<view class="insight-page" data-theme="{{appTheme}}">
  <view class="status-mask" style="height: {{statusBarHeight}}px;" aria-hidden="true"></view>

  <view class="insight-hero {{scopeMenuOpen ? 'is-menu-open' : ''}}">
    <image class="hero-landscape" src="/assets/ai-coach-shanshui-v2.jpg" mode="widthFix" aria-hidden="true" />
    <view class="hero-veil"></view>
    <view class="insight-nav" style="top: {{navTop}}px; height: {{navHeight}}px; padding-right: {{menuRightInset}}px;">
      <view class="nav-back" bindtap="goBack" role="button" aria-label="返回" hover-class="is-pressed"><t-icon name="chevron-left" size="50rpx" /></view>
      <view class="nav-brand">
        <image class="coach-brand" src="/components/coach-chat/coach-mark.svg" mode="aspectFit" aria-hidden="true" />
        <text class="nav-title">AI 成长教练</text>
      </view>
    </view>

    <view class="scope-switch" style="top: {{scopeTop}}px;" bindtap="toggleScopeMenu" role="button" aria-label="切换教练分析范围">
      <text>{{scopeLabel}}</text><t-icon name="chevron-down" size="28rpx" />
    </view>
    <view wx:if="{{scopeMenuOpen}}" class="scope-popover" style="top: {{scopeMenuTop}}px;">
      <view class="scope-option {{scope === 'day' ? 'is-active' : ''}}" data-scope="day" bindtap="selectCoachScope"><view><text>今日复盘</text><text>查看今天的行动与投入</text></view><t-icon wx:if="{{scope === 'day'}}" name="check" size="28rpx" /></view>
      <view class="scope-option {{scope === 'week' ? 'is-active' : ''}}" data-scope="week" bindtap="selectCoachScope"><view><text>本周复盘</text><text>回顾最近 7 天的节奏</text></view><t-icon wx:if="{{scope === 'week'}}" name="check" size="28rpx" /></view>
      <view class="scope-option {{scope === 'month' ? 'is-active' : ''}}" data-scope="month" bindtap="selectCoachScope"><view><text>本月观察</text><text>查看本月行动趋势</text></view><t-icon wx:if="{{scope === 'month'}}" name="check" size="28rpx" /></view>
      <view class="scope-option {{scope === 'overall' ? 'is-active' : ''}}" data-scope="overall" bindtap="selectCoachScope"><view><text>长期洞察</text><text>结合全部目标和成长记录</text></view><t-icon wx:if="{{scope === 'overall'}}" name="check" size="28rpx" /></view>
    </view>

    <view class="hero-conclusion" style="top: {{headlineTop}}px;">
      <view class="hero-spark" aria-hidden="true"></view>
      <view class="hero-title">{{judgement}}</view>
      <view class="hero-brush" aria-hidden="true"><view></view></view>
    </view>
  </view>

  <view class="insight-content">
    <view class="metric-grid">
      <view wx:for="{{metricCards}}" wx:key="key" class="metric-card metric-card--{{item.tone}}">
        <image class="metric-texture metric-texture--{{item.key}}" src="/assets/ai-coach-shanshui-v2.jpg" mode="aspectFill" aria-hidden="true" />
        <view class="metric-icon metric-icon--{{item.tone}}"><t-icon name="{{item.icon}}" size="36rpx" /></view>
        <view class="metric-value {{item.value >= 1000 ? 'is-compact' : item.value >= 100 ? 'is-dense' : ''}}">{{item.value}}<text>{{item.unit}}</text></view>
        <view class="metric-label">{{item.label}}</view>
        <view wx:if="{{item.progress !== undefined}}" class="metric-progress"><view style="width: {{item.progress}}%;"></view></view>
        <view class="metric-note">{{item.note}}</view>
      </view>
    </view>

    <view class="advice-card">
      <image class="advice-watermark" src="/assets/ai-coach-shanshui-v2.jpg" mode="aspectFill" aria-hidden="true" />
      <view class="advice-content">
        <view class="advice-heading">
          <view class="advice-spark"><t-icon name="star-filled" size="33rpx" /></view>
          <text class="advice-title">{{scope === 'day' ? '今日建议' : scope === 'week' ? '本周建议' : scope === 'month' ? '本月建议' : '长期建议'}}</text>
          <text class="advice-badge">AI</text>
        </view>
        <view class="advice-copy">{{bottleneck}}</view>
        <view class="advice-quick-list">
          <view wx:for="{{quickQuestions}}" wx:key="*this" class="advice-quick advice-quick--{{index}}" data-question="{{item}}" bindtap="sendGuidedQuestion" role="button">
            <t-icon name="{{index === 0 ? 'help-circle' : index === 1 ? 'chart-line' : 'flag'}}" size="28rpx" />
            <text>{{item}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{scope === 'day'}}" class="diagnosis-card">
      <image class="diagnosis-watermark" src="/assets/ai-coach-shanshui-v2.jpg" mode="aspectFill" aria-hidden="true" />
      <view class="diagnosis-heading">
        <view class="diagnosis-title-row">
          <view class="section-title">今日闭环诊断</view>
          <t-icon name="info-circle" size="27rpx" />
        </view>
        <view class="diagnosis-score">
          <text>综合评分</text>
          <text class="diagnosis-score-value">{{loopDiagnosis.score}}</text>
          <text>分</text>
          <text class="diagnosis-grade">{{loopDiagnosis.grade}}</text>
        </view>
      </view>
      <view class="diagnosis-grid">
        <view wx:for="{{loopDiagnosis.items}}" wx:key="key" class="diagnosis-item diagnosis-item--{{item.tone}}">
          <view class="diagnosis-item-label"><t-icon name="{{item.icon}}" size="27rpx" /><text>{{item.label}}</text></view>
          <view class="diagnosis-item-value">{{item.value}}</view>
          <view class="diagnosis-item-detail">{{item.detail}}</view>
          <view wx:if="{{item.meta}}" class="diagnosis-item-meta">{{item.meta}}</view>
        </view>
      </view>
      <view class="diagnosis-quote"><text class="diagnosis-quote-mark">“</text><text>{{loopDiagnosis.quote}}</text></view>
    </view>

    <view wx:else class="rhythm-card">
      <view class="section-heading">
        <view><view class="section-title">{{rhythmTitle}}</view><view class="section-subtitle">{{rhythmSubtitle}}</view></view>
        <view class="rhythm-total"><text class="rhythm-total-unit">共</text><text class="rhythm-total-value">{{rhythmTotalMinutes}}</text><text class="rhythm-total-unit">分钟</text></view>
      </view>
      <view wx:if="{{rhythmSegments.length}}" class="rhythm-strip" aria-hidden="true">
        <view wx:for="{{rhythmSegments}}" wx:key="key" class="rhythm-segment" style="flex-grow: {{item.minutes}}; background: {{item.color}};"></view>
      </view>
      <view wx:else class="rhythm-strip-empty">还没有真实投入记录，完成一项行动后会自动呈现节奏</view>
      <view class="rhythm-cells">
        <view wx:for="{{rhythmPoints}}" wx:key="key" class="rhythm-cell {{item.isCurrent ? 'is-current' : ''}} {{item.isFuture ? 'is-future' : ''}} {{item.minutes ? '' : 'is-rest'}}">
          <view class="rhythm-cell-icon" style="color: {{item.color}}; background: {{item.tint}};">
            <t-icon wx:if="{{item.icon}}" name="{{item.icon}}" size="30rpx" />
            <view wx:else class="rhythm-cell-dot" style="background: {{item.color}};"></view>
          </view>
          <view class="rhythm-cell-value">{{item.minutes ? item.minutes : '—'}}</view>
          <view class="rhythm-cell-label">{{item.label}}</view>
          <view class="rhythm-cell-count">{{item.completed ? item.completed + '项' : ''}}</view>
        </view>
      </view>
    </view>

    <view class="review-card">
      <view class="section-heading">
        <view><view class="section-title">{{reviewTitle}}</view><view class="section-subtitle">{{reviewSubtitle}}</view></view>
        <view class="section-link" bindtap="goProgress" role="button"><text>查看进度</text><t-icon name="chevron-right" size="27rpx" /></view>
      </view>
      <view wx:if="{{focusKind === 'actions' && reviewItems.length}}" class="review-list">
        <view wx:for="{{reviewItems}}" wx:key="id" class="review-row" data-task-id="{{item.id}}" bindtap="openReviewItem" role="button">
          <view class="review-icon review-icon--{{item.tone}}"><t-icon name="{{item.icon}}" size="30rpx" /></view>
          <view class="review-copy"><view class="review-title">{{item.title}}</view><view class="review-subtitle">{{item.subtitle}}</view></view>
          <view class="review-status review-status--{{item.tone}}">{{item.statusLabel}}</view>
        </view>
      </view>
      <view wx:elif="{{focusKind === 'goals' && goalItems.length}}" class="goal-list">
        <view wx:for="{{goalItems}}" wx:key="id" class="goal-row">
          <view class="goal-row-head"><view class="goal-title">{{item.title}}</view><view class="goal-status goal-status--{{item.tone}}">{{item.statusLabel}}</view></view>
          <view class="goal-copy">{{item.subtitle}}</view>
          <view class="goal-progress-row"><view class="goal-progress"><view style="width: {{item.progress}}%;"></view></view><text>{{item.completed}}/{{item.total}}</text></view>
        </view>
      </view>
      <view wx:else class="review-empty">{{scope === 'overall' ? '还没有可以展示的目标沉淀' : '这个范围内还没有行动记录'}}</view>
    </view>

    <view class="conversation-section">
      <coach-chat id="coach-chat" title="继续问教练" user-avatar-url="{{userAvatarUrl}}" messages="{{messages}}" asking="{{asking}}" error-message="{{chatError}}" executing-proposal-id="{{executingProposalId}}" bindsend="handleChatSend" bindretry="retryLastQuestion" bindconfirmproposal="confirmCoachAction"></coach-chat>
    </view>
  </view>
</view>
