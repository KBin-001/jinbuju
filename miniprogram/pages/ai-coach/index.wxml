<view class="coach-page progress-coach-page" data-theme="{{appTheme}}" style="padding-top: {{topInset}}px;">
  <view class="coach-header">
    <view class="coach-back" bindtap="goBack" hover-class="coach-pressed" aria-label="返回">‹</view>
    <view class="coach-heading">
      <view class="coach-title">AI 教练 <text>✦</text></view>
      <view class="coach-subtitle">{{scopeSubtitle}}</view>
    </view>
    <view class="coach-online"><view class="coach-online-dot"></view><text>在线</text></view>
  </view>

  <scroll-view class="coach-prompts" scroll-x show-scrollbar="{{false}}" enhanced>
    <view class="coach-prompts-inner">
      <view wx:for="{{quickQuestions}}" wx:key="*this" class="coach-prompt" data-question="{{item}}" bindtap="sendGuidedQuestion" hover-class="coach-pressed">
        <text wx:if="{{index === 0}}">📊</text><text wx:elif="{{index === 1}}">？</text><text wx:else>✦</text> {{item}}
      </view>
    </view>
  </scroll-view>

  <scroll-view class="coach-conversation" scroll-y show-scrollbar="{{false}}" enhanced scroll-into-view="{{scrollIntoView}}" scroll-with-animation>
    <view class="coach-bot-row">
      <image class="coach-robot" src="/assets/coach-ui/robot.svg" mode="aspectFit" />
      <view class="coach-bubble coach-bot-bubble">
        <text>你好，{{displayName}}！</text>
        <text>我已经整理了「{{goalTitle}}」的{{scopeLabel}}记录。</text>
        <text>{{scopeSubtitle}}。</text>
      </view>
    </view>

    <view class="coach-user-row">
      <view class="coach-bubble coach-user-bubble">{{initialPrompt}}</view>
      <text class="coach-time">{{scopeLabel}}</text>
    </view>

    <view class="coach-bot-row coach-report-row">
      <image class="coach-robot" src="/assets/coach-ui/robot.svg" mode="aspectFit" />
      <view class="coach-bubble coach-report-bubble">
        <view class="coach-report-intro">好的，以下是你的{{scopeLabel}}分析报告：</view>

        <view class="coach-report-card">
          <view class="coach-report-title">{{reportName}}</view>
          <view class="coach-report-metrics">
            <view class="coach-report-metric">
              <text class="coach-report-value coach-report-value--green">{{completedCount}}/{{totalCount}}</text>
              <text class="coach-report-label">已完成</text>
            </view>
            <view class="coach-report-metric">
              <view><text class="coach-report-value">{{periodMinutes}}</text><text class="coach-report-unit">min</text></view>
              <text class="coach-report-label">实际投入</text>
            </view>
            <view class="coach-report-metric">
              <view><text class="coach-report-value">{{completionRate}}</text><text class="coach-report-unit">%</text></view>
              <text class="coach-report-label">完成率</text>
            </view>
          </view>
          <view class="coach-report-progress"><view class="coach-report-progress-inner" style="width: {{completionRate}}%;"></view></view>
        </view>

        <view class="coach-report-card coach-analysis-card">
          <view class="coach-report-title">表现分析</view>
          <view class="coach-analysis-line"><view class="coach-analysis-dot coach-analysis-dot--green"></view><text>{{judgement}}</text></view>
          <view class="coach-analysis-line"><view class="coach-analysis-dot coach-analysis-dot--amber"></view><text>{{bottleneck}}</text></view>
        </view>

        <view class="coach-guided-actions coach-guided-actions--report">
          <view wx:for="{{quickQuestions}}" wx:key="*this" class="coach-guided-action" data-question="{{item}}" bindtap="sendGuidedQuestion" hover-class="coach-pressed">{{index === 0 ? '查看情况' : (index === 1 ? '查看卡点' : '下一步建议')}}</view>
        </view>
      </view>
    </view>

    <view wx:for="{{messages}}" wx:key="id" id="{{item.id}}" class="{{item.role === 'assistant' ? 'coach-bot-row coach-followup-row' : 'coach-user-row coach-followup-row'}}">
      <image wx:if="{{item.role === 'assistant'}}" class="coach-robot" src="/assets/coach-ui/robot.svg" mode="aspectFit" />
      <view wx:if="{{item.role === 'user'}}" class="coach-bubble coach-user-bubble">{{item.content}}</view>
      <view wx:elif="{{item.mode === 'direct'}}" class="coach-bubble coach-bot-bubble coach-direct-reply">{{item.content}}</view>
      <view wx:else class="coach-compact-reply">
        <view wx:if="{{item.summary}}" class="coach-compact-summary">{{item.summary}}</view>
        <view wx:if="{{item.metrics.length}}" class="coach-compact-metrics">
          <view wx:for="{{item.metrics}}" wx:for-item="metric" wx:key="label" class="coach-compact-metric">
            <text class="coach-compact-metric-value">{{metric.value}}</text>
            <text class="coach-compact-metric-label">{{metric.label}}</text>
          </view>
        </view>
        <view wx:if="{{item.insights.length}}" class="coach-compact-insights">
          <view wx:for="{{item.insights}}" wx:for-item="insight" wx:key="*this" class="coach-compact-insight"><view></view><text>{{insight}}</text></view>
        </view>
        <view wx:if="{{item.suggestion}}" class="coach-compact-divider"></view>
        <view wx:if="{{item.suggestion}}" class="coach-compact-advice-label">建议</view>
        <view wx:if="{{item.suggestion}}" class="coach-compact-advice">{{item.suggestion}}</view>
        <view wx:if="{{item.showFull}}" class="coach-compact-full">{{item.content}}</view>
        <view wx:if="{{item.canExpand}}" class="coach-compact-toggle" data-id="{{item.id}}" catchtap="toggleFullReply">{{item.showFull ? '收起完整回复' : '展开完整回复'}}</view>
        <view wx:if="{{item.followUps.length}}" class="coach-guided-actions">
          <view wx:for="{{item.followUps}}" wx:for-item="questionItem" wx:key="*this" class="coach-guided-action" data-question="{{questionItem}}" catchtap="sendGuidedQuestion" hover-class="coach-pressed">{{questionItem}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{asking}}" id="coach-typing" class="coach-bot-row coach-followup-row">
      <image class="coach-robot" src="/assets/coach-ui/robot.svg" mode="aspectFit" />
      <view class="coach-bubble coach-bot-bubble coach-typing">
        <view class="coach-breathe-wrap">
          <view class="coach-breathe-stage">
            <view class="coach-breathe-ring"></view>
            <view class="coach-breathe-orb"></view>
          </view>
          <text class="coach-breathe-text">思考中</text>
        </view>
      </view>
    </view>

    <view wx:if="{{chatError}}" id="chat-error" class="coach-chat-error">
      <text>{{chatError}}</text><view bindtap="retryLastQuestion">重新发送</view>
    </view>
    <view class="coach-scroll-spacer"></view>
  </scroll-view>

  <view class="coach-message-bar">
    <view class="coach-input-wrap">
      <input class="coach-input" value="{{question}}" maxlength="120" disabled="{{asking}}" placeholder="向 AI 教练发送消息..." placeholder-class="coach-placeholder" bindinput="inputQuestion" confirm-type="send" bindconfirm="sendQuestion" />
    </view>
    <view class="coach-send {{asking ? 'is-disabled' : ''}}" bindtap="sendQuestion" hover-class="coach-pressed">➤</view>
  </view>
</view>
