<view class="insight-page" data-theme="{{appTheme}}">
  <view class="status-mask" style="height: {{statusBarHeight}}px;" aria-hidden="true"></view>
  <view class="insight-hero" style="padding-top: {{navTop}}px;">
    <image class="hero-landscape" src="/assets/ai-coach/mountain-bg.svg" mode="aspectFill" aria-hidden="true" />
    <view class="hero-veil"></view>
    <view class="insight-nav" style="height: {{navHeight}}px; padding-right: {{menuRightInset}}px;">
      <view class="nav-back" bindtap="goBack" role="button" aria-label="返回"><t-icon name="chevron-left" size="42rpx" /></view>
      <view class="nav-copy">
        <view class="nav-title">AI 成长洞察<view class="nav-spark"></view></view>
        <view class="nav-subtitle">{{scopeSubtitle}}</view>
      </view>
    </view>
    <view class="hero-period"><text>{{scopeLabel}}</text><view>{{goalTitle}}</view></view>
  </view>

  <view class="insight-content">
    <view class="scope-questions">
      <view wx:for="{{quickQuestions}}" wx:key="*this" class="scope-question" data-question="{{item}}" bindtap="sendGuidedQuestion" role="button">{{index === 0 ? '完成情况' : (index === 1 ? '当前卡点' : '下一步')}}</view>
    </view>

    <view class="insight-card overview-card">
      <view class="card-kicker">{{reportName}}</view>
      <view class="overview-title">{{judgement}}</view>
      <view class="metrics-grid">
        <view class="metric"><text class="metric-value">{{completedCount}}<text>/{{totalCount}}</text></text><text class="metric-label">完成行动</text></view>
        <view class="metric"><text class="metric-value">{{periodMinutes}}<text> 分钟</text></text><text class="metric-label">实际投入</text></view>
        <view class="metric"><text class="metric-value">{{completionRate}}<text>%</text></text><text class="metric-label">行动完成率</text></view>
      </view>
      <view class="progress-track"><view class="progress-fill" style="width: {{completionRate}}%;"></view></view>
    </view>

    <view class="insight-card diagnosis-card">
      <view class="card-kicker card-kicker--spark">教练观察<view></view></view>
      <view class="diagnosis-main">{{bottleneck}}</view>
      <view class="diagnosis-stats">
        <view><text>{{activeDays}}</text><text>行动天数</text></view>
        <view><text>{{streakDays}}</text><text>连续天数</text></view>
        <view><text>{{recentActionDate}}</text><text>最近行动</text></view>
      </view>
    </view>

    <view class="insight-card conversation-card">
      <view class="conversation-title">继续问教练</view>
      <view class="question-list">
        <view wx:for="{{quickQuestions}}" wx:key="*this" class="question-chip" data-question="{{item}}" bindtap="sendGuidedQuestion" role="button">{{item}}</view>
      </view>

      <view wx:if="{{messages.length}}" class="message-list">
        <view wx:for="{{messages}}" wx:key="id" id="{{item.id}}" class="message-row message-row--{{item.role}}">
          <view wx:if="{{item.role === 'user'}}" class="user-message">{{item.content}}</view>
          <view wx:else class="assistant-message">
            <view class="assistant-mark"><view></view></view>
            <view class="assistant-body">
              <view class="assistant-summary">{{item.mode === 'direct' ? item.content : (item.summary || item.content)}}</view>
              <view wx:if="{{item.metrics.length}}" class="reply-metrics">
                <view wx:for="{{item.metrics}}" wx:for-item="metric" wx:key="label"><text>{{metric.value}}</text><text>{{metric.label}}</text></view>
              </view>
              <view wx:if="{{item.insights.length}}" class="reply-insights"><view wx:for="{{item.insights}}" wx:for-item="insight" wx:key="*this">{{insight}}</view></view>
              <view wx:if="{{item.suggestion}}" class="reply-suggestion">{{item.suggestion}}</view>
              <view wx:if="{{item.showFull}}" class="reply-full">{{item.content}}</view>
              <view wx:if="{{item.canExpand}}" class="reply-toggle" data-id="{{item.id}}" catchtap="toggleFullReply">{{item.showFull ? '收起完整回复' : '展开完整回复'}}</view>
              <view wx:if="{{item.actionProposal && item.actionProposal.id}}" class="action-proposal">
                <view>{{item.actionProposal.summary}}</view>
                <view wx:if="{{item.actionProposal.status === 'pending'}}" class="proposal-button" data-proposal-id="{{item.actionProposal.id}}" bindtap="confirmCoachAction">{{executingProposalId === item.actionProposal.id ? '正在执行…' : '确认执行'}}</view>
                <view wx:else class="proposal-success" bindtap="goToday">已执行 · 返回今日页</view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{asking}}" class="thinking"><view></view><text>正在结合真实记录分析</text></view>
      <view wx:if="{{chatError}}" id="chat-error" class="chat-error"><text>{{chatError}}</text><view bindtap="retryLastQuestion">重新发送</view></view>
      <view class="input-bar">
        <input class="coach-input" value="{{question}}" maxlength="120" disabled="{{asking}}" placeholder="继续问问行动节奏或下一步……" placeholder-class="coach-placeholder" bindinput="inputQuestion" confirm-type="send" bindconfirm="sendQuestion" />
        <view class="send-control {{asking ? 'is-disabled' : ''}}" bindtap="sendQuestion" role="button" aria-label="发送"><t-icon name="send" size="33rpx" /></view>
      </view>
    </view>
  </view>
</view>
