@import "../daily-coach/index.wxss";

.progress-coach-page .coach-prompt {
  white-space: nowrap;
}

.progress-coach-page .coach-conversation {
  min-height: 0;
}

.progress-coach-page .coach-followup-row.coach-user-row {
  align-items: flex-end;
}

.progress-coach-page .coach-followup-row.coach-user-row .coach-bubble {
  margin-left: auto;
}

.coach-typing {
  display: flex;
  align-items: center;
  min-width: 84rpx;
  gap: 9rpx;
}

.coach-typing view {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #7FAA91;
  animation: coach-typing-pulse 1s ease-in-out infinite;
}

.coach-typing view:nth-child(2) { animation-delay: 0.14s; }
.coach-typing view:nth-child(3) { animation-delay: 0.28s; }

@keyframes coach-typing-pulse {
  0%, 70%, 100% { opacity: 0.34; transform: translateY(0); }
  35% { opacity: 1; transform: translateY(-5rpx); }
}

.coach-chat-error {
  box-sizing: border-box;
  width: calc(100% - 104rpx);
  margin: 20rpx 0 0 76rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(214, 170, 66, 0.28);
  border-radius: 18rpx;
  background: #FFF8E5;
  color: #7E6528;
  font-size: 20rpx;
  line-height: 31rpx;
}

.coach-chat-error view {
  display: inline-flex;
  margin-top: 9rpx;
  color: #356859;
  font-weight: 700;
}

.progress-coach-page .coach-send.is-disabled {
  opacity: 0.48;
}

@media (max-width: 350px) {
  .progress-coach-page .coach-header {
    padding-right: 150rpx;
  }

  .progress-coach-page .coach-subtitle {
    max-width: 310rpx;
  }
}
