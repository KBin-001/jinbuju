/* Hallmark · genre: atmospheric product UI · tone: quiet modern Eastern · palette: ink green + warm ivory + restrained gold · macrostructure: landscape recap → real metrics → strategy → closed-loop diagnosis → action review · theme: studied-DNA (source: user reference) · pre-emit critique: P5 H5 E4 S5 R5 V4 */
@import "../../styles/theme.wxss";

page { min-height: 100%; background: #fbf8f1; }
.insight-page { min-height: 100vh; padding-bottom: calc(38rpx + env(safe-area-inset-bottom)); color: var(--color-text-main); background: #fbf8f1; }
.status-mask { position: absolute; z-index: 30; top: 0; right: 0; left: 0; pointer-events: none; background: rgba(255,253,249,.78); }
.is-pressed { opacity: .72; transform: scale(.97); }

.insight-hero { position: relative; box-sizing: border-box; height: 504rpx; overflow: hidden; background: #fffdf9; }
.insight-hero.is-menu-open { z-index: 50; overflow: visible; }
.hero-landscape { position: absolute; z-index: 0; top: 0; left: 0; width: 100%; opacity: .84; }
.hero-veil { position: absolute; z-index: 1; inset: 0; pointer-events: none; background: linear-gradient(180deg,rgba(255,253,249,.58) 0%,rgba(255,253,249,.06) 35%,rgba(255,253,249,.08) 69%,#fbf8f1 100%); }
.insight-nav { position: absolute; z-index: 22; right: 0; left: 0; display: flex; box-sizing: border-box; align-items: center; padding-left: 24rpx; }
.nav-back { display: flex; width: 72rpx; height: 72rpx; flex: none; align-items: center; justify-content: center; color: #1f2b27; }
.nav-brand { position: absolute; left: 50%; display: flex; align-items: center; transform: translateX(-50%); white-space: nowrap; }
.nav-title { margin-left: 15rpx; color: #193f36; font-family: STKaiti,"KaiTi SC","Noto Serif SC",serif; font-size: 36rpx; font-weight: 560; letter-spacing: 5rpx; line-height: 48rpx; }
.coach-brand { width: 78rpx; height: 54rpx; flex: none; }

.scope-switch { position: absolute; z-index: 22; left: 50%; display: flex; min-height: 60rpx; padding: 0 20rpx; gap: 7rpx; align-items: center; transform: translateX(-50%); border: 1rpx solid rgba(200,155,74,.19); border-radius: 999rpx; color: #233a33; background: rgba(255,253,249,.82); box-shadow: 0 6rpx 18rpx rgba(73,65,50,.04); font-size: 25rpx; line-height: 34rpx; }
.scope-popover { position: absolute; z-index: 40; left: 50%; width: 520rpx; padding: 12rpx; transform: translateX(-50%); border: 1rpx solid rgba(200,155,74,.2); border-radius: 28rpx; background: rgba(255,253,248,.98); box-shadow: 0 22rpx 60rpx rgba(45,56,50,.15); }
.scope-option { display: flex; min-height: 84rpx; padding: 13rpx 18rpx; box-sizing: border-box; align-items: center; justify-content: space-between; border-radius: 20rpx; color: var(--color-text-main); }
.scope-option.is-active { color: var(--color-primary); background: rgba(36,91,77,.07); }
.scope-option > view { min-width: 0; flex: 1; }
.scope-option text { display: block; }
.scope-option text:first-child { font-size: 24rpx; font-weight: 700; line-height: 34rpx; }
.scope-option text:last-child { margin-top: 2rpx; color: var(--color-text-secondary); font-size: 18rpx; line-height: 26rpx; }

.hero-conclusion { position: absolute; z-index: 8; right: 38rpx; left: 44rpx; }
.hero-spark { position: absolute; top: 13rpx; left: 2rpx; width: 12rpx; height: 12rpx; transform: rotate(45deg); background: #c89b4a; }
.hero-title { display: -webkit-box; max-width: 660rpx; padding-left: 28rpx; overflow: hidden; color: #202925; font-family: STKaiti,"KaiTi SC","Noto Serif SC",serif; font-size: 42rpx; font-weight: 500; letter-spacing: 3rpx; line-height: 1.56; text-shadow: 0 2rpx 16rpx rgba(255,253,249,.95); -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.hero-brush { width: 290rpx; height: 24rpx; margin: -3rpx 0 0 224rpx; overflow: hidden; transform: rotate(-4deg); }
.hero-brush view { width: 245rpx; height: 25rpx; border-top: 6rpx solid rgba(190,145,48,.9); border-radius: 50%; }

.insight-content { position: relative; z-index: 10; margin-top: -2rpx; padding: 0 30rpx; }
.metric-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 14rpx; }
.metric-card { position: relative; display: flex; min-width: 0; min-height: 252rpx; box-sizing: border-box; padding: 24rpx 20rpx 21rpx; overflow: hidden; flex-direction: column; border: 1rpx solid rgba(200,155,74,.26); border-radius: 28rpx; background: rgba(255,254,251,.97); box-shadow: 0 12rpx 30rpx rgba(53,61,56,.055); }
.metric-card--paper { background: linear-gradient(145deg,rgba(255,254,251,.99),rgba(255,249,235,.9)); }
.metric-card--mint { border-color: rgba(103,139,124,.22); background: linear-gradient(145deg,rgba(233,243,238,.94),rgba(255,253,248,.97)); }
.metric-card--gold { border-color: rgba(200,155,74,.35); background: linear-gradient(145deg,rgba(255,249,231,.98),rgba(247,231,190,.82)); }
.metric-texture { position: absolute; z-index: 0; right: -30rpx; bottom: -8rpx; width: 128rpx; height: 112rpx; opacity: .08; }
.metric-texture--minutes { width: 150rpx; opacity: .1; }
.metric-texture--days { right: -12rpx; width: 148rpx; opacity: .12; }
.metric-card > view { position: relative; z-index: 1; }
.metric-icon { height: 39rpx; color: #4c7968; }
.metric-icon--gold { color: #b78628; }
.metric-value { margin-top: 18rpx; color: #315f50; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 52rpx; font-weight: 450; line-height: 62rpx; white-space: nowrap; }
.metric-value.is-dense { font-size: 46rpx; }
.metric-value.is-compact { font-size: 40rpx; letter-spacing: -1rpx; }
.metric-value text { margin-left: 4rpx; color: #7d817d; font-family: var(--font-family-sans); font-size: 20rpx; font-weight: 400; }
.metric-label { color: #283630; font-size: 23rpx; font-weight: 550; line-height: 33rpx; }
.metric-progress { height: 8rpx; margin-top: 12rpx; overflow: hidden; border-radius: 999rpx; background: rgba(70,107,93,.12); }
.metric-progress view { height: 100%; border-radius: inherit; background: linear-gradient(90deg,#3f7562,#7fa794); }
.metric-note { margin-top: auto; padding-top: 12rpx; color: #858883; font-size: 17rpx; line-height: 26rpx; }

.advice-card { position: relative; min-height: 198rpx; margin-top: 24rpx; overflow: hidden; border: 1rpx solid rgba(200,155,74,.39); border-radius: 28rpx; background: linear-gradient(135deg,#fffdf8 0%,#fff9ed 100%); box-shadow: 0 10rpx 28rpx rgba(102,79,34,.052); }
.advice-watermark { position: absolute; z-index: 0; top: 0; right: 0; width: 48%; height: 100%; opacity: .12; }
.advice-content { position: relative; z-index: 1; padding: 23rpx 24rpx 20rpx; }
.advice-heading { display: flex; align-items: center; }
.advice-spark { display: flex; margin-right: 10rpx; color: #c89b4a; }
.advice-title { color: #27332f; font-family: STKaiti,"KaiTi SC","Noto Serif SC",serif; font-size: 30rpx; font-weight: 650; letter-spacing: 2rpx; }
.advice-badge { margin-left: 12rpx; padding: 2rpx 10rpx; border: 1rpx solid rgba(183,134,40,.72); border-radius: 999rpx; color: #a87820; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 18rpx; line-height: 28rpx; }
.advice-copy { max-width: 610rpx; margin-top: 12rpx; color: #4a514d; font-size: 22rpx; line-height: 35rpx; }
.advice-quick-list { display: grid; margin-top: 17rpx; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 10rpx; }
.advice-quick { display: flex; min-width: 0; min-height: 64rpx; box-sizing: border-box; padding: 8rpx 10rpx; gap: 7rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(200,155,74,.28); border-radius: 999rpx; color: #315f50; background: rgba(255,253,248,.91); box-shadow: 0 5rpx 13rpx rgba(69,72,65,.045); font-size: 18rpx; line-height: 24rpx; text-align: center; }
.advice-quick--1 { color: #a87820; }
.advice-quick text { display: -webkit-box; min-width: 0; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }

.rhythm-card,.review-card { margin-top: 22rpx; padding: 23rpx 24rpx; border: 1rpx solid rgba(200,155,74,.2); border-radius: 28rpx; background: rgba(255,253,248,.95); box-shadow: 0 10rpx 26rpx rgba(53,61,56,.045); }
.section-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.section-title { color: #26332e; font-family: STKaiti,"KaiTi SC","Noto Serif SC",serif; font-size: 28rpx; font-weight: 650; letter-spacing: 2rpx; line-height: 38rpx; }
.section-subtitle { margin-top: 3rpx; color: #858984; font-size: 18rpx; line-height: 27rpx; }
.section-link { display: flex; min-height: 42rpx; flex: none; gap: 3rpx; align-items: center; color: #66736d; font-size: 19rpx; }
.rhythm-total { display: flex; min-height: 36rpx; flex: none; gap: 6rpx; align-items: baseline; }
.rhythm-total-unit { color: #8a8e88; font-size: 17rpx; }
.rhythm-total-value { color: #315f50; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 34rpx; font-weight: 500; line-height: 40rpx; }
.rhythm-strip { display: flex; height: 18rpx; margin-top: 20rpx; }
.rhythm-segment { min-width: 12rpx; height: 100%; margin-right: 6rpx; border-radius: 999rpx; }
.rhythm-segment:last-child { margin-right: 0; }
.rhythm-strip-empty { display: flex; min-height: 58rpx; margin-top: 18rpx; padding: 0 20rpx; box-sizing: border-box; align-items: center; justify-content: center; border: 2rpx dashed rgba(87,119,104,.22); border-radius: 18rpx; color: #9a9e98; font-size: 18rpx; text-align: center; }
.rhythm-cells { display: flex; margin-top: 22rpx; }
.rhythm-cell { display: flex; min-width: 0; flex: 1; flex-direction: column; align-items: center; }
.rhythm-cell-icon { display: flex; width: 46rpx; height: 46rpx; align-items: center; justify-content: center; border-radius: 50%; }
.rhythm-cell-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.rhythm-cell-value { margin-top: 10rpx; min-height: 34rpx; color: #24312d; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 26rpx; font-weight: 550; line-height: 34rpx; }
.rhythm-cell-label { margin-top: 1rpx; color: #7c817d; font-size: 17rpx; line-height: 24rpx; }
.rhythm-cell-count { min-height: 22rpx; color: #a29d91; font-size: 15rpx; line-height: 22rpx; }
.rhythm-cell.is-current .rhythm-cell-icon { box-shadow: 0 0 0 2rpx rgba(200,155,74,.45); }
.rhythm-cell.is-current .rhythm-cell-label { color: #a77720; font-weight: 650; }
.rhythm-cell.is-rest .rhythm-cell-icon { opacity: .42; }
.rhythm-cell.is-rest .rhythm-cell-value { color: #c2beb1; font-weight: 400; }
.rhythm-cell.is-future { opacity: .45; }

.diagnosis-card { position: relative; margin-top: 22rpx; padding: 23rpx 23rpx 20rpx; overflow: hidden; border: 1rpx solid rgba(200,155,74,.28); border-radius: 28rpx; background: rgba(255,253,248,.97); box-shadow: 0 10rpx 28rpx rgba(53,61,56,.045); }
.diagnosis-watermark { position: absolute; right: -30rpx; bottom: -42rpx; width: 360rpx; height: 150rpx; opacity: .055; }
.diagnosis-heading { position: relative; z-index: 1; display: flex; gap: 18rpx; align-items: center; justify-content: space-between; }
.diagnosis-title-row { display: flex; gap: 10rpx; align-items: center; color: #7c817d; }
.diagnosis-score { display: flex; gap: 5rpx; align-items: baseline; color: #69736e; font-size: 18rpx; white-space: nowrap; }
.diagnosis-score-value { margin-left: 4rpx; color: #315f50; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 34rpx; line-height: 40rpx; }
.diagnosis-grade { margin-left: 5rpx; padding: 2rpx 10rpx; border: 1rpx solid rgba(200,155,74,.55); border-radius: 999rpx; color: #a87820; background: rgba(255,250,235,.8); font-size: 16rpx; line-height: 27rpx; }
.diagnosis-grid { position: relative; z-index: 1; display: grid; margin-top: 18rpx; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 10rpx; }
.diagnosis-item { position: relative; display: flex; min-width: 0; min-height: 178rpx; box-sizing: border-box; padding: 17rpx 13rpx 14rpx; flex-direction: column; border: 1rpx solid rgba(200,155,74,.17); border-radius: 18rpx; background: rgba(255,253,248,.74); }
.diagnosis-item--mint { background: rgba(238,245,241,.62); }
.diagnosis-item--gold { background: rgba(255,250,236,.66); }
.diagnosis-item-label { display: flex; min-width: 0; gap: 6rpx; align-items: center; color: #6b746f; font-size: 17rpx; line-height: 24rpx; white-space: nowrap; }
.diagnosis-item--gold .diagnosis-item-label { color: #b07e22; }
.diagnosis-item--mint .diagnosis-item-label { color: #4f7f6e; }
.diagnosis-item-value { margin-top: 18rpx; color: #315f50; font-family: STKaiti,"KaiTi SC","Noto Serif SC",serif; font-size: 28rpx; font-weight: 600; line-height: 36rpx; }
.diagnosis-item-detail { display: -webkit-box; margin-top: 8rpx; overflow: hidden; color: #727974; font-size: 16rpx; line-height: 25rpx; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.diagnosis-item-meta { align-self: flex-start; margin-top: auto; padding: 3rpx 10rpx; border: 1rpx solid rgba(200,155,74,.22); border-radius: 999rpx; color: #7f7b70; background: rgba(255,253,248,.7); font-size: 14rpx; line-height: 22rpx; }
.diagnosis-quote { position: relative; z-index: 1; display: flex; min-height: 58rpx; margin-top: 13rpx; padding: 0 14rpx; gap: 12rpx; align-items: center; color: #6c756f; font-family: STKaiti,"KaiTi SC","Noto Serif SC",serif; font-size: 20rpx; letter-spacing: 1rpx; line-height: 30rpx; }
.diagnosis-quote-mark { color: rgba(200,155,74,.26); font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 54rpx; line-height: 40rpx; }

.review-list,.goal-list { margin-top: 13rpx; }
.review-row { display: flex; min-height: 88rpx; gap: 15rpx; align-items: center; border-top: 1rpx solid rgba(113,106,93,.1); }
.review-row:first-child { border-top: 0; }
.review-icon { display: flex; width: 54rpx; height: 54rpx; flex: none; align-items: center; justify-content: center; border-radius: 50%; color: #777b78; background: rgba(112,115,111,.08); }
.review-icon--complete { color: #3d7562; background: rgba(79,132,111,.14); }
.review-icon--active { color: #b77f17; background: rgba(200,155,74,.17); }
.review-copy { min-width: 0; flex: 1; }
.review-title { overflow: hidden; color: #303a36; font-size: 23rpx; font-weight: 600; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }
.review-subtitle { margin-top: 1rpx; overflow: hidden; color: #8b8d89; font-size: 18rpx; line-height: 27rpx; text-overflow: ellipsis; white-space: nowrap; }
.review-status { flex: none; color: #818581; font-size: 18rpx; }
.review-status--complete { color: #3f7965; }
.review-status--active { color: #b57914; }
.goal-row { padding: 18rpx 0; border-top: 1rpx solid rgba(113,106,93,.1); }
.goal-row:first-child { border-top: 0; }
.goal-row-head { display: flex; gap: 14rpx; align-items: center; justify-content: space-between; }
.goal-title { min-width: 0; overflow: hidden; color: #303a36; font-size: 23rpx; font-weight: 650; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }
.goal-status { flex: none; padding: 4rpx 12rpx; border-radius: 999rpx; color: #3f7965; background: rgba(79,132,111,.11); font-size: 16rpx; }
.goal-status--archived { color: #8a7954; background: rgba(200,155,74,.12); }
.goal-copy { margin-top: 4rpx; overflow: hidden; color: #858984; font-size: 18rpx; line-height: 26rpx; text-overflow: ellipsis; white-space: nowrap; }
.goal-progress-row { display: flex; margin-top: 11rpx; gap: 12rpx; align-items: center; color: #758078; font-size: 17rpx; }
.goal-progress { height: 8rpx; flex: 1; overflow: hidden; border-radius: 999rpx; background: rgba(70,107,93,.11); }
.goal-progress view { height: 100%; border-radius: inherit; background: linear-gradient(90deg,#4b7968,#92ad9f); }
.review-empty { display: flex; min-height: 120rpx; align-items: center; justify-content: center; color: #8c8f8b; font-size: 21rpx; text-align: center; }
.conversation-section { margin-top: 16rpx; }

@media (max-width: 350px) {
  .insight-nav { padding-left: 14rpx; }
  .nav-title { font-size: 31rpx; letter-spacing: 3rpx; }
  .coach-brand { width: 66rpx; }
  .insight-content { padding-right: 20rpx; padding-left: 20rpx; }
  .hero-conclusion { right: 28rpx; left: 30rpx; }
  .hero-title { font-size: 40rpx; }
  .metric-grid { gap: 9rpx; }
  .metric-card { min-height: 240rpx; padding-right: 14rpx; padding-left: 14rpx; }
  .metric-value { font-size: 44rpx; }
  .metric-label { font-size: 20rpx; }
  .metric-note { font-size: 15rpx; line-height: 23rpx; }
  .advice-content { padding-right: 18rpx; padding-left: 18rpx; }
  .advice-quick { min-height: 60rpx; padding-right: 5rpx; padding-left: 5rpx; font-size: 16rpx; }
  .advice-quick .t-icon { display: none; }
  .rhythm-card,.review-card { padding-right: 18rpx; padding-left: 18rpx; }
  .diagnosis-card { padding-right: 16rpx; padding-left: 16rpx; }
  .diagnosis-grid { gap: 6rpx; }
  .diagnosis-item { min-height: 184rpx; padding-right: 9rpx; padding-left: 9rpx; }
  .diagnosis-item-label { font-size: 15rpx; }
  .diagnosis-item-value { font-size: 25rpx; }
  .diagnosis-item-detail { font-size: 14rpx; line-height: 22rpx; }
  .rhythm-cell-icon { width: 40rpx; height: 40rpx; }
  .rhythm-cell-value { font-size: 23rpx; }
  .scope-popover { width: 500rpx; }
}
