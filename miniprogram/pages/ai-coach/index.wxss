/* =============================================
   AI 教练页面 — UI 美化升级版
   配色对齐 AGENTS.md §4
   ============================================= */

.coach-page {
  --coach-bg: #FFFDF8;
  --coach-paper: rgba(255, 255, 255, 0.92);
  --coach-ink: #16372F;
  --coach-sub: #6F7974;
  --coach-green: #356859;
  --coach-green-deep: #2F6D55;
  --coach-green-light: #4F9876;
  --coach-mint: #EAF5EE;
  --coach-line: #DCE8E1;
  --coach-shadow: 0 14rpx 36rpx rgba(38, 65, 53, 0.09);
  --coach-glass: rgba(255, 255, 255, 0.72);
  --coach-bubble-ai: #F0F8F4;
  --coach-bubble-ai-border: #D8EBE0;
  --coach-bubble-user: #356859;
  --coach-typing: #6F9D86;

  position: relative;
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #FFFAF0 0%, #F7F3E9 38%, #FFFDF8 100%);
  color: var(--coach-ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* ===========================================
   顶部背景
   =========================================== */
.coach-page__mountain {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 410rpx;
  opacity: 0.96;
}

.coach-page__fade {
  position: absolute;
  top: 290rpx;
  left: 0;
  right: 0;
  height: 150rpx;
  background: linear-gradient(180deg, rgba(255, 253, 248, 0), #FFFDF8 78%);
}

/* ===========================================
   导航栏
   =========================================== */
.coach-nav {
  position: relative;
  z-index: 8;
  height: 96rpx;
  padding: calc(env(safe-area-inset-top) + 8rpx) 30rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: content-box;
}

.coach-nav__back {
  position: relative;
  z-index: 2;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.48);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.56);
  transition: opacity 0.15s, transform 0.15s;
}

.coach-nav__back--pressed {
  opacity: 0.5;
  transform: scale(0.92);
}

.coach-nav__back-arrow {
  color: #1A3B32;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
  margin-left: 4rpx;
}

.coach-nav__title {
  position: absolute;
  left: 0;
  right: 0;
  color: #1A3B32;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
  text-align: center;
  pointer-events: none;
}

.coach-nav__safe {
  width: 72rpx;
  height: 72rpx;
}

/* ===========================================
   滚动区
   =========================================== */
.coach-scroll {
  position: absolute;
  z-index: 3;
  top: calc(env(safe-area-inset-top) + 112rpx);
  right: 0;
  bottom: calc(116rpx + env(safe-area-inset-bottom));
  left: 0;
}

.coach-content {
  padding: 56rpx 30rpx 36rpx;
}

.coach-scroll--chat {
  bottom: calc(214rpx + env(safe-area-inset-bottom));
}

.coach-content--chat {
  padding-bottom: 28rpx;
}

/* ===========================================
   教练概览 Hero 卡
   =========================================== */
.coach-hero {
  min-height: 270rpx;
  padding: 28rpx 26rpx;
  display: grid;
  grid-template-columns: 154rpx minmax(0, 1fr) 142rpx;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(181, 206, 193, 0.72);
  border-radius: 42rpx;
  background: linear-gradient(120deg, rgba(255, 255, 255, 0.84), rgba(239, 249, 243, 0.70));
  box-shadow: var(--coach-shadow);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

/* 头像容器 — 带呼吸脉冲 */
.coach-hero__avatar-wrap {
  position: relative;
  width: 148rpx;
  height: 148rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #D7E9DF;
  border-radius: 50%;
  background: rgba(239, 248, 242, 0.86);
  box-shadow:
    inset 0 0 0 10rpx rgba(255, 255, 255, 0.62),
    0 8rpx 24rpx rgba(53, 104, 89, 0.10);
}

.coach-hero__avatar {
  width: 126rpx;
  height: 126rpx;
}

/* 脉冲动画环 */
.coach-hero__pulse {
  position: absolute;
  inset: -8rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(92, 202, 166, 0.3);
  animation: hero-pulse 2.4s ease-in-out infinite;
}

.coach-hero__copy {
  min-width: 0;
}

.coach-hero__greeting {
  display: block;
  color: #111111;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.3;
}

.coach-hero__line {
  display: block;
  margin-top: 8rpx;
  color: #2D3935;
  font-size: 23rpx;
  line-height: 1.35;
}

.coach-hero__status {
  height: 48rpx;
  margin-top: 14rpx;
  padding: 0 18rpx;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  border-radius: 24rpx;
  background: #E7F2EB;
  color: #39725B;
  font-size: 21rpx;
}

.coach-hero__status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #4AA077;
  animation: status-blink 2s ease-in-out infinite;
}

.coach-hero__status-text {
  font-weight: 500;
}

/* 完成率圆环 */
.coach-score {
  width: 138rpx;
  height: 138rpx;
  padding: 13rpx;
  box-sizing: border-box;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(47, 109, 85, 0.10);
}

.coach-score__inner {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
}

.coach-score__number-wrap {
  display: flex;
  align-items: baseline;
}

.coach-score__number {
  color: var(--coach-green);
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
}

.coach-score__unit {
  color: var(--coach-green);
  font-size: 23rpx;
  font-weight: 700;
}

.coach-score__label {
  margin-top: 7rpx;
  color: #68736E;
  font-size: 19rpx;
}

/* ===========================================
   通用区块卡片
   =========================================== */
.coach-section {
  margin-top: 26rpx;
  padding: 26rpx;
  box-sizing: border-box;
  border: 1rpx solid #E8EEE9;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 30rpx rgba(42, 62, 50, 0.065);
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.section-heading__title {
  color: #111111;
  font-size: 32rpx;
  font-weight: 850;
  line-height: 1.2;
}

.section-heading__title--compact {
  font-size: 26rpx;
}

.section-heading__meta {
  color: #A0A6A2;
  font-size: 19rpx;
}

/* ===========================================
   教练发现
   =========================================== */
.discovery-section {
  padding: 24rpx;
}

.discovery-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.discovery-card {
  min-height: 166rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #F0F8F4, #E8F4EC);
  border: 1rpx solid rgba(200, 224, 211, 0.5);
  transition: transform 0.15s;
}

.discovery-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.discovery-card__label {
  color: #65716B;
  font-size: 20rpx;
  line-height: 1.2;
}

.discovery-card__signal {
  flex: none;
  font-size: 18rpx;
  font-weight: 700;
}

.discovery-card__signal--down {
  color: #E76055;
}

.discovery-card__signal--up,
.discovery-card__signal--flat {
  color: #38A965;
}

.discovery-card__signal--warm,
.discovery-card__signal--chart {
  color: #EE9B4A;
}

.discovery-card__value {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
}

.discovery-card__number {
  color: var(--coach-green);
  font-size: 42rpx;
  font-weight: 850;
  line-height: 1;
}

.discovery-card__unit {
  margin-left: 4rpx;
  color: var(--coach-green-deep);
  font-size: 22rpx;
  font-weight: 650;
}

.discovery-card__helper {
  display: block;
  margin-top: 12rpx;
  color: #8A938E;
  font-size: 19rpx;
  line-height: 1.35;
}

/* ===========================================
   对话区域
   =========================================== */
.conversation-section {
  min-height: 260rpx;
}

/* 快捷问题 */
.question-area {
  margin-top: 18rpx;
}

.question-scroll {
  width: 100%;
  white-space: nowrap;
}

.question-row {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 20rpx;
}

.question-chip {
  height: 64rpx;
  padding: 0 24rpx;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  border: 1rpx solid #D8EBE0;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #3F4944;
  font-size: 21rpx;
  box-shadow: 0 4rpx 12rpx rgba(53, 104, 89, 0.06);
  transition: transform 0.15s, opacity 0.15s;
}

.question-chip--pressed {
  opacity: 0.7;
  transform: scale(0.96);
}

.question-chip__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #5CECD4, #4F9876);
  flex-shrink: 0;
}

/* 空对话提示 */
.chat-empty {
  margin-top: 18rpx;
  padding: 22rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #F5FAF7, #EDF6F1);
  border: 1rpx solid rgba(200, 224, 211, 0.4);
}

.chat-empty__avatar {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(234, 245, 238, 0.8);
}

.chat-empty__avatar image {
  width: 56rpx;
  height: 56rpx;
}

.chat-empty__body {
  flex: 1;
  min-width: 0;
}

.chat-empty__text {
  color: #68756F;
  font-size: 21rpx;
  line-height: 1.6;
}

/* ===========================================
   消息列表
   =========================================== */
.message-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.message-row--user {
  justify-content: flex-end;
}

/* 头像容器 */
.message-avatar-wrap {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(239, 248, 242, 0.86);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1.5rpx solid #D7E9DF;
  box-shadow: 0 4rpx 12rpx rgba(53, 104, 89, 0.08);
}

.message-avatar {
  width: 52rpx;
  height: 52rpx;
}

.message-avatar-wrap--user {
  background: linear-gradient(135deg, #356859, #2A6E5A);
  border-color: rgba(53, 104, 89, 0.3);
}

.message-user-avatar {
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}

/* 消息内容区 */
.message-content {
  max-width: 72%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.message-content--user {
  align-items: flex-end;
}

.message-sender {
  color: #A0A6A2;
  font-size: 20rpx;
  font-weight: 500;
  padding-left: 4rpx;
}

/* ===========================================
   对话气泡 — 核心美化
   =========================================== */
.message-bubble {
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  font-size: 23rpx;
  line-height: 1.65;
  word-break: break-all;
  position: relative;
}

/* AI 气泡 — 毛玻璃质感 + 精致边框 */
.message-bubble--assistant {
  background: linear-gradient(145deg, rgba(240, 248, 244, 0.95), rgba(232, 244, 236, 0.9));
  border: 1.5rpx solid rgba(200, 224, 211, 0.6);
  border-top-left-radius: 8rpx;
  color: #3A4D44;
  box-shadow:
    0 4rpx 16rpx rgba(53, 104, 89, 0.06),
    0 1rpx 3rpx rgba(53, 104, 89, 0.04);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}

/* 用户气泡 — 主色渐变 + 投影 */
.message-bubble--user {
  background: linear-gradient(135deg, #356859 0%, #2A6E5A 100%);
  border-top-right-radius: 8rpx;
  color: #FFFFFF;
  box-shadow:
    0 8rpx 24rpx rgba(53, 104, 89, 0.18),
    0 2rpx 6rpx rgba(53, 104, 89, 0.10);
  border: none;
}

/* 正在输入气泡 */
.message-bubble--typing {
  padding: 24rpx 28rpx;
}

.typing-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--coach-typing);
  animation: coach-dot 1.2s ease-in-out infinite;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.15s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.3s;
}

/* 错误提示 */
.chat-error {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 242, 239, 0.92);
  border: 1rpx solid rgba(234, 219, 215, 0.6);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}

.chat-error__text {
  color: #9A5E56;
  font-size: 20rpx;
}

.chat-error__retry {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  background: var(--coach-green);
  color: #FFFFFF;
  font-size: 19rpx;
  font-weight: 600;
}

/* ===========================================
   底部输入栏 — 玻璃质感
   =========================================== */
.chat-composer {
  position: absolute;
  z-index: 14;
  right: 0;
  bottom: calc(106rpx + env(safe-area-inset-bottom));
  left: 0;
  padding: 12rpx 24rpx;
  box-sizing: border-box;
  border-top: 1rpx solid rgba(220, 232, 225, 0.82);
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 -8rpx 24rpx rgba(40, 60, 50, 0.05);
  backdrop-filter: blur(22rpx);
  -webkit-backdrop-filter: blur(22rpx);
}

.chat-composer__inner {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 84rpx;
}

.chat-composer__input {
  flex: 1;
  height: 76rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border: 1.5rpx solid #DDE8E2;
  border-radius: 38rpx;
  background: rgba(248, 250, 247, 0.94);
  color: #33423C;
  font-size: 23rpx;
  transition: border-color 0.2s;
}

.chat-composer__input:focus {
  border-color: rgba(53, 104, 89, 0.4);
}

.chat-composer__send {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #356859 0%, #2A6E5A 100%);
  box-shadow: 0 6rpx 18rpx rgba(53, 104, 89, 0.22);
  transition: opacity 0.15s, transform 0.15s;
}

.chat-composer__send--pressed {
  opacity: 0.74;
  transform: scale(0.94);
}

.chat-composer__send image {
  width: 40rpx;
  height: 40rpx;
}

.chat-composer__send.is-disabled {
  opacity: 0.62;
}

.composer-spinner {
  width: 36rpx;
  height: 36rpx;
  box-sizing: border-box;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #FFFFFF;
  border-radius: 50%;
  animation: coach-spin 0.8s linear infinite;
}

/* ===========================================
   底部 TabBar
   =========================================== */
.coach-tabbar {
  position: absolute;
  z-index: 12;
  right: 0;
  bottom: 0;
  left: 0;
  height: calc(106rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  align-items: center;
  box-sizing: border-box;
  border-top: 1rpx solid #E7E7E3;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 -8rpx 24rpx rgba(40, 60, 50, 0.05);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.coach-tabbar__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5rpx;
  color: #898F8B;
  font-size: 20rpx;
}

.coach-tabbar__item image {
  width: 45rpx;
  height: 45rpx;
  opacity: 0.68;
}

.coach-tabbar__item--active {
  color: var(--coach-green);
  font-weight: 800;
}

.coach-tabbar__item--active image {
  opacity: 1;
}

/* ===========================================
   动画
   =========================================== */
@keyframes coach-spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes coach-dot {
  0%, 100% {
    opacity: 0.35;
    transform: translateY(0);
  }
  50% {
    opacity: 1;
    transform: translateY(-8rpx);
  }
}

@keyframes hero-pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.4;
  }
  50% {
    transform: scale(1.08);
    opacity: 0;
  }
}

@keyframes status-blink {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.4;
  }
}
