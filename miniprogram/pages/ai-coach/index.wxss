@import "../daily-coach/index.wxss";

.progress-coach-page .coach-prompt {
  white-space: nowrap;
}

.progress-coach-page .coach-conversation {
  min-height: 0;
}

.progress-coach-page .coach-followup-row.coach-user-row {
  align-items: flex-end;
}

.progress-coach-page .coach-followup-row.coach-user-row .coach-bubble {
  margin-left: auto;
}

.coach-typing {
  display: flex;
  align-items: center;
  min-width: 150rpx;
  min-height: 48rpx;
  padding: 16rpx 22rpx;
}

.coach-breathe-wrap {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.coach-breathe-stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 auto;
}

.coach-breathe-orb,
.coach-breathe-ring {
  position: absolute;
  box-sizing: border-box;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
}

.coach-breathe-orb {
  z-index: 2;
  background: radial-gradient(circle at 38% 34%, #FFB45E 0%, #F3A04C 48%, #E58522 100%);
  box-shadow: 0 4rpx 12rpx rgba(229, 133, 34, 0.20);
  animation: coach-breathe-scale 1.4s ease-in-out infinite;
}

.coach-breathe-ring {
  z-index: 1;
  border: 2rpx solid rgba(243, 160, 76, 0.34);
  animation: coach-breathe-ring 1.4s ease-out infinite;
}

.coach-breathe-text {
  color: #8B8580;
  font-size: 21rpx;
  line-height: 30rpx;
  white-space: nowrap;
}

@keyframes coach-breathe-scale {
  0%, 100% { opacity: 0.66; transform: scale(0.84); }
  50% { opacity: 1; transform: scale(1.14); }
}

@keyframes coach-breathe-ring {
  0% { opacity: 0.42; transform: scale(0.72); }
  72% { opacity: 0; transform: scale(1.9); }
  100% { opacity: 0; transform: scale(1.9); }
}

.coach-chat-error {
  box-sizing: border-box;
  width: calc(100% - 104rpx);
  margin: 20rpx 0 0 76rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(214, 170, 66, 0.28);
  border-radius: 18rpx;
  background: #FFF8E5;
  color: #7E6528;
  font-size: 20rpx;
  line-height: 31rpx;
}

.coach-chat-error view {
  display: inline-flex;
  margin-top: 9rpx;
  color: #356859;
  font-weight: 700;
}

.progress-coach-page .coach-send.is-disabled {
  opacity: 0.48;
}

@media (max-width: 350px) {
  .progress-coach-page .coach-header {
    padding-right: 150rpx;
  }

  .progress-coach-page .coach-subtitle {
    max-width: 310rpx;
  }
}
