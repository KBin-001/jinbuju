@import "../../styles/theme.wxss";

page { min-height: 100%; background: var(--color-background); }
.insight-page { min-height: 100vh; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); color: var(--color-text-main); background: var(--color-background); }
.status-mask { position: fixed; z-index: 30; top: 0; right: 0; left: 0; pointer-events: none; background: rgba(255,252,246,.96); }
.insight-hero { position: relative; box-sizing: border-box; height: 286rpx; overflow: hidden; }
.hero-landscape { position: absolute; right: 0; bottom: -34rpx; left: 0; width: 100%; height: 236rpx; opacity: .48; }
.hero-veil { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(255,252,246,.95), rgba(255,252,246,.52) 52%, rgba(247,243,234,.08)); }
.insight-nav { position: relative; z-index: 2; display: flex; box-sizing: border-box; align-items: center; padding-left: 32rpx; }
.nav-back { display: flex; width: 72rpx; min-width: 72rpx; height: 72rpx; flex: none; align-items: center; justify-content: center; border: 1rpx solid var(--color-border-soft); border-radius: 50%; color: var(--color-primary); background: rgba(255,252,246,.92); }
.nav-copy { min-width: 0; flex: 1; margin-left: 18rpx; overflow: hidden; }
.nav-title { display: flex; gap: 13rpx; align-items: center; color: var(--color-primary); font-size: 35rpx; font-weight: 760; line-height: 43rpx; white-space: nowrap; }
.nav-spark { width: 11rpx; height: 11rpx; transform: rotate(45deg); border-radius: 2rpx; background: var(--color-accent); }
.nav-subtitle { margin-top: 2rpx; overflow: hidden; color: #77827D; font-size: 20rpx; line-height: 27rpx; text-overflow: ellipsis; white-space: nowrap; }
.hero-period { position: absolute; z-index: 2; right: 32rpx; bottom: 24rpx; left: 32rpx; }
.hero-period text { color: var(--color-accent); font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; }
.hero-period view { max-width: 520rpx; margin-top: 8rpx; overflow: hidden; color: #214B3F; font-size: 34rpx; font-weight: 730; line-height: 44rpx; text-overflow: ellipsis; white-space: nowrap; }
.insight-content { position: relative; z-index: 3; padding: 0 32rpx; }
.scope-questions { display: flex; min-height: 76rpx; margin-top: -4rpx; padding: 7rpx; border: 1rpx solid var(--color-border-soft); border-radius: var(--radius-card-sm); background: var(--color-card); }
.scope-question { display: flex; min-width: 0; min-height: 62rpx; flex: 1; align-items: center; justify-content: center; border-radius: 18rpx; color: var(--color-primary); font-size: 23rpx; font-weight: 650; }
.scope-question + .scope-question { border-left: 1rpx solid var(--color-divider); }
.insight-card { margin-top: 20rpx; padding: 28rpx; border: 1rpx solid var(--color-border-soft); border-radius: var(--radius-card); background: var(--color-card); box-shadow: none; }
.card-kicker { color: var(--color-primary); font-size: 24rpx; font-weight: 700; letter-spacing: 1rpx; }
.card-kicker--spark { display: flex; gap: 12rpx; align-items: center; }
.card-kicker--spark view { width: 9rpx; height: 9rpx; transform: rotate(45deg); background: var(--color-accent); }
.overview-title { margin-top: 19rpx; color: #173F35; font-size: 32rpx; font-weight: 720; line-height: 47rpx; }
.metrics-grid { display: flex; margin-top: 24rpx; padding: 22rpx 4rpx; border: 1rpx solid var(--color-border-soft); border-radius: 22rpx; background: var(--color-card-soft); }
.metric { display: flex; min-width: 0; flex: 1; flex-direction: column; align-items: center; }
.metric + .metric { border-left: 1rpx solid rgba(103,94,77,.12); }
.metric-value { color: #39745F; font-size: 34rpx; font-weight: 740; line-height: 45rpx; white-space: nowrap; }
.metric-value text { font-size: 19rpx; font-weight: 560; }
.metric-label { margin-top: 6rpx; color: #7C817D; font-size: 21rpx; }
.progress-track { height: 7rpx; margin-top: 20rpx; overflow: hidden; border-radius: 4rpx; background: #E5E9E4; }
.progress-fill { height: 100%; border-radius: inherit; background: var(--gradient-progress); }
.diagnosis-main { margin-top: 19rpx; color: #243F36; font-size: 29rpx; font-weight: 680; line-height: 44rpx; }
.diagnosis-stats { display: flex; margin-top: 24rpx; gap: 12rpx; }
.diagnosis-stats view { display: flex; min-width: 0; flex: 1; padding: 18rpx 8rpx; flex-direction: column; align-items: center; border-radius: 18rpx; background: var(--color-primary-soft); }
.diagnosis-stats text:first-child { color: var(--color-primary); font-size: 28rpx; font-weight: 720; }
.diagnosis-stats text:last-child { margin-top: 4rpx; color: #718078; font-size: 19rpx; }
.conversation-title { color: #234C3F; font-size: 27rpx; font-weight: 700; }
.question-list { display: flex; gap: 10rpx; margin-top: 18rpx; overflow-x: auto; }
.question-chip { display: flex; min-width: 190rpx; min-height: 68rpx; padding: 8rpx 20rpx; align-items: center; justify-content: center; border: 1rpx solid var(--color-border-soft); border-radius: var(--radius-pill); color: var(--color-primary); background: var(--color-card-soft); font-size: 22rpx; line-height: 31rpx; text-align: center; }
.message-list { margin-top: 22rpx; padding-top: 4rpx; border-top: 1rpx solid rgba(103,94,77,.10); }
.message-row { margin-top: 18rpx; }
.user-message { max-width: 78%; margin-left: auto; padding: 15rpx 20rpx; border-radius: 20rpx 20rpx 6rpx 20rpx; color: #FFF; background: #39745F; font-size: 22rpx; line-height: 34rpx; }
.assistant-message { display: flex; gap: 13rpx; align-items: flex-start; }
.assistant-mark { display: flex; width: 40rpx; height: 40rpx; flex: none; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-primary-soft); }
.assistant-mark view { width: 12rpx; height: 12rpx; transform: rotate(45deg); border-radius: 2rpx; background: var(--color-primary); }
.assistant-body { min-width: 0; flex: 1; padding: 17rpx 19rpx; border: 1rpx solid rgba(36,91,77,.09); border-radius: 6rpx 20rpx 20rpx 20rpx; background: #FAFBF7; }
.assistant-summary, .reply-full { color: #41584F; font-size: 22rpx; line-height: 35rpx; white-space: pre-wrap; }
.reply-metrics { display: flex; gap: 8rpx; margin-top: 14rpx; }
.reply-metrics view { display: flex; min-width: 0; flex: 1; padding: 12rpx 5rpx; flex-direction: column; align-items: center; border-radius: 13rpx; background: var(--color-primary-soft); }
.reply-metrics text:first-child { color: var(--color-primary); font-size: 23rpx; font-weight: 700; }
.reply-metrics text:last-child { color: #748179; font-size: 17rpx; }
.reply-insights view { margin-top: 10rpx; color: #5D7168; font-size: 21rpx; line-height: 32rpx; }
.reply-suggestion { margin-top: 13rpx; padding: 14rpx 16rpx; border-radius: 14rpx; color: #6F5422; background: var(--color-warning-soft); font-size: 21rpx; line-height: 33rpx; }
.reply-full { margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid rgba(103,94,77,.10); color: #6C7772; }
.reply-toggle { margin-top: 9rpx; color: var(--color-primary); font-size: 20rpx; font-weight: 650; }
.action-proposal { margin-top: 13rpx; padding: 15rpx; border-radius: 14rpx; color: #705522; background: var(--color-warning-soft); font-size: 21rpx; line-height: 32rpx; }
.proposal-button { display: inline-flex; min-height: 52rpx; margin-top: 11rpx; padding: 0 20rpx; align-items: center; border-radius: 26rpx; color: #FFF; background: var(--color-primary); }
.proposal-success { margin-top: 9rpx; color: var(--color-success); font-weight: 650; }
.thinking { display: flex; gap: 12rpx; margin-top: 18rpx; align-items: center; color: #718078; font-size: 21rpx; }
.thinking view { width: 18rpx; height: 18rpx; border: 2rpx solid rgba(36,91,77,.2); border-top-color: var(--color-primary); border-radius: 50%; animation: spin .9s linear infinite; }
.chat-error { display: flex; margin-top: 17rpx; padding: 15rpx 17rpx; align-items: center; justify-content: space-between; border-radius: 15rpx; color: #775A25; background: var(--color-warning-soft); font-size: 21rpx; }
.chat-error view { color: var(--color-primary); font-weight: 650; }
.input-bar { display: flex; gap: 10rpx; margin-top: 22rpx; padding: 8rpx 9rpx 8rpx 20rpx; align-items: center; border: 1rpx solid var(--color-border-soft); border-radius: var(--radius-pill); background: var(--color-card); }
.coach-input { width: 0; min-width: 0; height: 68rpx; flex: 1; color: var(--color-text-main); font-size: 24rpx; }
.coach-placeholder { color: #99A39E; }
.send-control { display: flex; width: 68rpx; min-width: 68rpx; max-width: 68rpx; height: 68rpx; flex: none; align-items: center; justify-content: center; border-radius: 50%; color: var(--color-text-inverse); background: var(--color-primary); }
.send-control.is-disabled { opacity: .45; }
@keyframes spin { to { transform: rotate(360deg); } }
@media (max-width: 350px) {
  .insight-nav, .insight-content { padding-left: 24rpx; }
  .insight-content { padding-right: 24rpx; }
  .nav-title { font-size: 32rpx; }
  .insight-card { padding-right: 26rpx; padding-left: 26rpx; }
  .metric-value { font-size: 30rpx; }
}
