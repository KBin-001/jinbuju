.coach-page {
  --coach-bg: #FFFDF8;
  --coach-paper: rgba(255, 255, 255, 0.92);
  --coach-ink: #16372F;
  --coach-sub: #6F7974;
  --coach-green: #3F8468;
  --coach-green-deep: #2F6D55;
  --coach-mint: #EAF5EE;
  --coach-line: #DCE8E1;
  --coach-shadow: 0 14rpx 36rpx rgba(38, 65, 53, 0.09);

  position: relative;
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #FFFAF0 0%, #F7F3E9 38%, #FFFDF8 100%);
  color: var(--coach-ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.coach-page__mountain {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 410rpx;
  opacity: 0.96;
}

.coach-page__fade {
  position: absolute;
  top: 290rpx;
  left: 0;
  right: 0;
  height: 150rpx;
  background: linear-gradient(180deg, rgba(255, 253, 248, 0), #FFFDF8 78%);
}

.coach-nav {
  position: relative;
  z-index: 8;
  height: 96rpx;
  padding: calc(env(safe-area-inset-top) + 8rpx) 30rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: content-box;
}

.coach-nav__back {
  position: relative;
  z-index: 2;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  color: #111111;
  font-size: 64rpx;
  font-weight: 300;
  line-height: 1;
  transition: opacity 0.15s;
}

.coach-nav__back--pressed { opacity: 0.5; }

.coach-nav__title {
  position: absolute;
  left: 0;
  right: 0;
  color: #111111;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
  text-align: center;
  pointer-events: none;
}

.coach-nav__safe { width: 170rpx; }

.coach-scroll {
  position: absolute;
  z-index: 3;
  top: calc(env(safe-area-inset-top) + 112rpx);
  right: 0;
  bottom: calc(116rpx + env(safe-area-inset-bottom));
  left: 0;
}

.coach-content { padding: 56rpx 30rpx 36rpx; }

/* 教练概览 */
.coach-hero {
  min-height: 270rpx;
  padding: 28rpx 26rpx;
  display: grid;
  grid-template-columns: 154rpx minmax(0, 1fr) 142rpx;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(181, 206, 193, 0.72);
  border-radius: 42rpx;
  background: linear-gradient(120deg, rgba(255, 255, 255, 0.84), rgba(239, 249, 243, 0.70));
  box-shadow: var(--coach-shadow);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.coach-hero__avatar-wrap {
  width: 148rpx;
  height: 148rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #D7E9DF;
  border-radius: 50%;
  background: rgba(239, 248, 242, 0.86);
  box-shadow: inset 0 0 0 10rpx rgba(255, 255, 255, 0.62);
}

.coach-hero__avatar { width: 126rpx; height: 126rpx; }
.coach-hero__copy { min-width: 0; }

.coach-hero__title {
  display: block;
  color: #111111;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.3;
}

.coach-hero__line {
  display: block;
  margin-top: 8rpx;
  color: #2D3935;
  font-size: 23rpx;
  line-height: 1.35;
}

.coach-status {
  height: 48rpx;
  margin-top: 14rpx;
  padding: 0 18rpx;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  border-radius: 24rpx;
  background: #E7F2EB;
  color: #39725B;
  font-size: 21rpx;
}

.coach-status__dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #4AA077; }

.coach-score {
  width: 138rpx;
  height: 138rpx;
  padding: 13rpx;
  box-sizing: border-box;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(47, 109, 85, 0.10);
}

.coach-score__inner {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
}

.coach-score__number { color: var(--coach-green); font-size: 44rpx; font-weight: 800; line-height: 1; }
.coach-score__unit { color: var(--coach-green); font-size: 23rpx; font-weight: 700; }
.coach-score__label { margin-top: 7rpx; color: #68736E; font-size: 19rpx; }

/* 通用区块 */
.coach-section {
  margin-top: 26rpx;
  padding: 26rpx;
  box-sizing: border-box;
  border: 1rpx solid #E8EEE9;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 30rpx rgba(42, 62, 50, 0.065);
}

.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.section-heading__title { color: #111111; font-size: 32rpx; font-weight: 850; line-height: 1.2; }
.section-heading__action { height: 54rpx; padding: 0 20rpx; display: flex; align-items: center; border: 1rpx solid #DCE8E1; border-radius: 27rpx; color: #4C745F; font-size: 20rpx; }
.section-heading__link { padding: 10rpx 0 10rpx 20rpx; color: #818A85; font-size: 21rpx; }

/* 教练发现 */
.discovery-section { padding: 24rpx; }
.section-heading__title--compact { font-size: 26rpx; }
.section-heading__meta { color: #A0A6A2; font-size: 19rpx; }

.discovery-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.discovery-card {
  min-height: 166rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #EAF3ED;
}

.discovery-card__head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.discovery-card__label { color: #65716B; font-size: 20rpx; line-height: 1.2; }
.discovery-card__signal { flex: none; font-size: 18rpx; font-weight: 700; }
.discovery-card__signal--down { color: #E76055; }
.discovery-card__signal--up, .discovery-card__signal--flat { color: #38A965; }
.discovery-card__signal--warm, .discovery-card__signal--chart { color: #EE9B4A; }
.discovery-card__value { margin-top: 8rpx; display: flex; align-items: baseline; }
.discovery-card__number { color: var(--coach-green); font-size: 42rpx; font-weight: 850; line-height: 1; }
.discovery-card__unit { margin-left: 4rpx; color: var(--coach-green-deep); font-size: 22rpx; font-weight: 650; }
.discovery-card__helper { display: block; margin-top: 12rpx; color: #8A938E; font-size: 19rpx; line-height: 1.35; }

/* 问教练 */
.question-scroll { width: 100%; margin-top: 18rpx; white-space: nowrap; }
.question-row { display: inline-flex; gap: 12rpx; padding-right: 20rpx; }
.question-chip { height: 58rpx; padding: 0 24rpx; display: inline-flex; align-items: center; border: 1rpx solid #E2E5E1; border-radius: 29rpx; background: #FFFFFF; color: #3F4944; font-size: 21rpx; }

.ask-input-row { margin-top: 20rpx; display: grid; grid-template-columns: minmax(0, 1fr) 76rpx; gap: 16rpx; }
.ask-input { height: 76rpx; padding: 0 28rpx; box-sizing: border-box; border: 1rpx solid #E3E8E4; border-radius: 38rpx; background: #FBFBF8; color: #33423C; font-size: 22rpx; }
.ask-send { width: 76rpx; height: 76rpx; transition: opacity 0.15s, transform 0.15s; }
.ask-send image { width: 100%; height: 100%; }
.ask-send--pressed { opacity: 0.74; transform: scale(0.94); }

.coach-reply { margin-top: 20rpx; padding: 20rpx; display: grid; grid-template-columns: 58rpx minmax(0, 1fr); gap: 16rpx; border: 1rpx solid #DCE9E1; border-radius: 26rpx; background: linear-gradient(180deg, #F7FCF9, #F0F8F3); }
.coach-reply__avatar { width: 58rpx; height: 58rpx; }
.coach-reply__title { display: block; color: var(--coach-green); font-size: 22rpx; font-weight: 800; }
.coach-reply__text { display: block; margin-top: 8rpx; color: #4B5752; font-size: 21rpx; line-height: 1.55; }

/* 底部导航 */
.coach-tabbar {
  position: absolute;
  z-index: 12;
  right: 0;
  bottom: 0;
  left: 0;
  height: calc(106rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  align-items: center;
  box-sizing: border-box;
  border-top: 1rpx solid #E7E7E3;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 -8rpx 24rpx rgba(40, 60, 50, 0.05);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.coach-tabbar__item { display: flex; flex-direction: column; align-items: center; gap: 5rpx; color: #898F8B; font-size: 20rpx; }
.coach-tabbar__item image { width: 45rpx; height: 45rpx; opacity: 0.68; }
.coach-tabbar__item--active { color: var(--coach-green); font-weight: 800; }
.coach-tabbar__item--active image { opacity: 1; }
