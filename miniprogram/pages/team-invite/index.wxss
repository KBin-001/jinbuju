page { background: #f7f3ea; }
.invite-page { min-height: 100vh; color: #24312d; }
.invite-hero { position: relative; height: 360rpx; overflow: hidden; padding: 72rpx 42rpx 36rpx; box-sizing: border-box; }
.invite-hero__image,.invite-hero__veil { position: absolute; inset: 0; width: 100%; height: 100%; }
.invite-hero__veil { background: linear-gradient(180deg, rgba(247,243,234,.12), rgba(247,243,234,.92)); }
.invite-kicker,.invite-title,.invite-members { position: relative; z-index: 2; }
.invite-kicker { color: #7c817d; font-size: 24rpx; }
.invite-title { margin-top: 12rpx; color: #245b4d; font-family: "Songti SC", STSong, serif; font-size: 48rpx; font-weight: 700; }
.invite-members { margin-top: 36rpx; display: flex; align-items: center; color: #59645f; font-size: 24rpx; }
.invite-avatar { width: 64rpx; height: 64rpx; margin-left: -10rpx; overflow: hidden; display: flex; align-items: center; justify-content: center; border: 4rpx solid #fffcf6; border-radius: 50%; background: #e8f0eb; color: #245b4d; font-size: 20rpx; }
.invite-avatar:first-child { margin-left: 0; }.invite-avatar image { width: 100%; height: 100%; }.invite-members>text { margin-left: 18rpx; }
.invite-content { padding: 0 32rpx 64rpx; }
.room-card { position: relative; height: 230rpx; overflow: hidden; padding: 34rpx; border-radius: 28rpx; background: #fffcf6; box-shadow: 0 12rpx 30rpx rgba(55,67,60,.08); }
.room-card__image,.room-card__veil { position: absolute; inset: 0; width: 100%; height: 100%; }.room-card__image { opacity: .52; }.room-card__veil { background: linear-gradient(90deg,rgba(255,252,246,.98),rgba(255,252,246,.68)); }
.room-card__label,.room-card__code,.room-card__copy { position: relative; z-index: 2; display: block; }.room-card__label { color: #7c817d; font-size: 23rpx; }.room-card__code { margin-top: 12rpx; color: #245b4d; font-family: Georgia,serif; font-size: 52rpx; font-weight: 700; letter-spacing: 10rpx; }.room-card__copy { width: 150rpx; height: 58rpx; margin-top: 18rpx; display: flex; align-items: center; justify-content: center; border-radius: 30rpx; background: rgba(255,252,246,.86); color: #916b2f; font-size: 22rpx; }
.share-button,.secondary-button,.join-button { height: 88rpx; margin-top: 22rpx; display: flex; align-items: center; justify-content: center; border-radius: 44rpx; font-size: 28rpx; font-weight: 650; }.share-button { width: 100%; padding: 0; background: #245b4d; color: #fff; line-height: 88rpx; }.share-button::after { border: 0; }.secondary-button { border: 1rpx solid rgba(36,91,77,.24); background: #fffcf6; color: #245b4d; }.join-button { margin-top: 14rpx; color: #7a5d28; background: #f6ead0; }
.reserve-card { margin-top: 28rpx; padding: 24rpx 28rpx; border: 1rpx solid rgba(103,94,77,.14); border-radius: 24rpx; background: rgba(255,252,246,.76); }.reserve-title { margin-bottom: 8rpx; font-size: 27rpx; font-weight: 700; }.reserve-row { min-height: 68rpx; display: flex; align-items: center; justify-content: space-between; color: #7c817d; font-size: 24rpx; }.reserve-chip { padding: 7rpx 14rpx; border-radius: 18rpx; background: #ece9e1; color: #969994; font-size: 20rpx; }.invite-note { margin-top: 22rpx; color: #858a86; font-size: 22rpx; line-height: 34rpx; text-align: center; }
