page { background: #F7F3EA; }
.welcome-page { position: relative; min-height: 100vh; padding: calc(42rpx + env(safe-area-inset-top)) 40rpx calc(34rpx + env(safe-area-inset-bottom)); overflow: hidden; color: #24312D; background: #F7F3EA; }
.welcome-mountain { position: absolute; top: 0; right: 0; width: 100%; height: 58vh; opacity: .94; }
.welcome-mountain-veil { position: absolute; inset: 0 0 auto; height: 66vh; background: linear-gradient(180deg, rgba(247,243,234,.08), rgba(247,243,234,.38) 58%, #F7F3EA 100%); }
.welcome-state, .welcome-content { position: relative; z-index: 2; }
.welcome-state { min-height: calc(100vh - 120rpx); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.welcome-content { min-height: calc(100vh - 76rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom)); display: flex; flex-direction: column; }
.brand { display: flex; align-items: center; }
.brand-mark { width: 62rpx; height: 62rpx; padding: 13rpx; display: flex; align-items: flex-end; justify-content: center; gap: 5rpx; border-radius: 20rpx; background: #245B4D; box-shadow: 0 10rpx 26rpx rgba(36,91,77,.16); }
.brand-step { width: 8rpx; border-radius: 4rpx 4rpx 2rpx 2rpx; background: #FFFCF6; }
.brand-step-small { height: 12rpx; opacity: .65; }
.brand-step-medium { height: 22rpx; opacity: .82; }
.brand-step-large { height: 34rpx; }
.brand-name { margin-left: 16rpx; color: #245B4D; font-family: "Songti SC", STSong, serif; font-size: 34rpx; font-weight: 700; letter-spacing: 4rpx; }
.hero { margin-top: 13vh; }
.hero-label { display: inline-flex; padding: 9rpx 18rpx; border: 1rpx solid rgba(200,155,74,.22); border-radius: 24rpx; background: rgba(255,252,246,.78); color: #9A712E; font-size: 23rpx; font-weight: 650; }
.hero-title { max-width: 650rpx; margin-top: 24rpx; color: #24312D; font-family: "Songti SC", STSong, serif; font-size: 58rpx; font-weight: 700; line-height: 1.34; letter-spacing: 1rpx; }
.hero-subtitle { max-width: 600rpx; margin-top: 22rpx; color: #626B66; font-size: 27rpx; line-height: 1.7; }
.example-card { margin-top: 30rpx; padding: 26rpx; border: 1rpx solid rgba(121,111,91,.13); border-radius: 28rpx; background: rgba(255,252,246,.94); box-shadow: 0 8rpx 24rpx rgba(75,62,40,.06); }
.example-heading { display: flex; align-items: flex-start; justify-content: space-between; }
.example-tag { color: #9A712E; font-size: 21rpx; font-weight: 650; }
.example-title { margin-top: 7rpx; color: #24312D; font-size: 28rpx; font-weight: 700; }
.example-day { padding: 7rpx 14rpx; border-radius: 14rpx; background: #F5E9D2; color: #856126; font-size: 21rpx; }
.example-task { margin-top: 20rpx; padding-top: 20rpx; display: flex; align-items: center; border-top: 1rpx solid rgba(121,111,91,.13); }
.task-check { width: 50rpx; height: 50rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #E5EEE8; color: #245B4D; font-weight: 700; }
.task-content { margin-left: 16rpx; }
.task-title { color: #24312D; font-size: 26rpx; font-weight: 650; }
.task-meta, .example-note { margin-top: 5rpx; color: #7C817D; font-size: 21rpx; }
.example-note { margin-top: 18rpx; }
.welcome-actions { margin-top: auto; padding-top: 28rpx; }
.start-button, .example-button { width: 100%; height: 92rpx; display: flex; align-items: center; justify-content: center; border-radius: 46rpx; font-size: 28rpx; font-weight: 680; }
.start-button { background: #245B4D; color: #FFFCF6; box-shadow: 0 12rpx 30rpx rgba(36,91,77,.18); }
.example-button { margin-top: 14rpx; border: 1rpx solid rgba(36,91,77,.2); background: rgba(255,252,246,.8); color: #245B4D; }
.start-button-active, .example-button-active { opacity: .86; transform: scale(.985); }
@media (max-height: 700px) { .hero { margin-top: 7vh; } .hero-title { font-size: 50rpx; } .example-card { margin-top: 20rpx; padding: 21rpx; } .start-button, .example-button { height: 82rpx; } }
