.action-button-shell + .action-button-shell { margin-top: 10rpx; }
.start-button, .example-button { height: 72rpx; border-radius: 36rpx; font-size: 23rpx; line-height: 72rpx; }

.example-sheet-layer { position: fixed; z-index: 13000; inset: 0; }
.example-sheet-mask { position: absolute; inset: 0; background: rgba(28,35,32,.43); }
.example-sheet { position: absolute; right: 0; bottom: 0; left: 0; padding: 12rpx 30rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 34rpx 34rpx 0 0; background: #FBF8F0; box-shadow: 0 -18rpx 50rpx rgba(23,45,37,.16); }
.example-sheet-handle { width: 76rpx; height: 7rpx; margin: 0 auto 18rpx; border-radius: 4rpx; background: rgba(36,49,45,.16); }
.example-sheet-head { min-height: 76rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.example-sheet-head > view:first-child { min-width: 0; flex: 1; }
.example-sheet-kicker, .example-sheet-title { display: block; }
.example-sheet-kicker { color: #9A712E; font-size: 20rpx; }
.example-sheet-title { margin-top: 4rpx; color: #24312D; font-family: "Songti SC", STSong, serif; font-size: 31rpx; line-height: 42rpx; font-weight: 700; }
.example-sheet-close { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; flex: none; border-radius: 50%; background: #EEE9DD; color: #65716C; }
.example-sheet-copy { margin-top: 16rpx; color: #65706B; font-size: 22rpx; line-height: 35rpx; }
.example-sheet-steps { margin-top: 20rpx; display: grid; gap: 12rpx; }
.example-sheet-steps > view { min-height: 72rpx; display: flex; align-items: center; padding: 12rpx 16rpx; border-radius: 18rpx; background: rgba(232,240,235,.74); }
.example-sheet-steps > view > text { width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; flex: none; border-radius: 50%; background: #245B4D; color: #FFF; font-weight: 700; }
.example-sheet-steps > view > view { min-width: 0; margin-left: 14rpx; }
.example-sheet-steps > view > view text { display: block; color: #245B4D; font-size: 22rpx; font-weight: 700; }
.example-sheet-steps > view > view text + text { margin-top: 3rpx; color: #727B76; font-size: 18rpx; font-weight: 400; }
.example-sheet-action { width: 100%; height: 76rpx; margin: 22rpx 0 0; border: 0; border-radius: 38rpx; background: #245B4D; color: #FFF; font-size: 24rpx; line-height: 76rpx; }
.example-sheet-action::after { border: 0; }

@media (max-height: 700px) {
  .welcome-content { padding-top: calc(24rpx + env(safe-area-inset-top)); padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); }
  .brand { min-height: 66rpx; }
  .brand-mark { width: 58rpx; height: 58rpx; padding: 11rpx; }
  .hero { margin-top: auto; }
  .hero-title { font-size: 41rpx; }
  .hero-subtitle { font-size: 19rpx; line-height: 1.4; }
  .showcase { height: 370rpx; margin-top: auto; }
  .goal-demo-card { top: 31rpx; transform: rotate(-.8deg) scale(.91); transform-origin: top left; }
  .task-demo-card { top: 59rpx; transform: rotate(1.3deg) scale(.91); transform-origin: top right; }
  .capability-card { min-height: 118rpx; }
  .capability-desc { display: none; }
  .welcome-actions { padding-top: 0; }
  .start-button, .example-button { height: 64rpx; line-height: 64rpx; }
}
