.progress-copy { font-size: 16rpx; }
.goal-demo-stats { margin-top: 13rpx; }
.stat-label { font-size: 15rpx; }
.stat-value { margin-top: 5rpx; font-size: 24rpx; }
.stat-value text { font-size: 12rpx; }
.goal-demo-note { min-height: 45rpx; margin-top: 13rpx; padding: 9rpx 12rpx; font-size: 15rpx; }
.task-demo-card { top: 68rpx; width: 230rpx; min-height: 300rpx; padding: 17rpx 14rpx 17rpx 30rpx; }
.task-demo-head { font-size: 16rpx; }
.task-demo-item { margin-top: 14rpx; }
.task-demo-item text { font-size: 16rpx; }
