.brand-copy { margin-left: 14rpx; }
.brand-name { font-size: 28rpx; }
.hero { margin-top: auto; }
.hero-label { padding: 7rpx 15rpx; font-size: 20rpx; }
.hero-title { margin-top: 15rpx; font-size: 46rpx; line-height: 1.3; }
.hero-subtitle { max-width: 650rpx; margin-top: 12rpx; font-size: 22rpx; line-height: 1.52; }
.showcase { height: 410rpx; margin-top: auto; flex: none; }
.showcase-label { top: 0; font-size: 16rpx; }
.goal-demo-card { top: 36rpx; width: 470rpx; padding: 17rpx; border-radius: 22rpx; }
.goal-demo-icon { width: 54rpx; height: 54rpx; }
.goal-demo-title { font-size: 24rpx; }
