page { background: #F7F3EA; }

.welcome-page { position: relative; min-height: 100vh; overflow: hidden; color: var(--color-text-main, #24312D); background: #F7F3EA; }
.welcome-mountain { position: absolute; z-index: 0; top: 190rpx; right: -92rpx; width: 900rpx; height: 1080rpx; opacity: .78; }
.welcome-mountain-veil { position: absolute; z-index: 1; inset: 0 0 auto; height: 1260rpx; background: linear-gradient(180deg, rgba(247,243,234,.06), rgba(247,243,234,.18) 45%, rgba(247,243,234,.7) 76%, #F7F3EA 100%); pointer-events: none; }
.welcome-state, .welcome-content { position: relative; z-index: 2; }
.welcome-state { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 48rpx 32rpx; text-align: center; }
.welcome-content { padding: calc(38rpx + env(safe-area-inset-top)) 40rpx calc(38rpx + env(safe-area-inset-bottom)); }

.brand { min-height: 92rpx; display: flex; align-items: center; }
.brand-mark { width: 70rpx; height: 70rpx; flex: none; padding: 14rpx; display: flex; align-items: flex-end; justify-content: center; gap: 6rpx; border-radius: 20rpx; background: linear-gradient(145deg, #1D6654, #174A3F); box-shadow: 0 10rpx 24rpx rgba(36,91,77,.17); }
.brand-step { width: 9rpx; border-radius: 5rpx 5rpx 2rpx 2rpx; background: #FFFCF6; }
.brand-step-small { height: 18rpx; opacity: .72; }
.brand-step-medium { height: 30rpx; opacity: .88; }
.brand-step-large { height: 42rpx; }
.brand-copy { min-width: 0; margin-left: 18rpx; display: flex; flex-direction: column; overflow: hidden; }
.brand-name { color: #245B4D; font-family: "Songti SC", STSong, serif; font-size: 32rpx; font-weight: 700; line-height: 1.15; letter-spacing: 2rpx; white-space: nowrap; }
.brand-slogan { max-width: 100%; margin-top: 7rpx; overflow: hidden; color: #747D78; font-size: 20rpx; line-height: 1.2; letter-spacing: 1rpx; text-overflow: ellipsis; white-space: nowrap; }
.brand-subname { color: #245B4D; font-weight: 650; }

.hero { margin-top: 62rpx; }
.hero-label { display: inline-flex; padding: 9rpx 18rpx; border: 1rpx solid rgba(200,155,74,.28); border-radius: 24rpx; background: rgba(255,252,246,.72); color: #9A712E; font-size: 23rpx; font-weight: 650; }
.hero-title { max-width: 670rpx; margin-top: 23rpx; color: #153D33; font-family: "Songti SC", STSong, serif; font-size: 54rpx; font-weight: 700; line-height: 1.42; letter-spacing: 2rpx; }
.hero-title text { display: block; }
.hero-subtitle { max-width: 610rpx; margin-top: 20rpx; color: #5F6964; font-size: 26rpx; line-height: 1.7; }
.hero-positioning { margin-top: 14rpx; color: #245B4D; font-size: 21rpx; font-weight: 650; letter-spacing: 2rpx; }

.showcase { position: relative; height: 560rpx; margin-top: 28rpx; }
.showcase-label { position: absolute; z-index: 5; top: 8rpx; left: 12rpx; padding: 7rpx 15rpx; border-radius: 999rpx; background: rgba(255,252,246,.92); color: #8B6A30; font-size: 19rpx; font-weight: 650; box-shadow: 0 4rpx 14rpx rgba(75,62,40,.06); }
.goal-demo-card, .task-demo-card { box-sizing: border-box; border: 1rpx solid rgba(36,91,77,.1); background: rgba(255,252,246,.96); box-shadow: 0 20rpx 42rpx rgba(45,66,57,.12); }
.goal-demo-card { position: absolute; z-index: 3; top: 50rpx; left: 0; width: 460rpx; padding: 22rpx; transform: rotate(-1.2deg); border-radius: 26rpx; }
.goal-demo-head { display: flex; align-items: center; }
.goal-demo-icon { width: 62rpx; height: 62rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 17rpx; background: #245B4D; color: #FFFDF7; }
.goal-demo-copy { min-width: 0; margin-left: 13rpx; }
.goal-demo-title { overflow: hidden; color: #24312D; font-size: 28rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.goal-demo-meta { margin-top: 6rpx; overflow: hidden; color: #7C817D; font-size: 17rpx; text-overflow: ellipsis; white-space: nowrap; }
.progress-ring { width: 66rpx; height: 66rpx; flex: none; margin-left: auto; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 6rpx solid #245B4D; border-left-color: #DCE6DF; border-radius: 50%; color: #24312D; font-size: 21rpx; font-weight: 700; line-height: 1.1; }
.progress-ring view { margin-top: 2rpx; color: #7C817D; font-size: 14rpx; font-weight: 400; }
.goal-demo-progress { margin-top: 20rpx; padding: 16rpx 18rpx; border: 1rpx solid rgba(36,91,77,.1); border-radius: 16rpx; }
.progress-copy { display: flex; align-items: center; justify-content: space-between; color: #65706B; font-size: 18rpx; }
.progress-track { height: 9rpx; margin-top: 10rpx; overflow: hidden; border-radius: 999rpx; background: #E7E8DF; }
.progress-fill { width: 50%; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #7F9D91, #245B4D); }
.goal-demo-stats { margin-top: 20rpx; display: grid; grid-template-columns: repeat(3, 1fr); text-align: center; }
.goal-demo-stats > view { min-width: 0; padding: 0 8rpx; border-right: 1rpx solid rgba(36,91,77,.1); }
.goal-demo-stats > view:last-child { border-right: 0; }
.stat-label, .stat-value { display: block; }
.stat-label { color: #727B76; font-size: 18rpx; }
.stat-value { margin-top: 10rpx; color: #24312D; font-family: Georgia, serif; font-size: 28rpx; }
.stat-value text { font-family: inherit; font-size: 15rpx; }
.goal-demo-note { margin-top: 20rpx; min-height: 58rpx; display: flex; align-items: center; padding: 13rpx 15rpx; border: 1rpx solid rgba(36,91,77,.09); border-radius: 15rpx; color: #245B4D; font-size: 18rpx; }
.goal-demo-note text { margin-left: 8rpx; color: #4F5E58; }
.task-demo-card { position: absolute; z-index: 2; top: 92rpx; right: 0; width: 240rpx; min-height: 402rpx; padding: 22rpx 18rpx 22rpx 42rpx; transform: rotate(2deg); border-radius: 24rpx; }
.task-demo-head { display: flex; align-items: center; justify-content: space-between; color: #5F6964; font-size: 19rpx; font-weight: 650; }
.task-demo-item { margin-top: 20rpx; display: flex; align-items: flex-start; color: #99A09C; }
.task-demo-item--done { color: #245B4D; }
.task-demo-item > view:last-child { min-width: 0; margin-left: 8rpx; }
.task-demo-item text { display: block; overflow: hidden; color: #525E58; font-size: 19rpx; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.task-demo-item text + text { margin-top: 5rpx; color: #929894; font-size: 16rpx; }
.task-dot { width: 23rpx; height: 23rpx; flex: none; border: 1rpx solid #C8CECA; border-radius: 50%; }
.example-explain { margin: -16rpx 18rpx 28rpx; padding: 24rpx 26rpx; border-left: 5rpx solid #7F9D91; border-radius: 4rpx 18rpx 18rpx 4rpx; background: rgba(255,252,246,.88); color: #66716C; font-size: 22rpx; line-height: 1.65; }
.example-explain-title { margin-bottom: 8rpx; color: #245B4D; font-size: 25rpx; font-weight: 700; }

.capability-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18rpx; }
.capability-card { min-height: 192rpx; display: flex; align-items: center; justify-content: center; padding: 22rpx 18rpx; border: 1rpx solid rgba(36,91,77,.1); border-radius: 24rpx; background: rgba(255,252,246,.94); box-shadow: 0 10rpx 24rpx rgba(49,57,50,.065); text-align: left; }
.capability-icon { width: 58rpx; height: 58rpx; margin-right: 9rpx; flex: none; display: flex; align-items: center; justify-content: center; color: #245B4D; }
.capability-title, .capability-desc { display: block; }
.capability-title { color: #245B4D; font-size: 22rpx; font-weight: 700; white-space: nowrap; }
.capability-desc { margin-top: 8rpx; color: #65706B; font-size: 19rpx; line-height: 1.55; }
.capability-desc text { display: block; }

.audience-section { margin-top: 38rpx; }
.section-heading { display: flex; align-items: center; justify-content: center; color: #245B4D; font-size: 25rpx; font-weight: 700; }
.section-heading view { width: 90rpx; height: 1rpx; margin: 0 20rpx; background: linear-gradient(90deg, transparent, #7F9D91); }
.section-heading view:last-child { transform: rotate(180deg); }
.audience-list { margin-top: 20rpx; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24rpx; }
.audience-pill { height: 72rpx; display: flex; align-items: center; justify-content: center; gap: 13rpx; border: 1rpx solid rgba(36,91,77,.13); border-radius: 999rpx; background: rgba(245,246,239,.78); color: #245B4D; font-size: 24rpx; font-weight: 700; }

.feedback-card { margin-top: 28rpx; min-height: 128rpx; display: grid; grid-template-columns: auto 190rpx 1fr; align-items: center; gap: 16rpx; padding: 22rpx 24rpx; border: 1rpx solid rgba(36,91,77,.1); border-radius: 20rpx; background: rgba(255,252,246,.76); }
.feedback-badge { width: 66rpx; height: 66rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #E8F0EB; color: #245B4D; }
.feedback-title { color: #245B4D; font-size: 25rpx; font-weight: 700; }
.feedback-subtitle { margin-top: 6rpx; color: #6F7974; font-size: 18rpx; line-height: 1.45; }
.feedback-note { padding: 17rpx 20rpx; border-radius: 14rpx; background: rgba(232,240,235,.72); color: #64716B; font-size: 19rpx; line-height: 1.55; }

.steps-card { margin-top: 24rpx; display: flex; align-items: center; padding: 22rpx; border: 1rpx solid rgba(36,91,77,.1); border-radius: 20rpx; background: rgba(255,252,246,.78); }
.steps-title { width: 84rpx; flex: none; color: #245B4D; font-size: 24rpx; font-weight: 700; line-height: 1.25; }
.steps-title text { display: block; }
.step-item { min-width: 0; flex: 1; display: flex; align-items: center; }
.step-number { width: 38rpx; height: 38rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #245B4D; color: white; font-size: 20rpx; font-weight: 700; }
.step-item view { min-width: 0; margin-left: 9rpx; }
.step-item view text { display: block; color: #245B4D; font-size: 20rpx; font-weight: 700; white-space: nowrap; }
.step-item view text + text { margin-top: 3rpx; color: #737C78; font-size: 15rpx; font-weight: 400; }
.step-arrow { flex: none; color: #9EB4AA; }

.welcome-actions { margin-top: 30rpx; }
.agreement-check { margin-bottom: 20rpx; color: #616B66; font-size: 22rpx; line-height: 34rpx; text-align: center; }
.agreement-check label { display: inline-flex; align-items: center; }
.agreement-check checkbox { transform: scale(.78); transform-origin: center; }
.agreement-links { display: inline-flex; justify-content: center; }
.agreement-links text { color: #245B4D; font-weight: 600; }
.agreement-error { margin: -6rpx 0 16rpx; color: #9B554D; font-size: 22rpx; line-height: 32rpx; text-align: center; }
.action-button-shell { width: 100%; display: block; }
.action-button-shell + .action-button-shell { margin-top: 16rpx; }
.start-button, .example-button { width: 100%; height: 88rpx; margin: 0; padding: 0 32rpx; display: flex; align-items: center; justify-content: center; border-radius: 44rpx; font-size: 27rpx; font-weight: 680; line-height: 88rpx; }
.start-button::after, .example-button::after { border: 0; }
.start-button { background: linear-gradient(90deg, #1D6957, #145142); color: #FFFCF6; box-shadow: 0 12rpx 28rpx rgba(36,91,77,.17); }
.start-button[disabled] { opacity: 1; background: #A9C0B7; color: rgba(255,255,255,.96) !important; box-shadow: none; }
.example-button { border: 1rpx solid rgba(36,91,77,.48); background: rgba(255,252,246,.78); color: #245B4D; }
.welcome-button--pressed { opacity: .86; transform: scale(.992); }

@media (max-width: 350px) {
  .welcome-content { padding-right: 28rpx; padding-left: 28rpx; }
  .brand-mark { width: 60rpx; height: 60rpx; padding: 12rpx; }
  .brand-copy { margin-left: 12rpx; }
  .brand-name { font-size: 26rpx; letter-spacing: 1rpx; }
  .hero { margin-top: 42rpx; }
  .hero-title { font-size: 46rpx; }
  .hero-subtitle { font-size: 23rpx; }
  .showcase { height: 530rpx; }
  .goal-demo-card { left: 0; width: 440rpx; padding: 20rpx; }
  .task-demo-card { right: 0; width: 224rpx; padding: 20rpx 15rpx 20rpx 18rpx; }
  .capability-grid { gap: 10rpx; }
  .capability-card { min-height: 188rpx; padding: 18rpx 10rpx; }
  .capability-icon { width: 48rpx; height: 50rpx; margin-right: 5rpx; }
  .capability-title { font-size: 20rpx; }
  .capability-desc { font-size: 17rpx; }
  .audience-list { gap: 12rpx; }
  .audience-pill { gap: 7rpx; font-size: 20rpx; }
  .feedback-card { grid-template-columns: auto 1fr; }
  .feedback-note { grid-column: 1 / -1; }
  .steps-card { align-items: flex-start; overflow: hidden; padding: 18rpx 14rpx; }
  .steps-title { width: 66rpx; font-size: 20rpx; }
  .step-number { width: 32rpx; height: 32rpx; font-size: 17rpx; }
  .step-item view { margin-left: 6rpx; }
  .step-item view text { font-size: 17rpx; }
  .step-item view text + text { display: none; }
  .step-arrow { width: 24rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .goal-demo-card, .task-demo-card { transform: none; }
}

/* 单屏欢迎页：优先展示核心价值、产品示例和开始操作。 */
