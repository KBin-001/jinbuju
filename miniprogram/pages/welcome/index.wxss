page { background: #F7F3EA; }

.welcome-page { height: 100vh; min-height: 0; overflow: hidden; position: relative; color: var(--color-text-main, #24312D); background: #F7F3EA; }
.welcome-mountain { position: absolute; top: 0; right: -160rpx; width: 760rpx; height: 520rpx; opacity: .44; }
.welcome-mountain-veil { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(247,243,234,.2), #F7F3EA 56%, #F7F3EA); pointer-events: none; }
.welcome-state, .welcome-content { position: relative; z-index: 2; }
.welcome-state { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 48rpx 32rpx; text-align: center; }
.state-title { margin-top: 24rpx; font-size: 31rpx; font-weight: 700; }
.state-description { margin: 12rpx 0 28rpx; color: var(--color-text-secondary); }
.welcome-content { height: 100%; display: flex; flex-direction: column; padding: calc(34rpx + env(safe-area-inset-top)) 40rpx calc(24rpx + env(safe-area-inset-bottom)); }

.brand { width: 300rpx; min-height: 72rpx; display: flex; align-items: center; }
.brand-mark { width: 66rpx; height: 66rpx; flex: none; }
.brand-copy { min-width: 0; margin-left: 14rpx; display: flex; flex-direction: column; }
.brand-name { color: #245B4D; font-family: var(--font-family-brand); font-size: 31rpx; font-weight: var(--font-weight-title); line-height: 1.1; letter-spacing: 2rpx; white-space: nowrap; }
.brand-subname { margin-top: 5rpx; color: #6C7772; font-size: 18rpx; line-height: 1; letter-spacing: 1rpx; white-space: nowrap; }

.hero { margin-top: 34rpx; }
.hero-label { color: #8B682D; font-size: 22rpx; font-weight: 650; }
.hero-title { margin-top: 18rpx; color: #173F35; font-family: var(--font-family-brand); font-size: 48rpx; font-weight: var(--font-weight-title); line-height: 1.32; letter-spacing: 1rpx; }
.hero-title text { display: block; }
.hero-subtitle { max-width: 620rpx; margin-top: 15rpx; color: #5F6964; font-size: 24rpx; line-height: 1.6; }

.showcase { position: relative; height: 270rpx; margin-top: 22rpx; }
.showcase-label { position: absolute; z-index: 4; top: 0; left: 18rpx; padding: 6rpx 14rpx; border-radius: 999rpx; background: rgba(255,252,246,.92); color: #8B6A30; font-size: 18rpx; }
.goal-demo-card, .task-demo-card { box-sizing: border-box; border: 1rpx solid rgba(36,91,77,.1); background: rgba(255,252,246,.96); box-shadow: 0 12rpx 28rpx rgba(45,66,57,.08); }
.goal-demo-card { position: absolute; z-index: 2; top: 34rpx; left: 0; width: 470rpx; padding: 22rpx; border-radius: 24rpx; }
.goal-demo-head { display: flex; align-items: center; }
.goal-demo-icon { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: #E8F0EC; color: #245B4D; }
.goal-demo-copy { min-width: 0; margin-left: 13rpx; display: flex; flex-direction: column; }
.goal-demo-copy text:first-child { color: #24312D; font-size: 25rpx; font-weight: 700; }
.goal-demo-copy text:last-child { margin-top: 5rpx; color: #7C817D; font-size: 18rpx; }
.goal-demo-rate { margin-left: auto; color: #245B4D; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 31rpx; font-weight: var(--font-weight-numeric); }
.progress-track { height: 8rpx; margin-top: 18rpx; overflow: hidden; border-radius: 999rpx; background: #E3E9E5; }
.progress-fill { width: 72%; height: 100%; border-radius: inherit; background: #245B4D; }
.task-demo-card { position: absolute; z-index: 3; right: 0; bottom: 0; width: 312rpx; min-height: 142rpx; padding: 22rpx 18rpx 22rpx 42rpx; border-radius: 22rpx; }
.task-demo-head { display: flex; justify-content: space-between; color: #7C817D; font-size: 18rpx; }
.task-demo-title { margin-top: 9rpx; overflow: hidden; color: #24312D; font-size: 23rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.task-demo-action { margin-top: 12rpx; display: flex; align-items: center; color: #245B4D; font-size: 20rpx; font-weight: 650; }
.task-demo-action text { margin-left: 7rpx; }

.capability-grid { margin-top: auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; }
.capability-item { min-width: 0; min-height: 68rpx; display: flex; align-items: center; justify-content: center; gap: 6rpx; color: #245B4D; font-size: 19rpx; font-weight: 650; }
.capability-item text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.welcome-actions { margin-top: 8rpx; }
.agreement-check { display: flex; align-items: center; justify-content: center; color: #6F7773; font-size: 20rpx; }
.agreement-check label { display: flex; align-items: center; }
.agreement-check checkbox { transform: scale(.72); }
.agreement-links { display: flex; margin-left: 4rpx; color: #245B4D; }
.agreement-error { margin-top: 6rpx; color: var(--color-danger); font-size: 20rpx; text-align: center; }
.action-button-shell { width: 100%; display: block; margin-top: 12rpx; }
.start-button, .example-button { width: 100%; height: 84rpx; border-radius: 18rpx; font-size: 27rpx; font-weight: 700; }
.start-button { color: white; background: #245B4D; box-shadow: 0 8rpx 18rpx rgba(36,91,77,.16); }
.start-button[disabled] { color: rgba(255,255,255,.96) !important; background: #9FB3AB !important; }
.example-button { height: 58rpx; color: #557066; background: transparent; font-size: 22rpx; }
.welcome-button--pressed { opacity: .82; transform: scale(.985); }

.example-sheet-layer { position: fixed; z-index: 20; inset: 0; }
.example-sheet-mask { position: absolute; inset: 0; background: rgba(25,35,31,.46); }
.example-sheet { position: absolute; right: 0; bottom: 0; left: 0; padding: 14rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: #FFFCF6; box-shadow: 0 -18rpx 48rpx rgba(36,70,59,.14); }
.example-sheet-handle { width: 72rpx; height: 7rpx; margin: 0 auto 26rpx; border-radius: 999rpx; background: #D7DEDA; }
.example-sheet-head { display: flex; align-items: flex-start; justify-content: space-between; }
.example-sheet-kicker, .example-sheet-title { display: block; }
.example-sheet-kicker { color: #A4772E; font-size: 21rpx; }
.example-sheet-title { margin-top: 7rpx; color: #24312D; font-size: 31rpx; font-weight: 700; }
.example-sheet-close { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; color: #65716B; }
.example-sheet-copy { margin-top: 22rpx; color: #5F6964; font-size: 25rpx; line-height: 1.65; }
.example-sheet-steps { margin-top: 22rpx; }
.example-sheet-steps > view { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid rgba(36,91,77,.08); }
.example-sheet-steps > view > text { width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #E8F0EC; color: #245B4D; font-weight: 700; }
.example-sheet-steps > view > view { margin-left: 16rpx; display: flex; flex-direction: column; }
.example-sheet-steps > view > view text:first-child { color: #24312D; font-size: 25rpx; font-weight: 700; }
.example-sheet-steps > view > view text:last-child { margin-top: 4rpx; color: #7C817D; font-size: 21rpx; }
.example-sheet-action { width: 100%; height: 82rpx; margin-top: 24rpx; border-radius: 18rpx; color: white; background: #245B4D; font-size: 27rpx; font-weight: 700; }

@media (max-width: 350px) {
  .welcome-content { padding-right: 28rpx; padding-left: 28rpx; }
  .hero { margin-top: 22rpx; }
  .hero-title { font-size: 42rpx; }
  .hero-subtitle { font-size: 21rpx; }
  .showcase { height: 238rpx; margin-top: 14rpx; }
  .goal-demo-card { width: 430rpx; }
  .capability-item { font-size: 17rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .start-button, .example-button { transition: none; }
}
