<view class="welcome-page" data-theme="{{appTheme}}">
  <image class="welcome-mountain" src="/assets/today-hero-mountain-v2.jpg" mode="aspectFill" aria-hidden="true" />
  <view class="welcome-mountain-veil"></view>

  <view wx:if="{{status === 'loading'}}" class="welcome-state">
    <t-loading size="44rpx" theme="circular" />
    <view class="state-title">正在准备今日进度</view>
    <view class="state-description">马上就好</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="welcome-state">
    <t-icon name="error-circle" size="52rpx" />
    <view class="state-title">启动失败</view>
    <view class="state-description">{{errorMessage}}</view>
    <t-button class="primary-button" bindtap="retry">重新加载</t-button>
  </view>

  <view wx:else class="welcome-content">
    <view class="brand" aria-label="今日进度｜目标计划打卡">
      <image class="brand-mark" src="/assets/profile/journey-mark.svg" mode="aspectFit" aria-hidden="true" />
      <view class="brand-copy">
        <text class="brand-name">今日进度</text>
        <text class="brand-subname">目标计划打卡</text>
      </view>
    </view>

    <view class="hero">
      <view class="hero-label">记录今日行动，看见目标进度。</view>
      <view class="hero-title"><text>把长期目标，</text><text>变成今天就能完成的行动</text></view>
      <view class="hero-subtitle">先完成一件具体的小事，再让真实记录慢慢汇成成长路径。</view>
    </view>

    <view class="showcase" aria-label="示例目标与任务进度，数据仅作功能演示">
      <view class="showcase-label">界面示例 · 数据仅作功能演示</view>
      <view class="goal-demo-card">
        <view class="goal-demo-head">
          <view class="goal-demo-icon"><t-icon name="flag" size="34rpx" /></view>
          <view class="goal-demo-copy"><text>准备公务员考试</text><text>当前目标 · 12 周</text></view>
          <view class="goal-demo-rate">72%</view>
        </view>
        <view class="progress-track"><view class="progress-fill"></view></view>
      </view>
      <view class="task-demo-card">
        <view class="task-demo-head"><text>今天先做</text><text>45 分钟</text></view>
        <view class="task-demo-title">完成一组申论真题</view>
        <view class="task-demo-action"><t-icon name="play-circle" size="28rpx" /><text>开始行动</text></view>
      </view>
    </view>

    <view class="capability-grid" aria-label="核心能力">
      <view class="capability-item"><t-icon name="flag" size="30rpx" /><text>长期目标管理</text></view>
      <view class="capability-item"><t-icon name="calendar" size="30rpx" /><text>每日行动打卡</text></view>
      <view class="capability-item"><t-icon name="chart-bar" size="30rpx" /><text>真实投入记录</text></view>
    </view>

    <view class="welcome-actions">
      <checkbox-group class="agreement-check" bindchange="onConsentChange">
        <label><checkbox value="agree" checked="{{consentChecked}}" color="#245B4D" /><text>我已阅读并同意</text></label>
        <view class="agreement-links"><text catchtap="openPrivacy">《隐私政策》</text><text catchtap="openTerms">《用户协议》</text></view>
      </checkbox-group>
      <view wx:if="{{errorMessage}}" class="agreement-error">{{errorMessage}}</view>
      <view class="action-button-shell"><button class="start-button" hover-class="welcome-button--pressed" loading="{{submitting}}" disabled="{{!consentChecked || submitting}}" bindtap="startPlanning">{{submitting ? '正在保存' : '开始创建目标'}}</button></view>
      <view class="action-button-shell"><button class="example-button" hover-class="welcome-button--pressed" disabled="{{submitting}}" bindtap="toggleExample">{{showExample ? '收起示例说明' : '先看看怎么用'}}</button></view>
    </view>
  </view>

  <view wx:if="{{showExample}}" class="example-sheet-layer" catchtouchmove="noop">
    <view class="example-sheet-mask" catchtap="toggleExample"></view>
    <view class="example-sheet" catchtap="noop">
      <view class="example-sheet-handle"></view>
      <view class="example-sheet-head"><view><text class="example-sheet-kicker">使用示例</text><text class="example-sheet-title">把目标拆成今天能完成的行动</text></view><view class="example-sheet-close" catchtap="toggleExample" aria-role="button" aria-label="关闭示例说明"><t-icon name="close" size="32rpx" /></view></view>
      <view class="example-sheet-copy">建立长期目标后，只安排今天能做完的一小步。完成时记录实际投入，进度会随真实行动更新。</view>
      <view class="example-sheet-steps"><view><text>1</text><view><text>创建目标</text><text>明确想达成的结果</text></view></view><view><text>2</text><view><text>安排行动</text><text>确定今天具体做什么</text></view></view><view><text>3</text><view><text>记录完成</text><text>保存真实投入和进度</text></view></view></view>
      <button class="example-sheet-action" bindtap="toggleExample">我知道了</button>
    </view>
  </view>
</view>
