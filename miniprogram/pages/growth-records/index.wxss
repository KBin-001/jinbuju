page {
  background: #f7f3ea;
}

.growth-records-page {
  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
  color: var(--color-text-main, #24312d);
  background: #f8f4ec;
  font-family: var(--font-family-sans);
}

.page-hero-art {
  position: absolute;
  z-index: 0;
  width: 1120rpx;
  height: auto;
  top: 50rpx;
  left: -200rpx;
  opacity: .92;
  pointer-events: none;
}

.custom-nav {
  position: relative;
  z-index: 5;
  width: 100%;
}

.custom-nav__inner {
  box-sizing: content-box;
  padding-right: 36rpx;
  padding-left: 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-back,
.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
  flex: none;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  color: #17614f;
}

.nav-title-row {
  display: flex;
  align-items: center;
  gap: 11rpx;
}

.nav-title {
  color: #17614f;
  font-family: var(--font-family-brand);
  font-size: var(--font-section-title);
  font-weight: 550;
  line-height: var(--line-height-section-title);
  letter-spacing: 6rpx;
}

.nav-seal {
  width: auto;
  height: 31rpx;
}

.page-content {
  position: relative;
  z-index: 2;
  padding-bottom: calc(86rpx + env(safe-area-inset-bottom));
}

.growth-records-hero {
  position: relative;
  height: 365rpx;
  margin-top: 2rpx;
  border-bottom: 1rpx solid rgba(99, 99, 88, .16);
}

.hero-copy {
  position: absolute;
  z-index: 2;
  width: 315rpx;
  top: 36rpx;
  left: 44rpx;
}

.hero-eyebrow {
  display: block;
  color: #a77724;
  font-family: var(--font-family-brand);
  font-size: var(--font-meta);
  font-weight: 550;
  line-height: var(--line-height-meta);
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 25rpx;
  display: flex;
  flex-direction: column;
  color: #181d1a;
  font-family: var(--font-family-brand);
  font-size: var(--font-brand-display);
  font-weight: 500;
  line-height: var(--line-height-brand-display);
  letter-spacing: 4rpx;
  white-space: nowrap;
}

.history-entry {
  min-height: 52rpx;
  margin-top: 23rpx;
  display: inline-flex;
  align-items: center;
  color: #17614f;
  font-family: var(--font-family-brand);
  font-size: var(--font-body);
  font-weight: 550;
  line-height: var(--line-height-body);
  letter-spacing: 2rpx;
}

.summary-item {
  position: absolute;
  z-index: 2;
  min-width: 114rpx;
  display: flex;
  align-items: center;
  flex-direction: column;
  text-align: center;
}

.summary-item--actions {
  top: 35rpx;
  left: 336rpx;
}

.summary-item--days {
  top: 52rpx;
  right: 27rpx;
}

.summary-item--minutes {
  top: 205rpx;
  left: 350rpx;
}

.summary-item--streak {
  top: 120rpx;
  left: 504rpx;
}

.summary-value {
  max-width: 168rpx;
  overflow: hidden;
  color: #17614f;
  font-family: var(--font-family-numeric);
  font-variant-numeric: tabular-nums;
  font-size: var(--font-data);
  font-weight: 500;
  line-height: var(--line-height-data);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-value--streak {
  font-size: var(--font-data);
  line-height: var(--line-height-data);
}

.summary-label {
  margin-top: 4rpx;
  color: #303935;
  font-family: var(--font-family-brand);
  font-size: var(--font-meta);
  line-height: var(--line-height-meta);
  white-space: nowrap;
}

.summary-label--streak {
  font-size: var(--font-meta);
}

.filter-section {
  position: relative;
  padding: 28rpx 42rpx 0;
  background: transparent;
}

.filter-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.filter-title {
  color: #202925;
  font-family: var(--font-family-brand);
  font-size: var(--font-card-title);
  font-weight: 550;
  line-height: var(--line-height-card-title);
  letter-spacing: 2rpx;
}

.filter-total {
  color: #6f746f;
  font-family: var(--font-family-brand);
  font-size: var(--font-meta);
  line-height: var(--line-height-meta);
  white-space: nowrap;
}

.goal-filter-scroll {
  width: 100%;
  min-height: 116rpx;
  margin-top: 14rpx;
  white-space: nowrap;
}

.goal-filter-inner {
  position: relative;
  min-width: 100%;
  padding: 0 0 11rpx;
  display: inline-flex;
  align-items: flex-start;
  vertical-align: top;
}

.goal-filter-inner::after {
  position: absolute;
  z-index: 0;
  height: 2rpx;
  right: 0;
  bottom: 25rpx;
  left: 0;
  background: rgba(105, 111, 104, .28);
  content: "";
}

.goal-filter {
  position: relative;
  z-index: 1;
  width: 188rpx;
  min-width: 188rpx;
  max-width: 188rpx;
  height: 104rpx;
  display: inline-flex;
  align-items: center;
  flex-direction: column;
  justify-content: space-between;
  flex: none;
  color: #555f5a;
  font-family: var(--font-family-brand);
  font-size: var(--font-meta);
  line-height: var(--line-height-meta);
  text-align: center;
}

.goal-filter__label {
  width: 174rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goal-filter__node {
  box-sizing: border-box;
  width: 17rpx;
  height: 17rpx;
  margin-bottom: 17rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #929994;
  border-radius: 50%;
  background: #faf7f0;
}

.goal-filter__core {
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
}

.goal-filter.is-active {
  color: #17614f;
}

.goal-filter.is-active .goal-filter__node {
  width: 22rpx;
  height: 22rpx;
  margin-bottom: 14rpx;
  border-color: #b98522;
  box-shadow: 0 0 0 3rpx rgba(185, 133, 34, .10);
}

.goal-filter.is-active .goal-filter__core {
  background: #b98522;
}

.record-filter-bar {
  height: 75rpx;
  margin-top: 2rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  border-top: 1rpx solid rgba(92, 98, 91, .16);
  border-bottom: 1rpx solid rgba(92, 98, 91, .16);
}

.record-filter {
  position: relative;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #626a65;
  font-family: var(--font-family-brand);
  font-size: var(--font-body);
  line-height: var(--line-height-body);
  text-align: center;
}

.record-filter.is-active {
  color: #17614f;
}

.record-filter__indicator {
  position: absolute;
  width: 28rpx;
  height: 4rpx;
  bottom: -1rpx;
  left: 50%;
  border-radius: 3rpx;
  background: transparent;
  transform: translateX(-50%);
}

.record-filter.is-active .record-filter__indicator {
  background: #17614f;
}

.record-groups {
  position: relative;
  padding: 20rpx 42rpx 30rpx 14rpx;
}

.date-group {
  position: relative;
  display: grid;
  grid-template-columns: 132rpx minmax(0, 1fr);
  gap: 18rpx;
}

.date-rail {
  position: relative;
  min-height: 100%;
}

.timeline-thread {
  position: absolute;
  z-index: 0;
  width: 24rpx;
  height: calc(100% - 58rpx);
  top: 62rpx;
  left: 8rpx;
  opacity: .72;
  pointer-events: none;
}

.date-label {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  width: 128rpx;
  min-height: 76rpx;
  margin-top: 14rpx;
  padding-left: 34rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  color: #245b4d;
  font-family: var(--font-family-brand);
}

.date-label__day {
  font-size: var(--font-body-strong);
  font-weight: 550;
  line-height: var(--line-height-body-strong);
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.date-label__weekday {
  margin-top: 1rpx;
  color: #7c817d;
  font-size: var(--font-meta);
  line-height: var(--line-height-meta);
  letter-spacing: 2rpx;
}

.date-content {
  min-width: 0;
}

.date-heading {
  min-height: 66rpx;
  padding: 0 6rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid rgba(93, 98, 91, .18);
}

.date-summary {
  color: #676d69;
  font-family: var(--font-family-brand);
  font-size: var(--font-meta);
  line-height: var(--line-height-meta);
  white-space: nowrap;
}

.record-row {
  position: relative;
  min-height: 118rpx;
  padding: 22rpx 2rpx 20rpx 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-bottom: 1rpx solid rgba(93, 98, 91, .15);
}

.record-brush {
  width: 9rpx;
  height: 46rpx;
  flex: none;
  opacity: .82;
}

.record-main {
  min-width: 0;
  flex: 1;
}

.record-title {
  max-width: 100%;
  display: -webkit-box;
  overflow: hidden;
  color: #202622;
  font-family: var(--font-family-brand);
  font-size: var(--font-body-strong);
  font-weight: 550;
  line-height: var(--line-height-body-strong);
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.record-meta {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0 9rpx;
  color: #666d69;
  font-family: var(--font-family-brand);
  font-size: var(--font-meta);
  line-height: var(--line-height-meta);
}

.record-meta__dot,
.readonly-label {
  color: #88827a;
}

.record-reflection {
  margin-top: 5rpx;
  display: -webkit-box;
  overflow: hidden;
  color: #8b7453;
  font-size: var(--font-meta);
  line-height: var(--line-height-meta);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.record-state-link {
  min-width: 104rpx;
  min-height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: none;
  font-family: var(--font-family-brand);
  font-size: var(--font-meta);
  line-height: var(--line-height-meta);
  white-space: nowrap;
}

.status-text--success {
  color: #17614f;
}

.status-text--warning {
  color: #a77724;
}

.load-more {
  min-height: 72rpx;
  margin: 24rpx 42rpx 0 183rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid rgba(93, 98, 91, .15);
  border-bottom: 1rpx solid rgba(93, 98, 91, .15);
  color: #17614f;
  font-family: var(--font-family-brand);
  font-size: var(--font-body);
  line-height: var(--line-height-body);
}

.page-state {
  position: relative;
  z-index: 3;
  min-height: 440rpx;
  margin: 70rpx 42rpx 0;
  padding: 42rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: #17614f;
  text-align: center;
}

.compact-state {
  min-height: 300rpx;
  margin-top: 18rpx;
}

.empty-state {
  margin-top: 40rpx;
}

.state-symbol {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #17614f;
}

.state-symbol--warning {
  color: #a87025;
}

.state-title {
  margin-top: 19rpx;
  color: #24312d;
  font-family: var(--font-family-brand);
  font-size: var(--font-card-title);
  line-height: var(--line-height-card-title);
  font-weight: 550;
}

.state-desc {
  max-width: 480rpx;
  margin-top: 9rpx;
  color: #7c817d;
  font-size: var(--font-body);
  line-height: var(--line-height-body);
}

.state-action {
  min-width: 176rpx;
  min-height: 66rpx;
  margin-top: 23rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(36, 91, 77, .18);
  border-radius: 33rpx;
  color: #17614f;
  font-size: var(--font-body);
  line-height: var(--line-height-body);
  font-weight: 600;
}

.state-action--outline {
  color: #17614f;
}

.page-footer-mountain {
  position: absolute;
  z-index: 0;
  width: 410rpx;
  height: 190rpx;
  right: -42rpx;
  bottom: 0;
  opacity: .18;
  pointer-events: none;
}

.tap-pressed {
  opacity: .68;
  transform: scale(.992);
}

@media (max-width: 350px) {
  .custom-nav__inner {
    padding-right: 26rpx;
    padding-left: 26rpx;
  }

  .nav-title {
    font-size: var(--font-section-title-compact);
  }

  .growth-records-hero {
    height: 350rpx;
  }

  .hero-copy {
    width: 260rpx;
    top: 28rpx;
    left: 30rpx;
  }

  .hero-title {
    font-size: var(--font-page-title-compact);
  }

  .summary-item--actions {
    left: 294rpx;
  }

  .summary-item--minutes {
    top: 195rpx;
    left: 304rpx;
  }

  .summary-item--streak {
    top: 112rpx;
    left: 445rpx;
  }

  .summary-item--days {
    right: 14rpx;
  }

  .summary-value {
    font-size: var(--font-data-compact);
  }

  .filter-section {
    padding-right: 26rpx;
    padding-left: 26rpx;
  }

  .record-groups {
    padding-right: 26rpx;
    padding-left: 8rpx;
  }

  .timeline-thread {
    left: 6rpx;
  }

  .goal-filter {
    width: 168rpx;
    min-width: 168rpx;
    max-width: 168rpx;
  }

  .date-group {
    grid-template-columns: 116rpx minmax(0, 1fr);
    gap: 10rpx;
  }

  .date-label {
    width: 112rpx;
    padding-left: 30rpx;
  }

  .record-row {
    gap: 10rpx;
  }

  .record-title {
    font-size: var(--font-body-compact);
  }

  .record-meta {
    font-size: var(--font-meta-compact);
  }

  .record-state-link {
    min-width: 90rpx;
    font-size: var(--font-meta-compact);
  }
}

@media (prefers-reduced-motion: reduce) {
  .tap-pressed {
    transform: none;
  }
}
