.review-page {
  padding-top: 40rpx;
}

.stats-card,
.question-card,
.reviewed-card {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
}

.section-copy,
.stats-note {
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.stats-grid {
  display: flex;
  margin-top: 28rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-item + .stat-item {
  border-left: 1rpx solid var(--color-border);
}

.stat-value {
  color: var(--color-primary);
  font-size: 40rpx;
  font-weight: 750;
}

.stat-label {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.choice {
  width: 100%;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 22rpx;
  background: #ffffff;
  text-align: left;
}

.choice-active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.choice-title {
  font-weight: 650;
}

.choice-description {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 1.5;
}

.focus-input {
  width: 100%;
  min-height: 160rpx;
  margin-top: 20rpx;
  padding: 22rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: #fafbf8;
  line-height: 1.55;
}

.notice {
  margin-bottom: 20rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f5eddf;
  color: #705b37;
  line-height: 1.55;
}

.submit-button {
  width: 100%;
  padding: 24rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-weight: 650;
}

.full-button {
  width: 100%;
}

.button-disabled {
  opacity: 0.55;
}
