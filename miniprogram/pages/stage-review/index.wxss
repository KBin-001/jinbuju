.review-page {
  padding-top: 40rpx;
}

.stats-card,
.question-card,
.reviewed-card {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
}

.section-copy,
.stats-note {
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.stats-grid {
  display: flex;
  margin-top: 28rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-item + .stat-item {
  border-left: 1rpx solid var(--color-border);
}

.stat-value {
  color: var(--color-primary);
  font-size: 40rpx;
  font-weight: 750;
}

.stat-label {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.choice {
  width: 100%;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 22rpx;
  background: #ffffff;
  text-align: left;
}

.choice-active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.choice-title {
  font-weight: 650;
}

.choice-description {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 1.5;
}

.focus-input {
  width: 100%;
  min-height: 160rpx;
  margin-top: 20rpx;
  padding: 22rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: #fafbf8;
  line-height: 1.55;
}

.notice {
  margin-bottom: 20rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f5eddf;
  color: #705b37;
  line-height: 1.55;
}

.submit-button {
  width: 100%;
  padding: 24rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-weight: 650;
}

.full-button {
  width: 100%;
}

.button-disabled {
  opacity: 0.55;
}

/* 执行摘要卡片 */
.summary-card {
  margin-bottom: 24rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.summary-label {
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.summary-value {
  font-weight: 650;
  font-size: 28rpx;
}

.summary-warn {
  color: #b8860b;
}

.summary-hint {
  margin-top: 8rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: #f5eddf;
  color: #705b37;
  font-size: 24rpx;
  line-height: 1.5;
}

.summary-section {
  margin-top: 24rpx;
}

.summary-subtitle {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.summary-bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.summary-bar-label {
  width: 140rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.summary-bar-track {
  flex: 1;
  height: 16rpx;
  background: #e8ebe5;
  border-radius: 8rpx;
  overflow: hidden;
}

.summary-bar-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: 8rpx;
}

.summary-bar-rate {
  width: 80rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
}

.summary-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.summary-tag {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f0f0ec;
  font-size: 23rpx;
  color: var(--color-text-secondary);
}

.stats-card {
  background:
    radial-gradient(circle at 100% 0, rgba(157, 143, 214, 0.12), transparent 38%),
    linear-gradient(145deg, #ffffff, #f7faf8);
}

.summary-bar-fill {
  background: linear-gradient(90deg, var(--color-primary), var(--color-growth));
}

.choice {
  box-shadow: 0 6rpx 18rpx rgba(31, 77, 66, 0.04);
}

.choice-active {
  box-shadow: 0 0 0 4rpx rgba(53, 104, 89, 0.08);
}

.submit-button {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-deep));
  box-shadow: 0 12rpx 28rpx rgba(31, 77, 66, 0.18);
}
.review-hero { padding:38rpx; }
.review-hero .page-eyebrow { color:#e8c97f; }
.review-hero .page-title { color:#fff; font-size:48rpx; }
.review-hero .page-subtitle { color:rgba(255,255,255,.68); }
.stats-card { border:0; border-radius:36rpx; background:linear-gradient(145deg,#fff,#f2ead8); }
.stats-grid { gap:14rpx; }
.stat-item { border-radius:24rpx; background:#153f36; color:#fff; }
.stat-item:nth-child(2) { background:linear-gradient(145deg,#5c78d6,#7567c8); }
.stat-item:nth-child(3) { background:linear-gradient(145deg,#e67861,#d8a84e); }
.stat-item .stat-label { color:rgba(255,255,255,.7); }
.summary-card { border-left:7rpx solid #7567c8; background:#f7f8ff; }
.summary-bar-fill { background:linear-gradient(90deg,#5c78d6,#7567c8); }
.summary-tag { background:#f2dfb4; color:#725719; }
