.review-page {
  padding-top: 40rpx;
}

.stats-card,
.question-card,
.reviewed-card {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
}

.section-copy,
.stats-note {
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.stats-grid {
  display: flex;
  margin-top: 28rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-item + .stat-item {
  border-left: 1rpx solid var(--color-border);
}

.stat-value {
  color: var(--color-primary);
  font-size: 40rpx;
  font-weight: 750;
}

.stat-label {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.choice {
  width: 100%;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 22rpx;
  background: #ffffff;
  text-align: left;
}

.choice-active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.choice-title {
  font-weight: 650;
}

.choice-description {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 1.5;
}

.focus-input {
  width: 100%;
  min-height: 160rpx;
  margin-top: 20rpx;
  padding: 22rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: #fafbf8;
  line-height: 1.55;
}

.notice {
  margin-bottom: 20rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f5eddf;
  color: #705b37;
  line-height: 1.55;
}

.submit-button {
  width: 100%;
  padding: 24rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-weight: 650;
}

.full-button {
  width: 100%;
}

.button-disabled {
  opacity: 0.55;
}

/* 执行摘要卡片 */
.summary-card {
  margin-bottom: 24rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.summary-label {
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.summary-value {
  font-weight: 650;
  font-size: 28rpx;
}

.summary-warn {
  color: #b8860b;
}

.summary-hint {
  margin-top: 8rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: #f5eddf;
  color: #705b37;
  font-size: 24rpx;
  line-height: 1.5;
}

.summary-section {
  margin-top: 24rpx;
}

.summary-subtitle {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.summary-bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.summary-bar-label {
  width: 140rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.summary-bar-track {
  flex: 1;
  height: 16rpx;
  background: #e8ebe5;
  border-radius: 8rpx;
  overflow: hidden;
}

.summary-bar-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: 8rpx;
}

.summary-bar-rate {
  width: 80rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
}

.summary-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.summary-tag {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f0f0ec;
  font-size: 23rpx;
  color: var(--color-text-secondary);
}

.stats-card {
  background:
    radial-gradient(circle at 100% 0, rgba(157, 143, 214, 0.12), transparent 38%),
    linear-gradient(145deg, #ffffff, #f7faf8);
}

.summary-bar-fill {
  background: linear-gradient(90deg, var(--color-primary), var(--color-growth));
}

.choice {
  box-shadow: 0 6rpx 18rpx rgba(31, 77, 66, 0.04);
}

.choice-active {
  box-shadow: 0 0 0 4rpx rgba(53, 104, 89, 0.08);
}

.submit-button {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-deep));
  box-shadow: 0 12rpx 28rpx rgba(31, 77, 66, 0.18);
}
.review-hero { padding:38rpx; }
.review-hero .page-eyebrow { color:#e8c97f; }
.review-hero .page-title { color:#fff; font-size:48rpx; }
.review-hero .page-subtitle { color:rgba(255,255,255,.68); }
.stats-card { border:0; border-radius:36rpx; background:linear-gradient(145deg,#fff,#f2ead8); }
.stats-grid { gap:14rpx; }
.stat-item { border-radius:24rpx; background:#153f36; color:#fff; }
.stat-item:nth-child(2) { background:linear-gradient(145deg,#5c78d6,#7567c8); }
.stat-item:nth-child(3) { background:linear-gradient(145deg,#e67861,#d8a84e); }
.stat-item .stat-label { color:rgba(255,255,255,.7); }
.summary-card { border-left:7rpx solid #7567c8; background:#f7f8ff; }
.summary-bar-fill { background:linear-gradient(90deg,#5c78d6,#7567c8); }
.summary-tag { background:#f2dfb4; color:#725719; }

/* ---- Review success view ---- */

.review-success-view {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20rpx;
  padding: 0 8rpx;
}

.review-success-card {
  width: 100%;
  padding: 56rpx 40rpx;
  text-align: center;
  border: 0;
  border-radius: 36rpx;
  background: linear-gradient(145deg, #153f36, #356859);
  color: #fff;
  box-shadow: 0 22rpx 56rpx rgba(21, 63, 54, 0.22);
}

.review-success-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  color: #e8c97f;
  font-size: 52rpx;
  font-weight: 700;
  animation: review-mark-pop 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes review-mark-pop {
  0% { transform: scale(0); opacity: 0; }
  60% { transform: scale(1.15); opacity: 1; }
  100% { transform: scale(1); }
}

.review-success-title {
  margin-top: 28rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.review-success-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.6;
}

.review-success-stats {
  display: flex;
  margin-top: 36rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.15);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.15);
}

.review-stat-item {
  flex: 1;
  text-align: center;
}

.review-stat-item + .review-stat-item {
  border-left: 1rpx solid rgba(255, 255, 255, 0.12);
}

.review-stat-value {
  color: #e8c97f;
  font-size: 38rpx;
  font-weight: 750;
}

.review-stat-label {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
}

.review-success-encouragement {
  margin-top: 32rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 26rpx;
  line-height: 1.6;
}

.review-success-button {
  width: 100%;
  margin-top: 32rpx;
  padding: 26rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-deep));
  color: #fff;
  font-weight: 650;
  font-size: 30rpx;
  box-shadow: 0 12rpx 28rpx rgba(31, 77, 66, 0.18);
}

/* Confetti animation for review success */
.review-success-view .confetti-layer {
  position: absolute;
  top: -40rpx;
  right: 0;
  left: 0;
  height: 300rpx;
  overflow: hidden;
  pointer-events: none;
}

.review-success-view .confetti-piece {
  position: absolute;
  top: -24rpx;
  width: 12rpx;
  height: 22rpx;
  border-radius: 4rpx;
  background: var(--color-primary);
  opacity: 0;
  animation: review-confetti-fall 1100ms ease-out forwards;
}

.review-success-view .confetti-1 { left: 8%; animation-delay: 40ms; }
.review-success-view .confetti-2 { left: 18%; background: #d5a94e; animation-delay: 150ms; }
.review-success-view .confetti-3 { left: 29%; transform: rotate(28deg); animation-delay: 70ms; }
.review-success-view .confetti-4 { left: 39%; background: #8eb6a8; animation-delay: 210ms; }
.review-success-view .confetti-5 { left: 49%; background: #d5a94e; animation-delay: 10ms; }
.review-success-view .confetti-6 { left: 59%; transform: rotate(45deg); animation-delay: 170ms; }
.review-success-view .confetti-7 { left: 69%; background: #8eb6a8; animation-delay: 90ms; }
.review-success-view .confetti-8 { left: 78%; background: #d5a94e; animation-delay: 230ms; }
.review-success-view .confetti-9 { left: 88%; transform: rotate(24deg); animation-delay: 120ms; }
.review-success-view .confetti-10 { left: 95%; background: #8eb6a8; animation-delay: 260ms; }

@keyframes review-confetti-fall {
  0% { opacity: 0; transform: translateY(0) rotate(0); }
  15% { opacity: 1; }
  100% { opacity: 0; transform: translateY(270rpx) rotate(260deg); }
}

@media (prefers-reduced-motion: reduce) {
  .review-success-view .confetti-piece,
  .review-success-mark {
    animation: none;
  }
}

.duration-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.duration-choice {
  min-width: 0;
  margin: 0;
  padding: 20rpx 8rpx;
  border: 2rpx solid #dbe4df;
  border-radius: 20rpx;
  background: #f6f8f6;
  color: #5e6d67;
  font-size: 25rpx;
  line-height: 1.2;
}

.duration-choice::after {
  border: 0;
}

.duration-choice-active {
  border-color: #356859;
  background: #e7f1ec;
  color: #1f4d42;
  font-weight: 650;
}
