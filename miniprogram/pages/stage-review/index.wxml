<view class="page review-page" data-theme="{{appTheme}}">
  <view class="page-header growth-hero review-hero">
    <view class="page-eyebrow">可选的计划复盘</view>
    <view class="page-title">回顾这段行动</view>
    <view class="page-subtitle">用真实完成情况调整节奏，不追求一次做到完美。</view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="card state-card">
    <view class="loading-dot"></view>
    <view class="state-title">正在整理阶段数据</view>
    <view class="state-description">完成率和行动天数由服务端统计。</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="card state-card">
    <view class="state-mark">!</view>
    <view class="state-title">复盘加载失败</view>
    <view class="state-description">{{errorMessage}}</view>
    <t-button class="primary-button" bindtap="retry">重新加载</t-button>
  </view>

  <block wx:else>
    <view class="card stats-card">
      <view class="section-title">这一阶段的行动记录</view>
      <view class="stats-grid">
        <view class="stat-item">
          <view class="stat-value">{{review.completionRate}}%</view>
          <view class="stat-label">行动完成率</view>
        </view>
        <view class="stat-item">
          <view class="stat-value">{{review.actionDays}}</view>
          <view class="stat-label">行动天数</view>
        </view>
        <view class="stat-item">
          <view class="stat-value">{{review.streakDays}}</view>
          <view class="stat-label">最长连续天数</view>
        </view>
      </view>
      <view class="stats-note">已完成 {{review.completedActionCount}} / {{review.totalActionCount}} 项行动</view>
    </view>

    <!-- 详细执行摘要（仅在有数据时展示） -->
    <view wx:if="{{hasDetailedSummary}}" class="card summary-card">
      <view class="section-title">执行详情</view>

      <!-- 时间对比 -->
      <view class="summary-row">
        <view class="summary-label">计划日均</view>
        <view class="summary-value">{{review.executionSummary.plannedDailyMinutes}} 分钟</view>
      </view>
      <view class="summary-row">
        <view class="summary-label">实际日均</view>
        <view class="summary-value {{timeDeviation < -10 ? 'summary-warn' : ''}}">{{review.executionSummary.averageDailyMinutes}} 分钟</view>
      </view>
      <view wx:if="{{timeDeviation < -10}}" class="summary-hint">
        实际投入比计划少了 {{-timeDeviation}} 分钟，AI 会在新计划中据此调整
      </view>

      <!-- 行动类型完成率 -->
      <view wx:if="{{actionTypeRates.length > 0}}" class="summary-section">
        <view class="summary-subtitle">各类行动完成率</view>
        <view wx:for="{{actionTypeRates}}" wx:key="type" class="summary-bar-row">
          <view class="summary-bar-label">{{item.label}}</view>
          <view class="summary-bar-track">
            <view class="summary-bar-fill" style="width: {{item.rate}}%"></view>
          </view>
          <view class="summary-bar-rate">{{item.rate}}%</view>
        </view>
      </view>

      <!-- 跳过原因 -->
      <view wx:if="{{skipReasonList.length > 0}}" class="summary-section">
        <view class="summary-subtitle">跳过原因</view>
        <view class="summary-tags">
          <view wx:for="{{skipReasonList}}" wx:key="reason" class="summary-tag">
            {{item.label}} {{item.count}}次
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{justReviewed}}" class="review-success-view">
      <view class="confetti-layer" aria-hidden="true">
        <view class="confetti-piece confetti-1"></view><view class="confetti-piece confetti-2"></view>
        <view class="confetti-piece confetti-3"></view><view class="confetti-piece confetti-4"></view>
        <view class="confetti-piece confetti-5"></view><view class="confetti-piece confetti-6"></view>
        <view class="confetti-piece confetti-7"></view><view class="confetti-piece confetti-8"></view>
        <view class="confetti-piece confetti-9"></view><view class="confetti-piece confetti-10"></view>
      </view>
      <view class="card review-success-card">
        <view class="review-success-mark" aria-label="复盘完成">✓</view>
        <view class="review-success-title">复盘已完成</view>
        <view class="review-success-subtitle">新的行动计划已生成，继续向前推进。</view>
        <view class="review-success-stats">
          <view class="review-stat-item">
            <view class="review-stat-value">{{review.completionRate}}%</view>
            <view class="review-stat-label">完成率</view>
          </view>
          <view class="review-stat-item">
            <view class="review-stat-value">{{review.actionDays}}</view>
            <view class="review-stat-label">行动天数</view>
          </view>
          <view class="review-stat-item">
            <view class="review-stat-value">{{review.streakDays}}</view>
            <view class="review-stat-label">最长连续</view>
          </view>
        </view>
        <view class="review-success-encouragement">每一次复盘，都是让行动更清晰的一步。</view>
      </view>
      <t-button
        wx:if="{{generatedPreviewId || review.previewId}}"
        class="primary-button full-button review-success-button"
        bindtap="continuePreview"
      >查看新计划方案</t-button>
      <view wx:else class="section-copy">预览暂时不可用，请稍后从进度页重试。</view>
    </view>

    <view wx:elif="{{review.reviewed}}" class="card reviewed-card">
      <view class="section-title">复盘已经完成</view>
      <view class="section-copy">新计划预览已经生成，可以继续查看并确认。</view>
      <t-button
        wx:if="{{review.previewId}}"
        class="primary-button full-button"
        bindtap="continuePreview"
      >主动生成新计划</t-button>
      <view wx:else class="section-copy">预览暂时不可用，请稍后从进度页重试。</view>
    </view>

    <block wx:elif="{{!review.reviewed}}">
      <view class="card question-card">
        <view class="section-title">这段节奏感觉如何？</view>
        <t-button
          wx:for="{{difficultyOptions}}"
          wx:key="value"
          class="choice {{difficulty === item.value ? 'choice-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="chooseDifficulty"
        >
          <view class="choice-title">{{item.label}}</view>
          <view class="choice-description">{{item.description}}</view>
        </t-button>
      </view>

      <view class="card question-card">
        <view class="section-title">新计划怎么调整？</view>
        <t-button
          wx:for="{{preferenceOptions}}"
          wx:key="value"
          class="choice {{nextPreference === item.value ? 'choice-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="choosePreference"
        >
          <view class="choice-title">{{item.label}}</view>
          <view class="choice-description">{{item.description}}</view>
        </t-button>
        <t-textarea
          wx:if="{{nextPreference === 'change_focus'}}"
          class="focus-input"
          maxlength="200"
          value="{{focusAdjustment}}"
          placeholder="例如：减少理论阅读，多做两次模拟练习；也可以写下想使用的材料、练习方式和时间安排"
          bindchange="updateFocus"
        />
      </view>

      <view class="card question-card">
        <view class="section-title">新计划准备推进多久？</view>
        <view class="section-copy">14 天以内生成完整行动；更长周期先生成整体大纲和首个 7 天。</view>
        <view class="duration-grid">
          <t-button
            wx:for="{{durationOptions}}"
            wx:key="*this"
            class="duration-choice {{planDurationDays === item ? 'duration-choice-active' : ''}}"
            data-value="{{item}}"
            bindtap="chooseDuration"
          >{{item}} 天</t-button>
        </view>
      </view>

      <view wx:if="{{!review.canReview}}" class="notice">
        当前阶段结束后开放复盘。你可以先回到今日页继续行动。
      </view>
      <t-button
        class="submit-button {{!review.canReview ? 'button-disabled' : ''}}"
        disabled="{{!review.canReview || submitting}}"
        loading="{{submitting}}"
        bindtap="submit"
      >生成新的行动计划</t-button>
    </block>
  </block>
</view>
