.data-page {
  padding-top: 40rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 650;
}

.scope-list {
  margin-top: 20rpx;
  color: var(--color-text-secondary);
  line-height: 2;
}

.scope-list view::before {
  margin-right: 12rpx;
  color: var(--color-primary);
  content: "·";
}

.warning-card {
  margin-top: 24rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(180, 92, 85, 0.2);
  background: var(--color-danger-light);
  color: #8f3e37;
  line-height: 1.65;
}

.local-card {
  margin-top: 24rpx;
  border: 1rpx solid rgba(230, 120, 97, 0.16);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(113, 73, 68, 0.06);
}

.local-copy {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.55;
}

.local-danger-button {
  width: 100%;
  min-height: 82rpx;
  margin-top: 24rpx;
  border: 1rpx solid rgba(180, 76, 67, 0.22);
  border-radius: 999rpx;
  background: #fff7f4;
  color: #b44c43;
  font-size: 28rpx;
  font-weight: 650;
}

.local-danger-button::after {
  border: 0;
}

.mock-button {
  width: 100%;
  min-height: 82rpx;
  margin-top: 24rpx;
  border: 1rpx solid rgba(63, 143, 114, 0.22);
  border-radius: 999rpx;
  background: #E6F4EC;
  color: #3F8F72;
  font-size: 28rpx;
  font-weight: 650;
}

.mock-button::after {
  border: 0;
}

.danger-outline-button,
.danger-button {
  width: 100%;
  margin-top: 32rpx;
  padding: 25rpx;
  border-radius: 999rpx;
  font-weight: 650;
}

.danger-outline-button {
  border: 1rpx solid #b44c43;
  color: #b44c43;
}

.confirmation-card {
  margin-top: 32rpx;
}

.confirmation-copy {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
}

.confirmation-input {
  height: 92rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  background: #f9faf7;
}

.confirmation-input:focus {
  border-color: var(--color-danger);
  background: #ffffff;
}

.danger-button {
  background: linear-gradient(135deg, #b45c55, #91453f);
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(145, 69, 63, 0.16);
}

.danger-button[disabled] {
  opacity: 0.45;
}

.error-copy {
  margin-top: 14rpx;
  color: #b44c43;
  font-size: 24rpx;
}
.data-hero { padding:38rpx; background:linear-gradient(145deg,#493735,#714944); }
.data-hero .page-eyebrow { color:#f0c795; }
.data-hero .page-title { color:#fff; }
.data-hero .page-subtitle { color:rgba(255,255,255,.68); }
.scope-card { border:0; border-radius:34rpx; background:linear-gradient(145deg,#fff,#f5ddd7); }
.scope-list view { position:relative; padding-left:32rpx; }
.scope-list view::before { position:absolute; top:15rpx; left:2rpx; width:12rpx; height:12rpx; border-radius:50%; background:#e67861; content:""; }
.warning-card { border:1rpx solid rgba(230,120,97,.2); border-radius:28rpx; background:#fff7f4; }
.confirmation-card { border:2rpx solid rgba(230,120,97,.24); border-radius:34rpx; box-shadow:0 16rpx 40rpx rgba(113,73,68,.1); }
