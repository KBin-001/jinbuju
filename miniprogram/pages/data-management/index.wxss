page { background: var(--color-bg-page, #F7F3EA); }
.data-page { padding: 32rpx 32rpx calc(64rpx + env(safe-area-inset-bottom)); color: var(--color-text-primary, #24312D); }
.data-hero { padding: 34rpx; border: 1rpx solid rgba(121,111,91,.13); border-radius: 30rpx; background: linear-gradient(145deg, #FFFCF6, #F1EBDD); box-shadow: 0 8rpx 24rpx rgba(75,62,40,.05); }
.page-eyebrow, .page-title, .page-subtitle, .section-title, .section-desc { display: block; }
.page-eyebrow { color: var(--color-accent, #C89B4A); font-size: 22rpx; }
.page-title { margin-top: 8rpx; color: var(--color-brand, #245B4D); font-size: 38rpx; font-weight: 700; }
.page-subtitle { margin-top: 10rpx; color: var(--color-text-secondary, #7C817D); font-size: 24rpx; line-height: 38rpx; }
.section-card { margin-top: 22rpx; padding: 28rpx; border: 1rpx solid rgba(121,111,91,.13); border-radius: 28rpx; background: var(--color-bg-card, #FFFCF6); box-shadow: 0 8rpx 24rpx rgba(75,62,40,.04); }
.section-head { display: flex; align-items: flex-start; gap: 20rpx; }
.section-head > view:first-child { min-width: 0; flex: 1; }
.section-head > t-icon { color: #7F9D91; }
.section-title { font-size: 29rpx; font-weight: 700; }
.section-desc { margin-top: 7rpx; color: #7C817D; font-size: 23rpx; line-height: 36rpx; }
.button-row { margin-top: 22rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.retained-note { margin-top: 18rpx; padding: 18rpx 20rpx; border-radius: 18rpx; background: rgba(127,157,145,.10); color: #65736D; font-size: 22rpx; line-height: 34rpx; }
.retained-note--warning { background: rgba(155,85,77,.08); color: #87534C; }
.danger-outline-button, .danger-button { width: 100%; min-height: 82rpx; margin-top: 22rpx; }
.danger-outline-button { border-color: #9B554D !important; color: #9B554D !important; }
.danger-button, .sheet-danger { background: #9B554D !important; color: #FFF !important; }
.error-copy { margin-top: 18rpx; padding: 20rpx; display: flex; align-items: flex-start; gap: 10rpx; border-radius: 18rpx; background: rgba(155,85,77,.09); color: #9B554D; font-size: 23rpx; line-height: 34rpx; }
.danger-panel { position: fixed; z-index: 100; inset: 0; }
.danger-mask { position: absolute; inset: 0; background: rgba(22,30,27,.42); }
.danger-sheet { position: absolute; right: 0; bottom: 0; left: 0; padding: 18rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: #FFFCF6; }
.sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 28rpx; border-radius: 4rpx; background: rgba(36,49,45,.14); }
.sheet-title, .sheet-copy { display: block; }
.sheet-title { font-size: 32rpx; font-weight: 700; }
.sheet-copy { margin: 12rpx 0 22rpx; color: #7C817D; font-size: 24rpx; line-height: 38rpx; }
.sheet-error { margin-top: 12rpx; color: #9B554D; font-size: 22rpx; }
.sheet-danger { width: 100%; margin-top: 24rpx; }
@media (max-width: 350px) { .button-row { grid-template-columns: 1fr; } }
