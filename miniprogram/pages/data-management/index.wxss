page { background: #F7F3EA; }
.data-page { padding-top: 32rpx; color: #24312D; }
.data-hero { padding: 34rpx; border: 1rpx solid rgba(121,111,91,.13); border-radius: 30rpx; background: linear-gradient(145deg, #FFFCF6, #F5EBDD); box-shadow: 0 8rpx 24rpx rgba(75,62,40,.06); }
.data-hero .page-eyebrow { color: #9A712E; }
.data-hero .page-title { color: #245B4D; }
.data-hero .page-subtitle { color: #7C817D; }
.section-title { color: #24312D; font-size: 30rpx; font-weight: 700; }
.scope-card, .confirmation-card { margin-top: 22rpx; border: 1rpx solid rgba(121,111,91,.13); border-radius: 28rpx; background: #FFFCF6; box-shadow: 0 8rpx 24rpx rgba(75,62,40,.05); }
.scope-list { margin-top: 18rpx; color: #6F7772; font-size: 25rpx; line-height: 1.9; }
.scope-list view { position: relative; padding-left: 28rpx; }
.scope-list view::before { position: absolute; top: 17rpx; left: 2rpx; width: 10rpx; height: 10rpx; border-radius: 50%; background: #7F9D91; content: ""; }
.warning-card { margin-top: 20rpx; padding: 24rpx 26rpx; border: 1rpx solid rgba(181,91,79,.2); border-radius: 24rpx; background: #FBEEEA; color: #8B4B43; font-size: 24rpx; line-height: 1.65; }
.danger-outline-button, .danger-button { width: 100%; min-height: 84rpx; margin-top: 28rpx; padding: 0 28rpx; border-radius: 42rpx; font-size: 27rpx; font-weight: 650; }
.danger-outline-button { border: 1rpx solid #A75B51; background: #FFFCF6; color: #A75B51; }
.confirmation-copy { margin-top: 12rpx; color: #7C817D; font-size: 24rpx; line-height: 36rpx; }
.confirmation-input { min-height: 88rpx; margin-top: 22rpx; padding: 0 22rpx; border: 1rpx solid rgba(121,111,91,.18); border-radius: 22rpx; background: #FAF7F0; }
.danger-button { background: #9B554D; color: #FFFFFF; box-shadow: 0 10rpx 24rpx rgba(122,67,60,.14); }
.danger-button[disabled] { opacity: .45; }
.error-copy { margin-top: 14rpx; color: #A75B51; font-size: 24rpx; }
