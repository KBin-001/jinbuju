<view class="page data-page" data-theme="{{appTheme}}">
  <view class="page-header growth-hero data-hero">
    <view class="page-eyebrow">你的数据由你决定</view>
    <view class="page-title">数据管理</view>
    <view class="page-subtitle">清除操作不可恢复，请先了解影响范围。</view>
  </view>

  <view class="card scope-card">
    <view class="section-title">将清除的数据</view>
    <view class="scope-list">
      <view>用户资料与个人统计</view>
      <view>目标、行动阶段和每日行动记录</view>
      <view>每日打卡记录</view>
      <view>小队成员关系与固定鼓励记录</view>
      <view>与当前用户直接关联的其他业务数据</view>
    </view>
  </view>

  <view class="card local-card">
    <view class="section-title">本地数据</view>
    <view class="local-copy">清除当前设备上的本地目标、行动和历史复盘缓存，不会影响线上数据库。</view>
    <t-button class="local-danger-button" bindtap="clearLocalData">清除本地数据</t-button>
  </view>

  <view class="card local-card">
    <view class="section-title">演示数据</view>
    <view class="local-copy">载入 1 个目标、约 10 天行动记录和 20 位各行各业的小队成员，用于预览体验。会覆盖当前本地数据。</view>
    <t-button class="mock-button" bindtap="loadMockData">{{mockSeeded ? '重新载入演示数据' : '载入演示数据'}}</t-button>
  </view>

  <view class="warning-card">
    清除完成后无法恢复。小队中其他成员的数据不会受到影响，系统只会更新相应的小队人数。
  </view>

  <t-button
    wx:if="{{!confirmedRisk}}"
    class="danger-outline-button"
    bindtap="startDelete"
  >清除我的全部数据</t-button>

  <view wx:else class="card confirmation-card">
    <view class="section-title">再次确认</view>
    <view class="confirmation-copy">
      请输入“确认清除”，然后提交最终请求。
    </view>
    <t-input
      class="confirmation-input"
      value="{{confirmation}}"
      placeholder="确认清除"
      maxlength="20"
      disabled="{{deleting}}"
      bindchange="onConfirmationInput"
    />
    <view wx:if="{{errorMessage}}" class="error-copy">{{errorMessage}}</view>
    <t-button
      class="danger-button"
      loading="{{deleting}}"
      disabled="{{confirmation !== '确认清除' || deleting}}"
      bindtap="submitDelete"
    >{{deleting ? '正在清除' : '确认清除全部数据'}}</t-button>
  </view>
</view>
