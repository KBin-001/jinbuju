<view class="coach-page" data-theme="{{appTheme}}">
  <view class="status-bar-mask" style="height: {{statusBarHeight}}px;" aria-hidden="true"></view>
  <view class="coach-hero" style="height: {{heroHeight}}px;">
    <image class="hero-mountain" src="/assets/ai-coach-shanshui-v1.jpg" mode="aspectFill" aria-hidden="true" />
    <view class="hero-wash"></view>
    <view class="coach-nav" style="top: {{navTop}}px; height: {{navHeight}}px; padding-right: {{menuRightInset}}px;">
      <view class="nav-back" bindtap="goBack" role="button" aria-label="返回上一页" hover-class="is-pressed"><t-icon name="chevron-left" size="43rpx" /></view>
      <view class="nav-heading">
        <view class="nav-title-line"><text class="nav-title">AI 成长教练</text><view class="title-spark"></view></view>
      </view>
      <view class="records-button" bindtap="openTodayRecords" role="button" aria-label="查看今日记录" hover-class="is-pressed"><text>今日记录</text><t-icon name="chevron-right" size="25rpx" /></view>
    </view>
  </view>

  <view class="section-tabs" role="tablist">
    <view class="section-tab is-active" data-section="review" bindtap="selectSection" role="tab" aria-selected="true">今日复盘</view>
    <view class="section-tab" data-section="insights" bindtap="selectSection" role="tab">长期洞察</view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="page-state">
    <view class="loading-orb"><view></view></view>
    <text class="state-title">正在整理今天的行动记录</text>
    <text class="state-copy">结论只基于你的真实完成与投入数据</text>
  </view>

  <view wx:elif="{{status === 'error'}}" class="page-state page-state--error">
    <view class="state-icon"><t-icon name="error-circle" size="48rpx" /></view>
    <text class="state-title">今日分析读取失败</text>
    <text class="state-copy">{{errorMessage}}</text>
    <button class="retry-button" bindtap="loadAnalysis">重新读取</button>
  </view>

  <view wx:else id="today-review" class="coach-content">
    <view class="coach-card conclusion-card">
      <view class="conclusion-copy">
        <view class="card-eyebrow">今日结论</view>
        <view class="conclusion-title">{{workspace.conclusionTitle}}</view>
        <view class="conclusion-subtitle">{{workspace.conclusionSubtitle}}</view>
      </view>
      <view class="metric-panel">
        <view class="metric-item">
          <t-icon name="check-circle" size="43rpx" />
          <view class="metric-value">{{analysis.completedCount}}<text>/{{analysis.totalCount}}</text></view>
          <view class="metric-label">完成行动</view>
        </view>
        <view class="metric-divider"></view>
        <view class="metric-item">
          <t-icon name="time" size="43rpx" />
          <view class="metric-value">{{analysis.actualMinutes}}<text> 分钟</text></view>
          <view class="metric-label">实际投入</view>
        </view>
        <view class="metric-divider"></view>
        <view class="metric-item metric-item--status">
          <t-icon name="chart-line" size="43rpx" />
          <view class="metric-value metric-status metric-status--{{workspace.statusTone}}">{{workspace.todayStatus}}</view>
          <view class="metric-label">今日状态</view>
        </view>
      </view>
      <view class="completion-caption">今日行动完成率 {{analysis.completionPercent}}%</view>
      <view class="completion-track"><view class="completion-fill" style="width: {{analysis.completionPercent}}%;"></view></view>
      <button wx:if="{{analysis.totalCount === 0}}" class="empty-action-button" bindtap="addTodayAction">{{analysis.goalId ? '添加今日行动' : '创建长期目标'}}</button>
    </view>

    <view class="coach-card judgement-card">
      <view class="card-eyebrow card-eyebrow--spark">教练判断<view class="eyebrow-spark"></view></view>
      <view class="judgement-title">{{workspace.judgementTitle}}</view>
      <view class="evidence-list">
        <view wx:for="{{workspace.evidences}}" wx:key="id" class="evidence-item">
          <view class="evidence-icon evidence-icon--{{item.tone}}"><t-icon name="{{item.icon}}" size="35rpx" /></view>
          <view class="evidence-copy"><view class="evidence-title">{{item.title}}</view><view class="evidence-description">{{item.description}}</view></view>
        </view>
      </view>
    </view>

    <view class="coach-card chat-card">
      <coach-chat title="继续问教练" user-avatar-url="{{userAvatarUrl}}" messages="{{messages}}" quick-questions="{{quickQuestions}}" asking="{{asking}}" error-message="{{chatError}}" executing-proposal-id="{{executingProposalId}}" bindsend="handleChatSend" bindretry="retryLastQuestion" bindconfirmproposal="confirmCoachAction"></coach-chat>
    </view>
  </view>

</view>
