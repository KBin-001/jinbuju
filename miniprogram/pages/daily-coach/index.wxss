@import "../../styles/theme.wxss";

page { min-height: 100%; background: #fbf8f1; }
.coach-page { min-height: 100vh; padding-bottom: calc(38rpx + env(safe-area-inset-bottom)); color: var(--color-text-main); background: linear-gradient(180deg,#fffdf9 0%,#fbf8f1 58%,#f6f1e8 100%); }
.status-bar-mask { position: absolute; z-index: 30; top: 0; right: 0; left: 0; pointer-events: none; background: rgba(255,253,249,.78); }
button { margin: 0; padding: 0; border: 0; background: transparent; line-height: inherit; }
button::after { border: 0; }
.is-pressed { opacity: .72; transform: scale(.97); }

.coach-hero { position: relative; box-sizing: border-box; height: 500rpx; overflow: visible; background: #fffdf9; }
.hero-mountain { position: absolute; z-index: 0; top: 0; left: 0; width: 100%; opacity: .94; }
.hero-wash { position: absolute; z-index: 1; inset: 0; pointer-events: none; background: linear-gradient(180deg,rgba(255,253,249,.48) 0%,rgba(255,253,249,.05) 32%,rgba(255,253,249,.08) 67%,#fbf8f1 100%); }
.coach-nav { position: absolute; z-index: 22; right: 0; left: 0; display: flex; box-sizing: border-box; align-items: center; padding-left: 24rpx; }
.nav-back { display: flex; width: 72rpx; height: 72rpx; flex: none; align-items: center; justify-content: center; color: #1f2b27; }
.nav-heading { position: absolute; left: 50%; display: flex; align-items: center; transform: translateX(-50%); white-space: nowrap; }
.nav-title { margin-left: 15rpx; color: #193f36; font-family: STKaiti,"KaiTi SC","Noto Serif SC",serif; font-size: 36rpx; font-weight: 560; letter-spacing: 5rpx; line-height: 48rpx; }
.coach-brand { width: 78rpx; height: 54rpx; flex: none; }

.scope-switch { position: absolute; z-index: 22; left: 50%; display: flex; min-height: 58rpx; padding: 0 18rpx; gap: 7rpx; align-items: center; transform: translateX(-50%); border-radius: 999rpx; color: #233a33; background: rgba(255,253,249,.7); font-size: 25rpx; line-height: 34rpx; }
.scope-popover { position: absolute; z-index: 40; left: 50%; width: 520rpx; padding: 12rpx; transform: translateX(-50%); border: 1rpx solid rgba(200,155,74,.2); border-radius: 28rpx; background: rgba(255,253,248,.98); box-shadow: 0 22rpx 60rpx rgba(45,56,50,.15); }
.scope-option { display: flex; min-height: 84rpx; padding: 13rpx 18rpx; box-sizing: border-box; align-items: center; justify-content: space-between; border-radius: 20rpx; color: var(--color-text-main); }
.scope-option.is-active { color: var(--color-primary); background: rgba(36,91,77,.07); }
.scope-option > view { min-width: 0; flex: 1; }
.scope-option text { display: block; }
.scope-option text:first-child { font-size: 24rpx; font-weight: 700; line-height: 34rpx; }
.scope-option text:last-child { margin-top: 2rpx; color: var(--color-text-secondary); font-size: 18rpx; line-height: 26rpx; }
.scope-records { display: flex; min-height: 70rpx; margin-top: 8rpx; padding: 0 18rpx; gap: 11rpx; align-items: center; border-top: 1rpx solid var(--color-divider); color: var(--color-primary); font-size: 21rpx; }
.scope-records text { min-width: 0; flex: 1; }

.hero-conclusion { position: absolute; z-index: 8; right: 36rpx; left: 44rpx; }
.hero-spark { position: absolute; top: 13rpx; left: 2rpx; width: 12rpx; height: 12rpx; transform: rotate(45deg); background: #c89b4a; }
.hero-title { display: -webkit-box; max-width: 660rpx; padding-left: 28rpx; overflow: hidden; color: #202925; font-family: STKaiti,"KaiTi SC","Noto Serif SC",serif; font-size: 47rpx; font-weight: 540; letter-spacing: 3rpx; line-height: 1.48; text-shadow: 0 2rpx 16rpx rgba(255,253,249,.95); white-space: pre-line; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.hero-brush { width: 290rpx; height: 22rpx; margin: -7rpx 0 0 224rpx; overflow: hidden; transform: rotate(-4deg); }
.hero-brush view { width: 245rpx; height: 25rpx; border-top: 6rpx solid rgba(190,145,48,.9); border-radius: 50%; }

.page-state { display: flex; min-height: 330rpx; margin: 22rpx 30rpx 0; padding: 42rpx 32rpx; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid var(--color-border-soft); border-radius: 30rpx; background: var(--color-card); text-align: center; }
.loading-orb { display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-primary-soft); animation: breathe 1.8s ease-in-out infinite; }
.loading-orb view { width: 22rpx; height: 22rpx; transform: rotate(45deg); border-radius: 4rpx; background: var(--color-primary); }
.state-icon { color: var(--color-warning); }
.state-title { margin-top: 24rpx; font-size: 30rpx; font-weight: 700; }
.state-copy { max-width: 470rpx; margin-top: 10rpx; color: var(--color-text-secondary); font-size: 23rpx; line-height: 36rpx; }
.retry-button,.empty-action-button { min-width: 220rpx; height: 76rpx; margin: 26rpx auto 0; padding: 0 28rpx; border-radius: 999rpx; color: #fff; background: var(--color-primary); font-size: 24rpx; font-weight: 650; }

.coach-content { position: relative; z-index: 10; margin-top: -4rpx; padding: 0 30rpx; }
.metric-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 14rpx; }
.metric-card { display: flex; min-width: 0; min-height: 260rpx; box-sizing: border-box; padding: 25rpx 20rpx 22rpx; flex-direction: column; border: 1rpx solid rgba(200,155,74,.26); border-radius: 28rpx; background: rgba(255,254,251,.97); box-shadow: 0 12rpx 30rpx rgba(53,61,56,.055); }
.metric-card--complete { background: linear-gradient(145deg,rgba(255,254,251,.99),rgba(255,249,235,.9)); }
.metric-card--minutes { border-color: rgba(103,139,124,.22); background: linear-gradient(145deg,rgba(233,243,238,.94),rgba(255,253,248,.97)); }
.metric-card--streak { border-color: rgba(200,155,74,.35); background: linear-gradient(145deg,rgba(255,249,231,.98),rgba(247,231,190,.82)); }
.metric-icon { height: 39rpx; color: #4c7968; }
.metric-icon--gold { color: #b78628; }
.metric-value { margin-top: 20rpx; color: #315f50; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 58rpx; font-weight: 450; line-height: 66rpx; white-space: nowrap; }
.metric-value text { margin-left: 4rpx; color: #7d817d; font-family: var(--font-family-sans); font-size: 22rpx; font-weight: 400; }
.metric-label { margin-top: 3rpx; color: #283630; font-size: 24rpx; font-weight: 550; line-height: 34rpx; }
.metric-progress { height: 9rpx; margin-top: 13rpx; overflow: hidden; border-radius: 999rpx; background: rgba(70,107,93,.12); }
.metric-progress view { height: 100%; border-radius: inherit; background: linear-gradient(90deg,#3f7562,#7fa794); }
.metric-note { margin-top: auto; padding-top: 13rpx; color: #858883; font-size: 18rpx; line-height: 27rpx; }

.advice-card { position: relative; min-height: 218rpx; margin-top: 24rpx; overflow: hidden; border: 1rpx solid rgba(200,155,74,.48); border-radius: 30rpx; background: linear-gradient(135deg,#fffdf8 0%,#fff8e9 100%); box-shadow: 0 12rpx 34rpx rgba(102,79,34,.06); }
.advice-watermark { position: absolute; z-index: 0; top: 0; right: 0; width: 48%; height: 100%; opacity: .12; }
.advice-content { position: relative; z-index: 1; padding: 25rpx 24rpx 22rpx; }
.advice-heading { display: flex; min-width: 0; align-items: center; }
.advice-spark { display: flex; margin-right: 10rpx; color: #c89b4a; }
.advice-title { color: #27332f; font-family: STKaiti,"KaiTi SC","Noto Serif SC",serif; font-size: 30rpx; font-weight: 650; letter-spacing: 2rpx; }
.advice-badge { margin-left: 12rpx; padding: 2rpx 10rpx; border: 1rpx solid rgba(183,134,40,.72); border-radius: 999rpx; color: #a87820; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 18rpx; line-height: 28rpx; }
.advice-copy { max-width: 610rpx; margin-top: 12rpx; color: #4a514d; font-size: 22rpx; line-height: 35rpx; }
.advice-quick-list { display: grid; margin-top: 20rpx; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 10rpx; }
.advice-quick { display: flex; min-width: 0; min-height: 64rpx; box-sizing: border-box; padding: 8rpx 10rpx; gap: 7rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(200,155,74,.28); border-radius: 999rpx; color: #315f50; background: rgba(255,253,248,.91); box-shadow: 0 5rpx 13rpx rgba(69,72,65,.045); font-size: 19rpx; line-height: 24rpx; text-align: center; }
.advice-quick--1 { color: #a87820; }
.advice-quick text { display: -webkit-box; min-width: 0; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }

.actions-card { margin-top: 22rpx; padding: 22rpx 24rpx 10rpx; border: 1rpx solid rgba(200,155,74,.22); border-radius: 30rpx; background: rgba(255,253,248,.94); box-shadow: 0 10rpx 26rpx rgba(53,61,56,.045); }
.section-heading { display: flex; min-height: 47rpx; align-items: center; justify-content: space-between; }
.section-title { color: #26332e; font-family: STKaiti,"KaiTi SC","Noto Serif SC",serif; font-size: 28rpx; font-weight: 650; letter-spacing: 2rpx; }
.section-link { display: flex; gap: 4rpx; align-items: center; color: #6f7772; font-size: 20rpx; }
.task-preview { display: flex; min-height: 88rpx; gap: 15rpx; align-items: center; border-top: 1rpx solid rgba(113,106,93,.1); }
.task-preview:first-child { border-top: 0; }
.task-icon { display: flex; width: 54rpx; height: 54rpx; flex: none; align-items: center; justify-content: center; border-radius: 50%; color: #777b78; background: rgba(112,115,111,.08); }
.task-icon--complete { color: #3d7562; background: rgba(79,132,111,.14); }
.task-icon--active { color: #b77f17; background: rgba(200,155,74,.17); }
.task-copy { min-width: 0; flex: 1; }
.task-title { overflow: hidden; color: #303a36; font-size: 23rpx; font-weight: 600; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }
.task-subtitle { margin-top: 1rpx; overflow: hidden; color: #8b8d89; font-size: 18rpx; line-height: 27rpx; text-overflow: ellipsis; white-space: nowrap; }
.task-status { display: flex; flex: none; gap: 6rpx; align-items: center; color: #818581; font-size: 19rpx; }
.task-status--complete { color: #3f7965; }
.task-status--active { color: #b57914; }
.task-empty { display: flex; min-height: 118rpx; padding: 12rpx 0 10rpx; flex-direction: column; align-items: center; justify-content: center; color: #858a85; font-size: 21rpx; text-align: center; }
.task-empty-action { margin-top: 12rpx; padding: 10rpx 24rpx; border: 1rpx solid rgba(36,91,77,.26); border-radius: 999rpx; color: #245b4d; background: rgba(236,243,238,.74); }

.recent-card { display: flex; min-height: 116rpx; box-sizing: border-box; margin-top: 18rpx; padding: 19rpx 22rpx; gap: 18rpx; align-items: center; border: 1rpx solid rgba(104,139,124,.2); border-radius: 28rpx; background: linear-gradient(100deg,rgba(238,245,241,.95),rgba(255,252,244,.92)); }
.recent-summary { display: flex; min-width: 180rpx; flex: none; gap: 12rpx; align-items: center; }
.recent-mark { display: flex; width: 58rpx; height: 58rpx; flex: none; align-items: center; justify-content: center; border-radius: 50%; background: linear-gradient(145deg,#fff4d8,#efe2ba); }
.recent-mark image { width: 49rpx; height: 36rpx; }
.recent-title { color: #2a3933; font-size: 23rpx; font-weight: 650; line-height: 31rpx; }
.recent-copy { margin-top: 2rpx; color: #7b827d; font-size: 18rpx; white-space: nowrap; }
.recent-chart { position: relative; display: flex; min-width: 0; height: 66rpx; flex: 1; align-items: center; justify-content: space-between; }
.recent-line { position: absolute; top: 24rpx; right: 8rpx; left: 8rpx; border-top: 2rpx dashed rgba(56,105,87,.38); }
.recent-point { position: relative; z-index: 1; display: flex; width: 24rpx; height: 66rpx; flex-direction: column; align-items: center; justify-content: flex-start; color: #898c88; font-size: 17rpx; line-height: 22rpx; }
.recent-dot { width: 13rpx; height: 13rpx; margin-top: 18rpx; margin-bottom: 9rpx; border: 3rpx solid #eef4ef; border-radius: 50%; background: #b9c2bd; }
.recent-dot--1 { background: #91ad9f; }
.recent-dot--2 { background: #5f8b78; }
.recent-dot--3 { background: #2f6a57; }
.recent-point.is-today { color: #a97920; font-weight: 650; }
.recent-point.is-today .recent-dot { width: 16rpx; height: 16rpx; margin-top: 16rpx; margin-bottom: 7rpx; border-color: #fff8e6; background: #c89b4a; box-shadow: 0 0 0 3rpx rgba(200,155,74,.5); }
.recent-longest { min-width: 70rpx; flex: none; color: #858884; font-size: 17rpx; text-align: center; }
.recent-longest > view { color: #315f50; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 38rpx; line-height: 43rpx; }
.recent-longest > view text { margin-left: 2rpx; font-family: var(--font-family-sans); font-size: 17rpx; }
.recent-longest > text { white-space: nowrap; }
.conversation-section { margin-top: 16rpx; }

@keyframes breathe { 0%,100% { opacity: .72; transform: scale(.92); } 50% { opacity: 1; transform: scale(1.05); } }
@media (max-width: 350px) {
  .coach-nav { padding-left: 14rpx; }
  .nav-title { font-size: 31rpx; letter-spacing: 3rpx; }
  .coach-brand { width: 66rpx; }
  .coach-content { padding-right: 20rpx; padding-left: 20rpx; }
  .hero-conclusion { right: 28rpx; left: 30rpx; }
  .hero-title { font-size: 42rpx; }
  .metric-grid { gap: 9rpx; }
  .metric-card { min-height: 246rpx; padding-right: 14rpx; padding-left: 14rpx; }
  .metric-value { font-size: 50rpx; }
  .metric-label { font-size: 21rpx; }
  .metric-note { font-size: 16rpx; line-height: 24rpx; }
  .advice-content { padding-right: 18rpx; padding-left: 18rpx; }
  .advice-quick { min-height: 60rpx; padding-right: 5rpx; padding-left: 5rpx; font-size: 17rpx; }
  .advice-quick .t-icon { display: none; }
  .actions-card { padding-right: 18rpx; padding-left: 18rpx; }
  .task-status { font-size: 17rpx; }
  .recent-card { padding-right: 15rpx; padding-left: 15rpx; gap: 10rpx; }
  .recent-summary { min-width: 152rpx; }
  .recent-mark { width: 48rpx; height: 48rpx; }
  .recent-mark image { width: 41rpx; height: 31rpx; }
  .recent-copy { font-size: 16rpx; }
  .recent-longest { min-width: 60rpx; }
  .scope-popover { width: 500rpx; }
}
@media (prefers-reduced-motion: reduce) { .loading-orb { animation: none; } }

/* Semantic type roles for the daily coach's diagnosis and action review. */
.nav-title { font-size: var(--font-page-title); line-height: var(--line-height-page-title); }
.hero-title,
.advice-title,
.section-title,
.recent-title { font-size: var(--font-card-title); line-height: var(--line-height-card-title); }
.metric-value { font-size: var(--font-data); line-height: var(--line-height-data); }
.metric-label,
.task-title,
.recent-summary { font-size: var(--font-body-strong); line-height: var(--line-height-body-strong); }
.metric-note,
.section-subtitle,
.task-subtitle,
.recent-longest { font-size: var(--font-meta); line-height: var(--line-height-meta); }
.scope-switch,
.scope-option text:first-child,
.advice-quick,
.task-status { font-size: var(--font-tag); line-height: var(--line-height-tag); }
.hero-title,
.advice-copy,
.state-copy,
.task-copy,
.recent-copy,
.task-empty { font-size: var(--font-caption); line-height: var(--line-height-caption); }
.section-link,
.empty-action-button,
.task-empty-action,
.retry-button { font-size: var(--font-body-strong); line-height: var(--line-height-body-strong); }
.recent-mark { font-size: var(--font-icon-display); line-height: var(--line-height-data); }

@media (max-width: 350px) {
  .nav-title { font-size: var(--font-page-title-compact); line-height: var(--line-height-page-title); }
  .hero-title,
  .advice-title,
  .section-title,
  .recent-title { font-size: var(--font-card-title-compact); line-height: var(--line-height-card-title); }
  .hero-title,
  .advice-copy,
  .state-copy,
  .task-copy,
  .recent-copy,
  .task-empty { font-size: var(--font-caption-compact); line-height: var(--line-height-caption); }
  .metric-value { font-size: var(--font-data-compact); line-height: var(--line-height-data); }
  .metric-note,
  .section-subtitle,
  .task-subtitle,
  .recent-longest { font-size: var(--font-meta-compact); line-height: var(--line-height-meta); }
  .scope-switch,
  .scope-option text:first-child,
  .advice-quick,
  .task-status { font-size: var(--font-tag-compact); line-height: var(--line-height-tag); }
}
