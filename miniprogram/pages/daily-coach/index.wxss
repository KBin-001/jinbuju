@import "../../styles/theme.wxss";

page {
  height: 100%;
  overflow: hidden;
  background: #F7F1E9;
}

.coach-page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
  height: 100vh;
  padding-right: 32rpx;
  padding-left: 32rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #FAF6EF 0%, #F6EFE7 58%, #F1ECE2 100%);
  color: #111820;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", Arial, sans-serif;
}

.coach-header {
  display: flex;
  align-items: center;
  height: 90rpx;
  flex: 0 0 auto;
  padding-right: 12rpx;
}

.coach-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: rgba(34, 34, 34, 0.055);
  color: #191C1F;
  font-size: 54rpx;
  line-height: 60rpx;
}

.coach-heading {
  min-width: 0;
  margin-left: 20rpx;
}

.coach-title {
  color: #111820;
  font-size: 40rpx;
  font-weight: 850;
  line-height: 48rpx;
  letter-spacing: -0.8rpx;
  white-space: nowrap;
}

.coach-title text {
  color: #F2A51B;
  font-size: 25rpx;
  vertical-align: top;
}

.coach-subtitle {
  overflow: hidden;
  margin-top: 3rpx;
  color: #857F79;
  font-size: 21rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coach-prompts {
  width: 100%;
  margin-top: 18rpx;
  flex: 0 0 70rpx;
  white-space: nowrap;
}

.coach-prompts-inner {
  display: inline-flex;
  align-items: center;
  height: 70rpx;
}

.coach-prompt {
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  height: 64rpx;
  margin-right: 14rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.90);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #303539;
  font-size: 23rpx;
  font-weight: 650;
  box-shadow: 0 9rpx 20rpx rgba(70, 48, 30, 0.065);
}

.coach-conversation {
  width: 100%;
  min-height: 0;
  margin-top: 18rpx;
  flex: 1;
}

.coach-bot-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.coach-robot {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 auto;
}

.coach-bubble {
  box-sizing: border-box;
  border: 1rpx solid rgba(224, 219, 211, 0.82);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 13rpx 28rpx rgba(52, 40, 31, 0.10);
}

.coach-bot-bubble {
  display: flex;
  flex-direction: column;
  width: 472rpx;
  padding: 24rpx 28rpx;
  color: #2F3437;
  font-size: 25rpx;
  line-height: 42rpx;
}

.coach-user-row {
  display: flex;
  align-items: flex-end;
  flex-direction: column;
  margin-top: 30rpx;
}

.coach-user-bubble {
  max-width: 470rpx;
  padding: 24rpx 28rpx;
  border: 0;
  border-radius: 30rpx 30rpx 4rpx 30rpx;
  background: #2F8FF2;
  color: #FFFFFF;
  font-size: 25rpx;
  line-height: 38rpx;
  box-shadow: 0 10rpx 22rpx rgba(46, 143, 242, 0.22);
}

.coach-time {
  margin-top: 8rpx;
  color: #8B8F94;
  font-size: 18rpx;
}

.coach-report-row {
  margin-top: 24rpx;
}

.coach-report-bubble {
  width: 600rpx;
  padding: 0;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.84);
}

.coach-report-intro {
  padding: 26rpx 28rpx 18rpx;
  color: #303539;
  font-size: 25rpx;
  line-height: 38rpx;
}

.coach-report-card {
  margin: 0 20rpx 16rpx;
  padding: 24rpx;
  border: 1rpx solid #EEE9E2;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(55, 42, 29, 0.045);
}

.coach-report-title {
  color: #171D1A;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 36rpx;
}

.coach-report-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 22rpx;
  text-align: center;
}

.coach-report-metric {
  display: flex;
  align-items: center;
  flex-direction: column;
  min-width: 0;
  border-right: 1rpx solid #EBE6DE;
}

.coach-report-metric:last-child {
  border-right: 0;
}

.coach-report-value {
  color: #111820;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.coach-report-value--green {
  color: #0D805E;
}

.coach-report-unit {
  margin-left: 4rpx;
  color: #252A2E;
  font-size: 17rpx;
  font-weight: 700;
}

.coach-report-label {
  margin-top: 8rpx;
  color: #666C72;
  font-size: 20rpx;
}

.coach-report-progress {
  height: 7rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 7rpx;
  background: #E7EFEA;
}

.coach-report-progress-inner {
  height: 100%;
  border-radius: inherit;
  background: #168A61;
}

.coach-analysis-card {
  padding-bottom: 18rpx;
}

.coach-analysis-line {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
  color: #34393C;
  font-size: 22rpx;
  line-height: 34rpx;
}

.coach-analysis-dot {
  width: 13rpx;
  height: 13rpx;
  margin-top: 10rpx;
  margin-right: 14rpx;
  flex: 0 0 auto;
  border-radius: 50%;
}

.coach-analysis-dot--green { background: #2FB582; }
.coach-analysis-dot--amber { background: #F6A623; }

.coach-report-actions {
  display: flex;
  margin: 0 20rpx 22rpx;
  gap: 14rpx;
}

.coach-report-action {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  min-width: 0;
  flex: 1;
  border: 1rpx solid rgba(228, 232, 229, 0.92);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #19211E;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(55, 42, 29, 0.045);
}

.coach-report-action-icon {
  margin-right: 9rpx;
  font-size: 23rpx;
}

.coach-action-section {
  margin-top: 18rpx;
}

.coach-action-heading {
  color: #777C79;
  font-size: 20rpx;
  font-weight: 650;
}

.coach-action-row {
  display: flex;
  align-items: center;
  min-height: 52rpx;
  border-bottom: 1rpx solid #F0ECE6;
}

.coach-action-row:last-child {
  border-bottom: 0;
}

.coach-action-check,
.coach-action-pending {
  width: 25rpx;
  height: 25rpx;
  flex: 0 0 auto;
  border-radius: 50%;
}

.coach-action-check {
  background: #168A61;
  color: #FFFFFF;
  font-size: 16rpx;
  line-height: 25rpx;
  text-align: center;
}

.coach-action-pending {
  box-sizing: border-box;
  border: 2rpx solid #D7B35C;
}

.coach-action-title {
  overflow: hidden;
  margin-left: 12rpx;
  flex: 1;
  color: #2F3437;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coach-action-time {
  margin-left: 12rpx;
  color: #858A87;
  font-size: 18rpx;
}

.coach-action-empty {
  margin-top: 16rpx;
  color: #858A87;
  font-size: 21rpx;
}

.coach-suggestion-title {
  margin: 2rpx 24rpx 14rpx;
  color: #222925;
  font-size: 25rpx;
  font-weight: 800;
}

.coach-suggestion-list {
  margin: 0 20rpx 22rpx;
}

.coach-suggestion {
  display: flex;
  align-items: center;
  min-height: 62rpx;
  margin-top: 10rpx;
  padding: 0 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.90);
  box-shadow: 0 6rpx 14rpx rgba(55, 42, 29, 0.045);
}

.coach-suggestion-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #EAF5EF;
  color: #168A61;
  font-size: 18rpx;
  font-weight: 800;
}

.coach-suggestion-copy {
  margin-left: 12rpx;
  color: #34393C;
  font-size: 21rpx;
  line-height: 30rpx;
}

.coach-followup-row {
  margin-top: 24rpx;
}

.coach-scroll-spacer {
  height: 30rpx;
}

.coach-message-bar {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 104rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  flex: 0 0 auto;
  gap: 14rpx;
}

.coach-input-wrap {
  display: flex;
  align-items: center;
  height: 76rpx;
  min-width: 0;
  flex: 1;
  border: 1rpx solid #E1DDD6;
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.90);
  box-shadow: 0 8rpx 20rpx rgba(55, 42, 29, 0.06);
}

.coach-input {
  box-sizing: border-box;
  width: 100%;
  height: 76rpx;
  padding: 0 28rpx;
  color: #252A2E;
  font-size: 24rpx;
}

.coach-placeholder {
  color: #9A9B9D;
}

.coach-send {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #2F8FF2;
  color: #FFFFFF;
  font-size: 30rpx;
  box-shadow: 0 10rpx 20rpx rgba(47, 143, 242, 0.24);
}

.coach-pressed {
  opacity: 0.62;
}

.coach-state {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  flex-direction: column;
  color: #68706C;
  font-size: 24rpx;
}

.coach-state image {
  width: 82rpx;
  height: 82rpx;
  margin-bottom: 18rpx;
}

.coach-state--error button {
  height: 64rpx;
  margin-top: 22rpx;
  padding: 0 26rpx;
  border: 0;
  border-radius: 32rpx;
  background: #356859;
  color: #FFFFFF;
  font-size: 23rpx;
}

.coach-state-copy {
  margin-top: 10rpx;
  color: #7D817F;
}

@media (max-width: 350px) {
  .coach-page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .coach-header {
    padding-right: 150rpx;
  }

  .coach-title {
    font-size: 36rpx;
  }

  .coach-report-bubble {
    width: 540rpx;
  }
}
.coach-compact-reply {
  box-sizing: border-box;
  width: calc(100% - 76rpx);
  padding: 24rpx;
  border: 1rpx solid rgba(53, 104, 89, 0.10);
  border-radius: 24rpx 24rpx 24rpx 8rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 30rpx rgba(31, 70, 58, 0.07);
}

.coach-direct-reply {
  white-space: pre-wrap;
  word-break: break-all;
}

.coach-real-thinking {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 140rpx;
}

.coach-real-thinking view {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #F0A13B;
  box-shadow: 0 0 0 0 rgba(240, 161, 59, 0.30);
  animation: coach-real-pulse 1.4s ease-in-out infinite;
}

.coach-real-thinking text { color: #7B817D; font-size: 21rpx; }

@keyframes coach-real-pulse {
  0%, 100% { opacity: 0.65; transform: scale(0.82); box-shadow: 0 0 0 0 rgba(240, 161, 59, 0.26); }
  50% { opacity: 1; transform: scale(1.08); box-shadow: 0 0 0 12rpx rgba(240, 161, 59, 0); }
}

.coach-chat-error {
  width: calc(100% - 80rpx);
  margin: 18rpx 0 0 76rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(214, 170, 66, 0.28);
  border-radius: 18rpx;
  background: #FFF8E5;
  color: #7E6528;
  font-size: 20rpx;
  line-height: 31rpx;
}

.coach-chat-error view { margin-top: 8rpx; color: #356859; font-weight: 700; }

.coach-direct-wrap { max-width: 82%; }
.coach-direct-wrap .coach-bubble { max-width: 100%; }
.coach-action-proposal { margin-top: 12rpx; padding: 20rpx; border: 1rpx solid #D7E4DE; border-radius: 22rpx; background: #FFFFFF; box-shadow: 0 10rpx 24rpx rgba(31, 70, 58, 0.07); }
.coach-action-proposal-label { color: #71827A; font-size: 20rpx; font-weight: 700; }
.coach-action-proposal-summary { margin-top: 8rpx; color: #233B34; font-size: 25rpx; font-weight: 700; line-height: 38rpx; }
.coach-action-proposal-actions { display: flex; justify-content: flex-end; margin-top: 16rpx; }
.coach-action-confirm { min-height: 60rpx; padding: 0 28rpx; border-radius: 30rpx; background: #356859; color: #FFFFFF; font-size: 24rpx; font-weight: 700; line-height: 60rpx; }
.coach-action-success { margin-top: 16rpx; color: #356859; font-size: 23rpx; font-weight: 700; }
.coach-action-candidates { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.coach-action-candidate { min-height: 52rpx; padding: 0 20rpx; border: 1rpx solid #D7E4DE; border-radius: 26rpx; background: #FFFFFF; color: #356859; font-size: 22rpx; font-weight: 700; line-height: 52rpx; }
.coach-send.is-disabled { opacity: 0.48; }

.coach-compact-summary {
  color: #233B34;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 38rpx;
}

.coach-compact-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 20rpx;
}

.coach-compact-metric {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 92rpx;
  padding: 10rpx 6rpx;
  border-radius: 16rpx;
  background: #F5F7F5;
}

.coach-compact-metric-value {
  max-width: 100%;
  color: #233B34;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 34rpx;
  word-break: break-all;
}

.coach-compact-metric-label {
  margin-top: 4rpx;
  color: #839089;
  font-size: 17rpx;
  line-height: 24rpx;
}

.coach-compact-insights {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 18rpx;
}

.coach-compact-insight {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  color: #52645C;
  font-size: 21rpx;
  line-height: 32rpx;
}

.coach-compact-insight > view {
  width: 10rpx;
  height: 10rpx;
  margin-top: 11rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #55B98B;
}

.coach-compact-divider {
  height: 1rpx;
  margin: 20rpx 0 16rpx;
  background: #E6EEE9;
}

.coach-compact-advice-label {
  color: #D88A17;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.coach-compact-advice {
  margin-top: 6rpx;
  color: #71827A;
  font-size: 22rpx;
  line-height: 34rpx;
}

/* Natural-light premium chat skin shared by daily and progress coach pages. */
.coach-page {
  position: relative;
  isolation: isolate;
  background: linear-gradient(160deg, #F8F5EC 0%, #F3F3E9 52%, #EAF1EA 100%);
  color: #233B34;
}

.coach-ambient {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

.coach-ambient::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(250, 248, 241, 0.12) 0%, rgba(247, 245, 237, 0.76) 48%, rgba(238, 244, 237, 0.94) 100%);
}

.coach-ambient-mountain {
  position: absolute;
  right: -100rpx;
  bottom: 76rpx;
  width: 920rpx;
  height: 720rpx;
  opacity: 0.18;
  filter: saturate(0.72);
}

.coach-ambient-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(18rpx);
}

.coach-ambient-glow--top {
  top: -130rpx;
  right: -150rpx;
  width: 470rpx;
  height: 470rpx;
  background: radial-gradient(circle, rgba(248, 210, 106, 0.28) 0%, rgba(248, 210, 106, 0) 70%);
}

.coach-ambient-glow--bottom {
  left: -220rpx;
  bottom: 30rpx;
  width: 540rpx;
  height: 540rpx;
  background: radial-gradient(circle, rgba(88, 147, 120, 0.18) 0%, rgba(88, 147, 120, 0) 72%);
}

.coach-header,
.coach-prompts,
.coach-conversation,
.coach-state,
.coach-message-bar {
  position: relative;
  z-index: 1;
}

.coach-header {
  margin: 8rpx -4rpx 0;
  padding-left: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.48);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9), 0 14rpx 36rpx rgba(31, 70, 58, 0.06);
  backdrop-filter: blur(22rpx);
  -webkit-backdrop-filter: blur(22rpx);
}

.coach-back {
  background: rgba(255, 255, 255, 0.68);
  color: #315F50;
  box-shadow: inset 0 0 0 1rpx rgba(53, 104, 89, 0.08);
}

.coach-title { color: #1F4E40; }
.coach-title text { color: #C89B43; }
.coach-subtitle { color: #728179; }

.coach-prompt {
  border-color: rgba(53, 104, 89, 0.10);
  background: rgba(255, 255, 255, 0.74);
  color: #31594D;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.92), 0 10rpx 24rpx rgba(31, 70, 58, 0.06);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.coach-bot-row { gap: 16rpx; }

.coach-robot {
  box-sizing: border-box;
  width: 68rpx;
  height: 68rpx;
  overflow: hidden;
  border: 3rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 22rpx;
  background: linear-gradient(145deg, #EDF6F0, #DCECE2);
  box-shadow: 0 8rpx 22rpx rgba(31, 70, 58, 0.13), 0 0 0 1rpx rgba(53, 104, 89, 0.08);
}

.coach-bubble,
.coach-compact-reply {
  border-color: rgba(53, 104, 89, 0.10);
  background: linear-gradient(145deg, rgba(255, 255, 253, 0.94), rgba(247, 249, 244, 0.92));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.95), 0 14rpx 34rpx rgba(31, 70, 58, 0.08);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.coach-bot-bubble {
  max-width: calc(100% - 84rpx);
  border-radius: 10rpx 28rpx 28rpx 28rpx;
  color: #30483F;
}

.coach-user-bubble {
  border: 1rpx solid rgba(255, 255, 255, 0.30);
  background: linear-gradient(135deg, #2B6553 0%, #3E7B67 58%, #5A8C74 100%);
  color: #FFFFFF;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.18), 0 12rpx 28rpx rgba(31, 91, 74, 0.20);
}

.coach-time { color: #85918B; }

.coach-report-bubble {
  max-width: calc(100% - 84rpx);
  border-radius: 10rpx 30rpx 30rpx 30rpx;
  background: linear-gradient(155deg, rgba(255, 255, 252, 0.96), rgba(241, 247, 241, 0.92));
}

.coach-report-intro { color: #29483E; }

.coach-report-card {
  border: 1rpx solid rgba(53, 104, 89, 0.09);
  border-radius: 24rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.88), rgba(238, 246, 239, 0.82));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.96), 0 10rpx 26rpx rgba(31, 70, 58, 0.055);
}

.coach-report-title,
.coach-compact-summary { color: #234C3F; }
.coach-report-value--green,
.coach-compact-metric-value { color: #356859; }

.coach-report-progress { background: rgba(53, 104, 89, 0.10); }
.coach-report-progress-inner { background: linear-gradient(90deg, #356859, #7EAF85, #D5B55C); }

.coach-compact-metric {
  border: 1rpx solid rgba(53, 104, 89, 0.08);
  background: linear-gradient(150deg, #F7FAF5, #EDF5EF);
}

.coach-guided-action,
.coach-action-candidate {
  border-color: rgba(53, 104, 89, 0.16);
  background: rgba(241, 248, 243, 0.86);
  color: #356859;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.90);
}

.coach-action-proposal {
  border-color: rgba(200, 155, 67, 0.18);
  background: linear-gradient(145deg, #FFFCF3, #F5F8EF);
}

.coach-message-bar {
  box-sizing: border-box;
  margin: 0 -8rpx;
  padding: 14rpx 10rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(255, 255, 255, 0.80);
  border-radius: 34rpx 34rpx 0 0;
  background: rgba(248, 248, 242, 0.76);
  box-shadow: 0 -16rpx 40rpx rgba(31, 70, 58, 0.07);
  backdrop-filter: blur(28rpx);
  -webkit-backdrop-filter: blur(28rpx);
}

.coach-input-wrap {
  border-color: rgba(53, 104, 89, 0.12);
  background: rgba(255, 255, 255, 0.82);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.96), 0 8rpx 24rpx rgba(31, 70, 58, 0.06);
}

.coach-input { color: #29483E; }
.coach-placeholder { color: #96A09B; }

.coach-send {
  background: linear-gradient(145deg, #245B4A 0%, #3D7964 58%, #719C79 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.20), 0 10rpx 24rpx rgba(31, 91, 74, 0.24);
}

.coach-page .coach-typing {
  display: flex;
  align-items: center;
  width: auto;
  min-width: 172rpx;
  min-height: 54rpx;
  padding: 16rpx 24rpx;
  overflow: hidden;
}

.coach-page .coach-breathe-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.coach-page .coach-breathe-stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 auto;
}

.coach-page .coach-breathe-orb,
.coach-page .coach-breathe-ring {
  position: absolute;
  box-sizing: border-box;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
}

.coach-page .coach-breathe-orb {
  z-index: 2;
  background: radial-gradient(circle at 36% 30%, #FFF1B8 0%, #BFD7B7 36%, #4C846D 74%, #245B4A 100%);
  box-shadow: 0 4rpx 16rpx rgba(53, 104, 89, 0.24);
  animation: coach-premium-breathe 1.7s ease-in-out infinite;
}

.coach-page .coach-breathe-ring {
  z-index: 1;
  border: 2rpx solid rgba(71, 126, 102, 0.30);
  animation: coach-premium-ring 1.7s ease-out infinite;
}

.coach-page .coach-breathe-text {
  color: transparent;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 32rpx;
  letter-spacing: 2rpx;
  white-space: nowrap;
  background: linear-gradient(90deg, #245B4A 0%, #6B9A7B 28%, #D0A94E 50%, #6B9A7B 72%, #245B4A 100%);
  background-size: 240% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  animation: coach-thinking-shimmer 2.2s linear infinite;
}

@keyframes coach-premium-breathe {
  0%, 100% { opacity: 0.72; transform: scale(0.82); }
  50% { opacity: 1; transform: scale(1.12); }
}

@keyframes coach-premium-ring {
  0% { opacity: 0.54; transform: scale(0.66); }
  72%, 100% { opacity: 0; transform: scale(2); }
}

@keyframes coach-thinking-shimmer {
  0% { background-position: 120% 50%; }
  100% { background-position: -120% 50%; }
}

@media (max-width: 350px) {
  .coach-page { padding-right: 24rpx; padding-left: 24rpx; }
  .coach-header { padding-right: 12rpx; }
  .coach-robot { width: 60rpx; height: 60rpx; border-radius: 20rpx; }
  .coach-bot-bubble,
  .coach-report-bubble { max-width: calc(100% - 76rpx); }
  .coach-user-bubble { max-width: 440rpx; }
  .coach-message-bar { margin-right: -4rpx; margin-left: -4rpx; }
}

.coach-compact-full {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #FAFAF8;
  color: #52645C;
  font-size: 21rpx;
  line-height: 34rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.coach-compact-toggle {
  display: inline-flex;
  margin-top: 14rpx;
  color: #356859;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.coach-guided-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.coach-guided-actions--report {
  margin-top: 16rpx;
}

.coach-guided-action {
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 54rpx;
  padding: 0 20rpx;
  border: 1rpx solid #D7E4DE;
  border-radius: 27rpx;
  background: #F7FBF8;
  color: #356859;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 28rpx;
}

/* Keep late-defined interactive reply styles aligned with the premium skin. */
.coach-compact-full {
  border: 1rpx solid rgba(53, 104, 89, 0.08);
  background: rgba(247, 250, 246, 0.86);
  color: #52645C;
}

.coach-compact-toggle { color: #356859; }

.coach-guided-action {
  border-color: rgba(53, 104, 89, 0.16);
  background: rgba(241, 248, 243, 0.88);
  color: #356859;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.90), 0 6rpx 14rpx rgba(31, 70, 58, 0.04);
}
