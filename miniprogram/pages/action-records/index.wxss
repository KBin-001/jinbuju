page { background: var(--color-background, #F7F3EA); }
.action-records-page { min-height: 100vh; color: var(--color-text-main, #24312D); }
.custom-nav { box-sizing: content-box; height: 88rpx; padding: calc(env(safe-area-inset-top) + 8rpx) 32rpx 0; display: flex; align-items: center; justify-content: space-between; }
.nav-back, .nav-placeholder { width: 64rpx; height: 64rpx; }
.nav-back { display: flex; align-items: center; justify-content: center; border-radius: 50%; color: var(--color-primary); }
.nav-title { font-size: 34rpx; font-weight: 700; }
.page-content { padding: 20rpx 32rpx calc(64rpx + env(safe-area-inset-bottom)); }
.records-hero { position: relative; min-height: 182rpx; overflow: hidden; border: 1rpx solid var(--color-border-soft); border-radius: 28rpx; background: var(--color-card); }
.hero-mountain { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .58; }
.hero-veil { position: absolute; inset: 0; background: linear-gradient(100deg, rgba(255,252,246,.99), rgba(255,252,246,.9) 64%, rgba(255,252,246,.34)); }
.hero-content { position: relative; z-index: 1; padding: 26rpx 30rpx; }
.hero-eyebrow { color: var(--color-accent); font-size: 21rpx; font-weight: 650; letter-spacing: 2rpx; }
.hero-title { max-width: 82%; margin-top: 10rpx; display: -webkit-box; overflow: hidden; color: var(--color-primary); font-family: var(--font-family-brand); font-size: 36rpx; line-height: 48rpx; font-weight: var(--font-weight-title); -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.hero-summary { margin-top: 14rpx; display: block; color: var(--color-text-secondary); font-size: 21rpx; line-height: 32rpx; }
.filter-bar { margin-top: 22rpx; padding: 7rpx; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1rpx solid var(--color-border-soft); border-radius: 28rpx; background: rgba(255,252,246,.76); }
.filter-item { min-height: 66rpx; display: flex; align-items: center; justify-content: center; border-radius: 23rpx; color: var(--color-text-secondary); font-size: 23rpx; font-weight: 600; }
.filter-item.is-active { background: var(--color-action-primary); color: #FFF; box-shadow: 0 7rpx 16rpx rgba(85,127,117,.14); }
.record-groups { margin-top: 24rpx; }
.date-group { margin-top: 26rpx; }
.date-group:first-child { margin-top: 0; }
.date-heading { padding: 0 6rpx 12rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.date-title { color: var(--color-text-main); font-size: 26rpx; font-weight: 700; }
.date-summary { color: var(--color-text-tertiary, #969A96); font-size: 18rpx; }
.record-card { overflow: hidden; border: 1rpx solid var(--color-border-soft); border-radius: 26rpx; background: var(--color-card); }
.record-row { min-height: 106rpx; padding: 20rpx 24rpx; display: flex; align-items: center; gap: 16rpx; border-bottom: 1rpx solid var(--color-divider); }
.record-row:last-child { border-bottom: 0; }
.record-status { width: 42rpx; height: 42rpx; flex: none; display: flex; align-items: center; justify-content: center; border: 2rpx solid rgba(36,91,77,.18); border-radius: 50%; color: var(--color-primary); font-size: 22rpx; font-weight: 750; }
.record-status.is-completed { border-color: var(--color-success); background: var(--color-success); color: #FFF; }
.record-status.is-partial { border-color: var(--color-warning, #C89B4A); color: var(--color-warning, #9A732E); }
.pending-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: currentColor; }
.record-main { min-width: 0; flex: 1; }
.record-top { display: flex; align-items: flex-start; gap: 12rpx; }
.record-title { min-width: 0; flex: 1; display: -webkit-box; overflow: hidden; color: var(--color-text-main); font-size: 25rpx; line-height: 35rpx; font-weight: 650; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.status-text { min-height: 34rpx; padding: 2rpx 11rpx; flex: none; border-radius: 17rpx; background: var(--color-primary-soft); color: var(--color-primary); font-size: 18rpx; line-height: 30rpx; }
.status-text.success { background: var(--color-success-soft); color: var(--color-success); }
.status-text.warning { background: var(--color-warning-soft, #F7EEDB); color: var(--color-warning, #9A732E); }
.status-text.muted { background: var(--color-card-soft); color: var(--color-text-secondary); }
.status-text.is-completed { background: var(--color-success-soft); color: var(--color-success); }
.status-text.is-partial { background: var(--color-warning-soft, #F7EEDB); color: var(--color-warning, #9A732E); }
.status-text.is-pending { background: var(--color-card-soft); color: var(--color-text-secondary); }
.record-meta { margin-top: 7rpx; display: block; color: var(--color-text-secondary); font-size: 20rpx; line-height: 30rpx; }
.load-more { min-height: 76rpx; margin-top: 20rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(36,91,77,.16); border-radius: 38rpx; color: var(--color-primary); font-size: 22rpx; font-weight: 650; }
.state-card { min-height: 340rpx; margin-top: 24rpx; padding: 44rpx 32rpx; display: flex; align-items: center; justify-content: center; flex-direction: column; border: 1rpx solid var(--color-border-soft); border-radius: 28rpx; background: var(--color-card); color: var(--color-primary); text-align: center; }
.compact-state { min-height: 290rpx; }
.state-title { margin-top: 16rpx; color: var(--color-text-main); font-size: 28rpx; font-weight: 700; }
.state-desc { max-width: 480rpx; margin-top: 9rpx; color: var(--color-text-secondary); font-size: 22rpx; line-height: 34rpx; }
.state-action { min-height: 68rpx; margin-top: 22rpx; padding: 0 30rpx; display: flex; align-items: center; border-radius: 34rpx; background: var(--color-action-primary); color: #FFF; font-size: 23rpx; font-weight: 650; }
.empty-mountain { width: 140rpx; height: 96rpx; border-radius: 50%; opacity: .7; }
.tap-pressed { opacity: .66; }
@media (max-width: 350px) { .page-content { padding-right: 24rpx; padding-left: 24rpx; } .date-heading { align-items: flex-start; flex-direction: column; gap: 3rpx; } .record-row { padding-right: 18rpx; padding-left: 18rpx; } }

/* Semantic type roles for action history and status filters. */
.nav-title,
.hero-title { font-size: var(--font-page-title); line-height: var(--line-height-page-title); }
.hero-eyebrow,
.date-summary,
.record-meta { font-size: var(--font-meta); line-height: var(--line-height-meta); }
.hero-summary,
.state-desc { font-size: var(--font-caption); line-height: var(--line-height-caption); }
.filter-item,
.status-text { font-size: var(--font-tag); line-height: var(--line-height-tag); }
.date-title,
.record-title,
.state-title { font-size: var(--font-card-title); line-height: var(--line-height-card-title); }
.record-status { font-size: var(--font-icon-display); line-height: var(--line-height-data); }
.load-more,
.state-action { font-size: var(--font-body-strong); line-height: var(--line-height-body-strong); }

@media (max-width: 350px) {
  .nav-title,
  .hero-title { font-size: var(--font-page-title-compact); line-height: var(--line-height-page-title); }
  .date-title,
  .record-title,
  .state-title { font-size: var(--font-card-title-compact); line-height: var(--line-height-card-title); }
  .hero-summary,
  .state-desc { font-size: var(--font-caption-compact); line-height: var(--line-height-caption); }
  .hero-eyebrow,
  .date-summary,
  .record-meta { font-size: var(--font-meta-compact); line-height: var(--line-height-meta); }
  .filter-item,
  .status-text { font-size: var(--font-tag-compact); line-height: var(--line-height-tag); }
}
