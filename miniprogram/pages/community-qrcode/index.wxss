.container {
  min-height: 100vh;
  background-color: #F5F7F2;
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #356859;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

.qrcode-container {
  width: 500rpx;
  height: 500rpx;
  background-color: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 60rpx;
}

.qrcode {
  width: 420rpx;
  height: 420rpx;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading text {
  font-size: 28rpx;
  color: #999;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
}

.empty text {
  font-size: 28rpx;
  color: #999;
}

.hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #ccc;
}

.actions {
  width: 100%;
  margin-bottom: 60rpx;
}

.btn-save {
  width: 100%;
  height: 96rpx;
  background-color: #356859;
  color: #fff;
  font-size: 32rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-save[disabled] {
  background-color: #ccc;
}

.tips {
  width: 100%;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.tip-text {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}
