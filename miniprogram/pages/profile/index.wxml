<view class="page profile-page">
  <view class="user-card">
    <view class="avatar-wrap">
      <image wx:if="{{displayAvatarUrl}}" class="avatar-image" src="{{displayAvatarUrl}}" mode="aspectFill" />
      <text wx:else>{{displayAvatarText}}</text>
      <view class="avatar-badge">●</view>
      <button class="avatar-hitarea" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar"></button>
    </view>
    <view class="user-main">
      <view class="name-row">
        <view class="profile-name">{{displayName}}</view>
        <view class="name-caret">⌄</view>
      </view>
      <view class="level-row">
        <view class="level-pill">{{levelLabel}}</view>
        <view class="joined-days">入驻第 {{joinedDays}} 天</view>
      </view>
    </view>
    <button class="edit-profile-btn" bindtap="openProfileEditor">编辑资料</button>
  </view>

  <view class="goal-panel">
    <view class="panel-head">
      <view class="panel-title">我的目标</view>
      <view class="panel-status">进行中 {{activeGoalCount}} ›</view>
    </view>

    <view wx:if="{{goals.length === 0}}" class="empty-goal">
      <view class="empty-title">还没有进行中的目标</view>
      <view class="empty-desc">从一个想持续推进的小目标开始。</view>
    </view>

    <view wx:else class="goal-list">
      <view wx:for="{{goals}}" wx:key="id" class="goal-item" data-id="{{item.id}}" bindtap="openGoal">
        <view class="goal-item-head">
          <view class="goal-title">{{item.title}}</view>
          <view wx:if="{{item.isCurrent}}" class="current-chip">当前</view>
        </view>
        <view class="goal-meta-row">
          <text>已坚持 {{item.days}} 天</text>
          <text class="goal-percent">{{item.progressPercent}}%</text>
        </view>
        <view class="progress-track">
          <view class="progress-fill" style="width: {{item.progressPercent}}%;"></view>
        </view>
      </view>
    </view>

    <button class="add-goal-btn" bindtap="createGoal">+ 添加目标</button>
  </view>

  <view class="function-grid">
    <view wx:for="{{functionEntries}}" wx:key="key" class="function-item" data-key="{{item.key}}" bindtap="openFunction">
      <view class="function-icon">{{item.icon}}</view>
      <view class="function-title">{{item.title}}</view>
    </view>
  </view>

  <view wx:if="{{profileEditorVisible}}" class="profile-editor-layer">
    <view class="profile-editor-mask" catchtap="closeProfileEditor"></view>
    <view class="profile-editor-panel" catchtap="noop">
      <view class="popup-handle"></view>
      <view class="editor-head">
        <view>
          <view class="editor-kicker">PROFILE</view>
          <view class="editor-title">编辑展示资料</view>
        </view>
        <view class="panel-close" catchtap="closeProfileEditor">×</view>
      </view>

      <view class="profile-form-card">
        <view class="profile-avatar-row">
          <view class="profile-avatar-preview">
            <image wx:if="{{profileDraftAvatarUrl}}" src="{{profileDraftAvatarUrl}}" mode="aspectFill" />
            <text wx:else>{{profileDraftAvatarText}}</text>
          </view>
          <button class="avatar-choose-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">使用微信头像</button>
        </view>

        <view class="profile-field">
          <view class="profile-label">展示名称</view>
          <input class="profile-input" type="nickname" maxlength="16" value="{{profileDraftNickname}}" placeholder="输入昵称或选择微信昵称" bindinput="inputProfileNickname" />
        </view>

        <view class="profile-setting-row">
          <view>
            <view class="profile-label">在小队中使用该资料</view>
            <view class="profile-helper">匿名模式下仍会隐藏头像和名称。</view>
          </view>
          <switch checked="{{profileDraftUseInTeam}}" color="#356859" bindchange="toggleProfileUseInTeam" />
        </view>
      </view>

      <view class="profile-editor-actions">
        <button class="profile-cancel-btn" bindtap="closeProfileEditor">取消</button>
        <button class="profile-save-btn" bindtap="saveProfileEditor">保存</button>
      </view>
    </view>
  </view>
</view>
