<view class="profile-page" data-theme="{{currentThemeId}}">
  <view class="profile-top">
    <image class="profile-top__background" src="/assets/profile/profile-header-mist-v2.jpg" mode="aspectFill" aria-hidden="true" />
    <view class="profile-top__veil"></view>
    <view class="profile-hero tab-header" style="height: {{headerHeight}}px;">
      <view class="profile-nav tab-header__nav" style="padding-top: {{menuTop}}px; height: {{menuHeight}}px;"><text class="profile-nav__title tab-header__title">我的</text></view>
    </view>
    <view class="profile-identity">
      <view class="profile-avatar"><image wx:if="{{displayAvatarUrl}}" class="profile-avatar__image" src="{{displayAvatarUrl}}" mode="aspectFill" binderror="useDefaultAvatar" /><image wx:else class="profile-avatar__image profile-avatar__image--default" src="/images/icons/avatar.png" mode="aspectFit" /></view>
      <view class="profile-identity__copy">
        <text class="profile-user-name">{{displayName}}</text>
        <view class="profile-sync-line profile-sync-line--{{syncTone}}"><t-icon name="{{syncTone === 'success' ? 'check-circle-filled' : 'cloud'}}" size="25rpx" /><text>{{syncTitle}}</text></view>
      </view>
      <view class="profile-edit-line {{!accountAvailable ? 'is-disabled' : ''}}" bindtap="openProfileEditor" hover-class="is-pressed" aria-role="button" aria-label="编辑个人资料"><text>编辑</text><t-icon name="chevron-right" size="31rpx" /></view>
    </view>
  </view>

  <view class="profile-content">
    <view wx:if="{{status === 'loading'}}" class="paper-card profile-state-card"><t-loading size="48rpx" theme="circular" /><text class="profile-state-title">正在整理你的成长档案</text><text class="profile-state-copy">目标、行动和收藏马上就好。</text></view>
    <view wx:elif="{{status === 'error'}}" class="paper-card profile-state-card"><t-icon name="info-circle" size="58rpx" /><text class="profile-state-title">个人档案暂时没有加载出来</text><text class="profile-state-copy">{{errorMessage}}</text><t-button class="profile-retry-button" bindtap="retry">重新加载</t-button></view>

    <block wx:else>
      <view wx:if="{{showSyncNotice}}" class="sync-notice">
        <t-icon name="cloud" size="28rpx" />
        <text>{{syncNoticeText}}</text>
        <view class="sync-notice__retry" bindtap="retry" hover-class="is-pressed">重试</view>
      </view>

      <view wx:if="{{currentGoal}}" class="paper-card goal-card">
        <image class="goal-card__background" src="/assets/profile/goal-mountain-v2.jpg" mode="aspectFill" /><view class="goal-card__veil"></view>
        <view class="goal-card__content">
          <view class="goal-card__icon"><view class="goal-target-symbol"><view></view></view></view>
          <view class="goal-card__main"><text class="section-kicker">当前目标</text><text class="goal-title">{{currentGoal.title}}</text><text class="goal-persisted">{{currentGoal.continuityText}}</text></view>
          <view class="goal-manage" catchtap="manageGoals" hover-class="is-pressed" aria-role="button" aria-label="管理目标"><text>管理</text><t-icon name="chevron-right" size="31rpx" /></view>
        </view>
      </view>
      <view wx:else class="paper-card goal-card goal-empty"><view class="goal-card__icon"><view class="goal-target-symbol"><view></view></view></view><view class="goal-empty__main"><text class="section-kicker">当前目标</text><text class="goal-empty__title">还没有进行中的目标</text><text class="goal-empty__copy">从今天能完成的一小步开始。</text></view><view class="goal-empty__button" bindtap="createGoal" hover-class="is-pressed">添加目标</view>
      </view>

      <view class="paper-card growth-card" bindtap="viewAllStats" hover-class="is-pressed" aria-role="button" aria-label="查看成长记录">
        <view class="growth-icon"><view class="growth-chart-symbol"><view></view><view></view><view></view></view></view><view class="growth-copy"><text class="section-title">成长记录</text><text class="growth-summary">{{growth.completedActions}} 次行动 · {{growth.totalMinutes}} 分钟 · 连续 {{growth.currentStreakDays}} 天</text></view><t-icon name="chevron-right" size="33rpx" />
      </view>

      <view class="paper-card community-card" bindtap="openGrowthCommunity" hover-class="is-pressed" aria-role="button" aria-label="进入成长社区">
        <image class="community-card__path" src="/assets/profile/community-path.svg" mode="aspectFill" aria-hidden="true" />
        <view class="community-card__veil"></view>
        <view class="community-card__content">
          <view class="community-card__icon"><t-icon name="usergroup-add" size="38rpx" /></view>
          <view class="community-card__copy">
            <view class="community-card__title-row"><text class="community-card__title">成长社区</text><text class="community-card__badge">内测</text></view>
            <text class="community-card__description">找到同频伙伴，一起持续行动</text>
            <text class="community-card__benefits">每日交流 · 每周复盘 · 目标互助</text>
          </view>
          <view class="community-card__action"><text>进入社区</text><t-icon name="chevron-right" size="30rpx" /></view>
        </view>
      </view>

      <view class="paper-card manage-card">
        <view class="manage-head"><text class="section-title">管理与设置</text></view>
        <view class="manage-list">
          <view class="manage-row" data-key="goals" bindtap="openToolboxItem" hover-class="is-pressed"><view class="manage-icon"><t-icon name="flag" size="36rpx" /></view><view class="manage-copy"><text>目标管理</text><text>进行中与切换</text></view><text class="manage-value">{{activeGoalCount}} 个</text><t-icon name="chevron-right" size="33rpx" /></view>
          <view class="manage-row" data-key="history" bindtap="openToolboxItem" hover-class="is-pressed"><view class="manage-icon"><t-icon name="time" size="36rpx" /></view><view class="manage-copy"><text>历史目标</text><text>归档与最近删除</text></view><t-icon name="chevron-right" size="33rpx" /></view>
          <view class="manage-row" data-key="badges" bindtap="openToolboxItem" hover-class="is-pressed"><view class="manage-icon"><view class="manage-star-symbol"></view></view><view class="manage-copy"><text>成长收藏</text><text>阶段行动留下的纪念</text></view><text class="manage-value">{{achievementSummary}}</text><t-icon name="chevron-right" size="33rpx" /></view>
          <view class="manage-row" data-key="sync" bindtap="openToolboxItem" hover-class="is-pressed"><view class="manage-icon"><t-icon name="cloud" size="36rpx" /></view><view class="manage-copy"><text>云端数据与同步</text><text>最近成功 {{syncLabel}}</text></view><text class="manage-value manage-value--pill manage-value--{{syncTone}}">{{syncTitle}}</text><t-icon name="chevron-right" size="33rpx" /></view>
          <view class="manage-row" data-key="account" bindtap="openToolboxItem" hover-class="is-pressed"><view class="manage-icon"><t-icon name="user" size="36rpx" /></view><view class="manage-copy"><text>账号与安全</text><text>数据与注销</text></view><text wx:if="{{phoneBindingEnabled}}" class="manage-value {{phoneStatusText === '未绑定' ? 'manage-value--warning' : ''}}">{{phoneStatusText}}</text><t-icon name="chevron-right" size="33rpx" /></view>
          <view class="manage-row" data-key="privacy" bindtap="openToolboxItem" hover-class="is-pressed"><view class="manage-icon"><t-icon name="lock-on" size="36rpx" /></view><view class="manage-copy"><text>隐私与协议</text><text>授权、信息清单与协议</text></view><t-icon name="chevron-right" size="33rpx" /></view>
          <button class="manage-row manage-contact-row" open-type="contact" hover-class="is-pressed" aria-label="联系客服"><view class="manage-icon"><t-icon name="help-circle" size="36rpx" /></view><view class="manage-copy"><text>联系客服</text><text>问题咨询与使用帮助</text></view><t-icon name="chevron-right" size="33rpx" /></button>
          <view class="manage-row" data-key="about" bindtap="openToolboxItem" hover-class="is-pressed"><view class="manage-icon"><t-icon name="help-circle" size="36rpx" /></view><view class="manage-copy"><text>帮助与关于</text><text>产品说明与问题反馈</text></view><t-icon name="chevron-right" size="33rpx" /></view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{profileEditorVisible}}" class="sheet-layer">
    <view class="sheet-mask" catchtap="closeProfileEditor"></view>
    <view class="sheet-panel" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head"><view><text class="sheet-kicker">个人资料</text><text class="sheet-title">编辑展示资料</text></view><view class="sheet-close" catchtap="closeProfileEditor" aria-role="button" aria-label="关闭"><t-icon name="close" size="34rpx" /></view></view>
      <view class="profile-form-card">
        <view class="profile-avatar-row"><view class="profile-avatar-preview"><image wx:if="{{profileDraftAvatarUrl}}" src="{{profileDraftAvatarUrl}}" mode="aspectFill" binderror="useDefaultDraftAvatar" /><image wx:else class="profile-avatar-preview__default" src="/images/icons/avatar.png" mode="aspectFit" /></view><t-button wx:if="{{!platformPrivacyAuthorized}}" class="avatar-choose-btn" bindtap="authorizePlatformPrivacy">授权后选择头像</t-button><t-button wx:else class="avatar-choose-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">选择头像</t-button></view>
        <view class="profile-field"><text class="profile-label">展示名称</text><t-input class="profile-input" type="nickname" maxlength="16" value="{{profileDraftNickname}}" placeholder="输入昵称" bindchange="inputProfileNickname" /></view>
        <view class="profile-setting-row"><view><text class="profile-label">在小队中使用该资料</text><text class="profile-helper">匿名模式下仍会隐藏头像和名称。</text></view><t-switch value="{{profileDraftUseInTeam}}" color="#245B4D" bindchange="toggleProfileUseInTeam" /></view>
      </view>
      <view class="sheet-actions"><t-button class="sheet-cancel" disabled="{{profileSaving}}" bindtap="closeProfileEditor">取消</t-button><t-button class="sheet-save" loading="{{profileSaving}}" disabled="{{profileSaving}}" bindtap="saveProfileEditor">保存</t-button></view>
    </view>
  </view>

  <view wx:if="{{communitySheetVisible}}" class="community-sheet-layer" catchtouchmove="noop">
    <view class="community-sheet-mask" catchtap="closeGrowthCommunity"></view>
    <view class="community-sheet-panel" catchtap="noop">
      <view class="community-sheet-handle"></view>
      <view class="community-sheet-head">
        <view class="community-sheet-heading"><text class="community-sheet-kicker">成长社区</text><text class="community-sheet-title">{{communityTitle}}</text></view>
        <view class="community-sheet-close" catchtap="closeGrowthCommunity" hover-class="is-pressed" aria-role="button" aria-label="关闭成长社区"><t-icon name="close" size="34rpx" /></view>
      </view>

      <view wx:if="{{communitySheetStatus === 'loading'}}" class="community-sheet-state">
        <view class="community-state-symbol"><t-loading size="46rpx" theme="circular" /></view>
        <text class="community-state-title">正在读取社区入口</text>
        <text class="community-state-copy">请稍候，马上为你确认最新二维码。</text>
      </view>

      <view wx:elif="{{communitySheetStatus === 'preparing'}}" class="community-sheet-state">
        <view class="community-state-symbol"><t-icon name="qrcode" size="48rpx" /></view>
        <text class="community-state-title">社区入口正在准备</text>
        <text class="community-state-copy">{{communityDescription}}</text>
        <view wx:if="{{!communityBusy}}" class="community-state-action community-state-action--outline" bindtap="retryGrowthCommunity" hover-class="is-pressed">重新检查</view>
      </view>

      <view wx:elif="{{communitySheetStatus === 'ready'}}" class="community-sheet-ready">
        <text class="community-ready-copy">{{communityDescription}}</text>
        <view class="community-qr-frame" bindtap="previewGrowthCommunityQr" hover-class="is-pressed" aria-role="button" aria-label="预览社区二维码">
          <image class="community-qr-image" src="{{communityQrUrl}}" mode="aspectFit" show-menu-by-longpress="{{true}}" binderror="handleGrowthCommunityQrError" />
        </view>
        <text class="community-qr-tip">点击放大，或长按二维码识别</text>
      </view>

      <view wx:elif="{{communitySheetStatus === 'expired'}}" class="community-sheet-state">
        <view class="community-state-symbol community-state-symbol--warning"><t-icon name="time" size="48rpx" /></view>
        <text class="community-state-title">二维码已经过期</text>
        <text class="community-state-copy">刷新后会重新获取当前可用的社区入口。</text>
        <view class="community-state-action" bindtap="retryGrowthCommunity" hover-class="is-pressed">刷新二维码</view>
      </view>

      <view wx:else class="community-sheet-state">
        <view class="community-state-symbol community-state-symbol--warning"><t-icon name="error-circle" size="48rpx" /></view>
        <text class="community-state-title">社区入口暂时无法打开</text>
        <text class="community-state-copy">{{communityErrorMessage || '请检查网络后重试。'}}</text>
        <view class="community-state-action" bindtap="retryGrowthCommunity" hover-class="is-pressed">重新加载</view>
      </view>

      <view class="community-privacy-note"><t-icon name="info-circle" size="27rpx" /><text>二维码仅用于加入成长交流社群。加入后遵循微信社群规则；进步局不会读取群聊记录或通讯录，也不会自动上传你的目标和行动记录。</text></view>
    </view>
  </view>
</view>
