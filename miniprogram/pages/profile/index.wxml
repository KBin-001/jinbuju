<view class="page profile-page"><view class="growth-hero profile-hero"><view class="avatar">进</view><view><view class="hero-kicker">MY GROWTH</view><view class="hero-title">我的行动空间</view><view class="hero-copy">不用比较，只记录自己的推进。</view></view></view><view wx:if="{{goal}}" class="card goal-card"><view class="eyebrow">当前目标</view><view class="goal-title">{{goal.title}}</view><view class="goal-meta">创建于 {{goalCreatedDate}} · 进行中</view><button class="text-button" bindtap="goProgress">查看行动进度 ›</button></view><view wx:else class="card empty-goal"><view class="goal-title">还没有当前目标</view><view class="goal-meta">从一件真正想推进的事开始。</view><button class="primary-button" bindtap="createGoal">创建目标</button></view><view class="section-title">个人数据</view><view class="stats-grid"><view class="stat-card"><view class="stat-value">{{summary ? summary.totalActionDays : 0}}</view><view class="stat-label">累计行动天数</view></view><view class="stat-card blue"><view class="stat-value">{{summary ? summary.completedTasks : 0}}</view><view class="stat-label">累计完成行动</view></view><view class="stat-card wide"><view class="stat-value">{{summary ? summary.totalActualMinutes : 0}}<text> 分钟</text></view><view class="stat-label">累计实际投入</view></view></view><view class="menu-section"><view class="menu-title">目标与数据</view><view class="menu-card"><button class="menu-row" bindtap="showHistory"><text>历史目标</text><text class="arrow">›</text></button><button class="menu-row danger" bindtap="clearLocalData"><text>清除本地数据</text><text class="arrow">›</text></button></view></view><view class="menu-section"><view class="menu-title">帮助与信息</view><view class="menu-card"><button class="menu-row" open-type="feedback"><text>问题反馈</text><text class="arrow">›</text></button><button class="menu-row" bindtap="openPrivacy"><text>隐私政策</text><text class="arrow">›</text></button><button class="menu-row" bindtap="openTerms"><text>用户协议</text><text class="arrow">›</text></button><button class="menu-row" bindtap="openAbout"><text>关于进步局</text><text class="arrow">›</text></button></view></view></view>
