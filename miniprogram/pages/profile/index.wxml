<view class="profile-page" data-theme="{{currentThemeId}}">
  <view class="profile-hero">
    <image class="profile-hero__bg" src="/assets/profile/top-bg-watercolor.jpg" mode="aspectFill" />
    <view class="profile-nav">
      <text class="profile-nav__title">我的</text>
    </view>
  </view>

  <view class="profile-user-card">
    <view class="profile-avatar">
      <image wx:if="{{displayAvatarUrl}}" class="profile-avatar__image" src="{{displayAvatarUrl}}" mode="aspectFill" />
      <text wx:else class="profile-avatar__text">{{displayAvatarText}}</text>
      <button class="profile-avatar__picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar"></button>
    </view>

    <view class="profile-user-info">
      <text class="profile-user-name">{{displayName}}</text>
      <view class="profile-user-meta">
        <view class="profile-level-badge">
          <text class="profile-level-badge__star">★</text>
          <text class="profile-level-badge__text">{{levelLabel}}</text>
        </view>
        <text class="profile-user-meta__dot">·</text>
        <text class="profile-user-meta__days">入驻第 {{joinedDays}} 天</text>
      </view>
    </view>

    <view class="profile-edit" bindtap="openProfileEditor" hover-class="profile-edit--pressed">
      <image class="profile-edit__icon" src="/assets/profile/edit-button.svg" mode="aspectFit" />
    </view>
  </view>

  <view class="profile-content">
    <view class="profile-card growth-card">
      <view class="card-heading">
        <text class="card-heading__title">成长概览</text>
        <view class="card-heading__link" bindtap="viewAllStats">查看全部 ›</view>
      </view>

      <view class="growth-visual">
        <image class="growth-wave" src="/assets/profile/growth-wave.svg" mode="scaleToFill" />
        <image class="growth-medal growth-medal--calendar" src="/assets/profile/medal-calendar.svg" mode="aspectFit" />
        <image class="growth-medal growth-medal--check" src="/assets/profile/medal-check.svg" mode="aspectFit" />
        <image class="growth-medal growth-medal--timer" src="/assets/profile/medal-timer.svg" mode="aspectFit" />
      </view>

      <view class="growth-metrics">
        <view class="growth-metric">
          <view class="growth-metric__value"><text class="growth-metric__number">{{stats.streakDays}}</text><text class="growth-metric__unit">天</text></view>
          <text class="growth-metric__label">连续坚持</text>
        </view>
        <view class="growth-metric">
          <view class="growth-metric__value"><text class="growth-metric__number">{{stats.completedActions}}</text><text class="growth-metric__unit">项</text></view>
          <text class="growth-metric__label">完成行动</text>
        </view>
        <view class="growth-metric">
          <view class="growth-metric__value"><text class="growth-metric__number">{{stats.totalMinutes}}</text><text class="growth-metric__unit">分钟</text></view>
          <text class="growth-metric__label">累计投入</text>
        </view>
      </view>
    </view>

    <view class="profile-card goal-card">
      <view class="card-heading">
        <text class="card-heading__title">我的目标</text>
        <view class="card-heading__link" bindtap="manageGoals">管理目标 ›</view>
      </view>

      <view wx:if="{{goals.length === 0}}" class="goal-empty">
        <image class="goal-empty__icon" src="/assets/profile/target-icon.svg" mode="aspectFit" />
        <text class="goal-empty__title">还没有进行中的目标</text>
        <text class="goal-empty__desc">从一个想持续推进的小目标开始。</text>
        <view class="goal-empty__button" bindtap="createGoal">添加目标</view>
      </view>

      <view wx:else class="goal-list">
        <view
          wx:for="{{goals}}"
          wx:key="id"
          class="goal-item"
          data-id="{{item.id}}"
          bindtap="openGoal"
          hover-class="goal-item--pressed"
          hover-stay-time="120"
        >
          <view class="goal-main">
            <image class="goal-main__icon" src="/assets/profile/target-icon.svg" mode="aspectFit" />
            <view class="goal-main__info">
              <text class="goal-main__title">{{item.title}}</text>
              <text class="goal-main__sub">已坚持 {{item.days}} 天</text>
            </view>
            <view class="goal-status">{{item.isCurrent ? '进行中' : '待续'}}</view>
          </view>

          <view class="goal-progress-row">
            <view class="goal-progress"><view class="goal-progress__fill" style="width: {{item.progressPercent}}%;"></view></view>
            <text class="goal-progress__number">{{item.progressPercent}}%</text>
          </view>

          <view class="goal-actions">
            <view class="goal-action goal-action--archive" data-id="{{item.id}}" catchtap="viewGoalArchive">查看成长档案</view>
            <view
              wx:if="{{item.isCurrent}}"
              class="goal-action goal-action--end {{endingGoalId === item.id ? 'is-disabled' : ''}}"
              data-id="{{item.id}}"
              catchtap="endCurrentGoal"
            >{{endingGoalId === item.id ? '正在结束' : '结束目标'}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="profile-card toolbox-card">
      <view class="card-heading toolbox-heading">
        <text class="card-heading__title">工具箱</text>
      </view>

      <view class="toolbox-grid">
        <view class="toolbox-item toolbox-item--history" data-key="history" bindtap="openToolboxItem" hover-class="toolbox-item--pressed">
          <image class="toolbox-item__icon" src="/assets/profile/tool-history.svg" mode="aspectFit" />
          <text class="toolbox-item__title">历史数据</text>
        </view>
        <view class="toolbox-item toolbox-item--trophy" data-key="badges" bindtap="openToolboxItem" hover-class="toolbox-item--pressed">
          <image class="toolbox-item__icon" src="/assets/profile/tool-trophy.svg" mode="aspectFit" />
          <text class="toolbox-item__title">成就徽章</text>
        </view>
        <view class="toolbox-item toolbox-item--ai" data-key="ai" bindtap="openToolboxItem" hover-class="toolbox-item--pressed">
          <image class="toolbox-item__icon" src="/assets/profile/tool-ai.svg" mode="aspectFit" />
          <text class="toolbox-item__title toolbox-item__title--strong">AI 教练</text>
          <text class="toolbox-item__sub">查看分析</text>
        </view>
        <view class="toolbox-item toolbox-item--settings" data-key="settings" bindtap="openToolboxItem" hover-class="toolbox-item--pressed">
          <image class="toolbox-item__icon" src="/assets/profile/tool-settings.svg" mode="aspectFit" />
          <text class="toolbox-item__title">数据设置</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{profileEditorVisible}}" class="profile-editor-layer">
    <view class="profile-editor-mask" catchtap="closeProfileEditor"></view>
    <view class="profile-editor-panel" catchtap="noop">
      <view class="popup-handle"></view>
      <view class="editor-head">
        <view>
          <view class="editor-kicker">PROFILE</view>
          <view class="editor-title">编辑展示资料</view>
        </view>
        <view class="panel-close" catchtap="closeProfileEditor">×</view>
      </view>

      <view class="profile-form-card">
        <view class="profile-avatar-row">
          <view class="profile-avatar-preview">
            <image wx:if="{{profileDraftAvatarUrl}}" src="{{profileDraftAvatarUrl}}" mode="aspectFill" />
            <text wx:else>{{profileDraftAvatarText}}</text>
          </view>
          <button class="avatar-choose-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">使用微信头像</button>
        </view>

        <view class="profile-field">
          <view class="profile-label">展示名称</view>
          <input class="profile-input" type="nickname" maxlength="16" value="{{profileDraftNickname}}" placeholder="输入昵称或选择微信昵称" bindinput="inputProfileNickname" />
        </view>

        <view class="profile-setting-row">
          <view>
            <view class="profile-label">在小队中使用该资料</view>
            <view class="profile-helper">匿名模式下仍会隐藏头像和名称。</view>
          </view>
          <switch checked="{{profileDraftUseInTeam}}" color="#2F6D5D" bindchange="toggleProfileUseInTeam" />
        </view>
      </view>

      <view class="profile-editor-actions">
        <button class="profile-cancel-btn" bindtap="closeProfileEditor">取消</button>
        <button class="profile-save-btn" bindtap="saveProfileEditor">保存</button>
      </view>
    </view>
  </view>
</view>
