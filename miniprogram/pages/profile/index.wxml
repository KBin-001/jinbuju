<view class="profile-page" data-theme="{{currentThemeId}}">
  <view class="profile-hero">
    <image class="profile-hero__background" src="/assets/profile/profile-header-mist-v2.jpg" mode="aspectFill" />
    <view class="profile-hero__veil"></view>
    <view class="profile-nav" style="padding-top: {{menuTop}}px; height: {{menuHeight}}px;">
      <text class="profile-nav__title">我的</text>
    </view>

    <view class="profile-identity">
      <view class="profile-avatar">
        <image wx:if="{{displayAvatarUrl}}" class="profile-avatar__image" src="{{displayAvatarUrl}}" mode="aspectFill" />
        <view wx:else class="profile-avatar__text">{{displayAvatarText}}</view>
      </view>
      <view class="profile-identity__copy">
        <text class="profile-user-name">{{displayName}}</text>
        <view class="profile-cloud-line"><text class="profile-cloud-icon">⌁</text><text>云端个人档案</text></view>
        <view class="profile-edit-line" bindtap="openProfileEditor" hover-class="is-pressed"><text class="profile-edit-mark">⌑</text><text>编辑资料</text></view>
      </view>
    </view>
  </view>

  <view class="profile-content">
    <view class="paper-card journey-card" bindtap="viewAllStats">
      <view class="journey-copy">
        <text class="journey-title">这一程</text>
        <view class="journey-days"><text>已加入</text><text class="journey-days__number">{{joinedDays}}</text><text>天</text></view>
        <text class="journey-quote">每一步，都算数</text>
      </view>
      <view class="journey-ring" aria-hidden="true">
        <view class="journey-ring__track"></view>
        <view class="journey-ring__arc"></view>
        <view class="journey-ring__route"><text>⌁</text><view class="journey-ring__sun"></view></view>
        <view class="journey-ring__dot"></view>
      </view>
    </view>

    <view class="paper-card weekly-card">
      <text class="section-title">本周小结</text>
      <view class="weekly-metrics">
        <view class="weekly-metric"><view class="weekly-label"><t-icon name="calendar" size="34rpx" /><text>行动天数</text></view><view><text class="weekly-number">{{weeklySummary.actionDays}}</text><text class="weekly-unit">天</text></view></view>
        <view class="weekly-metric"><view class="weekly-label"><t-icon name="check-circle" size="34rpx" /><text>完成行动</text></view><view><text class="weekly-number">{{weeklySummary.completedActions}}</text><text class="weekly-unit">次</text></view></view>
        <view class="weekly-metric"><view class="weekly-label"><t-icon name="time" size="34rpx" /><text>投入</text></view><view><text class="weekly-number">{{weeklySummary.actualMinutes}}</text><text class="weekly-unit">分钟</text></view></view>
      </view>
    </view>

    <view class="paper-card goal-card">
      <image class="goal-card__background" src="/assets/profile/goal-mountain-v2.jpg" mode="aspectFill" />
      <view class="goal-card__veil"></view>
      <view class="goal-card__content" wx:if="{{currentGoal}}" data-id="{{currentGoal.id}}" bindtap="openGoal">
        <text class="section-title">当前目标</text>
        <text class="goal-title">{{currentGoal.title}}</text>
        <view class="goal-track"><view class="goal-track__fill" style="width: {{currentGoal.progressPercent}}%;"></view></view>
        <view class="goal-percent"><text>{{currentGoal.progressPercent}}</text><text class="goal-percent__symbol">%</text></view>
      </view>
      <view class="goal-empty" wx:else>
        <text class="section-title">当前目标</text>
        <text class="goal-empty__title">还没有进行中的目标</text>
        <view class="goal-empty__button" bindtap="createGoal">添加目标</view>
      </view>
    </view>

    <view class="paper-card collection-card">
      <text class="section-title">成长收藏</text>
      <view class="collection-grid">
        <view wx:for="{{achievementPreviews}}" wx:key="id" class="collection-item {{item.unlocked ? 'is-unlocked' : 'is-locked'}}" data-id="{{item.id}}" bindtap="openAchievementPreview">
          <view class="collection-badge"><view class="collection-badge__star">★</view><image src="{{item.icon}}" mode="aspectFit" /><view wx:if="{{!item.unlocked}}" class="collection-lock">◇</view></view>
          <text class="collection-title">{{item.title}}</text>
          <text class="collection-date">{{item.dateLabel}}</text>
        </view>
      </view>
    </view>

    <view class="paper-card account-card">
      <text class="section-title">账号与数据</text>
      <view class="account-row" data-key="profile" bindtap="openToolboxItem"><t-icon name="user" size="38rpx" /><text>个人信息</text><text class="account-arrow">›</text></view>
      <view class="account-row" data-key="backup" bindtap="openToolboxItem"><t-icon name="cloud" size="38rpx" /><text>云端备份</text><text class="account-arrow">›</text></view>
      <view class="account-row" data-key="settings" bindtap="openToolboxItem"><t-icon name="setting" size="38rpx" /><text>设置与隐私</text><text class="account-arrow">›</text></view>
    </view>
  </view>

  <view wx:if="{{profileEditorVisible}}" class="sheet-layer">
    <view class="sheet-mask" catchtap="closeProfileEditor"></view>
    <view class="sheet-panel" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head"><view><text class="sheet-kicker">PROFILE</text><text class="sheet-title">编辑展示资料</text></view><view class="sheet-close" catchtap="closeProfileEditor">×</view></view>
      <view class="profile-form-card">
        <view class="profile-avatar-row"><view class="profile-avatar-preview"><image wx:if="{{profileDraftAvatarUrl}}" src="{{profileDraftAvatarUrl}}" mode="aspectFill" /><text wx:else>{{profileDraftAvatarText}}</text></view><t-button class="avatar-choose-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">选择头像</t-button></view>
        <view class="profile-field"><text class="profile-label">展示名称</text><t-input class="profile-input" type="nickname" maxlength="16" value="{{profileDraftNickname}}" placeholder="输入昵称" bindchange="inputProfileNickname" /></view>
        <view class="profile-setting-row"><view><text class="profile-label">在小队中使用该资料</text><text class="profile-helper">匿名模式下仍会隐藏头像和名称。</text></view><t-switch value="{{profileDraftUseInTeam}}" color="#31584B" bindchange="toggleProfileUseInTeam" /></view>
      </view>
      <view class="sheet-actions"><t-button class="sheet-cancel" bindtap="closeProfileEditor">取消</t-button><t-button class="sheet-save" bindtap="saveProfileEditor">保存</t-button></view>
    </view>
  </view>

  <view wx:if="{{accountSheetVisible}}" class="sheet-layer">
    <view class="sheet-mask" catchtap="closeAccountSheet"></view>
    <view class="sheet-panel account-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head"><view><text class="sheet-kicker">CLOUD ACCOUNT</text><text class="sheet-title">云端备份</text></view><view class="sheet-close" catchtap="closeAccountSheet">×</view></view>
      <view class="cloud-status"><view class="cloud-status__icon">✓</view><view><text class="cloud-status__title">微信身份已登录</text><text class="cloud-status__desc">目标、行动和成长记录正在云端保存</text></view></view>
      <view class="cloud-phone"><view><text class="cloud-phone__label">手机号</text><text class="cloud-phone__value">{{cloudAccount && cloudAccount.phoneBound ? cloudAccount.phoneMasked : '暂未绑定'}}</text></view><button class="cloud-phone__button" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{phoneBinding}}" disabled="{{phoneBinding}}">{{cloudAccount && cloudAccount.phoneBound ? '更换' : '绑定'}}</button></view>
    </view>
  </view>
</view>
