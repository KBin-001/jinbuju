<view class="profile-page" style="{{themeStyle}}" data-theme="{{currentThemeId}}">

  <!-- ======= 一、用户成长 Hero 卡（卡片式 Header） ======= -->
  <view class="hero-card">
    <image class="hero-botanical-bg" src="/images/profile-hero-bg.jpg" mode="aspectFill" />
    <view class="hero-readability-wash"></view>
    <view class="hero-soft-glow"></view>
    <view class="hero-light-speck hero-light-speck--white"></view>
    <view class="hero-light-speck hero-light-speck--honey"></view>

    <view class="hero-avatar-wrap">
      <image wx:if="{{displayAvatarUrl}}" class="hero-avatar-img" src="{{displayAvatarUrl}}" mode="aspectFill" />
      <text wx:else class="hero-avatar-text">{{displayAvatarText}}</text>
      <!-- 微信头像选取热区 -->
      <button class="avatar-hitarea" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar"></button>
    </view>

    <view class="hero-user-info">
      <view class="hero-name">{{displayName}}</view>
      <view class="hero-meta-row">
        <view class="hero-level-pill">⭐ {{levelLabel}}</view>
        <text class="hero-meta-dot">·</text>
        <text class="hero-joined">入驻第 {{joinedDays}} 天</text>
      </view>
    </view>

    <view
      class="hero-edit-btn"
      bindtap="openProfileEditor"
      hover-class="hero-edit-btn--pressed"
      hover-stay-time="120"
      aria-label="编辑资料"
    >
      <text class="hero-edit-icon">✎</text>
    </view>
  </view>

  <!-- 内容区 -->
  <view class="page-content">

    <!-- ======= 二、成长概览卡 ======= -->
    <view class="section-card overview-card">
      <view class="card-head">
        <text class="card-title">成长概览</text>
        <view class="card-link" bindtap="viewAllStats">查看全部 ›</view>
      </view>
      <view class="overview-stats">
        <view class="stat-col">
          <view class="stat-icon-wrap stat-icon-wrap--green">
            <text class="stat-icon">📅</text>
          </view>
          <text class="stat-num">{{stats.streakDays}}</text>
          <text class="stat-unit">天</text>
          <text class="stat-label">连续坚持</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-col">
          <view class="stat-icon-wrap stat-icon-wrap--teal">
            <text class="stat-icon">✅</text>
          </view>
          <text class="stat-num">{{stats.completedActions}}</text>
          <text class="stat-unit">项</text>
          <text class="stat-label">完成行动</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-col">
          <view class="stat-icon-wrap stat-icon-wrap--gold">
            <text class="stat-icon">⏱</text>
          </view>
          <text class="stat-num">{{stats.totalMinutes}}</text>
          <text class="stat-unit">分钟</text>
          <text class="stat-label">累计投入</text>
        </view>
      </view>
    </view>

    <!-- ======= 三、我的目标卡 ======= -->
    <view class="section-card goal-card">
      <view class="card-head">
        <text class="card-title">我的目标</text>
        <view class="card-link" bindtap="manageGoals">管理目标 ›</view>
      </view>

      <!-- 空状态 -->
      <view wx:if="{{goals.length === 0}}" class="goal-empty">
        <view class="goal-empty-icon">🎯</view>
        <view class="goal-empty-title">还没有进行中的目标</view>
        <view class="goal-empty-desc">从一个想持续推进的小目标开始。</view>
      </view>

      <!-- 目标列表 -->
      <view wx:else class="goal-list">
        <view
          wx:for="{{goals}}"
          wx:key="id"
          class="goal-item"
          data-id="{{item.id}}"
          bindtap="openGoal"
          hover-class="goal-item--pressed"
          hover-stay-time="120"
        >
          <view class="goal-item-main">
            <view class="goal-item-icon-wrap">
              <text class="goal-item-icon">🎯</text>
            </view>
            <view class="goal-item-body">
              <view class="goal-item-head">
                <text class="goal-item-title">{{item.title}}</text>
                <view class="goal-status-chip">{{item.isCurrent ? '进行中' : '待续'}}</view>
              </view>
              <text class="goal-item-sub">已坚持 {{item.days}} 天</text>
              <view class="goal-progress-row">
                <view class="goal-progress-track">
                  <view class="goal-progress-fill" style="width: {{item.progressPercent}}%;"></view>
                </view>
                <text class="goal-progress-pct">{{item.progressPercent}}%</text>
              </view>
              <view class="goal-action-row">
                <view class="goal-focus-action">{{item.isCurrent ? '查看成长档案' : '设为当前目标'}}</view>
                <view
                  wx:if="{{item.isCurrent}}"
                  class="goal-end-action {{endingGoalId === item.id ? 'is-disabled' : ''}}"
                  data-id="{{item.id}}"
                  catchtap="endCurrentGoal"
                >{{endingGoalId === item.id ? '正在结束' : '结束目标'}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 添加目标按钮 -->
      <view class="add-goal-btn" bindtap="createGoal" hover-class="add-goal-btn--pressed" hover-stay-time="120">
        <text class="add-goal-plus">+</text>
        <text class="add-goal-text">添加目标</text>
      </view>
    </view>

    <!-- ======= 四、功能入口卡 ======= -->
    <view class="section-card func-card">
      <view
        wx:for="{{functionEntries}}"
        wx:key="key"
        class="func-item"
        data-key="{{item.key}}"
        bindtap="openFunction"
        hover-class="func-item--pressed"
        hover-stay-time="120"
      >
        <view class="func-icon-wrap {{item.iconClass}}">
          <text class="func-icon-emoji">{{item.emoji}}</text>
        </view>
        <text class="func-label">{{item.title}}</text>
      </view>
    </view>

    <!-- ======= 五、本周小结卡 ======= -->
    <view class="section-card week-card">
      <view class="week-badge-wrap">
        <view class="week-badge">
          <text class="week-badge-icon">🌿</text>
        </view>
        <view class="week-text">
          <text class="week-title">本周小结</text>
          <text class="week-desc">你超过了 {{weekSummary.beatPercent}}% 的同伴，加油！</text>
          <view class="week-progress-track">
            <view class="week-progress-fill" style="width: {{weekSummary.beatPercent}}%;"></view>
          </view>
        </view>
      </view>
      <view class="week-detail-btn" bindtap="viewWeekDetail" hover-class="week-detail-btn--pressed" hover-stay-time="120">查看更多 ›</view>
    </view>

  </view>

  <!-- ======= 编辑资料弹层（保留原有逻辑） ======= -->
  <view wx:if="{{profileEditorVisible}}" class="profile-editor-layer">
    <view class="profile-editor-mask" catchtap="closeProfileEditor"></view>
    <view class="profile-editor-panel" catchtap="noop">
      <view class="popup-handle"></view>
      <view class="editor-head">
        <view>
          <view class="editor-kicker">PROFILE</view>
          <view class="editor-title">编辑展示资料</view>
        </view>
        <view class="panel-close" catchtap="closeProfileEditor">×</view>
      </view>

      <view class="profile-form-card">
        <view class="profile-avatar-row">
          <view class="profile-avatar-preview">
            <image wx:if="{{profileDraftAvatarUrl}}" src="{{profileDraftAvatarUrl}}" mode="aspectFill" />
            <text wx:else>{{profileDraftAvatarText}}</text>
          </view>
          <button class="avatar-choose-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">使用微信头像</button>
        </view>

        <view class="profile-field">
          <view class="profile-label">展示名称</view>
          <input class="profile-input" type="nickname" maxlength="16" value="{{profileDraftNickname}}" placeholder="输入昵称或选择微信昵称" bindinput="inputProfileNickname" />
        </view>

        <view class="profile-setting-row">
          <view>
            <view class="profile-label">在小队中使用该资料</view>
            <view class="profile-helper">匿名模式下仍会隐藏头像和名称。</view>
          </view>
          <switch checked="{{profileDraftUseInTeam}}" color="#145F4E" bindchange="toggleProfileUseInTeam" />
        </view>
      </view>

      <view class="profile-editor-actions">
        <button class="profile-cancel-btn" bindtap="closeProfileEditor">取消</button>
        <button class="profile-save-btn" bindtap="saveProfileEditor">保存</button>
      </view>
    </view>
  </view>

