.profile-page{padding-top:36rpx}.profile-hero{display:flex;align-items:center;gap:24rpx}.avatar{position:relative;width:102rpx;height:102rpx;display:flex;align-items:center;justify-content:center;border:4rpx solid rgba(255,255,255,.6);border-radius:32rpx;background:#f3c76a;color:#1f4d42;font-size:42rpx;font-weight:750}.hero-kicker{position:relative;color:#e8c97f;font-size:19rpx;letter-spacing:3rpx}.hero-title{position:relative;margin-top:8rpx;font-size:40rpx;font-weight:750}.hero-copy{position:relative;margin-top:8rpx;color:rgba(255,255,255,.68);font-size:23rpx}.goal-card,.empty-goal{margin-top:24rpx}.eyebrow{color:#356859;font-size:22rpx;font-weight:650}.goal-title{margin-top:8rpx;font-size:34rpx;font-weight:700}.goal-meta{margin-top:10rpx;color:#66736f;font-size:23rpx}.text-button{margin-top:20rpx;color:#356859;font-weight:650}.section-title{margin:34rpx 6rpx 18rpx;font-size:32rpx;font-weight:700}.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.stat-card{padding:26rpx;border-radius:27rpx;background:#dcebe4}.stat-card.blue{background:#e1ebf3}.stat-card.wide{grid-column:1/3;background:#fff0c9}.stat-value{font-size:42rpx;font-weight:750}.stat-value text{font-size:23rpx}.stat-label{margin-top:7rpx;color:#66736f;font-size:23rpx}.menu-section{margin-top:34rpx}.menu-title{margin:0 7rpx 13rpx;color:#66736f;font-size:23rpx;font-weight:650}.menu-card{overflow:hidden;border-radius:28rpx;background:#fff;box-shadow:0 10rpx 30rpx rgba(31,77,66,.07)}.menu-row{width:100%;display:flex;justify-content:space-between;padding:29rpx 30rpx;border-bottom:1rpx solid #e6ece8;text-align:left}.menu-row:last-child{border-bottom:0}.arrow{color:#9aa6a1;font-size:34rpx}.danger{color:#9b4b45}.empty-goal{text-align:center}.empty-goal .primary-button{margin-right:auto;margin-left:auto}
