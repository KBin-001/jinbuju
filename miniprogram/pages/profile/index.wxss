.profile-page {
  min-height: 100vh;
  padding-top: 72rpx;
  padding-bottom: calc(156rpx + env(safe-area-inset-bottom));
  background: #f5f7f2;
  color: #233b34;
}

.user-card,
.goal-panel,
.function-grid {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid rgba(230, 238, 233, 0.92);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(31, 70, 58, 0.08);
}

.user-card {
  position: relative;
  min-height: 154rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx 28rpx;
}

.avatar-wrap {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  overflow: visible;
  border-radius: 50%;
  background: #f8d26a;
  color: #1f5b4a;
  font-size: 42rpx;
  font-weight: 800;
}

.avatar-image {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 50%;
}

.avatar-badge {
  position: absolute;
  right: -2rpx;
  bottom: 2rpx;
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #f8d26a;
  color: #356859;
  font-size: 14rpx;
}

.avatar-hitarea {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  left: -8rpx;
  width: auto;
  height: auto;
  border-radius: 50%;
  opacity: 0;
}

.user-main {
  min-width: 0;
  flex: 1;
}

.name-row,
.level-row,
.panel-head,
.goal-item-head,
.goal-meta-row {
  display: flex;
  align-items: center;
}

.name-row {
  gap: 8rpx;
}

.profile-name {
  max-width: 260rpx;
  overflow: hidden;
  color: #233b34;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.name-caret {
  color: #71827a;
  font-size: 26rpx;
}

.level-row {
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.level-pill {
  height: 36rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 14rpx;
  border-radius: 18rpx;
  background: #fff5d8;
  color: #8a6b21;
  font-size: 21rpx;
  font-weight: 700;
}

.joined-days {
  color: #71827a;
  font-size: 23rpx;
}

.edit-profile-btn {
  width: 128rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border: 1rpx solid #b8d0c6;
  border-radius: 27rpx;
  background: #ffffff;
  color: #356859;
  font-size: 23rpx;
  font-weight: 700;
}

.goal-panel {
  margin-top: 24rpx;
  padding: 28rpx;
}

.panel-head {
  justify-content: space-between;
  gap: 20rpx;
}

.panel-title {
  color: #233b34;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.panel-status {
  color: #356859;
  font-size: 24rpx;
  font-weight: 700;
}

.goal-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.goal-item {
  width: 100%;
  padding: 24rpx 24rpx 22rpx;
  border: 1rpx solid rgba(230, 238, 233, 0.9);
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(31, 70, 58, 0.06);
}

.goal-item-head {
  justify-content: space-between;
  gap: 16rpx;
}

.goal-title {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #233b34;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.current-chip {
  height: 34rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 14rpx;
  border-radius: 17rpx;
  background: #eaf5ef;
  color: #356859;
  font-size: 20rpx;
  font-weight: 700;
}

.goal-meta-row {
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 12rpx;
  color: #71827a;
  font-size: 23rpx;
}

.goal-percent {
  color: #233b34;
  font-weight: 800;
}

.progress-track {
  height: 12rpx;
  overflow: hidden;
  margin-top: 16rpx;
  border-radius: 6rpx;
  background: #e8efea;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: #67b98d;
}

.add-goal-btn {
  width: 100%;
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  border-radius: 37rpx;
  background: transparent;
  color: #356859;
  font-size: 25rpx;
  font-weight: 650;
}

.empty-goal {
  margin-top: 24rpx;
  padding: 36rpx 24rpx;
  border-radius: 22rpx;
  background: #f8faf8;
  text-align: center;
}

.empty-title {
  color: #233b34;
  font-size: 28rpx;
  font-weight: 750;
}

.empty-desc {
  margin-top: 8rpx;
  color: #71827a;
  font-size: 24rpx;
}

.function-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0;
  margin-top: 24rpx;
  padding: 28rpx 16rpx 24rpx;
}

.function-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.function-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #b8d0c6;
  border-radius: 50%;
  color: #356859;
  font-size: 26rpx;
  line-height: 1;
}

.function-title {
  color: #233b34;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 30rpx;
}

.profile-editor-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 36;
  display: flex;
  align-items: flex-end;
}

.profile-editor-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(31, 45, 42, 0.42);
}

.profile-editor-panel {
  position: relative;
  width: 100%;
  max-height: calc(100vh - 140rpx);
  overflow-y: auto;
  padding: 22rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: #f5f7f2;
}

.popup-handle {
  width: 78rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: #cbd8d2;
}

.editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.editor-kicker {
  color: #356859;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.editor-title {
  margin-top: 6rpx;
  color: #233b34;
  font-size: 38rpx;
  font-weight: 750;
}

.panel-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
  color: #71827a;
  font-size: 32rpx;
}

.profile-form-card {
  padding: 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(31, 70, 58, 0.08);
}

.profile-avatar-row,
.profile-setting-row,
.profile-editor-actions {
  display: flex;
  align-items: center;
}

.profile-avatar-row {
  gap: 22rpx;
}

.profile-avatar-preview {
  overflow: hidden;
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  background: #f8d26a;
  color: #1f5b4a;
  font-size: 42rpx;
  font-weight: 750;
}

.profile-avatar-preview image {
  width: 100%;
  height: 100%;
}

.avatar-choose-btn {
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border-radius: 32rpx;
  background: #eaf5ef;
  color: #356859;
  font-size: 24rpx;
  font-weight: 700;
}

.profile-field {
  margin-top: 28rpx;
}

.profile-label {
  color: #233b34;
  font-size: 26rpx;
  font-weight: 700;
}

.profile-input {
  width: 100%;
  height: 86rpx;
  margin-top: 14rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e6eee9;
  border-radius: 22rpx;
  background: #fbfdfb;
  color: #233b34;
  font-size: 28rpx;
}

.profile-setting-row {
  justify-content: space-between;
  gap: 22rpx;
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f8faf8;
}

.profile-helper {
  margin-top: 8rpx;
  color: #71827a;
  font-size: 23rpx;
  line-height: 1.4;
}

.profile-editor-actions {
  gap: 18rpx;
  margin-top: 22rpx;
}

.profile-cancel-btn,
.profile-save-btn {
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  border-radius: 41rpx;
  font-size: 27rpx;
  font-weight: 750;
}

.profile-cancel-btn {
  border: 1rpx solid #d7e4de;
  background: #ffffff;
  color: #356859;
}

.profile-save-btn {
  background: #356859;
  color: #ffffff;
}

.edit-profile-btn::after,
.add-goal-btn::after,
.avatar-hitarea::after,
.avatar-choose-btn::after,
.profile-cancel-btn::after,
.profile-save-btn::after {
  border: 0;
}
