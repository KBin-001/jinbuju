/* =============================================
   进步局 · 我的页面 — 浅绿成长风
   配色：主色 #3F8F72 / 深绿 #24584A / 浅绿 #E6F4EC
         背景 #F6FAF7 / 卡片 #FFFFFF / 文字 #244C43
         金色点缀 #F4C95D
   ============================================= */

/* ---- 页面容器 ---- */
.profile-page {
  --profile-primary: #3F8F72;
  --profile-deep: #24584A;
  --profile-primary-soft: #E6F4EC;
  --profile-primary-light: #7CC6A0;
  --profile-accent: #7CC6A0;
  --profile-growth: #7CC6A0;
  --profile-gold: #F4C95D;
  --profile-gold-soft: #FFF4D8;
  --profile-text: #244C43;
  --profile-secondary: #6F827B;
  --profile-muted: #9AA8A3;
  --profile-border: #E2EEE8;
  --profile-soft: #EFF8F3;
  --profile-bg: #F6FAF7;
  --profile-shadow: 0 8rpx 28rpx rgba(36, 88, 74, 0.08);
  /* 主题皮肤可覆盖的渐变（默认薄荷绿） */
  --profile-hero-gradient: linear-gradient(135deg, #E6F4EC 0%, #F7FBF8 60%, #FFFFFF 100%);
  --profile-progress-gradient: linear-gradient(90deg, #7CC6A0 0%, #3F8F72 100%);
  min-height: 100vh;
  background: var(--profile-bg);
  color: var(--profile-text);
  /* 顶部安全区交给 navigationBar 处理，此处不额外留白 */
}

/* =============================================
   Hero 卡 — 卡片式 Header
   - 高度固定 200rpx（区间 180-220rpx）
   - 左右各 24rpx 边距
   - 四角 32rpx 圆角
   - 背景装饰弱化
   ============================================= */
.hero-card {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 24rpx;
  height: 200rpx;
  margin: 24rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: var(--profile-hero-gradient);
  border-radius: 32rpx;
  box-shadow: 0 10rpx 28rpx rgba(36, 88, 74, 0.08);
  color: var(--profile-text);
}

/* 背景装饰圆（弱化处理：缩小 + 降低不透明度） */
.hero-deco-circle {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.hero-deco-circle--1 {
  top: -30rpx;
  right: -30rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(124, 198, 160, 0.14);
}
.hero-deco-circle--2 {
  bottom: -50rpx;
  left: -25rpx;
  width: 130rpx;
  height: 130rpx;
  background: rgba(244, 201, 93, 0.10);
}

/* 叶子装饰文字（弱化） */
.hero-deco-leaf {
  position: absolute;
  top: 8rpx;
  right: 16rpx;
  color: rgba(63, 143, 114, 0.06);
  font-size: 80rpx;
  line-height: 1;
  pointer-events: none;
  transform: rotate(20deg);
}

/* 头像（紧凑化） */
.hero-avatar-wrap {
  position: relative;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--profile-gold-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(36, 88, 74, 0.10);
  overflow: hidden;
}
.hero-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}
.hero-avatar-text {
  color: var(--profile-primary);
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1;
}

/* 微信头像热区 */
.avatar-hitarea {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  opacity: 0;
  padding: 0;
  margin: 0;
  background: transparent;
}
.avatar-hitarea::after { border: 0; }

/* 用户信息 */
.hero-user-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  justify-content: center;
}

.hero-name {
  color: var(--profile-text);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.2;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.hero-level-pill {
  display: inline-flex;
  align-items: center;
  height: 32rpx;
  padding: 0 12rpx;
  border-radius: 16rpx;
  background: var(--profile-gold-soft);
  border: 1rpx solid rgba(244, 201, 93, 0.48);
  color: #8A6B1F;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  flex-shrink: 0;
}

.hero-meta-dot {
  color: var(--profile-muted);
  font-size: 20rpx;
  line-height: 1;
}

.hero-joined {
  color: var(--profile-secondary);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
}

/* 编辑按钮（圆形图标按钮） */
.hero-edit-btn {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(63, 143, 114, 0.32);
  background: rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--profile-primary);
  font-size: 24rpx;
  line-height: 1;
  transition: opacity 0.15s, transform 0.15s;
}
.hero-edit-btn::after { border: 0; }
.hero-edit-btn--pressed { opacity: 0.78; transform: scale(0.94); }
.hero-edit-icon { font-size: 24rpx; line-height: 1; }

/* =============================================
   页面主内容区
   ============================================= */
.page-content {
  padding: 28rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ---- 通用卡片 ---- */
.section-card {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: var(--profile-shadow);
  padding: 28rpx;
}

/* 卡片头 */
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.card-title {
  color: var(--profile-text);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
}
.card-link {
  color: var(--profile-primary);
  font-size: 26rpx;
  font-weight: 600;
}

/* =============================================
   成长概览卡
   ============================================= */
.overview-card {}

.overview-stats {
  display: flex;
  align-items: stretch;
}

.stat-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-divider {
  width: 1rpx;
  background: var(--profile-border);
  margin: 4rpx 0;
}

.stat-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}
.stat-icon-wrap--green { background: var(--profile-primary-soft); }
.stat-icon-wrap--teal  { background: var(--profile-soft); }
.stat-icon-wrap--gold  { background: var(--profile-gold-soft); }

.stat-icon {
  font-size: 32rpx;
  line-height: 1;
}

.stat-num {
  color: var(--profile-text);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
}
.stat-unit {
  color: var(--profile-secondary);
  font-size: 22rpx;
  font-weight: 500;
  margin-top: -4rpx;
}
.stat-label {
  color: var(--profile-secondary);
  font-size: 22rpx;
  margin-top: 2rpx;
}

/* =============================================
   我的目标卡
   ============================================= */
.goal-card {}

.goal-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 40rpx 0;
}
.goal-empty-icon { font-size: 60rpx; }
.goal-empty-title {
  color: var(--profile-text);
  font-size: 28rpx;
  font-weight: 700;
}
.goal-empty-desc {
  color: var(--profile-secondary);
  font-size: 24rpx;
}

.goal-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.goal-item {
  padding: 22rpx 20rpx;
  border: 1rpx solid var(--profile-border);
  border-radius: 20rpx;
  background: #FBFCFA;
  transition: opacity 0.15s, transform 0.15s;
}
.goal-item--pressed {
  opacity: 0.82;
  transform: scale(0.985);
}

.goal-item-main {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.goal-item-icon-wrap {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--profile-primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}
.goal-item-icon { font-size: 34rpx; }

.goal-item-body {
  flex: 1;
  min-width: 0;
}

.goal-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.goal-item-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--profile-text);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}
.goal-status-chip {
  flex-shrink: 0;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 18rpx;
  background: var(--profile-primary-soft);
  color: var(--profile-primary);
  font-size: 22rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
}

.goal-item-sub {
  display: block;
  margin-top: 8rpx;
  color: var(--profile-secondary);
  font-size: 24rpx;
}

.goal-progress-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}
.goal-progress-track {
  flex: 1;
  height: 16rpx;
  border-radius: 8rpx;
  background: #E2EEE8;
  overflow: hidden;
}
.goal-progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: var(--profile-progress-gradient);
  transition: width 0.4s ease;
}
.goal-progress-pct {
  flex-shrink: 0;
  color: var(--profile-primary);
  font-size: 26rpx;
  font-weight: 800;
}

.goal-action-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.goal-focus-action,
.goal-end-action {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 21rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.goal-focus-action {
  background: var(--profile-primary-soft);
  color: var(--profile-primary);
}

.goal-end-action {
  border: 1rpx solid #EADBD7;
  background: #FBF1ED;
  color: #9A675F;
}

.goal-end-action.is-disabled {
  opacity: 0.58;
}

/* 添加目标按钮 */
.add-goal-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 76rpx;
  margin-top: 20rpx;
  border-radius: 38rpx;
  border: 1.5rpx dashed #B8D4C8;
  background: var(--profile-bg);
  transition: opacity 0.15s, transform 0.15s;
}
.add-goal-btn--pressed { opacity: 0.75; transform: scale(0.98); }
.add-goal-plus {
  color: var(--profile-primary);
  font-size: 32rpx;
  font-weight: 400;
  line-height: 1;
}
.add-goal-text {
  color: var(--profile-primary);
  font-size: 26rpx;
  font-weight: 600;
}

/* =============================================
   功能入口卡
   ============================================= */
.func-card {
  padding: 24rpx 16rpx 20rpx;
  display: flex;
  align-items: stretch;
  gap: 0;
}

.func-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 8rpx;
  transition: opacity 0.15s, transform 0.15s;
  position: relative;
}
/* 竖线分隔（除最后一个） */
.func-item:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 20%;
  right: 0;
  width: 1rpx;
  height: 60%;
  background: var(--profile-border);
}
.func-item--pressed {
  opacity: 0.75;
  transform: scale(0.94);
}

.func-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.func-icon-wrap--history { background: var(--profile-primary-soft); }
.func-icon-wrap--badges  { background: var(--profile-gold-soft); }
.func-icon-wrap--focus   { background: #E8F1FB; }
.func-icon-wrap--ai      { background: var(--profile-primary-soft); color: var(--profile-primary); }
.func-icon-wrap--theme   { background: var(--profile-primary-soft); color: var(--profile-primary); }
.func-icon-wrap--settings { background: #F1F4F2; }

.func-icon-emoji { font-size: 38rpx; line-height: 1; }

.func-label {
  color: var(--profile-text);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}

/* =============================================
   本周小结卡
   ============================================= */
.week-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 24rpx 24rpx 24rpx;
  background: linear-gradient(110deg, #FFF8E0 0%, #FFF4D8 100%);
  border: 1rpx solid rgba(244, 201, 93, 0.28);
  box-shadow: 0 6rpx 22rpx rgba(244, 201, 93, 0.10);
}

.week-badge-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.week-badge {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F4C95D 0%, #E0B04A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(244, 201, 93, 0.28);
}
.week-badge-icon { font-size: 40rpx; line-height: 1; }

.week-text {
  flex: 1;
  min-width: 0;
}
.week-title {
  display: block;
  color: var(--profile-text);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}
.week-desc {
  display: block;
  margin-top: 6rpx;
  color: var(--profile-secondary);
  font-size: 24rpx;
  line-height: 1.4;
}

/* 金色进度条 */
.week-progress-track {
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(244, 201, 93, 0.2);
  overflow: hidden;
  margin-top: 14rpx;
}
.week-progress-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #F4C95D 0%, #F8D779 100%);
  transition: width 0.5s ease;
}

/* 查看详情按钮 */
.week-detail-btn {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  background: var(--profile-primary);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.15s, transform 0.15s;
}
.week-detail-btn--pressed { opacity: 0.82; transform: scale(0.96); }

/* =============================================
   编辑资料弹层（样式保留并小幅升级）
   ============================================= */
.profile-editor-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 36;
  display: flex;
  align-items: flex-end;
}

.profile-editor-mask {
  position: absolute;
  inset: 0;
  background: rgba(36, 76, 67, 0.32);
}

.profile-editor-panel {
  position: relative;
  width: 100%;
  max-height: calc(100vh - 120rpx);
  overflow-y: auto;
  padding: 22rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: var(--profile-bg);
}

.popup-handle {
  width: 80rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: #E2EEE8;
}

.editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}
.editor-kicker {
  color: var(--profile-primary);
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}
.editor-title {
  margin-top: 6rpx;
  color: var(--profile-text);
  font-size: 38rpx;
  font-weight: 750;
}
.panel-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
  color: var(--profile-secondary);
  font-size: 32rpx;
  box-shadow: 0 4rpx 14rpx rgba(36, 88, 74, 0.08);
}

.profile-form-card {
  padding: 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: var(--profile-shadow);
}

.profile-avatar-row,
.profile-setting-row,
.profile-editor-actions {
  display: flex;
  align-items: center;
}
.profile-avatar-row { gap: 22rpx; }

.profile-avatar-preview {
  overflow: hidden;
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  background: var(--profile-gold-soft);
  color: var(--profile-primary);
  font-size: 42rpx;
  font-weight: 750;
}
.profile-avatar-preview image { width: 100%; height: 100%; }

.avatar-choose-btn {
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border-radius: 32rpx;
  background: var(--profile-primary-soft);
  color: var(--profile-primary);
  font-size: 24rpx;
  font-weight: 700;
}
.avatar-choose-btn::after { border: 0; }

.profile-field { margin-top: 28rpx; }
.profile-label {
  color: var(--profile-text);
  font-size: 26rpx;
  font-weight: 700;
}
.profile-input {
  width: 100%;
  height: 88rpx;
  margin-top: 14rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--profile-border);
  border-radius: 22rpx;
  background: #F8FBF9;
  color: var(--profile-text);
  font-size: 28rpx;
  box-sizing: border-box;
}

.profile-setting-row {
  justify-content: space-between;
  gap: 22rpx;
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: var(--profile-bg);
}
.profile-helper {
  margin-top: 8rpx;
  color: var(--profile-secondary);
  font-size: 23rpx;
  line-height: 1.4;
}

.profile-editor-actions {
  gap: 18rpx;
  margin-top: 22rpx;
}
.profile-cancel-btn,
.profile-save-btn {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  border-radius: 42rpx;
  font-size: 27rpx;
  font-weight: 750;
}
.profile-cancel-btn {
  border: 1rpx solid #E2EEE8;
  background: #ffffff;
  color: var(--profile-primary);
}
.profile-save-btn {
  background: var(--profile-primary);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(63, 143, 114, 0.22);
}
.profile-cancel-btn::after,
.profile-save-btn::after { border: 0; }

/* =============================================
   主题换肤弹窗（居中圆角浮层 + 紧凑 2 列网格）
   弹窗自身使用固定中性色，不随预览主题晃动；
   仅主题卡片内的色块 / 预览区跟随各自主题色。
   ============================================= */
.theme-modal {
  --theme-accent: #356859;
  --theme-accent-soft: #EAF5EF;
  --theme-border: #EEF2EF;
  --theme-text: #233B34;
  --theme-secondary: #8A9690;
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
}

.theme-modal__mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.28);
  /* 轻微模糊，突出弹窗主体 */
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
}

.theme-panel {
  position: relative;
  width: 92%;
  max-width: 680rpx;
  height: 74vh;
  display: flex;
  flex-direction: column;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 24rpx 60rpx rgba(20, 60, 45, 0.18);
  overflow: hidden;
}

/* ---- 顶部标题区 ---- */
.theme-panel__header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 22rpx;
  border-bottom: 1rpx solid var(--theme-border);
}

.theme-panel__title-wrap {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.theme-panel__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: var(--theme-accent-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}
.theme-panel__icon-emoji {
  font-size: 32rpx;
  line-height: 1;
}

.theme-panel__title-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.theme-panel__title {
  color: var(--theme-text);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}
.theme-panel__subtitle {
  color: var(--theme-secondary);
  font-size: 22rpx;
  line-height: 1.2;
}

.theme-panel__close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F4F7F5;
  display: flex;
  align-items: center;
  justify-content: center;
}
.theme-panel__close-icon {
  color: var(--theme-secondary);
  font-size: 32rpx;
  line-height: 1;
}

/* ---- 筛选标签 ---- */
.theme-filter {
  flex-shrink: 0;
  display: flex;
  gap: 14rpx;
  padding: 20rpx 32rpx 10rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.theme-filter__chip {
  flex-shrink: 0;
  height: 54rpx;
  padding: 0 24rpx;
  border-radius: 27rpx;
  border: 1rpx solid #E6EEE9;
  background: #FFFFFF;
  color: #6F827B;
  font-size: 24rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  transition: background 0.2s, border-color 0.2s, color 0.2s;
}
.theme-filter__chip.is-active {
  background: var(--theme-accent-soft);
  border-color: var(--theme-accent);
  color: var(--theme-accent);
}
.theme-filter__chip--pressed {
  opacity: 0.7;
}

/* ---- 主题网格（可滚动） ---- */
.theme-grid {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}

.theme-grid__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  padding: 14rpx 28rpx 24rpx;
}

.theme-grid__empty {
  grid-column: 1 / -1;
  padding: 60rpx 0;
  text-align: center;
  color: var(--theme-secondary);
  font-size: 24rpx;
}

/* ---- 主题卡片 ---- */
.theme-card {
  position: relative;
  height: 212rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  border: 2rpx solid var(--theme-border);
  box-shadow: 0 8rpx 24rpx rgba(20, 60, 45, 0.06);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  box-sizing: border-box;
  transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s, opacity 0.15s;
}
.theme-card--pressed {
  opacity: 0.92;
  transform: scale(0.97);
}
.theme-card--active {
  border-color: var(--theme-accent);
  box-shadow: 0 10rpx 28rpx rgba(20, 60, 45, 0.14);
}

/* 当前使用 / 预览中 角标 */
.theme-card__badge {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  z-index: 1;
  height: 32rpx;
  padding: 0 14rpx;
  border-radius: 16rpx;
  background: var(--theme-accent);
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  letter-spacing: 0.5rpx;
}
.theme-card__badge--preview {
  background: #FFFFFF;
  color: var(--theme-accent);
  border: 1rpx solid var(--theme-accent);
}

/* 卡片头部：色点 + 名称 + 描述 */
.theme-card__head {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding-right: 84rpx; /* 给角标留位 */
}
.theme-card__name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.theme-card__dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
}
.theme-card__name {
  color: var(--theme-text);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.theme-card__desc {
  color: var(--theme-secondary);
  font-size: 20rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 色块 */
.theme-swatches {
  display: flex;
  gap: 8rpx;
}
.theme-swatches__item {
  flex: 1;
  height: 18rpx;
  border-radius: 6rpx;
}

/* 迷你预览区：小进度条 + 小按钮 */
.theme-preview {
  margin-top: auto;
  border-radius: 14rpx;
  padding: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.theme-preview__bar {
  flex: 1;
  height: 10rpx;
  border-radius: 5rpx;
  background: rgba(0, 0, 0, 0.06);
  overflow: hidden;
}
.theme-preview__bar-fill {
  height: 100%;
  border-radius: 5rpx;
}
.theme-preview__btn {
  flex-shrink: 0;
  height: 36rpx;
  padding: 0 16rpx;
  border-radius: 18rpx;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* ---- 底部操作区（固定在弹窗底部） ---- */
.theme-action-bar {
  flex-shrink: 0;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--theme-border);
  background: #FFFFFF;
}
.theme-action-bar__btn {
  flex: 1;
  height: 76rpx;
  border-radius: 38rpx;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: opacity 0.15s, transform 0.15s;
}
.theme-action-bar__btn--ghost {
  border: 1rpx solid #E6EEE9;
  background: #FFFFFF;
  color: #6F827B;
}
.theme-action-bar__btn--primary {
  border: 1rpx solid var(--theme-accent);
  background: var(--theme-accent-soft);
  color: var(--theme-accent);
}
.theme-action-bar__btn--pressed {
  opacity: 0.78;
  transform: scale(0.97);
}
.theme-action-bar__icon {
  font-size: 26rpx;
  line-height: 1;
}
.theme-action-bar__text {
  line-height: 1;
}

/* =========================================================
 * 墨绿成长主题 覆写（profile-page）
 * 覆写本页硬编码的薄荷绿色：装饰圆、叶子文字、按钮、阴影、遮罩等。
 * 切换至墨绿主题后，整页 UI 统一呈现深绿质感。
 * ========================================================= */
.profile-page[data-theme="inkGreen"] {
  --profile-primary: #1F6F55;
  --profile-deep: #0F3F32;
  --profile-primary-soft: #E3F2EA;
  --profile-primary-light: #6DBB95;
  --profile-accent: #42A67A;
  --profile-growth: #6DBB95;
  --profile-gold: #F4C95D;
  --profile-gold-soft: #FFF2CD;
  --profile-text: #183F35;
  --profile-secondary: #6D8179;
  --profile-muted: #9AA9A4;
  --profile-border: #DDEBE4;
  --profile-soft: #EEF6F1;
  --profile-bg: #F4F8F5;
  --profile-shadow: 0 10rpx 28rpx rgba(20, 82, 63, 0.10);
  --profile-hero-gradient: linear-gradient(135deg, #E3F2EA 0%, #F4F8F5 60%, #FFFFFF 100%);
  --profile-progress-gradient: linear-gradient(90deg, #6DBB95 0%, #1F6F55 100%);
  background: #F4F8F5;
  color: #183F35;
}

.profile-page[data-theme="inkGreen"] .hero-card {
  box-shadow: 0 8rpx 24rpx rgba(20, 82, 63, 0.10);
}

.profile-page[data-theme="inkGreen"] .hero-deco-circle--1 {
  background: rgba(109, 187, 149, 0.22);
}

.profile-page[data-theme="inkGreen"] .hero-deco-circle--2 {
  background: rgba(244, 201, 93, 0.12);
}

.profile-page[data-theme="inkGreen"] .hero-deco-leaf {
  color: rgba(31, 111, 85, 0.10);
}

.profile-page[data-theme="inkGreen"] .hero-avatar-wrap {
  border: 4rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 4rpx 16rpx rgba(244, 201, 93, 0.28);
}

.profile-page[data-theme="inkGreen"] .stat-grid,
.profile-page[data-theme="inkGreen"] .goal-card,
.profile-page[data-theme="inkGreen"] .menu-card,
.profile-page[data-theme="inkGreen"] .danger-card,
.profile-page[data-theme="inkGreen"] .stat-tile,
.profile-page[data-theme="inkGreen"] .menu-item,
.profile-page[data-theme="inkGreen"] .danger-button,
.profile-page[data-theme="inkGreen"] .option-card {
  background: #FFFFFF;
  border-color: #DDEBE4;
}

.profile-page[data-theme="inkGreen"] .stat-divider,
.profile-page[data-theme="inkGreen"] .menu-divider,
.profile-page[data-theme="inkGreen"] .profile-divider {
  border-top-color: rgba(20, 82, 63, 0.14);
}

.profile-page[data-theme="inkGreen"] .progress-track,
.profile-page[data-theme="inkGreen"] .progress-bar,
.profile-page[data-theme="inkGreen"] .empty-progress {
  background: #DDEBE4;
}

.profile-page[data-theme="inkGreen"] .progress-fill,
.profile-page[data-theme="inkGreen"] .progress-bar-inner,
.profile-page[data-theme="inkGreen"] .goal-progress-fill {
  background: linear-gradient(90deg, #6DBB95 0%, #1F6F55 100%);
}

.profile-page[data-theme="inkGreen"] .primary-button,
.profile-page[data-theme="inkGreen"] .action-button,
.profile-page[data-theme="inkGreen"] .save-button,
.profile-page[data-theme="inkGreen"] .confirm-button,
.profile-page[data-theme="inkGreen"] .theme-confirm,
.profile-page[data-theme="inkGreen"] .profile-button {
  background: #1F6F55;
  box-shadow: 0 4rpx 16rpx rgba(31, 111, 85, 0.26);
  color: #FFFFFF;
}

.profile-page[data-theme="inkGreen"] .secondary-button,
.profile-page[data-theme="inkGreen"] .ghost-button {
  background: #FFFFFF;
  border-color: #DDEBE4;
  color: #1F6F55;
}

.profile-page[data-theme="inkGreen"] .gold-card,
.profile-page[data-theme="inkGreen"] .badge-card,
.profile-page[data-theme="inkGreen"] .achievement-card {
  background: linear-gradient(110deg, #FFF8E0 0%, #FFF4D8 100%);
  border: 1rpx solid rgba(244, 201, 93, 0.30);
  box-shadow: 0 6rpx 22rpx rgba(244, 201, 93, 0.12);
}

.profile-page[data-theme="inkGreen"] .gold-icon,
.profile-page[data-theme="inkGreen"] .badge-icon,
.profile-page[data-theme="inkGreen"] .achievement-icon {
  background: linear-gradient(135deg, #F4C95D 0%, #E0B04A 100%);
  box-shadow: 0 4rpx 14rpx rgba(244, 201, 93, 0.30);
  color: #183F35;
}

.profile-page[data-theme="inkGreen"] .gold-bar,
.profile-page[data-theme="inkGreen"] .level-bar {
  background: linear-gradient(90deg, #F4C95D 0%, #F8D779 100%);
}

.profile-page[data-theme="inkGreen"] .func-icon-wrap--focus   { background: #E3F2EA; }
.profile-page[data-theme="inkGreen"] .func-icon-wrap--settings { background: #EEF6F1; }
.profile-page[data-theme="inkGreen"] .func-icon-wrap--goal     { background: #E3F2EA; }
.profile-page[data-theme="inkGreen"] .func-icon-wrap--help     { background: #E3F2EA; }

.profile-page[data-theme="inkGreen"] .danger-card {
  background: #FBF1ED;
  border-color: #EADBD7;
  color: #9A675F;
}

.profile-page[data-theme="inkGreen"] .danger-button {
  background: #FBF1ED;
  border-color: #EADBD7;
  color: #9A675F;
}

.profile-page[data-theme="inkGreen"] .layer-mask,
.profile-page[data-theme="inkGreen"] .popup-mask,
.profile-page[data-theme="inkGreen"] .theme-mask {
  background: rgba(15, 63, 50, 0.36);
}

.profile-page[data-theme="inkGreen"] .theme-grid-card {
  background: #FFFFFF;
  border: 2rpx solid #EDF3EF;
  box-shadow: 0 6rpx 20rpx rgba(20, 82, 63, 0.06);
}

.profile-page[data-theme="inkGreen"] .theme-grid-card.is-active {
  border: 2rpx solid #1F6F55;
  box-shadow: 0 8rpx 24rpx rgba(20, 82, 63, 0.18);
}

.profile-page[data-theme="inkGreen"] .quick-task-popup,
.profile-page[data-theme="inkGreen"] .feedback-popup,
.profile-page[data-theme="inkGreen"] .management-popup,
.profile-page[data-theme="inkGreen"] .theme-popup {
  --popup-background: #F4F8F5;
}

/* 参考墨绿稿：个人 Hero 使用深绿底，其余内容保持白卡与灰绿背景。 */
.profile-page[data-theme="inkGreen"] {
  --profile-primary: #356859;
  --profile-deep: #1F5B4A;
  --profile-primary-soft: #EAF5EF;
  --profile-primary-light: #7FAA91;
  --profile-accent: #356859;
  --profile-growth: #356859;
  --profile-text: #233B34;
  --profile-secondary: #71827A;
  --profile-border: #E6EEE9;
  --profile-soft: #F0F5F1;
  --profile-bg: #F5F7F2;
  background: #F5F7F2;
}

.profile-page[data-theme="inkGreen"] .hero-card {
  background: linear-gradient(135deg, #1F5B4A 0%, #356859 62%, #4C806E 100%);
  color: #FFFFFF;
}

.profile-page[data-theme="inkGreen"] .hero-name,
.profile-page[data-theme="inkGreen"] .hero-joined,
.profile-page[data-theme="inkGreen"] .hero-motto {
  color: #FFFFFF;
}

.profile-page[data-theme="inkGreen"] .hero-edit-btn {
  border-color: rgba(255, 255, 255, 0.38);
  background: rgba(255, 255, 255, 0.14);
  color: #FFFFFF;
}

.profile-page[data-theme="inkGreen"] .section-card {
  border-color: rgba(31, 91, 74, 0.10);
  background: #FFFFFF;
}
