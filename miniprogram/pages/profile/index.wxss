.profile-page {
  --profile-primary: #356859;
  --profile-deep: #1f4d42;
  --profile-text: #1f2d2a;
  --profile-secondary: #66736f;
  --profile-muted: #9aa6a1;
  --profile-border: #e6ece8;
  --profile-card-radius: 28rpx;
  --profile-shadow: 0 10rpx 30rpx rgba(31, 77, 66, 0.07);
  padding-top: 28rpx;
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.profile-banner,
.profile-card,
.menu-section {
  margin-right: 0;
  margin-left: 0;
}

.profile-banner {
  position: relative;
  overflow: hidden;
  min-height: 300rpx;
  box-sizing: border-box;
  padding: 54rpx 40rpx 34rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #123d35 0%, #1f4d42 56%, #356859 100%);
  color: #ffffff;
  box-shadow: var(--profile-shadow);
}

.avatar {
  position: relative;
  overflow: visible;
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border: 4rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 50%;
  background: #f3c76a;
  color: #1f4d42;
  font-size: 48rpx;
  font-weight: 750;
}

.avatar-image {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 50%;
}

.identity-copy {
  position: relative;
  min-width: 0;
  flex: 1;
}

.hero-kicker {
  position: relative;
  color: rgba(243, 199, 106, 0.92);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.hero-copy {
  position: absolute;
  right: 40rpx;
  bottom: 34rpx;
  left: 40rpx;
  color: rgba(255, 255, 255, 0.52);
  font-size: 26rpx;
  line-height: 1.35;
}

.identity-group {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: 62rpx;
  padding-bottom: 44rpx;
}

.profile-name {
  color: rgba(255, 255, 255, 0.92);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.15;
}

.avatar-camera {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #1f4d42;
  border-radius: 50%;
  background: #f3c76a;
  color: #1f4d42;
  font-size: 20rpx;
  font-weight: 800;
}

.avatar-hitarea {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  left: -8rpx;
  z-index: 4;
  width: auto;
  height: auto;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  opacity: 0;
}

.identity-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 14rpx;
}

.level-pill {
  display: inline-flex;
  align-items: center;
  margin-top: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(243, 199, 106, 0.18);
  color: #f3c76a;
  font-size: 24rpx;
  font-weight: 750;
}

.joined-days {
  margin-top: 0;
  color: rgba(255, 255, 255, 0.68);
  font-size: 26rpx;
  line-height: 1.35;
}

.profile-edit-btn {
  position: absolute;
  top: 36rpx;
  right: 28rpx;
  width: 112rpx;
  height: 50rpx;
  min-width: 0;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.14);
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 50rpx;
  white-space: nowrap;
  box-sizing: border-box;
  overflow: hidden;
}

.profile-card {
  box-sizing: border-box;
  margin-top: 22rpx;
  padding: 30rpx 32rpx;
  border: 1rpx solid rgba(230, 236, 232, 0.88);
  border-radius: var(--profile-card-radius);
  background: #ffffff;
  box-shadow: var(--profile-shadow);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.section-kicker {
  color: var(--profile-primary);
  font-size: 23rpx;
  font-weight: 700;
}

.goal-status {
  min-height: 46rpx;
  display: inline-flex;
  align-items: center;
  flex: none;
  box-sizing: border-box;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #eff7f2;
  color: var(--profile-primary);
  font-size: 22rpx;
  font-weight: 650;
}

.goal-title {
  margin-top: 12rpx;
  color: var(--profile-text);
  font-size: 36rpx;
  font-weight: 750;
  line-height: 1.32;
}

.goal-meta {
  margin-top: 8rpx;
  color: var(--profile-secondary);
  font-size: 24rpx;
  line-height: 1.4;
}

.goal-primary-action {
  width: 100%;
  min-height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 22rpx 0 0;
  padding: 0 28rpx;
  border-radius: 22rpx;
  background: var(--profile-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(53, 104, 89, 0.16);
}

.goal-secondary-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 0;
}

.goal-secondary-actions button {
  min-width: 0;
  flex: 1;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  padding: 0 26rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(53, 104, 89, 0.14);
  background: #fbfdfb;
  color: var(--profile-primary);
  font-size: 24rpx;
  font-weight: 650;
}

.goal-secondary-actions .danger {
  border-color: rgba(102, 115, 111, 0.16);
  background: #f7f8f6;
  color: #7f8b86;
}

.goal-progress-track {
  height: 12rpx;
  overflow: hidden;
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: #e6ece8;
}

.goal-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #8bbf72 0%, #356859 100%);
}

.goal-progress-copy {
  margin-top: 10rpx;
  color: var(--profile-secondary);
  font-size: 23rpx;
  line-height: 1.35;
}

.goal-primary-action::after,
.goal-secondary-actions button::after,
.menu-row::after,
.panel-close::after,
.profile-edit-btn::after,
.avatar-hitarea::after,
.avatar-choose-btn::after,
.profile-cancel-btn::after,
.profile-save-btn::after,
.back-button::after {
  border: 0;
}

.goal-primary-action:active,
.goal-secondary-actions button:active,
.menu-row:active,
.history-card:active,
.record-card:active {
  opacity: 0.78;
}

.empty-goal {
  text-align: left;
}

.card-title {
  color: var(--profile-text);
  font-size: 31rpx;
  font-weight: 750;
}

.growth-data-card {
  padding-bottom: 26rpx;
}

.growth-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
  margin-top: 24rpx;
}

.growth-stat {
  position: relative;
  min-width: 0;
  text-align: center;
}

.growth-stat + .growth-stat::before {
  position: absolute;
  top: 10rpx;
  bottom: 8rpx;
  left: 0;
  width: 1rpx;
  background: #e6ece8;
  content: "";
}

.growth-value {
  color: var(--profile-text);
  font-size: 34rpx;
  font-weight: 780;
  line-height: 1.15;
}

.growth-value text {
  margin-left: 3rpx;
  color: var(--profile-secondary);
  font-size: 21rpx;
  font-weight: 650;
}

.growth-label {
  margin-top: 8rpx;
  color: var(--profile-secondary);
  font-size: 22rpx;
  line-height: 1.25;
}

.growth-empty-tip {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #f8faf8;
  color: var(--profile-secondary);
  font-size: 23rpx;
  line-height: 1.45;
  text-align: center;
}

.menu-section {
  margin-top: 22rpx;
}

.menu-title {
  margin: 0 6rpx 12rpx;
  color: var(--profile-secondary);
  font-size: 24rpx;
  font-weight: 700;
}

.menu-card {
  overflow: hidden;
  border: 1rpx solid rgba(230, 236, 232, 0.88);
  border-radius: var(--profile-card-radius);
  background: #ffffff;
  box-shadow: var(--profile-shadow);
}

.menu-row {
  position: relative;
  width: 100%;
  height: 100rpx;
  display: block;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  background: #ffffff;
  color: var(--profile-text);
  font-size: 28rpx;
  font-weight: 650;
  text-align: left;
  line-height: normal;
}

.menu-row::after {
  position: absolute;
  right: 32rpx;
  bottom: 0;
  left: 32rpx;
  height: 1rpx;
  border: 0;
  background: #edf1ee;
  content: "";
}

.menu-row:last-child::after {
  display: none;
}

.menu-row-inner {
  width: 100%;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  box-sizing: border-box;
  padding: 0 32rpx;
}

.menu-row-inner text:first-child {
  min-width: 0;
  flex: 1;
  text-align: left;
}

.feedback-hitarea {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  opacity: 0;
  line-height: 1;
}

.feedback-hitarea::after {
  border: 0;
}

.arrow {
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  width: 36rpx;
  flex: none;
  color: var(--profile-muted);
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1;
  text-align: right;
}

.history-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
}

.history-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(31, 45, 42, 0.42);
}

.history-panel {
  position: relative;
  width: 100%;
  max-height: calc(100vh - 140rpx);
  overflow-y: auto;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: #f5f7f2;
  box-shadow: 0 -18rpx 52rpx rgba(21, 63, 54, 0.2);
}

.panel-header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding-right: 80rpx;
}

.panel-kicker {
  color: var(--profile-primary);
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.panel-title {
  margin-top: 6rpx;
  color: var(--profile-text);
  font-size: 38rpx;
  font-weight: 750;
}

.panel-close {
  position: absolute;
  top: 0;
  right: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #f3f7f4;
  color: #6b837a;
  font-size: 30rpx;
  line-height: 1;
}

.history-empty {
  padding: 58rpx 36rpx;
  border-radius: 28rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: var(--profile-shadow);
}

.history-empty-title {
  color: var(--profile-text);
  font-size: 32rpx;
  font-weight: 700;
}

.history-empty-desc {
  margin-top: 14rpx;
  color: var(--profile-secondary);
  font-size: 26rpx;
  line-height: 1.55;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.history-card {
  padding: 26rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: var(--profile-shadow);
}

.history-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.history-title {
  min-width: 0;
  color: var(--profile-text);
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.35;
}

.history-arrow {
  flex: none;
  color: var(--profile-muted);
  font-size: 36rpx;
}

.history-date,
.review-date {
  margin-top: 8rpx;
  color: var(--profile-secondary);
  font-size: 23rpx;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.history-tag {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #eff7f2;
  color: var(--profile-primary);
  font-size: 22rpx;
  font-weight: 650;
}

.history-stats,
.review-stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
}

.history-stats view,
.review-stats-grid view {
  min-height: 82rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  background: #f8faf8;
}

.history-stats text:first-child,
.review-stats-grid text:first-child {
  color: var(--profile-text);
  font-size: 30rpx;
  font-weight: 750;
}

.history-stats text:last-child,
.review-stats-grid text:last-child {
  margin-top: 4rpx;
  color: var(--profile-secondary);
  font-size: 21rpx;
}

.back-button {
  width: auto;
  margin: 0 0 18rpx;
  padding: 0;
  background: transparent;
  color: var(--profile-primary);
  font-size: 26rpx;
  font-weight: 650;
  text-align: left;
}

.review-card {
  position: relative;
  overflow: hidden;
  padding: 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #1f4d42 0%, #356859 100%);
  color: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(31, 77, 66, 0.16);
}

.review-status {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #fff8ec;
  font-size: 22rpx;
  font-weight: 650;
}

.review-title {
  margin-top: 18rpx;
  font-size: 38rpx;
  font-weight: 750;
  line-height: 1.3;
}

.review-rate {
  margin-top: 24rpx;
}

.review-rate-value {
  font-size: 48rpx;
  font-weight: 750;
}

.review-rate-label {
  color: rgba(255, 255, 255, 0.72);
  font-size: 23rpx;
}

.records-title {
  margin: 30rpx 4rpx 16rpx;
  color: var(--profile-text);
  font-size: 30rpx;
  font-weight: 700;
}

.record-empty {
  padding: 34rpx;
  border-radius: 24rpx;
  background: #ffffff;
  color: var(--profile-secondary);
  text-align: center;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(31, 77, 66, 0.06);
}

.record-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.record-title {
  min-width: 0;
  color: var(--profile-text);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.record-tag {
  flex: none;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 650;
}

.record-tag.done {
  background: #eff7f2;
  color: var(--profile-primary);
}

.record-tag.todo {
  background: #f4f1ea;
  color: #8a6b32;
}

.record-desc {
  margin-top: 10rpx;
  color: var(--profile-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.record-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 16rpx;
  margin-top: 16rpx;
  color: var(--profile-secondary);
  font-size: 22rpx;
}

.profile-editor-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 36;
  display: flex;
  align-items: flex-end;
}

.profile-editor-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(31, 45, 42, 0.42);
}

.profile-editor-panel {
  position: relative;
  width: 100%;
  max-height: calc(100vh - 140rpx);
  overflow-y: auto;
  box-sizing: border-box;
  padding: 22rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: #f5f7f2;
  box-shadow: 0 -18rpx 52rpx rgba(21, 63, 54, 0.2);
}

.popup-handle {
  width: 78rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: #cbd8d2;
}

.panel-header.compact {
  margin-bottom: 22rpx;
}

.profile-form-card {
  padding: 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: var(--profile-shadow);
}

.profile-avatar-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.profile-avatar-preview {
  overflow: hidden;
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 32rpx;
  background: #f3c76a;
  color: var(--profile-deep);
  font-size: 42rpx;
  font-weight: 750;
}

.profile-avatar-preview image {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-choose-btn {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #eff7f2;
  color: var(--profile-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.profile-field {
  margin-top: 28rpx;
}

.profile-label {
  color: var(--profile-text);
  font-size: 26rpx;
  font-weight: 700;
}

.profile-input {
  width: 100%;
  height: 86rpx;
  margin-top: 14rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--profile-border);
  border-radius: 22rpx;
  background: #fbfdfb;
  color: var(--profile-text);
  font-size: 28rpx;
}

.profile-setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f8faf8;
}

.profile-helper {
  margin-top: 8rpx;
  color: var(--profile-secondary);
  font-size: 23rpx;
  line-height: 1.4;
}

.profile-editor-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
}

.profile-cancel-btn,
.profile-save-btn {
  min-width: 0;
  min-height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  margin: 0;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 750;
}

.profile-cancel-btn {
  border: 1rpx solid rgba(53, 104, 89, 0.18);
  background: #ffffff;
  color: var(--profile-primary);
}

.profile-save-btn {
  background: var(--profile-primary);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(53, 104, 89, 0.16);
}
