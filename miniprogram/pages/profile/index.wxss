.profile-page {
  --profile-bg: #F8F6EC;
  --profile-paper: #FFFDF7;
  --profile-card: #FFFFFF;
  --profile-ink: #173F36;
  --profile-green: #2F6D5D;
  --profile-green-light: #4F8E72;
  --profile-muted: #6B7280;
  --profile-line: #DDEBE4;
  --profile-yellow: #FFF1C8;
  --profile-pink: #FCEAEA;
  --profile-red: #B83A3A;
  --profile-lavender: #F3EFF8;
  --profile-shadow: 0 18rpx 50rpx rgba(26, 61, 52, 0.10);
  --profile-shadow-soft: 0 10rpx 26rpx rgba(26, 61, 52, 0.09);

  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
  background: transparent;
  color: var(--profile-ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

page {
  background: #F6F4EC;
}

.profile-fixed-background {
  position: fixed;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
  background: linear-gradient(180deg, #FFF9ED 0%, #F8F6EE 48%, #F4F3EC 100%);
}

.profile-fixed-background__image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 500rpx;
  display: block;
}

.profile-fixed-background__wash {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.02) 0%, rgba(250, 248, 241, 0.10) 300rpx, rgba(248, 246, 238, 0.96) 520rpx, #F6F4EC 76%);
}

/* 顶部区域 */
.profile-hero {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 326rpx;
  overflow: hidden;
  background: transparent;
}

.profile-hero__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.profile-nav {
  position: relative;
  z-index: 2;
  height: 88rpx;
  padding-top: calc(env(safe-area-inset-top) + 8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: content-box;
  pointer-events: none;
}

.profile-nav__title {
  color: #111111;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1;
}

/* 用户信息卡 */
.profile-user-card {
  position: relative;
  z-index: 5;
  height: 168rpx;
  margin: -76rpx 32rpx 0;
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.58);
  box-shadow: 0 18rpx 48rpx rgba(39, 69, 59, 0.10), inset 0 1rpx 0 rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(30rpx) saturate(135%);
  -webkit-backdrop-filter: blur(30rpx) saturate(135%);
}

.profile-user-card::before,
.profile-card::before,
.goal-item::before,
.toolbox-item::before {
  content: "";
  position: absolute;
  top: 0;
  left: 8%;
  width: 84%;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.96), transparent);
  pointer-events: none;
}

.profile-avatar {
  position: relative;
  flex: none;
  width: 116rpx;
  height: 116rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 7rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  background: linear-gradient(145deg, #FFFDF7 0%, #FFF4D7 100%);
  box-sizing: border-box;
  box-shadow: 0 12rpx 28rpx rgba(28, 61, 53, 0.12);
}

.profile-avatar__image {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 50%;
}

.profile-avatar__text {
  color: var(--profile-green);
  font-size: 50rpx;
  font-weight: 800;
  line-height: 1;
}

.profile-avatar__picker {
  position: absolute;
  inset: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  opacity: 0;
}

.profile-avatar__picker::after { border: 0; }

.profile-user-info {
  flex: 1;
  min-width: 0;
}

.profile-user-name {
  display: block;
  overflow: hidden;
  color: var(--profile-ink);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.08;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-user-meta {
  min-width: 0;
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #7B7D82;
  font-size: 23rpx;
  white-space: nowrap;
}

.profile-level-badge {
  flex: none;
  height: 44rpx;
  padding: 0 16rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
  border: 1.5rpx solid #F8C857;
  border-radius: 22rpx;
  background: rgba(255, 252, 242, 0.92);
  box-shadow: 0 5rpx 12rpx rgba(120, 85, 30, 0.06);
}

.profile-level-badge__star { color: #FFC857; font-size: 22rpx; }
.profile-level-badge__text { color: #78551E; font-size: 22rpx; font-weight: 800; }
.profile-user-meta__dot { color: #A7A9A7; }
.profile-user-meta__days { overflow: hidden; text-overflow: ellipsis; }

.profile-edit {
  flex: none;
  width: 78rpx;
  height: 78rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.50);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.96), 0 8rpx 22rpx rgba(35, 70, 59, 0.08);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  transition: opacity 0.15s, transform 0.15s;
}

.profile-edit--pressed { opacity: 0.72; transform: scale(0.94); }
.profile-edit__icon { width: 100%; height: 100%; display: block; }

/* 内容卡片 */
.profile-content {
  position: relative;
  z-index: 2;
  margin-top: -6rpx;
  padding: 24rpx 32rpx calc(180rpx + env(safe-area-inset-bottom));
}

.profile-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 28rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.68);
  box-shadow: 0 14rpx 38rpx rgba(35, 63, 54, 0.075), inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(26rpx) saturate(125%);
  -webkit-backdrop-filter: blur(26rpx) saturate(125%);
}

.card-heading {
  padding: 30rpx 30rpx 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.card-heading__title {
  color: var(--profile-ink);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
}

.card-heading__link {
  flex: none;
  min-height: 52rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.42);
  color: var(--profile-green);
  font-size: 24rpx;
  line-height: 1;
}

/* 成长概览 */
.growth-card {
  height: 348rpx;
  overflow: hidden;
  padding-bottom: 24rpx;
  border-color: rgba(243, 213, 153, 0.30);
  background: linear-gradient(135deg, rgba(255, 253, 245, 0.78) 0%, rgba(255, 238, 197, 0.72) 100%);
}

.growth-visual {
  position: relative;
  height: 156rpx;
  margin: 0 30rpx;
}

.growth-wave {
  position: absolute;
  left: 70rpx;
  right: 70rpx;
  bottom: 0;
  width: calc(100% - 140rpx);
  height: 64rpx;
}

.growth-medal {
  position: absolute;
  top: 2rpx;
  width: 120rpx;
  height: 136rpx;
}

.growth-medal--calendar { left: 28rpx; }
.growth-medal--check { left: 50%; transform: translateX(-50%); }
.growth-medal--timer { right: 28rpx; }

.growth-metrics {
  margin-top: -8rpx;
  display: flex;
  text-align: center;
}

.growth-metric {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.growth-metric__value { display: flex; align-items: baseline; justify-content: center; }
.growth-metric__number { color: var(--profile-ink); font-size: 46rpx; font-weight: 800; line-height: 1; letter-spacing: -2rpx; }
.growth-metric__unit { margin-left: 4rpx; color: var(--profile-ink); font-size: 23rpx; font-weight: 500; }
.growth-metric__label { margin-top: 7rpx; color: var(--profile-ink); font-size: 22rpx; line-height: 1; }

/* 我的目标 */
.goal-card { padding-bottom: 28rpx; }

.goal-list {
  margin: 0 26rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.goal-item {
  position: relative;
  overflow: hidden;
  padding: 24rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--profile-line);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.46);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.90), 0 8rpx 22rpx rgba(47, 82, 69, 0.05);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  transition: opacity 0.15s, transform 0.15s;
}

.goal-item--pressed { opacity: 0.82; transform: scale(0.99); }
.goal-main { display: flex; align-items: center; gap: 18rpx; }

.goal-main__icon {
  flex: none;
  width: 96rpx;
  height: 96rpx;
}

.goal-main__info { flex: 1; min-width: 0; }

.goal-main__title {
  display: block;
  overflow: hidden;
  color: var(--profile-ink);
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goal-main__sub { display: block; margin-top: 7rpx; color: var(--profile-muted); font-size: 23rpx; }

.goal-status {
  flex: none;
  height: 44rpx;
  padding: 0 18rpx;
  display: inline-flex;
  align-items: center;
  border: 1rpx solid #D3E7DE;
  border-radius: 22rpx;
  background: #E5F2EC;
  color: var(--profile-green);
  font-size: 22rpx;
  font-weight: 700;
}

.goal-progress-row {
  margin: 20rpx 0 20rpx 114rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.goal-progress {
  flex: 1;
  height: 14rpx;
  overflow: hidden;
  border-radius: 7rpx;
  background: #DFECE5;
}

.goal-progress__fill {
  min-width: 0;
  height: 100%;
  border-radius: 7rpx;
  background: linear-gradient(90deg, #A9D7C2 0%, #4F8E72 100%);
}

.goal-progress__number { flex: none; color: var(--profile-green); font-size: 26rpx; font-weight: 800; }

.goal-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.goal-action {
  min-width: 220rpx;
  height: 62rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 31rpx;
  font-size: 23rpx;
  font-weight: 500;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.88), 0 6rpx 16rpx rgba(31, 70, 58, 0.06);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
}

.goal-action--archive {
  border: 1rpx solid rgba(47, 109, 93, 0.15);
  background: #EAF5EE;
  color: var(--profile-green);
}

.goal-action--end {
  border: 1rpx solid #F4D2D2;
  background: var(--profile-pink);
  color: var(--profile-red);
}

.goal-action--end.is-disabled { opacity: 0.58; }

.goal-empty {
  margin: 0 26rpx;
  padding: 30rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid var(--profile-line);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
}

.goal-empty__icon { width: 96rpx; height: 96rpx; }
.goal-empty__title { margin-top: 12rpx; color: var(--profile-ink); font-size: 28rpx; font-weight: 700; }
.goal-empty__desc { margin-top: 8rpx; color: var(--profile-muted); font-size: 23rpx; text-align: center; }
.goal-empty__button { height: 62rpx; margin-top: 22rpx; padding: 0 36rpx; display: flex; align-items: center; border: 1rpx solid rgba(255, 255, 255, 0.78); border-radius: 31rpx; background: rgba(234, 245, 238, 0.68); color: var(--profile-green); font-size: 24rpx; font-weight: 600; box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.92), 0 6rpx 16rpx rgba(31, 70, 58, 0.06); backdrop-filter: blur(16rpx); -webkit-backdrop-filter: blur(16rpx); }

/* 工具箱 */
.toolbox-card { padding: 0 4rpx 28rpx; }
.toolbox-heading { padding-bottom: 20rpx; }

.toolbox-grid {
  margin: 0 24rpx;
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

.toolbox-item {
  position: relative;
  overflow: hidden;
  flex: 1;
  min-width: 0;
  height: 164rpx;
  padding: 12rpx 4rpx 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(47, 109, 93, 0.10);
  border-radius: 28rpx;
  background: rgba(234, 245, 238, 0.66);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.90), 0 8rpx 20rpx rgba(35, 67, 56, 0.055);
  backdrop-filter: blur(18rpx) saturate(120%);
  -webkit-backdrop-filter: blur(18rpx) saturate(120%);
  transition: opacity 0.15s, transform 0.15s;
}

.toolbox-item--trophy { border-color: rgba(244, 209, 141, 0.72); background: rgba(255, 241, 200, 0.68); }
.toolbox-item--settings { background: rgba(243, 239, 248, 0.70); }
.toolbox-item--pressed { opacity: 0.75; transform: scale(0.96); }
.toolbox-item__icon { width: 72rpx; height: 72rpx; }
.toolbox-item__title { color: var(--profile-ink); font-size: 21rpx; font-weight: 600; line-height: 1.15; text-align: center; white-space: nowrap; }
.toolbox-item__title--strong { font-size: 23rpx; font-weight: 800; }
.toolbox-item__sub { margin-top: 2rpx; color: var(--profile-ink); font-size: 18rpx; line-height: 1; }

/* 编辑资料弹层 */
.profile-editor-layer {
  position: fixed;
  inset: 0;
  z-index: 36;
  display: flex;
  align-items: flex-end;
}

.profile-editor-mask {
  position: absolute;
  inset: 0;
  background: rgba(31, 45, 40, 0.28);
  backdrop-filter: blur(4rpx);
  -webkit-backdrop-filter: blur(4rpx);
}

.profile-editor-panel {
  position: relative;
  width: 100%;
  max-height: calc(100vh - 120rpx);
  overflow-y: auto;
  padding: 22rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 36rpx 36rpx 0 0;
  background: var(--profile-bg);
  box-shadow: 0 -18rpx 50rpx rgba(35, 59, 52, 0.12);
}

.popup-handle { width: 80rpx; height: 8rpx; margin: 0 auto 24rpx; border-radius: 4rpx; background: #DCE5E0; }
.editor-head { margin-bottom: 22rpx; display: flex; align-items: center; justify-content: space-between; }
.editor-kicker { color: var(--profile-green); font-size: 19rpx; font-weight: 700; letter-spacing: 3rpx; }
.editor-title { margin-top: 6rpx; color: var(--profile-ink); font-size: 38rpx; font-weight: 700; }

.panel-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #EDF1EE;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.68);
  color: var(--profile-muted);
  font-size: 32rpx;
  box-shadow: 0 5rpx 14rpx rgba(31, 91, 74, 0.06);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
}

.profile-form-card { padding: 26rpx; border: 1rpx solid #EEF1EC; border-radius: 28rpx; background: #FFFFFF; box-shadow: var(--profile-shadow-soft); }
.profile-avatar-row, .profile-setting-row, .profile-editor-actions { display: flex; align-items: center; }
.profile-avatar-row { gap: 22rpx; }

.profile-avatar-preview {
  flex: none;
  width: 104rpx;
  height: 104rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--profile-yellow);
  color: var(--profile-green);
  font-size: 42rpx;
  font-weight: 700;
}

.profile-avatar-preview image { width: 100%; height: 100%; }

.avatar-choose-btn {
  height: 64rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: #EAF5EE;
  color: var(--profile-green);
  font-size: 24rpx;
  font-weight: 600;
}

.avatar-choose-btn::after { border: 0; }
.profile-field { margin-top: 28rpx; }
.profile-label { color: var(--profile-ink); font-size: 26rpx; font-weight: 600; }

.profile-input {
  width: 100%;
  height: 88rpx;
  margin-top: 14rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--profile-line);
  border-radius: 22rpx;
  background: #FAFCFA;
  color: var(--profile-ink);
  font-size: 28rpx;
}

.profile-setting-row { margin-top: 26rpx; padding: 22rpx; justify-content: space-between; gap: 22rpx; border-radius: 22rpx; background: #F7F8F3; }
.profile-helper { margin-top: 8rpx; color: var(--profile-muted); font-size: 23rpx; line-height: 1.4; }
.profile-editor-actions { gap: 18rpx; margin-top: 22rpx; }

.profile-cancel-btn,
.profile-save-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.profile-cancel-btn { border: 1rpx solid rgba(255, 255, 255, 0.82); background: rgba(255, 255, 255, 0.66); color: var(--profile-green); box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.92); backdrop-filter: blur(18rpx); -webkit-backdrop-filter: blur(18rpx); }
.profile-save-btn { background: var(--profile-green); color: #FFFFFF; box-shadow: 0 7rpx 18rpx rgba(47, 109, 93, 0.18); }
.profile-cancel-btn::after, .profile-save-btn::after { border: 0; }
