page { background: var(--color-background, #F7F3EA); }
.profile-page { min-height: 100vh; overflow-x: hidden; color: var(--color-text-main); background: var(--color-background); font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
.profile-hero { position: relative; min-height: 360rpx; overflow: hidden; }
.profile-hero__background { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .86; }
.profile-hero__veil { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(247,243,234,.08), rgba(247,243,234,.22) 58%, var(--color-background) 100%); }
.profile-nav { position: relative; z-index: 2; box-sizing: content-box; display: flex; align-items: center; justify-content: center; }
.profile-nav__title { color: var(--color-primary); font-family: "Songti SC", STSong, serif; font-size: 36rpx; font-weight: 700; letter-spacing: 3rpx; }
.profile-identity { position: relative; z-index: 2; margin: 42rpx 48rpx 0; display: flex; align-items: center; gap: 28rpx; }
.profile-avatar { position: relative; width: 136rpx; height: 136rpx; flex: none; overflow: hidden; border: 4rpx solid rgba(255,252,246,.9); border-radius: 50%; background: var(--color-card-soft); box-shadow: var(--shadow-card); }
.profile-avatar__image { position: absolute; inset: 0; width: 100%; height: 100%; }
.profile-avatar__image--default { padding: 24rpx; background: rgba(255,252,246,.9); }
.profile-identity__copy { min-width: 0; flex: 1; }
.profile-user-name { max-width: 100%; display: block; overflow: hidden; color: var(--color-primary); font-family: "Songti SC", STSong, serif; font-size: 43rpx; line-height: 54rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.profile-display-id { display: block; margin-top: 3rpx; color: var(--color-text-secondary); font-size: 21rpx; }
.profile-statuses { margin-top: 12rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.profile-status { min-height: 44rpx; padding: 7rpx 14rpx; display: flex; align-items: center; gap: 7rpx; border-radius: 999rpx; background: var(--color-success-soft); color: var(--color-success); font-size: 20rpx; }
.profile-status--warning { background: var(--color-warning-soft); color: var(--color-warning); }
.profile-status--plain { background: rgba(255,252,246,.82); color: var(--color-text-secondary); }
.profile-edit-line { min-height: 58rpx; margin-top: 4rpx; display: inline-flex; align-items: center; gap: 8rpx; color: #8B682F; font-size: 23rpx; }
.profile-content { position: relative; z-index: 3; padding: 0 32rpx calc(132rpx + env(safe-area-inset-bottom)); }
.paper-card { position: relative; box-sizing: border-box; overflow: hidden; margin-bottom: var(--gap-card); border: 1rpx solid var(--color-border-soft); border-radius: var(--radius-card); background: rgba(255,252,246,.96); box-shadow: var(--shadow-card-soft); }
.section-title { display: block; color: var(--color-text-main); font-family: "Songti SC", STSong, serif; font-size: 30rpx; font-weight: 700; letter-spacing: 1rpx; }
.section-kicker { color: var(--color-text-secondary); font-size: 23rpx; font-weight: 650; }
.profile-state-card { min-height: 340rpx; padding: 54rpx 36rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.profile-state-title { margin-top: 22rpx; font-size: 31rpx; font-weight: 700; }
.profile-state-copy { max-width: 520rpx; margin-top: 12rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 36rpx; }
.profile-retry-button { min-width: 220rpx; min-height: 80rpx; margin-top: 26rpx; border-radius: 40rpx; background: var(--color-primary); color: #fff; }
.journey-card { min-height: 258rpx; padding: 32rpx 34rpx; display: flex; align-items: center; justify-content: space-between; background: linear-gradient(135deg, rgba(255,252,246,.99), rgba(249,247,239,.96)); }
.journey-copy { position: relative; z-index: 1; min-width: 0; flex: 1; }
.journey-title, .journey-motto, .journey-note { display: block; }
.journey-title { color: var(--color-primary); font-family: "Songti SC", STSong, serif; font-size: 38rpx; line-height: 48rpx; letter-spacing: 2rpx; }
.journey-days { margin-top: 20rpx; display: flex; align-items: baseline; gap: 7rpx; color: var(--color-text-secondary); font-size: 24rpx; }
.journey-days__value { color: var(--color-accent); font-family: "Songti SC", STSong, serif; font-size: 48rpx; line-height: 54rpx; }
.journey-motto { margin-top: 6rpx; color: var(--color-text-secondary); font-family: "Songti SC", STSong, serif; font-size: 25rpx; letter-spacing: 2rpx; }
.journey-note { margin-top: 10rpx; color: var(--color-primary); font-size: 20rpx; }
.journey-ring { position: relative; width: 176rpx; height: 176rpx; margin-left: 30rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: conic-gradient(var(--color-primary) var(--journey-progress), rgba(127,157,145,.16) 0); transform: rotate(-42deg); }
.journey-ring__inner { width: 148rpx; height: 148rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-card); transform: rotate(42deg); }
.journey-ring__inner image { width: 94rpx; height: 94rpx; }
.journey-ring__dot { position: absolute; right: 4rpx; bottom: 30rpx; width: 10rpx; height: 10rpx; border: 5rpx solid var(--color-card); border-radius: 50%; background: var(--color-accent); }
.goal-card { min-height: 220rpx; }
.goal-card__background { position: absolute; top: 0; right: 0; width: 46%; height: 100%; opacity: .34; }
.goal-card__veil { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(255,252,246,.995) 0%, rgba(255,252,246,.98) 66%, rgba(255,252,246,.7) 100%); }
.goal-card__content { position: relative; z-index: 2; min-height: 220rpx; padding: 28rpx 32rpx 30rpx; display: flex; flex-direction: column; }
.goal-empty { position: relative; z-index: 2; min-height: 300rpx; padding: 30rpx 32rpx; display: flex; flex-direction: column; }
.goal-card__head { min-height: 52rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.goal-manage { min-width: 116rpx; min-height: 72rpx; margin: -10rpx -12rpx -10rpx 0; display: flex; align-items: center; justify-content: flex-end; color: var(--color-primary); font-size: 23rpx; font-weight: 650; }
.goal-title { width: 100%; margin-top: 10rpx; display: -webkit-box; overflow: hidden; color: var(--color-primary); font-family: "Songti SC", STSong, serif; font-size: 34rpx; line-height: 46rpx; font-weight: 700; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.goal-persisted { display: block; margin-top: 7rpx; color: var(--color-text-secondary); font-size: 21rpx; line-height: 32rpx; }
.goal-empty__button { min-width: 176rpx; min-height: 72rpx; padding: 0 24rpx; display: flex; align-items: center; justify-content: center; border-radius: 36rpx; background: var(--color-primary); color: #fff; font-size: 23rpx; font-weight: 650; }
.goal-empty__title { margin-top: 22rpx; font-size: 32rpx; font-weight: 700; }
.goal-empty__copy { margin-top: 10rpx; color: var(--color-text-secondary); font-size: 23rpx; }
.goal-empty__button { width: 176rpx; margin-top: auto; }
.growth-card { padding: 28rpx 30rpx; }
.growth-head, .collection-head, .manage-head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.growth-head > view:first-child { display: flex; align-items: baseline; gap: 14rpx; }
.growth-joined, .collection-summary, .manage-sync-note { color: var(--color-text-secondary); font-size: 21rpx; }
.growth-link, .collection-all { display: flex; align-items: center; color: var(--color-primary); font-size: 22rpx; }
.growth-grid { margin-top: 26rpx; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
.growth-item { min-width: 0; display: flex; align-items: center; flex-direction: column; }
.growth-item + .growth-item { border-left: 1rpx solid var(--color-divider); }
.growth-value { color: var(--color-primary); font-size: 42rpx; line-height: 52rpx; font-weight: 750; }
.growth-label { margin-top: 7rpx; color: var(--color-text-secondary); font-size: 21rpx; text-align: center; }
.weekly-line { margin-top: 24rpx; padding: 18rpx 20rpx; border-radius: 20rpx; background: var(--color-card-soft); color: var(--color-text-secondary); font-size: 22rpx; line-height: 32rpx; text-align: center; }
.collection-card { padding: 28rpx 28rpx 26rpx; }
.collection-head > view:first-child { min-width: 0; }
.collection-summary { display: block; margin-top: 4rpx; }
.collection-grid { margin-top: 24rpx; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.collection-item { min-width: 0; display: flex; align-items: center; flex-direction: column; text-align: center; }
.collection-badge { position: relative; width: 106rpx; height: 106rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-primary-soft); }
.collection-badge__ring { position: absolute; inset: 5rpx; border: 2rpx solid rgba(36,91,77,.18); border-radius: 50%; }
.collection-badge image { position: relative; z-index: 1; width: 74rpx; height: 74rpx; }
.collection-state { position: absolute; z-index: 2; right: 1rpx; bottom: 3rpx; width: 30rpx; height: 30rpx; display: flex; align-items: center; justify-content: center; border: 3rpx solid var(--color-card); border-radius: 50%; background: var(--color-card); color: var(--color-success); }
.is-locked { opacity: .52; }
.collection-title { max-width: 100%; margin-top: 12rpx; overflow: hidden; font-size: 23rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.collection-date { max-width: 100%; margin-top: 4rpx; overflow: hidden; color: var(--color-text-secondary); font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.manage-card { padding: 28rpx; }
.manage-grid { margin-top: 22rpx; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.manage-item { min-height: 120rpx; padding: 20rpx; display: flex; align-items: center; gap: 14rpx; border: 1rpx solid var(--color-border-soft); border-radius: 22rpx; background: var(--color-card); }
.manage-icon { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; flex: none; border-radius: 18rpx; background: var(--color-primary-soft); color: var(--color-primary); }
.manage-item > view:last-child { min-width: 0; }
.manage-item text { display: block; overflow: hidden; font-size: 24rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.manage-item text + text { margin-top: 6rpx; color: var(--color-text-secondary); font-size: 19rpx; font-weight: 400; }
.manage-footer { min-height: 82rpx; margin-top: 18rpx; padding-top: 16rpx; display: flex; align-items: center; justify-content: center; gap: 34rpx; border-top: 1rpx solid var(--color-divider); color: var(--color-primary); font-size: 23rpx; }
.sheet-layer { position: fixed; z-index: 40; inset: 0; }
.sheet-mask { position: absolute; inset: 0; background: rgba(28,35,32,.42); }
.sheet-panel { position: absolute; right: 0; bottom: 0; left: 0; max-height: 88vh; padding: 12rpx 30rpx calc(28rpx + env(safe-area-inset-bottom)); overflow-y: auto; border-radius: 34rpx 34rpx 0 0; background: var(--color-background); box-shadow: 0 -18rpx 50rpx rgba(23,45,37,.16); }
.sheet-handle { width: 76rpx; height: 7rpx; margin: 0 auto 18rpx; border-radius: 4rpx; background: rgba(36,49,45,.16); }
.sheet-head { display: flex; align-items: center; justify-content: space-between; }
.sheet-kicker, .sheet-title { display: block; }
.sheet-kicker { color: var(--color-accent); font-size: 21rpx; }
.sheet-title { margin-top: 5rpx; font-size: 34rpx; font-weight: 700; }
.sheet-close { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: var(--color-text-secondary); }
.profile-form-card { margin-top: 20rpx; padding: 26rpx; border-radius: var(--radius-card); background: var(--color-card); }
.profile-avatar-row, .profile-setting-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.profile-avatar-preview { width: 112rpx; height: 112rpx; overflow: hidden; border-radius: 50%; background: var(--color-card-soft); }
.profile-avatar-preview image { width: 100%; height: 100%; }
.profile-avatar-preview__default { padding: 20rpx; }
.avatar-choose-btn { min-width: 180rpx; min-height: 80rpx; border-radius: 40rpx; color: var(--color-primary); }
.profile-field, .profile-setting-row { margin-top: 24rpx; }
.profile-label { display: block; font-size: 25rpx; font-weight: 650; }
.profile-input { min-height: 88rpx; margin-top: 12rpx; padding: 0 18rpx; border: 1rpx solid var(--color-border); border-radius: 22rpx; background: var(--color-card); }
.profile-setting-row > view:first-child { min-width: 0; flex: 1; }
.profile-helper { display: block; margin-top: 7rpx; color: var(--color-text-secondary); font-size: 21rpx; line-height: 31rpx; }
.sheet-actions { margin-top: 22rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.sheet-cancel, .sheet-save { min-height: 88rpx; border-radius: 44rpx; }
.sheet-cancel { border: 1rpx solid var(--color-border); background: var(--color-card); color: var(--color-primary); }
.sheet-save { background: var(--color-primary); color: #fff; }
.is-pressed { opacity: .66; }
@media (max-width: 350px) { .profile-content { padding-right: 24rpx; padding-left: 24rpx; } .profile-identity { margin-right: 30rpx; margin-left: 30rpx; } .profile-avatar { width: 118rpx; height: 118rpx; } .profile-user-name { font-size: 38rpx; } .journey-ring { width: 150rpx; height: 150rpx; margin-left: 18rpx; } .journey-ring__inner { width: 126rpx; height: 126rpx; } .journey-ring__inner image { width: 80rpx; height: 80rpx; } .manage-grid { grid-template-columns: 1fr; } .manage-sync-note { display: none; } }
@media (prefers-reduced-motion: reduce) { .paper-card { animation: none; } }
