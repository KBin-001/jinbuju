/* =============================================
   进步局 · 我的页面 — 全量样式重构
   设计规范：深绿 #145243 / #0F4035 | 浅绿 #F3F8F5 | 背景 #F7F8F5
            金色点缀 #F5B94E | 正文 #173C34 | 次级 #6F7F78 | 分割 #E8EFEB
   ============================================= */

/* ---- 页面容器 ---- */
.profile-page {
  --profile-primary: #145243;
  --profile-deep: #0f4035;
  --profile-accent: #55b98b;
  --profile-growth: #7dbb69;
  --profile-gold: #f5b94e;
  --profile-gold-light: #fff4cf;
  --profile-text: #173c34;
  --profile-secondary: #6f7f78;
  --profile-muted: #a8b0aa;
  --profile-border: #e8efeb;
  --profile-soft: #f3f8f5;
  --profile-bg: #f7f8f5;
  --profile-shadow: 0 8rpx 30rpx rgba(20, 82, 67, 0.08);
  min-height: 100vh;
  background: var(--profile-bg);
  color: var(--profile-text);
  /* 顶部安全区交给 navigationBar 处理，此处不额外留白 */
}

/* =============================================
   Hero 卡 — 大面积深绿渐变
   ============================================= */
.hero-card {
  position: relative;
  overflow: hidden;
  padding: 44rpx 32rpx 36rpx;
  background: linear-gradient(145deg, #145243 0%, #1d604f 58%, #2c755e 100%);
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 12rpx 34rpx rgba(20, 82, 67, 0.18);
}

/* 背景装饰圆 */
.hero-deco-circle {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.hero-deco-circle--1 {
  top: -60rpx;
  right: -50rpx;
  width: 260rpx;
  height: 260rpx;
  background: rgba(255, 255, 255, 0.04);
}
.hero-deco-circle--2 {
  bottom: -80rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.03);
}

/* 叶子装饰文字 */
.hero-deco-leaf {
  position: absolute;
  top: 16rpx;
  right: 24rpx;
  color: rgba(255, 255, 255, 0.08);
  font-size: 120rpx;
  line-height: 1;
  pointer-events: none;
  transform: rotate(20deg);
}

/* 顶部行 */
.hero-top-row {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  position: relative;
  z-index: 1;
}

/* 头像 */
.hero-avatar-wrap {
  position: relative;
  flex-shrink: 0;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--profile-gold);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 16rpx rgba(20, 82, 67, 0.16);
}
.hero-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}
.hero-avatar-text {
  color: var(--profile-primary);
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
}
.hero-avatar-badge {
  position: absolute;
  right: -2rpx;
  bottom: 2rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #d99b35;
  border: 3rpx solid rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 16rpx;
  line-height: 1;
}

/* 微信头像热区 */
.avatar-hitarea {
  position: absolute;
  inset: -8rpx;
  width: auto;
  height: auto;
  border-radius: 50%;
  opacity: 0;
  padding: 0;
  margin: 0;
  background: transparent;
}
.avatar-hitarea::after { border: 0; }

/* 用户信息 */
.hero-user-info {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}
.hero-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.hero-name {
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.2;
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hero-name-caret {
  color: rgba(255, 255, 255, 0.5);
  font-size: 28rpx;
}
.hero-level-pill {
  display: inline-flex;
  align-items: center;
  height: 38rpx;
  padding: 0 16rpx;
  margin-top: 12rpx;
  border-radius: 19rpx;
  background: rgba(245, 185, 78, 0.18);
  border: 1rpx solid rgba(245, 185, 78, 0.48);
  color: #ffd977;
  font-size: 22rpx;
  font-weight: 700;
}
.hero-joined {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
}

/* 编辑资料按钮 */
.hero-edit-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  padding: 0 20rpx;
  border: 1.5rpx solid rgba(255, 255, 255, 0.36);
  border-radius: 27rpx;
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  font-weight: 600;
  margin-top: 4rpx;
}
.hero-edit-btn::after { border: 0; }

/* 成长文案 */
.hero-motto {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.6;
  position: relative;
  z-index: 1;
}

/* =============================================
   页面主内容区
   ============================================= */
.page-content {
  padding: 28rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ---- 通用卡片 ---- */
.section-card {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: var(--profile-shadow);
  padding: 28rpx;
}

/* 卡片头 */
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.card-title {
  color: var(--profile-text);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
}
.card-link {
  color: var(--profile-primary);
  font-size: 26rpx;
  font-weight: 600;
}

/* =============================================
   成长概览卡
   ============================================= */
.overview-card {}

.overview-stats {
  display: flex;
  align-items: stretch;
}

.stat-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-divider {
  width: 1rpx;
  background: var(--profile-border);
  margin: 4rpx 0;
}

.stat-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}
.stat-icon-wrap--green { background: #eef7f2; }
.stat-icon-wrap--teal  { background: var(--profile-soft); }
.stat-icon-wrap--gold  { background: var(--profile-gold-light); }

.stat-icon {
  font-size: 32rpx;
  line-height: 1;
}

.stat-num {
  color: var(--profile-text);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
}
.stat-unit {
  color: var(--profile-secondary);
  font-size: 22rpx;
  font-weight: 500;
  margin-top: -4rpx;
}
.stat-label {
  color: var(--profile-secondary);
  font-size: 22rpx;
  margin-top: 2rpx;
}

/* =============================================
   我的目标卡
   ============================================= */
.goal-card {}

.goal-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 40rpx 0;
}
.goal-empty-icon { font-size: 60rpx; }
.goal-empty-title {
  color: var(--profile-text);
  font-size: 28rpx;
  font-weight: 700;
}
.goal-empty-desc {
  color: var(--profile-secondary);
  font-size: 24rpx;
}

.goal-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.goal-item {
  padding: 22rpx 20rpx;
  border: 1rpx solid var(--profile-border);
  border-radius: 20rpx;
  background: #fbfcfa;
  transition: opacity 0.15s, transform 0.15s;
}
.goal-item--pressed {
  opacity: 0.82;
  transform: scale(0.985);
}

.goal-item-main {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.goal-item-icon-wrap {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eef7f2;
  display: flex;
  align-items: center;
  justify-content: center;
}
.goal-item-icon { font-size: 34rpx; }

.goal-item-body {
  flex: 1;
  min-width: 0;
}

.goal-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.goal-item-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--profile-text);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}
.goal-status-chip {
  flex-shrink: 0;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 18rpx;
  background: #eef7f2;
  color: var(--profile-primary);
  font-size: 22rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
}

.goal-item-sub {
  display: block;
  margin-top: 8rpx;
  color: var(--profile-secondary);
  font-size: 24rpx;
}

.goal-progress-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}
.goal-progress-track {
  flex: 1;
  height: 16rpx;
  border-radius: 8rpx;
  background: #e8efea;
  overflow: hidden;
}
.goal-progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #145243 0%, #55b98b 100%);
  transition: width 0.4s ease;
}
.goal-progress-pct {
  flex-shrink: 0;
  color: var(--profile-primary);
  font-size: 26rpx;
  font-weight: 800;
}

.goal-focus-action {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  margin-top: 14rpx;
  padding: 0 18rpx;
  border-radius: 21rpx;
  background: #F3F8F5;
  color: var(--profile-primary);
  font-size: 22rpx;
  font-weight: 700;
}

/* 添加目标按钮 */
.add-goal-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 76rpx;
  margin-top: 20rpx;
  border-radius: 38rpx;
  border: 1.5rpx dashed #B8D4C8;
  background: var(--profile-bg);
  transition: opacity 0.15s, transform 0.15s;
}
.add-goal-btn--pressed { opacity: 0.75; transform: scale(0.98); }
.add-goal-plus {
  color: var(--profile-primary);
  font-size: 32rpx;
  font-weight: 400;
  line-height: 1;
}
.add-goal-text {
  color: var(--profile-primary);
  font-size: 26rpx;
  font-weight: 600;
}

/* =============================================
   功能入口卡
   ============================================= */
.func-card {
  padding: 24rpx 16rpx 20rpx;
  display: flex;
  align-items: stretch;
  gap: 0;
}

.func-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 8rpx;
  transition: opacity 0.15s, transform 0.15s;
  position: relative;
}
/* 竖线分隔（除最后一个） */
.func-item:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 20%;
  right: 0;
  width: 1rpx;
  height: 60%;
  background: var(--profile-border);
}
.func-item--pressed {
  opacity: 0.75;
  transform: scale(0.94);
}

.func-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.func-icon-wrap--history { background: #eef7f2; }
.func-icon-wrap--badges  { background: var(--profile-gold-light); }
.func-icon-wrap--focus   { background: #E8F3FF; }
.func-icon-wrap--settings { background: #F3F3F3; }

.func-icon-emoji { font-size: 38rpx; line-height: 1; }

.func-label {
  color: var(--profile-text);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}

/* =============================================
   本周小结卡
   ============================================= */
.week-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 24rpx 24rpx 24rpx;
  background: linear-gradient(110deg, #fff7df 0%, #fff4cf 100%);
  border: 1rpx solid rgba(245, 185, 78, 0.22);
  box-shadow: 0 6rpx 22rpx rgba(245, 185, 78, 0.08);
}

.week-badge-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.week-badge {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #145243 0%, #0f4035 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(20, 82, 67, 0.18);
}
.week-badge-icon { font-size: 40rpx; line-height: 1; }

.week-text {
  flex: 1;
  min-width: 0;
}
.week-title {
  display: block;
  color: var(--profile-text);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}
.week-desc {
  display: block;
  margin-top: 6rpx;
  color: var(--profile-secondary);
  font-size: 24rpx;
  line-height: 1.4;
}

/* 金色进度条 */
.week-progress-track {
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(245, 185, 78, 0.2);
  overflow: hidden;
  margin-top: 14rpx;
}
.week-progress-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #f5b94e 0%, #ffd977 100%);
  transition: width 0.5s ease;
}

/* 查看详情按钮 */
.week-detail-btn {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  background: var(--profile-primary);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.15s, transform 0.15s;
}
.week-detail-btn--pressed { opacity: 0.82; transform: scale(0.96); }

/* =============================================
   编辑资料弹层（样式保留并小幅升级）
   ============================================= */
.profile-editor-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 36;
  display: flex;
  align-items: flex-end;
}

.profile-editor-mask {
  position: absolute;
  inset: 0;
  background: rgba(31, 45, 42, 0.34);
}

.profile-editor-panel {
  position: relative;
  width: 100%;
  max-height: calc(100vh - 120rpx);
  overflow-y: auto;
  padding: 22rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: var(--profile-bg);
}

.popup-handle {
  width: 80rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: #cbd6d0;
}

.editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}
.editor-kicker {
  color: var(--profile-primary);
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}
.editor-title {
  margin-top: 6rpx;
  color: var(--profile-text);
  font-size: 38rpx;
  font-weight: 750;
}
.panel-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
  color: var(--profile-secondary);
  font-size: 32rpx;
  box-shadow: 0 4rpx 14rpx rgba(20, 82, 67, 0.08);
}

.profile-form-card {
  padding: 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: var(--profile-shadow);
}

.profile-avatar-row,
.profile-setting-row,
.profile-editor-actions {
  display: flex;
  align-items: center;
}
.profile-avatar-row { gap: 22rpx; }

.profile-avatar-preview {
  overflow: hidden;
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  background: var(--profile-gold);
  color: var(--profile-primary);
  font-size: 42rpx;
  font-weight: 750;
}
.profile-avatar-preview image { width: 100%; height: 100%; }

.avatar-choose-btn {
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border-radius: 32rpx;
  background: #eef7f2;
  color: var(--profile-primary);
  font-size: 24rpx;
  font-weight: 700;
}
.avatar-choose-btn::after { border: 0; }

.profile-field { margin-top: 28rpx; }
.profile-label {
  color: var(--profile-text);
  font-size: 26rpx;
  font-weight: 700;
}
.profile-input {
  width: 100%;
  height: 88rpx;
  margin-top: 14rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--profile-border);
  border-radius: 22rpx;
  background: #FAFCFA;
  color: var(--profile-text);
  font-size: 28rpx;
  box-sizing: border-box;
}

.profile-setting-row {
  justify-content: space-between;
  gap: 22rpx;
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: var(--profile-bg);
}
.profile-helper {
  margin-top: 8rpx;
  color: var(--profile-secondary);
  font-size: 23rpx;
  line-height: 1.4;
}

.profile-editor-actions {
  gap: 18rpx;
  margin-top: 22rpx;
}
.profile-cancel-btn,
.profile-save-btn {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  border-radius: 42rpx;
  font-size: 27rpx;
  font-weight: 750;
}
.profile-cancel-btn {
  border: 1rpx solid #d8e5df;
  background: #ffffff;
  color: var(--profile-primary);
}
.profile-save-btn {
  background: linear-gradient(135deg, #145243 0%, #0f4035 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(20, 82, 67, 0.18);
}
.profile-cancel-btn::after,
.profile-save-btn::after { border: 0; }
