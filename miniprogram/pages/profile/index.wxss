/* =============================================
   进步局 · 我的页面 — 浅绿成长风
   配色：主色 #3F8F72 / 深绿 #24584A / 浅绿 #E6F4EC
         背景 #F6FAF7 / 卡片 #FFFFFF / 文字 #244C43
         金色点缀 #F4C95D
   ============================================= */

/* ---- 页面容器 ---- */
.profile-page {
  --profile-primary: #3F8F72;
  --profile-deep: #24584A;
  --profile-primary-soft: #E6F4EC;
  --profile-primary-light: #7CC6A0;
  --profile-accent: #7CC6A0;
  --profile-growth: #7CC6A0;
  --profile-gold: #F4C95D;
  --profile-gold-soft: #FFF4D8;
  --profile-text: #244C43;
  --profile-secondary: #6F827B;
  --profile-muted: #9AA8A3;
  --profile-border: #E2EEE8;
  --profile-soft: #EFF8F3;
  --profile-bg: #F6FAF7;
  --profile-shadow: 0 8rpx 28rpx rgba(36, 88, 74, 0.08);
  /* 主题皮肤可覆盖的渐变（默认薄荷绿） */
  --profile-hero-gradient: linear-gradient(135deg, #E6F4EC 0%, #F7FBF8 60%, #FFFFFF 100%);
  --profile-progress-gradient: linear-gradient(90deg, #7CC6A0 0%, #3F8F72 100%);
  min-height: 100vh;
  background: var(--profile-bg);
  color: var(--profile-text);
  /* 顶部安全区交给 navigationBar 处理，此处不额外留白 */
}

/* =============================================
   Hero 卡 — 浅薄荷绿渐变
   ============================================= */
.hero-card {
  position: relative;
  overflow: hidden;
  padding: 44rpx 32rpx 36rpx;
  background: var(--profile-hero-gradient);
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(36, 88, 74, 0.06);
  color: var(--profile-text);
}

/* 背景装饰圆 */
.hero-deco-circle {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.hero-deco-circle--1 {
  top: -60rpx;
  right: -50rpx;
  width: 260rpx;
  height: 260rpx;
  background: rgba(124, 198, 160, 0.18);
}
.hero-deco-circle--2 {
  bottom: -80rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(244, 201, 93, 0.12);
}

/* 叶子装饰文字 */
.hero-deco-leaf {
  position: absolute;
  top: 16rpx;
  right: 24rpx;
  color: rgba(63, 143, 114, 0.08);
  font-size: 120rpx;
  line-height: 1;
  pointer-events: none;
  transform: rotate(20deg);
}

/* 顶部行 */
.hero-top-row {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  position: relative;
  z-index: 1;
}

/* 头像 */
.hero-avatar-wrap {
  position: relative;
  flex-shrink: 0;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--profile-gold-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 4rpx 16rpx rgba(244, 201, 93, 0.22);
}
.hero-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}
.hero-avatar-text {
  color: var(--profile-primary);
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
}
.hero-avatar-badge {
  position: absolute;
  right: -2rpx;
  bottom: 2rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--profile-primary);
  border: 3rpx solid #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 16rpx;
  line-height: 1;
}

/* 微信头像热区 */
.avatar-hitarea {
  position: absolute;
  inset: -8rpx;
  width: auto;
  height: auto;
  border-radius: 50%;
  opacity: 0;
  padding: 0;
  margin: 0;
  background: transparent;
}
.avatar-hitarea::after { border: 0; }

/* 用户信息 */
.hero-user-info {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}
.hero-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.hero-name {
  color: var(--profile-text);
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.2;
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hero-name-caret {
  color: var(--profile-muted);
  font-size: 28rpx;
}
.hero-level-pill {
  display: inline-flex;
  align-items: center;
  height: 38rpx;
  padding: 0 16rpx;
  margin-top: 12rpx;
  border-radius: 19rpx;
  background: var(--profile-gold-soft);
  border: 1rpx solid rgba(244, 201, 93, 0.48);
  color: #8A6B1F;
  font-size: 22rpx;
  font-weight: 700;
}
.hero-joined {
  margin-top: 10rpx;
  color: var(--profile-secondary);
  font-size: 24rpx;
}

/* 编辑资料按钮 */
.hero-edit-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  padding: 0 20rpx;
  border: 1.5rpx solid var(--profile-primary-light);
  border-radius: 27rpx;
  background: #FFFFFF;
  color: var(--profile-primary);
  font-size: 22rpx;
  font-weight: 600;
  margin-top: 4rpx;
}
.hero-edit-btn::after { border: 0; }

/* 成长文案 */
.hero-motto {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(63, 143, 114, 0.14);
  color: var(--profile-secondary);
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.6;
  position: relative;
  z-index: 1;
}

/* =============================================
   页面主内容区
   ============================================= */
.page-content {
  padding: 28rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ---- 通用卡片 ---- */
.section-card {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: var(--profile-shadow);
  padding: 28rpx;
}

/* 卡片头 */
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.card-title {
  color: var(--profile-text);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
}
.card-link {
  color: var(--profile-primary);
  font-size: 26rpx;
  font-weight: 600;
}

/* =============================================
   成长概览卡
   ============================================= */
.overview-card {}

.overview-stats {
  display: flex;
  align-items: stretch;
}

.stat-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-divider {
  width: 1rpx;
  background: var(--profile-border);
  margin: 4rpx 0;
}

.stat-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}
.stat-icon-wrap--green { background: var(--profile-primary-soft); }
.stat-icon-wrap--teal  { background: var(--profile-soft); }
.stat-icon-wrap--gold  { background: var(--profile-gold-soft); }

.stat-icon {
  font-size: 32rpx;
  line-height: 1;
}

.stat-num {
  color: var(--profile-text);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
}
.stat-unit {
  color: var(--profile-secondary);
  font-size: 22rpx;
  font-weight: 500;
  margin-top: -4rpx;
}
.stat-label {
  color: var(--profile-secondary);
  font-size: 22rpx;
  margin-top: 2rpx;
}

/* =============================================
   我的目标卡
   ============================================= */
.goal-card {}

.goal-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 40rpx 0;
}
.goal-empty-icon { font-size: 60rpx; }
.goal-empty-title {
  color: var(--profile-text);
  font-size: 28rpx;
  font-weight: 700;
}
.goal-empty-desc {
  color: var(--profile-secondary);
  font-size: 24rpx;
}

.goal-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.goal-item {
  padding: 22rpx 20rpx;
  border: 1rpx solid var(--profile-border);
  border-radius: 20rpx;
  background: #FBFCFA;
  transition: opacity 0.15s, transform 0.15s;
}
.goal-item--pressed {
  opacity: 0.82;
  transform: scale(0.985);
}

.goal-item-main {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.goal-item-icon-wrap {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--profile-primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}
.goal-item-icon { font-size: 34rpx; }

.goal-item-body {
  flex: 1;
  min-width: 0;
}

.goal-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.goal-item-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--profile-text);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}
.goal-status-chip {
  flex-shrink: 0;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 18rpx;
  background: var(--profile-primary-soft);
  color: var(--profile-primary);
  font-size: 22rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
}

.goal-item-sub {
  display: block;
  margin-top: 8rpx;
  color: var(--profile-secondary);
  font-size: 24rpx;
}

.goal-progress-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}
.goal-progress-track {
  flex: 1;
  height: 16rpx;
  border-radius: 8rpx;
  background: #E2EEE8;
  overflow: hidden;
}
.goal-progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: var(--profile-progress-gradient);
  transition: width 0.4s ease;
}
.goal-progress-pct {
  flex-shrink: 0;
  color: var(--profile-primary);
  font-size: 26rpx;
  font-weight: 800;
}

.goal-action-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.goal-focus-action,
.goal-end-action {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 21rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.goal-focus-action {
  background: var(--profile-primary-soft);
  color: var(--profile-primary);
}

.goal-end-action {
  border: 1rpx solid #EADBD7;
  background: #FBF1ED;
  color: #9A675F;
}

.goal-end-action.is-disabled {
  opacity: 0.58;
}

/* 添加目标按钮 */
.add-goal-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 76rpx;
  margin-top: 20rpx;
  border-radius: 38rpx;
  border: 1.5rpx dashed #B8D4C8;
  background: var(--profile-bg);
  transition: opacity 0.15s, transform 0.15s;
}
.add-goal-btn--pressed { opacity: 0.75; transform: scale(0.98); }
.add-goal-plus {
  color: var(--profile-primary);
  font-size: 32rpx;
  font-weight: 400;
  line-height: 1;
}
.add-goal-text {
  color: var(--profile-primary);
  font-size: 26rpx;
  font-weight: 600;
}

/* =============================================
   功能入口卡
   ============================================= */
.func-card {
  padding: 24rpx 16rpx 20rpx;
  display: flex;
  align-items: stretch;
  gap: 0;
}

.func-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 8rpx;
  transition: opacity 0.15s, transform 0.15s;
  position: relative;
}
/* 竖线分隔（除最后一个） */
.func-item:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 20%;
  right: 0;
  width: 1rpx;
  height: 60%;
  background: var(--profile-border);
}
.func-item--pressed {
  opacity: 0.75;
  transform: scale(0.94);
}

.func-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.func-icon-wrap--history { background: var(--profile-primary-soft); }
.func-icon-wrap--badges  { background: var(--profile-gold-soft); }
.func-icon-wrap--focus   { background: #E8F1FB; }
.func-icon-wrap--ai      { background: var(--profile-primary-soft); color: var(--profile-primary); }
.func-icon-wrap--theme   { background: var(--profile-primary-soft); color: var(--profile-primary); }
.func-icon-wrap--settings { background: #F1F4F2; }

.func-icon-emoji { font-size: 38rpx; line-height: 1; }

.func-label {
  color: var(--profile-text);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}

/* =============================================
   本周小结卡
   ============================================= */
.week-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 24rpx 24rpx 24rpx;
  background: linear-gradient(110deg, #FFF8E0 0%, #FFF4D8 100%);
  border: 1rpx solid rgba(244, 201, 93, 0.28);
  box-shadow: 0 6rpx 22rpx rgba(244, 201, 93, 0.10);
}

.week-badge-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.week-badge {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F4C95D 0%, #E0B04A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(244, 201, 93, 0.28);
}
.week-badge-icon { font-size: 40rpx; line-height: 1; }

.week-text {
  flex: 1;
  min-width: 0;
}
.week-title {
  display: block;
  color: var(--profile-text);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}
.week-desc {
  display: block;
  margin-top: 6rpx;
  color: var(--profile-secondary);
  font-size: 24rpx;
  line-height: 1.4;
}

/* 金色进度条 */
.week-progress-track {
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(244, 201, 93, 0.2);
  overflow: hidden;
  margin-top: 14rpx;
}
.week-progress-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #F4C95D 0%, #F8D779 100%);
  transition: width 0.5s ease;
}

/* 查看详情按钮 */
.week-detail-btn {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  background: var(--profile-primary);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.15s, transform 0.15s;
}
.week-detail-btn--pressed { opacity: 0.82; transform: scale(0.96); }

/* =============================================
   编辑资料弹层（样式保留并小幅升级）
   ============================================= */
.profile-editor-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 36;
  display: flex;
  align-items: flex-end;
}

.profile-editor-mask {
  position: absolute;
  inset: 0;
  background: rgba(36, 76, 67, 0.32);
}

.profile-editor-panel {
  position: relative;
  width: 100%;
  max-height: calc(100vh - 120rpx);
  overflow-y: auto;
  padding: 22rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: var(--profile-bg);
}

.popup-handle {
  width: 80rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: #E2EEE8;
}

.editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}
.editor-kicker {
  color: var(--profile-primary);
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}
.editor-title {
  margin-top: 6rpx;
  color: var(--profile-text);
  font-size: 38rpx;
  font-weight: 750;
}
.panel-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
  color: var(--profile-secondary);
  font-size: 32rpx;
  box-shadow: 0 4rpx 14rpx rgba(36, 88, 74, 0.08);
}

.profile-form-card {
  padding: 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: var(--profile-shadow);
}

.profile-avatar-row,
.profile-setting-row,
.profile-editor-actions {
  display: flex;
  align-items: center;
}
.profile-avatar-row { gap: 22rpx; }

.profile-avatar-preview {
  overflow: hidden;
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  background: var(--profile-gold-soft);
  color: var(--profile-primary);
  font-size: 42rpx;
  font-weight: 750;
}
.profile-avatar-preview image { width: 100%; height: 100%; }

.avatar-choose-btn {
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border-radius: 32rpx;
  background: var(--profile-primary-soft);
  color: var(--profile-primary);
  font-size: 24rpx;
  font-weight: 700;
}
.avatar-choose-btn::after { border: 0; }

.profile-field { margin-top: 28rpx; }
.profile-label {
  color: var(--profile-text);
  font-size: 26rpx;
  font-weight: 700;
}
.profile-input {
  width: 100%;
  height: 88rpx;
  margin-top: 14rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--profile-border);
  border-radius: 22rpx;
  background: #F8FBF9;
  color: var(--profile-text);
  font-size: 28rpx;
  box-sizing: border-box;
}

.profile-setting-row {
  justify-content: space-between;
  gap: 22rpx;
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: var(--profile-bg);
}
.profile-helper {
  margin-top: 8rpx;
  color: var(--profile-secondary);
  font-size: 23rpx;
  line-height: 1.4;
}

.profile-editor-actions {
  gap: 18rpx;
  margin-top: 22rpx;
}
.profile-cancel-btn,
.profile-save-btn {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  border-radius: 42rpx;
  font-size: 27rpx;
  font-weight: 750;
}
.profile-cancel-btn {
  border: 1rpx solid #E2EEE8;
  background: #ffffff;
  color: var(--profile-primary);
}
.profile-save-btn {
  background: var(--profile-primary);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(63, 143, 114, 0.22);
}
.profile-cancel-btn::after,
.profile-save-btn::after { border: 0; }

/* =============================================
   主题皮肤弹窗
   ============================================= */
.theme-picker-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 38;
  display: flex;
  align-items: flex-end;
}

.theme-picker-mask {
  position: absolute;
  inset: 0;
  background: rgba(36, 76, 67, 0.32);
}

.theme-picker-panel {
  position: relative;
  width: 100%;
  max-height: calc(100vh - 120rpx);
  overflow-y: auto;
  padding: 22rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  /* 弹窗面板使用固定中性底，避免预览时面板自身晃动 */
  background: #F6FAF7;
}

.theme-picker-desc {
  margin: -4rpx 0 22rpx;
  color: var(--profile-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.theme-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.theme-card {
  padding: 24rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 2rpx solid #EDF3EF;
  box-shadow: 0 6rpx 20rpx rgba(36, 88, 74, 0.05);
  transition: opacity 0.15s, transform 0.15s, border-color 0.2s;
}
.theme-card--pressed {
  opacity: 0.92;
  transform: scale(0.985);
}
.theme-card.is-selected {
  border-color: var(--profile-primary);
  box-shadow: 0 8rpx 24rpx rgba(36, 88, 74, 0.1);
}
.theme-card.is-current {
  border-color: var(--profile-primary-light);
}

.theme-card-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 18rpx;
}
.theme-card-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.theme-color-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}
.theme-card-name {
  flex: 1;
  color: var(--profile-text);
  font-size: 30rpx;
  font-weight: 800;
}
.theme-current-tag {
  flex-shrink: 0;
  height: 36rpx;
  padding: 0 16rpx;
  border-radius: 18rpx;
  background: var(--profile-primary-soft);
  color: var(--profile-primary);
  font-size: 22rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
}
.theme-card-desc {
  color: var(--profile-secondary);
  font-size: 23rpx;
  line-height: 1.4;
}

/* 预览区：浅色背景 + 进度 + 按钮 */
.theme-preview {
  border-radius: 22rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.theme-preview-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.theme-preview-chip {
  height: 38rpx;
  padding: 0 16rpx;
  border-radius: 19rpx;
  font-size: 22rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
}
.theme-preview-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
}
.theme-preview-track {
  width: 100%;
  height: 14rpx;
  border-radius: 7rpx;
  background: rgba(0, 0, 0, 0.06);
  overflow: hidden;
}
.theme-preview-fill {
  height: 100%;
  border-radius: 7rpx;
}
.theme-preview-btn {
  align-self: flex-start;
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 30rpx;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* 卡片底部操作 */
.theme-card-actions {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.theme-apply-btn {
  height: 64rpx;
  padding: 0 32rpx;
  border-radius: 32rpx;
  background: var(--profile-primary);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  box-shadow: 0 4rpx 14rpx rgba(63, 143, 114, 0.22);
}
.theme-applied-tag {
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  border: 1rpx solid var(--profile-primary-light);
  background: var(--profile-primary-soft);
  color: var(--profile-primary);
  font-size: 26rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
}
.theme-tap-hint {
  color: var(--profile-muted);
  font-size: 24rpx;
}
