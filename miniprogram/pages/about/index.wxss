.about-page {
  padding-top: 72rpx;
  text-align: center;
}

.about-mark {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border-radius: 38rpx;
  background: linear-gradient(145deg, var(--color-primary), var(--color-primary-deep));
  color: #ffffff;
  font-size: 54rpx;
  font-weight: 700;
  box-shadow: 0 18rpx 42rpx rgba(31, 77, 66, 0.2);
}

.about-title {
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.about-version {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.about-card {
  margin-top: 48rpx;
  text-align: left;
  background: linear-gradient(145deg, #ffffff, #f4f8f5);
}

.about-heading {
  font-size: 31rpx;
  font-weight: 650;
  line-height: 1.5;
}

.about-copy,
.about-footnote {
  margin-top: 18rpx;
  color: var(--color-text-secondary);
  line-height: 1.75;
}

.about-footnote {
  font-size: 23rpx;
}
.about-page { background:linear-gradient(180deg,#E6F4EC 0,#F7FBF8 390rpx,#F6FAF7 390rpx); }
.about-mark { background:linear-gradient(135deg,#F4C95D,#E0B04A); color:#244C43; box-shadow:0 18rpx 44rpx rgba(244,201,93,.24); }
.about-title, .about-version { color:#244C43; }
.about-card { border:0; border-radius:36rpx; background:#FFFFFF; box-shadow:0 8rpx 24rpx rgba(36,88,74,.08); }
