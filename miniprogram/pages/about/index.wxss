page { background: #F7F3EA; }

.about-page { padding-top: 24rpx; color: #24312D; text-align: left; }
.about-hero { position: relative; height: 300rpx; overflow: hidden; border-radius: 32rpx; background: #E8ECE6; }
.about-hero__mountain { position: absolute; inset: 0; width: 100%; height: 100%; }
.about-hero__veil { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(255,252,246,.96), rgba(255,252,246,.62) 56%, rgba(255,252,246,.12)); }
.about-hero__content { position: relative; z-index: 2; height: 100%; padding: 38rpx; display: flex; align-items: center; gap: 26rpx; }
.about-mark { width: 104rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(102,143,132,.20); border-radius: 32rpx; background: var(--color-action-soft); color: var(--color-action-primary-active); font-family: var(--font-family-brand); font-size: 48rpx; font-weight: var(--font-weight-title); box-shadow: 0 10rpx 28rpx rgba(85,127,117,.10); }
.about-brand-copy { min-width: 0; }
.about-title { color: var(--color-primary); font-family: var(--font-family-brand); font-size: 43rpx; line-height: 52rpx; font-weight: var(--font-weight-title); letter-spacing: 3rpx; }
.about-subtitle { margin-top: 2rpx; color: #557368; font-size: 25rpx; line-height: 34rpx; font-weight: 650; letter-spacing: 2rpx; }
.about-version { margin-top: 8rpx; color: #7C817D; font-size: 23rpx; }
.about-card { margin-top: 22rpx; padding: 30rpx; border: 1rpx solid rgba(121,111,91,.13); border-radius: 28rpx; background: #FFFCF6; box-shadow: 0 8rpx 24rpx rgba(75,62,40,.06); }
.about-card--small { margin-top: 18rpx; }
.about-heading { color: #24312D; font-size: 30rpx; font-weight: 700; line-height: 42rpx; }
.about-copy { margin-top: 14rpx; color: #7C817D; font-size: 25rpx; line-height: 40rpx; }
.about-footnote { margin: 24rpx 12rpx 0; color: #8A8C87; font-size: 22rpx; line-height: 34rpx; text-align: center; }
.feedback-button { min-height: 82rpx; margin-top: 22rpx; display: flex; align-items: center; justify-content: center; border: 0; border-radius: 42rpx; background: var(--color-action-primary); color: #FFF; font-size: 26rpx; font-weight: 650; }
.feedback-button::after { border: 0; }
.about-link { min-height: 82rpx; display: flex; align-items: center; justify-content: space-between; color: #24312D; font-size: 26rpx; }
.about-link + .about-link { border-top: 1rpx solid rgba(121,111,91,.13); }
@media (max-width: 350px) { .about-hero__content { padding: 28rpx; gap: 20rpx; } .about-mark { width: 88rpx; height: 88rpx; border-radius: 27rpx; font-size: 42rpx; } .about-title { font-size: 37rpx; } .about-subtitle { font-size: 22rpx; } }

/* Semantic type roles for product identity, about copy and feedback. */
.about-title { font-size: var(--font-page-title); line-height: var(--line-height-page-title); }
.about-mark { font-size: var(--font-icon-display); line-height: var(--line-height-data); }
.about-subtitle,
.about-version { font-size: var(--font-meta); line-height: var(--line-height-meta); }
.about-heading { font-size: var(--font-card-title); line-height: var(--line-height-card-title); }
.about-copy { font-size: var(--font-longform); line-height: var(--line-height-body); }
.about-footnote { font-size: var(--font-caption); line-height: var(--line-height-caption); }
.feedback-button,
.about-link { font-size: var(--font-body-strong); line-height: var(--line-height-body-strong); }

@media (max-width: 350px) {
  .about-title { font-size: var(--font-page-title-compact); line-height: var(--line-height-page-title); }
  .about-heading { font-size: var(--font-card-title-compact); line-height: var(--line-height-card-title); }
  .about-copy { font-size: var(--font-body-compact); line-height: var(--line-height-body); }
  .about-subtitle,
  .about-version { font-size: var(--font-meta-compact); line-height: var(--line-height-meta); }
}
