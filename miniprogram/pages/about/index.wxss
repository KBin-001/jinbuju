.about-page {
  padding-top: 72rpx;
  text-align: center;
}

.about-mark {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border-radius: 38rpx;
  background: linear-gradient(145deg, var(--color-primary), var(--color-primary-deep));
  color: #ffffff;
  font-size: 54rpx;
  font-weight: 700;
  box-shadow: 0 18rpx 42rpx rgba(31, 77, 66, 0.2);
}

.about-title {
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.about-version {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.about-card {
  margin-top: 48rpx;
  text-align: left;
  background: linear-gradient(145deg, #ffffff, #f4f8f5);
}

.about-heading {
  font-size: 31rpx;
  font-weight: 650;
  line-height: 1.5;
}

.about-copy,
.about-footnote {
  margin-top: 18rpx;
  color: var(--color-text-secondary);
  line-height: 1.75;
}

.about-footnote {
  font-size: 23rpx;
}
.about-page { background:linear-gradient(180deg,#153f36 0,#285f51 390rpx,#edf1ee 390rpx); }
.about-mark { background:linear-gradient(145deg,#f0d28c,#d8a84e); color:#153f36; box-shadow:0 18rpx 44rpx rgba(0,0,0,.2); }
.about-title, .about-version { color:#fff; }
.about-card { border:0; border-radius:36rpx; background:rgba(255,255,255,.94); box-shadow:0 22rpx 56rpx rgba(21,63,54,.18); }
