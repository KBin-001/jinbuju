<view class="page privacy-page" data-theme="{{appTheme}}">
  <view class="privacy-hero">
    <view class="privacy-hero__mark"><t-icon name="lock-on" size="48rpx" /></view>
    <view><view class="privacy-hero__title">隐私与授权</view><view class="privacy-hero__subtitle">只说明真实处理的信息，也保留你的选择权</view></view>
  </view>

  <view wx:if="{{loading}}" class="card state-card"><t-loading size="48rpx" theme="circular" /><view class="state-title">正在读取协议记录</view></view>
  <block wx:else>
    <view class="card version-card">
      <view class="section-title">当前协议版本</view>
      <view class="version-row"><view><view>隐私政策</view><text>{{status.versions.privacy}}</text></view><view class="record-chip {{status.consents.privacy.agreed ? '' : 'record-chip--pending'}}">{{status.consents.privacy.agreed ? '已记录' : '待确认'}}</view></view>
      <view class="version-row"><view><view>用户协议</view><text>{{status.versions.terms}}</text></view><view class="record-chip {{status.consents.terms.agreed ? '' : 'record-chip--pending'}}">{{status.consents.terms.agreed ? '已记录' : '待确认'}}</view></view>
      <view class="draft-note">当前为发布候选版本。运营主体、联系方式、发布日期和生效日期仍需上线前人工确认。</view>
      <view class="legal-links"><view bindtap="openPrivacy">阅读隐私政策</view><view bindtap="openTerms">阅读用户协议</view></view>
      <checkbox-group class="agreement-check" bindchange="onConsentChange"><label><checkbox value="agree" checked="{{consentChecked}}" color="#245B4D" /><text>我已分别阅读并同意当前版本的隐私政策与用户协议</text></label></checkbox-group>
      <t-button class="confirm-button" loading="{{saving}}" disabled="{{!consentChecked || saving}}" bindtap="confirmAgreements">保存同意记录</t-button>
      <view wx:if="{{errorMessage}}" class="error-message">{{errorMessage}}</view>
    </view>

    <view class="card list-card">
      <view class="section-title">个人信息收集清单</view>
      <view class="info-item"><t-icon name="user" size="34rpx" /><view><view>微信身份、昵称与头像</view><text>用于建立账号、展示个人资料和小队身份</text></view></view>
      <view class="info-item"><t-icon name="flag" size="34rpx" /><view><view>目标、行动、投入与复盘</view><text>用于今日计划、进度统计、历史目标和 AI 建议</text></view></view>
      <view class="info-item"><t-icon name="user" size="34rpx" /><view><view>小队关系与公开行动摘要</view><text>用于成员身份、行动榜与轻量鼓励</text></view></view>
      <view class="info-item"><t-icon name="info-circle" size="34rpx" /><view><view>手机号（可选）</view><text>仅在用户主动授权并确认用途后绑定</text></view></view>
      <view class="info-item"><t-icon name="notification" size="34rpx" /><view><view>通知授权记录与微信身份</view><text>仅用于投递你主动订阅的行动、教练和小队提醒</text></view></view>
    </view>

    <view class="card notification-card">
      <view class="notification-heading">
        <view><view class="section-title">订阅通知</view><text>每次微信订阅授权仅产生一次可用额度</text></view>
        <view bindtap="openWechatNotificationSettings" class="setting-link">管理微信授权</view>
      </view>
      <view wx:if="{{notificationLoading}}" class="notification-loading"><t-loading size="36rpx" theme="circular" /><text>正在读取通知状态</text></view>
      <view wx:elif="{{!notificationPreference}}" class="notification-load-error"><text>{{notificationErrorMessage || '通知状态暂时没有加载出来'}}</text><button bindtap="loadNotificationSettings">重试</button></view>
      <block wx:elif="{{notificationPreference}}">
        <view wx:if="{{!wechatNotificationMainSwitch}}" class="notification-warning">微信订阅消息总开关已关闭，开启场景偏好后仍需到微信授权管理中恢复。</view>
        <view class="notification-row">
          <view><view>每日行动提醒</view><text>{{notificationPreference.scenes.daily_action_reminder.configured ? (notificationPreference.scenes.daily_action_reminder.needsAuthorization ? '待续订 · 前往今日页授权' : '剩余 ' + notificationPreference.scenes.daily_action_reminder.remainingQuota + ' 次') : '模板审核中，暂不可开启'}}</text></view>
          <t-switch data-scene="daily_action_reminder" value="{{notificationPreference.scenes.daily_action_reminder.enabled}}" loading="{{notificationSavingScene === 'daily_action_reminder'}}" bindchange="onNotificationChange" />
        </view>
        <view class="notification-row">
          <view><view>AI 教练建议</view><text>{{notificationPreference.scenes.ai_coach_advice.configured ? (notificationPreference.scenes.ai_coach_advice.needsAuthorization ? '待续订 · 前往教练页授权' : '剩余 ' + notificationPreference.scenes.ai_coach_advice.remainingQuota + ' 次') : '模板审核中，暂不可开启'}}</text></view>
          <t-switch data-scene="ai_coach_advice" value="{{notificationPreference.scenes.ai_coach_advice.enabled}}" loading="{{notificationSavingScene === 'ai_coach_advice'}}" bindchange="onNotificationChange" />
        </view>
        <view class="notification-row">
          <view><view>小队动态</view><text>{{notificationPreference.scenes.team_activity.configured ? (notificationPreference.scenes.team_activity.needsAuthorization ? '待续订 · 前往小队页授权' : '剩余 ' + notificationPreference.scenes.team_activity.remainingQuota + ' 次') : '模板审核中，暂不可开启'}}</text></view>
          <t-switch data-scene="team_activity" value="{{notificationPreference.scenes.team_activity.enabled}}" loading="{{notificationSavingScene === 'team_activity'}}" bindchange="onNotificationChange" />
        </view>
      </block>
      <view wx:if="{{notificationPreference && notificationErrorMessage}}" class="error-message">{{notificationErrorMessage}}</view>
      <view class="notification-note">关闭仅停止本服务并使未消费额度失效，不会修改微信侧的系统设置。发送失败时，仅在偏好仍开启且符合规则时生成站内提醒。</view>
      <view class="notification-explain-link" bindtap="openPrivacy">了解通知服务与数据保留说明</view>
    </view>

    <view class="card list-card">
      <view class="section-title">第三方与权限说明</view>
      <view class="plain-copy">微信平台提供身份上下文和手机号授权；腾讯云 CloudBase 承载数据库、云函数、云存储和 AI 网关。AI 实际模型提供方与数据保留策略需在正式环境核实后写入最终政策。</view>
      <view class="plain-copy">当前使用的敏感能力包括选择微信头像、获取手机号和保存分享图片到相册；未发现位置、通讯录、麦克风或摄像头采集。</view>
    </view>

    <view class="card rights-card">
      <view class="section-title">你的数据权利</view>
      <view class="rights-row" bindtap="openAccountSecurity"><view><view>手机号绑定与解除</view><text>拒绝绑定不影响核心功能</text></view><t-icon name="chevron-right" size="32rpx" /></view>
      <view class="rights-row" bindtap="withdrawOptionalConsent"><view><view>撤回可选手机号处理同意</view><text>已绑定时请先解除绑定</text></view><t-icon name="chevron-right" size="32rpx" /></view>
      <view class="rights-row" bindtap="openDataManagement"><view><view>删除数据与注销账号</view><text>三类操作分开处理并二次确认</text></view><t-icon name="chevron-right" size="32rpx" /></view>
    </view>
  </block>
</view>
