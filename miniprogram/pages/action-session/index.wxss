.session-page { height: 100vh; box-sizing: border-box; padding: 32rpx 32rpx calc(30rpx + env(safe-area-inset-bottom)); overflow: hidden; background: var(--color-bg-page); color: var(--color-text-main); }
.state-view { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18rpx; color: var(--color-text-secondary); text-align: center; }
.state-title { color: var(--color-text-main); font-size: 32rpx; font-weight: 700; }.state-copy { max-width: 520rpx; font-size: 25rpx; line-height: 1.6; }
.session-head { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 4rpx; }.goal-label { max-width: 65%; overflow: hidden; color: var(--color-text-secondary); font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }.mode-label { color: var(--color-primary); font-size: 22rpx; }
.focus-area { display: flex; flex-direction: column; align-items: center; padding-top: 54rpx; }.task-title { max-width: 620rpx; color: var(--color-text-main); font-size: 34rpx; font-weight: 700; line-height: 1.45; text-align: center; }
.session-progress { --td-progress-circle-width: 390rpx; --td-progress-circle-inner-bg-color: var(--color-bg-card); display: block; margin-top: 54rpx; }
.timer-ring__inner { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 50%; }
.timer-value { font-variant-numeric: tabular-nums; font-size: 76rpx; font-weight: 650; letter-spacing: 3rpx; }.timer-hint { margin-top: 14rpx; color: var(--color-text-secondary); font-size: 23rpx; }
.focus-copy { max-width: 560rpx; margin-top: 44rpx; color: var(--color-text-secondary); font-size: 23rpx; line-height: 1.65; text-align: center; }
.session-actions { display: flex; gap: 18rpx; margin-top: 70rpx; }.session-actions button, .state-view button, .sheet-submit { height: 92rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; box-sizing: border-box; border-radius: var(--radius-button); font-size: 28rpx; font-weight: 650; }.session-actions button::after, .state-view button::after, .sheet-submit::after { border: 0; }
.secondary-button { flex: 1; border: 1rpx solid var(--color-border-strong); background: var(--color-bg-card); color: var(--color-primary); }.primary-button { flex: 1.45; border: 0; background: var(--color-primary); color: #fff; }
.danger-link { margin-top: 30rpx; color: var(--color-danger); font-size: 23rpx; text-align: center; }
.sheet-mask { position: fixed; z-index: 20; inset: 0; background: var(--color-mask); }.completion-sheet { position: fixed; z-index: 21; right: 0; bottom: 0; left: 0; box-sizing: border-box; padding: 18rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius: var(--radius-sheet) var(--radius-sheet) 0 0; background: var(--color-bg-card); transform: translateY(110%); transition: transform .24s ease; }.completion-sheet.is-visible { transform: translateY(0); }
.sheet-handle { width: 72rpx; height: 7rpx; margin: 0 auto 25rpx; border-radius: 999rpx; background: var(--color-border-strong); }.sheet-title { font-size: 32rpx; font-weight: 700; }.sheet-copy { margin-top: 10rpx; color: var(--color-text-secondary); font-size: 23rpx; line-height: 1.55; }
.minutes-field { height: 86rpx; display: flex; align-items: center; gap: 12rpx; margin: 24rpx 0 18rpx; padding: 0 20rpx; border-radius: var(--radius-input); background: var(--color-surface-soft); font-size: 25rpx; }.minutes-field input { min-width: 0; flex: 1; color: var(--color-text-main); font-size: 32rpx; font-weight: 650; text-align: right; }.sheet-submit { width: 100%; margin-top: 24rpx; }
@media (max-width: 350px) { .focus-area { padding-top: 30rpx; } .session-progress { --td-progress-circle-width: 330rpx; margin-top: 36rpx; } .timer-value { font-size: 62rpx; } .session-actions { margin-top: 46rpx; } }
