<view class="session-page" data-theme="{{appTheme}}">
  <view wx:if="{{loading}}" class="state-view"><t-loading size="48rpx" text="正在准备行动" /></view>
  <view wx:elif="{{errorMessage}}" class="state-view">
    <t-icon name="error-circle" size="64rpx" />
    <text class="state-title">暂时无法开始</text><text class="state-copy">{{errorMessage}}</text>
    <button class="secondary-button" bindtap="goBack">返回今日</button>
  </view>
  <block wx:else>
    <image class="session-atmosphere" src="/pages/action-session/assets/mountains-v1.jpg" mode="aspectFill" aria-hidden="true" />
    <view class="session-content">
      <view class="session-head">
        <text class="goal-label">{{goalTitle}}</text>
        <text class="mode-label">{{session.mode === 'countdown' ? '按预计投入倒计时' : '自由正计时'}}</text>
      </view>
      <view class="focus-area">
        <view class="task-heading">
          <text class="task-title">{{task.title}}</text>
          <image class="task-seal" src="/assets/today-action-seal-v1.png" mode="aspectFit" aria-hidden="true" />
        </view>
        <t-progress
          class="session-progress"
          theme="circle"
          percentage="{{session.mode === 'countdown' ? progressPercent : 0}}"
          label="{{false}}"
          stroke-width="6rpx"
          color="{{session.status === 'paused' ? '#C89B4A' : '#245B4D'}}"
          track-color="#A8BDB5"
          aria-label="{{session.status === 'paused' ? '行动已暂停' : '行动计时中'}}"
        >
          <view slot="label" class="timer-ring__inner">
            <text class="timer-value">{{displayTime}}</text>
            <text class="timer-hint">{{session.status === 'paused' ? '已暂停' : remainingText}}</text>
          </view>
        </t-progress>
        <view class="focus-message">
          <text class="focus-quote">心定于一事，时间自有回响。</text>
          <view class="focus-divider"></view>
          <text class="focus-copy">退出小程序后，计时仍会按时间戳恢复。</text>
        </view>
      </view>
      <view class="session-controls">
        <view class="session-actions">
          <button wx:if="{{session.status === 'running'}}" class="secondary-button" bindtap="pause">暂停</button>
          <button wx:else class="secondary-button" bindtap="resume">继续</button>
          <button class="primary-button" bindtap="prepareComplete">提前完成</button>
        </view>
        <view class="danger-link" bindtap="abandon">放弃本次行动</view>
      </view>
    </view>
  </block>

  <view wx:if="{{completionVisible}}" class="sheet-mask" catchtap="closeCompletion"></view>
  <view class="completion-sheet {{completionVisible ? 'is-visible' : ''}}">
    <view class="sheet-handle"></view>
    <view class="sheet-title">记录这次真实投入</view>
    <view class="sheet-copy">计时结果为 {{elapsedResultText}}，你可以修正最终统计分钟数。</view>
    <view class="minutes-field"><text>实际投入</text><input type="number" value="{{actualMinutes}}" bindinput="inputMinutes" /><text>分钟</text></view>
    <t-textarea value="{{reflection}}" maxlength="200" placeholder="写下收获或遇到的困难（可选）" bindchange="inputReflection" />
    <button class="primary-button sheet-submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitComplete">完成并保存</button>
  </view>
</view>
