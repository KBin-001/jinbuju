page { height: 100%; overflow: hidden; background: #f7f3ea; }
.achievement-page { position: relative; box-sizing: border-box; height: 100vh; overflow: hidden; background: linear-gradient(180deg, #fbf8f1, #f5f3eb 56%, #f7f3ea); color: #24312d; font-family: var(--font-family-sans); }
.achievement-ambient { position: absolute; border-radius: 50%; pointer-events: none; }
.achievement-ambient--one { top: -240rpx; right: -200rpx; width: 430rpx; height: 430rpx; background: radial-gradient(circle, rgba(200,155,74,.08), transparent 68%); }
.achievement-ambient--two { top: 620rpx; left: -300rpx; width: 460rpx; height: 460rpx; background: radial-gradient(circle, rgba(127,157,145,.1), transparent 68%); }
.achievement-nav { position: relative; z-index: 2; height: 88rpx; padding: 0 26rpx; display: grid; align-items: center; grid-template-columns: 88rpx 1fr 88rpx; }
.achievement-nav-button { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: var(--color-primary); }
.achievement-nav-title { color: var(--color-primary); font-size: 34rpx; font-weight: 700; text-align: center; }
.achievement-scroll { position: relative; z-index: 1; height: calc(100vh - 88rpx - env(safe-area-inset-top)); }
.achievement-content { padding: 20rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); }
.achievement-hero { box-sizing: border-box; min-height: 230rpx; padding: 30rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; border: 1rpx solid rgba(36,91,77,.1); border-radius: 28rpx; background: rgba(255,252,246,.96); box-shadow: 0 10rpx 28rpx rgba(45,61,53,.07); }
.achievement-hero-copy { min-width: 0; flex: 1; }
.achievement-hero-kicker { color: #8b6b34; font-size: 21rpx; font-weight: 650; letter-spacing: 2rpx; }
.achievement-hero-title { max-width: 390rpx; margin-top: 12rpx; color: #24312d; font-size: 32rpx; font-weight: 700; line-height: 44rpx; }
.achievement-hero-summary { margin-top: 20rpx; display: flex; align-items: baseline; gap: 7rpx; color: #7c817d; font-size: 22rpx; }
.achievement-hero-number { color: var(--color-primary); font-size: 40rpx; font-weight: 750; }
.achievement-hero-percent { margin-left: auto; color: #7c817d; font-size: 20rpx; }
.achievement-featured { width: 154rpx; min-height: 170rpx; padding: 14rpx 10rpx; display: flex; align-items: center; justify-content: center; flex-direction: column; border: 1rpx solid rgba(36,91,77,.1); border-radius: 24rpx; background: #f1f4ee; color: #52665d; font-size: 19rpx; }
.achievement-featured image { width: 104rpx; height: 104rpx; }
.achievement-featured text { margin-top: 6rpx; }
.achievement-filter { height: 72rpx; margin-top: 22rpx; padding: 6rpx; display: grid; grid-template-columns: repeat(3, 1fr); border: 1rpx solid rgba(36,91,77,.08); border-radius: 22rpx; background: rgba(255,252,246,.76); }
.achievement-filter-item { display: flex; align-items: center; justify-content: center; border-radius: 17rpx; color: #7c817d; font-size: 23rpx; }
.achievement-filter-item.is-active { background: var(--color-action-primary); color: #fff; font-weight: 650; }
.achievement-section { margin-top: 30rpx; }
.achievement-section-head { padding: 0 2rpx; display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }
.achievement-section-title { color: #24312d; font-size: 29rpx; font-weight: 700; }
.achievement-section-subtitle { margin-top: 5rpx; color: #7c817d; font-size: 20rpx; line-height: 30rpx; }
.achievement-section-count { flex: none; color: #7c817d; font-size: 20rpx; }
.achievement-grid { margin-top: 16rpx; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.achievement-card { min-width: 0; padding: 18rpx 10rpx 16rpx; overflow: hidden; border: 1rpx solid rgba(36,91,77,.09); border-radius: 22rpx; background: rgba(255,252,246,.96); text-align: center; }
.achievement-card.is-locked { background: rgba(249,248,243,.9); }
.achievement-badge-shell { position: relative; width: 102rpx; height: 102rpx; margin: 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #e8efeb; }
.tier-gold .achievement-badge-shell { background: #f3ead3; }
.achievement-badge-ring { position: absolute; inset: 6rpx; border: 1rpx solid rgba(36,91,77,.16); border-radius: 50%; }
.achievement-badge-image { position: relative; width: 84rpx; height: 84rpx; }
.is-locked .achievement-badge-image { opacity: .32; filter: grayscale(1); }
.achievement-state-icon { position: absolute; right: -3rpx; bottom: 1rpx; width: 34rpx; height: 34rpx; display: flex; align-items: center; justify-content: center; border: 3rpx solid #fffcf6; border-radius: 50%; background: var(--color-action-primary); color: #fff; }
.is-locked .achievement-state-icon { background: #8c9591; }
.achievement-card-title { min-height: 58rpx; margin-top: 12rpx; display: -webkit-box; overflow: hidden; color: #29483e; font-size: 22rpx; font-weight: 650; line-height: 29rpx; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.is-locked .achievement-card-title { color: #69766f; }
.achievement-card-status { margin-top: 5rpx; overflow: hidden; color: #8b682f; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.is-locked .achievement-card-status { color: #7c817d; }
.achievement-card-track { height: 6rpx; margin: 10rpx 10rpx 0; overflow: hidden; border-radius: 3rpx; background: #e2e8e4; }
.achievement-card-track view { height: 100%; border-radius: inherit; background: #7f9d91; }
.achievement-empty { margin-top: 72rpx; color: #7c817d; font-size: 23rpx; text-align: center; }
.achievement-bottom-copy { margin-top: 42rpx; color: #8a9690; font-size: 20rpx; text-align: center; }
.achievement-detail-layer, .achievement-celebration { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; }
.achievement-detail-mask, .achievement-celebration-mask { position: absolute; inset: 0; background: rgba(19,39,32,.46); }
.achievement-detail-panel { position: relative; width: 100%; max-height: 86vh; padding: 18rpx 0 calc(28rpx + env(safe-area-inset-bottom)); overflow: hidden; border-radius: 36rpx 36rpx 0 0; background: #f7f3ea; box-shadow: 0 -16rpx 44rpx rgba(20,48,39,.14); }
.achievement-detail-handle { width: 72rpx; height: 7rpx; margin: 0 auto; border-radius: 4rpx; background: #d5ded8; }
.achievement-detail-close { position: absolute; z-index: 2; top: 18rpx; right: 24rpx; width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #52665d; }
.achievement-detail-scroll { max-height: calc(86vh - 48rpx); }
.achievement-detail-content { padding: 24rpx 40rpx 12rpx; text-align: center; }
.achievement-detail-badge { position: relative; width: 176rpx; height: 176rpx; margin: 4rpx auto 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #e2ece7; }
.achievement-detail-badge.tier-gold { background: #f2e6c8; }
.achievement-detail-badge image { position: relative; z-index: 1; width: 150rpx; height: 150rpx; }
.achievement-detail-badge.is-locked image { opacity: .32; filter: grayscale(1); }
.achievement-detail-aura { position: absolute; inset: 10rpx; border: 1rpx solid rgba(36,91,77,.15); border-radius: 50%; }
.achievement-detail-status { margin-top: 18rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; color: #8b682f; font-size: 21rpx; font-weight: 650; }
.achievement-detail-title { margin-top: 9rpx; color: #24312d; font-size: 36rpx; font-weight: 750; }
.achievement-detail-description { margin-top: 10rpx; color: #66776f; font-size: 24rpx; line-height: 38rpx; }
.achievement-earned-date { display: inline-flex; margin-top: 20rpx; padding: 10rpx 20rpx; border-radius: 22rpx; background: #f2e6c8; color: #8b6827; font-size: 21rpx; }
.achievement-detail-progress-row { margin-top: 26rpx; display: flex; justify-content: space-between; color: #52665d; font-size: 21rpx; }
.achievement-detail-track { height: 10rpx; margin-top: 10rpx; overflow: hidden; border-radius: 5rpx; background: #e2eae5; }
.achievement-detail-track view { height: 100%; border-radius: inherit; background: #7f9d91; }
.achievement-detail-remaining { margin-top: 11rpx; color: #356859; font-size: 22rpx; }
.achievement-detail-note { margin-top: 24rpx; padding: 18rpx; display: flex; align-items: flex-start; gap: 10rpx; border-radius: 18rpx; background: #edf2ef; color: #6f7d76; font-size: 20rpx; line-height: 31rpx; text-align: left; }
.achievement-detail-action, .achievement-celebration-button { height: 84rpx; margin-top: 22rpx; display: flex; align-items: center; justify-content: center; border-radius: 42rpx; background: var(--color-action-primary); color: #fff; font-size: 25rpx; font-weight: 650; }
.achievement-celebration { z-index: 40; align-items: center; justify-content: center; padding: 36rpx; }
.achievement-celebration-card { position: relative; box-sizing: border-box; width: 100%; max-width: 620rpx; padding: 42rpx 38rpx 34rpx; border-radius: 30rpx; background: #fffdf8; text-align: center; box-shadow: 0 24rpx 64rpx rgba(0,0,0,.22); }
.achievement-reveal { width: 168rpx; height: 168rpx; margin: 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #e2ece7; }
.achievement-reveal.tier-gold { background: #f2e6c8; }
.achievement-reveal image { width: 146rpx; height: 146rpx; }
.achievement-celebration-kicker { margin-top: 22rpx; color: #8b682f; font-size: 20rpx; font-weight: 650; letter-spacing: 2rpx; }
.achievement-celebration-title { margin-top: 9rpx; font-size: 36rpx; font-weight: 750; }
.achievement-celebration-copy { margin-top: 10rpx; color: #66776f; font-size: 23rpx; line-height: 34rpx; }
.achievement-celebration-date { margin-top: 10rpx; color: #999f9b; font-size: 19rpx; }
.is-pressed { opacity: .72; transform: scale(.99); }
@media (max-width: 350px) {
  .achievement-content { padding-right: 24rpx; padding-left: 24rpx; }
  .achievement-hero { align-items: flex-start; }
  .achievement-featured { width: 132rpx; }
  .achievement-badge-shell { width: 88rpx; height: 88rpx; }
  .achievement-badge-image { width: 72rpx; height: 72rpx; }
  .achievement-card { padding-right: 6rpx; padding-left: 6rpx; }
}
@media (prefers-reduced-motion: reduce) { .is-pressed { transform: none; } }
