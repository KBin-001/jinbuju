page{height:100%;overflow:hidden;background:#f7f3ea}.achievement-page{position:relative;display:flex;box-sizing:border-box;height:100vh;flex-direction:column;overflow:hidden;background:linear-gradient(180deg,#fbf7ee,#f2f5ef 58%,#f7f3ea);color:#24312d}.achievement-ambient{position:absolute;border-radius:50%;pointer-events:none}.achievement-ambient--one{top:-220rpx;right:-170rpx;width:450rpx;height:450rpx;background:radial-gradient(circle,rgba(200,155,74,.18),transparent 68%)}.achievement-ambient--two{top:600rpx;left:-280rpx;width:480rpx;height:480rpx;background:radial-gradient(circle,rgba(127,157,145,.18),transparent 68%)}
.achievement-nav{position:relative;z-index:3;display:flex;align-items:center;justify-content:space-between;height:92rpx;padding:0 28rpx;flex:none}.achievement-nav-button,.achievement-nav-space{width:68rpx;height:68rpx}.achievement-nav-button{display:flex;align-items:center;justify-content:center;border:1rpx solid rgba(36,91,77,.1);border-radius:50%;background:rgba(255,252,246,.82);color:#245b4d;box-shadow:0 8rpx 24rpx rgba(36,49,45,.06)}.achievement-nav-title{font-size:31rpx;font-weight:800;letter-spacing:1rpx}.achievement-scroll{position:relative;z-index:1;min-height:0;flex:1}.achievement-content{padding:18rpx 28rpx calc(84rpx + env(safe-area-inset-bottom))}
