.achievement-filter{display:flex;margin-top:26rpx;padding:8rpx;border:1rpx solid rgba(36,91,77,.08);border-radius:24rpx;background:rgba(255,252,246,.8)}.achievement-filter-item{display:flex;height:64rpx;align-items:center;justify-content:center;flex:1;border-radius:18rpx;color:#7c817d;font-size:23rpx;font-weight:700}.achievement-filter-item.is-active{background:#245b4d;color:#fff;box-shadow:0 8rpx 18rpx rgba(36,91,77,.18)}
.achievement-section{margin-top:40rpx}.achievement-section-head{display:flex;align-items:flex-end;justify-content:space-between;padding:0 4rpx 18rpx}.achievement-section-title{font-size:30rpx;font-weight:800}.achievement-section-subtitle{margin-top:5rpx;color:#7c817d;font-size:20rpx}.achievement-section-count{padding:8rpx 15rpx;border-radius:18rpx;background:#e5eee9;color:#356859;font-size:19rpx;font-weight:800}.achievement-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16rpx}.achievement-card{box-sizing:border-box;min-width:0;min-height:260rpx;padding:18rpx 8rpx 16rpx;border:1rpx solid rgba(36,91,77,.08);border-radius:28rpx;background:#fffcf6;text-align:center;box-shadow:0 12rpx 30rpx rgba(31,70,58,.06);transition:transform .18s ease,opacity .18s ease}.achievement-card.is-unlocked{border-color:rgba(200,155,74,.25);background:linear-gradient(150deg,#fffdf8,#f6f2e8)}.achievement-card.is-near{box-shadow:0 14rpx 34rpx rgba(36,91,77,.12)}
.achievement-badge-shell{position:relative;display:flex;width:130rpx;height:130rpx;align-items:center;justify-content:center;margin:0 auto;border-radius:50%;background:linear-gradient(145deg,#fff,#dfe9e3);box-shadow:inset 0 0 0 5rpx rgba(255,255,255,.66),0 10rpx 20rpx rgba(31,70,58,.13)}.tier-jade .achievement-badge-shell,.achievement-badge-shell.tier-jade{background:linear-gradient(145deg,#f9fff9,#b8d0c4)}.tier-gold .achievement-badge-shell,.achievement-badge-shell.tier-gold{background:linear-gradient(145deg,#fff8dd,#d9b65d)}.achievement-badge-ring{position:absolute;inset:7rpx;border:2rpx solid rgba(36,91,77,.18);border-radius:50%}.tier-gold .achievement-badge-ring{border-color:rgba(151,105,25,.35)}.achievement-badge-gloss{position:absolute;top:14rpx;left:27rpx;width:44rpx;height:18rpx;transform:rotate(-30deg);border-radius:50%;background:rgba(255,255,255,.62)}.achievement-badge-image{position:relative;width:112rpx;height:112rpx;filter:drop-shadow(0 8rpx 10rpx rgba(31,70,58,.12))}.is-locked .achievement-badge-image{opacity:.28;filter:grayscale(1)}.achievement-state-icon{position:absolute;right:-2rpx;bottom:5rpx;display:flex;width:38rpx;height:38rpx;align-items:center;justify-content:center;border:3rpx solid #fffcf6;border-radius:50%;background:#245b4d;color:#fff}.is-locked .achievement-state-icon{background:#818c87}.achievement-card-title{display:-webkit-box;min-height:58rpx;margin-top:12rpx;overflow:hidden;color:#29483e;font-size:22rpx;font-weight:800;line-height:29rpx;-webkit-box-orient:vertical;-webkit-line-clamp:2}.is-locked .achievement-card-title{color:#69766f}.achievement-card-status{margin-top:4rpx;color:#a1772e;font-size:18rpx;font-weight:700}.is-locked .achievement-card-status{color:#7c817d}.achievement-card-track{height:7rpx;margin:10rpx 12rpx 0;overflow:hidden;border-radius:6rpx;background:#e2e8e4}.achievement-card-track view{height:100%;border-radius:6rpx;background:linear-gradient(90deg,#7f9d91,#c89b4a)}.achievement-empty{margin-top:60rpx;color:#7c817d;text-align:center}.achievement-bottom-copy{margin-top:52rpx;color:#8a9690;font-size:20rpx;text-align:center}
.achievement-detail-layer{position:fixed;z-index:20;inset:0;display:flex;align-items:flex-end}.achievement-detail-mask{position:absolute;inset:0;background:rgba(19,39,32,.48)}.achievement-detail-panel{position:relative;display:flex;box-sizing:border-box;width:100%;max-height:86vh;flex-direction:column;padding:24rpx 0 calc(28rpx + env(safe-area-inset-bottom));border-radius:44rpx 44rpx 0 0;background:linear-gradient(165deg,#fffdf8,#f2f6f0);box-shadow:0 -20rpx 50rpx rgba(20,48,39,.16);animation:achievement-rise .26s ease-out}.achievement-detail-handle{width:78rpx;height:8rpx;margin:0 auto;border-radius:4rpx;background:#d5ded8}.achievement-detail-close{position:absolute;z-index:2;top:24rpx;right:30rpx;display:flex;width:64rpx;height:64rpx;align-items:center;justify-content:center;border-radius:50%;background:#e7ede9;color:#52665d}.achievement-detail-scroll{min-height:0;flex:1}.achievement-detail-content{padding:18rpx 42rpx 10rpx;text-align:center}.achievement-detail-badge{position:relative;display:flex;width:250rpx;height:250rpx;align-items:center;justify-content:center;margin:12rpx auto 0;border-radius:50%;background:radial-gradient(circle,#fff,#dfeae4 68%,#a8c0b4);box-shadow:inset 0 0 0 10rpx rgba(255,255,255,.65),0 22rpx 35rpx rgba(31,70,58,.14)}.achievement-detail-badge.tier-gold{background:radial-gradient(circle,#fffdf2,#f0d98f 68%,#b88835)}.achievement-detail-badge.tier-jade{background:radial-gradient(circle,#fff,#c6ded1 68%,#6f9986)}.achievement-detail-badge image{position:relative;z-index:2;width:218rpx;height:218rpx;filter:drop-shadow(0 14rpx 14rpx rgba(31,70,58,.16))}.achievement-detail-badge.is-locked image{opacity:.32;filter:grayscale(1)}.achievement-detail-aura{position:absolute;inset:20rpx;border:1rpx solid rgba(255,255,255,.74);border-radius:50%}.achievement-detail-status{display:flex;align-items:center;justify-content:center;gap:8rpx;margin-top:22rpx;color:#a1772e;font-size:21rpx;font-weight:800}.achievement-detail-title{margin-top:10rpx;font-size:39rpx;font-weight:850}.achievement-detail-description{margin-top:12rpx;color:#66776f;font-size:24rpx;line-height:38rpx}.achievement-earned-date{display:inline-flex;margin-top:22rpx;padding:12rpx 22rpx;border-radius:24rpx;background:#fff1c8;color:#8b6827;font-size:21rpx;font-weight:700}.achievement-detail-progress-row{display:flex;justify-content:space-between;margin-top:28rpx;color:#52665d;font-size:21rpx;font-weight:700}.achievement-detail-track{height:14rpx;margin-top:12rpx;overflow:hidden;border-radius:7rpx;background:#e2eae5}.achievement-detail-track view{height:100%;border-radius:7rpx;background:linear-gradient(90deg,#356859,#8db184,#d6b25d)}.achievement-detail-remaining{margin-top:12rpx;color:#356859;font-size:22rpx;font-weight:700}.achievement-detail-note{display:flex;align-items:flex-start;gap:12rpx;margin-top:28rpx;padding:20rpx;border-radius:20rpx;background:#edf2ef;color:#6f7d76;font-size:20rpx;line-height:32rpx;text-align:left}.achievement-detail-action{display:flex;height:88rpx;align-items:center;justify-content:center;margin-top:24rpx;border-radius:28rpx;background:#245b4d;color:#fff;font-size:25rpx;font-weight:800}
.achievement-celebration{position:fixed;z-index:40;inset:0;display:flex;align-items:center;justify-content:center;padding:36rpx}.achievement-celebration-mask{position:absolute;inset:0;background:rgba(14,35,28,.72)}.achievement-celebration-card{position:relative;box-sizing:border-box;width:100%;max-width:640rpx;overflow:hidden;padding:54rpx 42rpx 40rpx;border:1rpx solid rgba(255,255,255,.7);border-radius:42rpx;background:linear-gradient(155deg,#fffdf7,#f3eee0);text-align:center;box-shadow:0 32rpx 90rpx rgba(0,0,0,.3);animation:celebration-card .36s cubic-bezier(.2,.9,.3,1.15)}.achievement-rays{position:absolute;top:18rpx;left:50%;width:360rpx;height:360rpx;transform:translateX(-50%)}.achievement-rays view{position:absolute;top:0;left:174rpx;width:12rpx;height:76rpx;transform-origin:6rpx 180rpx;border-radius:8rpx;background:linear-gradient(#d8ad54,transparent);opacity:.35}.achievement-rays view:nth-child(2){transform:rotate(60deg)}.achievement-rays view:nth-child(3){transform:rotate(120deg)}.achievement-rays view:nth-child(4){transform:rotate(180deg)}.achievement-rays view:nth-child(5){transform:rotate(240deg)}.achievement-rays view:nth-child(6){transform:rotate(300deg)}.achievement-reveal{position:relative;display:flex;width:250rpx;height:250rpx;align-items:center;justify-content:center;overflow:hidden;margin:0 auto;border-radius:50%;background:linear-gradient(145deg,#fff,#c7d9cf);box-shadow:inset 0 0 0 9rpx rgba(255,255,255,.7),0 22rpx 44rpx rgba(36,91,77,.2);animation:badge-reveal .55s cubic-bezier(.2,.9,.25,1.18)}.achievement-reveal.tier-gold{background:linear-gradient(145deg,#fff8d8,#d2a744)}.achievement-reveal.tier-jade{background:linear-gradient(145deg,#f8fff9,#8fb2a2)}.achievement-reveal image{position:relative;z-index:2;width:220rpx;height:220rpx}.achievement-reveal-gloss{position:absolute;z-index:3;top:-40rpx;left:-90rpx;width:64rpx;height:340rpx;transform:rotate(25deg);background:linear-gradient(90deg,transparent,rgba(255,255,255,.72),transparent);animation:badge-gloss .7s .28s ease-out both}.achievement-celebration-kicker{margin-top:26rpx;color:#a1772e;font-size:20rpx;font-weight:800;letter-spacing:4rpx}.achievement-celebration-title{margin-top:10rpx;font-size:42rpx;font-weight:850}.achievement-celebration-copy{margin-top:10rpx;color:#66776f;font-size:23rpx}.achievement-celebration-date{margin-top:12rpx;color:#999f9b;font-size:19rpx}.achievement-celebration-button{display:flex;height:88rpx;align-items:center;justify-content:center;margin-top:30rpx;border-radius:28rpx;background:linear-gradient(110deg,#245b4d,#377462);color:#fff;font-size:26rpx;font-weight:800;box-shadow:0 14rpx 28rpx rgba(36,91,77,.2)}
.is-pressed{opacity:.78;transform:scale(.98)}@keyframes achievement-rise{from{opacity:0;transform:translateY(80rpx)}to{opacity:1;transform:translateY(0)}}@keyframes celebration-card{from{opacity:0;transform:translateY(30rpx) scale(.94)}to{opacity:1;transform:none}}@keyframes badge-reveal{0%{opacity:0;transform:scale(.52) rotate(-8deg)}100%{opacity:1;transform:scale(1) rotate(0)}}@keyframes badge-gloss{from{transform:translateX(0) rotate(25deg)}to{transform:translateX(430rpx) rotate(25deg)}}
@media(max-width:350px){.achievement-content{padding-right:22rpx;padding-left:22rpx}.achievement-hero{min-height:280rpx;padding:28rpx}.achievement-hero-copy{width:64%}.achievement-hero-title{font-size:32rpx;line-height:43rpx}.achievement-featured{width:160rpx;height:190rpx}.achievement-featured image{width:126rpx;height:126rpx}.achievement-grid{gap:10rpx}.achievement-card{min-height:234rpx;padding-right:5rpx;padding-left:5rpx}.achievement-badge-shell{width:108rpx;height:108rpx}.achievement-badge-image{width:94rpx;height:94rpx}.achievement-card-title{font-size:20rpx}.achievement-detail-content{padding-right:30rpx;padding-left:30rpx}}
@media(prefers-reduced-motion:reduce){.achievement-detail-panel,.achievement-celebration-card,.achievement-reveal,.achievement-reveal-gloss{animation:none}}
