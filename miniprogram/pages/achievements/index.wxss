page {
  height: 100%;
  overflow: hidden;
  background: #f7f3ea;
}

.achievement-page {
  position: relative;
  box-sizing: border-box;
  height: 100vh;
  overflow: hidden;
  background: #f7f3ea;
  color: #24312d;
  font-family: var(--font-family-sans);
}

.achievement-nav {
  position: relative;
  z-index: 5;
  height: 92rpx;
  padding: 0 28rpx;
  display: grid;
  align-items: center;
  grid-template-columns: 88rpx 1fr 88rpx;
  background: rgba(247, 243, 234, .94);
}

.achievement-nav::after {
  position: absolute;
  right: 32rpx;
  bottom: 0;
  left: 32rpx;
  height: 1rpx;
  background: rgba(36, 91, 77, .06);
  content: "";
}

.achievement-nav-button {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary);
}

.achievement-nav-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: var(--color-primary-dark);
  font-family: var(--font-family-brand);
  font-size: 37rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  text-align: center;
}

.achievement-nav-seal,
.achievement-signature-seal,
.achievement-celebration-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(184, 82, 59, .68);
  color: #a94f3d;
  font-family: var(--font-family-brand);
  line-height: 1;
}

.achievement-nav-seal {
  width: 26rpx;
  height: 31rpx;
  border-radius: 5rpx;
  font-size: 16rpx;
  letter-spacing: 0;
}

.achievement-scroll {
  position: relative;
  height: calc(100vh - 92rpx - env(safe-area-inset-top));
}

.achievement-content {
  padding: 22rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
}

.achievement-state {
  min-height: 70vh;
  padding: 80rpx 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: var(--color-text-secondary);
}

.achievement-state--error { text-align: center; }
.achievement-state-title { color: var(--color-text-main); font-size: 30rpx; font-weight: 650; }
.achievement-state-copy { margin-top: 14rpx; font-size: 23rpx; line-height: 36rpx; }
.achievement-state-action { margin-top: 28rpx; padding: 17rpx 34rpx; border: 1rpx solid rgba(36, 91, 77, .24); border-radius: 999rpx; color: var(--color-primary); font-size: 24rpx; }

.achievement-hero {
  position: relative;
  box-sizing: border-box;
  min-height: 258rpx;
  padding: 30rpx 30rpx;
  display: flex;
  align-items: center;
  overflow: hidden;
  border: 1rpx solid rgba(200, 155, 74, .28);
  border-radius: 28rpx;
  background: #fffcf6;
  box-shadow: 0 7rpx 22rpx rgba(49, 57, 50, .05);
}

.achievement-hero-landscape {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: .72;
}

.achievement-hero::after {
  position: absolute;
  inset: 0;
  background: rgba(255, 252, 246, .2);
  content: "";
}

.achievement-hero-copy {
  position: relative;
  z-index: 2;
  width: 58%;
  min-width: 0;
}

.achievement-hero-summary { display: flex; align-items: flex-end; gap: 13rpx; }

.achievement-hero-number {
  color: var(--color-primary-dark);
  font-family: var(--font-family-numeric);
  font-size: 70rpx;
  font-weight: 500;
  line-height: .92;
  letter-spacing: -3rpx;
}

.achievement-hero-unit {
  padding-bottom: 4rpx;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  color: var(--color-text-body);
  font-size: 21rpx;
}

.achievement-hero-unit text:last-child { color: var(--color-text-secondary); font-size: 19rpx; }

.achievement-hero-message {
  max-width: 390rpx;
  margin-top: 26rpx;
  color: #4f615b;
  font-family: var(--font-family-brand);
  font-size: 22rpx;
  line-height: 35rpx;
  letter-spacing: 1rpx;
}

.achievement-stage {
  width: fit-content;
  margin-top: 20rpx;
  padding: 10rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  border: 1rpx solid rgba(200, 155, 74, .26);
  border-radius: 999rpx;
  background: rgba(255, 252, 246, .72);
  color: #725d36;
  font-size: 20rpx;
}

.achievement-signature {
  position: absolute;
  z-index: 2;
  right: 26rpx;
  top: 30rpx;
  width: 182rpx;
  height: 182rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 50%;
  background: transparent;
  box-shadow: none;
}

.achievement-signature image { position: relative; width: 178rpx; height: 178rpx; }

.achievement-signature-seal {
  position: absolute;
  right: -1rpx;
  bottom: 6rpx;
  width: 41rpx;
  height: 41rpx;
  border-radius: 7rpx;
  background: #fffaf1;
  font-size: 17rpx;
}

.achievement-focus-row {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: minmax(0, .86fr) minmax(0, 1.14fr);
  gap: 16rpx;
}

.achievement-focus-card {
  position: relative;
  box-sizing: border-box;
  min-width: 0;
  min-height: 266rpx;
  padding: 23rpx 22rpx 20rpx;
  border: 1rpx solid rgba(36, 91, 77, .1);
  border-radius: 24rpx;
  background: #fffcf6;
  box-shadow: 0 4rpx 14rpx rgba(49, 57, 50, .035);
}

.achievement-focus-kicker {
  padding-bottom: 15rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  border-bottom: 1rpx solid rgba(200, 155, 74, .2);
  color: #765f35;
  font-size: 21rpx;
  font-weight: 600;
}

.achievement-focus-main,
.achievement-next-main { margin-top: 17rpx; display: flex; align-items: center; gap: 13rpx; }
.achievement-focus-main image { width: 78rpx; height: 78rpx; flex: none; }
.achievement-focus-copy,
.achievement-next-copy { min-width: 0; flex: 1; }

.achievement-focus-title {
  overflow: hidden;
  color: var(--color-text-main);
  font-family: var(--font-family-brand);
  font-size: 27rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.achievement-focus-meta { margin-top: 6rpx; color: var(--color-text-secondary); font-family: var(--font-family-numeric); font-size: 19rpx; }

.achievement-focus-note {
  margin-top: 14rpx;
  display: -webkit-box;
  overflow: hidden;
  color: #68756f;
  font-size: 20rpx;
  line-height: 31rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.achievement-text-action,
.achievement-outline-action,
.achievement-memory-action {
  display: flex;
  align-items: center;
  color: var(--color-primary);
  font-size: 21rpx;
}

.achievement-text-action { margin-top: 15rpx; }

.achievement-next-badge {
  position: relative;
  width: 78rpx;
  height: 78rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f0eee7;
}

.achievement-next-badge image { width: 66rpx; height: 66rpx; opacity: .42; filter: grayscale(1); }

.achievement-next-lock {
  position: absolute;
  right: -2rpx;
  bottom: -1rpx;
  width: 29rpx;
  height: 29rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fffcf6;
  border-radius: 50%;
  background: #77817c;
  color: #fff;
}

.achievement-progress-track,
.achievement-card-track,
.achievement-detail-track {
  overflow: hidden;
  background: #e4e8e4;
}

.achievement-progress-track { height: 6rpx; margin-top: 11rpx; border-radius: 4rpx; }
.achievement-progress-track view,
.achievement-card-track view,
.achievement-detail-track view { height: 100%; border-radius: inherit; background: var(--color-primary); }

.achievement-outline-action {
  width: fit-content;
  min-height: 54rpx;
  margin-top: 12rpx;
  padding: 0 13rpx 0 17rpx;
  justify-content: center;
  border: 1rpx solid rgba(36, 91, 77, .44);
  border-radius: 12rpx;
  background: rgba(255, 252, 246, .78);
}

.achievement-focus-card--empty { grid-column: 1 / -1; min-height: 200rpx; }

.achievement-filter {
  height: 74rpx;
  margin-top: 24rpx;
  padding: 5rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border: 1rpx solid rgba(36, 91, 77, .11);
  border-radius: 22rpx;
  background: rgba(255, 252, 246, .74);
}

.achievement-filter-item {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.achievement-filter-item.is-active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 650;
}

.achievement-section {
  margin-top: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(36, 91, 77, .1);
  border-radius: 24rpx;
  background: rgba(255, 252, 246, .92);
}

.achievement-section-head {
  min-height: 92rpx;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-bottom: 1rpx solid rgba(36, 91, 77, .08);
}

.achievement-section-heading { min-width: 0; display: flex; align-items: center; gap: 14rpx; }

.achievement-section-icon {
  width: 36rpx;
  height: 36rpx;
  flex: none;
}

.achievement-section-title {
  color: var(--color-primary-dark);
  font-family: var(--font-family-brand);
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.achievement-section-subtitle {
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--color-text-secondary);
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.achievement-section-count { flex: none; display: flex; align-items: center; gap: 5rpx; color: var(--color-text-secondary); font-family: var(--font-family-numeric); font-size: 20rpx; }
.achievement-section-count text { color: var(--color-primary); font-size: 25rpx; font-weight: 650; }
.achievement-section-count .achievement-section-count-label { margin-left: 2rpx; color: var(--color-text-secondary); font-family: var(--font-family-sans); font-size: 17rpx; font-weight: 400; }

.achievement-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }

.achievement-card {
  position: relative;
  min-width: 0;
  min-height: 220rpx;
  padding: 18rpx 10rpx 16rpx;
  overflow: hidden;
  border-right: 1rpx solid rgba(36, 91, 77, .08);
  background: rgba(255, 252, 246, .66);
  text-align: center;
}

.achievement-card:last-child { border-right: 0; }
.achievement-card.is-locked { background: rgba(247, 246, 240, .72); }
.achievement-card.is-near { background: rgba(242, 235, 214, .34); }

.achievement-badge-shell {
  position: relative;
  width: 86rpx;
  height: 86rpx;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e9f0ec;
}

.tier-gold .achievement-badge-shell { background: #f3ead4; }

.achievement-badge-ring { position: absolute; inset: 5rpx; border: 1rpx solid rgba(36, 91, 77, .15); border-radius: 50%; }
.achievement-badge-image { position: relative; width: 74rpx; height: 74rpx; }
.is-locked .achievement-badge-image { opacity: .32; filter: grayscale(1); }

.achievement-state-icon {
  position: absolute;
  right: -3rpx;
  bottom: -1rpx;
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fffcf6;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
}

.is-locked .achievement-state-icon { background: #848c88; }

.achievement-card-copy { min-width: 0; }

.achievement-card-title {
  margin-top: 12rpx;
  overflow: hidden;
  color: #29483e;
  font-family: var(--font-family-brand);
  font-size: 23rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.is-locked .achievement-card-title { color: #626e68; }

.achievement-card-description {
  margin-top: 5rpx;
  display: -webkit-box;
  overflow: hidden;
  color: #7b827e;
  font-size: 17rpx;
  line-height: 25rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.achievement-card-status {
  margin-top: 10rpx;
  overflow: hidden;
  color: #8a682f;
  font-family: var(--font-family-numeric);
  font-size: 16rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.is-locked .achievement-card-status { color: #69746f; }
.achievement-card-track { height: 5rpx; margin: 9rpx 7rpx 0; border-radius: 3rpx; }
.achievement-card-arrow { display: none; }

.achievement-empty {
  margin-top: 24rpx;
  padding: 52rpx 32rpx;
  border: 1rpx solid rgba(36, 91, 77, .08);
  border-radius: 24rpx;
  background: rgba(255, 252, 246, .72);
  text-align: center;
}

.achievement-empty-title { color: var(--color-text-main); font-size: 26rpx; font-weight: 600; }
.achievement-empty-copy { margin-top: 10rpx; color: var(--color-text-secondary); font-size: 21rpx; line-height: 34rpx; }
.achievement-empty .achievement-outline-action { margin-right: auto; margin-left: auto; }

.achievement-memory-card {
  min-height: 86rpx;
  margin-top: 24rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  gap: 15rpx;
  border: 1rpx solid rgba(200, 155, 74, .28);
  border-radius: 20rpx;
  background: rgba(255, 252, 246, .86);
}

.achievement-memory-icon {
  width: 48rpx;
  height: 48rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(200, 155, 74, .38);
  border-radius: 11rpx;
  color: #8a682f;
}

.achievement-memory-copy { min-width: 0; flex: 1; color: #29483e; font-size: 23rpx; }
.achievement-memory-copy text { margin-top: 3rpx; display: block; color: var(--color-text-secondary); font-size: 18rpx; }
.achievement-memory-action { flex: none; }

.achievement-bottom-copy {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 13rpx;
  color: #8c948f;
  font-family: var(--font-family-brand);
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.achievement-bottom-copy text { width: 62rpx; height: 1rpx; background: rgba(200, 155, 74, .38); }

.achievement-detail-layer,
.achievement-celebration { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; }
.achievement-detail-mask,
.achievement-celebration-mask { position: absolute; inset: 0; background: rgba(19, 39, 32, .46); }

.achievement-detail-panel {
  position: relative;
  width: 100%;
  max-height: 86vh;
  padding: 18rpx 0 calc(28rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  border-radius: 34rpx 34rpx 0 0;
  background: #f7f3ea;
  box-shadow: 0 -16rpx 44rpx rgba(20, 48, 39, .14);
}

.achievement-detail-handle { width: 72rpx; height: 7rpx; margin: 0 auto; border-radius: 4rpx; background: #d5ded8; }
.achievement-detail-close { position: absolute; z-index: 2; top: 18rpx; right: 24rpx; width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; color: #52665d; }
.achievement-detail-scroll { max-height: calc(86vh - 48rpx); }
.achievement-detail-content { padding: 24rpx 40rpx 12rpx; text-align: center; }

.achievement-detail-badge {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  margin: 4rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e2ece7;
}

.achievement-detail-badge.tier-gold { background: #f2e6c8; }
.achievement-detail-badge image { position: relative; z-index: 1; width: 150rpx; height: 150rpx; }
.achievement-detail-badge.is-locked image { opacity: .32; filter: grayscale(1); }
.achievement-detail-aura { position: absolute; inset: 10rpx; border: 1rpx solid rgba(36, 91, 77, .15); border-radius: 50%; }
.achievement-detail-status { margin-top: 18rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; color: #8b682f; font-size: 21rpx; font-weight: 650; }
.achievement-detail-title { margin-top: 9rpx; color: #24312d; font-family: var(--font-family-brand); font-size: 36rpx; font-weight: 650; }
.achievement-detail-description { margin-top: 10rpx; color: #66776f; font-size: 24rpx; line-height: 38rpx; }
.achievement-earned-date { display: inline-flex; margin-top: 20rpx; padding: 10rpx 20rpx; border-radius: 22rpx; background: #f2e6c8; color: #8b6827; font-size: 21rpx; }
.achievement-detail-progress-row { margin-top: 26rpx; display: flex; justify-content: space-between; color: #52665d; font-size: 21rpx; }
.achievement-detail-track { height: 10rpx; margin-top: 10rpx; border-radius: 5rpx; }
.achievement-detail-remaining { margin-top: 11rpx; color: #356859; font-size: 22rpx; }
.achievement-detail-note { margin-top: 24rpx; padding: 18rpx; display: flex; align-items: flex-start; gap: 10rpx; border-radius: 18rpx; background: #edf2ef; color: #6f7d76; font-size: 20rpx; line-height: 31rpx; text-align: left; }
.achievement-detail-action,
.achievement-celebration-button { height: 84rpx; margin-top: 22rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: var(--color-action-primary); color: #fff; font-size: 25rpx; font-weight: 650; }

.achievement-celebration { z-index: 40; align-items: center; justify-content: center; padding: 36rpx; }

.achievement-celebration-card {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-width: 620rpx;
  padding: 42rpx 38rpx 34rpx;
  border: 1rpx solid rgba(200, 155, 74, .34);
  border-radius: 30rpx;
  background: #fffdf8;
  text-align: center;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, .2);
}

.achievement-celebration-seal { position: absolute; top: 28rpx; right: 28rpx; width: 45rpx; height: 45rpx; border-radius: 6rpx; font-size: 18rpx; }
.achievement-reveal { width: 168rpx; height: 168rpx; margin: 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #e2ece7; }
.achievement-reveal.tier-gold { background: #f2e6c8; }
.achievement-reveal image { width: 146rpx; height: 146rpx; }
.achievement-celebration-kicker { margin-top: 22rpx; color: #8b682f; font-family: var(--font-family-brand); font-size: 21rpx; letter-spacing: 1rpx; }
.achievement-celebration-title { margin-top: 9rpx; font-family: var(--font-family-brand); font-size: 38rpx; font-weight: 650; }
.achievement-celebration-copy { margin-top: 10rpx; color: #66776f; font-size: 23rpx; line-height: 34rpx; }
.achievement-celebration-date { margin-top: 10rpx; color: #999f9b; font-family: var(--font-family-numeric); font-size: 19rpx; }

/* Semantic type roles keep achievement content encouraging but restrained. */
.achievement-nav-title { font-size: var(--font-page-title); line-height: var(--line-height-page-title); }
.achievement-state-title,
.achievement-empty-title { font-size: var(--font-card-title); line-height: var(--line-height-card-title); }
.achievement-state-copy,
.achievement-empty-copy,
.achievement-detail-description,
.achievement-detail-note,
.achievement-celebration-copy { font-size: var(--font-caption); line-height: var(--line-height-caption); }
.achievement-state-action,
.achievement-text-action,
.achievement-outline-action,
.achievement-memory-action,
.achievement-celebration-button { font-size: var(--font-body-strong); line-height: var(--line-height-body-strong); }
.achievement-hero-number { font-size: var(--font-data-hero); line-height: var(--line-height-data); }
.achievement-hero-unit,
.achievement-hero-unit text:last-child,
.achievement-focus-meta,
.achievement-section-subtitle,
.achievement-section-count .achievement-section-count-label,
.achievement-memory-copy text,
.achievement-celebration-date { font-size: var(--font-meta); line-height: var(--line-height-meta); }
.achievement-hero-message,
.achievement-focus-note,
.achievement-memory-copy,
.achievement-detail-progress-row,
.achievement-detail-remaining { font-size: var(--font-body); line-height: var(--line-height-body); }
.achievement-stage,
.achievement-detail-status,
.achievement-earned-date,
.achievement-detail-status,
.achievement-section-count,
.achievement-section-count text { font-size: var(--font-tag); line-height: var(--line-height-tag); }
.achievement-focus-kicker,
.achievement-filter-item,
.achievement-section-title,
.achievement-detail-title,
.achievement-celebration-title { font-size: var(--font-card-title); line-height: var(--line-height-card-title); }
.achievement-focus-title { font-size: var(--font-card-title); line-height: var(--line-height-card-title); }
.achievement-section-count text { font-size: var(--font-body-strong); line-height: var(--line-height-body-strong); }

@media (max-width: 350px) {
  .achievement-nav-title { font-size: var(--font-page-title-compact); line-height: var(--line-height-page-title); }
  .achievement-state-title,
  .achievement-empty-title,
  .achievement-focus-kicker,
  .achievement-filter-item,
  .achievement-section-title,
  .achievement-detail-title,
  .achievement-celebration-title,
  .achievement-focus-title { font-size: var(--font-card-title-compact); line-height: var(--line-height-card-title); }
  .achievement-state-copy,
  .achievement-empty-copy,
  .achievement-detail-description,
  .achievement-detail-note,
  .achievement-celebration-copy { font-size: var(--font-caption-compact); line-height: var(--line-height-caption); }
  .achievement-hero-unit,
  .achievement-hero-unit text:last-child,
  .achievement-focus-meta,
  .achievement-section-subtitle,
  .achievement-section-count .achievement-section-count-label,
  .achievement-memory-copy text,
  .achievement-celebration-date { font-size: var(--font-meta-compact); line-height: var(--line-height-meta); }
  .achievement-stage,
  .achievement-detail-status,
  .achievement-earned-date { font-size: var(--font-tag-compact); line-height: var(--line-height-tag); }
  .achievement-hero-number { font-size: var(--font-data-compact); line-height: var(--line-height-data); }
}

.is-pressed { opacity: .74; transform: scale(.992); }

@media (max-width: 350px) {
  .achievement-content { padding-right: 22rpx; padding-left: 22rpx; }
  .achievement-hero { min-height: 272rpx; padding-right: 24rpx; padding-left: 24rpx; }
  .achievement-signature { right: 17rpx; width: 178rpx; height: 178rpx; }
  .achievement-signature image { width: 144rpx; height: 144rpx; }
  .achievement-focus-row { grid-template-columns: 1fr; }
  .achievement-focus-card { min-height: 236rpx; }
  .achievement-badge-shell { width: 74rpx; height: 74rpx; }
  .achievement-badge-image { width: 64rpx; height: 64rpx; }
  .achievement-card { min-height: 210rpx; padding-right: 6rpx; padding-left: 6rpx; }
  .achievement-section-subtitle { max-width: 310rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .is-pressed { transform: none; }
}
