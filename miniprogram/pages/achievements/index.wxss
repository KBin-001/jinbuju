page { height: 100%; overflow: hidden; background: #F4F5EE; }
.achievement-page { position: relative; box-sizing: border-box; display: flex; flex-direction: column; width: 100%; height: 100vh; overflow: hidden; background: linear-gradient(180deg, #F8F5EB 0%, #F1F5EE 48%, #F6F7F3 100%); color: #233B34; }
.achievement-ambient { position: absolute; border-radius: 50%; pointer-events: none; filter: blur(10rpx); }
.achievement-ambient--one { width: 420rpx; height: 420rpx; top: -210rpx; right: -180rpx; background: rgba(244, 201, 93, 0.18); }
.achievement-ambient--two { width: 460rpx; height: 460rpx; top: 520rpx; left: -300rpx; background: rgba(91, 150, 119, 0.14); }
.achievement-nav { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; height: 92rpx; padding: 0 28rpx; flex: 0 0 auto; }
.achievement-back, .achievement-nav-space { width: 68rpx; height: 68rpx; flex: 0 0 auto; }
.achievement-back { display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(53,104,89,.08); border-radius: 50%; background: rgba(255,255,255,.62); color: #2C5C4D; font-size: 52rpx; line-height: 60rpx; box-shadow: 0 8rpx 22rpx rgba(31,70,58,.06); }
.achievement-nav-title { color: #1F453A; font-size: 31rpx; font-weight: 800; letter-spacing: 1rpx; }
.achievement-scroll { position: relative; z-index: 1; min-height: 0; flex: 1; }
.achievement-content { padding: 18rpx 28rpx calc(80rpx + env(safe-area-inset-bottom)); }
.achievement-hero { position: relative; box-sizing: border-box; min-height: 330rpx; padding: 34rpx; overflow: hidden; border: 1rpx solid rgba(255,255,255,.72); border-radius: 34rpx; background: linear-gradient(140deg, #244F43 0%, #356859 58%, #6B8E73 100%); color: #FFFFFF; box-shadow: 0 20rpx 50rpx rgba(31,70,58,.17); }
.achievement-hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(110deg, rgba(255,255,255,.10), transparent 44%, rgba(248,210,106,.10)); pointer-events: none; }
.achievement-hero-kicker { position: relative; z-index: 2; color: #F4D98D; font-size: 19rpx; font-weight: 800; letter-spacing: 4rpx; }
.achievement-hero-title { position: relative; z-index: 2; margin-top: 18rpx; font-size: 38rpx; font-weight: 800; line-height: 50rpx; }
.achievement-hero-copy { position: relative; z-index: 2; width: 78%; margin-top: 12rpx; color: rgba(255,255,255,.76); font-size: 23rpx; line-height: 36rpx; }
.achievement-hero-summary { position: relative; z-index: 2; display: flex; align-items: flex-end; justify-content: space-between; margin-top: 28rpx; }
.achievement-hero-number { color: #FFE39A; font-size: 52rpx; font-weight: 850; line-height: 58rpx; }
.achievement-hero-total, .achievement-hero-percent { color: rgba(255,255,255,.82); font-size: 22rpx; font-weight: 700; }
.achievement-hero-track { position: relative; z-index: 2; height: 14rpx; margin-top: 13rpx; overflow: hidden; border-radius: 7rpx; background: rgba(255,255,255,.16); }
.achievement-hero-fill { height: 100%; border-radius: 7rpx; background: linear-gradient(90deg, #F8D26A, #FFF0B2); box-shadow: 0 0 16rpx rgba(248,210,106,.35); }
.achievement-hero-orbit { position: absolute; width: 200rpx; height: 200rpx; top: -48rpx; right: -36rpx; border: 2rpx solid rgba(255,235,174,.18); border-radius: 50%; box-shadow: 0 0 0 28rpx rgba(255,255,255,.025), 0 0 0 58rpx rgba(255,255,255,.018); }
.achievement-hero-star { position: absolute; top: 56rpx; right: 52rpx; color: rgba(255,226,140,.72); font-size: 52rpx; }
.achievement-section { margin-top: 42rpx; }
.achievement-section-head { display: flex; align-items: flex-end; justify-content: space-between; padding: 0 4rpx 18rpx; }
.achievement-section-title { color: #213F36; font-size: 30rpx; font-weight: 800; }
.achievement-section-subtitle { margin-top: 5rpx; color: #7A8A82; font-size: 20rpx; }
.achievement-section-count { padding: 8rpx 15rpx; border-radius: 18rpx; background: rgba(234,245,239,.88); color: #356859; font-size: 19rpx; font-weight: 800; }
.achievement-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18rpx; }
.achievement-card { box-sizing: border-box; min-width: 0; min-height: 230rpx; padding: 18rpx 10rpx 16rpx; border: 1rpx solid rgba(255,255,255,.88); border-radius: 26rpx; background: rgba(255,255,255,.74); text-align: center; box-shadow: inset 0 1rpx 0 rgba(255,255,255,.95), 0 12rpx 28rpx rgba(31,70,58,.065); backdrop-filter: blur(18rpx); -webkit-backdrop-filter: blur(18rpx); }
.achievement-card.is-unlocked { border-color: rgba(214,177,83,.24); background: linear-gradient(150deg, rgba(255,255,252,.94), rgba(247,245,232,.90)); }
.achievement-badge-shell { position: relative; display: flex; align-items: center; justify-content: center; width: 116rpx; height: 116rpx; margin: 0 auto; border-radius: 38rpx; }
.accent-sprout { background: radial-gradient(circle, rgba(226,242,229,.95), rgba(204,226,208,.54)); }
.accent-jade { background: radial-gradient(circle, rgba(216,235,224,.95), rgba(166,204,181,.45)); }
.accent-gold, .accent-sun { background: radial-gradient(circle, rgba(255,243,203,.98), rgba(239,208,126,.45)); }
.accent-mist { background: radial-gradient(circle, rgba(235,241,237,.98), rgba(207,221,212,.5)); }
.achievement-badge-image { width: 102rpx; height: 102rpx; filter: drop-shadow(0 8rpx 10rpx rgba(31,70,58,.12)); }
.achievement-card.is-locked .achievement-badge-image { opacity: .30; filter: grayscale(1); }
.achievement-lock { position: absolute; right: 6rpx; bottom: 5rpx; display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; border: 2rpx solid #FFFFFF; border-radius: 50%; background: #88958F; color: #FFFFFF; font-size: 19rpx; font-weight: 800; }
.achievement-card-title { margin-top: 10rpx; overflow: hidden; color: #29483E; font-size: 22rpx; font-weight: 800; line-height: 30rpx; text-overflow: ellipsis; white-space: nowrap; }
.achievement-card.is-locked .achievement-card-title { color: #76847D; }
.achievement-card-progress { margin-top: 5rpx; color: #8B9691; font-size: 17rpx; line-height: 24rpx; }
.achievement-card.is-unlocked .achievement-card-progress { color: #B18435; font-weight: 700; }
.achievement-bottom-copy { margin-top: 52rpx; color: #8A9690; font-size: 20rpx; text-align: center; }
.achievement-detail-layer { position: fixed; inset: 0; z-index: 20; display: flex; align-items: flex-end; }
.achievement-detail-mask { position: absolute; inset: 0; background: rgba(19,39,32,.42); backdrop-filter: blur(8rpx); -webkit-backdrop-filter: blur(8rpx); }
.achievement-detail-panel { position: relative; box-sizing: border-box; width: 100%; min-height: 650rpx; padding: 28rpx 42rpx calc(42rpx + env(safe-area-inset-bottom)); border-radius: 44rpx 44rpx 0 0; background: linear-gradient(165deg, #FFFEF9 0%, #F2F6F0 100%); text-align: center; box-shadow: 0 -20rpx 50rpx rgba(20,48,39,.16); animation: achievement-rise .26s ease-out; }
.achievement-detail-handle { width: 78rpx; height: 8rpx; margin: 0 auto; border-radius: 4rpx; background: #D5DED8; }
.achievement-detail-close { position: absolute; top: 28rpx; right: 30rpx; display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 50%; background: rgba(230,238,233,.8); color: #587066; font-size: 36rpx; }
.achievement-detail-badge { display: flex; align-items: center; justify-content: center; width: 230rpx; height: 230rpx; margin: 30rpx auto 0; border-radius: 72rpx; }
.achievement-detail-badge image { width: 205rpx; height: 205rpx; filter: drop-shadow(0 16rpx 18rpx rgba(31,70,58,.17)); }
.achievement-detail-badge.is-locked image { opacity: .34; filter: grayscale(1); }
.achievement-detail-status { margin-top: 18rpx; color: #B1883C; font-size: 20rpx; font-weight: 800; letter-spacing: 1rpx; }
.achievement-detail-title { margin-top: 10rpx; color: #1F453A; font-size: 38rpx; font-weight: 850; }
.achievement-detail-description { margin-top: 12rpx; color: #66776F; font-size: 24rpx; line-height: 38rpx; }
.achievement-earned-date { display: inline-flex; margin-top: 22rpx; padding: 12rpx 22rpx; border-radius: 24rpx; background: #FFF1C8; color: #8B6827; font-size: 21rpx; font-weight: 700; }
.achievement-detail-progress-row { display: flex; justify-content: space-between; margin-top: 28rpx; color: #52665D; font-size: 21rpx; font-weight: 700; }
.achievement-detail-track { height: 14rpx; margin-top: 12rpx; overflow: hidden; border-radius: 7rpx; background: #E2EAE5; }
.achievement-detail-track view { height: 100%; border-radius: 7rpx; background: linear-gradient(90deg, #356859, #8DB184, #D6B25D); }
.achievement-detail-remaining { margin-top: 12rpx; color: #356859; font-size: 22rpx; font-weight: 700; }
.achievement-detail-note { margin-top: 30rpx; padding-top: 24rpx; border-top: 1rpx solid #E3EAE5; color: #87928D; font-size: 20rpx; line-height: 32rpx; }
.is-pressed { opacity: .76; transform: scale(.98); }
@keyframes achievement-rise { from { opacity: 0; transform: translateY(80rpx); } to { opacity: 1; transform: translateY(0); } }
@media (max-width: 350px) { .achievement-content { padding-right: 22rpx; padding-left: 22rpx; } .achievement-grid { gap: 12rpx; } .achievement-card { min-height: 210rpx; padding-right: 6rpx; padding-left: 6rpx; } .achievement-badge-shell { width: 102rpx; height: 102rpx; } .achievement-badge-image { width: 90rpx; height: 90rpx; } .achievement-card-title { font-size: 20rpx; } }
