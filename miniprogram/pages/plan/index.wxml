<view class="page progress-page" data-theme="{{appTheme}}">
  <view wx:if="{{status === 'loading'}}" class="state-card">
    <view class="state-orbit"></view>
    <view class="state-title">正在整理成长记录</view>
    <view class="state-description">把最近的行动、投入和里程碑收拢到一起。</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="state-card">
    <view class="state-mark">!</view>
    <view class="state-title">进度读取失败</view>
    <view class="state-description">{{errorMessage}}</view>
    <button class="primary-action" bindtap="retry">重新加载</button>
  </view>

  <view wx:elif="{{!goal}}" class="state-card">
    <view class="state-mark">0</view>
    <view class="state-title">还没有当前目标</view>
    <view class="state-description">创建目标后，这里会记录你的完成率、趋势和成长里程碑。</view>
    <button class="primary-action" bindtap="createGoal">创建目标</button>
  </view>

  <block wx:else>
    <view class="progress-header">
      <view class="page-title">我的进度</view>
      <view class="page-subtitle">记录每一次坚持，看见长期变化</view>
    </view>

    <view class="goal-card" bindtap="openGoalPicker">
      <view class="goal-card-main">
        <view class="goal-copy">
          <view class="section-eyebrow">当前目标</view>
          <view class="goal-title">{{goal.title}}</view>
          <view class="goal-meta-row">
            <view class="level-chip">{{levelLabel}}</view>
            <view class="status-chip">{{goalStatusText}}</view>
          </view>
          <view class="goal-period">{{goalPeriod}}</view>
        </view>

        <view wx:if="{{goalOptions.length > 1}}" class="goal-switch-button" catchtap="openGoalPicker">
          <text>切换目标</text>
          <view class="goal-switch-arrow"></view>
        </view>

        <view wx:else class="medal {{medalState.achieved ? 'is-achieved' : ''}}">
          <view class="medal-spark spark-a"></view>
          <view class="medal-spark spark-b"></view>
          <view class="medal-leaf leaf-left"></view>
          <view class="medal-leaf leaf-right"></view>
          <view class="medal-face">
            <view class="medal-star">★</view>
          </view>
          <view class="medal-ribbon"></view>
        </view>
      </view>
    </view>

    <view wx:if="{{goalPickerVisible}}" class="goal-picker-layer" catchtouchmove="noop">
      <view class="goal-picker-mask" catchtap="closeGoalPicker"></view>
      <view class="goal-picker-panel" catchtap="noop">
        <view class="goal-picker-grabber"></view>
        <view class="goal-picker-header">
          <view>
            <view class="goal-picker-kicker">FOCUS GOAL</view>
            <view class="goal-picker-title">切换当前聚焦目标</view>
          </view>
          <view class="goal-picker-close" catchtap="closeGoalPicker">×</view>
        </view>
        <view class="goal-picker-list">
          <view
            wx:for="{{goalOptions}}"
            wx:key="id"
            class="goal-option {{item.active ? 'is-active' : ''}}"
            data-id="{{item.id}}"
            catchtap="switchGoal"
          >
            <view class="goal-option-main">
              <view class="goal-option-title">{{item.title}}</view>
              <view class="goal-option-meta">
                <text>{{item.progressPercent}}%</text>
                <text>{{item.statusText}}</text>
              </view>
              <view class="goal-option-track">
                <view class="goal-option-fill" style="width: {{item.progressPercent}}%;"></view>
              </view>
            </view>
            <view class="goal-option-action">{{item.active ? '当前' : '切换'}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="overview-card">
      <view class="card-title-row">
        <view>
          <view class="card-title">进度总览</view>
          <view class="card-subtitle">用行动完成率记录真实推进</view>
        </view>
      </view>
      <view class="overview-grid">
        <view wx:for="{{overviewStats}}" wx:key="label" class="overview-item">
          <view class="overview-value">{{item.value}}<text>{{item.unit}}</text></view>
          <view class="overview-label">{{item.label}}</view>
        </view>
      </view>
    </view>

    <view class="trend-card">
      <view class="card-title-row">
        <view>
          <view class="card-title">投入趋势</view>
          <view class="card-subtitle">按投入分钟观察最近节奏</view>
        </view>
        <view class="trend-range-tabs">
          <view
            wx:for="{{trendRanges}}"
            wx:key="key"
            class="trend-range-tab {{item.active ? 'is-active' : ''}}"
            data-key="{{item.key}}"
            bindtap="switchTrendRange"
          >{{item.label}}</view>
        </view>
      </view>

      <!-- 周 / 月 柱状图 -->
      <block wx:if="{{trendRange !== 'year'}}">
        <view class="trend-metric-panel">
          <view class="trend-metric-item">
            <view class="trend-metric-row">
              <view class="metric-icon metric-clock"></view>
              <view class="trend-metric-name">{{trendRange === 'week' ? '本周投入' : '本月投入'}}</view>
            </view>
            <view class="trend-metric-value">{{trendSummary.totalMinutes}}<text>分钟</text></view>
            <view class="trend-metric-compare compare-{{trendSummary.compareTone}}">{{trendSummary.compareText}}</view>
          </view>
          <view class="trend-metric-divider"></view>
          <view class="trend-metric-item">
            <view class="trend-metric-row">
              <view class="metric-icon metric-check"></view>
              <view class="trend-metric-name">完成行动</view>
            </view>
            <view class="trend-metric-value">{{trendSummary.totalActions}}<text>项</text></view>
            <view class="trend-metric-compare">完成率 <text>{{trendSummary.completionRate}}%</text></view>
          </view>
        </view>

        <view wx:if="{{trendSummary.insufficient}}" class="trend-insufficient">
          {{trendSummary.summaryText}}
        </view>

        <block wx:else>
          <view class="chart-title-row">
            <view class="chart-title">投入分钟数</view>
            <view class="chart-legend">
              <view class="legend-line"></view>
              <text>趋势线</text>
            </view>
          </view>
          <view class="bar-chart" bindtap="onChartBackdropTap">
            <view class="bar-y-axis">
              <text>{{barChart.maxLabel}}</text>
              <text>{{barChart.midLabel}}</text>
              <text>0</text>
            </view>
            <view class="bar-area">
              <view class="bar-grid">
                <view></view>
                <view></view>
                <view></view>
                <view></view>
              </view>
              <view class="bar-columns">
                <view
                  wx:for="{{barChart.bars}}"
                  wx:key="key"
                  class="bar-column {{item.active ? 'is-active' : ''}}"
                  catchtap="onBarTap"
                  data-key="{{item.key}}"
                >
                  <view wx:if="{{item.active}}" class="bar-tooltip tooltip-{{item.tooltipAlign}}" style="bottom: calc({{item.heightPercent}}% + 12rpx);">
                    <view>{{item.minutes}} 分钟</view>
                    <text>{{item.actions}} 项完成</text>
                  </view>
                  <view
                    class="bar-fill {{item.isMax ? 'is-max' : ''}} {{item.isToday ? 'is-today' : ''}}"
                    style="width: {{barChart.barWidth}}rpx; height: {{item.heightPercent}}%;"
                  ></view>
                </view>
              </view>
              <canvas wx:if="{{!goalPickerVisible}}" type="2d" id="trendLine" class="line-canvas"></canvas>
            </view>
          </view>
          <view class="bar-labels">
            <text wx:for="{{barChart.bars}}" wx:key="key">{{item.label}}</text>
          </view>
        </block>

        <view class="ai-coach-card">
          <view class="ai-coach-head">
            <view class="ai-coach-title-wrap">
              <view class="ai-coach-icon">✦</view>
              <view class="ai-coach-title">AI 进度教练</view>
            </view>
            <view class="ai-coach-period">{{aiCoach.periodLabel}}</view>
          </view>
          <view class="ai-coach-point">
            <text class="ai-coach-point-icon">↗</text>
            <text>{{aiCoach.summary}}</text>
          </view>
          <view class="ai-coach-point ai-coach-point-warning">
            <text class="ai-coach-point-icon">!</text>
            <text>{{aiCoach.suggestion}}</text>
          </view>
          <view class="ai-coach-action">查看完整分析与建议 →</view>
        </view>

        <view class="trend-stats-grid">
          <view class="trend-stat-item">
            <view class="trend-stat-icon stat-bars"></view>
            <view class="trend-stat-label">日均投入</view>
            <view class="trend-stat-value">{{trendSummary.avgMinutes}}<text>分钟</text></view>
          </view>
          <view class="trend-stat-item">
            <view class="trend-stat-icon stat-pie"></view>
            <view class="trend-stat-label">完成率</view>
            <view class="trend-stat-value">{{trendSummary.completionRate}}<text>%</text></view>
          </view>
          <view class="trend-stat-item">
            <view class="trend-stat-icon stat-fire"></view>
            <view class="trend-stat-label">连续坚持</view>
            <view class="trend-stat-value">{{trendSummary.streakDays}}<text>天</text></view>
          </view>
          <view class="trend-stat-item">
            <view class="trend-stat-icon stat-calendar"></view>
            <view class="trend-stat-label">最佳投入日</view>
            <view class="trend-stat-value">{{trendSummary.bestInvestLabel}}</view>
          </view>
        </view>
      </block>

      <!-- 年 热力图 -->
      <block wx:else>
        <view class="year-top-stats">
          <view class="year-stat-item">
            <view class="year-stat-value">{{yearSummary.checkinDays}}<text>天</text></view>
            <view class="year-stat-label">打卡</view>
          </view>
          <view class="year-stat-divider"></view>
          <view class="year-stat-item">
            <view class="year-stat-value">{{yearSummary.totalMinutes}}<text>分钟</text></view>
            <view class="year-stat-label">累计投入</view>
          </view>
          <view class="year-stat-divider"></view>
          <view class="year-stat-item">
            <view class="year-stat-value">{{yearSummary.maxStreakDays}}<text>天</text></view>
            <view class="year-stat-label">最长连续</view>
          </view>
        </view>

        <scroll-view scroll-x class="heatmap-scroll" enhanced show-scrollbar="{{false}}">
          <view class="heatmap-inner">
            <view class="heatmap-months-row">
              <view class="heatmap-weekday-spacer"></view>
              <view class="heatmap-months">
                <text
                  wx:for="{{heatmapMonthLabels}}"
                  wx:key="label"
                  class="heatmap-month-label"
                  style="left: {{item.left}}rpx;"
                >{{item.label}}</text>
              </view>
            </view>
            <view class="heatmap-body-row">
              <view class="heatmap-weekdays">
                <text class="heatmap-weekday" style="top: 0;">一</text>
                <text class="heatmap-weekday" style="top: 38rpx;">三</text>
                <text class="heatmap-weekday" style="top: 76rpx;">五</text>
              </view>
              <view class="heatmap-grid">
                <view
                  wx:for="{{heatmapWeeks}}"
                  wx:for-item="week"
                  wx:for-index="weekIndex"
                  wx:key="weekIndex"
                  class="heatmap-column"
                >
                  <view
                    wx:for="{{week.days}}"
                    wx:for-item="day"
                    wx:for-index="dayIndex"
                    wx:key="date"
                    class="heatmap-cell level-{{day.level}} {{day.active ? 'is-active' : ''}} {{day.isEmpty ? 'is-empty' : ''}} {{day.isFuture ? 'is-future' : ''}}"
                    data-date="{{day.date}}"
                    catchtap="onHeatmapDayTap"
                  ></view>
                </view>
              </view>
            </view>
          </view>
        </scroll-view>

        <view wx:if="{{selectedHeatmapDay}}" class="heatmap-tooltip">
          <view class="heatmap-tooltip-date">{{selectedHeatmapDay.dateLabel}}</view>
          <block wx:if="{{selectedHeatmapDay.hasRecord}}">
            <view class="heatmap-tooltip-row">投入 {{selectedHeatmapDay.minutes}} 分钟</view>
            <text class="heatmap-tooltip-sub">完成 {{selectedHeatmapDay.actions}} 项行动</text>
          </block>
          <text wx:else class="heatmap-tooltip-empty">暂无记录</text>
        </view>

        <view class="heatmap-legend">
          <text class="heatmap-legend-text">少</text>
          <view class="legend-cell level-0"></view>
          <view class="legend-cell level-1"></view>
          <view class="legend-cell level-2"></view>
          <view class="legend-cell level-3"></view>
          <view class="legend-cell level-4"></view>
          <text class="heatmap-legend-text">多</text>
        </view>

        <view class="trend-summary">{{yearSummary.summaryText}}</view>

        <view wx:if="{{yearHighlights.maxDay || yearHighlights.maxStreak || yearHighlights.maxMonth}}" class="year-highlights">
          <view class="highlights-title">年度亮点</view>
          <view class="highlights-grid">
            <view wx:if="{{yearHighlights.maxDay}}" class="highlight-item">
              <view class="highlight-icon highlight-icon-target">◎</view>
              <view class="highlight-date">{{yearHighlights.maxDay.dateLabel}}</view>
              <view class="highlight-label">单日最高 {{yearHighlights.maxDay.minutes}} 分钟</view>
            </view>
            <view wx:if="{{yearHighlights.maxStreak}}" class="highlight-item">
              <view class="highlight-icon highlight-icon-trophy">★</view>
              <view class="highlight-date">{{yearHighlights.maxStreak.dateLabel}}</view>
              <view class="highlight-label">连续打卡 {{yearHighlights.maxStreak.days}} 天</view>
            </view>
            <view wx:if="{{yearHighlights.maxMonth}}" class="highlight-item">
              <view class="highlight-icon highlight-icon-trend">↗</view>
              <view class="highlight-date">{{yearHighlights.maxMonth.month}}</view>
              <view class="highlight-label">投入最多的月份</view>
            </view>
          </view>
        </view>
      </block>
    </view>

    <view class="milestone-card">
      <view class="card-title-row">
        <view>
          <view class="card-title">成长里程碑</view>
          <view class="card-subtitle">{{nextMilestoneText}}</view>
        </view>
      </view>
      <view class="milestone-row">
        <view wx:for="{{milestones}}" wx:key="days" class="milestone-item state-{{item.state}}">
          <view class="milestone-line"></view>
          <view class="mini-medal">
            <view class="mini-medal-face">★</view>
            <view class="mini-medal-ribbon"></view>
          </view>
          <view class="milestone-label">{{item.label}}</view>
          <view class="milestone-status">{{item.statusText}}</view>
        </view>
      </view>
    </view>

    <view class="record-card">
      <view class="card-title-row">
        <view>
          <view class="card-title">最近记录</view>
          <view class="card-subtitle">今天完成了什么</view>
        </view>
        <button class="review-link" bindtap="openHistoryReview">查看历史复盘</button>
      </view>

      <view wx:if="{{recentRecords.length}}" class="record-list">
        <view wx:for="{{recentRecords}}" wx:key="id" class="record-item">
          <view class="record-check">✓</view>
          <view class="record-copy">
            <view class="record-title">{{item.title}}</view>
            <view class="record-meta">{{item.statusText}} · {{item.minutesText}}</view>
          </view>
        </view>
      </view>
      <view wx:else class="record-empty">
        今天还没有完成记录。先完成一项小行动，进度页会替你记下来。
      </view>
    </view>
  </block>
</view>
