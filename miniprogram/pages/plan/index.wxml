<view class="page progress-page">
  <view wx:if="{{status === 'loading'}}" class="card state-card">
    <view class="loading-dot"></view>
    <view class="state-title">正在整理成长档案</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="card state-card">
    <view class="state-mark">!</view>
    <view class="state-title">进度读取失败</view>
    <view class="state-description">{{errorMessage}}</view>
    <button class="primary-button" bindtap="retry">重新加载</button>
  </view>

  <view wx:elif="{{!goal}}" class="card state-card">
    <view class="state-mark">0</view>
    <view class="state-title">还没有行动目标</view>
    <view class="state-description">创建目标后，这里会沉淀你的每次行动。</view>
    <button class="primary-button" bindtap="createGoal">创建目标</button>
  </view>

  <block wx:else>
    <view class="progress-title">我的进度</view>

    <view class="progress-hero">
      <view class="progress-hero-copy">
        <view class="progress-goal-title">{{goal.title}}</view>
        <view class="level-pill">{{levelLabel}}</view>
        <view class="goal-period">{{goalPeriod}}</view>
      </view>
      <view class="hero-trophy">奖</view>
    </view>

    <view class="total-progress">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{completionRate}}%;"></view>
      </view>
      <view class="progress-copy-row">
        <text>{{progressText}}</text>
        <text class="progress-percent">{{completionRate}}%</text>
      </view>
    </view>

    <view class="stats-card">
      <view class="stat-item">
        <view class="stat-value">{{summary.totalActionDays}}<text> 天</text></view>
        <view class="stat-label">坚持天数</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{summary.completedTasks}}<text> / {{summary.totalTasks}}</text></view>
        <view class="stat-label">完成项数</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{todayActualMinutes}}<text> 分钟</text></view>
        <view class="stat-label">今日投入</view>
      </view>
    </view>

    <view class="trend-card">
      <view class="card-head">
        <view class="card-title">成长趋势</view>
      </view>
      <view class="trend-tabs">
        <view
          wx:for="{{trendTabs}}"
          wx:key="key"
          class="trend-tab {{item.active ? 'is-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="switchTrendTab"
        >{{item.label}}</view>
      </view>

      <view class="chart-area">
        <view class="chart-grid">
          <view></view>
          <view></view>
          <view></view>
        </view>
        <view
          wx:for="{{trendSegments}}"
          wx:key="key"
          class="chart-segment"
          style="left: {{item.left}}%; bottom: {{item.bottom}}%; width: {{item.width}}%; transform: rotate({{item.rotate}}deg);"
        ></view>
        <view
          wx:for="{{trendPoints}}"
          wx:key="date"
          class="chart-point {{item.active ? 'is-active' : ''}}"
          style="left: {{item.x}}%; bottom: {{item.y}}%;"
          data-date="{{item.date}}"
          bindtap="selectTrendPoint"
        >
          <view wx:if="{{item.active}}" class="chart-tooltip">{{item.value}} 分钟</view>
        </view>
      </view>
      <view class="chart-labels">
        <text wx:for="{{trendPoints}}" wx:key="date">{{item.label}}</text>
      </view>
    </view>

    <view class="milestone-card">
      <view class="card-title">成长里程碑</view>
      <view class="milestone-row">
        <view wx:for="{{milestones}}" wx:key="days" class="milestone-item {{item.achieved ? 'is-achieved' : ''}} {{item.next ? 'is-next' : ''}}">
          <view class="milestone-line"></view>
          <view class="milestone-icon">奖</view>
          <view class="milestone-bar"></view>
          <view class="milestone-label">{{item.label}}</view>
        </view>
      </view>
    </view>
  </block>
</view>
