<view class="page">
  <view class="page-header">
    <view class="page-eyebrow">一周行动地图</view>
    <view class="page-title">我的计划</view>
    <view class="page-subtitle">聚焦一个目标，完成接下来 7 天。</view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="card state-card">
    <view class="loading-dot"></view>
    <view class="state-title">正在读取计划</view>
    <view class="state-description">正在同步你的目标和进度。</view>
  </view>

  <view wx:elif="{{status === 'empty'}}" class="card state-card">
    <view class="state-mark">7</view>
    <view class="state-title">从一个清晰目标开始</view>
    <view class="state-description">告诉我们你想通过的考试、想掌握的技能，或正在准备的岗位。</view>
    <button class="primary-button" bindtap="createGoal">创建目标</button>
  </view>

  <view wx:elif="{{status === 'error'}}" class="card state-card">
    <view class="state-mark">!</view>
    <view class="state-title">计划加载失败</view>
    <view class="state-description">{{errorMessage}}</view>
    <button class="primary-button" bindtap="retry">重新加载</button>
  </view>

  <view wx:elif="{{status === 'preview'}}" class="card">
    <view class="state-title">计划预览已准备好</view>
    <view class="state-description">你有一份尚未采用的 7 天计划，可以继续查看并确认。</view>
    <button class="primary-button" bindtap="continuePreview">继续查看计划</button>
  </view>

  <view wx:else class="active-plan-card">
    <view class="active-plan-label">进行中的目标</view>
    <view class="active-plan-title">{{currentPlan.goalTitle}}</view>
    <view class="active-plan-summary">{{currentPlan.summary}}</view>

    <view class="plan-detail">
      <view class="plan-detail-label">本周目标</view>
      <view class="plan-detail-value">{{currentPlan.weeklyGoal}}</view>
    </view>
    <view class="plan-date">{{currentPlan.startDate}} 至 {{currentPlan.endDate}}</view>

    <button
      class="delete-button {{deleting ? 'delete-button-disabled' : ''}}"
      loading="{{deleting}}"
      disabled="{{deleting}}"
      bindtap="confirmDelete"
    >删除当前计划</button>
  </view>
</view>
