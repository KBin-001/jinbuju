<view class="page plan-page">
  <view class="page-header">
    <view class="page-eyebrow">长期目标行动记录</view>
    <view class="page-title">进度</view>
    <view class="page-subtitle">看见当前阶段，也看见每一次行动。</view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="card state-card">
    <view class="loading-dot"></view>
    <view class="state-title">正在读取行动进度</view>
    <view class="state-description">正在同步你的目标和进度。</view>
  </view>

  <view wx:elif="{{status === 'empty'}}" class="card state-card">
    <view class="state-mark">1</view>
    <view class="state-title">还没有进行中的目标</view>
    <view class="state-description">创建一个长期目标，开始第一个行动阶段。</view>
    <button class="primary-button" bindtap="createGoal">创建目标</button>
  </view>

  <view wx:elif="{{status === 'error'}}" class="card state-card">
    <view class="state-mark">!</view>
    <view class="state-title">进度加载失败</view>
    <view class="state-description">{{errorMessage}}</view>
    <button class="primary-button" bindtap="retry">重新加载</button>
  </view>

  <view wx:elif="{{status === 'preview'}}" class="card state-card">
    <view class="state-mark">1</view>
    <view class="state-title">行动阶段预览已准备好</view>
    <view class="state-description">确认后就可以开始今天的行动。</view>
    <button class="primary-button" bindtap="continuePreview">继续查看阶段</button>
  </view>

  <block wx:else>
    <view class="card goal-card">
      <view class="goal-heading">
        <view>
          <view class="section-eyebrow">当前目标</view>
          <view class="goal-title">{{pageData.goal.title}}</view>
        </view>
        <view class="category-tag">{{categoryLabel}}</view>
      </view>
      <view class="goal-summary">{{pageData.plan.stageTitle}}</view>
      <view class="weekly-goal">
        <view class="weekly-goal-label">本阶段重点</view>
        <view>{{pageData.plan.focus}}</view>
      </view>
      <view class="goal-grid">
        <view class="goal-grid-item">
          <view class="goal-grid-value">第 {{pageData.plan.currentDay}} / {{pageData.plan.totalDays}} 天</view>
          <view class="goal-grid-label">{{pageData.plan.startDate}} 至 {{pageData.plan.endDate}}</view>
        </view>
        <view class="goal-grid-item">
          <view class="status-badge status-{{pageData.plan.status}}">{{planStatusLabel}}</view>
          <view class="goal-grid-label">当前阶段状态</view>
        </view>
      </view>
      <view class="time-row">
        <view>
          <view class="time-label">每日行动时间</view>
          <view class="time-value">{{pageData.plan.dailyReminderTime}}</view>
        </view>
        <picker
          mode="time"
          value="{{pageData.plan.dailyReminderTime}}"
          disabled="{{actionLoading !== '' || (pageData.plan.status !== 'active' && pageData.plan.status !== 'paused')}}"
          bindchange="changePlanTime"
        >
          <view class="outline-button">修改时间</view>
        </picker>
      </view>
    </view>

    <view wx:if="{{pageData.plan.status === 'paused'}}" class="paused-notice">
      <view class="paused-title">当前阶段已暂停</view>
      <view>行动会继续保留，暂停期间不能记录或顺延。</view>
    </view>

    <view class="card progress-card">
      <view class="section-heading">
        <view>
          <view class="section-eyebrow">阶段完成率</view>
          <view class="progress-count">{{pageData.plan.completedCount}} / {{pageData.plan.totalCount}} 项完成</view>
        </view>
        <view class="progress-rate">{{pageData.plan.completionRate}}%</view>
      </view>
      <view
        class="progress-track"
        aria-role="progressbar"
        aria-label="阶段行动完成 {{pageData.plan.completionRate}}%"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="{{pageData.plan.completionRate}}"
      >
        <view class="progress-fill" style="width: {{pageData.plan.completionRate}}%;"></view>
      </view>
      <view class="progress-copy">{{progressText}}</view>
      <view class="action-stats">
        <view class="action-stat">
          <view class="action-stat-value">{{pageData.progress.streakDays}}</view>
          <view class="action-stat-label">连续行动天数</view>
        </view>
        <view class="action-stat">
          <view class="action-stat-value">{{pageData.progress.totalActionDays}}</view>
          <view class="action-stat-label">累计行动天数</view>
        </view>
      </view>
    </view>

    <view class="timeline-section">
      <view class="section-title">近 7 天行动</view>
      <view class="recent-grid">
        <view wx:for="{{recentDays}}" wx:key="date" class="recent-day recent-{{item.status}}">
          <view class="recent-date">{{item.monthDay}}</view>
          <view class="recent-status">{{item.isToday ? '今天' : item.statusLabel}}</view>
          <view class="recent-count">{{item.completedCount}} / {{item.totalCount}}</view>
        </view>
      </view>
    </view>

    <view class="timeline-section">
      <view class="section-title">阶段每日行动概览</view>
      <scroll-view class="timeline-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="timeline-row">
          <button
            wx:for="{{days}}"
            wx:key="date"
            class="day-chip day-{{item.status}} {{selectedDate === item.date ? 'day-selected' : ''}}"
            data-date="{{item.date}}"
            bindtap="selectDay"
            aria-label="第 {{item.day}} 天，{{item.monthDay}}，{{item.statusLabel}}，完成 {{item.completedCount}} / {{item.totalCount}}"
          >
            <view class="day-index">第 {{item.day}} 天</view>
            <view class="day-date">{{item.monthDay}}</view>
            <view class="day-week">{{item.weekday}} · {{item.statusLabel}}</view>
            <view wx:if="{{item.isToday}}" class="today-mark">今天</view>
            <view class="day-count">{{item.completedCount}} / {{item.totalCount}}</view>
          </button>
        </view>
      </scroll-view>
    </view>

    <view class="task-section">
      <view class="section-heading">
        <view>
          <view class="section-title">第 {{selectedDay.day}} 天行动</view>
          <view class="selected-date">{{selectedDay.monthDay}} · {{selectedDay.weekday}}</view>
        </view>
        <view class="day-status-text">{{selectedDay.statusLabel}}</view>
      </view>

      <view wx:if="{{selectedDay.tasks.length === 0}}" class="card empty-tasks">
        <view class="state-mark small-mark">0</view>
        <view class="empty-task-title">这一天没有安排行动</view>
        <view class="state-description">留一点空白，也是在为下一步积蓄精力。</view>
      </view>

      <view
        wx:for="{{selectedDay.tasks}}"
        wx:key="id"
        class="card task-card task-{{item.state}}"
      >
        <view class="task-top">
          <view class="task-title">{{item.title}}</view>
          <view class="task-state">{{item.state === 'completed' ? '已完成' : item.state === 'postponed' ? '已顺延' : item.state === 'expired' ? '已过期' : item.state === 'paused' ? '暂停中' : '未完成'}}</view>
        </view>
        <view wx:if="{{item.description}}" class="task-description">{{item.description}}</view>
        <view class="task-meta">预计 {{item.estimatedMinutes}} 分钟</view>
        <view wx:if="{{item.postponed}}" class="postpone-info">
          原计划 {{item.originalScheduledDate}} · 当前 {{item.scheduledDate}}
        </view>
        <view class="task-actions">
          <button
            wx:if="{{item.canPostpone}}"
            class="outline-button"
            data-task-id="{{item.id}}"
            disabled="{{actionLoading !== ''}}"
            loading="{{actionLoading === 'task' && actionTaskId === item.id}}"
            bindtap="confirmPostpone"
          >顺延到明天</button>
          <button
            wx:if="{{selectedDay.date === pageData.businessDate && pageData.plan.status === 'active'}}"
            class="text-button"
            bindtap="goToToday"
          >前往今日页</button>
        </view>
      </view>
    </view>

    <view class="card management-card">
      <view class="section-title">阶段管理</view>
      <view wx:if="{{pageData.plan.status === 'paused'}}" class="resume-copy">
        恢复后将继续当前阶段，暂停期间的日期不会自动顺延。
      </view>
      <button
        wx:if="{{pageData.plan.status === 'active'}}"
        class="management-button"
        loading="{{actionLoading === 'status'}}"
        disabled="{{actionLoading !== ''}}"
        bindtap="confirmPause"
      >暂停阶段</button>
      <button
        wx:elif="{{pageData.plan.status === 'paused'}}"
        class="primary-management-button"
        loading="{{actionLoading === 'status'}}"
        disabled="{{actionLoading !== ''}}"
        bindtap="resumePlan"
      >恢复阶段</button>
      <button
        class="delete-button"
        loading="{{deleting}}"
        disabled="{{deleting || actionLoading !== ''}}"
        bindtap="confirmDelete"
      >删除当前目标</button>
    </view>

    <view class="card next-week-card">
      <view class="section-eyebrow">阶段复盘</view>
      <view class="next-week-title">{{pageData.plan.reviewEligible ? '回顾这一阶段' : '阶段结束后开放'}}</view>
      <view class="next-week-copy">完成复盘后，会根据你的实际完成情况制定下一阶段。</view>
      <button wx:if="{{pageData.plan.reviewEligible}}" class="primary-button full-button" bindtap="goToStageReview">
        {{pageData.plan.status === 'reviewing' ? '继续制定下一阶段' : '开始阶段复盘'}}
      </button>
    </view>
  </block>
</view>
