<view class="page plan-page">
  <view class="page-header plan-header">
    <view>
      <view class="page-eyebrow">长期目标行动记录</view>
      <view class="page-title">进度</view>
      <view class="page-subtitle">看见当前阶段，也看见每一次行动。</view>
    </view>
    <button wx:if="{{status === 'ready'}}" class="management-menu-trigger" aria-label="打开阶段管理菜单" bindtap="toggleManagementMenu">•••</button>
  </view>

  <view wx:if="{{showManagementMenu}}" class="management-menu-backdrop" catchtap="closeManagementMenu"></view>
  <view wx:if="{{showManagementMenu && pageData}}" class="management-menu" catchtap="preventBubble">
    <view class="management-menu-title">阶段管理</view>
    <picker mode="time" value="{{pageData.plan.dailyReminderTime}}" disabled="{{actionLoading !== '' || (pageData.plan.status !== 'active' && pageData.plan.status !== 'paused')}}" bindchange="changePlanTime">
      <view class="management-menu-row">
        <view><view class="management-menu-label">每日行动时间</view><view class="management-menu-value">{{pageData.plan.dailyReminderTime}}</view></view>
        <text class="menu-arrow">›</text>
      </view>
    </picker>
    <button wx:if="{{pageData.plan.status === 'active'}}" class="management-menu-row" disabled="{{actionLoading !== ''}}" bindtap="confirmPause"><text>暂停当前阶段</text><text class="menu-arrow">›</text></button>
    <button wx:elif="{{pageData.plan.status === 'paused'}}" class="management-menu-row menu-primary-row" loading="{{actionLoading === 'status'}}" disabled="{{actionLoading !== ''}}" bindtap="resumePlan"><text>恢复当前阶段</text><text class="menu-arrow">›</text></button>
    <button class="management-menu-row {{pageData.plan.reviewEligible ? '' : 'menu-row-disabled'}}" disabled="{{!pageData.plan.reviewEligible}}" bindtap="goToStageReview">
      <view class="management-menu-copy"><text>阶段复盘</text><text wx:if="{{!pageData.plan.reviewEligible}}" class="management-menu-hint">阶段结束后开放</text></view>
      <text class="menu-arrow">›</text>
    </button>
    <button class="management-menu-row menu-danger-row" loading="{{deleting}}" disabled="{{deleting || actionLoading !== ''}}" bindtap="confirmDelete"><text>删除当前目标</text><text class="menu-arrow">›</text></button>
  </view>

  <view wx:if="{{status === 'loading'}}" class="card state-card">
    <view class="loading-dot"></view>
    <view class="state-title">正在读取行动进度</view>
    <view class="state-description">正在同步你的目标和进度。</view>
  </view>

  <view wx:elif="{{status === 'empty'}}" class="card state-card">
    <view class="state-mark">1</view>
    <view class="state-title">还没有进行中的目标</view>
    <view class="state-description">创建一个长期目标，开始第一个行动阶段。</view>
    <button class="primary-button" bindtap="createGoal">创建目标</button>
  </view>

  <view wx:elif="{{status === 'error'}}" class="card state-card">
    <view class="state-mark">!</view>
    <view class="state-title">进度加载失败</view>
    <view class="state-description">{{errorMessage}}</view>
    <button class="primary-button" bindtap="retry">重新加载</button>
  </view>

  <view wx:elif="{{status === 'preview'}}" class="card state-card">
    <view class="state-mark">1</view>
    <view class="state-title">行动阶段预览已准备好</view>
    <view class="state-description">确认后就可以开始今天的行动。</view>
    <button class="primary-button" bindtap="continuePreview">继续查看阶段</button>
  </view>

  <block wx:else>
    <view class="card overview-card">
      <view class="goal-heading">
        <view>
          <view class="section-eyebrow">当前目标</view>
          <view class="goal-title">{{pageData.goal.title}}</view>
        </view>
        <view class="category-tag">{{categoryLabel}}</view>
      </view>
      <view class="stage-row">
        <view><view class="stage-label">当前阶段</view><view class="goal-summary">{{pageData.plan.stageTitle}}</view></view>
        <view class="status-badge status-{{pageData.plan.status}}">{{planStatusLabel}}</view>
      </view>
      <view class="weekly-goal {{showStageFocus ? 'weekly-goal-expanded' : ''}}">
        <button class="weekly-goal-toggle" aria-expanded="{{showStageFocus}}" bindtap="toggleStageFocus">
          <text class="weekly-goal-label">本阶段重点</text>
          <text class="weekly-goal-action">{{showStageFocus ? '收起' : '查看'}} {{showStageFocus ? '⌃' : '⌄'}}</text>
        </button>
        <view wx:if="{{showStageFocus}}" class="weekly-goal-content">{{pageData.plan.focus}}</view>
      </view>
      <view class="overview-progress">
        <view class="progress-ring" style="background: conic-gradient(#356859 {{pageData.plan.completionRate}}%, #E8ECE6 0);" aria-role="progressbar" aria-label="阶段行动完成 {{pageData.plan.completionRate}}%" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{pageData.plan.completionRate}}">
          <view class="progress-ring-center"><view class="progress-ring-value">{{pageData.plan.completionRate}}%</view><view class="progress-ring-label">阶段进度</view></view>
        </view>
        <view class="overview-stats">
          <view class="overview-stat"><view class="overview-stat-value">第 {{pageData.plan.currentDay}} / {{pageData.plan.totalDays}} 天</view><view class="overview-stat-label">当前阶段</view></view>
          <view class="overview-stat"><view class="overview-stat-value streak-flip">{{pageData.progress.streakDays}} 天</view><view class="overview-stat-label">连续行动</view></view>
          <view class="overview-stat"><view class="overview-stat-value">{{pageData.progress.totalActionDays}} 天</view><view class="overview-stat-label">累计行动</view></view>
        </view>
      </view>
      <view class="progress-copy">{{progressText}} · {{pageData.plan.completedCount}} / {{pageData.plan.totalCount}} 项完成</view>
    </view>

    <view wx:if="{{pageData.plan.status === 'paused'}}" class="paused-notice">
      <view class="paused-title">当前阶段已暂停</view>
      <view>行动会继续保留，暂停期间不能记录或顺延。</view>
    </view>

    <view class="timeline-section">
      <view class="section-title">近 7 天行动</view>
      <view class="recent-grid">
        <view wx:for="{{recentDays}}" wx:key="date" class="recent-day recent-{{item.status}}">
          <view class="recent-date">{{item.monthDay}}</view>
          <view class="recent-status">{{item.isToday ? '今天' : item.statusLabel}}</view>
          <view class="recent-count">{{item.completedCount}} / {{item.totalCount}}</view>
        </view>
      </view>
    </view>

    <view class="timeline-section">
      <view class="section-title">阶段每日行动概览</view>
      <scroll-view class="timeline-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="timeline-row">
          <button
            wx:for="{{days}}"
            wx:key="date"
            class="day-chip day-{{item.status}} {{selectedDate === item.date ? 'day-selected' : ''}}"
            data-date="{{item.date}}"
            bindtap="selectDay"
            aria-label="第 {{item.day}} 天，{{item.monthDay}}，{{item.statusLabel}}，完成 {{item.completedCount}} / {{item.totalCount}}"
          >
            <view class="day-index">第 {{item.day}} 天</view>
            <view class="day-date">{{item.monthDay}}</view>
            <view class="day-week">{{item.weekday}} · {{item.statusLabel}}</view>
            <view wx:if="{{item.isToday}}" class="today-mark">今天</view>
            <view class="day-count">{{item.completedCount}} / {{item.totalCount}}</view>
          </button>
        </view>
      </scroll-view>
    </view>

    <view class="task-section">
      <view class="section-heading">
        <view>
          <view class="section-title">第 {{selectedDay.day}} 天行动</view>
          <view class="selected-date">{{selectedDay.monthDay}} · {{selectedDay.weekday}}</view>
        </view>
        <view class="day-status-text">{{selectedDay.statusLabel}}</view>
      </view>

      <view wx:if="{{selectedDay.tasks.length === 0}}" class="card empty-tasks">
        <view class="state-mark small-mark">0</view>
        <view class="empty-task-title">这一天没有安排行动</view>
          <view class="state-description">{{selectedDay.status === 'rest' ? '今天是计划休息日，休息不会计为未完成。' : '留一点空白，也是在为下一步积蓄精力。'}}</view>
      </view>

      <view
        wx:for="{{selectedDay.tasks}}"
        wx:key="id"
        class="card task-card task-{{item.state}}"
      >
        <view class="task-top">
          <view class="task-title">{{item.title}}</view>
          <view class="task-state">{{item.state === 'completed' ? '已完成' : item.state === 'postponed' ? '已顺延' : item.state === 'expired' ? '已过期' : item.state === 'paused' ? '暂停中' : '未完成'}}</view>
        </view>
        <view wx:if="{{item.description}}" class="task-description">{{item.description}}</view>
        <view class="task-meta">预计 {{item.estimatedMinutes}} 分钟</view>
        <view wx:if="{{item.postponed}}" class="postpone-info">
          原计划 {{item.originalScheduledDate}} · 当前 {{item.scheduledDate}}
        </view>
        <view class="task-actions">
          <button
            wx:if="{{item.canPostpone}}"
            class="outline-button"
            data-task-id="{{item.id}}"
            disabled="{{actionLoading !== ''}}"
            loading="{{actionLoading === 'task' && actionTaskId === item.id}}"
            bindtap="confirmPostpone"
          >顺延到明天</button>
          <button
            wx:if="{{selectedDay.date === pageData.businessDate && pageData.plan.status === 'active'}}"
            class="text-button"
            bindtap="goToToday"
          >前往今日页</button>
        </view>
      </view>
    </view>

  </block>
</view>
