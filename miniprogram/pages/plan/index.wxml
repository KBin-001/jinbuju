<view class="page progress-page" data-theme="{{appTheme}}">
  <view class="landscape-header tab-header" style="height: {{headerHeight}}px;">
    <image class="tab-header__background" src="/assets/progress-mountain-path-v2.jpg" mode="aspectFill" aria-hidden="true" />
    <view class="landscape-header__veil tab-header__veil"></view>
    <view class="progress-nav tab-header__nav" style="padding-top: {{menuTop}}px; height: {{menuHeight}}px;">
      <text class="tab-header__title">进度</text>
      <view class="progress-title-mark" aria-hidden="true"></view>
      <text class="progress-subtitle">持续行动 · 长期成长</text>
    </view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="state-card surface-card">
    <t-loading theme="circular" size="48rpx" color="#245B4D" />
    <view class="state-title">正在整理成长记录</view>
    <view class="state-description">正在读取你的目标与行动。</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="state-card surface-card">
    <view class="state-symbol"><t-icon name="info-circle" size="44rpx" /></view>
    <view class="state-title">进度暂时没有加载出来</view>
    <view class="state-description">{{errorMessage || '成长记录读取失败，请重试。'}}</view>
    <t-button class="state-action" theme="primary" shape="round" bindtap="retry">重新加载</t-button>
  </view>

  <view wx:elif="{{!goal}}" class="state-card surface-card empty-goal">
    <view class="empty-landscape"><image class="empty-landscape__image" src="/assets/progress-mountain-path-v2.jpg" mode="aspectFill" /></view>
    <view class="state-title">还没有目标</view>
    <view class="state-description">先创建一个想推进的方向。</view>
    <t-button class="state-action" theme="primary" shape="round" bindtap="createGoal">创建目标</t-button>
  </view>

  <block wx:else>
    <goal-overview goal="{{goal}}" period="{{goalPeriod}}" stage="{{goalStage}}" switch-label="{{canSwitchGoal ? '切换目标' : '查看目标'}}" bind:switch="openGoalPicker" />
    <progress-metrics items="{{overviewStats}}" />

    <action-trend-chart
      id="actionTrendChart"
      wx:if="{{trendRange !== 'year'}}"
      chart="{{barChart}}"
      summary="{{trendSummary}}"
      highlights="{{trendHighlights}}"
      ranges="{{trendRanges}}"
      period-label="{{trendPeriodLabel}}"
      completion-enabled="{{completionDotsEnabled}}"
      has-any-task="{{hasAnyTask}}"
      bind:rangechange="onTrendRangeChange"
      bind:select="onTrendSelect"
      bind:history="openHistoryReview"
      bind:emptyaction="onTrendEmptyAction"
    />

    <view wx:else class="year-card surface-card">
      <view class="year-card__head">
        <view><view class="section-title">行动趋势</view><view class="section-description">{{trendPeriodLabel}}</view></view>
        <view class="year-tabs" role="tablist"><view wx:for="{{trendRanges}}" wx:key="key" class="year-tab {{item.active ? 'is-active' : ''}}" data-key="{{item.key}}" bindtap="switchTrendRange">{{item.label}}</view></view>
      </view>
        <view wx:if="{{yearSummary.insufficient}}" class="trend-empty">
          <view>{{yearSummary.summaryText}}</view>
          <view wx:if="{{!hasAnyTask}}" class="trend-empty-action" bindtap="addTodayAction">添加今日行动</view>
          <view wx:else class="trend-empty-action" bindtap="goToday">去今日页开始行动</view>
        </view>
        <block wx:else>
          <view class="year-stats">
            <view class="year-stat"><text class="year-stat__value">{{yearSummary.checkinDays}}</text><text class="year-stat__label">行动天数</text></view>
            <view class="year-stat"><text class="year-stat__value">{{yearSummary.totalMinutes}}</text><text class="year-stat__label">累计分钟</text></view>
            <view class="year-stat"><text class="year-stat__value">{{yearSummary.maxStreakDays}}</text><text class="year-stat__label">最长连续</text></view>
          </view>
          <scroll-view scroll-x class="heatmap-scroll" enhanced show-scrollbar="{{false}}">
            <view class="heatmap-inner">
              <view class="heatmap-months"><text wx:for="{{heatmapMonthLabels}}" wx:key="label" class="heatmap-month" style="left: {{item.left}}rpx;">{{item.label}}</text></view>
              <view class="heatmap-grid">
                <view wx:for="{{heatmapWeeks}}" wx:for-item="week" wx:for-index="weekIndex" wx:key="weekIndex" class="heatmap-column">
                  <view wx:for="{{week.days}}" wx:for-item="day" wx:for-index="dayIndex" wx:key="dayIndex" class="heatmap-cell level-{{day.level}} {{day.active ? 'is-active' : ''}} {{day.isEmpty || day.isFuture ? 'is-muted' : ''}}" data-date="{{day.date}}" data-week-index="{{weekIndex}}" data-day-index="{{dayIndex}}" catchtap="onHeatmapDayTap"></view>
                </view>
              </view>
            </view>
          </scroll-view>
          <view wx:if="{{selectedHeatmapDay}}" class="heatmap-detail">
            <text>{{selectedHeatmapDay.dateLabel}}</text>
            <text wx:if="{{selectedHeatmapDay.hasRecord}}"> · {{selectedHeatmapDay.minutes}} 分钟，完成 {{selectedHeatmapDay.actions}} 项</text>
            <text wx:else> · 没有行动记录</text>
          </view>
          <view class="trend-insight">{{yearSummary.summaryText}}</view>
        </block>
      <view class="history-link" bindtap="openHistoryReview"><text>查看历史记录</text><t-icon name="chevron-right" size="30rpx" /></view>
    </view>

    <coach-insight wx:if="{{hasTrendData}}" insight="{{coachInsight}}" bind:open="openAiCoach" />

    <view wx:if="{{goal}}" class="growth-record-entry surface-card" bindtap="openGrowthRecords" hover-class="tap-pressed" aria-role="button" aria-label="查看完整成长记录">
      <view class="growth-record-icon"><view class="growth-record-bars"><view class="growth-record-bar is-first"></view><view class="growth-record-bar is-second"></view><view class="growth-record-bar is-third"></view></view></view>
      <view class="growth-record-copy"><view class="section-title">成长记录</view><view class="growth-record-summary">{{growthRecordSummary}}</view></view>
      <view class="growth-record-action"><text class="growth-record-action__label">查看全部</text><t-icon name="chevron-right" size="30rpx" /></view>
    </view>

    <view wx:if="{{recentCompletedTasks.length}}" class="recent-tasks-card surface-card">
      <view class="recent-tasks-head">
        <view><view class="section-title">最近任务</view><view class="recent-tasks-description">仅显示今日已完成，可修改实际投入</view></view>
        <view class="recent-tasks-count">{{recentCompletedTasks.length}} 项</view>
      </view>
      <view class="recent-task-list">
        <block wx:for="{{recentCompletedTasks}}" wx:key="id">
          <view wx:if="{{index === 0}}" class="recent-task-row" data-id="{{item.id}}" bindtap="openRecentTask" hover-class="tap-pressed" aria-role="button" aria-label="编辑{{item.title}}的实际投入">
            <view class="recent-task-status"><t-icon name="check" size="24rpx" /></view>
            <view class="recent-task-copy">
              <view class="recent-task-title">{{item.title}}</view>
              <view class="recent-task-meta"><text>{{item.completedTime}}</text><text class="recent-task-meta__estimate">预计 {{item.estimatedMinutes}} 分钟</text></view>
            </view>
            <view class="recent-task-actual"><text class="recent-task-actual__number">{{item.actualMinutes}}</text><text class="recent-task-actual__unit">分钟</text></view>
            <t-icon class="recent-task-arrow" name="chevron-right" size="28rpx" color="#969A96" />
          </view>
        </block>
      </view>
    </view>
  </block>

  <view wx:if="{{goalPickerVisible}}" class="goal-picker-layer" catchtouchmove="noop">
    <view class="goal-picker-mask" catchtap="closeGoalPicker"></view>
    <view class="goal-picker-panel" catchtap="noop">
      <view class="goal-picker-grabber"></view>
      <view class="goal-picker-header"><view><view class="picker-label">目标视图</view><view class="picker-title">切换当前目标</view></view><view class="picker-close" catchtap="closeGoalPicker" aria-role="button" aria-label="关闭目标选择"><t-icon name="close" size="38rpx" /></view></view>
      <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="goal-picker-list">
        <view wx:for="{{goalOptions}}" wx:key="id" class="goal-option {{item.active ? 'is-active' : ''}}" data-id="{{item.id}}" catchtap="switchGoal" aria-role="button" aria-label="{{item.active ? '当前目标' : '切换到'}}{{item.title}}">
          <view class="goal-option-main"><view class="goal-option-title">{{item.title}}</view><view class="goal-option-meta"><text>{{item.periodText}}</text></view></view>
          <view class="goal-option-action {{item.active ? 'is-current' : ''}}"><text>{{item.active ? '当前' : '切换'}}</text><t-icon name="{{item.active ? 'check-circle' : 'chevron-right'}}" size="28rpx" /></view>
        </view>
      </scroll-view>
    </view>
  </view>

  <action-record-editor visible="{{recordEditorVisible}}" task="{{recordEditorTask}}" saving="{{savingRecord}}" deleting="{{deletingRecord}}" bind:close="closeRecordEditor" bind:save="saveRecordEditor" bind:delete="deleteRecordEditor" />

</view>
