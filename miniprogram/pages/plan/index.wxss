.plan-page {
  padding-top: 40rpx;
}

.goal-card,
.progress-card,
.management-card,
.next-week-card {
  margin-bottom: 24rpx;
}

.goal-heading,
.section-heading,
.task-top,
.time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-eyebrow {
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 650;
}

.goal-title {
  max-width: 430rpx;
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.4;
}

.category-tag,
.status-badge,
.day-status-text,
.task-state {
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.category-tag {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.goal-summary {
  margin-top: 18rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.weekly-goal {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  line-height: 1.6;
}

.weekly-goal-label {
  margin-bottom: 6rpx;
  font-size: 22rpx;
  font-weight: 650;
}

.goal-grid {
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
}

.goal-grid-item {
  flex: 1;
}

.goal-grid-item + .goal-grid-item {
  padding-left: 28rpx;
  border-left: 1rpx solid var(--color-border);
}

.goal-grid-value {
  font-weight: 650;
}

.goal-grid-label {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 1.5;
}

.status-active {
  display: inline-block;
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.status-paused {
  display: inline-block;
  background: #f2eadc;
  color: #806233;
}

.status-completed {
  display: inline-block;
  background: #edf0ed;
  color: #59625b;
}

.status-reviewing {
  display: inline-block;
  background: #eef0f5;
  color: #59657a;
}

.time-row {
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f6f8f5;
}

.time-label {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.time-value {
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.outline-button {
  padding: 16rpx 22rpx;
  border: 2rpx solid var(--color-primary);
  border-radius: 999rpx;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.paused-notice {
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 22rpx;
  background: #f5eddf;
  color: #705b37;
  line-height: 1.55;
}

.paused-title {
  margin-bottom: 6rpx;
  font-weight: 700;
}

.progress-count,
.progress-copy,
.selected-date {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.progress-rate {
  color: var(--color-primary);
  font-size: 42rpx;
  font-weight: 700;
}

.progress-track {
  height: 18rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e8ece6;
}

.action-stats {
  display: flex;
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
}

.action-stat {
  flex: 1;
  text-align: center;
}

.action-stat + .action-stat {
  border-left: 1rpx solid var(--color-border);
}

.action-stat-value {
  color: var(--color-primary);
  font-size: 36rpx;
  font-weight: 700;
}

.action-stat-label {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.recent-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-top: 20rpx;
}

.recent-day {
  min-width: 0;
  padding: 16rpx 4rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  background: #ffffff;
  text-align: center;
}

.recent-completed,
.recent-today,
.recent-rest {
  background: var(--color-primary-light);
}

.recent-partial,
.recent-missed,
.recent-paused {
  background: #faf7f1;
}

.recent-date,
.recent-status,
.recent-count {
  overflow: hidden;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-status {
  margin-top: 8rpx;
  color: var(--color-primary);
  font-weight: 650;
}

.recent-count {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
}

.timeline-section,
.task-section {
  margin-top: 36rpx;
  margin-bottom: 34rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
}

.timeline-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.timeline-row {
  display: inline-flex;
  padding: 2rpx 2rpx 18rpx;
}

.day-chip {
  width: 210rpx;
  margin-right: 16rpx;
  padding: 22rpx 18rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
  background: #ffffff;
  text-align: left;
}

.day-selected {
  border-color: var(--color-primary);
  box-shadow: 0 8rpx 22rpx rgba(53, 104, 89, 0.12);
}

.day-today {
  background: #f1f7f4;
}

.day-completed {
  background: #f4f8f5;
}

.day-rest {
  background: #f4f7f3;
}

.day-missed,
.day-paused {
  background: #faf7f1;
}

.day-index {
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 650;
}

.day-date {
  margin-top: 10rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.day-week,
.day-count {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 21rpx;
}

.today-mark {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 650;
}

.day-status-text {
  background: #edf2ee;
  color: var(--color-primary);
}

.task-card {
  margin-top: 18rpx;
  padding: 28rpx;
}

.task-completed {
  border-color: #cfe1d8;
  background: #f4f8f5;
}

.task-paused,
.task-expired {
  background: #faf8f3;
}

.task-title {
  flex: 1;
  padding-right: 18rpx;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.45;
}

.task-state {
  flex-shrink: 0;
  background: #edf0ed;
  color: #59625b;
}

.task-description {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.55;
}

.task-meta,
.postpone-info {
  margin-top: 12rpx;
  color: #879087;
  font-size: 22rpx;
}

.postpone-info {
  color: #806233;
}

.task-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 22rpx;
}

.text-button {
  padding: 16rpx 20rpx;
  color: var(--color-primary);
  font-size: 24rpx;
}

.empty-tasks {
  margin-top: 18rpx;
  text-align: center;
}

.small-mark {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto;
  border-radius: 22rpx;
  font-size: 30rpx;
}

.empty-task-title {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 650;
}

.resume-copy,
.next-week-copy {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.management-button,
.primary-management-button,
.delete-button {
  width: 100%;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 999rpx;
  font-weight: 650;
}

.management-button {
  border: 2rpx solid #a48654;
  color: #735b33;
}

.primary-management-button {
  background: var(--color-primary);
  color: #ffffff;
}

.delete-button {
  border: 2rpx solid #d8a0a0;
  color: #ad4b4b;
}

.next-week-title {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.full-button {
  width: 100%;
}

.next-week-error {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #faf3e8;
  color: #735b33;
}

.error-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.error-actions button {
  color: var(--color-primary);
  font-weight: 600;
}

.next-preview {
  margin-top: 24rpx;
}

.next-preview-summary {
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.5;
}

.next-preview-goal {
  margin-top: 12rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  line-height: 1.55;
}

.next-preview-day {
  margin-top: 14rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 1.55;
}
