.progress-page {
  --progress-primary: #145243;
  --progress-deep: #0f4035;
  --progress-accent: #55b98b;
  --progress-gold: #f5b94e;
  --progress-text: #173c34;
  --progress-secondary: #6f7f78;
  --progress-muted: #a8b0aa;
  --progress-border: #edf2ef;
  --progress-shadow: 0 8rpx 30rpx rgba(20, 82, 67, 0.08);
  min-height: 100vh;
  padding: 40rpx 32rpx calc(150rpx + env(safe-area-inset-bottom));
  background: #f7f8f5;
}

.progress-title {
  margin: 16rpx 0 26rpx;
  color: var(--progress-text);
  font-size: 34rpx;
  line-height: 42rpx;
  font-weight: 800;
}

.progress-hero {
  position: relative;
  min-height: 258rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 34rpx 34rpx 32rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 82% 80%, rgba(255, 255, 255, 0.12), transparent 32%),
    linear-gradient(145deg, #145243 0%, #1c604f 58%, #2d765f 100%);
  box-shadow: var(--progress-shadow);
}

.progress-hero::after {
  position: absolute;
  right: 18rpx;
  bottom: -72rpx;
  width: 230rpx;
  height: 150rpx;
  border-radius: 50% 50% 0 0;
  background: rgba(255, 255, 255, 0.08);
  content: "";
}

.progress-hero-copy {
  min-width: 0;
  position: relative;
  z-index: 1;
  flex: 1;
}

.progress-goal-title {
  max-width: 440rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.level-pill {
  display: inline-flex;
  align-items: center;
  width: auto;
  margin-top: 16rpx;
  padding: 8rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(245, 185, 78, 0.16);
  color: #f8c963;
  font-size: 24rpx;
  line-height: 30rpx;
  font-weight: 700;
}

.goal-period {
  margin-top: 22rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
  line-height: 32rpx;
}

.hero-trophy {
  position: relative;
  z-index: 1;
  width: 132rpx;
  height: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 44rpx;
  background: linear-gradient(145deg, #ffe8a6 0%, #f5b94e 100%);
  color: #8a6220;
  font-size: 52rpx;
  font-weight: 900;
  box-shadow: 0 16rpx 32rpx rgba(89, 62, 13, 0.16);
}

.total-progress {
  margin-top: 28rpx;
}

.progress-track {
  height: 10rpx;
  overflow: hidden;
  border-radius: 5rpx;
  background: #e6eee9;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--progress-accent);
  transition: width 180ms ease-out;
}

.progress-copy-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 14rpx;
  color: var(--progress-muted);
  font-size: 24rpx;
  line-height: 32rpx;
}

.progress-percent {
  flex: none;
  color: var(--progress-text);
  font-weight: 800;
}

.stats-card,
.trend-card,
.milestone-card {
  margin-top: 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: var(--progress-shadow);
}

.stats-card {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  padding: 30rpx 0;
}

.stat-item {
  min-width: 0;
  position: relative;
  text-align: center;
}

.stat-item + .stat-item::before {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 0;
  width: 1rpx;
  background: #edf2ef;
  content: "";
}

.stat-value {
  color: var(--progress-text);
  font-size: 42rpx;
  line-height: 50rpx;
  font-weight: 800;
}

.stat-value text {
  margin-left: 4rpx;
  color: var(--progress-text);
  font-size: 20rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 8rpx;
  color: var(--progress-secondary);
  font-size: 23rpx;
  line-height: 30rpx;
}

.trend-card {
  padding: 30rpx 28rpx 28rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  color: var(--progress-text);
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.trend-tabs {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 24rpx;
}

.trend-tab {
  min-width: 72rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  color: var(--progress-muted);
  font-size: 24rpx;
  font-weight: 700;
}

.trend-tab.is-active {
  background: var(--progress-primary);
  color: #ffffff;
}

.chart-area {
  position: relative;
  height: 250rpx;
  margin: 34rpx 8rpx 0;
}

.chart-grid {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-rows: repeat(3, 1fr);
}

.chart-grid view {
  border-top: 1rpx dashed #e7efea;
}

.chart-segment {
  position: absolute;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--progress-primary);
  transform-origin: left center;
}

.chart-point {
  position: absolute;
  z-index: 2;
  width: 18rpx;
  height: 18rpx;
  margin-left: -9rpx;
  margin-bottom: -9rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: var(--progress-primary);
  box-shadow: 0 0 0 3rpx rgba(20, 82, 67, 0.18);
}

.chart-point.is-active {
  width: 22rpx;
  height: 22rpx;
  margin-left: -11rpx;
  margin-bottom: -11rpx;
  background: var(--progress-accent);
}

.chart-tooltip {
  position: absolute;
  left: 50%;
  bottom: 28rpx;
  transform: translateX(-50%);
  min-width: 92rpx;
  padding: 8rpx 12rpx;
  border-radius: 10rpx;
  background: var(--progress-primary);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 26rpx;
  text-align: center;
  white-space: nowrap;
}

.chart-tooltip::after {
  position: absolute;
  left: 50%;
  bottom: -8rpx;
  width: 0;
  height: 0;
  margin-left: -8rpx;
  border: 8rpx solid transparent;
  border-top-color: var(--progress-primary);
  content: "";
}

.chart-labels {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 0;
  margin-top: 12rpx;
  color: var(--progress-muted);
  font-size: 22rpx;
  line-height: 28rpx;
  text-align: center;
}

.milestone-card {
  padding: 30rpx 26rpx 28rpx;
}

.milestone-row {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  margin-top: 28rpx;
}

.milestone-item {
  position: relative;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.milestone-line {
  position: absolute;
  top: 34rpx;
  right: 50%;
  left: -50%;
  height: 2rpx;
  background: #e6eee9;
}

.milestone-item:first-child .milestone-line {
  display: none;
}

.milestone-icon {
  position: relative;
  z-index: 1;
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #edf2ef;
  border-radius: 50%;
  background: #f7f8f5;
  color: #a8b0aa;
  font-size: 28rpx;
  font-weight: 800;
}

.milestone-bar {
  width: 30rpx;
  height: 8rpx;
  margin-top: 12rpx;
  border-radius: 4rpx;
  background: #dce5df;
}

.milestone-label {
  margin-top: 10rpx;
  color: var(--progress-secondary);
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 700;
}

.milestone-item.is-achieved .milestone-line {
  background: rgba(245, 185, 78, 0.48);
}

.milestone-item.is-achieved .milestone-icon {
  border-color: rgba(245, 185, 78, 0.42);
  background: #fff8e8;
  color: var(--progress-gold);
}

.milestone-item.is-achieved .milestone-bar {
  background: var(--progress-accent);
}

.milestone-item.is-next .milestone-icon {
  box-shadow: 0 0 0 6rpx rgba(20, 82, 67, 0.08);
}

@media (max-width: 340px) {
  .progress-page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .hero-trophy {
    width: 112rpx;
    height: 112rpx;
  }

  .stat-value {
    font-size: 36rpx;
  }
}
