@import "../../styles/glass.wxss";

.progress-page {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  padding: 18rpx 26rpx calc(144rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: linear-gradient(180deg, #FAF7EE 0%, #F3F7F1 48%, #F7F8F4 100%);
  color: #233B34;
}

.progress-ambient { position: absolute; z-index: 0; border-radius: 50%; pointer-events: none; }
.progress-ambient--one { width: 360rpx; height: 360rpx; top: -190rpx; right: -150rpx; background: rgba(188, 222, 199, 0.36); }
.progress-ambient--two { width: 280rpx; height: 280rpx; top: 420rpx; left: -210rpx; background: rgba(248, 210, 106, 0.12); }

.hero-card,
.growth-conclusion-card,
.trend-card,
.state-card {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 14rpx 36rpx rgba(31, 70, 58, 0.075);
}

.growth-conclusion-card,
.trend-card { margin-top: 24rpx; padding: 28rpx; }
.card-pressed { opacity: 0.86; transform: scale(0.994); }

.hero-card {
  min-height: 470rpx;
  padding: 28rpx 28rpx 24rpx;
  overflow: hidden;
  border-color: #E8E2D5;
  background: #FFFDF9;
}

.hero-card-bg,
.hero-card-overlay { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
.hero-card-bg { z-index: 0; opacity: 0.52; }
.hero-card-overlay { z-index: 1; background: linear-gradient(100deg, rgba(255,253,249,0.96) 0%, rgba(255,253,249,0.90) 43%, rgba(246,250,241,0.72) 72%, rgba(238,247,235,0.60) 100%); }
.hero-heading,
.hero-main,
.hero-stats { position: relative; z-index: 2; }
.hero-heading { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.hero-heading-main { display: flex; align-items: center; min-width: 0; flex: 1; }
.hero-target-icon { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; margin-right: 14rpx; flex: 0 0 auto; border-radius: 50%; background: #356F4B; color: #FFFFFF; font-size: 30rpx; font-weight: 800; }
.hero-title { min-width: 0; overflow: hidden; color: #1E2F29; font-size: 30rpx; line-height: 40rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.hero-switch-button { display: flex; align-items: center; justify-content: center; min-height: 52rpx; padding: 0 17rpx; flex: 0 0 auto; border: 1rpx solid rgba(53,104,89,0.18); border-radius: 27rpx; background: rgba(255,255,255,0.82); color: #356859; font-size: 19rpx; font-weight: 700; box-shadow: 0 6rpx 16rpx rgba(31,70,58,0.07); }
.hero-switch-arrow { margin-left: 5rpx; color: #52635C; font-size: 30rpx; line-height: 26rpx; }
.hero-main { display: flex; align-items: center; min-height: 238rpx; margin-top: 18rpx; }
.goal-ring-wrap { position: relative; width: 222rpx; height: 222rpx; margin-left: 6rpx; flex: 0 0 auto; }
.goal-ring-canvas { width: 222rpx; height: 222rpx; }
.goal-ring-copy { position: absolute; display: flex; align-items: center; justify-content: center; inset: 0; flex-direction: column; pointer-events: none; }
.goal-ring-copy > view { color: #2F6F4B; font-size: 39rpx; line-height: 50rpx; font-weight: 800; }
.goal-ring-copy > view text { font-size: 64rpx; }
.goal-ring-copy > text { margin-top: 3rpx; color: #6B736F; font-size: 20rpx; }
.hero-encouragement { position: relative; min-width: 0; min-height: 160rpx; margin-left: 42rpx; padding-top: 18rpx; flex: 1; color: #3F4844; font-size: 26rpx; line-height: 48rpx; }
.hero-seedling { position: absolute; width: 118rpx; height: 82rpx; right: 0; bottom: -24rpx; opacity: 0.78; }
.seedling-stem { position: absolute; width: 4rpx; height: 58rpx; left: 57rpx; bottom: 10rpx; border-radius: 4rpx; background: #B8D0AC; transform: rotate(5deg); }
.seedling-leaf { position: absolute; width: 42rpx; height: 24rpx; border-radius: 90% 10% 90% 10%; background: #C4DDB9; }
.seedling-leaf--left { left: 18rpx; top: 24rpx; transform: rotate(25deg); }
.seedling-leaf--right { right: 15rpx; top: 7rpx; transform: rotate(-30deg); }
.seedling-ground { position: absolute; width: 116rpx; height: 24rpx; left: 0; bottom: 0; border-top: 4rpx solid #DCE8D5; border-radius: 50%; }
.hero-stats { display: flex; align-items: stretch; margin-top: 6rpx; padding-top: 20rpx; border-top: 1rpx solid #E9E5DC; }
.hero-stat { display: flex; align-items: center; min-width: 0; flex: 1; }
.hero-stat-icon { display: flex; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; margin-right: 14rpx; flex: 0 0 auto; border-radius: 50%; background: #EDF4E7; color: #347149; font-size: 30rpx; font-weight: 800; }
.hero-stat > view > text { color: #68736D; font-size: 20rpx; line-height: 28rpx; }
.hero-stat > view > view { margin-top: 2rpx; color: #2F6F4B; font-size: 34rpx; line-height: 40rpx; font-weight: 800; }
.hero-stat > view > view text { margin-left: 5rpx; font-size: 22rpx; font-weight: 500; }
.hero-stat-divider { width: 1rpx; margin: 0 28rpx; background: #E3E4DE; }

.card-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.card-title { color: #203730; font-size: 31rpx; line-height: 40rpx; font-weight: 800; }
.card-subtitle { margin-top: 3rpx; color: #7B8B84; font-size: 20rpx; line-height: 29rpx; }

.growth-conclusion-card { display: flex; align-items: center; min-height: 270rpx; overflow: hidden; border-color: #D6E4CE; background: linear-gradient(135deg, #F6FAF0, #EEF6E8); }
.conclusion-robot { width: 190rpx; height: 230rpx; margin: 12rpx 22rpx -28rpx -8rpx; flex: 0 0 auto; }
.conclusion-content { min-width: 0; flex: 1; }
.conclusion-title { display: flex; align-items: center; color: #285E42; font-size: 30rpx; line-height: 40rpx; font-weight: 800; }
.conclusion-title text { margin-right: 10rpx; color: #2E7050; font-size: 30rpx; }
.conclusion-copy { margin-top: 15rpx; color: #3E4A45; font-size: 23rpx; line-height: 39rpx; white-space: normal; overflow-wrap: break-word; }
.conclusion-action { display: flex; align-items: center; justify-content: center; width: 190rpx; min-height: 54rpx; margin: 18rpx 0 0 auto; border-radius: 27rpx; background: #356859; color: #FFFFFF; font-size: 19rpx; font-weight: 700; box-shadow: 0 8rpx 18rpx rgba(53,104,89,0.15); }
.conclusion-action text { margin-left: 7rpx; font-size: 28rpx; line-height: 24rpx; }

.trend-head { align-items: center; }
.trend-title-icon { margin-right: 10rpx; color: #2F6F4B; font-size: 32rpx; }
.trend-range-tabs { display: flex; box-sizing: border-box; height: 54rpx; padding: 4rpx; flex: 0 0 auto; border-radius: 27rpx; background: #EEF2EE; }
.trend-range-tab { display: flex; align-items: center; justify-content: center; width: 54rpx; height: 46rpx; border-radius: 23rpx; color: #7B8982; font-size: 20rpx; font-weight: 600; }
.trend-range-tab.is-active { background: #FFFFFF; color: #356859; font-weight: 800; box-shadow: 0 5rpx 14rpx rgba(31, 70, 58, 0.10); }
.trend-insufficient,
.trend-summary { margin-top: 20rpx; padding: 18rpx 20rpx; border-radius: 18rpx; background: #FFF8E8; color: #80672C; font-size: 20rpx; line-height: 31rpx; }
.chart-legend-row { display: flex; align-items: center; gap: 26rpx; margin-top: 20rpx; padding-left: 48rpx; }
.chart-legend { display: flex; align-items: center; color: #71827A; font-size: 17rpx; }
.legend-dot { width: 11rpx; height: 11rpx; margin-right: 7rpx; border-radius: 50%; background: #16825C; }
.legend-line { width: 25rpx; height: 3rpx; margin-right: 7rpx; border-radius: 3rpx; background: #7FA88B; }
.bar-chart { display: flex; height: 310rpx; margin-top: 8rpx; }
.bar-y-axis { display: flex; box-sizing: border-box; width: 46rpx; padding: 8rpx 7rpx 8rpx 0; flex: 0 0 auto; flex-direction: column; justify-content: space-between; color: #95A099; font-size: 16rpx; text-align: right; }
.bar-y-axis--right { padding-right: 0; padding-left: 8rpx; text-align: left; }
.bar-area { position: relative; min-width: 0; flex: 1; }
.bar-grid,
.bar-columns,
.line-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
.bar-grid { display: flex; flex-direction: column; justify-content: space-between; }
.bar-grid-line { width: 100%; border-top: 1rpx solid #E3EAE4; }
.bar-columns { z-index: 2; display: flex; align-items: flex-end; justify-content: space-around; }
.bar-column { position: relative; display: flex; height: 100%; min-width: 30rpx; align-items: flex-end; justify-content: center; }
.bar-fill { min-height: 4rpx; border-radius: 10rpx 10rpx 4rpx 4rpx; background: linear-gradient(180deg, #25A975, #08704B); }
.bar-fill.is-max,
.bar-column.is-active .bar-fill { box-shadow: 0 6rpx 14rpx rgba(11, 107, 69, 0.22); }
.line-canvas { z-index: 1; pointer-events: none; }
.bar-tooltip { position: absolute; z-index: 5; min-width: 106rpx; padding: 9rpx 11rpx; border-radius: 13rpx; background: #244D40; color: #FFFFFF; font-size: 17rpx; line-height: 25rpx; text-align: center; box-shadow: 0 8rpx 18rpx rgba(31,70,58,0.16); transform: translateX(-50%); }
.bar-tooltip-sub { display: block; color: #D1E2D9; font-size: 15rpx; }
.tooltip-left { left: 0; transform: none; }
.tooltip-center { left: 50%; }
.tooltip-right { right: 0; transform: none; }
.bar-labels { display: flex; margin-right: 46rpx; margin-left: 46rpx; color: #87958E; font-size: 16rpx; }
.bar-label { min-width: 0; flex: 1; text-align: center; }
.trend-footer { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 22rpx; padding: 14rpx 16rpx; border-radius: 18rpx; background: #EDF4E4; color: #356A47; }
.trend-footer-copy { display: flex; align-items: center; min-width: 0; flex: 1; font-size: 19rpx; line-height: 30rpx; }
.trend-footer-icon { display: flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; margin-right: 10rpx; flex: 0 0 auto; border-radius: 50%; background: #3B7B51; color: #FFFFFF; font-size: 22rpx; font-weight: 800; }
.trend-footer-strong { margin: 0 3rpx; color: #2F6F4B; font-size: 23rpx; font-weight: 800; }
.trend-history { padding: 8rpx 0 8rpx 10rpx; flex: 0 0 auto; color: #356859; font-size: 18rpx; font-weight: 700; }

.year-top-stats { display: flex; margin-top: 20rpx; padding: 18rpx 10rpx; border-radius: 20rpx; background: #F4F8F3; }
.year-stat-item { min-width: 0; flex: 1; text-align: center; }
.year-stat-item + .year-stat-item { border-left: 1rpx solid #DFE8E1; }
.year-stat-value { color: #294F43; font-size: 29rpx; font-weight: 800; }
.year-stat-label { margin-top: 4rpx; color: #71827A; font-size: 17rpx; }
.value-unit { margin-left: 3rpx; color: #71827A; font-size: 16rpx; font-weight: 500; }
.heatmap-scroll { width: 100%; margin-top: 20rpx; }
.heatmap-inner { width: 1050rpx; }
.heatmap-months-row,
.heatmap-body-row { display: flex; }
.heatmap-weekday-spacer { width: 36rpx; flex: 0 0 auto; }
.heatmap-months { position: relative; width: 1014rpx; height: 28rpx; }
.heatmap-month-label { position: absolute; color: #85928C; font-size: 17rpx; }
.heatmap-weekdays { position: relative; width: 36rpx; height: 128rpx; flex: 0 0 auto; }
.heatmap-weekday { position: absolute; color: #85928C; font-size: 17rpx; }
.heatmap-grid { display: flex; gap: 5rpx; }
.heatmap-column { display: flex; flex-direction: column; gap: 5rpx; }
.heatmap-cell,
.legend-cell { box-sizing: border-box; width: 14rpx; height: 14rpx; border-radius: 4rpx; background: #EDF2EE; }
.heatmap-cell.level-1, .legend-cell.level-1 { background: #CFE3D6; }
.heatmap-cell.level-2, .legend-cell.level-2 { background: #9CC8AE; }
.heatmap-cell.level-3, .legend-cell.level-3 { background: #61A184; }
.heatmap-cell.level-4, .legend-cell.level-4 { background: #356859; }
.heatmap-cell.is-future, .heatmap-cell.is-empty { opacity: 0.42; }
.heatmap-cell.is-active { box-shadow: 0 0 0 3rpx rgba(242,185,75,0.68); }
.heatmap-tooltip { width: max-content; max-width: 100%; margin: 16rpx auto 0; padding: 12rpx 19rpx; border-radius: 17rpx; background: #244D40; color: #FFFFFF; font-size: 18rpx; line-height: 28rpx; text-align: center; }
.heatmap-tooltip-date { font-weight: 700; }
.heatmap-tooltip-sub { display: block; color: #CDE1D7; font-size: 16rpx; }
.heatmap-legend { display: flex; align-items: center; justify-content: flex-end; gap: 7rpx; margin-top: 13rpx; color: #85928C; font-size: 16rpx; }
.year-highlights { margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid #E8EEE9; }
.highlights-title { color: #294F43; font-size: 23rpx; font-weight: 800; }
.highlights-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 9rpx; margin-top: 13rpx; }
.highlight-item { min-width: 0; padding: 14rpx 8rpx; border-radius: 17rpx; background: #F7F9F6; text-align: center; }
.highlight-icon { display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; margin: 0 auto 7rpx; border-radius: 11rpx; background: #EAF5EF; color: #356859; font-size: 18rpx; font-weight: 800; }
.highlight-icon.is-gold { background: #FFF1C7; color: #A57A17; }
.highlight-date { overflow: hidden; color: #294F43; font-size: 18rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.highlight-label { margin-top: 3rpx; color: #7B8B84; font-size: 15rpx; line-height: 22rpx; }

.state-card { margin-top: 110rpx; padding: 54rpx 32rpx; text-align: center; }
.state-orbit,
.state-mark { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 76rpx; height: 76rpx; margin: 0 auto 22rpx; border-radius: 50%; background: #EAF5EF; color: #356859; font-size: 20rpx; font-weight: 800; }
.state-orbit { border: 5rpx solid #D9E8E0; border-top-color: #356859; background: transparent; animation: state-spin 1s linear infinite; }
@keyframes state-spin { to { transform: rotate(360deg); } }
.state-title { color: #203730; font-size: 31rpx; font-weight: 800; }
.state-description { max-width: 520rpx; margin: 12rpx auto 0; color: #71827A; font-size: 22rpx; line-height: 35rpx; }
.primary-action { width: 320rpx; height: 76rpx; margin-top: 28rpx; border-radius: 38rpx; background: #356859 !important; color: #FFFFFF !important; font-size: 25rpx; font-weight: 700; }

.goal-picker-layer { position: fixed; z-index: 100; inset: 0; }
.goal-picker-mask { position: absolute; inset: 0; background: rgba(28,46,39,0.28); -webkit-backdrop-filter: blur(8rpx); backdrop-filter: blur(8rpx); }
.goal-picker-panel { position: absolute; box-sizing: border-box; width: 100%; max-height: 72vh; right: 0; bottom: 0; left: 0; padding: 14rpx 28rpx calc(34rpx + env(safe-area-inset-bottom)); overflow-y: auto; border-radius: 34rpx 34rpx 0 0; background: #FBFCF8; box-shadow: 0 -18rpx 46rpx rgba(31,70,58,0.15); }
.goal-picker-grabber { width: 72rpx; height: 8rpx; margin: 0 auto 24rpx; border-radius: 8rpx; background: #C8D5CF; }
.goal-picker-header { display: flex; align-items: center; justify-content: space-between; }
.goal-picker-kicker { color: #6D8E82; font-size: 19rpx; font-weight: 700; letter-spacing: 2rpx; }
.goal-picker-title { margin-top: 4rpx; color: #203730; font-size: 31rpx; font-weight: 800; }
.goal-picker-close { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; border-radius: 50%; background: #EDF2EE; color: #71827A; font-size: 34rpx; }
.goal-picker-list { margin-top: 24rpx; }
.goal-option { display: flex; align-items: center; margin-top: 14rpx; padding: 21rpx; border: 1rpx solid #E3EBE6; border-radius: 22rpx; background: #FFFFFF; }
.goal-option.is-active { border-color: #BFD8C8; background: #EDF7F0; }
.goal-option-main { min-width: 0; flex: 1; }
.goal-option-title { overflow: hidden; color: #263C35; font-size: 24rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.goal-option-meta { display: flex; justify-content: space-between; margin-top: 8rpx; color: #71827A; font-size: 18rpx; }
.goal-option-track { height: 7rpx; margin-top: 11rpx; overflow: hidden; border-radius: 7rpx; background: #DDE9E2; }
.goal-option-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #7FAA91, #356859); }
.goal-option-action { display: flex; align-items: center; justify-content: center; min-width: 72rpx; height: 46rpx; margin-left: 18rpx; padding: 0 12rpx; border-radius: 23rpx; background: #356859; color: #FFFFFF; font-size: 19rpx; font-weight: 700; }
.goal-option.is-active .goal-option-action { background: rgba(53,104,89,0.12); color: #356859; }

@media (max-width: 350px) {
  .progress-page { padding-right: 20rpx; padding-left: 20rpx; }
  .hero-card { min-height: 450rpx; padding-right: 22rpx; padding-left: 22rpx; }
  .hero-title { font-size: 27rpx; }
  .goal-ring-wrap,
  .goal-ring-canvas { width: 200rpx; height: 200rpx; }
  .hero-encouragement { margin-left: 24rpx; font-size: 23rpx; line-height: 42rpx; }
  .growth-conclusion-card,
  .trend-card { padding: 22rpx; }
  .conclusion-robot { width: 158rpx; height: 205rpx; margin-right: 12rpx; }
  .conclusion-copy { font-size: 21rpx; line-height: 35rpx; }
  .trend-footer-copy { font-size: 17rpx; }
}
