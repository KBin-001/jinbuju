.progress-page{padding-top:36rpx}.archive-hero{min-height:330rpx}.hero-kicker{position:relative;color:#e8c97f;font-size:20rpx;letter-spacing:3rpx}.hero-title{position:relative;margin-top:10rpx;font-size:52rpx;font-weight:750}.hero-goal{position:relative;margin-top:12rpx;color:rgba(255,255,255,.72)}.hero-rate{position:absolute;right:42rpx;bottom:62rpx;font-size:78rpx;font-weight:760;color:#f3c76a}.rate-unit{font-size:28rpx}.hero-copy{position:absolute;right:42rpx;bottom:36rpx;color:rgba(255,255,255,.65);font-size:21rpx}.metric-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:24rpx}.metric-card{padding:28rpx;border-radius:28rpx}.metric-card.green{background:#dcebe4}.metric-card.gold{background:#fff0c9}.metric-card.coral{background:#f5ddd7}.metric-card.blue{background:#e1ebf3}.metric-value{font-size:42rpx;font-weight:750}.metric-label{margin-top:6rpx;color:#66736f;font-size:23rpx}.today-card{margin-top:24rpx}.section-title{font-size:32rpx;font-weight:700}.today-count{margin-top:18rpx;color:#66736f}.today-count text{color:#356859;font-size:40rpx;font-weight:750}.progress-track{height:18rpx;margin-top:18rpx;border-radius:999rpx;background:#edf0ea;overflow:hidden}.progress-fill{height:100%;border-radius:inherit;background:linear-gradient(90deg,#356859,#8bbf72)}.section-gap{margin:34rpx 4rpx 18rpx}.week-card{display:flex;justify-content:space-between;padding:26rpx 16rpx}.day-column{width:14%;text-align:center}.day-bar-wrap{height:100rpx;display:flex;align-items:flex-end;justify-content:center}.day-bar{width:22rpx;border-radius:999rpx;background:#e7ebe8}.day-done{background:#8bbf72}.day-partial{background:#f3c76a}.day-label{margin-top:10rpx;font-size:20rpx}.day-state{margin-top:5rpx;color:#9aa6a1;font-size:17rpx;white-space:nowrap}.section-heading,.pending-card{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.section-heading{margin:36rpx 4rpx 18rpx}.mini-add{padding:14rpx 20rpx;border-radius:999rpx;background:#356859;color:#fff}.p