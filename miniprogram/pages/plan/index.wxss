}

.progress-page[data-theme="inkGreen"] .trend-card .trend-range-tab {
  color: rgba(255, 255, 255, 0.68);
}

.progress-page[data-theme="inkGreen"] .trend-card .trend-range-tab.is-active {
  background: #F8D26A;
  color: #1F4E40;
  box-shadow: 0 8rpx 18rpx rgba(248, 210, 106, 0.16);
}

.progress-page[data-theme="inkGreen"] .trend-insufficient,
.progress-page[data-theme="inkGreen"] .trend-summary-strip {
  background: rgba(255, 255, 255, 0.08);
  color: #D6EBE1;
}

.progress-page[data-theme="inkGreen"] .chart-legend,
.progress-page[data-theme="inkGreen"] .trend-card .bar-y-axis,
.progress-page[data-theme="inkGreen"] .trend-card .bar-labels {
  color: rgba(255, 255, 255, 0.64);
}

.progress-page[data-theme="inkGreen"] .trend-card .bar-grid view {
  border-color: rgba(255, 255, 255, 0.10);
}

.progress-page[data-theme="inkGreen"] .trend-card .bar-fill {
