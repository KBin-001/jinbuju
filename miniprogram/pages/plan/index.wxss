  box-shadow: inset 0 8rpx 0 rgba(255, 255, 255, 0.28);
  content: "";
}

.trend-card .trend-stat-label {
  margin-top: 0;
  color: #222826;
  font-size: 20rpx;
  line-height: 26rpx;
  font-weight: 650;
}

.trend-card .trend-stat-value {
  margin-top: 6rpx;
  color: #07543f;
  font-size: 28rpx;
  line-height: 34rpx;
  font-weight: 850;
}

.trend-card .trend-stat-value text {
  margin-left: 4rpx;
  color: #616967;
  font-size: 18rpx;
  font-weight: 500;
}

.year-top-stats {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(85, 185, 139, 0.12), rgba(20, 82, 67, 0.05));
}

.year-stat-item {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.year-stat-value {
  color: var(--progress-primary);
  font-size: 40rpx;
  line-height: 48rpx;
  font-weight: 800;
}

.year-stat-value text {
  margin-left: 4rpx;
  color: var(--progress-secondary);
  font-size: 22rpx;
  font-weight: 600;
}

.year-stat-label {
  margin-top: 4rpx;
  color: var(--progress-secondary);
  font-size: 23rpx;
  line-height: 30rpx;
}

.year-stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #dfe7e2;
}

.heatmap-scroll {
  margin-top: 28rpx;
  width: 100%;
  white-space: nowrap;
}

.heatmap-inner {
  display: inline-flex;
  flex-direction: column;
  padding-bottom: 8rpx;
}

.heatmap-months-row {
  display: flex;
  align-items: flex-end;
  height: 28rpx;
  margin-bottom: 8rpx;
}

.heatmap-weekday-spacer {
  width: 36rpx;
  flex: none;
}

.heatmap-months {
  position: relative;
  height: 28rpx;
}

.heatmap-month-label {
  position: absolute;
  bottom: 0;
  color: #9aa5a0;
  font-size: 20rpx;
  line-height: 26rpx;
}

.heatmap-body-row {
  display: flex;
  align-items: flex-start;
}

.heatmap-weekdays {
  position: relative;
  width: 36rpx;
  flex: none;
  height: 133rpx;
}

.heatmap-weekday {
  position: absolute;
  left: 0;
  color: #9aa5a0;
  font-size: 20rpx;
  line-height: 19rpx;
}

.heatmap-grid {
  display: flex;
  flex-direction: row;
}

.heatmap-column {
  display: flex;
  flex-direction: column;
  margin-right: 5rpx;
}

.heatmap-column:last-child {
  margin-right: 0;
}

.heatmap-cell {
  width: 14rpx;
  height: 14rpx;
  margin-bottom: 5rpx;
  border-radius: 4rpx;
  background: #eaf2ee;
}

.heatmap-cell:last-child {
  margin-bottom: 0;
}

.heatmap-cell.level-0 {
  background: #EFF8F3;
}

.heatmap-cell.level-1 {
  background: #C5E5D4;
}

.heatmap-cell.level-2 {
  background: #7CC6A0;
}

.heatmap-cell.level-3 {
  background: #3F8F72;
}

.heatmap-cell.level-4 {
  background: #24584A;
}

.heatmap-cell.is-empty {
  background: transparent;
}

.heatmap-cell.is-future {
  background: #f2f6f4;
}

.heatmap-cell.is-active {
  box-shadow: 0 0 0 3rpx rgba(20, 82, 67, 0.5);
}

.heatmap-tooltip {
  margin-top: 20rpx;
  padding: 18rpx 24rpx;
  border-radius: 18rpx;
  background: var(--progress-primary);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 34rpx;
}

.heatmap-tooltip-date {
  font-size: 26rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.heatmap-tooltip-row {
  margin-top: 6rpx;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 32rpx;
}

.heatmap-tooltip-sub {
  display: block;
  margin-top: 2rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 22rpx;
  line-height: 30rpx;
}

.heatmap-tooltip-empty {
  display: block;
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 24rpx;
  line-height: 32rpx;
}

.heatmap-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 18rpx;
}

.heatmap-legend-text {
  color: #9aa5a0;
  font-size: 20rpx;
  line-height: 26rpx;
}

.legend-cell {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
}

.legend-cell.level-0 {
  background: #EFF8F3;
}

.legend-cell.level-1 {
  background: #C5E5D4;
}

.legend-cell.level-2 {
  background: #7CC6A0;
}

.legend-cell.level-3 {
  background: #3F8F72;
}

.legend-cell.level-4 {
  background: #24584A;
}

.year-highlights {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #f7faf8;
}

.highlights-title {
  color: var(--progress-text);
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 800;
}

.highlights-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.highlight-item {
  flex: 1;
  min-width: 0;
  padding: 20rpx 16rpx;
  border-radius: 18rpx;
  background: #ffffff;
  text-align: center;
}

.highlight-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 800;
}

.highlight-icon-target {
  background: rgba(85, 185, 139, 0.16);
  color: var(--progress-primary);
}

.highlight-icon-trophy {
  background: rgba(245, 185, 78, 0.18);
  color: #d99a2b;
}

.highlight-icon-trend {
  background: rgba(20, 82, 67, 0.1);
  color: var(--progress-primary);
}

.highlight-date {
  margin-top: 12rpx;
  color: var(--progress-text);
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 700;
}

.highlight-label {
  margin-top: 4rpx;
  color: var(--progress-secondary);
  font-size: 21rpx;
  line-height: 28rpx;
}

.milestone-row {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  margin-top: 28rpx;
}

.milestone-item {
  position: relative;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.milestone-line {
  position: absolute;
  top: 38rpx;
  right: 50%;
  left: -50%;
  height: 2rpx;
  background: #e2ebe6;
}

.milestone-item:first-child .milestone-line {
  display: none;
}

.mini-medal {
  position: relative;
  z-index: 2;
  width: 76rpx;
  height: 86rpx;
}

.mini-medal-face {
  position: absolute;
  top: 0;
  left: 8rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 4rpx solid #e2e9e5;
  background: #f1f4f2;
  color: #9AA8A3;
  font-size: 28rpx;
  box-sizing: border-box;
}

.mini-medal-ribbon {
  position: absolute;
  top: 52rpx;
  left: 26rpx;
  width: 24rpx;
  height: 28rpx;
  border-radius: 0 0 6rpx 6rpx;
  background: #c7d1cb;
}

.state-achieved .milestone-line {
  background: rgba(245, 185, 78, 0.52);
}

.state-achieved .mini-medal-face {
  border-color: rgba(255, 224, 138, 0.8);
  background: radial-gradient(circle at 34% 24%, #fff7c8, #f5b94e);
  color: #fff5c4;
  box-shadow: 0 8rpx 18rpx rgba(245, 185, 78, 0.24);
}

.state-achieved .mini-medal-ribbon {
  background: var(--progress-primary);
}

.state-current .mini-medal-face {
  border-color: var(--progress-primary);
  background: #f8fbf9;
  color: var(--progress-primary);
  box-shadow: 0 0 0 8rpx rgba(20, 82, 67, 0.08);
}

.state-current .mini-medal-ribbon {
  background: var(--progress-accent);
}

.milestone-label {
  margin-top: 4rpx;
  color: var(--progress-text);
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 800;
}

.milestone-status {
  margin-top: 2rpx;
  color: var(--progress-muted);
  font-size: 19rpx;
  line-height: 26rpx;
}

.state-achieved .milestone-status {
  color: #c99024;
}

.state-current .milestone-status {
  color: var(--progress-primary);
  font-weight: 700;
}

.review-link {
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid #d8e5df;
  border-radius: 25rpx;
  background: #ffffff;
  color: var(--progress-primary);
  font-size: 22rpx;
  line-height: 50rpx;
  font-weight: 700;
}

.review-link::after,
.primary-action::after {
  display: none;
}

.record-list {
  margin-top: 24rpx;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
}

.record-item + .record-item {
  border-top: 1rpx solid var(--progress-border);
}

.record-check {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  background: #e8f6ef;
  color: var(--progress-primary);
  font-size: 24rpx;
  font-weight: 800;
}

.record-copy {
  min-width: 0;
  flex: 1;
}

.record-title {
  overflow: hidden;
  color: var(--progress-text);
  font-size: 27rpx;
  line-height: 36rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-meta {
  margin-top: 4rpx;
  color: var(--progress-secondary);
  font-size: 23rpx;
  line-height: 30rpx;
}

.record-empty {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f7faf8;
  color: var(--progress-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.state-card {
  margin-top: 80rpx;
  padding: 54rpx 34rpx;
  text-align: center;
}

.state-orbit,
.state-mark {
  width: 86rpx;
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: var(--progress-soft);
  color: var(--progress-primary);
  font-size: 34rpx;
  font-weight: 800;
}

.state-orbit {
  border: 6rpx solid #e4efe9;
  border-top-color: var(--progress-primary);
}

.state-title {
  color: var(--progress-text);
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 800;
}

.state-description {
  margin-top: 12rpx;
  color: var(--progress-secondary);
  font-size: 25rpx;
  line-height: 36rpx;
}

.primary-action {
  width: 300rpx;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 32rpx auto 0;
  border-radius: 41rpx;
  background: var(--progress-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}

@media (max-width: 340px) {
  .progress-page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .medal {
    width: 138rpx;
    transform: scale(0.88);
    transform-origin: right center;
  }

  .goal-title {
    font-size: 32rpx;
  }

  .overview-value {
    font-size: 32rpx;
  }

  .card-title-row {
    flex-direction: column;
  }

  .trend-headline-value {
    font-size: 38rpx;
    line-height: 46rpx;
  }

  .bar-y-axis,
  .bar-area {
    height: 200rpx;
  }

  .trend-stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .year-stat-value {
    font-size: 34rpx;
    line-height: 42rpx;
  }

  .highlights-grid {
    flex-wrap: wrap;
  }

  .highlight-item {
    flex: 1 1 100%;
  }
}

/* =========================================================
 * 墨绿成长：进度页深色主题，保留山水 Hero
 * ========================================================= */
.progress-page[data-theme="inkGreen"] {
  background:
    radial-gradient(circle at 100% 16%, rgba(91, 143, 122, 0.24), transparent 32%),
    radial-gradient(circle at 0 92%, rgba(70, 122, 101, 0.20), transparent 30%),
    linear-gradient(180deg, #173F34 0%, #1D493C 58%, #15382F 100%);
  color: #FFFFFF;
}

.progress-page[data-theme="inkGreen"] .goal-card {
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 18rpx 44rpx rgba(7, 31, 24, 0.30);
}

.progress-page[data-theme="inkGreen"] .goal-card-shade {
  background: linear-gradient(90deg, rgba(10, 47, 36, 0.52) 0%, rgba(10, 47, 36, 0.22) 60%, rgba(10, 47, 36, 0.04) 100%);
}

.progress-page[data-theme="inkGreen"] .overview-card,
.progress-page[data-theme="inkGreen"] .trend-card,
.progress-page[data-theme="inkGreen"] .milestone-card,
.progress-page[data-theme="inkGreen"] .record-card,
.progress-page[data-theme="inkGreen"] .ai-coach-card--summary {
  border-color: rgba(255, 255, 255, 0.10);
  background: rgba(35, 81, 67, 0.94);
  box-shadow: 0 16rpx 38rpx rgba(7, 31, 24, 0.24);
}

.progress-page[data-theme="inkGreen"] .card-title,
.progress-page[data-theme="inkGreen"] .trend-card .card-title,
.progress-page[data-theme="inkGreen"] .overview-value,
.progress-page[data-theme="inkGreen"] .milestone-label,
.progress-page[data-theme="inkGreen"] .record-title,
.progress-page[data-theme="inkGreen"] .ai-coach-card--summary .ai-coach-title {
  color: #FFFFFF;
}

.progress-page[data-theme="inkGreen"] .card-subtitle,
.progress-page[data-theme="inkGreen"] .overview-label,
.progress-page[data-theme="inkGreen"] .overview-value text,
.progress-page[data-theme="inkGreen"] .milestone-status,
.progress-page[data-theme="inkGreen"] .record-meta,
.progress-page[data-theme="inkGreen"] .record-empty,
.progress-page[data-theme="inkGreen"] .ai-coach-summary {
