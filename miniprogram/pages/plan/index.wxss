/* =========================================================
 * V4 浅色奶油 · 雾绿成长档案最终覆盖
 * 顶部目标卡为动态交互卡（浅奶油渐变底 + 阳光晕），
 * 文案层从 {{goal.title}} / {{levelLabel}} 等数据实时渲染，
 * 卡片 bindtap + 按钮 catchtap + hover-class 提供可见反馈。
 * 整页统一为浅奶油底 + 雾绿卡片 + 金色点缀，去除大面积墨绿。
 * ========================================================= */
.progress-page,
.progress-page[data-theme="inkGreen"] {
  --progress-primary: #2F765E;
  --progress-deep: #294F43;
  --progress-soft: #EAF3EC;
  --progress-accent: #2F765E;
  --progress-gold: #F2B94B;
  --progress-gold-light: #FFF1C7;
  --progress-text: #20322D;
  --progress-secondary: #74847E;
  --progress-muted: #9AA8A3;
  --progress-border: #E7ECE5;
  --progress-shadow: 0 16rpx 42rpx rgba(48, 71, 60, 0.075);
  padding: 28rpx 28rpx calc(170rpx + env(safe-area-inset-bottom));
  background: #F6F3EA;
  color: #20322D;
}

/* 顶部目标卡：参考图背景 + 动态文案 + 可点击按钮 */
.hero-card {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  padding: 34rpx 30rpx 30rpx;
  border-radius: 34rpx;
  background: #FFFDF7;
  box-shadow: 0 20rpx 48rpx rgba(48, 71, 60, 0.10);
  transition: transform 120ms ease, opacity 120ms ease;
}

.hero-card--pressed {
  opacity: 0.96;
  transform: scale(0.995);
}

/* 背景插画层 */
.hero-card-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.hero-card-content {
  position: relative;
  z-index: 2;
}

.hero-eyebrow {
  color: #2F765E;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-title {
  max-width: 500rpx;
  margin-top: 10rpx;
  overflow: hidden;
  color: #20322D;
  font-size: 40rpx;
  line-height: 50rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.hero-chip {
  height: 42rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 16rpx;
  border-radius: 21rpx;
  font-size: 22rpx;
  line-height: 42rpx;
  font-weight: 700;
}

.hero-chip--level {
  background: #FFF1C7;
  color: #8A6C2F;
}

.hero-chip--status {
  background: #EAF5EF;
  color: #2F765E;
}

.hero-period {
  margin-top: 16rpx;
  color: #74847E;
  font-size: 22rpx;
  line-height: 30rpx;
}

.hero-switch-button {
  position: relative;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 26rpx;
  height: 64rpx;
  padding: 0 26rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid #DDEBE1;
  color: #2F765E;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(48, 71, 60, 0.08);
  transition: transform 120ms ease, background 120ms ease;
}

.hero-switch-button--pressed {
  background: #FFFFFF;
  transform: scale(0.97);
}

.hero-switch-arrow {
  width: 10rpx;
  height: 10rpx;
  border-top: 2rpx solid #2F765E;
  border-right: 2rpx solid #2F765E;
  transform: rotate(45deg);
}

/* 原深绿 goal-card 已被动态卡替换，兜底隐藏可能残留子元素 */
.goal-card-bg,
.goal-card-shade {
  display: none;
}

