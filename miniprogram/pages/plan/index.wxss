.progress-page {
  --progress-primary: #145243;
  --progress-deep: #0f4035;
  --progress-soft: #f3f8f5;
  --progress-accent: #55b98b;
  --progress-gold: #f5b94e;
  --progress-gold-light: #fff4cf;
  --progress-text: #173c34;
  --progress-secondary: #6f7f78;
  --progress-muted: #a8b0aa;
  --progress-border: #e8efeb;
  --progress-shadow: 0 8rpx 30rpx rgba(20, 82, 67, 0.08);
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 32rpx calc(210rpx + env(safe-area-inset-bottom));
  background: #f7f8f5;
  color: var(--progress-text);
}

.progress-header {
  padding: 14rpx 0 24rpx;
}

.page-title {
  font-size: 40rpx;
  line-height: 50rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.page-subtitle {
  margin-top: 8rpx;
  color: var(--progress-secondary);
  font-size: 25rpx;
  line-height: 34rpx;
}

.goal-card,
.overview-card,
.trend-card,
.milestone-card,
.record-card,
.state-card {
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: var(--progress-shadow);
}

.goal-card {
  overflow: hidden;
  padding: 30rpx;
  background:
    radial-gradient(circle at 88% 16%, rgba(245, 185, 78, 0.2), transparent 28%),
    radial-gradient(circle at 92% 96%, rgba(255, 255, 255, 0.11), transparent 34%),
    linear-gradient(145deg, #145243 0%, #1d604f 58%, #2c755e 100%);
  color: #ffffff;
}

.goal-card-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}

.goal-copy {
  min-width: 0;
  flex: 1;
}

.section-eyebrow {
  color: rgba(255, 255, 255, 0.66);
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 700;
}

.goal-title {
  max-width: 440rpx;
  margin-top: 10rpx;
  overflow: hidden;
  font-size: 36rpx;
  line-height: 46rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goal-meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
}

.level-chip,
.status-chip {
  height: 42rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 16rpx;
  border-radius: 21rpx;
  font-size: 22rpx;
  line-height: 42rpx;
  font-weight: 700;
}

.level-chip {
  background: rgba(245, 185, 78, 0.18);
  color: #ffd977;
}

.status-chip {
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.86);
}

.goal-period {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  line-height: 32rpx;
}

.medal {
  position: relative;
  width: 164rpx;
  height: 172rpx;
  flex: none;
}

.medal-face {
  position: absolute;
  top: 12rpx;
  left: 24rpx;
  z-index: 3;
  width: 116rpx;
  height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid rgba(255, 239, 174, 0.74);
  border-radius: 50%;
  background:
    radial-gradient(circle at 34% 26%, #fff3b7 0%, #ffd46e 35%, #e6a93c 100%);
  box-shadow: 0 18rpx 32rpx rgba(49, 38, 12, 0.24), inset 0 -10rpx 18rpx rgba(151, 95, 15, 0.16);
}

.medal-star {
  color: #fff2ad;
  font-size: 52rpx;
  line-height: 1;
  text-shadow: 0 4rpx 8rpx rgba(125, 78, 10, 0.2);
}

.medal-ribbon {
  position: absolute;
  top: 104rpx;
  left: 58rpx;
  z-index: 2;
  width: 48rpx;
  height: 62rpx;
  border-radius: 0 0 10rpx 10rpx;
  background: linear-gradient(180deg, #2e765e 0%, #155242 100%);
  box-shadow: inset 0 8rpx 12rpx rgba(255, 255, 255, 0.12);
}

.medal-ribbon::after {
  position: absolute;
  right: 0;
  bottom: -1rpx;
  left: 0;
  width: 0;
  height: 0;
  margin: 0 auto;
  border-right: 24rpx solid transparent;
  border-bottom: 16rpx solid #1c604f;
  border-left: 24rpx solid transparent;
  content: "";
}

.medal-leaf {
  position: absolute;
  top: 76rpx;
  z-index: 1;
  width: 64rpx;
  height: 28rpx;
  border-radius: 100% 10rpx 100% 10rpx;
  background: linear-gradient(135deg, #6caf8c, #2c6f58);
  opacity: 0.92;
}

.leaf-left {
  left: 0;
  transform: rotate(28deg);
}

.leaf-right {
  right: 0;
  transform: rotate(152deg);
}

.medal-spark {
  position: absolute;
  z-index: 4;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffe08a;
  box-shadow: 0 0 14rpx rgba(255, 218, 113, 0.7);
}

.spark-a {
  top: 8rpx;
  right: 16rpx;
}

.spark-b {
  top: 46rpx;
  left: 0;
  width: 9rpx;
  height: 9rpx;
}

.goal-progress-block {
  margin-top: 26rpx;
  padding: 24rpx 24rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.12);
}

.goal-progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 32rpx;
}

.goal-percent {
  color: #ffffff;
  font-size: 34rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.goal-progress-track {
  height: 10rpx;
  overflow: hidden;
  margin-top: 16rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.18);
}

.goal-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #72d39e, #f5d47a);
  transition: width 180ms ease-out;
}

.goal-next-step {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 23rpx;
  line-height: 32rpx;
}

.overview-card,
.trend-card,
.milestone-card,
.record-card {
  margin-top: 26rpx;
  padding: 30rpx 28rpx;
}

.card-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.card-title {
  color: var(--progress-text);
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.card-subtitle {
  margin-top: 6rpx;
  color: var(--progress-muted);
  font-size: 23rpx;
  line-height: 32rpx;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 26rpx;
}

.overview-item {
  min-width: 0;
  padding: 22rpx 16rpx;
  border-radius: 22rpx;
  background: #f7faf8;
  text-align: center;
}

.overview-value {
  color: var(--progress-text);
  font-size: 38rpx;
  line-height: 46rpx;
  font-weight: 800;
}

.overview-value text {
  margin-left: 4rpx;
  color: var(--progress-secondary);
  font-size: 21rpx;
  font-weight: 700;
}

.overview-label {
  margin-top: 8rpx;
  color: var(--progress-secondary);
  font-size: 23rpx;
  line-height: 30rpx;
}

.trend-tabs {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: none;
  padding: 6rpx;
  border-radius: 26rpx;
  background: #f2f6f4;
}

.trend-tab {
  min-width: 56rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 21rpx;
  color: var(--progress-muted);
  font-size: 22rpx;
  font-weight: 700;
}

.trend-tab.is-active {
  background: var(--progress-primary);
  color: #ffffff;
}

.chart-shell {
  display: flex;
  gap: 12rpx;
  margin-top: 28rpx;
}

.y-axis {
  width: 56rpx;
  height: 260rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  flex: none;
  padding: 8rpx 6rpx 2rpx 0;
  box-sizing: border-box;
  color: #b1bbb5;
  font-size: 20rpx;
  line-height: 24rpx;
  white-space: nowrap;
}

.chart-area {
  position: relative;
  height: 260rpx;
  min-width: 0;
  flex: 1;
  overflow: hidden;
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(243, 248, 245, 0.86), rgba(255, 255, 255, 0));
}

.chart-grid {
  position: absolute;
  inset: 18rpx 0 18rpx;
  display: grid;
  grid-template-rows: repeat(3, 1fr);
}

.chart-grid view {
  border-top: 1rpx dashed #e1eae5;
}

.chart-segment {
  position: absolute;
  z-index: 2;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--progress-primary);
  transform-origin: left center;
}

.chart-point {
  position: absolute;
  z-index: 3;
  width: 18rpx;
  height: 18rpx;
  margin-left: -9rpx;
  margin-bottom: -9rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: var(--progress-primary);
  box-shadow: 0 0 0 3rpx rgba(20, 82, 67, 0.16);
}

.chart-point.is-active {
  width: 22rpx;
  height: 22rpx;
  margin-left: -11rpx;
  margin-bottom: -11rpx;
  background: var(--progress-accent);
  box-shadow: 0 0 0 8rpx rgba(85, 185, 139, 0.14);
}

.chart-point.is-zero {
  background: #b8c5be;
  box-shadow: none;
}

.chart-tooltip {
  position: absolute;
  bottom: 34rpx;
  min-width: 112rpx;
  padding: 10rpx 12rpx;
  border-radius: 12rpx;
  background: var(--progress-primary);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 28rpx;
  text-align: center;
  white-space: nowrap;
  box-shadow: 0 10rpx 22rpx rgba(20, 82, 67, 0.2);
}

.chart-tooltip text {
  display: block;
  margin-top: 2rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 19rpx;
}

.tooltip-center {
  left: 50%;
  transform: translateX(-50%);
}

.tooltip-left {
  left: -4rpx;
}

.tooltip-right {
  right: -4rpx;
}

.chart-empty {
  position: absolute;
  inset: 0;
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  text-align: center;
}

.chart-empty view {
  color: var(--progress-text);
  font-size: 27rpx;
  line-height: 36rpx;
  font-weight: 700;
}

.chart-empty text {
  margin-top: 8rpx;
  color: var(--progress-muted);
  font-size: 22rpx;
  line-height: 30rpx;
}

.chart-labels {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(0, 1fr);
  margin: 12rpx 0 0 68rpx;
  color: var(--progress-muted);
  font-size: 21rpx;
  line-height: 28rpx;
  text-align: center;
}

.trend-summary {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: var(--progress-soft);
  color: var(--progress-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.milestone-row {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  margin-top: 28rpx;
}

.milestone-item {
  position: relative;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.milestone-line {
  position: absolute;
  top: 38rpx;
  right: 50%;
  left: -50%;
  height: 2rpx;
  background: #e2ebe6;
}

.milestone-item:first-child .milestone-line {
  display: none;
}

.mini-medal {
  position: relative;
  z-index: 2;
  width: 76rpx;
  height: 86rpx;
}

.mini-medal-face {
  position: absolute;
  top: 0;
  left: 8rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 4rpx solid #e2e9e5;
  background: #f1f4f2;
  color: #a8b0aa;
  font-size: 28rpx;
  box-sizing: border-box;
}

.mini-medal-ribbon {
  position: absolute;
  top: 52rpx;
  left: 26rpx;
  width: 24rpx;
  height: 28rpx;
  border-radius: 0 0 6rpx 6rpx;
  background: #c7d1cb;
}

.state-achieved .milestone-line {
  background: rgba(245, 185, 78, 0.52);
}

.state-achieved .mini-medal-face {
  border-color: rgba(255, 224, 138, 0.8);
  background: radial-gradient(circle at 34% 24%, #fff7c8, #f5b94e);
  color: #fff5c4;
  box-shadow: 0 8rpx 18rpx rgba(245, 185, 78, 0.24);
}

.state-achieved .mini-medal-ribbon {
  background: var(--progress-primary);
}

.state-current .mini-medal-face {
  border-color: var(--progress-primary);
  background: #f8fbf9;
  color: var(--progress-primary);
  box-shadow: 0 0 0 8rpx rgba(20, 82, 67, 0.08);
}

.state-current .mini-medal-ribbon {
  background: var(--progress-accent);
}

.milestone-label {
  margin-top: 4rpx;
  color: var(--progress-text);
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 800;
}

.milestone-status {
  margin-top: 2rpx;
  color: var(--progress-muted);
  font-size: 19rpx;
  line-height: 26rpx;
}

.state-achieved .milestone-status {
  color: #c99024;
}

.state-current .milestone-status {
  color: var(--progress-primary);
  font-weight: 700;
}

.review-link {
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid #d8e5df;
  border-radius: 25rpx;
  background: #ffffff;
  color: var(--progress-primary);
  font-size: 22rpx;
  line-height: 50rpx;
  font-weight: 700;
}

.review-link::after,
.primary-action::after {
  display: none;
}

.record-list {
  margin-top: 24rpx;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
}

.record-item + .record-item {
  border-top: 1rpx solid var(--progress-border);
}

.record-check {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  background: #e8f6ef;
  color: var(--progress-primary);
  font-size: 24rpx;
  font-weight: 800;
}

.record-copy {
  min-width: 0;
  flex: 1;
}

.record-title {
  overflow: hidden;
  color: var(--progress-text);
  font-size: 27rpx;
  line-height: 36rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-meta {
  margin-top: 4rpx;
  color: var(--progress-secondary);
  font-size: 23rpx;
  line-height: 30rpx;
}

.record-empty {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f7faf8;
  color: var(--progress-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.state-card {
  margin-top: 80rpx;
  padding: 54rpx 34rpx;
  text-align: center;
}

.state-orbit,
.state-mark {
  width: 86rpx;
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: var(--progress-soft);
  color: var(--progress-primary);
  font-size: 34rpx;
  font-weight: 800;
}

.state-orbit {
  border: 6rpx solid #e4efe9;
  border-top-color: var(--progress-primary);
}

.state-title {
  color: var(--progress-text);
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 800;
}

.state-description {
  margin-top: 12rpx;
  color: var(--progress-secondary);
  font-size: 25rpx;
  line-height: 36rpx;
}

.primary-action {
  width: 300rpx;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 32rpx auto 0;
  border-radius: 41rpx;
  background: var(--progress-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}

@media (max-width: 340px) {
  .progress-page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .medal {
    width: 138rpx;
    transform: scale(0.88);
    transform-origin: right center;
  }

  .goal-title {
    font-size: 32rpx;
  }

  .overview-value {
    font-size: 32rpx;
  }

  .card-title-row {
    flex-direction: column;
  }
}
