.ai-coach-card--summary .ai-coach-title-text {
  flex: 1;
  min-width: 0;
}

.ai-coach-card--summary .ai-coach-subtitle {
  display: block;
  margin-top: 4rpx;
  color: #64766B;
  font-size: 24rpx;
  line-height: 30rpx;
  font-weight: 400;
}

.ai-coach-card--summary .ai-coach-title {
  color: #14251E;
  font-size: 38rpx;
  line-height: 44rpx;
  font-weight: 700;
}

/* AI 头像 */
.ai-coach-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #EAF5EF;
  border: 2rpx solid #CFE5D5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

