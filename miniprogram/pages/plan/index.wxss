.progress-page{padding-top:36rpx}.archive-hero{min-height:330rpx}.hero-kicker{position:relative;color:#e8c97f;font-size:20rpx;letter-spacing:3rpx}.hero-title{position:relative;margin-top:10rpx;font-size:52rpx;font-weight:750}.hero-goal{position:relative;margin-top:12rpx;color:rgba(255,255,255,.72)}.hero-rate{position:absolute;right:42rpx;bottom:62rpx;font-size:78rpx;font-weight:760;color:#f3c76a}.rate-unit{font-size:28rpx}.hero-copy{position:absolute;right:42rpx;bottom:36rpx;color:rgba(255,255,255,.65);font-size:21rpx}
.metric-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:24rpx}.metric-card{padding:28rpx;border-radius:28rpx}.metric-card.green{background:#dcebe4}.metric-card.gold{background:#fff0c9}.metric-card.coral{background:#f5ddd7}.metric-card.blue{background:#e1ebf3}.metric-value{font-size:42rpx;font-weight:750}.metric-label{margin-top:6rpx;color:#66736f;font-size:23rpx}
.today-card{margin-top:24rpx}.section-title{font-size:32rpx;font-weight:700}.today-count{margin-top:18rpx;color:#66736f}.today-count text{color:#356859;font-size:40rpx;font-weight:750}.progress-track{height:18rpx;margin-top:18rpx;border-radius:999rpx;background:#edf0ea;overflow:hidden}.progress-fill{height:100%;border-radius:inherit;background:linear-gradient(90deg,#356859,#8bbf72)}
.section-gap{margin:34rpx 4rpx 18rpx}.week-card{display:flex;justify-content:space-between;padding:24rpx 12rpx}.day-column{width:14%;padding:8rpx 2rpx 10rpx;border-radius:20rpx;text-align:center}.day-today{background:#eff7f2}.day-bar-wrap{height:100rpx;display:flex;align-items:flex-end;justify-content:center}.day-bar{width:22rpx;border-radius:999rpx;background:#e7ebe8}.day-done{background:#8bbf72}.day-partial{background:#f3c76a}.day-label{margin-top:10rpx;font-size:20rpx}.day-today .day-label{color:#356859;font-weight:700}.day-state{margin-top:5rpx;color:#9aa6a1;font-size:17rpx;white-space:nowrap}
.pending-section-header{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;width:100%;box-sizing:border-box;margin:40rpx 0 18rpx}.pending-section-left{min-width:0;flex:1}.pending-section-right{display:flex;flex-direction:column;align-items:flex-end;flex-shrink:0;min-width:118rpx}.section-copy{margin-top:7rpx;color:#8a9a93;font-size:24rpx;line-height:1.35}.mini-add{display:inline-flex;align-items:center;justify-content:center;min-height:48rpx;padding:0;background:transparent;color:#2f6f61;font-size:30rpx;font-weight:600;line-height:1}.mini-add:active{color:#1f4d42;opacity:.78}.pending-count{margin-top:10rpx;color:#a0aaa5;font-size:24rpx;line-height:1.35}
.pending-card{width:100%;min-height:0;display:flex;align-items:center;justify-content:space-between;gap:24rpx;box-sizing:border-box;margin-bottom:16rpx;padding:28rpx 28rpx;text-align:left;border:1rpx solid #e6ece8;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(21,71,58,.06)}.pending-card:active{background:#f8fbf9}.pending-main{min-width:0;flex:1}.pending-tags{display:flex;align-items:center;flex-wrap:wrap;gap:10rpx}.pending-status,.pending-date{display:inline-flex;align-items:center;min-height:36rpx;box-sizing:border-box;padding:0 12rpx;border-radius:999rpx;font-size:22rpx;font-weight:500}.pending-status{background:#fff6df;color:#8a6730}.pending-date{background:#eef7f2;color:#6b837a}.pending-title{margin-top:14rpx;color:#1f352f;font-size:31rpx;font-weight:700;line-height:1.4}.pending-description{display:-webkit-box;overflow:hidden;margin-top:8rpx;color:#66736f;font-size:24rpx;line-height:1.5;-webkit-box-orient:vertical;-webkit-line-clamp:2}.pending-meta{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx;color:#66736f;font-size:22rpx}.pending-meta text{padding:6rpx 14rpx;border-radius:999rpx;background:#f5f8f6;color:#66736f}.pending-arrow{width:48rpx;height:48rpx;display:flex;align-items:center;justify-content:center;flex:none;border-radius:999rpx;background:#f3f7f4;color:#8a9a93;font-size:36rpx}.empty-copy{color:#66736f;line-height:1.6}
