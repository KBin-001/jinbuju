.progress-page {
  --progress-primary: #3F8F72;
  --progress-deep: #24584A;
  --progress-soft: #EFF8F3;
  --progress-accent: #68BE8F;
  --progress-gold: #F4C95D;
  --progress-gold-light: #FFF4D8;
  --progress-text: #244C43;
  --progress-secondary: #6F827B;
  --progress-muted: #9AA8A3;
  --progress-border: #E2EEE8;
  --progress-shadow: 0 8rpx 28rpx rgba(36, 88, 74, 0.08);
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 32rpx calc(210rpx + env(safe-area-inset-bottom));
  background: #F6FAF7;
  color: var(--progress-text);
}

.progress-header {
  padding: 14rpx 0 24rpx;
}

.page-title {
  font-size: 40rpx;
  line-height: 50rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.page-subtitle {
  margin-top: 8rpx;
  color: var(--progress-secondary);
  font-size: 25rpx;
  line-height: 34rpx;
}

.goal-card,
.overview-card,
.trend-card,
.milestone-card,
.record-card,
.state-card {
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: var(--progress-shadow);
}

.goal-card {
  overflow: hidden;
  padding: 30rpx;
  background:
    radial-gradient(circle at 88% 16%, rgba(244, 201, 93, 0.22), transparent 28%),
    radial-gradient(circle at 92% 96%, rgba(124, 198, 160, 0.16), transparent 34%),
    var(--gradient-card-mint);
  color: var(--progress-text);
  box-shadow: var(--progress-shadow);
  border-radius: 28rpx;
}

.goal-card-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}

.goal-copy {
  min-width: 0;
  flex: 1;
}

.section-eyebrow {
  color: var(--progress-primary);
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 700;
}

.goal-title {
  max-width: 440rpx;
  margin-top: 10rpx;
  overflow: hidden;
  font-size: 36rpx;
  line-height: 46rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goal-meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
}

.level-chip,
.status-chip {
  height: 42rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 16rpx;
  border-radius: 21rpx;
  font-size: 22rpx;
  line-height: 42rpx;
  font-weight: 700;
}

.level-chip {
  background: rgba(244, 201, 93, 0.18);
  color: #B68A1C;
}

.status-chip {
  background: rgba(124, 198, 160, 0.18);
  color: var(--progress-primary);
}

.goal-period {
  margin-top: 18rpx;
  color: var(--progress-secondary);
  font-size: 24rpx;
  line-height: 32rpx;
}

.goal-switch-button {
  height: 72rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  flex: none;
  box-sizing: border-box;
  padding: 0 28rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.7);
  color: var(--progress-primary);
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 700;
  border: 1rpx solid var(--progress-border);
}

.goal-switch-button:active {
  background: var(--color-card);
  transform: scale(0.98);
}

.goal-switch-arrow {
  width: 0;
  height: 0;
  border-top: 8rpx solid var(--progress-primary);
  border-right: 7rpx solid transparent;
  border-left: 7rpx solid transparent;
}

.goal-picker-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.goal-picker-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(36, 76, 67, 0.32);
  backdrop-filter: blur(6rpx);
}

.goal-picker-panel {
  position: relative;
  width: 100%;
  max-height: calc(100vh - 180rpx);
  overflow-y: auto;
  box-sizing: border-box;
  padding: 16rpx 32rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #F6FAF7;
  box-shadow: var(--shadow-float);
}

.goal-picker-grabber {
  width: 70rpx;
  height: 7rpx;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  background: #cbd6d0;
}

.goal-picker-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.goal-picker-kicker {
  color: var(--progress-primary);
  font-size: 20rpx;
  line-height: 28rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.goal-picker-title {
  margin-top: 6rpx;
  color: var(--progress-text);
  font-size: 34rpx;
  line-height: 42rpx;
  font-weight: 800;
}

.goal-picker-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  background: #ffffff;
  color: var(--progress-secondary);
  font-size: 36rpx;
  line-height: 1;
}

.goal-picker-list {
  margin-top: 24rpx;
}

.goal-option {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(36, 88, 74, 0.05);
}

.goal-option + .goal-option {
  margin-top: 18rpx;
}

.goal-option.is-active {
  border-color: rgba(63, 143, 114, 0.32);
  background: var(--color-primary-soft);
}

.goal-option-main {
  min-width: 0;
  flex: 1;
}

.goal-option-title {
  overflow: hidden;
  color: var(--progress-text);
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goal-option-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
  color: var(--progress-secondary);
  font-size: 23rpx;
  line-height: 32rpx;
}

.goal-option-track {
  height: 12rpx;
  overflow: hidden;
  margin-top: 16rpx;
  border-radius: 6rpx;
  background: #E2EEE8;
}

.goal-option-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #7CC6A0 0%, #3F8F72 100%);
}

.goal-option-action {
  height: 46rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  padding: 0 18rpx;
  border-radius: 23rpx;
  background: var(--progress-primary);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.goal-option.is-active .goal-option-action {
  background: var(--color-primary-soft);
  color: var(--progress-primary);
}

.medal {
  position: relative;
  width: 164rpx;
  height: 172rpx;
  flex: none;
}

.medal-face {
  position: absolute;
  top: 12rpx;
  left: 24rpx;
  z-index: 3;
  width: 116rpx;
  height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid rgba(255, 239, 174, 0.74);
  border-radius: 50%;
  background:
    radial-gradient(circle at 34% 26%, #fff3b7 0%, #ffd46e 35%, #e6a93c 100%);
  box-shadow: 0 18rpx 32rpx rgba(49, 38, 12, 0.24), inset 0 -10rpx 18rpx rgba(151, 95, 15, 0.16);
}

.medal-star {
  color: #fff2ad;
  font-size: 52rpx;
  line-height: 1;
  text-shadow: 0 4rpx 8rpx rgba(125, 78, 10, 0.2);
}

.medal-ribbon {
  position: absolute;
  top: 104rpx;
  left: 58rpx;
  z-index: 2;
  width: 48rpx;
  height: 62rpx;
  border-radius: 0 0 10rpx 10rpx;
  background: linear-gradient(180deg, #7CC6A0 0%, #3F8F72 100%);
  box-shadow: inset 0 8rpx 12rpx rgba(255, 255, 255, 0.12);
}

.medal-ribbon::after {
  position: absolute;
  right: 0;
  bottom: -1rpx;
  left: 0;
  width: 0;
  height: 0;
  margin: 0 auto;
  border-right: 24rpx solid transparent;
  border-bottom: 16rpx solid #3F8F72;
  border-left: 24rpx solid transparent;
  content: "";
}

.medal-leaf {
  position: absolute;
  top: 76rpx;
  z-index: 1;
  width: 64rpx;
  height: 28rpx;
  border-radius: 100% 10rpx 100% 10rpx;
  background: linear-gradient(135deg, #9BD9B7, #68BE8F);
  opacity: 0.92;
}

.leaf-left {
  left: 0;
  transform: rotate(28deg);
}

.leaf-right {
  right: 0;
  transform: rotate(152deg);
}

.medal-spark {
  position: absolute;
  z-index: 4;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffe08a;
  box-shadow: 0 0 14rpx rgba(255, 218, 113, 0.7);
}

.spark-a {
  top: 8rpx;
  right: 16rpx;
}

.spark-b {
  top: 46rpx;
  left: 0;
  width: 9rpx;
  height: 9rpx;
}

.overview-card,
.trend-card,
.milestone-card,
.record-card {
  margin-top: 26rpx;
  padding: 30rpx 28rpx;
}

.card-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.card-title {
  color: var(--progress-text);
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.card-subtitle {
  margin-top: 6rpx;
  color: var(--progress-muted);
  font-size: 23rpx;
  line-height: 32rpx;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 26rpx;
}

.overview-item {
  min-width: 0;
  padding: 22rpx 16rpx;
  border-radius: 22rpx;
  background: #f7faf8;
  text-align: center;
}

.overview-value {
  color: var(--progress-text);
  font-size: 38rpx;
  line-height: 46rpx;
  font-weight: 800;
}

.overview-value text {
  margin-left: 4rpx;
  color: var(--progress-secondary);
  font-size: 21rpx;
  font-weight: 700;
}

.overview-label {
  margin-top: 8rpx;
  color: var(--progress-secondary);
  font-size: 23rpx;
  line-height: 30rpx;
}

.trend-range-tabs {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex: none;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #eef3f0;
}

.trend-range-tab {
  min-width: 60rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #6F827B;
  font-size: 24rpx;
  font-weight: 700;
}

.trend-range-tab.is-active {
  background: var(--progress-primary);
  color: #ffffff;
}

.trend-headline {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(104, 190, 143, 0.14), rgba(63, 143, 114, 0.04));
}

.trend-headline-item {
  flex: 1;
  min-width: 0;
}

.trend-headline-value {
  color: var(--progress-text);
  font-size: 44rpx;
  line-height: 52rpx;
  font-weight: 800;
}

.trend-headline-value text {
  margin-left: 6rpx;
  color: var(--progress-secondary);
  font-size: 22rpx;
  font-weight: 600;
}

.trend-headline-label {
  margin-top: 4rpx;
  color: var(--progress-secondary);
  font-size: 23rpx;
  line-height: 30rpx;
}

.trend-headline-divider {
  width: 1rpx;
  height: 56rpx;
  background: #dfe7e2;
}

.trend-insufficient {
  margin-top: 28rpx;
  padding: 32rpx 24rpx;
  border-radius: 20rpx;
  background: var(--progress-soft);
  color: var(--progress-secondary);
  font-size: 25rpx;
  line-height: 38rpx;
  text-align: center;
}

.bar-chart {
  display: flex;
  gap: 14rpx;
  margin-top: 28rpx;
}

.bar-y-axis {
  width: 52rpx;
  height: 300rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  flex: none;
  padding: 6rpx 4rpx 0 0;
  box-sizing: border-box;
  color: #9aa5a0;
  font-size: 20rpx;
  line-height: 24rpx;
  white-space: nowrap;
}

.bar-area {
  position: relative;
  height: 300rpx;
  min-width: 0;
  flex: 1;
  overflow: visible;
}

.line-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 2;
}

.bar-grid {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-rows: repeat(4, 1fr);
}

.bar-grid view {
  border-top: 1rpx dashed #eef2ef;
}

.bar-grid view:last-child {
  border-bottom: 1rpx dashed #eef2ef;
}

.bar-columns {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
}

.bar-column {
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
}

.bar-fill {
  border-radius: 10rpx;
  background: linear-gradient(180deg, #9BD9B7, #7CC6A0);
  transition: height 200ms ease-out, background 200ms ease-out;
}

.bar-fill.is-max {
  background: linear-gradient(180deg, #3F8F72, #24584A);
}

.bar-fill.is-today {
  box-shadow: 0 0 0 3rpx rgba(63, 143, 114, 0.18);
}

.bar-column.is-active .bar-fill {
  background: linear-gradient(180deg, #3F8F72, #24584A);
}

.bar-tooltip {
  position: absolute;
  z-index: 3;
  min-width: 120rpx;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  background: var(--progress-primary);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
  white-space: nowrap;
  box-shadow: 0 10rpx 24rpx rgba(63, 143, 114, 0.22);
}

.bar-tooltip text {
  display: block;
  margin-top: 2rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 20rpx;
}

.bar-tooltip::after {
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  width: 0;
  height: 0;
  margin-left: -8rpx;
  border-right: 8rpx solid transparent;
  border-top: 8rpx solid var(--progress-primary);
  border-left: 8rpx solid transparent;
  content: "";
}

.tooltip-center {
  left: 50%;
  transform: translateX(-50%);
}

.tooltip-left {
  left: 0;
}

.tooltip-left::after {
  left: 24rpx;
  margin-left: 0;
}

.tooltip-right {
  right: 0;
}

.tooltip-right::after {
  left: auto;
  right: 24rpx;
  margin-left: 0;
}

.bar-labels {
  display: flex;
  justify-content: space-around;
  margin: 14rpx 0 0 66rpx;
  color: #9aa5a0;
  font-size: 21rpx;
  line-height: 28rpx;
  text-align: center;
}

.ai-coach-card {
  margin-top: 24rpx;
  padding: 28rpx 26rpx;
  border-radius: 28rpx;
  background: var(--gradient-card-mint);
  color: var(--progress-text);
  box-shadow: var(--progress-shadow);
  border: 1rpx solid rgba(124, 198, 160, 0.18);
}

.ai-coach-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.ai-coach-title-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.ai-coach-icon {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 18rpx;
  background: rgba(63, 143, 114, 0.16);
  color: var(--progress-primary);
  font-size: 28rpx;
  font-weight: 800;
}

.ai-coach-title {
  color: var(--progress-text);
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 850;
}

.ai-coach-period {
  flex: none;
  color: var(--progress-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.ai-coach-point {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.7);
  color: var(--progress-text);
  font-size: 26rpx;
  line-height: 38rpx;
  font-weight: 650;
}

.ai-coach-point-warning {
  margin-top: 14rpx;
}

.ai-coach-point-icon {
  flex: none;
  color: #B68A1C;
  font-size: 25rpx;
  font-weight: 850;
}

.ai-coach-action {
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 22rpx;
  border-radius: 35rpx;
  background: var(--progress-primary);
  color: #ffffff;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 18rpx rgba(63, 143, 114, 0.22);
}

.trend-summary {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: var(--progress-soft);
  color: var(--progress-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.trend-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 22rpx;
}

.trend-stat-item {
  padding: 20rpx 10rpx;
  border-radius: 18rpx;
  background: #f7faf8;
  text-align: center;
}

.trend-stat-value {
  color: var(--progress-text);
  font-size: 36rpx;
  line-height: 44rpx;
  font-weight: 800;
}

.trend-stat-value text {
  margin-left: 4rpx;
  color: var(--progress-secondary);
  font-size: 20rpx;
  font-weight: 600;
}

.trend-stat-label {
  margin-top: 6rpx;
  color: var(--progress-secondary);
  font-size: 22rpx;
  line-height: 28rpx;
}

/* 目标投入 · reference aligned redesign */
.trend-card {
  padding: 26rpx 24rpx 26rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(36, 88, 74, 0.06);
}

.trend-card .card-title-row {
  align-items: flex-start;
}

.trend-card .card-title {
  color: #151918;
  font-size: 34rpx;
  line-height: 42rpx;
  font-weight: 850;
}

.trend-card .card-subtitle {
  margin-top: 6rpx;
  color: #7a827e;
  font-size: 23rpx;
  line-height: 30rpx;
}

.trend-card .trend-range-tabs {
  gap: 0;
  padding: 0;
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  border-radius: 28rpx;
  background: #ffffff;
}

.trend-card .trend-range-tab {
  min-width: 66rpx;
  height: 46rpx;
  padding: 0 20rpx;
  border-radius: 0;
  color: #464b49;
  font-size: 24rpx;
  font-weight: 650;
}

.trend-card .trend-range-tab + .trend-range-tab {
  border-left: 1rpx solid var(--color-border-soft);
}

.trend-card .trend-range-tab.is-active {
  border-radius: 26rpx 0 0 26rpx;
  background: linear-gradient(135deg, #3F8F72 0%, #24584A 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 14rpx rgba(63, 143, 114, 0.18);
}

.trend-metric-panel {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 14rpx 0 18rpx;
  border-bottom: 1rpx solid #edf1ed;
}

.trend-metric-item {
  min-width: 0;
  flex: 1;
}

.trend-metric-divider {
  width: 1rpx;
  align-self: stretch;
  background: #e7e3dc;
}

.trend-metric-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.metric-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  flex: none;
  border-radius: 50%;
  background: #eef5f1;
}

.metric-clock::before {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #3F8F72;
  content: "";
}

.metric-clock::after {
  position: absolute;
  top: 13rpx;
  left: 17rpx;
  width: 9rpx;
  height: 10rpx;
  border-left: 2rpx solid #ffffff;
  border-bottom: 2rpx solid #ffffff;
  border-radius: 0 0 0 3rpx;
  content: "";
}

.metric-check::before {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #3F8F72;
  content: "";
}

.metric-check::after {
  position: absolute;
  top: 15rpx;
  left: 15rpx;
  width: 10rpx;
  height: 6rpx;
  border-left: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(-45deg);
  content: "";
}

.trend-metric-name {
