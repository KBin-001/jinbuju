@import "../../styles/glass.wxss";

.progress-page {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  padding: 0 28rpx calc(164rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #F6F3EA 0, #EEF5EF 360rpx, #F5F7F2 760rpx);
  color: #233B34;
}

.progress-ambient {
  position: absolute;
  z-index: 0;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(2rpx);
}

.progress-ambient--one {
  width: 360rpx;
  height: 360rpx;
  top: -160rpx;
  right: -130rpx;
  background: rgba(199, 225, 207, 0.44);
}

.progress-ambient--two {
  width: 260rpx;
  height: 260rpx;
  top: 250rpx;
  left: -180rpx;
  background: rgba(248, 210, 106, 0.13);
}

.hero-card,
.overview-card,
.trend-card,
.ai-coach-card,
.milestone-card,
.record-card,
.state-card {
  position: relative;
  z-index: 1;
}

.hero-card,
.overview-card,
.trend-card,
.ai-coach-card,
.milestone-card,
.record-card,
.state-card {
  box-sizing: border-box;
  width: 100%;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  border-color: rgba(255, 255, 255, 0.84);
  box-shadow: 0 16rpx 40rpx rgba(31, 70, 58, 0.075);
}

.overview-card,
.trend-card,
.ai-coach-card,
.milestone-card,
.record-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.card-pressed {
  opacity: 0.84;
  transform: scale(0.992);
}

.hero-card {
  min-height: 350rpx;
  overflow: hidden;
  padding: 34rpx 30rpx 28rpx;
}

.hero-card-bg,
.hero-card-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.hero-card-bg { z-index: 0; }

.hero-card-shade {
  z-index: 1;
  background: linear-gradient(90deg, rgba(255, 253, 247, 0.98) 0%, rgba(255, 253, 247, 0.93) 45%, rgba(255, 253, 247, 0.20) 76%, rgba(255, 253, 247, 0.04) 100%);
}

.hero-card-content {
  position: relative;
  z-index: 2;
  width: 66%;
}

.hero-eyebrow {
  color: #356859;
  font-size: 22rpx;
  font-weight: 700;
}

.hero-title {
  max-width: 100%;
  margin-top: 8rpx;
  overflow: hidden;
  color: #1D322B;
  font-size: 38rpx;
  line-height: 50rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-status {
  max-width: 100%;
  min-height: 40rpx;
  margin-top: 12rpx;
  padding: 0 14rpx;
  overflow: hidden;
  color: #356859;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-status-dot {
  width: 9rpx;
  height: 9rpx;
  margin-right: 9rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #2DA879;
}

.hero-progress-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 24rpx;
  color: #71827A;
  font-size: 21rpx;
}

.hero-progress-value {
  color: #234D40;
  font-size: 29rpx;
  line-height: 34rpx;
  font-weight: 800;
}

.hero-progress {
  height: 9rpx;
  margin-top: 10rpx;
  background: rgba(53, 104, 89, 0.11);
}

.hero-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
}

.hero-period {
  max-width: 220rpx;
  overflow: hidden;
  color: #71827A;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-switch-button {
  display: flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 17rpx;
  border: 1rpx solid rgba(53, 104, 89, 0.13);
  border-radius: 25rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #356859;
  font-size: 20rpx;
  font-weight: 700;
  box-shadow: 0 7rpx 18rpx rgba(31, 70, 58, 0.06);
}

.hero-switch-arrow {
  margin-left: 6rpx;
  font-size: 28rpx;
  line-height: 24rpx;
}

.card-title-row,
.ai-coach-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.card-title {
  color: #203730;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.card-subtitle {
  margin-top: 4rpx;
  color: #7B8B84;
  font-size: 21rpx;
  line-height: 31rpx;
}

.overview-chip {
  min-height: 42rpx;
  padding: 0 14rpx;
  color: #8A6A22;
  font-size: 19rpx;
  background: rgba(255, 245, 211, 0.92);
}

.overview-grid {
  display: flex;
  margin-top: 25rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #E8EEE9;
}

.overview-item {
  position: relative;
  min-width: 0;
  flex: 1;
  text-align: center;
}

.overview-item + .overview-item::before {
  position: absolute;
  width: 1rpx;
  height: 76rpx;
  top: 12rpx;
  left: 0;
  background: #E8EEE9;
  content: "";
}

.overview-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  margin: 0 auto 8rpx;
  border-radius: 12rpx;
  background: #EAF5EF;
  color: #356859;
  font-size: 18rpx;
  font-weight: 800;
}

.overview-icon--2 {
  background: #FFF1C7;
  color: #A57A17;
}

.overview-value {
  overflow: hidden;
  color: #244D40;
  font-size: 34rpx;
  line-height: 42rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.value-unit {
  margin-left: 4rpx;
  color: #71827A;
  font-size: 18rpx;
  font-weight: 600;
}

.overview-label {
  margin-top: 3rpx;
  color: #7B8B84;
  font-size: 20rpx;
}

.trend-head { align-items: center; }

.trend-range-tabs {
  display: flex;
  box-sizing: border-box;
  height: 58rpx;
  padding: 5rpx;
  flex: 0 0 auto;
  border-radius: 29rpx;
  background: #EDF2EE;
}

.trend-range-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 48rpx;
  border-radius: 24rpx;
  color: #78877F;
  font-size: 21rpx;
  font-weight: 600;
}

.trend-range-tab.is-active {
  background: #FFFFFF;
  color: #356859;
  font-weight: 800;
  box-shadow: 0 6rpx 16rpx rgba(31, 70, 58, 0.10);
}

.trend-metric-panel,
.year-top-stats {
  display: flex;
  align-items: stretch;
  margin-top: 25rpx;
  padding: 22rpx;
  border: 1rpx solid #E6EEE9;
  border-radius: 24rpx;
  background: #F5F8F4;
}

.trend-metric-item {
  min-width: 0;
  flex: 1;
}

.trend-metric-divider {
  width: 1rpx;
  margin: 0 24rpx;
  background: #E0E9E3;
}

.trend-metric-name,
.trend-stat-label,
.year-stat-label {
  color: #71827A;
  font-size: 20rpx;
}

.trend-metric-value {
  margin-top: 8rpx;
  color: #203730;
  font-size: 36rpx;
  line-height: 44rpx;
  font-weight: 800;
}

.trend-metric-compare {
  margin-top: 6rpx;
  color: #77877F;
  font-size: 18rpx;
  line-height: 28rpx;
}

.compare-up { color: #2B8A68; }
.compare-down { color: #A67B20; }

.trend-insufficient,
.trend-summary {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(229, 181, 68, 0.22);
  border-radius: 20rpx;
  background: #FFF8E4;
  color: #886A28;
  font-size: 21rpx;
  line-height: 34rpx;
}

.chart-title-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 24rpx;
  padding-left: 52rpx;
}

.chart-legend {
  display: flex;
  align-items: center;
  color: #71827A;
  font-size: 18rpx;
}

.legend-dot {
  width: 11rpx;
  height: 11rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #356859;
}

.legend-line {
  position: relative;
  width: 22rpx;
  height: 3rpx;
  margin-right: 8rpx;
  border-radius: 3rpx;
  background: #F0B83F;
}

.legend-line::after {
  position: absolute;
  width: 7rpx;
  height: 7rpx;
  top: -2rpx;
  left: 8rpx;
  border-radius: 50%;
  background: #F0B83F;
  content: "";
}

.bar-chart {
  display: flex;
  height: 300rpx;
  margin-top: 10rpx;
}

.bar-y-axis {
  display: flex;
  width: 48rpx;
  padding: 8rpx 8rpx 8rpx 0;
  flex: 0 0 auto;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  color: #96A19C;
  font-size: 17rpx;
  text-align: right;
}

.bar-area {
  position: relative;
  min-width: 0;
  flex: 1;
}

.bar-grid,
.bar-columns,
.line-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.bar-grid {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.bar-grid-line {
  width: 100%;
  border-top: 1rpx solid #E8EEE9;
}

.bar-columns {
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
}

.bar-column {
  position: relative;
  display: flex;
  height: 100%;
  min-width: 32rpx;
  align-items: flex-end;
  justify-content: center;
}

.bar-fill {
  min-height: 4rpx;
  border-radius: 12rpx 12rpx 5rpx 5rpx;
  background: linear-gradient(180deg, #C7E1D0, #90C1A5);
}

.bar-fill.is-max,
.bar-column.is-active .bar-fill {
  background: linear-gradient(180deg, #4D8B74, #356859);
  box-shadow: 0 9rpx 20rpx rgba(53, 104, 89, 0.18);
}

.line-canvas {
  z-index: 3;
  pointer-events: none;
}

.bar-tooltip {
  position: absolute;
  z-index: 5;
  min-width: 112rpx;
  padding: 10rpx 12rpx;
  border-radius: 13rpx;
  background: #244D40;
  color: #FFFFFF;
  font-size: 18rpx;
  line-height: 27rpx;
  text-align: center;
  box-shadow: 0 9rpx 20rpx rgba(31, 70, 58, 0.16);
  transform: translateX(-50%);
}

.bar-tooltip-sub { display: block; color: #CDE1D7; font-size: 16rpx; }
.tooltip-left { left: 0; transform: none; }
.tooltip-center { left: 50%; }
.tooltip-right { right: 0; transform: none; }

.bar-labels {
  display: flex;
  margin-left: 48rpx;
  color: #8B9892;
  font-size: 17rpx;
}

.bar-label {
  min-width: 0;
  flex: 1;
  text-align: center;
}

.trend-stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.trend-stat-item {
  padding: 18rpx;
  border: 1rpx solid #E8EEE9;
  border-radius: 20rpx;
  background: rgba(248, 250, 247, 0.88);
}

.trend-stat-value {
  margin-top: 5rpx;
  overflow: hidden;
  color: #294F43;
  font-size: 29rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trend-stat-value--text { font-size: 23rpx; }

.year-top-stats { justify-content: space-between; }
.year-stat-item { min-width: 0; flex: 1; text-align: center; }
.year-stat-item + .year-stat-item { border-left: 1rpx solid #E0E9E3; }
.year-stat-value { color: #294F43; font-size: 31rpx; font-weight: 800; }
.year-stat-label { margin-top: 6rpx; }

.heatmap-scroll {
  width: 100%;
  margin-top: 24rpx;
}

.heatmap-inner { width: 1050rpx; }
.heatmap-months-row,
.heatmap-body-row { display: flex; }
.heatmap-weekday-spacer { width: 36rpx; flex: 0 0 auto; }
.heatmap-months { position: relative; width: 1014rpx; height: 28rpx; }
.heatmap-month-label { position: absolute; color: #85928C; font-size: 17rpx; }
.heatmap-weekdays { position: relative; width: 36rpx; height: 128rpx; flex: 0 0 auto; }
.heatmap-weekday { position: absolute; color: #85928C; font-size: 17rpx; }
.heatmap-grid { display: flex; gap: 5rpx; }
.heatmap-column { display: flex; flex-direction: column; gap: 5rpx; }

.heatmap-cell,
.legend-cell {
  box-sizing: border-box;
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  background: #EDF2EE;
}

.heatmap-cell.level-1, .legend-cell.level-1 { background: #CFE3D6; }
.heatmap-cell.level-2, .legend-cell.level-2 { background: #9CC8AE; }
.heatmap-cell.level-3, .legend-cell.level-3 { background: #61A184; }
.heatmap-cell.level-4, .legend-cell.level-4 { background: #356859; }
.heatmap-cell.is-future, .heatmap-cell.is-empty { opacity: 0.42; }
.heatmap-cell.is-active { box-shadow: 0 0 0 3rpx rgba(242, 185, 75, 0.68); }

.heatmap-tooltip {
  width: max-content;
  max-width: 100%;
  margin: 18rpx auto 0;
  padding: 13rpx 20rpx;
  border-radius: 18rpx;
  background: #244D40;
  color: #FFFFFF;
  font-size: 19rpx;
  line-height: 29rpx;
  text-align: center;
}

.heatmap-tooltip-sub { display: block; color: #CDE1D7; font-size: 17rpx; }

.heatmap-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 7rpx;
  margin-top: 15rpx;
  color: #85928C;
  font-size: 17rpx;
}

.year-highlights {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #E8EEE9;
}

.highlights-title { color: #294F43; font-size: 24rpx; font-weight: 800; }
.highlights-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; margin-top: 15rpx; }
.highlight-item { min-width: 0; padding: 16rpx 10rpx; border-radius: 18rpx; background: #F7F9F6; text-align: center; }
.highlight-icon { display: flex; align-items: center; justify-content: center; width: 36rpx; height: 36rpx; margin: 0 auto 8rpx; border-radius: 12rpx; background: #EAF5EF; color: #356859; font-size: 19rpx; font-weight: 800; }
.highlight-icon.is-gold { background: #FFF1C7; color: #A57A17; }
.highlight-date { overflow: hidden; color: #294F43; font-size: 19rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.highlight-label { margin-top: 4rpx; color: #7B8B84; font-size: 16rpx; line-height: 24rpx; }

.ai-coach-card {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.97), rgba(241, 248, 242, 0.95));
}

.ai-coach-identity { display: flex; align-items: center; min-width: 0; }
.ai-coach-avatar { width: 58rpx; height: 58rpx; margin-right: 14rpx; flex: 0 0 auto; border-radius: 18rpx; background: #E8F4EE; }
.ai-coach-title { color: #203730; font-size: 27rpx; font-weight: 800; }
.ai-coach-subtitle { margin-top: 3rpx; color: #7B8B84; font-size: 19rpx; }
.ai-coach-period { min-height: 40rpx; padding: 0 13rpx; flex: 0 0 auto; font-size: 18rpx; }

.ai-coach-message {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid #F2E3B9;
  border-radius: 22rpx;
  background: #FFFAEB;
}

.ai-coach-message-title { color: #304A41; font-size: 23rpx; line-height: 34rpx; font-weight: 800; }
.ai-coach-star { margin-right: 9rpx; color: #E9AE32; }
.ai-coach-message-copy { margin-top: 8rpx; color: #6F7D77; font-size: 20rpx; line-height: 32rpx; }

.ai-coach-evidence {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 16rpx;
}

.evidence-item {
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 14rpx 10rpx;
  border: 1rpx solid #E6EEE9;
  border-radius: 17rpx;
  background: rgba(255, 255, 255, 0.86);
}

.evidence-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin-right: 8rpx;
  flex: 0 0 auto;
  border-radius: 11rpx;
  background: #EAF5EF;
  color: #356859;
  font-size: 16rpx;
  font-weight: 800;
}

.evidence-icon.is-gold { background: #FFF1C7; color: #A57A17; }
.evidence-label { display: block; color: #819089; font-size: 15rpx; }
.evidence-value { margin-top: 2rpx; overflow: hidden; color: #294F43; font-size: 17rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }

.ai-coach-action {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  margin-top: 18rpx;
  border-radius: 34rpx;
  background: #356859;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 22rpx rgba(53, 104, 89, 0.16);
}

.ai-coach-action-arrow { margin-left: 7rpx; font-size: 30rpx; }

.milestone-card { overflow: hidden; }
.milestone-scroll { width: 100%; margin-top: 24rpx; }
.milestone-row { display: flex; width: 760rpx; padding: 9rpx 8rpx 4rpx; }
.milestone-item { position: relative; width: 144rpx; flex: 0 0 auto; text-align: center; }
.milestone-line { position: absolute; z-index: 0; width: 100%; height: 4rpx; top: 31rpx; left: 72rpx; background: #DDE7E1; }
.milestone-item:last-child .milestone-line { display: none; }
.mini-medal { position: relative; z-index: 1; width: 64rpx; height: 80rpx; margin: 0 auto; }
.mini-medal-face { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 64rpx; height: 64rpx; border: 3rpx solid #D6E2DC; border-radius: 50%; background: #F3F7F4; color: #9AAAA3; font-size: 24rpx; }
.mini-medal-ribbon { width: 22rpx; height: 25rpx; margin: -7rpx auto 0; background: #C9D8D1; clip-path: polygon(0 0, 100% 0, 76% 100%, 50% 70%, 24% 100%); }
.state-achieved .mini-medal-face, .state-current .mini-medal-face { border-color: #F0C655; background: #FFF4CE; color: #A57A17; box-shadow: 0 0 0 7rpx rgba(248, 210, 106, 0.13); }
.state-achieved .mini-medal-ribbon, .state-current .mini-medal-ribbon { background: #E9B93D; }
.milestone-label { margin-top: 4rpx; color: #294F43; font-size: 19rpx; font-weight: 700; }
.milestone-status { margin-top: 3rpx; color: #87948E; font-size: 16rpx; }
.state-achieved .milestone-status, .state-current .milestone-status { color: #A57A17; }

.review-link { padding: 8rpx 0 8rpx 12rpx; color: #356859; font-size: 20rpx; font-weight: 700; }
.record-list { margin-top: 22rpx; }
.record-item { min-height: 92rpx; margin-top: 12rpx; padding: 18rpx; border-radius: 22rpx; }
.record-check { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; margin-right: 16rpx; flex: 0 0 auto; border-radius: 50%; background: #356859; color: #FFFFFF; font-size: 21rpx; font-weight: 800; }
.record-copy { min-width: 0; flex: 1; }
.record-title { overflow: hidden; color: #263C35; font-size: 24rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.record-meta { margin-top: 6rpx; color: #7B8B84; font-size: 19rpx; }
.record-empty { margin-top: 22rpx; padding: 24rpx; border-radius: 20rpx; background: #F4F8F4; color: #71827A; font-size: 21rpx; line-height: 33rpx; }

.state-card {
  margin-top: 120rpx;
  padding: 56rpx 34rpx;
  text-align: center;
}

.state-orbit,
.state-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #EAF5EF;
  color: #356859;
  font-size: 20rpx;
  font-weight: 800;
}

.state-orbit {
  border: 5rpx solid #D9E8E0;
  border-top-color: #356859;
  background: transparent;
  animation: state-spin 1s linear infinite;
}

@keyframes state-spin { to { transform: rotate(360deg); } }
.state-title { color: #203730; font-size: 31rpx; font-weight: 800; }
.state-description { max-width: 520rpx; margin: 12rpx auto 0; color: #71827A; font-size: 22rpx; line-height: 35rpx; }
.primary-action { width: 320rpx; height: 76rpx; margin-top: 28rpx; border-radius: 38rpx; background: #356859 !important; color: #FFFFFF !important; font-size: 25rpx; font-weight: 700; }

.goal-picker-layer { position: fixed; z-index: 100; inset: 0; }
.goal-picker-mask { position: absolute; inset: 0; background: rgba(28, 46, 39, 0.28); -webkit-backdrop-filter: blur(8rpx); backdrop-filter: blur(8rpx); }
.goal-picker-panel { position: absolute; box-sizing: border-box; width: 100%; max-height: 72vh; right: 0; bottom: 0; left: 0; padding: 14rpx 28rpx calc(34rpx + env(safe-area-inset-bottom)); overflow-y: auto; border-radius: 34rpx 34rpx 0 0; background: #FBFCF8; box-shadow: 0 -18rpx 46rpx rgba(31, 70, 58, 0.15); }
.goal-picker-grabber { width: 72rpx; height: 8rpx; margin: 0 auto 24rpx; border-radius: 8rpx; background: #C8D5CF; }
.goal-picker-header { display: flex; align-items: center; justify-content: space-between; }
.goal-picker-kicker { color: #6D8E82; font-size: 19rpx; font-weight: 700; letter-spacing: 2rpx; }
.goal-picker-title { margin-top: 4rpx; color: #203730; font-size: 31rpx; font-weight: 800; }
.goal-picker-close { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; border-radius: 50%; background: #EDF2EE; color: #71827A; font-size: 34rpx; }
.goal-picker-list { margin-top: 24rpx; }
.goal-option { display: flex; align-items: center; margin-top: 14rpx; padding: 21rpx; border: 1rpx solid #E3EBE6; border-radius: 22rpx; background: #FFFFFF; }
.goal-option.is-active { border-color: #BFD8C8; background: #EDF7F0; }
.goal-option-main { min-width: 0; flex: 1; }
.goal-option-title { overflow: hidden; color: #263C35; font-size: 24rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.goal-option-meta { display: flex; justify-content: space-between; margin-top: 8rpx; color: #71827A; font-size: 18rpx; }
.goal-option-track { height: 7rpx; margin-top: 11rpx; overflow: hidden; border-radius: 7rpx; background: #DDE9E2; }
.goal-option-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #7FAA91, #356859); }
.goal-option-action { display: flex; align-items: center; justify-content: center; min-width: 72rpx; height: 46rpx; margin-left: 18rpx; padding: 0 12rpx; border-radius: 23rpx; background: #356859; color: #FFFFFF; font-size: 19rpx; font-weight: 700; }
.goal-option.is-active .goal-option-action { background: rgba(53, 104, 89, 0.12); color: #356859; }

@media (max-width: 340px) {
  .progress-page { padding-right: 22rpx; padding-left: 22rpx; }
  .hero-card-content { width: 72%; }
  .hero-title { font-size: 34rpx; }
  .overview-chip { display: none; }
  .trend-card, .overview-card, .ai-coach-card, .milestone-card, .record-card { padding: 24rpx; }
  .evidence-item { display: block; text-align: center; }
  .evidence-icon { margin: 0 auto 7rpx; }
}

/* Compact growth archive layout */
.progress-page {
  padding-bottom: calc(136rpx + env(safe-area-inset-bottom));
}

.hero-card,
.overview-card,
.trend-card,
.ai-coach-card,
.milestone-card,
.record-card {
  border-radius: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(31, 70, 58, 0.065);
}

.overview-card,
.trend-card,
.ai-coach-card,
.milestone-card,
.record-card {
  margin-top: 20rpx;
  padding: 22rpx;
}

.hero-card {
  min-height: 258rpx;
  padding: 22rpx 24rpx 20rpx;
}

.hero-card-content { width: 72%; }
.hero-eyebrow { font-size: 19rpx; }
.hero-title { margin-top: 3rpx; font-size: 34rpx; line-height: 42rpx; }
.hero-status { min-height: 36rpx; margin-top: 7rpx; padding: 0 11rpx; font-size: 18rpx; }
.hero-footer { align-items: flex-end; gap: 14rpx; margin-top: 15rpx; }
.hero-progress-compact { min-width: 0; flex: 1; }
.hero-progress-row { margin-top: 0; font-size: 17rpx; }
.hero-progress-value { font-size: 25rpx; line-height: 29rpx; }
.hero-progress { height: 8rpx; margin-top: 7rpx; }
.hero-switch-button { min-height: 50rpx; padding: 0 16rpx; flex: 0 0 auto; font-size: 19rpx; }

.card-title { font-size: 28rpx; line-height: 36rpx; }
.card-subtitle { font-size: 18rpx; line-height: 26rpx; }

.overview-grid {
  gap: 10rpx;
  margin-top: 15rpx;
  padding-top: 0;
  border-top: 0;
}

.overview-item {
  box-sizing: border-box;
  min-height: 126rpx;
  padding: 12rpx 4rpx 10rpx;
  border: 1rpx solid #E8EEE9;
  border-radius: 18rpx;
  background: #F8FAF7;
}

.overview-item + .overview-item::before { display: none; }
.overview-item--level { border-color: #F4E2AD; background: #FFF9E9; }
.overview-icon { width: 32rpx; height: 32rpx; margin-bottom: 4rpx; border-radius: 10rpx; font-size: 15rpx; }
.overview-icon--level { background: #FFF0BF; color: #A57A17; }
.overview-value { font-size: 28rpx; line-height: 34rpx; }
.overview-level-value { color: #9B7018; }
.overview-label { margin-top: 1rpx; font-size: 16rpx; line-height: 22rpx; }
.value-unit { font-size: 15rpx; }

.trend-range-tabs { height: 50rpx; padding: 4rpx; border-radius: 25rpx; }
.trend-range-tab { width: 52rpx; height: 42rpx; border-radius: 21rpx; font-size: 18rpx; }
.trend-metric-panel,
.year-top-stats { margin-top: 15rpx; padding: 14rpx 16rpx; border-radius: 20rpx; }
.trend-metric-divider { margin: 0 18rpx; }
.trend-metric-name,
.year-stat-label { font-size: 17rpx; }
.trend-metric-value { margin-top: 3rpx; font-size: 30rpx; line-height: 36rpx; }
.trend-metric-compare { margin-top: 2rpx; font-size: 16rpx; line-height: 22rpx; }
.chart-title-row { gap: 22rpx; margin-top: 14rpx; padding-left: 44rpx; }
.chart-legend { font-size: 16rpx; }
.bar-chart { height: 320rpx; margin-top: 5rpx; }
.bar-y-axis { width: 42rpx; font-size: 15rpx; }
.bar-labels { margin-left: 42rpx; font-size: 15rpx; }
.bar-tooltip { min-width: 100rpx; padding: 7rpx 10rpx; font-size: 16rpx; line-height: 23rpx; }
.bar-tooltip-sub { font-size: 14rpx; }
.trend-insufficient,
.trend-summary { margin-top: 14rpx; padding: 15rpx; font-size: 18rpx; line-height: 28rpx; }

.year-stat-value { font-size: 27rpx; }
.year-stat-label { margin-top: 2rpx; }
.heatmap-scroll { margin-top: 15rpx; }
.heatmap-legend { margin-top: 9rpx; }
.year-highlights { margin-top: 14rpx; padding-top: 14rpx; }
.highlights-title { font-size: 21rpx; }
.highlights-grid { margin-top: 10rpx; }
.highlight-item { padding: 11rpx 7rpx; }
.highlight-icon { width: 30rpx; height: 30rpx; margin-bottom: 5rpx; }

.ai-coach-head { align-items: center; }
.ai-coach-avatar { width: 48rpx; height: 48rpx; margin-right: 10rpx; border-radius: 15rpx; }
.ai-coach-title { font-size: 24rpx; }
.ai-coach-subtitle { font-size: 16rpx; }
.ai-coach-period { min-height: 34rpx; font-size: 15rpx; }
.ai-coach-message { margin-top: 12rpx; padding: 13rpx 15rpx; border-radius: 17rpx; }
.ai-coach-message-title { overflow: hidden; font-size: 19rpx; line-height: 28rpx; text-overflow: ellipsis; white-space: nowrap; }
.ai-coach-footer { display: flex; align-items: stretch; gap: 9rpx; margin-top: 10rpx; }
.ai-coach-evidence { display: flex; min-width: 0; margin-top: 0; flex: 1; gap: 7rpx; }
.evidence-item { min-width: 0; padding: 8rpx 6rpx; flex: 1; border-radius: 14rpx; }
.evidence-icon { width: 27rpx; height: 27rpx; margin-right: 5rpx; border-radius: 8rpx; font-size: 13rpx; }
.evidence-label { font-size: 13rpx; }
.evidence-value { font-size: 15rpx; }
.ai-coach-action { width: 152rpx; height: auto; min-height: 60rpx; margin-top: 0; flex: 0 0 auto; border-radius: 18rpx; font-size: 17rpx; }
.ai-coach-action-arrow { margin-left: 3rpx; font-size: 22rpx; }

.milestone-card { min-height: 200rpx; }
.milestone-next { align-self: center; color: #7B8B84; font-size: 16rpx; }
.milestone-row { width: 100%; margin-top: 12rpx; padding: 3rpx 0 0; }
.milestone-item { width: 25%; flex: 1; }
.milestone-line { height: 3rpx; top: 24rpx; left: 50%; }
.mini-medal { width: 50rpx; height: 50rpx; }
.mini-medal-face { width: 50rpx; height: 50rpx; border-width: 2rpx; font-size: 18rpx; }
.milestone-label { margin-top: 5rpx; font-size: 17rpx; }
.milestone-status { margin-top: 0; font-size: 14rpx; }

.record-card { padding: 0; }
.record-compact { display: flex; align-items: center; min-height: 96rpx; padding: 0 20rpx; }
.record-check { width: 42rpx; height: 42rpx; margin-right: 13rpx; background: #EDF3EF; color: #71827A; font-size: 17rpx; }
.record-title { font-size: 22rpx; }
.record-meta { max-width: 520rpx; margin-top: 2rpx; overflow: hidden; font-size: 16rpx; line-height: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.record-arrow { margin-left: 12rpx; color: #89968F; font-size: 36rpx; }

@media (max-width: 340px) {
  .hero-card { min-height: 250rpx; }
  .hero-card-content { width: 76%; }
  .overview-card,
  .trend-card,
  .ai-coach-card,
  .milestone-card { padding: 18rpx; }
  .overview-grid { gap: 6rpx; }
  .overview-item { min-height: 120rpx; }
  .ai-coach-footer { display: block; }
  .ai-coach-action { width: 100%; min-height: 54rpx; margin-top: 8rpx; }
}

/* Typography alignment with the Today page */
