page { background: #f8f5ec; }

.progress-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 0 30rpx calc(154rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  color: #29463d;
  background: linear-gradient(180deg, #fbf8f0 0%, #f8f5ec 58%, #f5f1e7 100%);
}

.progress-page::after {
  position: fixed;
  z-index: 0;
  inset: 0;
  pointer-events: none;
  content: "";
  opacity: .18;
  background-image: radial-gradient(rgba(112, 93, 62, .16) .7rpx, transparent .8rpx);
  background-size: 12rpx 12rpx;
}

.progress-page-backdrop { position: absolute; z-index: 0; width: 100%; height: 510rpx; top: 0; left: 0; overflow: hidden; }
.progress-page-backdrop image { width: 100%; height: 100%; opacity: .76; }
.progress-page-backdrop__veil { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(251,248,240,.08), rgba(248,245,236,.38) 58%, #f8f5ec 100%); }
.progress-nav { position: relative; z-index: 3; display: flex; align-items: center; justify-content: center; box-sizing: content-box; padding-bottom: 38rpx; }
.progress-nav text { color: #234b40; font-family: STSong, SimSun, serif; font-size: 40rpx; font-weight: 600; letter-spacing: 6rpx; }

.paper-card {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(184, 168, 135, .28);
  border-radius: 28rpx;
  background: rgba(255, 253, 248, .94);
  box-shadow: 0 12rpx 34rpx rgba(66, 54, 36, .075);
}
.card-pressed { opacity: .9; transform: scale(.995); }

.hero-card { min-height: 566rpx; padding: 34rpx 34rpx 28rpx; }
.hero-card-bg, .hero-card-overlay { position: absolute; z-index: 0; width: 100%; height: 100%; inset: 0; pointer-events: none; }
.hero-card-bg { opacity: .5; }
.hero-card-overlay { z-index: 1; background: linear-gradient(100deg, rgba(255,253,248,.98) 0%, rgba(255,253,248,.93) 47%, rgba(255,253,248,.52) 100%); }
.hero-kicker, .hero-heading, .hero-main, .hero-stats { position: relative; z-index: 2; }
.hero-kicker { color: #aa8442; font-size: 18rpx; font-weight: 600; letter-spacing: 4rpx; }
.hero-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin-top: 10rpx; }
.hero-heading-main { min-width: 0; flex: 1; }
.hero-title-label { color: #234b40; font-family: STSong, SimSun, serif; font-size: 42rpx; line-height: 52rpx; font-weight: 600; letter-spacing: 3rpx; }
.hero-title { max-width: 420rpx; margin-top: 8rpx; overflow: hidden; color: #58645f; font-size: 24rpx; line-height: 34rpx; text-overflow: ellipsis; white-space: nowrap; }
.hero-switch-button { display: flex; align-items: center; min-height: 52rpx; margin-top: 4rpx; padding: 0 18rpx; flex: 0 0 auto; border: 1rpx solid rgba(181,140,67,.65); border-radius: 28rpx; color: #9c7431; background: rgba(255,253,248,.72); font-size: 20rpx; }
.hero-switch-arrow { margin-left: 7rpx; font-size: 30rpx; line-height: 26rpx; }
.hero-main { display: flex; align-items: center; min-height: 250rpx; margin-top: 12rpx; }
.goal-ring-wrap { position: relative; width: 228rpx; height: 228rpx; margin-left: 2rpx; flex: 0 0 auto; }
.goal-ring-canvas { width: 228rpx; height: 228rpx; }
.goal-ring-copy { position: absolute; display: flex; align-items: center; justify-content: center; inset: 0; flex-direction: column; pointer-events: none; }
.goal-ring-copy > view { color: #254e42; font-family: Georgia, STSong, serif; font-size: 32rpx; line-height: 58rpx; }
.goal-ring-copy > view text { font-size: 68rpx; }
.goal-ring-copy > text { color: #7c7a72; font-size: 20rpx; }
.hero-encouragement { margin-left: 34rpx; padding-bottom: 4rpx; color: #5d625e; font-family: STSong, SimSun, serif; font-size: 27rpx; line-height: 48rpx; letter-spacing: 1rpx; }
.hero-stats { display: flex; align-items: stretch; padding-top: 22rpx; border-top: 1rpx solid rgba(166,151,122,.24); }
.hero-stat { display: flex; align-items: center; min-width: 0; flex: 1; }
.hero-stat-icon { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; margin-right: 14rpx; border: 1rpx solid rgba(49,88,75,.18); border-radius: 50%; color: #31584b; font-size: 27rpx; }
.hero-stat > view > text { color: #777b76; font-size: 20rpx; }
.hero-stat > view > view { margin-top: 4rpx; color: #254e42; font-family: Georgia, STSong, serif; font-size: 38rpx; line-height: 42rpx; }
.hero-stat > view > view text { margin-left: 5rpx; color: #777b76; font-family: sans-serif; font-size: 19rpx; }
.hero-stat-divider { width: 1rpx; margin: 0 28rpx; background: rgba(166,151,122,.24); }

.growth-conclusion-card { min-height: 250rpx; margin-top: 24rpx; padding: 30rpx 32rpx; }
.conclusion-background, .conclusion-veil { position: absolute; width: 100%; height: 100%; inset: 0; }
.conclusion-background { opacity: .9; }
.conclusion-veil { background: linear-gradient(90deg, rgba(255,253,248,.98) 0%, rgba(255,253,248,.9) 48%, rgba(255,253,248,.24) 100%); }
.conclusion-content { position: relative; z-index: 2; width: 62%; }
.conclusion-title { display: flex; align-items: center; color: #234b40; font-family: STSong, SimSun, serif; font-size: 38rpx; line-height: 48rpx; letter-spacing: 3rpx; }
.conclusion-title text { margin-left: 10rpx; color: #b58c43; font-size: 27rpx; }
.conclusion-period { margin-top: 7rpx; color: #a47c38; font-size: 18rpx; letter-spacing: 1rpx; }
.conclusion-copy { max-height: 72rpx; margin-top: 13rpx; overflow: hidden; color: #656963; font-size: 22rpx; line-height: 36rpx; }
.conclusion-action { display: inline-flex; align-items: center; margin-top: 13rpx; color: #8e692d; font-size: 20rpx; font-weight: 600; }
.conclusion-action text { margin-left: 7rpx; font-size: 27rpx; }

.trend-card { margin-top: 24rpx; padding: 30rpx 28rpx 28rpx; }
.card-title-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 16rpx; }
.trend-kicker { color: #aa8442; font-size: 16rpx; font-weight: 600; letter-spacing: 3rpx; }
.card-title { margin-top: 5rpx; color: #234b40; font-family: STSong, SimSun, serif; font-size: 34rpx; line-height: 44rpx; letter-spacing: 2rpx; }
.trend-range-tabs { display: flex; box-sizing: border-box; height: 52rpx; padding: 4rpx; border: 1rpx solid rgba(150,142,123,.2); border-radius: 28rpx; background: rgba(241,238,228,.82); }
.trend-range-tab { display: flex; align-items: center; justify-content: center; width: 54rpx; height: 42rpx; border-radius: 23rpx; color: #838780; font-size: 19rpx; }
.trend-range-tab.is-active { color: #fffdf8; background: #31584b; box-shadow: 0 5rpx 12rpx rgba(49,88,75,.18); }
.trend-insufficient, .trend-summary { margin-top: 22rpx; padding: 18rpx 20rpx; border: 1rpx solid rgba(181,140,67,.16); border-radius: 18rpx; color: #816b43; background: #fbf5e7; font-size: 20rpx; line-height: 32rpx; }
.chart-legend-row { display: flex; gap: 28rpx; margin-top: 22rpx; padding-left: 48rpx; }
.chart-legend { display: flex; align-items: center; color: #858a84; font-size: 17rpx; }
.legend-dot { width: 12rpx; height: 12rpx; margin-right: 8rpx; border-radius: 3rpx; background: #31584b; }
.legend-line { width: 28rpx; height: 2rpx; margin-right: 8rpx; background: #91a99e; }
.bar-chart { display: flex; height: 310rpx; margin-top: 8rpx; }
.bar-y-axis { display: flex; box-sizing: border-box; width: 46rpx; padding: 8rpx 7rpx 8rpx 0; flex: 0 0 auto; flex-direction: column; justify-content: space-between; color: #9b9b92; font-size: 16rpx; text-align: right; }
.bar-y-axis--right { padding-right: 0; padding-left: 8rpx; text-align: left; }
.bar-area { position: relative; min-width: 0; flex: 1; }
.bar-grid, .bar-columns, .line-canvas { position: absolute; width: 100%; height: 100%; inset: 0; }
.bar-grid { display: flex; flex-direction: column; justify-content: space-between; }
.bar-grid-line { width: 100%; border-top: 1rpx solid rgba(123,130,121,.14); }
.bar-columns { z-index: 2; display: flex; align-items: flex-end; justify-content: space-around; }
.bar-column { position: relative; display: flex; height: 100%; min-width: 30rpx; align-items: flex-end; justify-content: center; }
.bar-fill { min-height: 4rpx; border: 1rpx solid transparent; border-radius: 10rpx 10rpx 3rpx 3rpx; background: linear-gradient(180deg, #718f83, #31584b); box-shadow: 0 5rpx 12rpx rgba(49,88,75,.09); }
.bar-fill.is-max { background: linear-gradient(180deg, #426d5e, #234b40); }
.bar-fill.is-today { border-color: #c5a15e; box-shadow: 0 0 0 2rpx rgba(197,161,94,.14); }
.line-canvas { z-index: 1; pointer-events: none; }
.bar-tooltip { position: absolute; z-index: 5; min-width: 108rpx; padding: 9rpx 11rpx; border: 1rpx solid rgba(197,161,94,.42); border-radius: 13rpx; color: #fffdf8; background: #31584b; font-size: 17rpx; line-height: 25rpx; text-align: center; box-shadow: 0 8rpx 18rpx rgba(31,70,58,.14); transform: translateX(-50%); }
.bar-tooltip-sub { display: block; color: #d9e2dc; font-size: 15rpx; }
.tooltip-left { left: 0; transform: none; } .tooltip-center { left: 50%; } .tooltip-right { right: 0; transform: none; }
.bar-labels { display: flex; margin-right: 46rpx; margin-left: 46rpx; color: #8b9089; font-size: 16rpx; }
.bar-label { min-width: 0; flex: 1; text-align: center; }
.trend-footer { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 22rpx; padding: 16rpx 18rpx; border-radius: 18rpx; color: #53685f; background: #f5f1e5; }
.trend-footer-copy { display: flex; align-items: center; min-width: 0; flex: 1; font-size: 19rpx; line-height: 30rpx; }
.trend-footer-icon { display: flex; align-items: center; justify-content: center; width: 36rpx; height: 36rpx; margin-right: 10rpx; border-radius: 50%; color: #fff; background: #31584b; font-size: 20rpx; }
.trend-footer-strong { margin: 0 3rpx; color: #234b40; font-family: Georgia, serif; font-size: 24rpx; }
.trend-history { padding: 9rpx 0 9rpx 12rpx; color: #9a7130; font-size: 19rpx; font-weight: 600; }

.year-top-stats { display: flex; margin-top: 22rpx; padding: 20rpx 8rpx; border-radius: 20rpx; background: #f7f3e9; }
.year-stat-item { min-width: 0; flex: 1; text-align: center; }
.year-stat-item + .year-stat-item { border-left: 1rpx solid rgba(166,151,122,.25); }
.year-stat-value { color: #294f43; font-family: Georgia, STSong, serif; font-size: 31rpx; }
.year-stat-label { margin-top: 5rpx; color: #7c827c; font-size: 17rpx; }
.value-unit { margin-left: 3rpx; color: #7c827c; font-family: sans-serif; font-size: 16rpx; }
.heatmap-scroll { width: 100%; margin-top: 22rpx; }
.heatmap-inner { width: 1050rpx; }
.heatmap-months-row, .heatmap-body-row { display: flex; }
.heatmap-weekday-spacer { width: 36rpx; flex: 0 0 auto; }
.heatmap-months { position: relative; width: 1014rpx; height: 28rpx; }
.heatmap-month-label, .heatmap-weekday { position: absolute; color: #8a8e88; font-size: 17rpx; }
.heatmap-weekdays { position: relative; width: 36rpx; height: 128rpx; flex: 0 0 auto; }
.heatmap-grid { display: flex; gap: 5rpx; }
.heatmap-column { display: flex; flex-direction: column; gap: 5rpx; }
.heatmap-cell, .legend-cell { box-sizing: border-box; width: 14rpx; height: 14rpx; border-radius: 4rpx; background: #ecebe3; }
.heatmap-cell.level-1, .legend-cell.level-1 { background: #d8e1da; } .heatmap-cell.level-2, .legend-cell.level-2 { background: #aebfb6; } .heatmap-cell.level-3, .legend-cell.level-3 { background: #6f9183; } .heatmap-cell.level-4, .legend-cell.level-4 { background: #31584b; }
.heatmap-cell.is-active { border: 2rpx solid #c39b51; transform: scale(1.18); }
.heatmap-cell.is-empty, .heatmap-cell.is-future { opacity: .38; }
.heatmap-tooltip { width: max-content; max-width: 100%; margin: 16rpx auto 0; padding: 12rpx 19rpx; border: 1rpx solid rgba(197,161,94,.4); border-radius: 17rpx; color: #fffdf8; background: #31584b; font-size: 18rpx; line-height: 28rpx; text-align: center; }
.heatmap-tooltip-date { font-weight: 700; } .heatmap-tooltip-sub { display: block; color: #d4dfd8; font-size: 16rpx; }
.heatmap-legend { display: flex; align-items: center; justify-content: flex-end; gap: 7rpx; margin-top: 13rpx; color: #8a8e88; font-size: 16rpx; }
.year-highlights { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(166,151,122,.22); }
.highlights-title { color: #294f43; font-family: STSong, SimSun, serif; font-size: 26rpx; }
.highlights-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; margin-top: 14rpx; }
.highlight-item { min-width: 0; padding: 16rpx 8rpx; border: 1rpx solid rgba(166,151,122,.16); border-radius: 17rpx; background: #faf8f1; text-align: center; }
.highlight-icon { display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; margin: 0 auto 8rpx; border-radius: 50%; color: #31584b; background: #e7eee9; font-size: 18rpx; }
.highlight-icon.is-gold { color: #9a7130; background: #f5ead1; }
.highlight-date { overflow: hidden; color: #294f43; font-size: 18rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.highlight-label { margin-top: 4rpx; color: #7c827c; font-size: 15rpx; line-height: 23rpx; }

.state-card { margin-top: 70rpx; padding: 58rpx 32rpx; text-align: center; }
.state-orbit, .state-mark { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 78rpx; height: 78rpx; margin: 0 auto 22rpx; border: 1rpx solid rgba(181,140,67,.3); border-radius: 50%; color: #31584b; background: #f5f0e3; font-size: 20rpx; font-weight: 700; }
.state-orbit { border: 4rpx solid #e6ddca; border-top-color: #31584b; background: transparent; animation: state-spin 1s linear infinite; }
@keyframes state-spin { to { transform: rotate(360deg); } }
.state-title { color: #234b40; font-family: STSong, SimSun, serif; font-size: 32rpx; }
.state-description { max-width: 520rpx; margin: 13rpx auto 0; color: #777b76; font-size: 22rpx; line-height: 36rpx; }
.primary-action { width: 320rpx; height: 76rpx; margin-top: 28rpx; border-radius: 38rpx; color: #fffdf8 !important; background: #31584b !important; font-size: 25rpx; }

.goal-picker-layer { position: fixed; z-index: 100; inset: 0; }
.goal-picker-mask { position: absolute; inset: 0; background: rgba(31,48,42,.32); -webkit-backdrop-filter: blur(8rpx); backdrop-filter: blur(8rpx); }
.goal-picker-panel { position: absolute; box-sizing: border-box; width: 100%; max-height: 72vh; right: 0; bottom: 0; left: 0; padding: 14rpx 28rpx calc(34rpx + env(safe-area-inset-bottom)); overflow-y: auto; border-radius: 34rpx 34rpx 0 0; background: #fbf8f0; box-shadow: 0 -18rpx 46rpx rgba(31,48,42,.16); }
.goal-picker-grabber { width: 72rpx; height: 8rpx; margin: 0 auto 24rpx; border-radius: 8rpx; background: #cfc7b7; }
.goal-picker-header { display: flex; align-items: center; justify-content: space-between; }
.goal-picker-kicker { color: #aa8442; font-size: 18rpx; font-weight: 600; letter-spacing: 3rpx; }
.goal-picker-title { margin-top: 5rpx; color: #234b40; font-family: STSong, SimSun, serif; font-size: 34rpx; }
.goal-picker-close { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; border-radius: 50%; color: #777b76; background: #eee9dd; font-size: 34rpx; }
.goal-picker-list { margin-top: 24rpx; }
.goal-option { display: flex; align-items: center; margin-top: 14rpx; padding: 21rpx; border: 1rpx solid rgba(166,151,122,.25); border-radius: 22rpx; background: #fffdf8; }
.goal-option.is-active { border-color: rgba(181,140,67,.62); background: #fbf7ea; }
.goal-option-main { min-width: 0; flex: 1; }
.goal-option-title { overflow: hidden; color: #29463d; font-size: 24rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.goal-option-meta { display: flex; justify-content: space-between; margin-top: 8rpx; color: #7c827c; font-size: 18rpx; }
.goal-option-track { height: 7rpx; margin-top: 11rpx; overflow: hidden; border-radius: 7rpx; background: #e3e3da; }
.goal-option-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #8ba397, #31584b); }
.goal-option-action { display: flex; align-items: center; justify-content: center; min-width: 72rpx; height: 46rpx; margin-left: 18rpx; padding: 0 12rpx; border: 1rpx solid rgba(181,140,67,.45); border-radius: 23rpx; color: #8f692c; background: #fffaf0; font-size: 19rpx; font-weight: 600; }

@media (max-width: 350px) {
  .progress-page { padding-right: 22rpx; padding-left: 22rpx; }
  .hero-card { min-height: 540rpx; padding: 28rpx 26rpx 24rpx; }
  .goal-ring-wrap, .goal-ring-canvas { width: 196rpx; height: 196rpx; }
  .hero-encouragement { margin-left: 20rpx; font-size: 24rpx; line-height: 42rpx; }
  .hero-stat-divider { margin: 0 18rpx; }
  .conclusion-content { width: 68%; }
  .trend-card { padding-right: 20rpx; padding-left: 20rpx; }
}
