.progress-page {
  --progress-primary: #145243;
  --progress-deep: #0f4035;
  --progress-soft: #f3f8f5;
  --progress-accent: #55b98b;
  --progress-gold: #f5b94e;
  --progress-gold-light: #fff4cf;
  --progress-text: #173c34;
  --progress-secondary: #6f7f78;
  --progress-muted: #a8b0aa;
  --progress-border: #e8efeb;
  --progress-shadow: 0 8rpx 30rpx rgba(20, 82, 67, 0.08);
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 32rpx calc(210rpx + env(safe-area-inset-bottom));
  background: #f7f8f5;
  color: var(--progress-text);
}

.progress-header {
  padding: 14rpx 0 24rpx;
}

.page-title {
  font-size: 40rpx;
  line-height: 50rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.page-subtitle {
  margin-top: 8rpx;
  color: var(--progress-secondary);
  font-size: 25rpx;
  line-height: 34rpx;
}

.goal-card,
.overview-card,
.trend-card,
.milestone-card,
.record-card,
.state-card {
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: var(--progress-shadow);
}

.goal-card {
  overflow: hidden;
  padding: 30rpx;
  background:
    radial-gradient(circle at 88% 16%, rgba(245, 185, 78, 0.2), transparent 28%),
    radial-gradient(circle at 92% 96%, rgba(255, 255, 255, 0.11), transparent 34%),
    linear-gradient(145deg, #145243 0%, #1d604f 58%, #2c755e 100%);
  color: #ffffff;
}

.goal-card-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}

.goal-copy {
  min-width: 0;
  flex: 1;
}

.section-eyebrow {
  color: rgba(255, 255, 255, 0.66);
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 700;
}

.goal-title {
  max-width: 440rpx;
  margin-top: 10rpx;
  overflow: hidden;
  font-size: 36rpx;
  line-height: 46rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goal-meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
}

.level-chip,
.status-chip {
  height: 42rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 16rpx;
  border-radius: 21rpx;
  font-size: 22rpx;
  line-height: 42rpx;
  font-weight: 700;
}

.level-chip {
  background: rgba(245, 185, 78, 0.18);
  color: #ffd977;
}

.status-chip {
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.86);
}

.goal-period {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  line-height: 32rpx;
}

.medal {
  position: relative;
  width: 164rpx;
  height: 172rpx;
  flex: none;
}

.medal-face {
  position: absolute;
  top: 12rpx;
  left: 24rpx;
  z-index: 3;
  width: 116rpx;
  height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid rgba(255, 239, 174, 0.74);
  border-radius: 50%;
  background:
    radial-gradient(circle at 34% 26%, #fff3b7 0%, #ffd46e 35%, #e6a93c 100%);
  box-shadow: 0 18rpx 32rpx rgba(49, 38, 12, 0.24), inset 0 -10rpx 18rpx rgba(151, 95, 15, 0.16);
}

.medal-star {
  color: #fff2ad;
  font-size: 52rpx;
  line-height: 1;
  text-shadow: 0 4rpx 8rpx rgba(125, 78, 10, 0.2);
}

.medal-ribbon {
  position: absolute;
  top: 104rpx;
  left: 58rpx;
  z-index: 2;
  width: 48rpx;
  height: 62rpx;
  border-radius: 0 0 10rpx 10rpx;
  background: linear-gradient(180deg, #2e765e 0%, #155242 100%);
  box-shadow: inset 0 8rpx 12rpx rgba(255, 255, 255, 0.12);
}

.medal-ribbon::after {
  position: absolute;
  right: 0;
  bottom: -1rpx;
  left: 0;
  width: 0;
  height: 0;
  margin: 0 auto;
  border-right: 24rpx solid transparent;
  border-bottom: 16rpx solid #1c604f;
  border-left: 24rpx solid transparent;
  content: "";
}

.medal-leaf {
  position: absolute;
  top: 76rpx;
  z-index: 1;
  width: 64rpx;
  height: 28rpx;
  border-radius: 100% 10rpx 100% 10rpx;
  background: linear-gradient(135deg, #6caf8c, #2c6f58);
  opacity: 0.92;
}

.leaf-left {
  left: 0;
  transform: rotate(28deg);
}

.leaf-right {
  right: 0;
  transform: rotate(152deg);
}

.medal-spark {
  position: absolute;
  z-index: 4;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffe08a;
  box-shadow: 0 0 14rpx rgba(255, 218, 113, 0.7);
}

.spark-a {
  top: 8rpx;
  right: 16rpx;
}

.spark-b {
  top: 46rpx;
  left: 0;
  width: 9rpx;
  height: 9rpx;
}

.goal-progress-block {
  margin-top: 26rpx;
  padding: 24rpx 24rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.12);
}

.goal-progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 32rpx;
}

.goal-percent {
  color: #ffffff;
  font-size: 34rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.goal-progress-track {
  height: 10rpx;
  overflow: hidden;
  margin-top: 16rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.18);
}

.goal-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #72d39e, #f5d47a);
  transition: width 180ms ease-out;
}

.goal-next-step {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 23rpx;
  line-height: 32rpx;
}

.overview-card,
.trend-card,
.milestone-card,
.record-card {
  margin-top: 26rpx;
  padding: 30rpx 28rpx;
}

.card-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.card-title {
  color: var(--progress-text);
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.card-subtitle {
  margin-top: 6rpx;
  color: var(--progress-muted);
  font-size: 23rpx;
  line-height: 32rpx;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 26rpx;
}

.overview-item {
  min-width: 0;
  padding: 22rpx 16rpx;
  border-radius: 22rpx;
  background: #f7faf8;
  text-align: center;
}

.overview-value {
  color: var(--progress-text);
  font-size: 38rpx;
  line-height: 46rpx;
  font-weight: 800;
}

.overview-value text {
  margin-left: 4rpx;
  color: var(--progress-secondary);
  font-size: 21rpx;
  font-weight: 700;
}

.overview-label {
  margin-top: 8rpx;
  color: var(--progress-secondary);
  font-size: 23rpx;
  line-height: 30rpx;
}

.trend-range-tabs {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex: none;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #eef3f0;
}

.trend-range-tab {
  min-width: 60rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #6f7f78;
  font-size: 24rpx;
  font-weight: 700;
}

.trend-range-tab.is-active {
  background: var(--progress-primary);
  color: #ffffff;
}

.trend-headline {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(85, 185, 139, 0.1), rgba(20, 82, 67, 0.04));
}

.trend-headline-item {
  flex: 1;
  min-width: 0;
}

.trend-headline-value {
  color: var(--progress-text);
  font-size: 44rpx;
  line-height: 52rpx;
  font-weight: 800;
}

.trend-headline-value text {
  margin-left: 6rpx;
  color: var(--progress-secondary);
  font-size: 22rpx;
  font-weight: 600;
}

.trend-headline-label {
  margin-top: 4rpx;
  color: var(--progress-secondary);
  font-size: 23rpx;
  line-height: 30rpx;
}

.trend-headline-divider {
  width: 1rpx;
  height: 56rpx;
  background: #dfe7e2;
}

.trend-insufficient {
  margin-top: 28rpx;
  padding: 32rpx 24rpx;
  border-radius: 20rpx;
  background: var(--progress-soft);
  color: var(--progress-secondary);
  font-size: 25rpx;
  line-height: 38rpx;
  text-align: center;
}

.bar-chart {
  display: flex;
  gap: 14rpx;
  margin-top: 28rpx;
}

.bar-y-axis {
  width: 52rpx;
  height: 300rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  flex: none;
  padding: 6rpx 4rpx 0 0;
  box-sizing: border-box;
  color: #9aa5a0;
  font-size: 20rpx;
  line-height: 24rpx;
  white-space: nowrap;
}

.bar-area {
  position: relative;
  height: 300rpx;
  min-width: 0;
  flex: 1;
  overflow: visible;
}

.bar-grid {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-rows: repeat(4, 1fr);
}

.bar-grid view {
  border-top: 1rpx dashed #eef2ef;
}

.bar-grid view:last-child {
  border-bottom: 1rpx dashed #eef2ef;
}

.bar-columns {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
}

.bar-column {
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
}

.bar-fill {
  border-radius: 10rpx;
  background: linear-gradient(180deg, #55b98b, #3da676);
  transition: height 200ms ease-out, background 200ms ease-out;
}

.bar-fill.is-max {
  background: linear-gradient(180deg, #145243, #0f4035);
}

.bar-fill.is-today {
  box-shadow: 0 0 0 3rpx rgba(20, 82, 67, 0.18);
}

.bar-column.is-active .bar-fill {
  background: linear-gradient(180deg, #145243, #0f4035);
}

.bar-tooltip {
  position: absolute;
  min-width: 120rpx;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  background: var(--progress-primary);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
  white-space: nowrap;
  box-shadow: 0 10rpx 24rpx rgba(20, 82, 67, 0.22);
}

.bar-tooltip text {
  display: block;
  margin-top: 2rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 20rpx;
}

.bar-tooltip::after {
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  width: 0;
  height: 0;
  margin-left: -8rpx;
  border-right: 8rpx solid transparent;
  border-top: 8rpx solid var(--progress-primary);
  border-left: 8rpx solid transparent;
  content: "";
}

.tooltip-center {
  left: 50%;
  transform: translateX(-50%);
}

.tooltip-left {
  left: 0;
}

.tooltip-left::after {
  left: 24rpx;
  margin-left: 0;
}

.tooltip-right {
  right: 0;
}

.tooltip-right::after {
  left: auto;
  right: 24rpx;
  margin-left: 0;
}

.bar-labels {
  display: flex;
  justify-content: space-around;
  margin: 14rpx 0 0 66rpx;
  color: #9aa5a0;
  font-size: 21rpx;
  line-height: 28rpx;
  text-align: center;
}

.trend-summary {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: var(--progress-soft);
  color: var(--progress-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.trend-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 22rpx;
}

.trend-stat-item {
  padding: 20rpx 10rpx;
  border-radius: 18rpx;
  background: #f7faf8;
  text-align: center;
}

.trend-stat-value {
  color: var(--progress-text);
  font-size: 36rpx;
  line-height: 44rpx;
  font-weight: 800;
}

.trend-stat-value text {
  margin-left: 4rpx;
  color: var(--progress-secondary);
  font-size: 20rpx;
  font-weight: 600;
}

.trend-stat-label {
  margin-top: 6rpx;
  color: var(--progress-secondary);
  font-size: 22rpx;
  line-height: 28rpx;
}

.year-top-stats {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(85, 185, 139, 0.12), rgba(20, 82, 67, 0.05));
}

.year-stat-item {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.year-stat-value {
  color: var(--progress-primary);
  font-size: 40rpx;
  line-height: 48rpx;
  font-weight: 800;
}

.year-stat-value text {
  margin-left: 4rpx;
  color: var(--progress-secondary);
  font-size: 22rpx;
  font-weight: 600;
}

.year-stat-label {
  margin-top: 4rpx;
  color: var(--progress-secondary);
  font-size: 23rpx;
  line-height: 30rpx;
}

.year-stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #dfe7e2;
}

.heatmap-scroll {
  margin-top: 28rpx;
  width: 100%;
  white-space: nowrap;
}

.heatmap-inner {
  display: inline-flex;
  flex-direction: column;
  padding-bottom: 8rpx;
}

.heatmap-months-row {
  display: flex;
  align-items: flex-end;
  height: 28rpx;
  margin-bottom: 8rpx;
}

.heatmap-weekday-spacer {
  width: 36rpx;
  flex: none;
}

.heatmap-months {
  position: relative;
  height: 28rpx;
}

.heatmap-month-label {
  position: absolute;
  bottom: 0;
  color: #9aa5a0;
  font-size: 20rpx;
  line-height: 26rpx;
}

.heatmap-body-row {
  display: flex;
  align-items: flex-start;
}

.heatmap-weekdays {
  position: relative;
  width: 36rpx;
  flex: none;
  height: 133rpx;
}

.heatmap-weekday {
  position: absolute;
  left: 0;
  color: #9aa5a0;
  font-size: 20rpx;
  line-height: 19rpx;
}

.heatmap-grid {
  display: flex;
  flex-direction: row;
}

.heatmap-column {
  display: flex;
  flex-direction: column;
  margin-right: 5rpx;
}

.heatmap-column:last-child {
  margin-right: 0;
}

.heatmap-cell {
  width: 14rpx;
  height: 14rpx;
  margin-bottom: 5rpx;
  border-radius: 4rpx;
  background: #eaf2ee;
}

.heatmap-cell:last-child {
  margin-bottom: 0;
}

.heatmap-cell.level-0 {
  background: #eaf2ee;
}

.heatmap-cell.level-1 {
  background: #cde9da;
}

.heatmap-cell.level-2 {
  background: #8fd2ae;
}

.heatmap-cell.level-3 {
  background: #55b98b;
}

.heatmap-cell.level-4 {
  background: #145243;
}

.heatmap-cell.is-empty {
  background: transparent;
}

.heatmap-cell.is-future {
  background: #f2f6f4;
}

.heatmap-cell.is-active {
  box-shadow: 0 0 0 3rpx rgba(20, 82, 67, 0.5);
}

.heatmap-tooltip {
  margin-top: 20rpx;
  padding: 18rpx 24rpx;
  border-radius: 18rpx;
  background: var(--progress-primary);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 34rpx;
}

.heatmap-tooltip-date {
  font-size: 26rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.heatmap-tooltip-row {
  margin-top: 6rpx;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 32rpx;
}

.heatmap-tooltip-sub {
  display: block;
  margin-top: 2rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 22rpx;
  line-height: 30rpx;
}

.heatmap-tooltip-empty {
  display: block;
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 24rpx;
  line-height: 32rpx;
}

.heatmap-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 18rpx;
}

.heatmap-legend-text {
  color: #9aa5a0;
  font-size: 20rpx;
  line-height: 26rpx;
}

.legend-cell {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
}

.legend-cell.level-0 {
  background: #eaf2ee;
}

.legend-cell.level-1 {
  background: #cde9da;
}

.legend-cell.level-2 {
  background: #8fd2ae;
}

.legend-cell.level-3 {
  background: #55b98b;
}

.legend-cell.level-4 {
  background: #145243;
}

.year-highlights {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #f7faf8;
}

.highlights-title {
  color: var(--progress-text);
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 800;
}

.highlights-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.highlight-item {
  flex: 1;
  min-width: 0;
  padding: 20rpx 16rpx;
  border-radius: 18rpx;
  background: #ffffff;
  text-align: center;
}

.highlight-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 800;
}

.highlight-icon-target {
  background: rgba(85, 185, 139, 0.16);
  color: var(--progress-primary);
}

.highlight-icon-trophy {
  background: rgba(245, 185, 78, 0.18);
  color: #d99a2b;
}

.highlight-icon-trend {
  background: rgba(20, 82, 67, 0.1);
  color: var(--progress-primary);
}

.highlight-date {
  margin-top: 12rpx;
  color: var(--progress-text);
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 700;
}

.highlight-label {
  margin-top: 4rpx;
  color: var(--progress-secondary);
  font-size: 21rpx;
  line-height: 28rpx;
}

.milestone-row {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  margin-top: 28rpx;
}

.milestone-item {
  position: relative;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.milestone-line {
  position: absolute;
  top: 38rpx;
  right: 50%;
  left: -50%;
  height: 2rpx;
  background: #e2ebe6;
}

.milestone-item:first-child .milestone-line {
  display: none;
}

.mini-medal {
  position: relative;
  z-index: 2;
  width: 76rpx;
  height: 86rpx;
}

.mini-medal-face {
  position: absolute;
  top: 0;
  left: 8rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 4rpx solid #e2e9e5;
  background: #f1f4f2;
  color: #a8b0aa;
  font-size: 28rpx;
  box-sizing: border-box;
}

.mini-medal-ribbon {
  position: absolute;
  top: 52rpx;
  left: 26rpx;
  width: 24rpx;
  height: 28rpx;
  border-radius: 0 0 6rpx 6rpx;
  background: #c7d1cb;
}

.state-achieved .milestone-line {
  background: rgba(245, 185, 78, 0.52);
}

.state-achieved .mini-medal-face {
  border-color: rgba(255, 224, 138, 0.8);
  background: radial-gradient(circle at 34% 24%, #fff7c8, #f5b94e);
  color: #fff5c4;
  box-shadow: 0 8rpx 18rpx rgba(245, 185, 78, 0.24);
}

.state-achieved .mini-medal-ribbon {
  background: var(--progress-primary);
}

.state-current .mini-medal-face {
  border-color: var(--progress-primary);
  background: #f8fbf9;
  color: var(--progress-primary);
  box-shadow: 0 0 0 8rpx rgba(20, 82, 67, 0.08);
}

.state-current .mini-medal-ribbon {
  background: var(--progress-accent);
}

.milestone-label {
  margin-top: 4rpx;
  color: var(--progress-text);
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 800;
}

.milestone-status {
  margin-top: 2rpx;
  color: var(--progress-muted);
  font-size: 19rpx;
  line-height: 26rpx;
}

.state-achieved .milestone-status {
  color: #c99024;
}

.state-current .milestone-status {
  color: var(--progress-primary);
  font-weight: 700;
}

.review-link {
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid #d8e5df;
  border-radius: 25rpx;
  background: #ffffff;
  color: var(--progress-primary);
  font-size: 22rpx;
  line-height: 50rpx;
  font-weight: 700;
}

.review-link::after,
.primary-action::after {
  display: none;
}

.record-list {
  margin-top: 24rpx;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
}

.record-item + .record-item {
  border-top: 1rpx solid var(--progress-border);
}

.record-check {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  background: #e8f6ef;
  color: var(--progress-primary);
  font-size: 24rpx;
  font-weight: 800;
}

.record-copy {
  min-width: 0;
  flex: 1;
}

.record-title {
  overflow: hidden;
  color: var(--progress-text);
  font-size: 27rpx;
  line-height: 36rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-meta {
  margin-top: 4rpx;
  color: var(--progress-secondary);
  font-size: 23rpx;
  line-height: 30rpx;
}

.record-empty {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f7faf8;
  color: var(--progress-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.state-card {
  margin-top: 80rpx;
  padding: 54rpx 34rpx;
  text-align: center;
}

.state-orbit,
.state-mark {
  width: 86rpx;
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: var(--progress-soft);
  color: var(--progress-primary);
  font-size: 34rpx;
  font-weight: 800;
}

.state-orbit {
  border: 6rpx solid #e4efe9;
  border-top-color: var(--progress-primary);
}

.state-title {
  color: var(--progress-text);
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 800;
}

.state-description {
  margin-top: 12rpx;
  color: var(--progress-secondary);
  font-size: 25rpx;
  line-height: 36rpx;
}

.primary-action {
  width: 300rpx;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 32rpx auto 0;
  border-radius: 41rpx;
  background: var(--progress-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}

@media (max-width: 340px) {
  .progress-page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .medal {
    width: 138rpx;
    transform: scale(0.88);
    transform-origin: right center;
  }

  .goal-title {
    font-size: 32rpx;
  }

  .overview-value {
    font-size: 32rpx;
  }

  .card-title-row {
    flex-direction: column;
  }

  .trend-headline-value {
    font-size: 38rpx;
    line-height: 46rpx;
  }

  .bar-y-axis,
  .bar-area {
    height: 260rpx;
  }

  .trend-stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .year-stat-value {
    font-size: 34rpx;
    line-height: 42rpx;
  }

  .highlights-grid {
    flex-wrap: wrap;
  }

  .highlight-item {
    flex: 1 1 100%;
  }
}
