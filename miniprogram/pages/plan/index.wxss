.plan-page {
  position: relative;
  padding-top: 40rpx;
}

.plan-header,
.stage-row,
.overview-progress,
.management-menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.plan-header {
  align-items: flex-start;
}

.management-menu-trigger {
  width: 80rpx !important;
  min-width: 80rpx;
  height: 68rpx;
  flex: none;
  margin-top: 8rpx;
  border-radius: 999rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.management-menu-backdrop {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: rgba(26, 34, 30, 0.18);
}

.management-menu {
  position: absolute;
  top: 150rpx;
  right: 32rpx;
  z-index: 31;
  width: 430rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 56rpx rgba(33, 48, 40, 0.18);
  animation: menu-enter 160ms ease-out;
}

.management-menu-title {
  padding: 24rpx 28rpx 12rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  font-weight: 650;
}

.management-menu-row {
  width: 100%;
  min-height: 90rpx;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid var(--color-border);
  color: var(--color-text);
  font-size: 26rpx;
  text-align: left;
}

.management-menu-row:last-child {
  border-bottom: 0;
}

.management-menu-label,
.management-menu-hint {
  color: var(--color-text-secondary);
  font-size: 21rpx;
}

.management-menu-value {
  margin-top: 4rpx;
  font-weight: 650;
}

.management-menu-copy {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.menu-arrow {
  color: #9aa19a;
  font-size: 34rpx;
}

.menu-primary-row {
  color: var(--color-primary);
  font-weight: 650;
}

.menu-danger-row {
  color: #ad4b4b;
}

.menu-row-disabled {
  color: #8b928a;
}

.overview-card {
  margin-bottom: 28rpx;
}

.stage-row {
  gap: 24rpx;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--color-border);
}

.stage-label {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.stage-row .goal-summary {
  margin-top: 6rpx;
  color: var(--color-text);
  font-weight: 650;
}

.overview-progress {
  gap: 34rpx;
  margin-top: 30rpx;
}

.progress-ring {
  position: relative;
  width: 190rpx;
  height: 190rpx;
  flex: none;
  border-radius: 50%;
  animation: ring-enter 520ms ease-out;
}

.progress-ring-center {
  position: absolute;
  inset: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
}

.progress-ring-value {
  color: var(--color-primary);
  font-size: 38rpx;
  font-weight: 750;
}

.progress-ring-label {
  margin-top: 4rpx;
  color: var(--color-text-secondary);
  font-size: 20rpx;
}

.overview-stats {
  min-width: 0;
  flex: 1;
}

.overview-stat {
  padding: 12rpx 0;
}

.overview-stat + .overview-stat {
  border-top: 1rpx solid var(--color-border);
}

.overview-stat-value {
  color: var(--color-text);
  font-size: 29rpx;
  font-weight: 700;
}

.overview-stat-label {
  margin-top: 4rpx;
  color: var(--color-text-secondary);
  font-size: 21rpx;
}

.streak-flip {
  transform-origin: center bottom;
  animation: number-flip 480ms ease-out;
}

@keyframes menu-enter {
  from { opacity: 0; transform: translateY(-10rpx) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes ring-enter {
  from { opacity: 0; transform: scale(0.88) rotate(-12deg); }
  to { opacity: 1; transform: scale(1) rotate(0); }
}

@keyframes number-flip {
  0% { opacity: 0; transform: rotateX(-70deg); }
  100% { opacity: 1; transform: rotateX(0); }
}

.goal-card,
.progress-card,
.management-card,
.next-week-card {
  margin-bottom: 24rpx;
}

@media (max-width: 340px) {
  .management-menu {
    right: 24rpx;
    width: calc(100vw - 48rpx);
  }

  .overview-progress {
    gap: 22rpx;
  }

  .progress-ring {
    width: 164rpx;
    height: 164rpx;
  }

  .progress-ring-center {
    inset: 16rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .management-menu,
  .progress-ring,
  .streak-flip,
  .weekly-goal-content {
    animation: none;
  }
}

.goal-heading,
.section-heading,
.task-top,
.time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-eyebrow {
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 650;
}

.goal-title {
  max-width: 430rpx;
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.4;
}

.category-tag,
.status-badge,
.day-status-text,
.task-state {
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.category-tag {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.goal-summary {
  margin-top: 18rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.weekly-goal {
  margin-top: 20rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  line-height: 1.6;
}

.weekly-goal-label {
  font-size: 22rpx;
  font-weight: 650;
}

.weekly-goal-toggle {
  width: 100% !important;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--color-primary);
  text-align: left;
}

.weekly-goal-action {
  font-size: 22rpx;
  font-weight: 600;
}

.weekly-goal-content {
  padding: 0 0 22rpx;
  animation: focus-expand 180ms ease-out;
}

@keyframes focus-expand {
  from { opacity: 0; transform: translateY(-6rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.goal-grid {
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
}

.goal-grid-item {
  flex: 1;
}

.goal-grid-item + .goal-grid-item {
  padding-left: 28rpx;
  border-left: 1rpx solid var(--color-border);
}

.goal-grid-value {
  font-weight: 650;
}

.goal-grid-label {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 1.5;
}

.status-active {
  display: inline-block;
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.status-paused {
  display: inline-block;
  background: #f2eadc;
  color: #806233;
}

.status-completed {
  display: inline-block;
  background: #edf0ed;
  color: #59625b;
}

.status-reviewing {
  display: inline-block;
  background: #eef0f5;
  color: #59657a;
}

.time-row {
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f6f8f5;
}

.time-label {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.time-value {
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.outline-button {
  padding: 16rpx 22rpx;
  border: 2rpx solid var(--color-primary);
  border-radius: 999rpx;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.paused-notice {
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 22rpx;
  background: #f5eddf;
  color: #705b37;
  line-height: 1.55;
}

.paused-title {
  margin-bottom: 6rpx;
  font-weight: 700;
}

.progress-count,
.progress-copy,
.selected-date {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.progress-rate {
  color: var(--color-primary);
  font-size: 42rpx;
  font-weight: 700;
}

.progress-track {
  height: 18rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e8ece6;
}

.action-stats {
  display: flex;
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
}

.action-stat {
  flex: 1;
  text-align: center;
}

.action-stat + .action-stat {
  border-left: 1rpx solid var(--color-border);
}

.action-stat-value {
  color: var(--color-primary);
  font-size: 36rpx;
  font-weight: 700;
}

.action-stat-label {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.recent-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-top: 20rpx;
}

.recent-day {
  min-width: 0;
  padding: 16rpx 4rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  background: #ffffff;
  text-align: center;
}

.recent-completed,
.recent-today,
.recent-rest {
  background: var(--color-primary-light);
}

.recent-partial,
.recent-missed,
.recent-paused {
  background: #faf7f1;
}

.recent-date,
.recent-status,
.recent-count {
  overflow: hidden;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-status {
  margin-top: 8rpx;
  color: var(--color-primary);
  font-weight: 650;
}

.recent-count {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
}

.timeline-section,
.task-section {
  margin-top: 36rpx;
  margin-bottom: 34rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
}

.timeline-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.timeline-row {
  display: inline-flex;
  padding: 2rpx 2rpx 18rpx;
}

.day-chip {
  width: 210rpx;
  margin-right: 16rpx;
  padding: 22rpx 18rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
  background: #ffffff;
  text-align: left;
}

.day-selected {
  border-color: var(--color-primary);
  box-shadow: 0 8rpx 22rpx rgba(53, 104, 89, 0.12);
}

.day-today {
  background: #f1f7f4;
}

.day-completed {
  background: #f4f8f5;
}

.day-rest {
  background: #f4f7f3;
}

.day-missed,
.day-paused {
  background: #faf7f1;
}

.day-index {
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 650;
}

.day-date {
  margin-top: 10rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.day-week,
.day-count {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 21rpx;
}

.today-mark {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 650;
}

.day-status-text {
  background: #edf2ee;
  color: var(--color-primary);
}

.task-card {
  margin-top: 18rpx;
  padding: 28rpx;
}

.task-completed {
  border-color: #cfe1d8;
  background: #f4f8f5;
}

.task-paused,
.task-expired {
  background: #faf8f3;
}

.task-title {
  flex: 1;
  padding-right: 18rpx;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.45;
}

.task-state {
  flex-shrink: 0;
  background: #edf0ed;
  color: #59625b;
}

.task-description {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.55;
}

.task-meta,
.postpone-info {
  margin-top: 12rpx;
  color: #879087;
  font-size: 22rpx;
}

.postpone-info {
  color: #806233;
}

.task-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 22rpx;
}

.text-button {
  padding: 16rpx 20rpx;
  color: var(--color-primary);
  font-size: 24rpx;
}

.empty-tasks {
  margin-top: 18rpx;
  text-align: center;
}

.small-mark {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto;
  border-radius: 22rpx;
  font-size: 30rpx;
}

.empty-task-title {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 650;
}

.resume-copy,
.next-week-copy {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.management-button,
.primary-management-button,
.delete-button {
  width: 100%;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 999rpx;
  font-weight: 650;
}

.management-button {
  border: 2rpx solid #a48654;
  color: #735b33;
}

.primary-management-button {
  background: var(--color-primary);
  color: #ffffff;
}

.delete-button {
  border: 2rpx solid #d8a0a0;
  color: #ad4b4b;
}

.next-week-title {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.full-button {
  width: 100%;
}

.next-week-error {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #faf3e8;
  color: #735b33;
}

.error-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.error-actions button {
  color: var(--color-primary);
  font-weight: 600;
}

.next-preview {
  margin-top: 24rpx;
}

.next-preview-summary {
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.5;
}

.next-preview-goal {
  margin-top: 12rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  line-height: 1.55;
}

.next-preview-day {
  margin-top: 14rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 1.55;
}
