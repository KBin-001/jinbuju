/* =========================================================
 * V2 设计稿最终对齐：成长档案（默认 · 浅绿主基调）
 * 仅作用于默认主题；墨绿主题另起一节沉浸式深绿覆写。
 * ========================================================= */
.progress-page {
  --progress-primary: #356859;
  --progress-deep: #1F5B4A;
  --progress-soft: #F0F5F1;
  --progress-accent: #7FAA91;
  --progress-text: #233B34;
  --progress-secondary: #71827A;
  --progress-muted: #9AA9A4;
  --progress-border: #E6EEE9;
  --progress-shadow: 0 12rpx 32rpx rgba(31, 91, 74, 0.09);
  padding: 18rpx 28rpx calc(170rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 100% 90%, rgba(214, 232, 222, 0.92), transparent 28%),
    #ECF3EE;
  color: #233B34;
}

.goal-card,
.progress-page[data-theme="inkGreen"] .goal-card {
  position: relative;
  min-height: 272rpx;
  padding: 30rpx 30rpx 28rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 28rpx;
  background: #1F5B4A;
  color: #FFFFFF;
  box-shadow: 0 16rpx 36rpx rgba(31, 91, 74, 0.18);
}

.goal-card-bg,
.goal-card-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.goal-card-bg {
  z-index: 0;
}

.goal-card-shade {
  z-index: 1;
  background: linear-gradient(90deg, rgba(20, 66, 53, 0.32) 0%, rgba(20, 66, 53, 0.12) 58%, rgba(20, 66, 53, 0.02) 100%);
  pointer-events: none;
}

.goal-card-main {
  position: relative;
  z-index: 2;
  min-height: 214rpx;
  align-items: flex-start;
}

.goal-card .section-eyebrow,
.progress-page[data-theme="inkGreen"] .goal-card .section-eyebrow {
  color: rgba(255, 255, 255, 0.80);
  font-size: 22rpx;
  font-weight: 500;
}

.goal-card .goal-title,
.progress-page[data-theme="inkGreen"] .goal-card .goal-title {
  max-width: 520rpx;
  margin-top: 8rpx;
  color: #FFFFFF;
  font-size: 40rpx;
  line-height: 50rpx;
  text-shadow: 0 3rpx 12rpx rgba(10, 45, 35, 0.24);
}

.goal-meta-row {
  margin-top: 14rpx;
}

.goal-card .level-chip,
.progress-page[data-theme="inkGreen"] .goal-card .level-chip {
  border: 0;
  background: #FFF2CD;
  color: #745B20;
}

.goal-card .status-chip,
.progress-page[data-theme="inkGreen"] .goal-card .status-chip {
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  background: rgba(105, 170, 145, 0.42);
  color: #FFFFFF;
  backdrop-filter: blur(8rpx);
}

.goal-card .goal-period,
.progress-page[data-theme="inkGreen"] .goal-card .goal-period {
  position: absolute;
  left: 30rpx;
  bottom: 26rpx;
  margin: 0;
  color: rgba(255, 255, 255, 0.88);
  font-size: 22rpx;
}

.goal-switch-button {
  position: absolute;
  right: 26rpx;
  bottom: 24rpx;
  height: 66rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 33rpx;
  background: rgba(255, 252, 243, 0.94);
  color: #1F5B4A;
  font-size: 24rpx;
  box-shadow: 0 10rpx 22rpx rgba(15, 58, 45, 0.16);
}

.goal-switch-arrow {
  width: 10rpx;
  height: 10rpx;
  border: 0;
  border-top: 2rpx solid #356859;
  border-right: 2rpx solid #356859;
  transform: rotate(45deg);
}

.overview-card,
.trend-card,
.milestone-card,
.record-card,
.ai-coach-card--summary {
  margin-top: 22rpx;
  border: 1rpx solid rgba(230, 238, 233, 0.86);
  border-radius: 26rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 30rpx rgba(31, 91, 74, 0.07);
}

.overview-card {
  padding: 24rpx 26rpx;
}

.overview-card .card-subtitle {
  display: none;
}

.card-title,
.trend-card .card-title {
  color: #233B34;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.overview-grid {
  gap: 0;
  margin-top: 18rpx;
}

.overview-item {
  position: relative;
  padding: 10rpx 8rpx 4rpx;
  border-radius: 0;
  background: transparent;
}

.overview-item + .overview-item::before {
  position: absolute;
  top: 8rpx;
  bottom: 4rpx;
  left: 0;
  width: 1rpx;
  background: #E6EEE9;
  content: "";
}

.overview-value {
  color: #1F5B4A;
  font-size: 42rpx;
  line-height: 50rpx;
}

.overview-label {
  margin-top: 4rpx;
  color: #526B62;
  font-size: 22rpx;
}

.trend-card {
  padding: 24rpx 24rpx 22rpx;
}

.trend-card .card-title-row {
  align-items: flex-start;
}

.trend-card .card-subtitle {
  color: #71827A;
}

.trend-card .trend-range-tabs {
  border: 0;
  background: #F0F3F1;
}

.trend-card .trend-range-tab {
  min-width: 58rpx;
  height: 46rpx;
  padding: 0 18rpx;
  border: 0;
  border-radius: 23rpx;
  color: #53645E;
}

.trend-card .trend-range-tab + .trend-range-tab {
  border: 0;
}

.trend-card .trend-range-tab.is-active {
  border-radius: 23rpx;
  background: linear-gradient(145deg, #356859, #1F5B4A);
  color: #FFFFFF;
}

.trend-metric-panel,
.ai-coach-card--inside,
.trend-stats-grid {
  display: none;
}

.chart-title-row {
  justify-content: flex-start;
  gap: 30rpx;
  margin-top: 20rpx;
}

.chart-legend {
  color: #526B62;
  font-size: 21rpx;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #4B8B77;
  box-shadow: 0 0 0 4rpx #EAF5EF;
}

.legend-line {
  width: 34rpx;
  background: #E6A83E;
}

.legend-line::before {
  top: -6rpx;
  left: 11rpx;
  width: 13rpx;
  height: 13rpx;
  border-width: 2rpx;
  border-color: #E6A83E;
}

.trend-card .bar-chart {
  margin-top: 12rpx;
}

.trend-card .bar-y-axis,
.trend-card .bar-area {
  height: 210rpx;
}

.trend-card .bar-fill {
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  background: linear-gradient(180deg, #8DBAA8 0%, #4B8B77 100%);
  opacity: 0.9;
}

.trend-card .bar-fill.is-max,
.trend-card .bar-column.is-active .bar-fill,
.progress-page[data-theme="inkGreen"] .trend-card .bar-fill.is-max,
.progress-page[data-theme="inkGreen"] .trend-card .bar-column.is-active .bar-fill {
  background: linear-gradient(180deg, #6FA28E 0%, #356859 100%);
}

.trend-card .bar-labels {
  color: #61736C;
}

.trend-summary-strip {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: #EAF5EF;
  color: #356859;
  font-size: 22rpx;
  line-height: 32rpx;
}

.ai-coach-card--summary {
  padding: 24rpx 26rpx;
  border-color: #D5E6DC;
  background: linear-gradient(135deg, #DDEDE4 0%, #EFF6F1 100%);
  color: #233B34;
}

.ai-coach-card--summary .ai-coach-icon {
  width: 50rpx;
  height: 50rpx;
  border-radius: 15rpx;
  background: linear-gradient(145deg, #356859, #1F5B4A);
  color: #FFFFFF;
  box-shadow: 0 8rpx 18rpx rgba(31, 91, 74, 0.18);
}

.ai-coach-card--summary .ai-coach-title {
  color: #1F5B4A;
  font-size: 29rpx;
  font-weight: 800;
}

.ai-coach-card--summary .ai-coach-period {
  padding: 8rpx 16rpx;
  border-radius: 18rpx;
  background: #EAF5EF;
  color: #356859;
  font-size: 21rpx;
}

.ai-coach-summary {
  margin: 14rpx 0 0 66rpx;
  color: #526B62;
  font-size: 23rpx;
  line-height: 34rpx;
}

/* ============ AI 进度教练容器 - Figma 优化版 ============ */
.ai-coach-card--summary {
  padding: 28rpx 24rpx;
  border-color: #CFE5D5;
  background: linear-gradient(180deg, #FFFDF7 0%, #F4FAF2 100%);
