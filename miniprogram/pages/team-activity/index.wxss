.activity-page {
  --paper: #F7F1E6;
  --card: rgba(255, 252, 245, 0.94);
  --ink: #244D42;
  --muted: #746F68;
  --gold: #B88731;
  --green: #2B604F;
  --green-soft: #E7F0E6;
  --line: rgba(206, 196, 176, 0.62);
  --shadow: 0 16rpx 42rpx rgba(58, 48, 32, 0.075);
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 22% 8%, rgba(226, 207, 165, 0.28), transparent 20%),
    linear-gradient(180deg, #FBF7EF 0%, #F7F1E6 46%, #F5EEE2 100%);
  color: var(--ink);
}

.activity-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 420rpx;
  opacity: 0.48;
  pointer-events: none;
}

.activity-bg-mask {
  position: absolute;
  inset: 0 0 auto;
  height: 560rpx;
  background: linear-gradient(180deg, rgba(251, 247, 239, 0.08) 0%, #F7F1E6 96%);
  pointer-events: none;
}

.paper-card {
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  border-radius: 30rpx;
  background: var(--card);
  box-shadow: var(--shadow);
}

.nav-bar {
  position: relative;
  z-index: 3;
}

.nav-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  padding-left: 96rpx;
}

.nav-back {
  position: absolute;
  left: 24rpx;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  transform: translateY(-50%);
}

.nav-back-arrow {
  color: var(--ink);
  font-size: 58rpx;
  line-height: 1;
}

.nav-titles {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nav-title {
  color: var(--ink);
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 44rpx;
  letter-spacing: 4rpx;
}

.nav-subtitle {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 30rpx;
}

.activity-body {
  position: relative;
  z-index: 1;
  padding: 56rpx 38rpx calc(56rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.timeline-card {
  position: relative;
  padding: 28rpx 0 20rpx;
  overflow: hidden;
}

.timeline-card::before {
  content: "";
  position: absolute;
  left: 63rpx;
  top: 72rpx;
  bottom: 46rpx;
  width: 2rpx;
  background: rgba(206, 196, 176, 0.72);
}

.activity-item-wrap {
  position: relative;
}

.date-header {
  margin: 12rpx 28rpx 18rpx;
  color: var(--gold);
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.activity-item {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 116rpx;
  padding: 18rpx 24rpx 18rpx 38rpx;
  box-sizing: border-box;
}

.activity-item--pressed {
  background: rgba(231, 240, 230, 0.34);
}

.timeline-dot {
  position: absolute;
  left: 58rpx;
  top: 56rpx;
  z-index: 2;
  width: 12rpx;
  height: 12rpx;
  border: 4rpx solid #FFFDF5;
  border-radius: 50%;
  background: var(--gold);
  box-shadow: 0 0 0 1rpx rgba(184, 135, 49, 0.28);
}

.activity-avatar,
.detail-avatar {
  position: relative;
  z-index: 1;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  width: 68rpx;
  height: 68rpx;
  border: 4rpx solid rgba(255, 252, 245, 0.96);
  border-radius: 50%;
  color: #FFFDF5;
  font-size: 27rpx;
  font-weight: 800;
  box-shadow: 0 6rpx 14rpx rgba(58, 48, 32, 0.08);
}

.avatar-grad image,
.activity-avatar image,
.detail-avatar image {
  display: block;
  width: 100%;
  height: 100%;
}

.avatar-grad.grad-1 { background: linear-gradient(135deg, #9FBBA7 0%, #2B604F 100%); }
.avatar-grad.grad-2 { background: linear-gradient(135deg, #CFC5A5 0%, #6A806F 100%); }
.avatar-grad.grad-3 { background: linear-gradient(135deg, #D7BA78 0%, #906824 100%); }
.avatar-grad.grad-4 { background: linear-gradient(135deg, #AFC4BC 0%, #446B5D 100%); }
.avatar-grad.grad-5 { background: linear-gradient(135deg, #CDBEAA 0%, #7A6E5E 100%); }
.avatar-grad.grad-6 { background: linear-gradient(135deg, #D3A78E 0%, #8F5F4F 100%); }

.activity-main {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
}

.activity-line1 {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  min-width: 0;
}

.activity-name {
  flex: none;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.activity-action {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 34rpx;
}

.activity-line2 {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.activity-type-tag {
  display: inline-flex;
  align-items: center;
  height: 34rpx;
  padding: 0 13rpx;
  border-radius: 999rpx;
  background: var(--green-soft);
  color: var(--green);
  font-size: 20rpx;
  font-weight: 700;
}

.tag-partial,
.tag-streak {
  background: rgba(244, 227, 188, 0.72);
  color: #8C641B;
}

.tag-started,
.tag-joined,
.tag-encouraged {
  background: rgba(238, 232, 217, 0.82);
  color: var(--muted);
}

.activity-time {
  color: var(--muted);
  font-size: 22rpx;
}

.activity-chevron {
  flex: none;
  margin-left: 12rpx;
  color: #AFA694;
  font-size: 32rpx;
}

.list-footer {
  padding: 28rpx 0 6rpx;
  color: var(--muted);
  font-size: 24rpx;
  text-align: center;
}

.footer-end,
.footer-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.footer-line {
  width: 80rpx;
  height: 1rpx;
  background: var(--line);
}

.footer-spinner {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid rgba(43, 96, 79, 0.18);
  border-top-color: var(--green);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.skeleton-card {
  padding: 26rpx;
}

.skeleton-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
}

.skeleton-avatar,
.skeleton-line,
.skeleton-tag {
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(231, 224, 210, 0.7), rgba(255, 252, 245, 0.9), rgba(231, 224, 210, 0.7));
}

.skeleton-avatar {
  width: 68rpx;
  height: 68rpx;
}

.skeleton-lines {
  flex: 1;
}

.skeleton-line {
  height: 24rpx;
  margin-top: 12rpx;
}

.skeleton-line--short {
  width: 48%;
  margin-top: 0;
}

.empty-state {
  margin-top: 60rpx;
  padding: 78rpx 38rpx;
  text-align: center;
}

.empty-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--green-soft);
  color: var(--green);
  font-size: 30rpx;
  font-weight: 800;
}

.empty-title {
  margin-top: 22rpx;
  color: var(--ink);
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-copy {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 36rpx;
}
.empty-action { min-height: 68rpx; margin-top: 24rpx; padding: 0 28rpx; display: flex; align-items: center; justify-content: center; border-radius: 34rpx; background: var(--color-primary, #245b4d); color: #fff; font-size: 23rpx; font-weight: 650; }

.bottom-safe-area {
  height: env(safe-area-inset-bottom);
}

.detail-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(32, 58, 50, 0.28);
  backdrop-filter: blur(8rpx);
}

.detail-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 78vh;
  padding: 0 30rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: #F7F1E6;
  overflow-y: auto;
  box-shadow: 0 -18rpx 50rpx rgba(58, 48, 32, 0.18);
}

.detail-handle-row {
  position: relative;
  height: 58rpx;
}

.detail-handle {
  position: absolute;
  left: 50%;
  top: 24rpx;
  width: 76rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #DED4C0;
  transform: translateX(-50%);
}

.detail-close {
  position: absolute;
  right: 0;
  top: 13rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #FFFDF5;
  color: var(--muted);
  font-size: 32rpx;
}

.detail-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 10rpx 0 24rpx;
}

.detail-avatar {
  width: 96rpx;
  height: 96rpx;
  font-size: 36rpx;
}

.detail-head-main {
  flex: 1;
  min-width: 0;
}

.detail-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.detail-name {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 700;
}

.detail-time {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.detail-action {
  color: var(--ink);
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.detail-content {
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.detail-meta {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
}

.meta-item {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.meta-item:last-child {
  border-bottom: 0;
}

.meta-label {
  flex: none;
  color: var(--muted);
  font-size: 24rpx;
}

.meta-value {
  min-width: 0;
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 700;
  text-align: right;
}

.detail-footer {
  margin-top: 26rpx;
}

.detail-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  border-radius: 999rpx;
  background: var(--green);
  color: #FFFDF5;
  font-size: 28rpx;
  font-weight: 700;
}

@media (max-width: 350px) {
  .activity-body {
    padding-left: 26rpx;
    padding-right: 26rpx;
  }

  .activity-name {
    max-width: 120rpx;
  }

  .detail-sheet {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }
}
