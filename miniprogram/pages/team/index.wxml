<view class="page team-page">
  <view class="page-header growth-hero team-hero">
    <view class="page-eyebrow">3～5 人自律同行</view>
    <view class="page-title">小队</view>
    <view class="page-subtitle">目标可以不同，认真行动这件事相同。</view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="card state-card">
    <ant-loading type="spin" size="large" color="#356859" />
    <view class="state-title">正在同步小队信息</view>
    <view class="state-description">稍等一下，马上回来。</view>
  </view>

  <view wx:elif="{{status === 'empty'}}" class="card state-card">
    <view class="state-mark">3</view>
    <view class="state-title">还没有加入行动小队</view>
    <view class="state-description">
      学习、运动、求职或创作，都可以加入同一个自律小队。
    </view>
    <ant-button
      type="primary"
      className="growth-primary-button"
      loading="{{joining}}"
      disabled="{{joining}}"
      bindtap="joinTeam"
    >{{joining ? '正在加入' : '加入小队'}}</ant-button>
  </view>

  <view wx:elif="{{status === 'error'}}" class="card state-card">
    <view class="state-mark">!</view>
    <view class="state-title">
      {{errorCode === 'NOT_TEAM_MEMBER' ? '暂无访问权限' : '小队加载失败'}}
    </view>
    <view class="state-description">{{errorMessage}}</view>
    <ant-button type="primary" className="growth-primary-button" bindtap="retry">重新加载</ant-button>
  </view>

  <block wx:else>
    <ant-card className="team-summary-card growth-ant-card">
      <view class="summary-heading">
        <view>
          <view class="section-eyebrow">我的行动小队</view>
          <view class="team-name">{{team.name}}</view>
        </view>
        <view class="member-count">{{team.memberCount}} / {{team.maxMembers}}</view>
      </view>

      <view class="team-detail">
        <view class="detail-row">
          <text class="detail-label">小队定位</text>
          <text class="detail-value">跨目标自律同行</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">当前阶段</text>
          <text class="detail-value">{{team.stageTitle}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">阶段日期</text>
          <text class="detail-value">{{stageDateRange}}</text>
        </view>
      </view>

      <view class="today-summary">
        今日已有 <text>{{team.todayCompletedCount}}</text> 人完成行动
      </view>
      <view wx:if="{{team.memberCount < 3}}" class="waiting-notice">
        正在等待新的行动伙伴加入
      </view>
      <view wx:elif="{{team.memberCount >= team.maxMembers}}" class="full-notice">
        小队成员已集结
      </view>
    </ant-card>

    <view class="members-section">
      <view class="section-heading">
        <view class="section-title">小队成员</view>
        <view class="privacy-copy">仅展示必要行动信息</view>
      </view>

      <ant-card
        wx:for="{{members}}"
        wx:key="id"
        className="member-card growth-ant-card {{item.isSelf ? 'member-self' : ''}}"
      >
        <view class="member-top">
          <ant-badge type="{{item.todayCompleted ? 'dot' : 'text'}}" text="{{item.todayCompleted ? '' : '待'}}" position="bottom-right" bgColor="{{item.todayCompleted ? '#D8A84E' : '#7567C8'}}">
            <ant-avatar className="member-avatar" size="large" src="{{item.avatarDisplay}}" aria-label="{{item.nickname}}的头像" />
          </ant-badge>
          <view class="member-main">
            <view class="member-name-row">
              <view class="member-name">{{item.nickname}}</view>
              <view wx:if="{{item.isSelf}}" class="self-tag">我</view>
            </view>
            <view class="member-streak">目标：{{item.goalTitle || '正在建立目标'}}</view>
          </view>
          <view class="today-tag {{item.todayRest ? 'today-rest' : (item.todayCompleted ? 'today-done' : 'today-pending')}}">
            {{item.todayStatusText}}
          </view>
        </view>

        <view class="member-progress-row">
          <view>
            <view class="member-progress-value">{{item.todayMinutes || 0}} 分钟</view>
            <view class="member-progress-label">今日投入</view>
          </view>
          <view>
            <view class="member-progress-value">{{item.encouragementCount}}</view>
            <view class="member-progress-label">收到鼓励</view>
          </view>
        </view>

        <view
          class="member-progress-track"
          aria-role="progressbar"
          aria-label="{{item.nickname}}阶段完成 {{item.stageCompletionRate}}%"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="{{item.stageCompletionRate}}"
        >
          <view class="member-progress-fill" style="width: {{item.stageCompletionRate}}%;"></view>
        </view>

        <button
          wx:if="{{!item.isSelf}}"
          class="encourage-button {{item.encouragedByMeToday ? 'encouraged-button' : ''}}"
          data-member-id="{{item.id}}"
          loading="{{encouragingMemberId === item.id}}"
          disabled="{{item.encouragedByMeToday || encouragingMemberId !== ''}}"
          bindtap="chooseEncouragement"
        >
          {{item.encouragedByMeToday ? '今天已鼓励' : '送鼓励'}}
        </button>
      </ant-card>
    </view>
  </block>
</view>
