<view class="team-page" data-theme="{{appTheme}}">
  <view class="team-header tab-header" style="height: {{headerHeight}}px;">
    <image class="team-bg tab-header__background" src="/assets/team-header-watercolor-v2.jpg" mode="aspectFill" aria-hidden="true" />
    <view class="team-bg-mask tab-header__veil"></view>
    <view class="team-nav tab-header__nav" style="padding-top: {{menuTop}}px; height: {{menuHeight}}px;">
      <view class="team-nav-title tab-header__title">小队</view>
    </view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="team-content team-content--state">
    <view class="paper-card state-card">
      <view class="state-seal">同</view>
      <view class="state-title">正在整理小队信息</view>
      <view class="state-copy">稍等一下，马上回来。</view>
    </view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="team-content team-content--state">
    <view class="paper-card state-card">
      <view class="state-seal">!</view>
      <view class="state-title">小队暂时没有加载出来</view>
      <view class="state-copy">{{errorMessage}}</view>
      <view class="state-action" bindtap="retry">重新加载</view>
    </view>
  </view>

  <view wx:elif="{{status === 'empty'}}" class="team-content team-content--state">
    <view class="paper-card state-card state-card--empty">
      <view class="state-seal">伴</view>
      <view class="state-title">还没有加入小队</view>
      <view class="state-copy">创建或使用房间号加入，和伙伴一起记录真实行动。</view>
      <view class="state-actions">
        <view class="state-action state-action--solid" bindtap="createLocalTeam">{{creating ? '正在创建' : '创建小队'}}</view>
        <view class="state-action" bindtap="openJoinPopup">房间号加入</view>
      </view>
    </view>
  </view>

  <view wx:else class="team-content">
    <view wx:if="{{serviceNotice}}" class="team-service-notice">{{serviceNotice}}</view>
    <view wx:if="{{teamNotificationPromptVisible}}" class="team-notification-optin">
      <view><view>关注小队的真实进展</view><text>队友完成行动时轻量提醒；夜间只保留站内消息。</text></view>
      <button disabled="{{notificationAuthorizing}}" bindtap="subscribeTeamActivity">{{notificationAuthorizing ? '正在授权' : '开启提醒'}}</button>
    </view>
    <view class="team-hero paper-card">
      <view class="hero-identity">
        <view class="hero-identity-copy">
          <view class="hero-title-line"><text class="hero-title">{{displayTeamName}}</text></view>
          <view class="hero-subtitle">{{team.slogan || team.announcement || team.description || '一起行动，各自成长'}}<text> · 同行第 {{teamDays}} 天</text></view>
        </view>
        <view wx:if="{{settingsCanEditTeam}}" class="hero-settings" bindtap="openTeamSettings" hover-class="hero-settings--pressed">
          <image src="/assets/team/icon-settings.svg" mode="aspectFit" /><text>设置</text>
        </view>
        <view wx:else class="hero-settings" bindtap="openTeamInfo" hover-class="hero-settings--pressed">
          <image src="/assets/team/icon-settings.svg" mode="aspectFit" /><text>信息</text>
        </view>
      </view>

      <view wx:if="{{teamViewMode === 'group'}}" class="hero-today">
        <view class="hero-today-heading"><t-icon name="time-filled" size="31rpx" /><text>今日同行</text></view>
        <view class="hero-stat-grid">
          <view class="hero-stat-item"><text class="hero-stat-value">{{teamStats.completedMembers}}/{{teamStats.totalMembers}}</text><text class="hero-stat-label">今日完成</text></view>
          <view class="hero-stat-item"><text class="hero-stat-value">{{teamStats.startedMembers}}</text><text class="hero-stat-label">已经开始</text></view>
          <view class="hero-stat-item"><text class="hero-stat-value">{{teamStats.totalGrowthMinutes}}</text><text class="hero-stat-label">共同投入·分钟</text></view>
        </view>
        <view class="hero-community-row">
          <view class="hero-avatar-stack">
            <view wx:for="{{heroAvatarSlots}}" wx:key="id" wx:for-index="avatarIndex" class="hero-avatar {{item.isExtra ? 'hero-avatar--extra' : ''}}">
              <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" data-index="{{avatarIndex}}" binderror="onHeroAvatarError" />
              <text wx:elif="{{item.isExtra}}">{{item.avatarText}}</text>
              <image wx:else src="/images/icons/avatar.png" mode="aspectFill" />
            </view>
          </view>
          <view wx:if="{{canInviteFriends && team.memberCount < team.maxMembers}}" class="hero-invite" bindtap="inviteFriends" hover-class="hero-invite--pressed">
            <image src="/assets/team/icon-invite.svg" mode="aspectFit" /><text>邀请伙伴</text>
          </view>
          <view wx:else class="hero-member-waiting">{{inviteUnavailableText}}</view>
        </view>
        <view class="hero-room" bindtap="copyRoomCode" hover-class="hero-room--pressed" aria-label="复制房间号">房间号 {{displayRoomCode}}<text>·</text><text class="hero-room-copy">复制</text></view>
      </view>

      <view wx:else class="solo-invite">
        <view class="solo-invite-heading">小队已经准备好了</view>
        <view class="solo-invite-copy">邀请第一位伙伴加入后，这里会出现真实的同行进度与行动动态。</view>
        <view class="solo-member-line">
          <view class="hero-avatar-stack">
            <view wx:for="{{heroAvatarSlots}}" wx:key="id" wx:for-index="avatarIndex" class="hero-avatar">
              <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" data-index="{{avatarIndex}}" binderror="onHeroAvatarError" />
              <image wx:else src="/images/icons/avatar.png" mode="aspectFill" />
            </view>
          </view>
          <text>当前 {{team.memberCount}}/{{team.maxMembers}} 人</text>
        </view>
        <view wx:if="{{canInviteFriends}}" class="solo-invite-button" bindtap="inviteFriends" hover-class="hero-invite--pressed"><image src="/assets/team/icon-invite.svg" mode="aspectFit" /><text>邀请第一位伙伴</text></view>
        <view wx:else class="solo-invite-unavailable">{{inviteUnavailableText}}</view>
        <view class="hero-room" bindtap="copyRoomCode" hover-class="hero-room--pressed" aria-label="复制房间号">房间号 {{displayRoomCode}}<text>·</text><text class="hero-room-copy">复制</text></view>
      </view>
    </view>

    <view wx:if="{{teamViewMode === 'solo'}}" class="solo-action-card paper-card">
      <view class="solo-action-eyebrow">我的今日行动</view>
      <view class="hero-primary {{selfActionPrompt.allDone ? 'hero-primary--done' : ''}}" bindtap="goToday" hover-class="hero-primary--pressed" aria-role="button" aria-label="{{selfActionPrompt.buttonText}}，{{selfActionPrompt.text}}">
        <image class="hero-primary-background" src="/assets/profile/goal-mountain-v2.jpg" mode="aspectFill" />
        <view class="hero-primary-icon"><t-icon name="{{selfActionPrompt.allDone ? 'check' : 'task-time'}}" size="40rpx" /></view>
        <view class="hero-primary-copy"><text class="hero-primary-title">{{selfActionPrompt.buttonText}}</text><text class="hero-primary-note">{{selfActionPrompt.text}}</text><text class="hero-primary-status">{{selfActionPrompt.allDone ? '今日已完成' : '今日待行动'}}</text></view>
        <view class="hero-primary-arrow"><t-icon name="chevron-right" size="34rpx" /></view>
      </view>
    </view>

    <view wx:if="{{teamViewMode === 'group'}}" class="companion-card paper-card">
      <view class="section-head">
        <view class="section-title">今日行动榜</view>
        <view class="section-link" bindtap="openAllMembers">查看全部 <image src="/assets/team/icon-arrow.svg" mode="aspectFit" /></view>
      </view>

      <view wx:if="{{companionRows.length}}" class="companion-list">
        <view
          wx:for="{{companionRows}}"
          wx:key="id"
          wx:for-index="memberIndex"
          class="companion-row companion-row--{{item.statusClass}}"
          data-id="{{item.id}}"
          bindtap="openMemberDetail"
        >
          <view class="companion-rank">{{item.rank}}</view>
          <view class="companion-marker">
            <image src="/assets/team/leaf-node.svg" mode="aspectFit" />
            <view wx:if="{{item.statusClass === 'completed'}}" class="companion-marker-check">✓</view>
          </view>

          <view class="companion-avatar">
            <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" data-index="{{memberIndex}}" binderror="onCompanionAvatarError" />
            <image wx:else src="/images/icons/avatar.png" mode="aspectFill" />
          </view>

          <view class="companion-main">
            <view class="companion-name-line">
              <text class="companion-name">{{item.name}}</text>
              <text class="companion-chip companion-chip--{{item.statusClass}}">{{item.statusLabel}}</text>
            </view>
            <view class="companion-action">{{item.actionSummary}}</view>
            <view class="companion-progress">
              <view class="companion-progress-fill companion-progress-fill--{{item.statusClass}}" style="width: {{item.progressKnown ? item.progressPercent : 0}}%;"></view>
            </view>
          </view>

          <view class="companion-metric">
            <view class="companion-minutes">{{item.growthMinutes}}<text>分钟</text></view>
            <view class="companion-percent">{{item.progressText}}</view>
          </view>
        </view>
      </view>

      <view wx:else class="companion-empty">成员开始记录行动后，会在这里留下今天的进度。</view>

      <view class="self-prompt {{selfActionPrompt.allDone ? 'self-prompt--done' : ''}}">
        <view class="self-prompt-icon"><t-icon name="{{selfActionPrompt.allDone ? 'check' : 'task-time'}}" size="28rpx" /></view>
        <view class="self-prompt-copy"><text class="self-prompt-title">{{selfActionPrompt.buttonText}}</text><text class="self-prompt-note">{{selfRankNote}}</text></view>
        <view class="self-prompt-button" bindtap="goToday" hover-class="self-prompt-button--pressed"><text>{{selfActionPrompt.allDone ? '查看' : '前往'}}</text><t-icon name="chevron-right" size="25rpx" /></view>
      </view>
      <view wx:if="{{companionExtra > 0}}" class="companion-more" bindtap="openAllMembers">还有 {{companionExtra}} 位伙伴，查看全部成员</view>
    </view>

    <view wx:if="{{teamViewMode === 'group'}}" class="activity-card paper-card">
      <view class="section-head section-head--activity">
        <view class="section-title">小队动态</view>
        <view class="encourage-pill" bindtap="openAllMembers">
          <image src="/assets/team/icon-chat.svg" mode="aspectFit" />
          <text>送一句鼓励</text>
        </view>
      </view>

      <view wx:if="{{activityStatus === 'ready' && activityList.length}}" class="activity-list">
        <view
          wx:for="{{activityList}}"
          wx:key="id"
          wx:for-index="activityIndex"
          class="activity-row"
          data-id="{{item.memberId}}"
          bindtap="openMemberDetail"
        >
          <view class="activity-line"><view class="activity-dot"></view></view>
          <view class="activity-avatar">
            <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" data-index="{{activityIndex}}" binderror="onActivityAvatarError" />
            <image wx:else src="/images/icons/avatar.png" mode="aspectFill" />
          </view>
          <view class="activity-copy"><text>{{item.name}}</text>{{item.actionText}}</view>
          <view class="activity-time">{{item.time}}</view>
        </view>
      </view>
      <view wx:elif="{{activityStatus === 'loading'}}" class="activity-empty">正在读取小队的真实行动动态…</view>
      <view wx:elif="{{activityStatus === 'error'}}" class="activity-empty">小队动态暂时无法读取，今日榜单仍可继续查看。</view>
      <view wx:elif="{{activityStatus === 'unavailable'}}" class="activity-empty">联网后可查看小队的真实行动动态。</view>
      <view wx:else class="activity-empty">今天还没有新的高价值动态，先从自己的一小步开始。</view>
      <view wx:if="{{activityStatus === 'ready' || activityStatus === 'empty'}}" class="activity-all" bindtap="openAllActivities">查看全部动态 <image src="/assets/team/icon-arrow.svg" mode="aspectFit" /></view>
    </view>
  </view>

  <view wx:if="{{joinPopupVisible}}" class="team-popup-layer">
    <view class="team-popup-mask" catchtap="closeJoinPopup"></view>
    <view class="team-popup" catchtap="noop">
      <view class="popup-handle"></view>
      <view class="popup-eyebrow">加入小队</view>
      <view class="popup-title">输入房间号加入</view>
      <view class="popup-copy">输入伙伴分享的 6 位房间号，一起开始今天的行动。</view>
      <t-input class="room-input" maxlength="6" value="{{roomCodeInput}}" placeholder="例如 TQLR01" bindchange="inputRoomCode" />
      <view class="popup-actions">
        <view class="popup-button popup-button--ghost" bindtap="closeJoinPopup">取消</view>
        <view class="popup-button popup-button--solid" bindtap="submitJoinRoom">{{joining ? '加入中' : '加入小队'}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{settingsVisible}}" class="team-settings-layer" catchtouchmove="noop">
    <view class="team-settings-mask" catchtap="closeTeamSettings"></view>
    <view class="team-settings-dialog" catchtap="noop">
      <view class="settings-header">
        <view>
          <view class="settings-title">小队设置</view>
        </view>
        <view class="settings-close" catchtap="closeTeamSettings" aria-label="关闭"><t-icon name="close" size="34rpx" /></view>
      </view>

      <view class="settings-simple">
        <view class="setting-label">小队名称</view>
        <t-input class="settings-input" maxlength="20" value="{{settingsDraft.name}}" placeholder="输入 2–20 个字符" disabled="{{!settingsCanEditTeam}}" bindchange="inputTeamName" />
        <view class="settings-count">{{settingsDraft.name.length}} / 20</view>
        <view class="setting-label settings-slogan-label">小队宣传语</view>
        <t-input class="settings-input" maxlength="30" value="{{settingsDraft.slogan}}" placeholder="例如：每天进步一点点" disabled="{{!settingsCanEditTeam}}" bindchange="inputTeamSlogan" />
        <view class="settings-count">{{settingsDraft.slogan.length}} / 30</view>
        <view class="owner-setting-row" bindtap="openMemberManagement"><text>成员管理</text><text>›</text></view>
        <view class="owner-setting-row"><view><text>匿名模式</text><text class="owner-setting-help">成员将{{team.anonymityMode === 'anonymous' ? '匿名展示' : '按资料权限展示'}}</text></view><t-switch value="{{team.anonymityMode === 'anonymous'}}" bindchange="toggleTeamAnonymousMode" /></view>
        <view class="owner-setting-row owner-setting-row--danger" bindtap="confirmLeaveOrDissolve"><text>解散小队</text><text>›</text></view>
      </view>

      <view class="settings-footer">
        <view class="settings-footer-button settings-footer-button--ghost" bindtap="closeTeamSettings">取消</view>
        <view class="settings-footer-button settings-footer-button--solid {{!settingsCanEditTeam ? 'is-disabled' : ''}}" bindtap="saveTeamSettings">{{savingSettings ? '保存中' : '保存设置'}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{teamInfoVisible}}" class="team-settings-layer" catchtouchmove="noop">
    <view class="team-settings-mask" catchtap="closeTeamInfo"></view>
    <view class="team-settings-dialog team-info-dialog" catchtap="noop">
      <view class="settings-header"><view class="settings-title">小队信息</view><view class="settings-close" catchtap="closeTeamInfo" aria-label="关闭"><t-icon name="close" size="34rpx" /></view></view>
      <scroll-view scroll-y class="team-info-scroll">
        <view class="team-info-name">{{team.name}}</view>
        <view class="team-info-slogan">{{team.slogan || team.announcement || team.description || '一起行动，各自成长'}}</view>
        <view class="team-info-row"><text>队长</text><text>{{teamOwnerName}}</text></view>
        <view class="team-info-row"><text>我的加入时间</text><text>{{teamJoinedDate}}</text></view>
        <view class="team-info-row"><text>小队人数</text><text>{{team.memberCount}}/{{team.maxMembers}}人</text></view>
        <view class="team-info-row"><text>加入规则</text><text>{{teamRuleText}}</text></view>
        <view class="team-info-row"><text>匿名状态</text><text>{{team.anonymityMode === 'anonymous' ? '匿名模式' : '公开模式'}}</text></view>
      </scroll-view>
      <view class="settings-footer"><view wx:if="{{runtime && runtime.capabilities.canMutate}}" class="settings-footer-button settings-footer-button--danger" bindtap="confirmLeaveOrDissolve">{{isOwner ? '解散小队' : '退出小队'}}</view><view class="settings-footer-button settings-footer-button--ghost" bindtap="closeTeamInfo">关闭</view></view>
    </view>
  </view>

  <view wx:if="{{memberDetailVisible}}" class="team-popup-layer">
    <view class="team-popup-mask" catchtap="closeMemberDetail"></view>
    <view class="team-popup member-detail-popup" catchtap="noop">
      <view class="popup-handle"></view>
      <view wx:if="{{selectedMember}}" class="member-detail-head">
        <view class="member-detail-avatar">
          <image wx:if="{{selectedMember.avatar}}" class="avatar-img" src="{{selectedMember.avatar}}" mode="aspectFill" binderror="onSelectedMemberAvatarError" />
          <image wx:else src="/images/icons/avatar.png" mode="aspectFill" />
        </view>
        <view class="member-detail-main">
          <view class="popup-title">{{selectedMember.displayName}}</view>
          <view class="member-detail-tags"><view class="soft-tag">{{selectedMember.privacyText}}</view><view class="soft-tag soft-tag--gold">{{selectedMember.statusText}}</view></view>
        </view>
      </view>

      <view wx:if="{{selectedMember && selectedMember.taskDetailVisible}}" class="task-detail-section">
        <view class="detail-section-title">今日行动明细</view>
        <view wx:if="{{selectedMember.todayActionDetails.length === 0}}" class="detail-empty">今天还没有可展示的行动记录。</view>
        <view wx:else class="task-detail-list">
          <view wx:for="{{selectedMember.todayActionDetails}}" wx:key="id" wx:for-item="detail" class="task-detail-item">
            <view class="task-detail-title">{{detail.title}}</view>
            <view class="task-detail-meta">预计 {{detail.estimatedMinutes}} 分钟 · 实际 {{detail.growthMinutes}} 分钟</view>
          </view>
        </view>
      </view>
      <view wx:elif="{{selectedMember}}" class="detail-private-card"><view class="detail-section-title">行动明细未开放</view><view class="popup-copy">{{selectedMember.detailHiddenText}}</view></view>
      <view wx:if="{{selectedMember && selectedMember.isSelf && runtime && runtime.capabilities.canMutate}}" class="self-detail-actions">
        <view class="self-detail-action" bindtap="openSelfPrivacyOptions">调整我的展示方式</view>
        <view wx:if="{{!isOwner}}" class="self-detail-action self-detail-action--danger" bindtap="confirmLeaveOrDissolve">退出小队</view>
      </view>
      <view class="popup-button popup-button--solid popup-button--full" bindtap="closeMemberDetail">知道了</view>
    </view>
  </view>
</view>
