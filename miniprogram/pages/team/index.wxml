<view class="page team-page" data-theme="{{appTheme}}">
  <view class="page-title-row">
    <view class="page-title">小队</view>
    <view class="page-subtitle">一起完成今天的行动</view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="team-card state-card">
    <view class="state-icon">...</view>
    <view class="state-title">正在整理小队信息</view>
    <view class="state-copy">稍等一下，马上回来。</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="team-card state-card">
    <view class="state-icon">!</view>
    <view class="state-title">小队加载失败</view>
    <view class="state-copy">{{errorMessage}}</view>
    <button class="solid-button state-button" bindtap="retry">重新加载</button>
  </view>

  <view wx:elif="{{status === 'empty'}}" class="team-card empty-card">
    <view class="empty-mark">队</view>
    <view class="empty-title">还没有加入小队</view>
    <view class="empty-copy">支持 5-50 人轻量同行。一起自律，各自成长。</view>
    <view class="empty-actions">
      <button class="solid-button" loading="{{creating}}" disabled="{{creating}}" bindtap="createLocalTeam">
        {{creating ? '正在创建' : '创建小队'}}
      </button>
      <button class="outline-button" bindtap="openJoinPopup">房间号加入</button>
    </view>
  </view>

  <block wx:else>
    <!-- 1. 小队状态卡（紧凑身份卡） -->
    <view class="team-card team-status-card">
      <view class="team-title-row">
        <view class="team-info-block">
          <view class="team-name-row">
            <view class="team-name">{{displayTeamName}}</view>
            <view class="my-team-tag">我的小队</view>
          </view>
          <view class="team-tags">
            <view class="level-tag">{{teamLevel}}</view>
            <view class="mood-tag">{{teamMood}}</view>
          </view>
        </view>
        <view class="team-member-preview" catchtap="openAllMembers">
          <view
            wx:for="{{avatarMembers}}"
            wx:key="id"
            class="preview-avatar"
          >
            <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" />
            <text wx:else>{{item.avatarText}}</text>
          </view>
          <view wx:if="{{extraAvatarCount > 0}}" class="preview-more">+{{extraAvatarCount}}</view>
        </view>
      </view>

      <view class="team-sub-info">
        <text>{{team.memberCount}} / {{team.maxMembers}} 成员</text>
        <text class="dot">·</text>
        <text>今日 {{teamStats.completedMembers}} 人已完成</text>
      </view>

      <view class="team-slogan-row">一起自律，各自成长</view>

      <view class="team-action-buttons">
        <button class="pill-button" catchtap="inviteFriends">邀请好友</button>
        <button class="pill-button" catchtap="openTeamSettings">小队设置</button>
      </view>
    </view>

    <!-- 2. 今日小队战况（核心数据模块） -->
    <view class="team-card team-dashboard-card">
      <view class="dashboard-title-row">
        <view class="card-title">今日小队战况</view>
        <view class="dashboard-detail-link" catchtap="noop">查看详情 ›</view>
      </view>

      <view class="team-stat-grid">
        <view class="stat-item">
          <view class="stat-value">{{teamStats.todayCompletionRate}}<text class="stat-unit">%</text></view>
          <view class="stat-label">今日完成率</view>
        </view>
        <view class="stat-item stat-item--divider">
          <view class="stat-value">{{teamStats.completedMembers}}<text class="stat-slash">/{{teamStats.totalMembers}}</text></view>
          <view class="stat-label">已完成成员</view>
        </view>
        <view class="stat-item stat-item--divider">
          <view class="stat-value">{{teamStats.todayActions}}<text class="stat-unit">项</text></view>
          <view class="stat-label">今日行动数</view>
        </view>
      </view>

      <view class="team-progress-bar">
        <view class="progress-track">
          <view class="progress-fill" style="width: {{teamStats.todayActionsRate}}%;"></view>
        </view>
        <view class="progress-meta-row">
          <text class="progress-goal-text">今日目标：全队完成 {{teamStats.targetActions}} 项行动</text>
          <text class="progress-current">{{teamStats.todayActions}} / {{teamStats.targetActions}}</text>
        </view>
      </view>
    </view>

    <!-- 3. 今日共同行动（关键行动模块） -->
    <view class="team-card team-common-action">
      <view class="card-title">今日共同行动</view>
      <view class="common-action-desc">{{commonAction.desc}}</view>

      <view class="team-common-progress">
        <view class="common-progress-item">
          <view class="common-progress-label">我的进度</view>
          <view class="common-progress-value">
            <text class="cpv-current {{commonAction.myDone ? 'cpv-current--done' : ''}}">{{commonAction.myCompleted}}</text>
            <text class="cpv-slash"> / {{commonAction.myTarget}}</text>
          </view>
        </view>
        <view class="common-progress-divider"></view>
        <view class="common-progress-item">
          <view class="common-progress-label">全队进度</view>
          <view class="common-progress-value">
            <text class="cpv-current">{{commonAction.teamCompleted}}</text>
            <text class="cpv-slash"> / {{commonAction.teamTarget}}</text>
          </view>
        </view>
      </view>

      <button class="solid-button common-action-button" catchtap="goToTodayAction">
        {{commonAction.myDone ? '今日行动已完成' : '去完成今日任务'}}
      </button>
    </view>

    <!-- 4. 成员状态 -->
    <view class="team-card team-member-status">
      <view class="dashboard-title-row">
        <view class="card-title">成员状态</view>
        <view class="member-status-summary">
          <text class="ms-completed">已完成 {{memberStatusSummary.completed}}</text>
          <text class="ms-doing">进行中 {{memberStatusSummary.doing}}</text>
          <text class="ms-pending">未开始 {{memberStatusSummary.pending}}</text>
        </view>
      </view>

      <view class="team-member-list">
        <view
          wx:for="{{memberStatusList}}"
          wx:key="id"
          class="member-status-item"
          data-id="{{item.id}}"
          bindtap="openMemberDetail"
        >
          <view class="member-avatar member-avatar--{{item.statusClass}}">
            <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" />
            <text wx:else>{{item.avatarText}}</text>
            <view wx:if="{{item.statusClass === 'completed'}}" class="avatar-check">✓</view>
            <view wx:elif="{{item.statusClass === 'doing'}}" class="avatar-dot"></view>
          </view>
          <view class="member-status-info">
            <view class="member-name">{{item.name}}</view>
            <view class="member-progress-text">{{item.statusText}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{memberStatusExtra > 0}}" class="member-list-more" catchtap="openAllMembers">
        查看全部 {{team.memberCount}} 位成员 ›
      </view>
    </view>

    <!-- 5. 小队动态（行动动态） -->
    <view class="team-card team-activity-card">
      <view class="dashboard-title-row">
        <view class="card-title">行动动态</view>
      </view>

      <view wx:if="{{activityList.length === 0}}" class="activity-empty">今天还没有队友动态。</view>
      <view wx:else>
        <view wx:for="{{activityList}}" wx:key="id" class="activity-item" data-id="{{item.memberId}}" bindtap="openMemberDetail">
          <view class="activity-avatar">
            <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" />
            <text wx:else>{{item.avatarText}}</text>
          </view>
          <view class="activity-main">
            <text class="activity-name">{{item.name}}</text>
            <text class="activity-action"> {{item.actionText}}</text>
          </view>
          <view class="activity-time">{{item.time}}</view>
        </view>
        <view class="activity-more" catchtap="noop">查看全部动态 ›</view>
      </view>
    </view>

    <!-- 6. 本周荣誉（轻量横向徽章） -->
    <view class="team-card team-honor-card">
      <view class="card-title">本周荣誉</view>
      <scroll-view scroll-x class="honor-scroll" enhanced show-scrollbar="{{false}}">
        <view wx:for="{{honorList}}" wx:key="id" class="honor-badge-card">
          <view class="honor-icon">{{item.icon}}</view>
          <view class="honor-title">{{item.title}}</view>
          <view class="honor-desc">{{item.desc}}</view>
        </view>
      </scroll-view>
    </view>
  </block>

  <view wx:if="{{joinPopupVisible}}" class="team-popup-layer">
    <view class="team-popup-mask" catchtap="closeJoinPopup"></view>
    <view class="team-popup" catchtap="noop">
      <view class="popup-handle"></view>
      <view class="popup-title">输入房间号加入</view>
      <view class="popup-copy">当前为本地演示版本，真实跨设备加入需要后续接入云端小队数据。</view>
      <input
        class="room-input"
        maxlength="6"
        value="{{roomCodeInput}}"
        placeholder="例如 TQLR01"
        bindinput="inputRoomCode"
      />
      <view class="popup-actions">
        <button class="outline-button" bindtap="closeJoinPopup">取消</button>
        <button class="solid-button" loading="{{joining}}" disabled="{{joining}}" bindtap="submitJoinRoom">加入</button>
      </view>
    </view>
  </view>

  <view wx:if="{{teamInfoVisible}}" class="team-popup-layer">
    <view class="team-popup-mask" catchtap="closeTeamInfo"></view>
    <view class="team-popup" catchtap="noop">
      <view class="popup-handle"></view>
      <view class="popup-title">{{displayTeamName}}</view>
      <view class="team-detail-list">
        <view>
          <text>房间号</text>
          <text>{{team.roomCode}}</text>
        </view>
        <view>
          <text>成员</text>
          <text>{{team.memberCount}} / {{team.maxMembers}}</text>
        </view>
        <view>
          <text>定位</text>
          <text>一起自律，各自成长</text>
        </view>
      </view>
      <button class="solid-button popup-full-button" bindtap="closeTeamInfo">知道了</button>
    </view>
  </view>

  <view wx:if="{{memberDetailVisible}}" class="team-popup-layer">
    <view class="team-popup-mask" catchtap="closeMemberDetail"></view>
    <view class="team-popup member-detail-popup" catchtap="noop">
      <view class="popup-handle"></view>
      <view wx:if="{{selectedMember}}" class="member-detail-head">
        <view class="member-detail-avatar">
          <image wx:if="{{selectedMember.avatar}}" src="{{selectedMember.avatar}}" mode="aspectFill" />
          <text wx:else>{{selectedMember.avatarText}}</text>
        </view>
        <view class="member-detail-main">
          <view class="popup-title">{{selectedMember.displayName}}</view>
          <view class="member-detail-tags">
            <view class="soft-tag">{{selectedMember.privacyText}}</view>
            <view class="soft-tag">{{selectedMember.statusText}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{selectedMember && selectedMember.taskDetailVisible}}" class="task-detail-section">
        <view class="detail-section-title">今日行动明细</view>
        <view wx:if="{{selectedMember.todayActionDetails.length === 0}}" class="detail-empty">今天还没有可展示的行动记录。</view>
        <view wx:else class="task-detail-list">
          <view wx:for="{{selectedMember.todayActionDetails}}" wx:key="id" wx:for-item="detail" class="task-detail-item">
            <view class="task-detail-title">{{detail.title}}</view>
            <view class="task-detail-meta">预计 {{detail.estimatedMinutes}} 分钟 · 成长 {{detail.growthMinutes}} 分钟</view>
          </view>
        </view>
      </view>

      <view wx:elif="{{selectedMember}}" class="detail-private-card">
        <view class="detail-section-title">行动明细未开放</view>
        <view class="popup-copy">{{selectedMember.detailHiddenText}}</view>
      </view>

      <button class="solid-button popup-full-button" bindtap="closeMemberDetail">知道了</button>
    </view>
  </view>
</view>
