.team-page {
  --team-primary: #3F8F72;
  --team-primary-deep: #24584A;
  --team-primary-light: #7CC6A0;
  --team-primary-soft: #E6F4EC;
  --team-text: #244C43;
  --team-secondary: #6F827B;
  --team-muted: #9AA8A3;
  --team-border: #E2EEE8;
  --team-soft: #EFF8F3;
  --team-sun: #F4C95D;
  --team-sun-soft: #FFF4D8;
  --team-bg: #F6FAF7;
  --team-shadow: 0 8rpx 28rpx rgba(36, 88, 74, 0.08);
  min-height: 100vh;
  padding: 32rpx 32rpx calc(156rpx + env(safe-area-inset-bottom));
  background: var(--team-bg);
}

.page-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  min-height: 72rpx;
  margin-bottom: 22rpx;
}

.page-title {
  color: var(--team-text);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.page-subtitle {
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.team-card {
  width: 100%;
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(226, 238, 232, 0.92);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: var(--team-shadow);
}

.team-card:first-of-type {
  margin-top: 0;
}

.card-title {
  color: var(--team-text);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
}

/* ============ 1. 小队状态卡（紧凑身份卡） ============ */
.team-status-card {
  padding: 26rpx 28rpx 24rpx;
}

.team-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.team-info-block {
  min-width: 0;
  flex: 1;
}

.team-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.team-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--team-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.my-team-tag,
.level-tag,
.mood-tag,
.soft-tag,
.pill-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 40rpx;
  padding: 0 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.my-team-tag {
  flex: none;
  background: var(--team-primary-soft);
  color: var(--team-primary);
}

.team-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.level-tag {
  background: var(--team-sun-soft);
  color: #8A6B1F;
}

.mood-tag,
.soft-tag {
  background: var(--team-primary-soft);
  color: var(--team-primary);
}

.team-member-preview {
  flex: none;
  display: flex;
  align-items: center;
  min-height: 56rpx;
  padding-top: 6rpx;
}

.preview-avatar,
.preview-more {
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 52rpx;
  height: 52rpx;
  margin-right: -10rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  background: var(--team-primary-soft);
  color: var(--team-primary);
  font-weight: 700;
  font-size: 22rpx;
}

.preview-avatar image {
  width: 100%;
  height: 100%;
  display: block;
}

.preview-more {
  margin-right: 0;
  margin-left: 4rpx;
  background: var(--team-soft);
  color: var(--team-muted);
  font-size: 20rpx;
}

.team-sub-info {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 20rpx;
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.team-sub-info .dot {
  color: var(--team-muted);
}

.team-slogan-row {
  margin-top: 6rpx;
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.team-action-buttons {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 22rpx;
}

.pill-button {
  height: 64rpx;
  padding: 0 24rpx;
  margin: 0;
  border: 1rpx solid var(--team-border);
  border-radius: 32rpx;
  background: #ffffff;
  color: var(--team-primary);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
}

.pill-button::after {
  border: 0;
}

/* ============ 2. 今日小队战况 ============ */
.dashboard-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.dashboard-detail-link {
  flex: none;
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.team-stat-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 22rpx;
}

.stat-item {
  min-width: 0;
  padding: 4rpx 0;
}

.stat-item--divider {
  border-left: 1rpx solid var(--team-border);
  padding-left: 12rpx;
}

.stat-value {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  color: var(--team-text);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.stat-unit {
  font-size: 24rpx;
  font-weight: 700;
}

.stat-slash {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--team-muted);
}

.stat-label {
  margin-top: 4rpx;
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.team-progress-bar {
  margin-top: 24rpx;
}

.progress-track {
  width: 100%;
  height: 16rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #E2EEE8;
}

.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #7CC6A0 0%, #3F8F72 100%);
}

.progress-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
}

.progress-goal-text {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.progress-current {
  flex: none;
  color: var(--team-text);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

/* ============ 3. 今日共同行动 ============ */
.team-common-action {
  padding-bottom: 26rpx;
}

.common-action-desc {
  margin-top: 12rpx;
  color: var(--team-secondary);
  font-size: 26rpx;
  line-height: 36rpx;
}

.team-common-progress {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: var(--team-soft);
}

.common-progress-item {
  min-width: 0;
  flex: 1;
}

.common-progress-label {
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.common-progress-value {
  margin-top: 6rpx;
  color: var(--team-text);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.cpv-current {
  color: var(--team-primary);
}

.cpv-current--done {
  color: var(--team-text);
}

.cpv-slash {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--team-muted);
}

.common-progress-divider {
  flex: none;
  width: 1rpx;
  background: var(--team-border);
}

.common-action-button {
  margin-top: 24rpx;
}

/* ============ 4. 成员状态 ============ */
.member-status-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  font-size: 22rpx;
  line-height: 32rpx;
}

.ms-completed {
  color: var(--team-primary);
  font-weight: 600;
}

.ms-doing {
  color: #C99A2E;
  font-weight: 600;
}

.ms-pending {
  color: var(--team-muted);
  font-weight: 600;
}

.team-member-list {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 24rpx 12rpx;
  margin-top: 22rpx;
}

.member-status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.member-avatar {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--team-primary-soft);
  color: var(--team-primary);
  font-weight: 700;
  font-size: 30rpx;
}

.member-avatar image {
  width: 100%;
  height: 100%;
  display: block;
}

.member-avatar--doing {
  background: var(--team-sun-soft);
  color: #8A6B1F;
}

.member-avatar--pending {
  background: #F0F2EF;
  color: var(--team-muted);
  opacity: 0.62;
}

.avatar-check {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 3rpx solid #ffffff;
  background: var(--team-primary);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
}

.avatar-dot {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 3rpx solid #ffffff;
  background: var(--team-sun);
}

.member-status-info {
  margin-top: 12rpx;
  text-align: center;
  width: 100%;
}

.member-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--team-text);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.member-progress-text {
  margin-top: 4rpx;
  color: var(--team-secondary);
  font-size: 20rpx;
  line-height: 28rpx;
}

.member-list-more {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--team-border);
  text-align: center;
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

/* ============ 5. 行动动态 ============ */
.team-activity-card {
  padding-bottom: 18rpx;
}

.activity-empty {
  margin-top: 18rpx;
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.activity-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 70rpx;
  padding: 16rpx 0;
}

.activity-item + .activity-item {
  border-top: 1rpx solid var(--team-border);
}

.activity-avatar {
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--team-primary-soft);
  color: var(--team-primary);
  font-weight: 700;
  font-size: 22rpx;
}

.activity-avatar image {
  width: 100%;
  height: 100%;
  display: block;
}

.activity-main {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-name {
  color: var(--team-text);
  font-size: 26rpx;
  font-weight: 700;
}

.activity-action {
  color: var(--team-secondary);
  font-size: 26rpx;
}

.activity-time {
  flex: none;
  color: var(--team-muted);
  font-size: 22rpx;
}

.activity-more {
  margin-top: 10rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--team-border);
  text-align: center;
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

/* ============ 6. 本周荣誉（横向徽章） ============ */
.team-honor-card {
  padding-bottom: 24rpx;
}

.honor-scroll {
  width: 100%;
  margin-top: 18rpx;
  white-space: nowrap;
}

.honor-badge-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
  margin-right: 16rpx;
  padding: 22rpx 16rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: var(--team-soft);
  vertical-align: top;
  white-space: normal;
}

.honor-badge-card:last-child {
  margin-right: 0;
}

.honor-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--team-sun);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
}

.honor-title {
  margin-top: 14rpx;
  color: var(--team-text);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
}

.honor-desc {
  margin-top: 6rpx;
  color: var(--team-secondary);
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
}

/* ============ 按钮 / 状态卡 ============ */
.outline-button,
.solid-button {
  min-width: 0;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
}

.outline-button {
  border: 1rpx solid #E2EEE8;
  background: #ffffff;
  color: var(--team-primary);
}

.solid-button {
  background: var(--team-primary);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(63, 143, 114, 0.22);
}

button::after {
  border: 0;
}

button[disabled] {
  opacity: 0.58;
}

.state-card,
.empty-card {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.state-icon,
.empty-mark {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: var(--team-primary-soft);
  color: var(--team-primary);
  font-size: 32rpx;
  font-weight: 800;
}

.state-title,
.empty-title {
  margin-top: 24rpx;
  color: var(--team-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.state-copy,
.empty-copy,
.popup-copy,
.detail-empty,
.task-detail-meta {
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.state-copy,
.empty-copy {
  max-width: 520rpx;
  margin-top: 14rpx;
}

.state-button {
  min-width: 220rpx;
  margin-top: 30rpx;
}

.empty-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  width: 100%;
  margin-top: 32rpx;
}

/* ============ 弹窗 ============ */
.team-popup-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
}

.team-popup-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(36, 76, 67, 0.32);
}

.team-popup {
  position: relative;
  width: calc(100vw - 48rpx);
  max-height: calc(100vh - 180rpx);
  overflow-y: auto;
  box-sizing: border-box;
  margin: 0 auto 24rpx;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 -18rpx 48rpx rgba(36, 88, 74, 0.16);
}

.popup-handle {
  width: 78rpx;
  height: 8rpx;
  margin: 0 auto 26rpx;
  border-radius: 999rpx;
  background: #E2EEE8;
}

.popup-title {
  color: var(--team-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.popup-copy {
  margin-top: 12rpx;
}

.room-input {
  width: 100%;
  height: 90rpx;
  margin-top: 26rpx;
  padding: 0 26rpx;
  border: 1rpx solid var(--team-border);
  border-radius: 24rpx;
  background: #F8FBF9;
  color: var(--team-text);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.popup-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 26rpx;
}

.popup-full-button {
  width: 100%;
  margin-top: 30rpx;
}

.team-detail-list {
  margin-top: 24rpx;
  border-top: 1rpx solid var(--team-border);
}

.team-detail-list > view {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--team-border);
  color: var(--team-secondary);
  font-size: 26rpx;
  line-height: 36rpx;
}

.team-detail-list > view text:last-child {
  color: var(--team-text);
  font-weight: 600;
  text-align: right;
}

.member-detail-popup {
  padding-top: 24rpx;
}

.member-detail-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.member-detail-avatar {
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  background: var(--team-primary-soft);
  color: var(--team-primary);
  font-weight: 700;
  font-size: 32rpx;
}

.member-detail-avatar image {
  width: 100%;
  height: 100%;
  display: block;
}

.member-detail-main {
  min-width: 0;
  flex: 1;
}

.member-detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.task-detail-section,
.detail-private-card {
  margin-top: 28rpx;
}

.detail-section-title {
  color: var(--team-text);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.task-detail-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 16rpx;
}

.task-detail-item,
.detail-empty {
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--team-border);
  border-radius: 22rpx;
  background: #F8FBF9;
}

.task-detail-title {
  color: var(--team-text);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.task-detail-meta {
  margin-top: 8rpx;
}

.detail-private-card {
  padding: 22rpx;
  border: 1rpx solid var(--team-border);
  border-radius: 22rpx;
  background: #F8FBF9;
}

@media (max-width: 340px) {
  .team-page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .team-action-buttons,
  .empty-actions,
  .popup-actions {
    grid-template-columns: 1fr;
  }

  .team-member-list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .activity-time {
    display: none;
  }
}

/* =========================================================
 * 墨绿成长主题 覆写（team-page）
 * 切换至墨绿主题后，整页 UI 统一呈现深绿质感。
 * ========================================================= */
.team-page[data-theme="inkGreen"] {
  --team-primary: #356859;
  --team-primary-deep: #1F5B4A;
  --team-primary-light: #7FAA91;
  --team-primary-soft: #EAF5EF;
  --team-text: #233B34;
  --team-secondary: #71827A;
  --team-muted: #9AA9A4;
  --team-border: #E6EEE9;
  --team-soft: #F0F5F1;
  --team-sun: #F4C95D;
  --team-sun-soft: #FFF2CD;
  --team-bg: #F5F7F2;
  --team-shadow: 0 12rpx 32rpx rgba(31, 91, 74, 0.10);
  background: #F5F7F2;
  color: #233B34;
}

.team-page[data-theme="inkGreen"] .page-title {
  color: #233B34;
}

.team-page[data-theme="inkGreen"] .team-card {
  border-color: rgba(31, 91, 74, 0.10);
  background: #FFFFFF;
  box-shadow: var(--team-shadow);
}

/* 小队状态卡使用深绿 Hero 背景与其他页 Hero 保持一致。 */
.team-page[data-theme="inkGreen"] .team-status-card {
  border-color: transparent;
  background:
