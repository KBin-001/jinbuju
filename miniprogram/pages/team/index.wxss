.team-page {
  --team-primary: #145243;
  --team-deep: #0f4035;
  --team-text: #173c34;
  --team-secondary: #6f7f78;
  --team-muted: #a8b0aa;
  --team-border: #e8efeb;
  --team-soft: #f3f8f5;
  --team-sun: #f5b94e;
  --team-bg: #f7f8f5;
  --team-shadow: 0 8rpx 30rpx rgba(20, 82, 67, 0.08);
  min-height: 100vh;
  padding: 32rpx 32rpx calc(156rpx + env(safe-area-inset-bottom));
  background: var(--team-bg);
}

.page-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  margin-bottom: 22rpx;
}

.page-title {
  color: var(--team-text);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.team-card {
  width: 100%;
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(232, 239, 235, 0.92);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: var(--team-shadow);
}

.team-card:first-of-type {
  margin-top: 0;
}

.team-info-card {
  padding: 30rpx 28rpx 26rpx;
}

.team-info-top,
.team-name-row,
.member-count-row,
.progress-meta-row,
.honor-card,
.feed-item,
.member-detail-head {
  display: flex;
  align-items: center;
}

.team-info-top,
.member-count-row,
.progress-meta-row,
.honor-card {
  justify-content: space-between;
}

.team-info-main {
  min-width: 0;
  flex: 1;
}

.team-name-row {
  align-items: flex-start;
  gap: 16rpx;
}

.team-name {
  min-width: 0;
  flex: 1;
  color: var(--team-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.my-team-tag,
.level-tag,
.mood-tag,
.soft-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 40rpx;
  padding: 0 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.my-team-tag {
  background: #eef7f2;
  color: var(--team-primary);
}

.team-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.level-tag {
  background: var(--team-sun);
  color: #5f4518;
}

.mood-tag,
.soft-tag {
  background: #eef7f2;
  color: var(--team-primary);
}

.team-slogan {
  margin-top: 16rpx;
  color: var(--team-secondary);
  font-size: 26rpx;
  line-height: 36rpx;
}

.member-count-row {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--team-border);
}

.member-count {
  color: var(--team-secondary);
  font-size: 26rpx;
  line-height: 36rpx;
}

.card-arrow {
  color: #879790;
  font-size: 42rpx;
  line-height: 1;
}

.avatar-row {
  display: flex;
  align-items: center;
  min-height: 58rpx;
  margin-top: 18rpx;
}

.avatar-item,
.avatar-more,
.feed-avatar,
.member-detail-avatar {
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  background: var(--team-soft);
  color: var(--team-primary);
  font-weight: 700;
}

.avatar-item {
  width: 52rpx;
  height: 52rpx;
  margin-right: -8rpx;
  border: 3rpx solid #ffffff;
  font-size: 22rpx;
}

.avatar-item image,
.feed-avatar image,
.member-detail-avatar image {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-more {
  width: 52rpx;
  height: 52rpx;
  margin-left: 8rpx;
  color: var(--team-muted);
  font-size: 20rpx;
}

.team-button-row,
.empty-actions,
.popup-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.team-button-row {
  margin-top: 28rpx;
}

.outline-button,
.solid-button {
  min-width: 0;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
}

.outline-button {
  border: 1rpx solid #d8e5df;
  background: #ffffff;
  color: var(--team-primary);
}

.solid-button {
  background: var(--team-primary);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(20, 82, 67, 0.18);
}

.card-title {
  color: var(--team-text);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.progress-card {
  padding-bottom: 26rpx;
}

.progress-meta-row {
  margin-top: 22rpx;
}

.progress-label,
.progress-goal,
.honor-subtitle,
.feed-time,
.state-copy,
.empty-copy,
.popup-copy,
.detail-empty,
.task-detail-meta {
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.delta-label {
  color: var(--team-primary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.focus-number-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 10rpx;
}

.focus-number {
  color: var(--team-text);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.focus-unit {
  color: var(--team-text);
  font-size: 28rpx;
  font-weight: 700;
}

.progress-track {
  width: 100%;
  height: 16rpx;
  overflow: hidden;
  margin-top: 26rpx;
  border-radius: 8rpx;
  background: #e8efea;
}

.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: #7dbb69;
}

.progress-goal {
  margin-top: 12rpx;
  text-align: right;
}

.honor-card {
  gap: 22rpx;
}

.honor-copy {
  min-width: 0;
  flex: 1;
}

.honor-subtitle {
  margin-top: 18rpx;
}

.honor-title {
  margin-top: 6rpx;
  color: var(--team-text);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.honor-badge {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  background: #f5b94e;
  box-shadow: inset 0 0 0 8rpx rgba(255, 255, 255, 0.55);
}

.honor-badge::before,
.honor-badge::after {
  position: absolute;
  bottom: -10rpx;
  width: 20rpx;
  height: 30rpx;
  border-radius: 0 0 8rpx 8rpx;
  background: #d99b35;
  content: "";
}

.honor-badge::before {
  left: 18rpx;
  transform: rotate(18deg);
}

.honor-badge::after {
  right: 18rpx;
  transform: rotate(-18deg);
}

.honor-badge-inner {
  position: relative;
  z-index: 1;
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--team-primary);
  color: #ffffff;
  font-size: 24rpx;
}

.feed-card {
  padding-bottom: 18rpx;
}

.feed-item {
  min-height: 70rpx;
  gap: 16rpx;
  padding: 18rpx 0;
}

.feed-item + .feed-item {
  border-top: 1rpx solid var(--team-border);
}

.feed-avatar {
  width: 42rpx;
  height: 42rpx;
  font-size: 20rpx;
}

.feed-main {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-name {
  color: var(--team-text);
  font-size: 26rpx;
  font-weight: 700;
}

.feed-action {
  color: var(--team-secondary);
  font-size: 26rpx;
}

.feed-time {
  flex: none;
  font-size: 22rpx;
  color: var(--team-muted);
}

.state-card,
.empty-card {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.state-icon,
.empty-mark {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: var(--team-soft);
  color: var(--team-primary);
  font-size: 32rpx;
  font-weight: 800;
}

.state-title,
.empty-title {
  margin-top: 24rpx;
  color: var(--team-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.state-copy,
.empty-copy {
  max-width: 520rpx;
  margin-top: 14rpx;
}

.state-button {
  min-width: 220rpx;
  margin-top: 30rpx;
}

.empty-actions {
  width: 100%;
  margin-top: 32rpx;
}

.team-popup-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
}

.team-popup-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(31, 45, 42, 0.34);
}

.team-popup {
  position: relative;
  width: calc(100vw - 48rpx);
  max-height: calc(100vh - 180rpx);
  overflow-y: auto;
  box-sizing: border-box;
  margin: 0 auto 24rpx;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 -18rpx 48rpx rgba(21, 63, 54, 0.18);
}

.popup-handle {
  width: 78rpx;
  height: 8rpx;
  margin: 0 auto 26rpx;
  border-radius: 999rpx;
  background: #cbd6d0;
}

.popup-title {
  color: var(--team-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.popup-copy {
  margin-top: 12rpx;
}

.room-input {
  width: 100%;
  height: 90rpx;
  margin-top: 26rpx;
  padding: 0 26rpx;
  border: 1rpx solid var(--team-border);
  border-radius: 24rpx;
  background: #fbfcfa;
  color: var(--team-text);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.popup-actions {
  margin-top: 26rpx;
}

.popup-full-button {
  width: 100%;
  margin-top: 30rpx;
}

.team-detail-list {
  margin-top: 24rpx;
  border-top: 1rpx solid var(--team-border);
}

.team-detail-list > view {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--team-border);
  color: var(--team-secondary);
  font-size: 26rpx;
  line-height: 36rpx;
}

.team-detail-list > view text:last-child {
  color: var(--team-text);
  font-weight: 600;
  text-align: right;
}

.member-detail-popup {
  padding-top: 24rpx;
}

.member-detail-head {
  gap: 18rpx;
}

.member-detail-avatar {
  width: 82rpx;
  height: 82rpx;
  font-size: 32rpx;
}

.member-detail-main {
  min-width: 0;
  flex: 1;
}

.member-detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.task-detail-section,
.detail-private-card {
  margin-top: 28rpx;
}

.detail-section-title {
  color: var(--team-text);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.task-detail-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 16rpx;
}

.task-detail-item,
.detail-empty {
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--team-border);
  border-radius: 22rpx;
  background: #f7faf8;
}

.task-detail-title {
  color: var(--team-text);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.task-detail-meta {
  margin-top: 8rpx;
}

button::after {
  border: 0;
}

button[disabled] {
  opacity: 0.58;
}

@media (max-width: 340px) {
  .team-page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .team-button-row,
  .empty-actions,
  .popup-actions {
    grid-template-columns: 1fr;
  }

  .team-name-row,
  .progress-meta-row {
    align-items: flex-start;
    flex-direction: column;
  }

  .feed-time {
    display: none;
  }
}
