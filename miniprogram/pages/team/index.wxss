.team-page {
  --paper: #F7F1E6;
  --card: rgba(255, 252, 245, 0.94);
  --ink: #244D42;
  --ink-deep: #163A32;
  --muted: #746F68;
  --muted-light: #9A948B;
  --gold: #B88731;
  --gold-soft: #F4E3BC;
  --green: #2B604F;
  --green-soft: #E7F0E6;
  --line: rgba(206, 196, 176, 0.62);
  --shadow: 0 18rpx 48rpx rgba(58, 48, 32, 0.075);
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 21% 8%, rgba(226, 207, 165, 0.30), transparent 20%),
    linear-gradient(180deg, #FBF7EF 0%, #F7F1E6 46%, #F5EEE2 100%);
  color: var(--ink);
}

.team-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 470rpx;
  opacity: 0.60;
  pointer-events: none;
}

.team-bg-mask {
  position: absolute;
  inset: 0 0 auto;
  height: 600rpx;
  pointer-events: none;
  background:
    radial-gradient(circle at 24% 12%, rgba(217, 191, 132, 0.28) 0 38rpx, transparent 84rpx),
    linear-gradient(180deg, rgba(251, 247, 239, 0.18) 0%, rgba(251, 247, 239, 0.12) 42%, #F7F1E6 96%);
}

.team-nav {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: content-box;
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.team-nav-title {
  color: var(--ink);
  font-family: "Songti SC", "STSong", serif;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 6rpx;
}

.team-content {
  position: relative;
  z-index: 1;
  padding: 88rpx 38rpx 0;
}

.team-content--state {
  padding-top: 170rpx;
}

.paper-card {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid var(--line);
  border-radius: 30rpx;
  background: var(--card);
  box-shadow: var(--shadow);
}

.team-hero {
  position: relative;
  overflow: hidden;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 244rpx;
  min-height: 286rpx;
  padding: 46rpx 32rpx 30rpx 40rpx;
}

.team-hero::after {
  content: "";
  position: absolute;
  right: -54rpx;
  bottom: -56rpx;
  width: 340rpx;
  height: 220rpx;
  opacity: 0.30;
  background:
    radial-gradient(circle at 56% 46%, rgba(43, 96, 79, 0.16), transparent 31%),
    linear-gradient(135deg, transparent 0%, rgba(43, 96, 79, 0.08) 48%, rgba(43, 96, 79, 0.16) 100%);
}

.hero-left,
.hero-right {
  position: relative;
  z-index: 1;
}

.hero-title {
  color: var(--ink);
  font-family: "Songti SC", "STSong", serif;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 60rpx;
  letter-spacing: 2rpx;
}

.hero-slogan {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 28rpx;
  line-height: 38rpx;
  letter-spacing: 2rpx;
}

.hero-capacity {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  margin-top: 20rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(231, 240, 230, 0.74);
  color: var(--green);
  font-size: 22rpx;
  font-weight: 700;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 40rpx;
}

.hero-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 58rpx;
  min-width: 142rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

.hero-btn--invite {
  border: 1rpx solid rgba(184, 135, 49, 0.72);
  background: rgba(255, 252, 245, 0.66);
  color: var(--gold);
}

.hero-btn--copy {
  border: 1rpx solid rgba(196, 188, 172, 0.76);
  background: rgba(255, 252, 245, 0.54);
  color: var(--muted);
}

.hero-btn-svg {
  flex: none;
  width: 30rpx;
  height: 30rpx;
}

.hero-right {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-cluster {
  position: relative;
  width: 222rpx;
  height: 198rpx;
}

.cluster-avatar {
  position: absolute;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  border: 5rpx solid rgba(255, 252, 245, 0.96);
  border-radius: 50%;
  background: #F1EBDD;
  color: var(--green);
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 20rpx rgba(58, 48, 32, 0.12);
}

.cluster-avatar--pos0 { top: 0; left: 8rpx; }
.cluster-avatar--pos1 { top: 8rpx; right: 0; }
.cluster-avatar--pos2 { left: 24rpx; bottom: 0; }
.cluster-avatar--pos3 { right: 14rpx; bottom: 0; }

.avatar-img {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: inherit;
}

.cluster-avatar--mountain {
  background: linear-gradient(145deg, #EEF1E8 0%, #C9D8CE 48%, #809B8D 100%);
}

.cluster-avatar--robot {
  background: linear-gradient(145deg, #F1EBDD 0%, #D5DED1 46%, #7C9386 100%);
}

.room-chip {
  margin-top: 2rpx;
  min-width: 184rpx;
  height: 54rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(246, 232, 204, 0.82);
  color: var(--gold);
  font-family: "Songti SC", "STSong", serif;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 54rpx;
  text-align: center;
}

.joint-card {
  margin-top: 30rpx;
  padding: 38rpx 34rpx 34rpx;
  border-radius: 32rpx;
}

.joint-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
}

.joint-title,
.member-section-title,
.secondary-title,
.popup-title,
.settings-title,
.state-title {
  color: var(--ink);
  font-family: "Songti SC", "STSong", serif;
  font-weight: 700;
}

.joint-title,
.member-section-title {
  font-size: 38rpx;
  line-height: 48rpx;
  letter-spacing: 2rpx;
}

.joint-done {
  flex: none;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 36rpx;
}

.joint-done-number {
  margin-right: 8rpx;
  color: var(--gold);
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
  font-weight: 700;
}

.node-track {
  position: relative;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 42rpx;
}

.node-track::before {
  content: "";
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  top: 41rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #CED3C4;
}

.action-node {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.node-avatar {
  position: relative;
  overflow: visible;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  border: 2rpx solid rgba(43, 96, 79, 0.35);
  border-radius: 50%;
  background: #EEF3E8;
}

.node-avatar .avatar-img {
  border: 4rpx solid rgba(255, 252, 245, 0.92);
}

.node-leaf-svg {
  width: 86rpx;
  height: 86rpx;
}

.action-node--pending .node-leaf-svg {
  opacity: 0.62;
  filter: grayscale(1);
}

.action-node--doing .node-leaf-svg {
  opacity: 0.88;
}

.node-check {
  position: absolute;
  right: -3rpx;
  bottom: -4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #FFFDF5;
  border-radius: 50%;
  background: var(--gold);
  color: #FFFDF5;
  font-size: 18rpx;
  font-weight: 800;
}

.node-name {
  max-width: 112rpx;
  margin-top: 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.node-status {
  margin-top: 2rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 32rpx;
}

.joint-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 40rpx;
  padding: 24rpx 0;
  border: 1rpx solid rgba(206, 196, 176, 0.55);
  border-radius: 24rpx;
  background: rgba(255, 252, 245, 0.60);
}

.joint-stat {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 10rpx;
  min-width: 0;
  padding: 0 12rpx;
  border-left: 1rpx solid rgba(206, 196, 176, 0.52);
}

.joint-stat--first {
  border-left: 0;
}

.joint-stat-svg {
  flex: none;
  width: 32rpx;
  height: 32rpx;
  margin-top: 2rpx;
  opacity: 0.82;
}

.joint-stat-leaf,
.leaf-small {
  flex: none;
  width: 26rpx;
  height: 32rpx;
  margin-top: 3rpx;
  border-radius: 80% 0 80% 0;
  background: var(--green);
  transform: rotate(45deg);
}

.joint-stat-label {
  color: var(--muted);
  font-size: 24rpx;
  line-height: 32rpx;
}

.joint-stat-value {
  margin-top: 10rpx;
  color: var(--ink);
  font-family: "Songti SC", "STSong", serif;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.joint-stat-unit {
  margin-left: 6rpx;
  color: var(--muted);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 22rpx;
  font-weight: 400;
}

.member-section {
  margin-top: 42rpx;
}

.member-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.encourage-all-btn {
  flex: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(184, 135, 49, 0.62);
  border-radius: 999rpx;
  background: rgba(255, 252, 245, 0.66);
  color: var(--gold);
  font-size: 24rpx;
  font-weight: 600;
}

.leaf-small {
  width: 22rpx;
  height: 28rpx;
  margin-top: 0;
}

.member-list {
  margin-top: 18rpx;
}

.member-card {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 108rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid rgba(206, 196, 176, 0.52);
  border-radius: 24rpx;
  background: rgba(255, 252, 245, 0.92);
  box-shadow: 0 8rpx 22rpx rgba(58, 48, 32, 0.04);
}

.member-avatar,
.activity-avatar,
.member-detail-avatar {
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: var(--green-soft);
  color: var(--green);
  font-size: 27rpx;
  font-weight: 700;
}

.member-main {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
}

.member-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.member-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.member-chip {
  flex: none;
  height: 36rpx;
  padding: 0 15rpx;
  border-radius: 999rpx;
  background: #EEE8D9;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 36rpx;
}

.member-chip--completed {
  background: var(--green-soft);
  color: var(--green);
}

.member-chip--doing {
  background: var(--gold-soft);
  color: #8C641B;
}

.member-action {
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 32rpx;
}

.member-encourage {
  flex: none;
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-left: 12rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 32rpx;
}

.member-encourage--disabled {
  opacity: 0.72;
}

.member-encourage-icon {
  width: 34rpx;
  height: 34rpx;
}

.member-arrow {
  color: #AFA694;
  font-size: 30rpx;
}

.secondary-card {
  margin-top: 26rpx;
  padding: 26rpx;
  opacity: 0.94;
}

.secondary-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.secondary-title {
  font-size: 30rpx;
  line-height: 40rpx;
}

.secondary-link {
  color: var(--gold);
  font-size: 24rpx;
}

.activity-empty,
.state-copy,
.popup-copy,
.setting-help,
.option-desc,
.detail-empty,
.task-detail-meta {
  color: var(--muted);
  font-size: 24rpx;
  line-height: 34rpx;
}

.activity-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
}

.activity-row + .activity-row {
  border-top: 1rpx solid rgba(206, 196, 176, 0.45);
}

.activity-avatar {
  width: 50rpx;
  height: 50rpx;
  font-size: 21rpx;
}

.activity-main {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-name {
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 700;
}

.activity-action,
.activity-time {
  color: var(--muted);
  font-size: 24rpx;
}

.solid-button,
.outline-button,
.settings-cancel-button,
.settings-save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 74rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.solid-button,
.settings-save-button {
  border: 1rpx solid var(--green);
  background: var(--green);
  color: #FFFDF5;
  box-shadow: 0 12rpx 24rpx rgba(43, 96, 79, 0.18);
}

.outline-button,
.settings-cancel-button {
  border: 1rpx solid rgba(184, 135, 49, 0.40);
  background: #FFFDF5;
  color: var(--gold);
}

.solid-button::after,
.outline-button::after,
.team-avatar-picker::after,
.copy-code-button::after,
.settings-cancel-button::after,
.settings-save-button::after {
  border: 0;
}

.state-card {
  min-height: 520rpx;
  padding: 56rpx 38rpx;
  text-align: center;
}

.state-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 92rpx;
  height: 92rpx;
  padding: 0 18rpx;
  border-radius: 30rpx;
  background: var(--green-soft);
  color: var(--green);
  font-size: 25rpx;
  font-weight: 800;
}

.state-title {
  margin-top: 26rpx;
  font-size: 36rpx;
  line-height: 46rpx;
}

.state-copy {
  max-width: 520rpx;
  margin: 14rpx auto 0;
}

.state-button {
  min-width: 220rpx;
  margin: 34rpx auto 0;
}

.empty-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 34rpx;
}

.team-popup-layer,
.team-settings-layer {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
}

.team-popup-mask,
.team-settings-mask {
  position: absolute;
  inset: 0;
  background: rgba(32, 58, 50, 0.28);
  backdrop-filter: blur(8rpx);
}

.team-popup {
  position: relative;
  box-sizing: border-box;
  width: calc(100vw - 48rpx);
  max-height: calc(100vh - 180rpx);
  overflow-y: auto;
  margin: 0 auto 24rpx;
  padding: 28rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  border: 1rpx solid var(--line);
  border-radius: 34rpx;
  background: #FFFDF5;
  box-shadow: 0 -18rpx 48rpx rgba(58, 48, 32, 0.16);
}

.popup-handle {
  width: 76rpx;
  height: 8rpx;
  margin: 0 auto 26rpx;
  border-radius: 999rpx;
  background: #DED4C0;
}

.popup-title {
  font-size: 34rpx;
  line-height: 44rpx;
}

.popup-copy {
  margin-top: 12rpx;
}

.room-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: rgba(247, 241, 230, 0.72);
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.popup-actions,
.settings-footer {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 26rpx;
}

.popup-full-button {
  width: 100%;
  margin-top: 30rpx;
}

.team-detail-list {
  margin-top: 22rpx;
  border-top: 1rpx solid var(--line);
}

.team-detail-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
  color: var(--muted);
  font-size: 25rpx;
  line-height: 35rpx;
}

.team-detail-value {
  color: var(--ink);
  font-weight: 700;
  text-align: right;
}

.team-settings-layer {
  z-index: 60;
  align-items: center;
  justify-content: center;
  padding: 48rpx 24rpx;
  box-sizing: border-box;
}

.team-settings-dialog {
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  width: 100%;
  max-width: 686rpx;
  max-height: calc(100vh - 96rpx);
  border: 1rpx solid var(--line);
  border-radius: 34rpx;
  background: #F7F1E6;
  box-shadow: 0 28rpx 80rpx rgba(32, 58, 50, 0.22);
}

.settings-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: none;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--line);
  background: #FFFDF5;
}

.settings-eyebrow {
  color: var(--gold);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
  letter-spacing: 2rpx;
}

.settings-title {
  margin-top: 4rpx;
  font-size: 34rpx;
  line-height: 44rpx;
}

.settings-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: var(--green-soft);
  color: var(--green);
  font-size: 36rpx;
  line-height: 1;
}

.settings-scroll {
  flex: 1;
  min-height: 0;
  max-height: calc(100vh - 330rpx);
}

.settings-readonly-tip {
  margin: 24rpx 24rpx 0;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: rgba(244, 227, 188, 0.5);
  color: #8C641B;
  font-size: 24rpx;
  line-height: 34rpx;
}

.settings-section {
  margin: 24rpx;
  padding: 26rpx;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  background: #FFFDF5;
}

.settings-section--readonly .team-profile-setting,
.settings-section--readonly .setting-block,
.settings-section--readonly .setting-toggle-row,
.settings-section--readonly .detail-visibility-list {
  opacity: 0.58;
}

.settings-section-title {
  margin-bottom: 20rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.team-profile-setting {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.team-avatar-picker {
  position: relative;
  overflow: visible;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 108rpx;
  height: 108rpx;
  border: 1rpx solid rgba(43, 96, 79, 0.18);
  border-radius: 30rpx;
  background: var(--green-soft);
  color: var(--green);
  font-size: 34rpx;
  font-weight: 800;
}

.team-name-field {
  min-width: 0;
  flex: 1;
}

.setting-label,
.option-title,
.detail-section-title,
.task-detail-title {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.settings-input {
  margin-top: 10rpx;
  min-height: 76rpx;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  background: rgba(247, 241, 230, 0.72);
}

.avatar-edit-mark {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #FFFDF5;
  border-radius: 50%;
  background: var(--green);
  color: #FFFDF5;
  font-size: 18rpx;
}

.room-code-card,
.setting-toggle-row,
.detail-visibility-option,
.task-detail-item,
.detail-private-card {
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  background: rgba(247, 241, 230, 0.48);
}

.room-code-card,
.setting-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.room-code-value {
  margin-top: 4rpx;
  color: var(--gold);
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.copy-code-button {
  height: 58rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #FFFDF5;
  color: var(--gold);
  font-size: 24rpx;
}

.setting-block {
  margin-top: 18rpx;
}

.setting-segments {
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 8rpx;
  border-radius: 22rpx;
  background: rgba(238, 232, 217, 0.82);
}

.setting-segments--three .setting-segment {
  flex: 1;
}

.setting-segment {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  padding: 0 14rpx;
  border-radius: 18rpx;
  color: var(--muted);
  font-size: 23rpx;
  font-weight: 700;
}

.setting-segment--active {
  background: #FFFDF5;
  color: var(--green);
  box-shadow: 0 6rpx 16rpx rgba(58, 48, 32, 0.07);
}

.setting-segment--disabled,
.custom-switch--disabled {
  opacity: 0.45;
}

.custom-switch {
  flex: none;
  width: 88rpx;
  height: 50rpx;
  padding: 4rpx;
  border-radius: 999rpx;
  background: #DCD4C4;
  box-sizing: border-box;
}

.custom-switch-dot {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #FFFDF5;
  transition: transform 0.18s ease;
}

.custom-switch--on {
  background: var(--green);
}

.custom-switch--on .custom-switch-dot {
  transform: translateX(38rpx);
}

.detail-visibility-list {
  margin-top: 18rpx;
}

.detail-visibility-option {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.detail-visibility-option--active {
  border-color: rgba(43, 96, 79, 0.32);
  background: var(--green-soft);
}

.option-radio {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 30rpx;
  height: 30rpx;
  margin-top: 4rpx;
  border: 2rpx solid #B9B09D;
  border-radius: 50%;
}

.option-radio-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.detail-visibility-option--active .option-radio {
  border-color: var(--green);
}

.detail-visibility-option--active .option-radio-dot {
  background: var(--green);
}

.settings-footer {
  flex: none;
  margin: 0;
  padding: 22rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: #FFFDF5;
}

.member-detail-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.member-detail-avatar {
  width: 92rpx;
  height: 92rpx;
  font-size: 32rpx;
}

.member-detail-main {
  min-width: 0;
  flex: 1;
}

.member-detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.soft-tag {
  display: inline-flex;
  align-items: center;
  height: 38rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: var(--green-soft);
  color: var(--green);
  font-size: 21rpx;
  font-weight: 700;
}

.soft-tag--gold {
  background: var(--gold-soft);
  color: #8C641B;
}

.task-detail-section,
.detail-private-card {
  margin-top: 24rpx;
}

.task-detail-list {
  margin-top: 14rpx;
}

@media (max-width: 350px) {
  .team-content {
    padding-left: 26rpx;
    padding-right: 26rpx;
  }

  .team-hero {
    grid-template-columns: 1fr;
    padding: 40rpx 32rpx 32rpx;
  }

  .hero-right {
    margin-top: 24rpx;
  }

  .hero-actions {
    margin-top: 28rpx;
  }

  .joint-head,
  .member-section-head {
    align-items: flex-start;
    flex-direction: column;
  }

  .joint-stats {
    grid-template-columns: 1fr;
    padding: 0 24rpx;
  }

  .joint-stat {
    justify-content: flex-start;
    border-left: 0;
    border-top: 1rpx solid rgba(206, 196, 176, 0.52);
    padding: 22rpx 0;
  }

  .joint-stat--first {
    border-top: 0;
  }

  .member-encourage {
    max-width: 154rpx;
  }
}
