.team-page {
  --team-primary: #3F8F72;
  --team-primary-deep: #24584A;
  --team-primary-light: #7CC6A0;
  --team-primary-soft: #E6F4EC;
  --team-text: #244C43;
  --team-secondary: #6F827B;
  --team-muted: #9AA8A3;
  --team-border: #E2EEE8;
  --team-soft: #EFF8F3;
  --team-sun: #F4C95D;
  --team-sun-soft: #FFF4D8;
  --team-bg: #F6FAF7;
  --team-shadow: 0 8rpx 28rpx rgba(36, 88, 74, 0.08);
  min-height: 100vh;
  padding: 32rpx 32rpx calc(156rpx + env(safe-area-inset-bottom));
  background: var(--team-bg);
}

.page-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  margin-bottom: 22rpx;
}

.page-title {
  color: var(--team-text);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.team-card {
  width: 100%;
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(226, 238, 232, 0.92);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: var(--team-shadow);
}

.team-card:first-of-type {
  margin-top: 0;
}

.team-info-card {
  padding: 30rpx 28rpx 26rpx;
}

.team-info-top,
.team-name-row,
.member-count-row,
.progress-meta-row,
.honor-card,
.feed-item,
.member-detail-head {
  display: flex;
  align-items: center;
}

.team-info-top,
.member-count-row,
.progress-meta-row,
.honor-card {
  justify-content: space-between;
}

.team-info-main {
  min-width: 0;
  flex: 1;
}

.team-name-row {
  align-items: flex-start;
  gap: 16rpx;
}

.team-name {
  min-width: 0;
  flex: 1;
  color: var(--team-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.my-team-tag,
.level-tag,
.mood-tag,
.soft-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 40rpx;
  padding: 0 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.my-team-tag {
  background: var(--team-primary-soft);
  color: var(--team-primary);
}

.team-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.level-tag {
  background: var(--team-sun-soft);
  color: #8A6B1F;
}

.mood-tag,
.soft-tag {
  background: var(--team-primary-soft);
  color: var(--team-primary);
}

.team-slogan {
  margin-top: 16rpx;
  color: var(--team-secondary);
  font-size: 26rpx;
  line-height: 36rpx;
}

.member-count-row {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--team-border);
}

.member-count {
  color: var(--team-secondary);
  font-size: 26rpx;
  line-height: 36rpx;
}

.card-arrow {
  color: #879790;
  font-size: 42rpx;
  line-height: 1;
}

.avatar-row {
  display: flex;
  align-items: center;
  min-height: 58rpx;
  margin-top: 18rpx;
}

.avatar-item,
.avatar-more,
.feed-avatar,
.member-detail-avatar {
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  background: var(--team-primary-soft);
  color: var(--team-primary);
  font-weight: 700;
}

.avatar-item {
  width: 52rpx;
  height: 52rpx;
  margin-right: -8rpx;
  border: 3rpx solid #ffffff;
  font-size: 22rpx;
}

.avatar-item image,
.feed-avatar image,
.member-detail-avatar image {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-more {
  width: 52rpx;
  height: 52rpx;
  margin-left: 8rpx;
  color: var(--team-muted);
  font-size: 20rpx;
}

.team-button-row,
.empty-actions,
.popup-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.team-button-row {
  margin-top: 28rpx;
}

.outline-button,
.solid-button {
  min-width: 0;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
}

.outline-button {
  border: 1rpx solid #E2EEE8;
  background: #ffffff;
  color: var(--team-primary);
}

.solid-button {
  background: var(--team-primary);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(63, 143, 114, 0.22);
}

.card-title {
  color: var(--team-text);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.progress-card {
  padding-bottom: 26rpx;
}

.progress-meta-row {
  margin-top: 22rpx;
}

.progress-label,
.progress-goal,
.honor-subtitle,
.feed-time,
.state-copy,
.empty-copy,
.popup-copy,
.detail-empty,
.task-detail-meta {
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.delta-label {
  color: var(--team-primary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.focus-number-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 10rpx;
}

.focus-number {
  color: var(--team-text);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.focus-unit {
  color: var(--team-text);
  font-size: 28rpx;
  font-weight: 700;
}

.progress-track {
  width: 100%;
  height: 16rpx;
  overflow: hidden;
  margin-top: 26rpx;
  border-radius: 8rpx;
  background: #E2EEE8;
}

.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #7CC6A0 0%, #3F8F72 100%);
}

.progress-goal {
  margin-top: 12rpx;
  text-align: right;
}

.honor-card {
  gap: 22rpx;
}

.honor-copy {
  min-width: 0;
  flex: 1;
}

.honor-subtitle {
  margin-top: 18rpx;
}

.honor-title {
  margin-top: 6rpx;
  color: var(--team-text);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.honor-badge {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  background: var(--team-sun);
  box-shadow: inset 0 0 0 8rpx rgba(255, 255, 255, 0.55);
}

.honor-badge::before,
.honor-badge::after {
  position: absolute;
  bottom: -10rpx;
  width: 20rpx;
  height: 30rpx;
  border-radius: 0 0 8rpx 8rpx;
  background: #E0B04A;
  content: "";
}

.honor-badge::before {
  left: 18rpx;
  transform: rotate(18deg);
}

.honor-badge::after {
  right: 18rpx;
  transform: rotate(-18deg);
}

.honor-badge-inner {
  position: relative;
  z-index: 1;
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--team-primary);
  color: #ffffff;
  font-size: 24rpx;
}

.feed-card {
  padding-bottom: 18rpx;
}

.feed-item {
  min-height: 70rpx;
  gap: 16rpx;
  padding: 18rpx 0;
}

.feed-item + .feed-item {
  border-top: 1rpx solid var(--team-border);
}

.feed-avatar {
  width: 42rpx;
  height: 42rpx;
  font-size: 20rpx;
}

.feed-main {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-name {
  color: var(--team-text);
  font-size: 26rpx;
  font-weight: 700;
}

.feed-action {
  color: var(--team-secondary);
  font-size: 26rpx;
}

.feed-time {
  flex: none;
  font-size: 22rpx;
  color: var(--team-muted);
}

.state-card,
.empty-card {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.state-icon,
.empty-mark {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: var(--team-primary-soft);
  color: var(--team-primary);
  font-size: 32rpx;
  font-weight: 800;
}

.state-title,
.empty-title {
  margin-top: 24rpx;
  color: var(--team-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.state-copy,
.empty-copy {
  max-width: 520rpx;
  margin-top: 14rpx;
}

.state-button {
  min-width: 220rpx;
  margin-top: 30rpx;
}

.empty-actions {
  width: 100%;
  margin-top: 32rpx;
}

.team-popup-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
}

.team-popup-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(36, 76, 67, 0.32);
}

.team-popup {
  position: relative;
  width: calc(100vw - 48rpx);
  max-height: calc(100vh - 180rpx);
  overflow-y: auto;
  box-sizing: border-box;
  margin: 0 auto 24rpx;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 -18rpx 48rpx rgba(36, 88, 74, 0.16);
}

.popup-handle {
  width: 78rpx;
  height: 8rpx;
  margin: 0 auto 26rpx;
  border-radius: 999rpx;
  background: #E2EEE8;
}

.popup-title {
  color: var(--team-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.popup-copy {
  margin-top: 12rpx;
}

.room-input {
  width: 100%;
  height: 90rpx;
  margin-top: 26rpx;
  padding: 0 26rpx;
  border: 1rpx solid var(--team-border);
  border-radius: 24rpx;
  background: #F8FBF9;
  color: var(--team-text);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.popup-actions {
  margin-top: 26rpx;
}

.popup-full-button {
  width: 100%;
  margin-top: 30rpx;
}

.team-detail-list {
  margin-top: 24rpx;
  border-top: 1rpx solid var(--team-border);
}

.team-detail-list > view {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--team-border);
  color: var(--team-secondary);
  font-size: 26rpx;
  line-height: 36rpx;
}

.team-detail-list > view text:last-child {
  color: var(--team-text);
  font-weight: 600;
  text-align: right;
}

.member-detail-popup {
  padding-top: 24rpx;
}

.member-detail-head {
  gap: 18rpx;
}

.member-detail-avatar {
  width: 82rpx;
  height: 82rpx;
  font-size: 32rpx;
}

.member-detail-main {
  min-width: 0;
  flex: 1;
}

.member-detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.task-detail-section,
.detail-private-card {
  margin-top: 28rpx;
}

.detail-section-title {
  color: var(--team-text);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.task-detail-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 16rpx;
}

.task-detail-item,
.detail-empty {
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--team-border);
  border-radius: 22rpx;
  background: #F8FBF9;
}

.task-detail-title {
  color: var(--team-text);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.task-detail-meta {
  margin-top: 8rpx;
}

button::after {
  border: 0;
}

button[disabled] {
  opacity: 0.58;
}

@media (max-width: 340px) {
  .team-page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .team-button-row,
  .empty-actions,
  .popup-actions {
    grid-template-columns: 1fr;
  }

  .team-name-row,
  .progress-meta-row {
    align-items: flex-start;
    flex-direction: column;
  }

  .feed-time {
    display: none;
  }
}

/* =========================================================
 * 墨绿成长主题 覆写（team-page）
 * 覆写本页硬编码的薄荷绿色：进度条、按钮、阴影、遮罩等。
 * 切换至墨绿主题后，整页 UI 统一呈现深绿质感。
 * ========================================================= */
.team-page[data-theme="inkGreen"] {
  --team-primary: #356859;
  --team-primary-deep: #1F5B4A;
  --team-primary-light: #7FAA91;
  --team-primary-soft: #EAF5EF;
  --team-text: #183F35;
  --team-secondary: #6D8179;
  --team-muted: #9AA9A4;
  --team-border: #DDEBE4;
  --team-soft: #F0F5F1;
  --team-sun: #F4C95D;
  --team-sun-soft: #FFF2CD;
  --team-bg: #F5F7F2;
  --team-shadow: 0 10rpx 28rpx rgba(20, 82, 63, 0.10);
  background: #F5F7F2;
  color: #183F35;
}

.team-page[data-theme="inkGreen"] .nav-bar {
  border-bottom-color: rgba(20, 82, 63, 0.08);
}

.team-page[data-theme="inkGreen"] .team-hero,
.team-page[data-theme="inkGreen"] .team-card,
.team-page[data-theme="inkGreen"] .team-info-card,
.team-page[data-theme="inkGreen"] .progress-card,
.team-page[data-theme="inkGreen"] .member-card,
.team-page[data-theme="inkGreen"] .feed-card,
.team-page[data-theme="inkGreen"] .empty-card,
.team-page[data-theme="inkGreen"] .join-popup,
.team-page[data-theme="inkGreen"] .member-detail {
  background: #FFFFFF;
  border-color: #DDEBE4;
}

.team-page[data-theme="inkGreen"] .hero-progress-fill,
.team-page[data-theme="inkGreen"] .progress-bar-inner,
.team-page[data-theme="inkGreen"] .summary-progress-fill {
  background: linear-gradient(90deg, #6DBB95 0%, #1F6F55 100%);
}

.team-page[data-theme="inkGreen"] .progress-track,
.team-page[data-theme="inkGreen"] .progress-bar,
.team-page[data-theme="inkGreen"] .empty-progress {
  background: #DDEBE4;
}

.team-page[data-theme="inkGreen"] .primary-action,
.team-page[data-theme="inkGreen"] .feed-button,
.team-page[data-theme="inkGreen"] .encourage-button,
.team-page[data-theme="inkGreen"] .team-button,
.team-page[data-theme="inkGreen"] .copy-button,
.team-page[data-theme="inkGreen"] .invite-button,
.team-page[data-theme="inkGreen"] .detail-button,
.team-page[data-theme="inkGreen"] .status-button {
  background: #1F6F55;
  box-shadow: 0 8rpx 20rpx rgba(31, 111, 85, 0.26);
  color: #FFFFFF;
}

.team-page[data-theme="inkGreen"] .encourage-button.is-encouraged,
.team-page[data-theme="inkGreen"] .status-button.is-disabled {
  background: #C9DDD3;
  color: rgba(255, 255, 255, 0.9);
}

.team-page[data-theme="inkGreen"] .medal-glow,
.team-page[data-theme="inkGreen"] .member-avatar-ring {
  border: 3rpx solid #FFFFFF;
  background: linear-gradient(180deg, #6DBB95 0%, #1F6F55 100%);
}

.team-page[data-theme="inkGreen"] .medal-crown {
  background: #E0B04A;
}

.team-page[data-theme="inkGreen"] .feed-icon,
.team-page[data-theme="inkGreen"] .info-icon,
.team-page[data-theme="inkGreen"] .room-icon,
.team-page[data-theme="inkGreen"] .team-mark {
  background: #E3F2EA;
  color: #1F6F55;
}

.team-page[data-theme="inkGreen"] .layer-mask,
.team-page[data-theme="inkGreen"] .popup-mask,
.team-page[data-theme="inkGreen"] .join-mask,
.team-page[data-theme="inkGreen"] .detail-mask {
  background: rgba(15, 63, 50, 0.36);
}

.team-page[data-theme="inkGreen"] .popup-panel,
.team-page[data-theme="inkGreen"] .join-popup,
.team-page[data-theme="inkGreen"] .member-detail {
  background: #F4F8F5;
  box-shadow: 0 -18rpx 48rpx rgba(15, 63, 50, 0.20);
}

.team-page[data-theme="inkGreen"] .popup-grabber,
.team-page[data-theme="inkGreen"] .join-grabber {
  background: #C9DDD3;
}

.team-page[data-theme="inkGreen"] .quick-task-popup,
.team-page[data-theme="inkGreen"] .feedback-popup,
.team-page[data-theme="inkGreen"] .management-popup {
  --popup-background: #F4F8F5;
}

/* =========================================================
 * 墨绿主题兼容 V2：严格对应当前 team/index.wxml 的真实类名。
 * 旧兼容层仍引用了已移除的 primary-action / progress-bar-inner 等类，
 * 因而主题状态虽已切换，关键控件仍显示为默认浅绿。
 * ========================================================= */
.team-page[data-theme="inkGreen"] {
  --team-primary: #356859;
  --team-primary-deep: #1F5B4A;
  --team-primary-light: #7FAA91;
  --team-primary-soft: #EAF5EF;
  --team-text: #233B34;
  --team-secondary: #71827A;
  --team-muted: #9AA9A4;
  --team-border: #E6EEE9;
  --team-soft: #F0F5F1;
  --team-bg: #F5F7F2;
  --team-shadow: 0 12rpx 32rpx rgba(31, 91, 74, 0.10);
  background: #F5F7F2;
  color: #233B34;
}

.team-page[data-theme="inkGreen"] .page-title {
  color: #233B34;
}

.team-page[data-theme="inkGreen"] .team-card {
  border-color: rgba(31, 91, 74, 0.10);
  background: #FFFFFF;
  box-shadow: var(--team-shadow);
}

/* 小队档案主卡与今日/进度/我的的深绿 Hero 保持同一层级。 */
.team-page[data-theme="inkGreen"] .team-info-card {
  border-color: transparent;
  background:
    radial-gradient(circle at 88% 18%, rgba(248, 210, 106, 0.16), transparent 30%),
    radial-gradient(circle at 94% 88%, rgba(255, 255, 255, 0.10), transparent 34%),
    linear-gradient(135deg, #1F5B4A 0%, #356859 62%, #4C806E 100%);
  box-shadow: 0 16rpx 36rpx rgba(31, 91, 74, 0.18);
}

.team-page[data-theme="inkGreen"] .team-info-card .team-name,
.team-page[data-theme="inkGreen"] .team-info-card .team-slogan,
.team-page[data-theme="inkGreen"] .team-info-card .member-count,
.team-page[data-theme="inkGreen"] .team-info-card .card-arrow {
  color: #FFFFFF;
}

.team-page[data-theme="inkGreen"] .team-info-card .member-count-row {
  border-top-color: rgba(255, 255, 255, 0.20);
}

.team-page[data-theme="inkGreen"] .team-info-card .my-team-tag,
.team-page[data-theme="inkGreen"] .team-info-card .mood-tag {
  background: rgba(255, 255, 255, 0.16);
  color: #FFFFFF;
}

.team-page[data-theme="inkGreen"] .team-info-card .level-tag {
  background: #F8D26A;
  color: #5E4A16;
}

.team-page[data-theme="inkGreen"] .team-info-card .avatar-item,
.team-page[data-theme="inkGreen"] .team-info-card .avatar-more {
  border-color: rgba(255, 255, 255, 0.82);
  background: rgba(255, 255, 255, 0.90);
  color: #356859;
}

.team-page[data-theme="inkGreen"] .team-info-card .outline-button {
  border-color: rgba(255, 255, 255, 0.34);
  background: rgba(255, 255, 255, 0.12);
  color: #FFFFFF;
}

.team-page[data-theme="inkGreen"] .progress-card,
.team-page[data-theme="inkGreen"] .honor-card,
.team-page[data-theme="inkGreen"] .feed-card,
.team-page[data-theme="inkGreen"] .state-card,
.team-page[data-theme="inkGreen"] .empty-card {
  border-color: rgba(31, 91, 74, 0.10);
  background: #FFFFFF;
}

.team-page[data-theme="inkGreen"] .progress-track {
  background: #D7E4DE;
}

.team-page[data-theme="inkGreen"] .progress-fill {
  background: linear-gradient(90deg, #7FAA91 0%, #356859 100%);
  box-shadow: 0 2rpx 8rpx rgba(53, 104, 89, 0.18);
}

.team-page[data-theme="inkGreen"] .delta-label,
.team-page[data-theme="inkGreen"] .focus-number,
.team-page[data-theme="inkGreen"] .focus-unit,
.team-page[data-theme="inkGreen"] .honor-title,
.team-page[data-theme="inkGreen"] .feed-name {
  color: #1F5B4A;
}

.team-page[data-theme="inkGreen"] .my-team-tag,
.team-page[data-theme="inkGreen"] .mood-tag,
.team-page[data-theme="inkGreen"] .soft-tag,
.team-page[data-theme="inkGreen"] .feed-avatar,
.team-page[data-theme="inkGreen"] .member-detail-avatar {
  background: #EAF5EF;
  color: #356859;
}

.team-page[data-theme="inkGreen"] .solid-button {
  background: #356859;
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(53, 104, 89, 0.22);
}

.team-page[data-theme="inkGreen"] .outline-button {
  border-color: #D7E4DE;
  background: #FFFFFF;
  color: #356859;
}

.team-page[data-theme="inkGreen"] .solid-button[disabled] {
  background: #C9D8D1;
  box-shadow: none;
}

.team-page[data-theme="inkGreen"] .honor-badge-inner {
  background: #356859;
}

.team-page[data-theme="inkGreen"] .team-popup-mask {
  background: rgba(31, 91, 74, 0.38);
  backdrop-filter: blur(6rpx);
}

.team-page[data-theme="inkGreen"] .team-popup {
  border-color: rgba(31, 91, 74, 0.10);
  background: #F5F7F2;
  box-shadow: 0 -18rpx 48rpx rgba(31, 91, 74, 0.20);
}

.team-page[data-theme="inkGreen"] .popup-handle {
  background: #C9D8D1;
}

.team-page[data-theme="inkGreen"] .room-input,
.team-page[data-theme="inkGreen"] .task-detail-item,
.team-page[data-theme="inkGreen"] .detail-private-card {
  border-color: #D7E4DE;
  background: #FFFFFF;
}
