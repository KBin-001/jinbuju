.team-page {
  --team-primary: #3F8F72;
  --team-primary-deep: #24584A;
  --team-primary-light: #7CC6A0;
  --team-primary-soft: #E6F4EC;
  --team-text: #244C43;
  --team-secondary: #6F827B;
  --team-muted: #9AA8A3;
  --team-border: #E2EEE8;
  --team-soft: #EFF8F3;
  --team-sun: #F4C95D;
  --team-sun-soft: #FFF4D8;
  --team-bg: #F6FAF7;
  --team-shadow: 0 8rpx 28rpx rgba(36, 88, 74, 0.08);
  min-height: 100vh;
  padding: 32rpx 32rpx calc(156rpx + env(safe-area-inset-bottom));
  background: var(--team-bg);
}

.page-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  min-height: 72rpx;
  margin-bottom: 22rpx;
}

.page-title {
  color: var(--team-text);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.page-subtitle {
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.team-card {
  width: 100%;
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(226, 238, 232, 0.92);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: var(--team-shadow);
}

.team-card:first-of-type {
  margin-top: 0;
}

.card-title {
  color: var(--team-text);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
}

/* ============ 1. 小队状态卡（紧凑身份卡） ============ */
.team-status-card {
  padding: 26rpx 28rpx 24rpx;
}

.team-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.team-identity-row {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
  gap: 18rpx;
}

.team-hero-avatar {
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 80rpx;
  height: 80rpx;
  border: 3rpx solid rgba(53, 104, 89, 0.12);
  border-radius: 24rpx;
  background: var(--team-primary-soft);
  color: var(--team-primary);
  font-size: 30rpx;
  font-weight: 800;
}

.team-hero-avatar image {
  display: block;
  width: 100%;
  height: 100%;
}

.team-info-block {
  min-width: 0;
  flex: 1;
}

.team-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.team-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--team-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.my-team-tag,
.level-tag,
.mood-tag,
.soft-tag,
.pill-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 40rpx;
  padding: 0 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.my-team-tag {
  flex: none;
  background: var(--team-primary-soft);
  color: var(--team-primary);
}

.team-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.level-tag {
  background: var(--team-sun-soft);
  color: #8A6B1F;
}

.mood-tag,
.soft-tag {
  background: var(--team-primary-soft);
  color: var(--team-primary);
}

.team-member-preview {
  flex: none;
  display: flex;
  align-items: center;
  min-height: 56rpx;
  padding-top: 6rpx;
}

.preview-avatar,
.preview-more {
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 52rpx;
  height: 52rpx;
  margin-right: -10rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  background: var(--team-primary-soft);
  color: var(--team-primary);
  font-weight: 700;
  font-size: 22rpx;
}

.preview-avatar image {
  width: 100%;
  height: 100%;
  display: block;
}

.preview-more {
  margin-right: 0;
  margin-left: 4rpx;
  background: var(--team-soft);
  color: var(--team-muted);
  font-size: 20rpx;
}

.team-sub-info {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 20rpx;
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.team-sub-info .dot {
  color: var(--team-muted);
}

.team-slogan-row {
  margin-top: 6rpx;
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.team-action-buttons {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  margin-top: 28rpx;
}

.team-action-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 0.5rpx;
  box-sizing: border-box;
  transition: opacity 0.15s, transform 0.15s, box-shadow 0.15s;
}

.team-action-btn--primary {
  background: var(--team-primary);
  border: 1rpx solid var(--team-primary);
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(53, 104, 89, 0.22);
}

.team-action-btn--secondary {
  background: #FFFFFF;
  border: 1rpx solid var(--team-border);
  color: var(--team-primary);
  box-shadow: 0 2rpx 8rpx rgba(36, 88, 74, 0.04);
}

.team-action-btn__icon {
  font-size: 30rpx;
  line-height: 1;
  font-weight: 600;
}

.team-action-btn__label {
  line-height: 1;
  white-space: nowrap;
}

.team-action-btn--pressed {
  opacity: 0.85;
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(36, 88, 74, 0.10);
}

.team-action-btn--secondary.team-action-btn--pressed {
  background: var(--team-bg-soft);
}

.pill-button::after {
  border: 0;
}

/* ============ 2. 今日小队战况 ============ */
.dashboard-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.dashboard-detail-link {
  flex: none;
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.team-stat-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 22rpx;
}

.stat-item {
  min-width: 0;
  padding: 4rpx 0;
}

.stat-item--divider {
  border-left: 1rpx solid var(--team-border);
  padding-left: 12rpx;
}

.stat-value {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  color: var(--team-text);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.stat-unit {
  font-size: 24rpx;
  font-weight: 700;
}

.stat-slash {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--team-muted);
}

.stat-label {
  margin-top: 4rpx;
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.team-progress-bar {
  margin-top: 24rpx;
}

.progress-track {
  width: 100%;
  height: 16rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #E2EEE8;
}

.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #7CC6A0 0%, #3F8F72 100%);
}

.progress-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
}

.progress-goal-text {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.progress-current {
  flex: none;
  color: var(--team-text);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

/* ============ 3. 今日共同行动 ============ */

.common-action-desc {
  margin-top: 12rpx;
  color: var(--team-secondary);
  font-size: 26rpx;
  line-height: 36rpx;
}

.team-common-progress {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: var(--team-soft);
}

.common-progress-item {
  min-width: 0;
  flex: 1;
}

.common-progress-label {
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.common-progress-value {
  margin-top: 6rpx;
  color: var(--team-text);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.cpv-current {
  color: var(--team-primary);
}

.cpv-current--done {
  color: var(--team-text);
}

.cpv-slash {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--team-muted);
}

.common-progress-divider {
  flex: none;
  width: 1rpx;
  background: var(--team-border);
}

/* ============ 4. 成员状态 ============ */
.member-status-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  font-size: 22rpx;
  line-height: 32rpx;
}

.ms-completed {
  color: var(--team-primary);
  font-weight: 600;
}

.ms-doing {
  color: #C99A2E;
  font-weight: 600;
}

.ms-pending {
  color: var(--team-muted);
  font-weight: 600;
}

.team-member-list {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 24rpx 12rpx;
  margin-top: 22rpx;
}

.member-status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.member-avatar {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--team-primary-soft);
  color: var(--team-primary);
  font-weight: 700;
  font-size: 30rpx;
}

.member-avatar image {
  width: 100%;
  height: 100%;
  display: block;
}

.member-avatar--doing {
  background: var(--team-sun-soft);
  color: #8A6B1F;
}

.member-avatar--pending {
  background: #F0F2EF;
  color: var(--team-muted);
  opacity: 0.62;
}

.avatar-check {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 3rpx solid #ffffff;
  background: var(--team-primary);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
}

.avatar-dot {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 3rpx solid #ffffff;
  background: var(--team-sun);
}

.member-status-info {
  margin-top: 12rpx;
  text-align: center;
  width: 100%;
}

.member-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--team-text);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.member-progress-text {
  margin-top: 4rpx;
  color: var(--team-secondary);
  font-size: 20rpx;
  line-height: 28rpx;
}

.member-list-more {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--team-border);
  text-align: center;
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

/* ============ 5. 行动动态 ============ */
.team-activity-card {
  padding-bottom: 18rpx;
}

.activity-empty {
  margin-top: 18rpx;
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.activity-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 70rpx;
  padding: 16rpx 0;
}

.activity-item + .activity-item {
  border-top: 1rpx solid var(--team-border);
}

.activity-avatar {
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--team-primary-soft);
  color: var(--team-primary);
  font-weight: 700;
  font-size: 22rpx;
}

.activity-avatar image {
  width: 100%;
  height: 100%;
  display: block;
}

.activity-main {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-name {
  color: var(--team-text);
  font-size: 26rpx;
  font-weight: 700;
}

.activity-action {
  color: var(--team-secondary);
  font-size: 26rpx;
}

.activity-time {
  flex: none;
  color: var(--team-muted);
  font-size: 22rpx;
}

.activity-more {
  margin-top: 10rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--team-border);
  text-align: center;
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
  transition: background 0.18s ease;
}

.activity-more--pressed {
  background: rgba(124, 198, 160, 0.08);
}

/* ============ 6. 本周荣誉（横向徽章） ============ */
.team-honor-card {
  padding-bottom: 24rpx;
}

.honor-scroll {
  width: 100%;
  margin-top: 18rpx;
  white-space: nowrap;
}

.honor-badge-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
  margin-right: 16rpx;
  padding: 22rpx 16rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: var(--team-soft);
  vertical-align: top;
  white-space: normal;
}

.honor-badge-card:last-child {
  margin-right: 0;
}

.honor-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--team-sun);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
}

.honor-title {
  margin-top: 14rpx;
  color: var(--team-text);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
}

.honor-desc {
  margin-top: 6rpx;
  color: var(--team-secondary);
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
}

/* ============ 按钮 / 状态卡 ============ */
.outline-button,
.solid-button {
  min-width: 0;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
}

.outline-button {
  border: 1rpx solid #E2EEE8;
  background: #ffffff;
  color: var(--team-primary);
}

.solid-button {
  background: var(--team-primary);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(63, 143, 114, 0.22);
}

button::after {
  border: 0;
}

button[disabled] {
  opacity: 0.58;
}

.state-card,
.empty-card {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.state-icon,
.empty-mark {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: var(--team-primary-soft);
  color: var(--team-primary);
  font-size: 32rpx;
  font-weight: 800;
}

.state-title,
.empty-title {
  margin-top: 24rpx;
  color: var(--team-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.state-copy,
.empty-copy,
.popup-copy,
.detail-empty,
.task-detail-meta {
  color: var(--team-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.state-copy,
.empty-copy {
  max-width: 520rpx;
  margin-top: 14rpx;
}

.state-button {
  min-width: 220rpx;
  margin-top: 30rpx;
}

.empty-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  width: 100%;
  margin-top: 32rpx;
}

/* ============ 弹窗 ============ */
.team-popup-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
}

.team-popup-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(36, 76, 67, 0.32);
}

.team-popup {
  position: relative;
  width: calc(100vw - 48rpx);
  max-height: calc(100vh - 180rpx);
  overflow-y: auto;
  box-sizing: border-box;
  margin: 0 auto 24rpx;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 -18rpx 48rpx rgba(36, 88, 74, 0.16);
}

.popup-handle {
  width: 78rpx;
  height: 8rpx;
  margin: 0 auto 26rpx;
  border-radius: 999rpx;
  background: #E2EEE8;
}

.popup-title {
  color: var(--team-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.popup-copy {
  margin-top: 12rpx;
}

.room-input {
  width: 100%;
  height: 90rpx;
  margin-top: 26rpx;
  padding: 0 26rpx;
  border: 1rpx solid var(--team-border);
  border-radius: 24rpx;
  background: #F8FBF9;
  color: var(--team-text);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.popup-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 26rpx;
}

.popup-full-button {
  width: 100%;
  margin-top: 30rpx;
}

.team-detail-list {
  margin-top: 24rpx;
  border-top: 1rpx solid var(--team-border);
}

.team-detail-list > view {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--team-border);
  color: var(--team-secondary);
  font-size: 26rpx;
  line-height: 36rpx;
}

.team-detail-list > view text:last-child {
  color: var(--team-text);
  font-weight: 600;
  text-align: right;
}

.member-detail-popup {
  padding-top: 24rpx;
}

/* ============ 小队设置悬浮容器 ============ */
.team-settings-layer {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 24rpx;
  box-sizing: border-box;
}

.team-settings-mask {
  position: absolute;
  inset: 0;
  background: rgba(31, 70, 58, 0.42);
  backdrop-filter: blur(8rpx);
}

.team-settings-dialog {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 686rpx;
  max-height: calc(100vh - 96rpx);
  border: 1rpx solid rgba(215, 228, 222, 0.96);
  border-radius: 36rpx;
  background: #F5F7F2;
  box-shadow: 0 28rpx 80rpx rgba(31, 70, 58, 0.24);
}

.settings-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: none;
  padding: 30rpx 30rpx 24rpx;
  border-bottom: 1rpx solid var(--team-border);
  background: #FFFFFF;
}

.settings-eyebrow {
  color: var(--team-primary);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
  letter-spacing: 2rpx;
}

.settings-title {
  margin-top: 4rpx;
  color: var(--team-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.settings-close {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: var(--team-soft);
  color: var(--team-secondary);
  font-size: 30rpx;
  line-height: 1;
}

.team-avatar-picker::after,
.copy-code-button::after,
.settings-cancel-button::after,
.settings-save-button::after {
  border: 0;
}

.settings-close:active {
  background: var(--team-primary-soft);
  color: var(--team-primary);
}

.settings-scroll {
  flex: 1;
  min-height: 0;
  max-height: calc(100vh - 330rpx);
}

.settings-readonly-tip {
  margin: 24rpx 24rpx 0;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #FFF2CD;
  color: #745B20;
  font-size: 24rpx;
  line-height: 34rpx;
}

.settings-section {
  margin: 24rpx;
  padding: 26rpx;
  border: 1rpx solid var(--team-border);
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 10rpx 28rpx rgba(31, 70, 58, 0.06);
}

.settings-section--readonly .team-profile-setting,
.settings-section--readonly .setting-block,
.settings-section--readonly .setting-toggle-row {
  opacity: 0.58;
}

.settings-section-title {
  margin-bottom: 22rpx;
  color: var(--team-text);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.team-profile-setting {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.team-avatar-picker {
  position: relative;
  overflow: visible;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 112rpx;
  height: 112rpx;
  margin: 0;
  padding: 0;
  border: 3rpx solid #D7E4DE;
  border-radius: 32rpx;
  background: var(--team-primary-soft);
  color: var(--team-primary);
  font-size: 38rpx;
  font-weight: 800;
}

.team-avatar-picker image {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 29rpx;
}

.team-avatar-picker[disabled] {
  opacity: 1;
}

.avatar-edit-mark {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border: 3rpx solid #FFFFFF;
  border-radius: 50%;
  background: var(--team-primary);
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
}

.team-name-field {
  min-width: 0;
  flex: 1;
}

.setting-label {
  color: var(--team-text);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 36rpx;
}

.settings-input {
  width: 100%;
  height: 76rpx;
  margin-top: 10rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--team-border);
  border-radius: 20rpx;
  background: #F8FBF9;
  color: var(--team-text);
  font-size: 26rpx;
}

.room-code-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: var(--team-soft);
}

.room-code-value {
  margin-top: 4rpx;
  color: var(--team-primary-deep);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 40rpx;
  letter-spacing: 4rpx;
}

.copy-code-button {
  flex: none;
  min-width: 108rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  color: var(--team-primary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 56rpx;
}

.setting-help,
.option-desc {
  color: var(--team-secondary);
  font-size: 22rpx;
  line-height: 32rpx;
}

.setting-help {
  margin-top: 10rpx;
}

.setting-block {
  padding-bottom: 26rpx;
  border-bottom: 1rpx solid var(--team-border);
}

.setting-block--last {
  padding-bottom: 0;
  border-bottom: 0;
}

.setting-segments {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 14rpx;
  padding: 8rpx;
  border-radius: 22rpx;
  background: #EEF3EF;
}

.setting-segments--three {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.setting-segment {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  padding: 0 12rpx;
  border-radius: 16rpx;
  color: var(--team-secondary);
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.setting-segment--active {
  background: #FFFFFF;
  color: var(--team-primary-deep);
  box-shadow: 0 6rpx 18rpx rgba(31, 70, 58, 0.10);
}

.setting-segment--disabled {
  opacity: 0.4;
}

.setting-toggle-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--team-border);
}

.setting-toggle-copy {
  min-width: 0;
  flex: 1;
}

.custom-switch {
  position: relative;
  flex: none;
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #D8E1DC;
  transition: background 180ms ease;
}

.custom-switch-dot {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 4rpx 10rpx rgba(31, 70, 58, 0.18);
  transition: transform 180ms ease;
}

.custom-switch--on {
  background: var(--team-primary);
}

.custom-switch--on .custom-switch-dot {
  transform: translateX(40rpx);
}

.custom-switch--disabled {
  opacity: 0.42;
}

.detail-visibility-list {
  display: grid;
  gap: 12rpx;
  margin-top: 14rpx;
}

.detail-visibility-option {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx;
  border: 1rpx solid var(--team-border);
  border-radius: 20rpx;
  background: #FAFCFA;
}

.detail-visibility-option--active {
  border-color: rgba(53, 104, 89, 0.46);
  background: var(--team-primary-soft);
}

.option-radio {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 32rpx;
  height: 32rpx;
  margin-top: 2rpx;
  border: 2rpx solid #B8C8C0;
  border-radius: 50%;
}

.detail-visibility-option--active .option-radio {
  border-color: var(--team-primary);
}

.detail-visibility-option--active .option-radio view {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--team-primary);
}

.option-title {
  color: var(--team-text);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.option-desc {
  margin-top: 4rpx;
}

.personal-detail-toggle {
  margin-top: 12rpx;
  padding-bottom: 0;
  border-bottom: 0;
}

.settings-footer {
  display: grid;
  grid-template-columns: 1fr 1.55fr;
  gap: 16rpx;
  flex: none;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--team-border);
  background: #FFFFFF;
}

.settings-cancel-button,
.settings-save-button {
  height: 76rpx;
  margin: 0;
  border-radius: 38rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 76rpx;
}

.settings-cancel-button {
  border: 1rpx solid #D7E4DE;
  background: #FFFFFF;
  color: var(--team-primary);
}

.settings-save-button {
  background: var(--team-primary);
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(53, 104, 89, 0.20);
}

.member-detail-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.member-detail-avatar {
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  background: var(--team-primary-soft);
  color: var(--team-primary);
  font-weight: 700;
  font-size: 32rpx;
}

.member-detail-avatar image {
  width: 100%;
  height: 100%;
  display: block;
}

.member-detail-main {
  min-width: 0;
  flex: 1;
}

.member-detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.task-detail-section,
.detail-private-card {
  margin-top: 28rpx;
}

.detail-section-title {
  color: var(--team-text);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.task-detail-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 16rpx;
}

.task-detail-item,
.detail-empty {
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--team-border);
  border-radius: 22rpx;
  background: #F8FBF9;
}

.task-detail-title {
  color: var(--team-text);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.task-detail-meta {
  margin-top: 8rpx;
}

.detail-private-card {
  padding: 22rpx;
  border: 1rpx solid var(--team-border);
  border-radius: 22rpx;
  background: #F8FBF9;
}

@media (max-width: 340px) {
  .team-page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .team-action-buttons,
  .empty-actions,
  .popup-actions {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16rpx;
  }

  .team-action-btn {
    height: 72rpx;
    border-radius: 36rpx;
    font-size: 24rpx;
    gap: 6rpx;
  }

  .team-action-btn__icon {
    font-size: 26rpx;
  }

  .team-member-list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .activity-time {
    display: none;
  }
}

/* =========================================================
 * 墨绿成长主题 覆写（team-page）
 * 切换至墨绿主题后，整页 UI 统一呈现深绿质感。
 * ========================================================= */
.team-page[data-theme="inkGreen"] {
  --team-primary: #356859;
  --team-primary-deep: #1F5B4A;
  --team-primary-light: #7FAA91;
  --team-primary-soft: #EAF5EF;
  --team-text: #233B34;
  --team-secondary: #71827A;
  --team-muted: #9AA9A4;
  --team-border: #E6EEE9;
  --team-soft: #F0F5F1;
  --team-sun: #F4C95D;
  --team-sun-soft: #FFF2CD;
  --team-bg: #F5F7F2;
  --team-shadow: 0 12rpx 32rpx rgba(31, 91, 74, 0.10);
  background: #F5F7F2;
  color: #233B34;
}

.team-page[data-theme="inkGreen"] .page-title {
  color: #233B34;
}

.team-page[data-theme="inkGreen"] .team-card {
  border-color: rgba(31, 91, 74, 0.10);
  background: #FFFFFF;
  box-shadow: var(--team-shadow);
}

/* 小队状态卡使用深绿 Hero 背景与其他页 Hero 保持一致。 */
.team-page[data-theme="inkGreen"] .team-status-card {
  border-color: transparent;
  background:
    radial-gradient(circle at 88% 18%, rgba(248, 210, 106, 0.16), transparent 30%),
    radial-gradient(circle at 94% 88%, rgba(255, 255, 255, 0.10), transparent 34%),
    linear-gradient(135deg, #1F5B4A 0%, #356859 62%, #4C806E 100%);
  box-shadow: 0 16rpx 36rpx rgba(31, 91, 74, 0.18);
}

.team-page[data-theme="inkGreen"] .team-status-card .team-name,
.team-page[data-theme="inkGreen"] .team-status-card .team-slogan-row,
.team-page[data-theme="inkGreen"] .team-status-card .team-sub-info {
  color: #FFFFFF;
}

.team-page[data-theme="inkGreen"] .team-status-card .team-sub-info .dot {
  color: rgba(255, 255, 255, 0.6);
}

.team-page[data-theme="inkGreen"] .team-status-card .my-team-tag,
.team-page[data-theme="inkGreen"] .team-status-card .mood-tag {
  background: rgba(255, 255, 255, 0.16);
  color: #FFFFFF;
}

.team-page[data-theme="inkGreen"] .team-status-card .level-tag {
  background: #F8D26A;
  color: #5E4A16;
}

.team-page[data-theme="inkGreen"] .team-status-card .preview-avatar,
.team-page[data-theme="inkGreen"] .team-status-card .preview-more {
  border-color: rgba(255, 255, 255, 0.82);
  background: rgba(255, 255, 255, 0.90);
  color: #356859;
}

.team-page[data-theme="inkGreen"] .team-status-card .team-action-btn--secondary {
  border-color: rgba(255, 255, 255, 0.34);
  background: rgba(255, 255, 255, 0.12);
  color: #FFFFFF;
}

.team-page[data-theme="inkGreen"] .team-status-card .team-action-btn--primary {
  background: #FFFFFF;
  border-color: #FFFFFF;
  color: #1F5B4A;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.10);
}

/* 战况 / 共同行动 / 成员 / 动态 / 荣誉 卡片保持白底 */
.team-page[data-theme="inkGreen"] .team-dashboard-card,
.team-page[data-theme="inkGreen"] .team-common-action,
.team-page[data-theme="inkGreen"] .team-member-status,
.team-page[data-theme="inkGreen"] .team-activity-card,
.team-page[data-theme="inkGreen"] .team-honor-card,
.team-page[data-theme="inkGreen"] .state-card,
.team-page[data-theme="inkGreen"] .empty-card {
  border-color: rgba(31, 91, 74, 0.10);
  background: #FFFFFF;
}

.team-page[data-theme="inkGreen"] .progress-track {
  background: #D7E4DE;
}

.team-page[data-theme="inkGreen"] .progress-fill {
  background: linear-gradient(90deg, #7FAA91 0%, #356859 100%);
  box-shadow: 0 2rpx 8rpx rgba(53, 104, 89, 0.18);
}

.team-page[data-theme="inkGreen"] .stat-value,
.team-page[data-theme="inkGreen"] .common-progress-value,
.team-page[data-theme="inkGreen"] .progress-current,
.team-page[data-theme="inkGreen"] .activity-name,
.team-page[data-theme="inkGreen"] .member-name,
.team-page[data-theme="inkGreen"] .honor-title {
  color: #1F5B4A;
}

.team-page[data-theme="inkGreen"] .cpv-current {
  color: #356859;
}

.team-page[data-theme="inkGreen"] .cpv-current--done {
  color: #1F5B4A;
}

.team-page[data-theme="inkGreen"] .ms-completed {
  color: #356859;
}

.team-page[data-theme="inkGreen"] .my-team-tag,
.team-page[data-theme="inkGreen"] .mood-tag,
.team-page[data-theme="inkGreen"] .soft-tag,
.team-page[data-theme="inkGreen"] .activity-avatar,
.team-page[data-theme="inkGreen"] .member-detail-avatar {
  background: #EAF5EF;
  color: #356859;
}

.team-page[data-theme="inkGreen"] .team-common-progress,
.team-page[data-theme="inkGreen"] .honor-badge-card {
  background: #F0F5F1;
}

.team-page[data-theme="inkGreen"] .member-avatar {
  background: #EAF5EF;
  color: #356859;
}

.team-page[data-theme="inkGreen"] .member-avatar--doing {
  background: #FFF2CD;
  color: #8A6B1F;
}

.team-page[data-theme="inkGreen"] .member-avatar--pending {
  background: #ECEFEA;
  color: #9AA9A4;
}

.team-page[data-theme="inkGreen"] .avatar-check {
  background: #356859;
}

.team-page[data-theme="inkGreen"] .solid-button {
  background: #356859;
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(53, 104, 89, 0.22);
}

.team-page[data-theme="inkGreen"] .outline-button {
  border-color: #D7E4DE;
  background: #FFFFFF;
  color: #356859;
}

.team-page[data-theme="inkGreen"] .pill-button {
  border-color: #D7E4DE;
  background: #FFFFFF;
  color: #356859;
}

.team-page[data-theme="inkGreen"] .solid-button[disabled] {
  background: #C9D8D1;
  box-shadow: none;
}

.team-page[data-theme="inkGreen"] .honor-icon {
  background: #F8D26A;
  color: #5E4A16;
}

.team-page[data-theme="inkGreen"] .team-popup-mask {
  background: rgba(31, 91, 74, 0.38);
  backdrop-filter: blur(6rpx);
}

.team-page[data-theme="inkGreen"] .team-popup {
  border-color: rgba(31, 91, 74, 0.10);
  background: #F5F7F2;
  box-shadow: 0 -18rpx 48rpx rgba(31, 91, 74, 0.20);
}

.team-page[data-theme="inkGreen"] .popup-handle {
  background: #C9D8D1;
}

.team-page[data-theme="inkGreen"] .room-input,
.team-page[data-theme="inkGreen"] .task-detail-item,
.team-page[data-theme="inkGreen"] .detail-private-card {
  border-color: #D7E4DE;
  background: #FFFFFF;
}

