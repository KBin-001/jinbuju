.team-page {
  padding-top: 40rpx;
}

.team-summary-card {
  margin-bottom: 34rpx;
}

.summary-heading,
.section-heading,
.member-top,
.member-name-row,
.member-progress-row,
.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-eyebrow {
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 650;
}

.team-name {
  max-width: 470rpx;
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.4;
}

.member-count {
  flex-shrink: 0;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 650;
}

.team-detail {
  margin-top: 28rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f7f9f6;
}

.detail-row + .detail-row {
  margin-top: 16rpx;
}

.detail-label {
  flex-shrink: 0;
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.detail-value {
  max-width: 450rpx;
  margin-left: 24rpx;
  font-size: 24rpx;
  text-align: right;
  line-height: 1.45;
}

.today-summary {
  margin-top: 24rpx;
  color: var(--color-text-secondary);
}

.today-summary text {
  color: var(--color-primary);
  font-size: 34rpx;
  font-weight: 700;
}

.waiting-notice,
.full-notice {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
}

.waiting-notice {
  background: #faf3e8;
  color: #735b33;
}

.full-notice {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
}

.privacy-copy {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.member-card {
  margin-top: 20rpx;
  padding: 28rpx;
}

.member-self {
  border-color: #cfe1d8;
  background: #f7faf8;
}

.member-avatar {
  width: 82rpx;
  height: 82rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #e7ebe6;
}

.member-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.member-name-row {
  justify-content: flex-start;
}

.member-name {
  max-width: 250rpx;
  overflow: hidden;
  font-size: 29rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.self-tag {
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 19rpx;
}

.member-streak {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.today-tag {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
}

.today-done {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.today-pending {
  background: #edf0ed;
  color: #626a63;
}

.today-rest {
  background: #eef2ec;
  color: #58675d;
}

.member-progress-row {
  justify-content: flex-start;
  gap: 80rpx;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--color-border);
}

.member-progress-value {
  font-size: 30rpx;
  font-weight: 700;
}

.member-progress-label {
  margin-top: 5rpx;
  color: var(--color-text-secondary);
  font-size: 21rpx;
}

.member-progress-track {
  height: 12rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e8ece6;
}

.member-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
}

.encourage-button {
  width: 100%;
  margin-top: 24rpx;
  padding: 20rpx;
  border: 2rpx solid var(--color-primary);
  border-radius: 999rpx;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 650;
}

.encouraged-button,
.encourage-button[disabled] {
  border-color: #dce2dc;
  background: #edf1ed;
  color: #7d867e;
}

.team-summary-card {
  background:
    radial-gradient(circle at 100% 0, rgba(243, 199, 106, 0.2), transparent 36%),
    linear-gradient(145deg, #ffffff, #f6faf7);
}

.team-detail {
  border: 1rpx solid var(--color-border);
  background: rgba(255, 255, 255, 0.7);
}

.member-card {
  box-shadow: 0 8rpx 26rpx rgba(31, 77, 66, 0.07);
}

.member-self {
  background: linear-gradient(145deg, #ffffff, var(--color-primary-light));
}

.member-progress-fill {
  background: linear-gradient(90deg, var(--color-primary), var(--color-growth));
}

.encourage-button {
  background: #ffffff;
}
/* Companion squad */
.team-hero { padding:38rpx; }
.team-hero .page-eyebrow { color:#e8c97f; }
.team-hero .page-title { color:#fff; }
.team-hero .page-subtitle { color:rgba(255,255,255,.68); }
.team-summary-card { overflow:hidden; border:0; border-radius:36rpx; background:linear-gradient(145deg,#fff,#f2ead8); box-shadow:0 18rpx 48rpx rgba(21,63,54,.11); }
.member-count { background:#153f36; color:#fff; }
.today-summary { padding:18rpx 24rpx; border-radius:24rpx; background:linear-gradient(135deg,#5c78d6,#7567c8); color:#fff; line-height:1.35; }
.today-summary text { margin:0 5rpx; color:#f4d58c; font-size:32rpx; }
.member-card { border:0; border-left:7rpx solid #5c78d6; border-radius:30rpx; background:linear-gradient(145deg,#fff,#f4f6ff); }
.member-card:nth-child(3n+2) { border-left-color:#e67861; background:linear-gradient(145deg,#fff,#fff7f4); }
.member-card:nth-child(3n) { border-left-color:#d8a84e; background:linear-gradient(145deg,#fff,#fffaf0); }
.member-self { box-shadow:0 16rpx 42rpx rgba(92,120,214,.16); }
.member-avatar { overflow:hidden; border:4rpx solid rgba(255,255,255,.9); border-radius:50%; box-shadow:0 8rpx 20rpx rgba(21,63,54,.14); }
.encourage-button { border:0; background:#153f36; color:#fff; }
