<view class="history-page" data-theme="{{appTheme}}">
  <view class="custom-nav">
    <view class="nav-back" bindtap="goBack" hover-class="tap-pressed" aria-role="button" aria-label="返回"><t-icon name="chevron-left" size="42rpx" /></view>
    <text class="nav-title">历史目标</text>
    <view class="nav-placeholder"></view>
  </view>

  <view class="page-content">
    <view class="history-hero">
      <text class="hero-eyebrow">成长档案</text>
      <text class="hero-title">走过的每一步，都有据可查</text>
      <text class="hero-subtitle">完成、终止和归档彼此分开；删除后仍可在最近删除中恢复。</text>
    </view>

    <view class="summary-card">
      <view class="summary-item"><text class="summary-value">{{summary.goalCount}}</text><text class="summary-label">历史目标</text></view>
      <view class="summary-item"><text class="summary-value">{{summary.completedActions}}</text><text class="summary-label">完成行动</text></view>
      <view class="summary-item"><text class="summary-value">{{summary.actualMinutes}}</text><text class="summary-label">投入分钟</text></view>
      <view class="summary-item"><text class="summary-value">{{summary.averageRate}}%</text><text class="summary-label">平均行动完成率</text></view>
    </view>

    <view class="tab-bar">
      <view class="tab {{activeTab === 'history' ? 'tab--active' : ''}}" data-tab="history" bindtap="switchTab">历史档案</view>
      <view class="tab {{activeTab === 'deleted' ? 'tab--active' : ''}}" data-tab="deleted" bindtap="switchTab">最近删除</view>
    </view>

    <scroll-view wx:if="{{activeTab === 'history'}}" class="filter-row" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-inner">
        <view class="filter {{activeFilter === 'all' ? 'filter--active' : ''}}" data-filter="all" bindtap="changeFilter">全部</view>
        <view class="filter {{activeFilter === 'completed' ? 'filter--active' : ''}}" data-filter="completed" bindtap="changeFilter">已完成</view>
        <view class="filter {{activeFilter === 'ended' ? 'filter--active' : ''}}" data-filter="ended" bindtap="changeFilter">已终止</view>
        <view class="filter {{activeFilter === 'archived' ? 'filter--active' : ''}}" data-filter="archived" bindtap="changeFilter">已归档</view>
      </view>
    </scroll-view>

    <view wx:if="{{status === 'loading'}}" class="state-card">
      <t-loading size="44rpx" theme="circular" />
      <text>正在读取云端目标档案</text>
    </view>
    <view wx:elif="{{status === 'error'}}" class="state-card">
      <t-icon name="error-circle" size="48rpx" />
      <text class="state-title">历史目标暂时无法读取</text>
      <text class="state-desc">{{errorMessage}}</text>
      <view class="state-action" bindtap="retry">重新加载</view>
    </view>
    <view wx:elif="{{groups.length === 0}}" class="state-card">
      <t-icon name="time" size="52rpx" />
      <text class="state-title">{{activeTab === 'deleted' ? '最近没有删除的目标' : '这里还没有目标档案'}}</text>
      <text class="state-desc">{{activeTab === 'deleted' ? '从历史档案删除的目标会出现在这里。' : '目标完成、终止或归档后，会完整保存在这里。'}}</text>
      <view wx:if="{{activeTab === 'history'}}" class="state-action" bindtap="backProfile">返回我的</view>
    </view>

    <block wx:else>
      <view wx:for="{{groups}}" wx:key="year" class="year-group">
        <view class="year-title">{{item.year}} 年</view>
        <view wx:for="{{item.goals}}" wx:for-item="goal" wx:key="id" class="archive-card" data-id="{{goal.id}}" bindtap="openReview" hover-class="archive-card--pressed">
          <view class="archive-head">
            <view class="archive-main">
              <text class="archive-title">{{goal.title}}</text>
              <text class="archive-date">{{goal.dateRange}}</text>
            </view>
            <view class="status-chip">{{activeTab === 'deleted' ? '最近删除' : goal.statusText}}</view>
          </view>
          <view class="archive-metrics">
            <view><text>{{goal.totalDays}}</text><text>行动天数</text></view>
            <view><text>{{goal.completionRate}}%</text><text>行动完成率</text></view>
            <view><text>{{goal.completedActions}}</text><text>完成行动</text></view>
            <view><text>{{goal.actualMinutes}}</text><text>投入分钟</text></view>
          </view>
          <view wx:if="{{activeTab === 'history'}}" class="archive-actions">
            <view class="text-action" data-id="{{goal.id}}" catchtap="openReview">查看复盘</view>
            <view class="text-action text-action--danger" data-id="{{goal.id}}" data-title="{{goal.title}}" catchtap="deleteGoal">删除</view>
          </view>
          <view wx:else class="archive-actions">
            <text class="deleted-date">删除于 {{goal.deletedAt}}</text>
            <view class="text-action" data-id="{{goal.id}}" catchtap="restoreGoal">恢复</view>
            <view class="text-action text-action--danger" data-id="{{goal.id}}" data-title="{{goal.title}}" catchtap="purgeGoal">彻底删除</view>
          </view>
          <view wx:if="{{operatingId === goal.id}}" class="operation-mask"><t-loading size="36rpx" theme="circular" /></view>
        </view>
      </view>
    </block>
  </view>
</view>
