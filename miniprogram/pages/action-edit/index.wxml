<view class="page edit-page" data-theme="{{appTheme}}">
  <view wx:if="{{loading}}" class="card state-card">
    <view class="loading-dot"></view>
    <view class="state-title">正在读取行动</view>
  </view>
  <view wx:elif="{{errorMessage}}" class="card state-card">
    <view class="state-mark">!</view>
    <view class="state-title">无法编辑</view>
    <view class="state-description">{{errorMessage}}</view>
    <t-button class="secondary-button" bindtap="goBack">返回上一页</t-button>
  </view>
  <block wx:else>
    <view class="page-header">
      <view class="page-title">{{isEdit ? '编辑行动' : '添加行动'}}</view>
      <view class="page-subtitle">写清今天要做什么，并留出一段容易开始的时间。</view>
    </view>
    <view class="card form-card">
      <view class="field-label">行动标题</view>
      <t-input class="text-input" value="{{title}}" maxlength="40" placeholder="例如：做一组逻辑推理题" confirm-type="done" bindchange="inputTitle"/>
      <view class="counter">{{title.length}} / 40</view>
      <view class="field field-gap">
        <view class="field-label">预计投入</view>
        <view class="duration-grid">
          <view wx:for="{{durationOptions}}" wx:key="*this" class="duration-option {{estimatedMinutes === item ? 'is-selected' : ''}}" data-value="{{item}}" bindtap="selectDuration">{{item}} 分钟</view>
        </view>
        <view class="custom-duration-row">
          <text>自定义</text>
          <view class="input-unit"><t-input type="number" value="{{estimatedMinutes}}" maxlength="3" bindchange="inputMinutes"/><text>分钟</text></view>
        </view>
        <view class="hint">支持 5～240 分钟，预计投入与完成后的实际投入分开记录。</view>
      </view>
      <view class="field field-gap">
        <view class="field-label">安排日期</view>
        <picker mode="date" value="{{currentDate}}" start="{{todayDate}}" end="{{dateEnd}}" bindchange="changeDate">
          <view class="date-picker"><text>{{currentDate}}</text><text class="date-arrow">选择日期</text></view>
        </picker>
      </view>
      <view class="field field-gap reminder-switch-row">
        <view><view class="field-label">提醒我</view><view class="hint">每条微信提醒需要一次授权</view></view>
        <switch color="#245B4D" checked="{{reminderEnabled}}" bindchange="toggleReminder" />
      </view>
      <view wx:if="{{reminderEnabled}}" class="field reminder-time-field">
        <picker mode="time" value="{{reminderTime}}" bindchange="changeReminderTime">
          <view class="date-picker"><text>{{reminderTime}}</text><text class="date-arrow">5 分钟粒度</text></view>
        </picker>
        <view class="hint">{{hadScheduledReminder ? '未发送提醒改期不需要重新授权。' : '保存时会弹出微信一次性订阅授权。'}}</view>
      </view>
    </view>
    <view wx:if="{{validationMessage}}" class="validation-message">{{validationMessage}}</view>
    <view class="bottom-action">
      <t-button class="primary-button save-button" loading="{{submitting}}" disabled="{{submitting || title.length < 2}}" bindtap="save">{{submitting ? '正在保存' : '保存行动'}}</t-button>
    </view>
  </block>
</view>
