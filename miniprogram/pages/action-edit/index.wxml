<view class="page edit-page" data-theme="{{appTheme}}">
  <view wx:if="{{loading}}" class="card state-card">
    <view class="loading-dot"></view>
    <view class="state-title">正在读取行动</view>
  </view>
  <view wx:elif="{{errorMessage}}" class="card state-card">
    <view class="state-mark">!</view>
    <view class="state-title">无法编辑</view>
    <view class="state-description">{{errorMessage}}</view>
  </view>
  <block wx:else>
    <view class="page-header">
      <view class="page-eyebrow">MANUAL ACTION</view>
      <view class="page-title">{{isEdit ? '编辑行动' : '添加行动'}}</view>
      <view class="page-subtitle">写清要做什么，也给自己留出合适的时间。</view>
    </view>
    <view class="card form-card">
      <view class="field-label">行动标题</view>
      <input class="text-input" value="{{title}}" maxlength="40" placeholder="例如：做一组逻辑推理题" bindinput="inputTitle"/>
      <view class="counter">{{title.length}} / 40</view>
      <view class="two-fields">
        <view class="field">
          <view class="field-label">预计时间</view>
          <view class="input-unit">
            <input type="number" value="{{estimatedMinutes}}" bindinput="inputMinutes"/>
            <text>分钟</text>
          </view>
          <view class="hint">5～240 分钟</view>
        </view>
        <view class="field">
          <view class="field-label">安排日期</view>
          <picker mode="date" value="{{currentDate}}" bindchange="changeDate">
            <view class="date-picker">{{currentDate}} ›</view>
          </picker>
        </view>
      </view>
      <view class="field-label field-gap">简单说明（可选）</view>
      <textarea class="description" value="{{description}}" maxlength="150" placeholder="补充执行方式或完成标准" bindinput="inputDescription"/>
      <view class="counter">{{description.length}} / 150</view>
    </view>
    <button class="primary-button save-button" loading="{{submitting}}" disabled="{{submitting || title.length < 2}}" bindtap="save">
      {{submitting ? '正在保存' : '保存行动'}}
    </button>
  </block>
</view>
