<view class="page edit-page" data-theme="{{appTheme}}">
  <view wx:if="{{loading}}" class="card state-card">
    <t-loading theme="circular" size="48rpx" />
    <view class="state-title">正在读取行动</view>
  </view>
  <view wx:elif="{{errorMessage}}" class="card state-card">
    <view class="state-mark">!</view>
    <view class="state-title">无法编辑</view>
    <view class="state-description">{{errorMessage}}</view>
    <t-button class="secondary-button" theme="default" shape="round" bindtap="goBack">返回上一页</t-button>
  </view>

  <block wx:else>
    <view class="page-header">
      <view class="page-eyebrow">今日行动</view>
      <view class="page-title">{{isEdit ? '调整行动' : '添加行动'}}</view>
      <view class="page-subtitle">把今天要推进的事情写具体，给它留出一段容易开始的时间。</view>
    </view>

    <view class="form-section surface-card">
      <view class="section-heading">
        <view class="section-icon"><t-icon name="edit-1" size="30rpx" /></view>
        <view><view class="section-title">行动内容</view><view class="section-caption">一句话说明今天具体要做什么</view></view>
      </view>

      <view class="title-input-shell {{title.length >= 2 ? 'has-value' : ''}}">
        <input class="title-input" value="{{title}}" maxlength="40" placeholder="例如：完成一组逻辑推理题" confirm-type="done" bindinput="inputTitle" />
        <view class="title-counter">{{title.length}} / 40</view>
      </view>

      <view class="icon-picker-block">
        <view class="field-heading">
          <view><view class="field-label">行动图标</view><view class="icon-match-copy">{{iconManual ? '已使用你的选择' : '已根据标题智能匹配'}}</view></view>
          <view class="auto-icon-button {{iconManual ? '' : 'is-active'}}" bindtap="useAutomaticActionIcon" hover-class="auto-icon-button--pressed"><t-icon name="lightbulb" size="23rpx" /><text>智能匹配</text></view>
        </view>
        <scroll-view class="icon-picker-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="icon-picker-list">
            <view wx:for="{{actionIconOptions}}" wx:key="key" class="icon-option icon-option--{{item.tone}} {{selectedIconKey === item.key ? 'is-selected' : ''}}" data-key="{{item.key}}" bindtap="selectActionIcon" hover-class="icon-option--pressed" aria-role="radio" aria-checked="{{selectedIconKey === item.key}}" aria-label="选择{{item.label}}图标">
              <view class="icon-option-symbol"><image src="{{item.asset}}" mode="aspectFit" /></view>
              <text>{{item.label}}</text>
              <view wx:if="{{selectedIconKey === item.key}}" class="icon-option-check"><t-icon name="check" size="17rpx" /></view>
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="field-block">
        <view class="field-heading"><view class="field-label">预计投入</view><view class="field-note">选择容易开始的时长</view></view>
        <view class="duration-grid">
          <view wx:for="{{durationOptions}}" wx:key="*this" class="duration-option {{estimatedMinutes === item && !isCustomDuration ? 'is-selected' : ''}}" data-value="{{item}}" bindtap="selectDuration" hover-class="duration-option--pressed"><text>{{item}}</text><text>分钟</text></view>
        </view>
        <view class="custom-duration-box {{isCustomDuration ? 'is-active' : ''}}">
          <view class="custom-duration-copy"><view>自定义时长</view><text>支持 5～240 分钟</text></view>
          <view class="custom-duration-input"><input type="number" value="{{estimatedMinutes}}" maxlength="3" bindinput="inputMinutes" /><text>分钟</text></view>
        </view>
        <view class="field-hint"><t-icon name="info-circle" size="24rpx" /><text>完成后可单独修改实际投入，不会覆盖预计时长。</text></view>
      </view>
    </view>

    <view class="form-section surface-card">
      <view class="section-heading">
        <view class="section-icon"><t-icon name="star" size="30rpx" /></view>
        <view><view class="section-title">重要程度</view><view class="section-caption">影响今日分组推荐</view></view>
      </view>

      <view class="duration-grid duration-grid--two">
        <view class="duration-option {{importance === 'normal' ? 'is-selected' : ''}}" data-importance="normal" bindtap="selectImportance" hover-class="duration-option--pressed">
          <text>普通任务</text><text>常规推进</text>
        </view>
        <view class="duration-option {{importance === 'required' ? 'is-selected' : ''}}" data-importance="required" bindtap="selectImportance" hover-class="duration-option--pressed">
          <text>必须完成</text><text>优先推荐为重点</text>
        </view>
      </view>

      <view class="setting-divider"></view>

      <view class="setting-row reminder-row">
        <view class="setting-copy"><view class="setting-label">阻塞其他任务</view><view class="setting-description">标记后评分中获得依赖加分</view></view>
        <switch class="reminder-switch" color="#668F84" checked="{{blocksOthers}}" bindchange="toggleBlocksOthers" />
      </view>
    </view>

    <view class="form-section schedule-card surface-card">
      <view class="section-heading compact-heading">
        <view class="section-icon"><t-icon name="calendar" size="30rpx" /></view>
        <view><view class="section-title">时间安排</view><view class="section-caption">安排日期与微信提醒</view></view>
      </view>

      <picker mode="date" value="{{currentDate}}" start="{{todayDate}}" end="{{dateEnd}}" bindchange="changeDate">
        <view class="setting-row" hover-class="setting-row--pressed">
          <view class="setting-copy"><view class="setting-label">安排日期</view><view class="setting-description">行动将出现在对应日期</view></view>
          <view class="setting-value"><text>{{currentDate}}</text><t-icon name="chevron-right" size="28rpx" /></view>
        </view>
      </picker>

      <view class="setting-divider"></view>

      <view class="setting-row reminder-row">
        <view class="setting-copy"><view class="setting-label">提醒我</view><view class="setting-description">每条微信提醒需要一次授权</view></view>
        <switch class="reminder-switch" color="#668F84" checked="{{reminderEnabled}}" bindchange="toggleReminder" />
      </view>

      <block wx:if="{{reminderEnabled}}">
        <view class="setting-divider reminder-divider"></view>
        <picker mode="time" value="{{reminderTime}}" bindchange="changeReminderTime">
          <view class="reminder-time-row" hover-class="setting-row--pressed">
            <view><view class="setting-label">提醒时间</view><view class="setting-description">{{hadScheduledReminder ? '调整未发送提醒无需重新授权' : '保存时申请微信一次性订阅'}}</view></view>
            <view class="reminder-time-value"><text>{{reminderTime}}</text><t-icon name="chevron-right" size="28rpx" /></view>
          </view>
        </picker>
      </block>
    </view>

    <view class="bottom-action">
      <view wx:if="{{validationMessage}}" class="validation-message"><t-icon name="error-circle" size="24rpx" /><text>{{validationMessage}}</text></view>
      <t-button class="save-button" theme="primary" shape="round" size="large" block="{{true}}" loading="{{submitting}}" disabled="{{submitting || title.length < 2}}" bindtap="save">{{submitting ? '正在保存' : (isEdit ? '保存修改' : '保存行动')}}</t-button>
    </view>
  </block>
</view>
