page { background: #F7F3EA; }
.edit-page { padding-top: 36rpx; color: #24312D; }
.form-card { margin-top: 24rpx; border: 1rpx solid rgba(121,111,91,.13); background: #FFFCF6; }
.field-label { color: #24312D; font-weight: 680; }
.text-input, .description, .input-unit, .date-picker { margin-top: 14rpx; padding: 22rpx; border: 1rpx solid rgba(36,91,77,.16); border-radius: 22rpx; background: #FAF7F0; }
.description { width: 100%; height: 190rpx; }
.counter, .hint { margin-top: 8rpx; color: #8B908C; font-size: 22rpx; }
.counter { text-align: right; }
.two-fields { margin-top: 28rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.input-unit { display: flex; align-items: center; gap: 8rpx; }
.input-unit input { min-width: 0; flex: 1; }
.date-picker { min-height: 44rpx; color: #245B4D; font-size: 24rpx; white-space: nowrap; }
.field-gap { margin-top: 28rpx; }
.save-button { width: 100%; margin-top: 30rpx; background: #245B4D; color: #FFFCF6; }
@media (max-width: 350px) { .two-fields { grid-template-columns: 1fr; } }
