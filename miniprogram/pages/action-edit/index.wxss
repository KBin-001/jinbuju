page { background: #F7F3EA; }
.edit-page { min-height: 100vh; box-sizing: border-box; padding: 32rpx 32rpx calc(154rpx + env(safe-area-inset-bottom)); color: #24312D; }
.page-title { font-size: 38rpx; line-height: 50rpx; font-weight: 720; }
.page-subtitle { max-width: 590rpx; margin-top: 8rpx; color: #7C817D; font-size: 24rpx; line-height: 36rpx; }
.form-card { margin-top: 26rpx; padding: 30rpx; border: 1rpx solid rgba(121,111,91,.13); border-radius: 28rpx; background: #FFFCF6; box-shadow: none; }
.field-label { color: #24312D; font-weight: 680; }
.text-input, .description, .input-unit, .date-picker { margin-top: 14rpx; padding: 20rpx 22rpx; border: 1rpx solid rgba(36,91,77,.16); border-radius: 20rpx; background: #FAF7F0; }
.description { width: 100%; height: 190rpx; }
.counter, .hint { margin-top: 8rpx; color: #8B908C; font-size: 22rpx; }
.counter { text-align: right; }
.duration-grid { margin-top: 16rpx; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.duration-option { min-height: 68rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(36,91,77,.18); border-radius: 34rpx; color: #245B4D; background: #FFFDF8; font-size: 22rpx; font-weight: 600; }
.duration-option.is-selected { border-color: #245B4D; color: #FFF; background: #245B4D; }
.custom-duration-row { min-height: 76rpx; margin-top: 16rpx; padding: 0 4rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; color: #4F615B; font-size: 23rpx; }
.input-unit { width: 240rpx; margin-top: 0; display: flex; align-items: center; gap: 8rpx; }
.input-unit input { min-width: 0; flex: 1; }
.date-picker { min-height: 48rpx; display: flex; align-items: center; justify-content: space-between; color: #245B4D; font-size: 24rpx; white-space: nowrap; }
.date-arrow { color: #7C817D; font-size: 21rpx; }
.field-gap { margin-top: 28rpx; }
.validation-message { margin-top: 18rpx; color: #A14F45; font-size: 22rpx; text-align: center; }
.bottom-action { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid rgba(36,91,77,.08); background: rgba(247,243,234,.96); }
.save-button { width: 100%; height: 82rpx; border-radius: 41rpx; background: #245B4D; color: #FFFCF6; }
.secondary-button { min-width: 210rpx; height: 72rpx; margin-top: 24rpx; border: 1rpx solid rgba(36,91,77,.18); border-radius: 36rpx; color: #245B4D; background: #FFFDF8; }
.state-card { margin-top: 20vh; padding: 44rpx 30rpx; text-align: center; }
@media (max-width: 350px) { .duration-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
