page { background: var(--color-bg-page, #f7f3ea); }
.edit-page { min-height: 100vh; box-sizing: border-box; padding: 30rpx 32rpx calc(176rpx + env(safe-area-inset-bottom)); overflow: hidden; color: var(--color-text-main, #24312d); background: radial-gradient(circle at 92% 0, rgba(127,157,145,.11), transparent 420rpx), linear-gradient(180deg,#faf7ef 0%,#f7f3ea 100%); }
.page-header { margin-bottom: 26rpx; padding: 4rpx 4rpx 0; }
.page-eyebrow { color: #9b7432; font-size: 20rpx; font-weight: 650; line-height: 30rpx; letter-spacing: 3rpx; }
.page-title { margin-top: 5rpx; color: #24312d; font-family: var(--font-family-brand); font-size: 42rpx; font-weight: var(--font-weight-title); line-height: 56rpx; letter-spacing: 2rpx; }
.page-subtitle { max-width: 620rpx; margin-top: 8rpx; color: #747c78; font-size: 23rpx; line-height: 36rpx; }
.surface-card { border: 1rpx solid rgba(93,108,100,.11); border-radius: 28rpx; background: rgba(255,252,246,.94); box-shadow: 0 10rpx 30rpx rgba(54,70,63,.045); }
.form-section { padding: 28rpx 26rpx; }
.schedule-card { margin-top: 22rpx; padding-bottom: 10rpx; }
.section-heading { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.compact-heading { margin-bottom: 8rpx; }
.section-icon { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; flex: none; border-radius: 17rpx; color: var(--color-action-primary); background: var(--color-action-soft); }
.section-title { color: #24312d; font-size: 27rpx; font-weight: 680; line-height: 38rpx; }
.section-caption { margin-top: 1rpx; color: #8a8f8b; font-size: 19rpx; line-height: 28rpx; }
.title-input-shell { height: 102rpx; padding: 0 18rpx 0 20rpx; display: flex; align-items: center; gap: 14rpx; border: 1rpx solid rgba(87,105,96,.17); border-radius: 20rpx; background: #faf8f2; transition: border-color 180ms ease, background 180ms ease; }
.title-input-shell.has-value { border-color: rgba(36,91,77,.27); background: #fffdf8; }
.title-input { min-width: 0; height: 100%; flex: 1; color: #24312d; font-size: 27rpx; line-height: 102rpx; }
.title-input::placeholder { color: #a4a6a2; }
.title-counter { align-self: flex-end; padding-bottom: 17rpx; flex: none; color: #9a9e9a; font-size: 18rpx; line-height: 24rpx; }
.icon-picker-block { margin-top: 27rpx; }
.icon-match-copy { margin-top: 2rpx; color: #929792; font-size: 18rpx; line-height: 27rpx; }
.auto-icon-button { min-height: 48rpx; padding: 0 14rpx; display: flex; align-items: center; gap: 5rpx; flex: none; border: 1rpx solid rgba(36,91,77,.13); border-radius: 24rpx; color: #718079; background: #f6f3ec; font-size: 18rpx; font-weight: 600; }
.auto-icon-button.is-active { border-color: rgba(102,143,132,.28); color: var(--color-action-primary); background: var(--color-action-soft); }
.auto-icon-button--pressed { opacity: .7; }
.icon-picker-scroll { width: calc(100% + 26rpx); margin-top: 14rpx; margin-right: -26rpx; white-space: nowrap; }
.icon-picker-list { padding-right: 26rpx; display: inline-flex; gap: 12rpx; }
.icon-option { position: relative; width: 108rpx; height: 112rpx; padding: 11rpx 8rpx 9rpx; display: inline-flex; align-items: center; justify-content: center; flex-direction: column; gap: 5rpx; border: 1rpx solid rgba(93,108,100,.12); border-radius: 21rpx; color: #56645f; background: #fffdf8; font-size: 18rpx; font-weight: 600; transition: border-color 160ms ease, transform 160ms ease, background 160ms ease; }
.icon-option-symbol { width: 55rpx; height: 55rpx; display: flex; align-items: center; justify-content: center; border-radius: 17rpx; color: #35695c; background: #e8f0eb; }
.icon-option-symbol image { width: 39rpx; height: 39rpx; }
.icon-option--blue .icon-option-symbol { color: #496a76; background: #e9f0f2; }
.icon-option--gold .icon-option-symbol { color: #98702f; background: #f7efdf; }
.icon-option--orange .icon-option-symbol { color: #a86436; background: #f8ece3; }
.icon-option--purple .icon-option-symbol { color: #665d77; background: #eeebf2; }
.icon-option.is-selected { border: 2rpx solid rgba(102,143,132,.55); color: #557b71; background: #f5f8f6; box-shadow: 0 7rpx 18rpx rgba(85,127,117,.09); }
.icon-option-check { position: absolute; width: 27rpx; height: 27rpx; top: 7rpx; right: 7rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: var(--color-action-primary); }
.icon-option--pressed { transform: scale(.96); }
.field-block { margin-top: 29rpx; }
.field-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.field-label { color: #35443f; font-size: 24rpx; font-weight: 650; line-height: 34rpx; }
.field-note { color: #929792; font-size: 19rpx; line-height: 28rpx; }
.duration-grid { margin-top: 15rpx; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 11rpx; }
.duration-option { min-height: 64rpx; display: flex; align-items: baseline; justify-content: center; gap: 4rpx; border: 1rpx solid rgba(36,91,77,.17); border-radius: 32rpx; color: #35695c; background: #fffdf8; transition: transform 160ms ease, background 160ms ease; }
.duration-option text:first-child { font-size: 23rpx; font-weight: 700; line-height: 32rpx; }
.duration-option text:last-child { font-size: 17rpx; line-height: 26rpx; }
.duration-option.is-selected { border-color: var(--color-action-primary); color: #fff; background: var(--color-action-primary); box-shadow: 0 7rpx 16rpx rgba(85,127,117,.16); }
.duration-option--pressed { transform: scale(.97); }
.custom-duration-box { min-height: 82rpx; margin-top: 14rpx; padding: 12rpx 14rpx 12rpx 18rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border: 1rpx solid rgba(93,108,100,.12); border-radius: 20rpx; background: #f6f3ec; }
.custom-duration-box.is-active { border-color: rgba(36,91,77,.28); background: #f0f5f1; }
.custom-duration-copy view { color: #4e5b56; font-size: 22rpx; font-weight: 600; line-height: 31rpx; }
.custom-duration-copy text { color: #929792; font-size: 17rpx; line-height: 25rpx; }
.custom-duration-input { width: 176rpx; height: 58rpx; padding: 0 14rpx; display: flex; align-items: center; gap: 7rpx; flex: none; border: 1rpx solid rgba(36,91,77,.15); border-radius: 16rpx; background: #fffdf8; }
.custom-duration-input input { min-width: 0; height: 58rpx; flex: 1; color: #24312d; font-size: 26rpx; font-weight: 650; text-align: right; }
.custom-duration-input text { flex: none; color: #7c817d; font-size: 18rpx; }
.field-hint { margin-top: 13rpx; display: flex; align-items: flex-start; gap: 7rpx; color: #858b87; font-size: 18rpx; line-height: 28rpx; }
.field-hint t-icon { margin-top: 2rpx; flex: none; color: #7f9d91; }
.setting-row, .reminder-time-row { min-height: 104rpx; padding: 17rpx 2rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.setting-row--pressed { opacity: .72; }
.setting-copy { min-width: 0; flex: 1; }
.setting-label { color: #35443f; font-size: 24rpx; font-weight: 650; line-height: 34rpx; }
.setting-description { margin-top: 3rpx; color: #8a8f8b; font-size: 19rpx; line-height: 28rpx; }
.setting-value { display: flex; align-items: center; gap: 5rpx; flex: none; color: var(--color-action-primary-active); font-size: 22rpx; font-weight: 600; }
.setting-divider { height: 1rpx; margin-left: 74rpx; background: rgba(93,108,100,.11); }
.reminder-row { padding-top: 18rpx; padding-bottom: 18rpx; }
.reminder-switch { flex: none; transform: scale(.82); transform-origin: right center; }
.reminder-divider { margin-top: 0; }
.reminder-time-row { padding-left: 74rpx; }
.reminder-time-value { min-width: 126rpx; height: 58rpx; padding: 0 12rpx 0 17rpx; display: flex; align-items: center; justify-content: space-between; gap: 5rpx; flex: none; border-radius: 17rpx; color: var(--color-action-primary-active); background: var(--color-action-soft); font-size: 24rpx; font-weight: 700; }
.bottom-action { position: fixed; z-index: 30; right: 0; bottom: 0; left: 0; padding: 14rpx 32rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid rgba(83,98,90,.1); background: rgba(250,247,239,.95); -webkit-backdrop-filter: blur(18rpx); backdrop-filter: blur(18rpx); }
.save-button { width: 100%; --td-button-primary-bg-color: var(--color-action-primary); --td-button-primary-border-color: var(--color-action-primary); --td-button-primary-active-bg-color: var(--color-action-primary-active); --td-button-border-radius: 44rpx; }
.validation-message { min-height: 34rpx; margin-bottom: 10rpx; display: flex; align-items: center; justify-content: center; gap: 7rpx; color: #a14f45; font-size: 20rpx; line-height: 30rpx; }
.secondary-button { min-width: 220rpx; margin-top: 24rpx; }
.state-card { margin-top: 18vh; padding: 46rpx 30rpx; text-align: center; }
@media (max-width:350px) {
  .edit-page { padding-right: 22rpx; padding-left: 22rpx; }
  .form-section { padding-right: 20rpx; padding-left: 20rpx; }
  .duration-grid { grid-template-columns: repeat(3,minmax(0,1fr)); gap: 8rpx; }
  .duration-option { min-height: 60rpx; }
  .duration-option text:first-child { font-size: 21rpx; }
  .duration-option text:last-child { font-size: 15rpx; }
  .custom-duration-input { width: 154rpx; }
  .bottom-action { padding-right: 22rpx; padding-left: 22rpx; }
}
