<view class="page checkin-page" data-theme="{{appTheme}}">

  <!-- Loading state -->
  <view wx:if="{{status === 'loading'}}" class="card state-card page-state">
    <t-loading size="48rpx" color="#3F8F72" />
    <view class="state-title">正在加载行动记录</view>
    <view class="state-description">稍等一下，马上回来。</view>
  </view>

  <!-- Error state -->
  <view wx:elif="{{status === 'error'}}" class="card state-card page-state">
    <view class="state-mark">!</view>
    <view class="state-title">记录行动遇到问题</view>
    <view class="state-description">{{errorMessage}}</view>
    <view class="error-actions"><t-button class="error-secondary" bindtap="retry">重新加载</t-button><t-button theme="primary" class="growth-primary-button" bindtap="goBackToToday">返回今日页</t-button></view>
  </view>

  <!-- Success state -->
  <view wx:elif="{{status === 'success'}}" class="success-view">
    <view class="success-card growth-component-card">
      <view class="success-mark" aria-label="记录成功"><t-icon name="check" size="50rpx" /></view>
      <view class="success-title">今天的行动已记录</view>
      <view class="success-stats">
        <view class="stat-row">
          <text class="stat-label">今日完成率</text>
          <text class="stat-value">{{resultData.completionRate}}%</text>
        </view>
        <view wx:if="{{resultData.streakDays > 0}}" class="stat-row">
          <text class="stat-label">连续行动</text>
          <text class="stat-value">{{resultData.streakDays}} 天</text>
        </view>
      </view>
      <view class="success-encouragement">{{encouragementText}}</view>
    </view>
    <t-button theme="primary" class="back-home-button" bindtap="goBackToToday">
      返回今日页
    </t-button>
  </view>

  <!-- Ready state: checkin form -->
  <block wx:else>

    <!-- Summary card -->
    <view class="summary-card growth-component-card checkin-hero">
      <view class="section-eyebrow">记录今日行动</view>
      <view class="summary-subtitle">为每项行动选择今天的完成情况。</view>
      <view class="summary-date">{{dateDisplay}}</view>
      <view class="summary-progress">
        <view class="progress-count">
          <text class="progress-count-strong">{{completedCount}}</text>
          <text> / {{totalCount}} 项完成</text>
        </view>
        <view class="progress-rate">{{completionRate}}%</view>
      </view>
      <t-progress percentage="{{completionRate}}" color="#D8A84E" trackColor="rgba(255,255,255,.18)" strokeWidth="{{10}}" />
    </view>

    <!-- Task list with status selectors -->
    <view class="task-status-section">
      <view class="section-title-row">
        <view class="section-title">今日行动</view>
        <view class="section-count">{{totalCount}} 项</view>
      </view>

      <view wx:if="{{totalCount === 0}}" class="card no-task-card">
        <view class="state-mark small-mark">0</view>
        <view class="no-task-title">今天没有安排行动</view>
        <view class="state-description">返回今日页查看行动安排。</view>
        <t-button theme="primary" class="growth-primary-button" bindtap="goBackToToday">返回今日页</t-button>
      </view>

      <view
        wx:for="{{taskItems}}"
        wx:key="id"
        class="task-status-card growth-component-card {{item.currentStatus !== '' ? 'task-status-selected' : ''}}"
      >
        <view class="task-status-header">
          <view class="task-status-title">{{item.title}}</view>
        </view>
        <view wx:if="{{item.description}}" class="task-status-desc">{{item.description}}</view>
        <t-radio-group class="status-radio-group" options="{{item.statusOptions}}" value="{{item.currentStatus}}" data-task-id="{{item.id}}" bindchange="selectTaskStatus" />
      </view>
    </view>

    <!-- Skip reason selector (shown when overallStatus is not completed) -->
    <view wx:if="{{showSkipReason}}" class="reason-card growth-component-card">
      <view class="section-title">今天的主要原因</view>
      <view class="reason-hint">可选，帮助改进后续计划</view>
      <t-radio-group class="reason-radio-group" options="{{skipReasonOptions}}" value="{{skipReason}}" bindchange="selectSkipReason" />
    </view>

    <!-- Feeling selector -->
    <view class="feeling-card growth-component-card">
      <view class="section-title">今天的感受</view>
      <view class="feeling-options-grid">
        <view
          wx:for="{{feelingOptions}}"
          wx:key="value"
          class="feeling-option {{feeling === item.value ? 'feeling-option-active' : ''}} {{feelingBounce === item.value ? 'feeling-option-bounce' : ''}}"
          data-value="{{item.value}}"
          bindtap="selectFeeling"
        >
          <view class="feeling-icon"><t-icon name="{{item.icon}}" size="36rpx" /></view>
          <view class="feeling-label">{{item.label}}</view>
        </view>
      </view>
    </view>

    <!-- Note input -->
    <view class="note-card growth-component-card">
      <view class="note-header">
        <view class="section-title">今日备注</view>
        <view class="note-count">{{noteRemaining}}/100</view>
      </view>
      <view class="note-hint">记录一下今天的想法（可选）</view>
      <t-textarea
        class="note-input"
        placeholder="写点什么..."
        maxlength="{{100}}"
        value="{{note}}"
        bindchange="onNoteInput"
      />
    </view>

    <!-- Submit button -->
    <view class="bottom-action">
      <t-button
        theme="primary"
        class="checkin-button"
        disabled="{{submitting || !canSubmit}}"
        loading="{{submitting}}"
        bindtap="doSubmitCheckin"
      >
        {{submitButtonText}}
      </t-button>
    </view>

  </block>
</view>
