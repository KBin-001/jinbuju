.checkin-page {
  padding-top: 40rpx;
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.page-state {
  margin-top: 80rpx;
}

/* ---- Summary card ---- */

.summary-card {
  margin-bottom: 28rpx;
}

.summary-subtitle {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 28rpx;
  line-height: 1.6;
}

.summary-date {
  margin-top: 18rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.summary-progress {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}

.progress-count {
  color: var(--color-text-secondary);
}

.progress-count-strong {
  color: var(--color-text);
  font-size: 38rpx;
  font-weight: 700;
}

.progress-rate {
  color: var(--color-primary);
  font-size: 42rpx;
  font-weight: 700;
}

.progress-track {
  height: 18rpx;
  margin-top: 22rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e8ece6;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
  transition: width 220ms ease;
}

/* ---- Task status section ---- */

.task-status-section {
  margin-top: 34rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
}

.section-count {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.no-task-card {
  margin-top: 20rpx;
  padding: 44rpx 30rpx;
  text-align: center;
}

.small-mark {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto;
  border-radius: 22rpx;
  font-size: 30rpx;
}

.no-task-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 650;
}

.task-status-card {
  margin-top: 20rpx;
  padding: 28rpx;
  transition: border-color 160ms ease;
}

.task-status-selected {
  border-color: #cfe1d8;
}

.task-status-header {
  display: flex;
  align-items: center;
}

.task-status-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.45;
  color: var(--color-text);
}

.task-status-desc {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.55;
}

.task-status-options {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.status-btn {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-size: 22rpx;
  transition: border-color 160ms ease, background 160ms ease, color 160ms ease;
}

.status-btn-icon {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
}

.status-btn-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
}

/* Active status button colors */
.status-btn-completed.status-active {
  border-color: var(--color-primary);
  background: #edf5f0;
  color: var(--color-primary);
}

.status-btn-partially_completed.status-active {
  border-color: #6b9080;
  background: #f0f5f2;
  color: #6b9080;
}

.status-btn-skipped.status-active {
  border-color: #b8a88a;
  background: #faf6f0;
  color: #8a7a5e;
}

.status-btn-rescheduled.status-active {
  border-color: #7a9eb8;
  background: #f0f5fa;
  color: #5a7e98;
}

/* ---- Skip reason section ---- */

.reason-card {
  margin-top: 28rpx;
}

.reason-card .section-title {
  margin-bottom: 8rpx;
}

.reason-hint {
  color: var(--color-text-secondary);
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.reason-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.reason-btn {
  padding: 14rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 600;
  transition: border-color 160ms ease, background 160ms ease;
}

.reason-btn.reason-active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
  color: var(--color-primary);
}

/* ---- Feeling selector ---- */

.feeling-card {
  margin-top: 28rpx;
}

.feeling-card .section-title {
  margin-bottom: 24rpx;
}

.feeling-options-grid {
  display: flex;
  gap: 20rpx;
}

.feeling-option {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 10rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-surface);
  color: var(--color-text);
  text-align: center;
  transition: border-color 160ms ease, background 160ms ease, transform 200ms ease;
}

.feeling-option-active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.feeling-option-bounce {
  animation: feeling-pop 360ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes feeling-pop {
  0% { transform: scale(0.85); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  .feeling-option-bounce {
    animation: none;
  }
}

/* Calm action journal */
.checkin-page {
  background:
    radial-gradient(circle at 100% 0, rgba(157, 143, 214, 0.1), transparent 30%),
    var(--color-background);
}

.summary-card,
.task-status-card,
.feeling-card,
.reason-card,
.note-card {
  box-shadow: var(--shadow-card);
}

.summary-card {
  background: linear-gradient(145deg, #ffffff, #f4f8f5);
}

.status-btn-active,
.feeling-option-active,
.reason-option-active {
  border-color: var(--color-primary) !important;
  background: var(--color-primary-light) !important;
  box-shadow: 0 0 0 4rpx rgba(53, 104, 89, 0.08);
}

.submit-bar {
  border-top: 1rpx solid var(--color-border);
  background: rgba(246, 248, 243, 0.94);
  box-shadow: 0 -12rpx 36rpx rgba(31, 77, 66, 0.08);
}

.success-card {
  background:
    radial-gradient(circle at 50% 0, rgba(243, 199, 106, 0.24), transparent 38%),
    #ffffff;
}

.status-radio-group,
.reason-radio-group,
.feeling-radio-group {
  display: block;
  margin-top: 18rpx;
}

.feeling-emoji {
  display: block;
  font-size: 36rpx;
  line-height: 1.2;
}

.feeling-label {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
}

/* ---- Note card ---- */

.note-card {
  margin-top: 28rpx;
}

.note-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.note-count {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.note-hint {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.note-input {
  width: 100%;
  min-height: 120rpx;
  margin-top: 18rpx;
  padding: 20rpx 18rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  background: var(--color-background);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 1.6;
}

/* ---- Success view ---- */

.success-view {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 80rpx;
}

.confetti-layer {
  position: absolute;
  top: -40rpx;
  right: 0;
  left: 0;
  height: 300rpx;
  overflow: hidden;
  pointer-events: none;
}

.confetti-piece {
  position: absolute;
  top: -24rpx;
  width: 12rpx;
  height: 22rpx;
  border-radius: 4rpx;
  background: var(--color-primary);
  opacity: 0;
  animation: confetti-fall 1100ms ease-out forwards;
}

.confetti-1 { left: 8%; animation-delay: 40ms; }
.confetti-2 { left: 18%; background: #d5a94e; animation-delay: 150ms; }
.confetti-3 { left: 29%; transform: rotate(28deg); animation-delay: 70ms; }
.confetti-4 { left: 39%; background: #8eb6a8; animation-delay: 210ms; }
.confetti-5 { left: 49%; background: #d5a94e; animation-delay: 10ms; }
.confetti-6 { left: 59%; transform: rotate(45deg); animation-delay: 170ms; }
.confetti-7 { left: 69%; background: #8eb6a8; animation-delay: 90ms; }
.confetti-8 { left: 78%; background: #d5a94e; animation-delay: 230ms; }
.confetti-9 { left: 88%; transform: rotate(24deg); animation-delay: 120ms; }
.confetti-10 { left: 95%; background: #8eb6a8; animation-delay: 260ms; }

@keyframes confetti-fall {
  0% { opacity: 0; transform: translateY(0) rotate(0); }
  15% { opacity: 1; }
  100% { opacity: 0; transform: translateY(270rpx) rotate(260deg); }
}

@media (prefers-reduced-motion: reduce) {
  .confetti-piece {
    display: none;
  }
}

.success-card {
  width: 100%;
  padding: 56rpx 40rpx;
  text-align: center;
}

.success-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 52rpx;
  font-weight: 700;
}

.success-title {
  margin-top: 28rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.success-stats {
  margin-top: 40rpx;
  padding: 28rpx 0;
  border-top: 1rpx solid var(--color-border);
  border-bottom: 1rpx solid var(--color-border);
}

.stat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.stat-label {
  color: var(--color-text-secondary);
  font-size: 28rpx;
}

.stat-value {
  color: var(--color-primary);
  font-size: 34rpx;
  font-weight: 700;
}

.success-encouragement {
  margin-top: 36rpx;
  color: var(--color-text-secondary);
  font-size: 28rpx;
  line-height: 1.6;
}

.back-home-button {
  width: 100%;
  margin-top: 40rpx;
}

/* ---- Bottom action bar ---- */

.bottom-action {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  background: rgba(255, 255, 255, 0.96);
}

.checkin-button {
  width: 100%;
  padding: 26rpx 30rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-weight: 650;
}

.checkin-button[disabled] {
  background: #d9ded8;
  color: #899087;
}
/* Check-in dashboard */
.checkin-page { background: radial-gradient(circle at 100% 8%,rgba(216,168,78,.18),transparent 26%),#edf1ee; }
.checkin-hero { position:relative; overflow:hidden; padding:38rpx; border:0; border-radius:40rpx; background:linear-gradient(145deg,#153f36,#356859); color:#fff; box-shadow:0 22rpx 56rpx rgba(21,63,54,.22); }
.checkin-hero::after { position:absolute; right:-60rpx; bottom:-100rpx; width:250rpx; height:250rpx; border-radius:50%; background:rgba(216,168,78,.16); content:""; }
.checkin-hero .section-eyebrow { color:#e8c97f; }
.checkin-hero .summary-subtitle, .checkin-hero .summary-date, .checkin-hero .progress-count, .checkin-hero .progress-rate { position:relative; z-index:1; color:#fff; }
.task-status-card { border:0; border-left:7rpx solid #5c78d6; border-radius:28rpx; background:linear-gradient(145deg,#fff,#f4f6ff); }
.task-status-card:nth-child(3n+2) { border-left-color:#e67861; background:linear-gradient(145deg,#fff,#fff6f3); }
.task-status-card:nth-child(3n) { border-left-color:#d8a84e; background:linear-gradient(145deg,#fff,#fffaf0); }
.task-status-selected { box-shadow:0 16rpx 40rpx rgba(92,120,214,.16); }
.reason-card { background:linear-gradient(145deg,#fffaf0,#f4e5c4); }
.feeling-card { background:linear-gradient(145deg,#faf8ff,#e8e3fa); }
.note-card { background:linear-gradient(145deg,#fff,#eef4f0); }
.success-card { border:0; background:linear-gradient(145deg,#153f36,#356859); color:#fff; box-shadow:var(--shadow-float); }
.success-card .success-title, .success-card .stat-value { color:#fff; }
.success-card .success-encouragement, .success-card .stat-label { color:rgba(255,255,255,.7); }
