page { background: var(--color-background, #F7F3EA); }
.goal-manage-page { min-height: 100vh; color: var(--color-text-main, #24312D); }
.custom-nav { box-sizing: content-box; height: 88rpx; padding: calc(env(safe-area-inset-top) + 8rpx) 32rpx 0; display: flex; align-items: center; justify-content: space-between; }
.nav-back, .nav-placeholder { width: 64rpx; height: 64rpx; }
.nav-back { display: flex; align-items: center; justify-content: center; border-radius: 50%; color: var(--color-primary, #557F75); }
.nav-title { font-size: 34rpx; font-weight: 700; }
.page-content { padding: 20rpx 32rpx 210rpx; }

.hero-card { position: relative; min-height: 220rpx; overflow: hidden; border: 1rpx solid var(--color-border-soft); border-radius: 32rpx; background: var(--color-card); box-shadow: var(--shadow-card-soft); }
.hero-mountain { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .72; }
.hero-veil { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(255,252,246,.98) 0%, rgba(255,252,246,.9) 52%, rgba(255,252,246,.32) 100%); }
.hero-copy { position: relative; z-index: 1; padding: 34rpx; }
.hero-eyebrow { display: block; color: var(--color-accent); font-size: 22rpx; font-weight: 650; letter-spacing: 2rpx; }
.hero-count-row { margin-top: 10rpx; display: flex; align-items: baseline; }
.hero-title { color: var(--color-primary); font-family: var(--font-family-brand); font-size: 34rpx; font-weight: var(--font-weight-title); }
.hero-count { margin-left: 14rpx; color: var(--color-accent); font-size: 48rpx; line-height: 56rpx; font-weight: 750; }
.hero-unit { margin-left: 6rpx; color: var(--color-text-secondary); font-size: 23rpx; }
.hero-subtitle { max-width: 75%; margin-top: 10rpx; display: block; overflow: hidden; color: var(--color-text-secondary); font-size: 23rpx; line-height: 34rpx; text-overflow: ellipsis; white-space: nowrap; }

.goal-list, .empty-card, .state-card { margin-top: 24rpx; }
.goal-card { position: relative; margin-top: 20rpx; overflow: hidden; border: 1rpx solid var(--color-border-soft); border-radius: 28rpx; background: rgba(255,252,246,.97); box-shadow: var(--shadow-card-soft); }
.goal-card:first-child { margin-top: 0; }
.goal-card--current { border-color: rgba(36,91,77,.22); box-shadow: 0 10rpx 28rpx rgba(36,91,77,.08); }
.goal-card__wash { position: absolute; top: -100rpx; right: -70rpx; width: 250rpx; height: 210rpx; border-radius: 50%; background: radial-gradient(circle, rgba(127,157,145,.15), rgba(127,157,145,0) 68%); }
.goal-head { position: relative; padding: 28rpx 28rpx 0; display: flex; align-items: flex-start; gap: 18rpx; }
.goal-index { width: 58rpx; height: 58rpx; flex: none; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(36,91,77,.13); border-radius: 19rpx; background: var(--color-primary-soft); color: var(--color-primary); font-family: var(--font-family-brand); font-size: 27rpx; font-weight: var(--font-weight-title); }
.goal-info { min-width: 0; flex: 1; }
.goal-title-row { display: flex; align-items: flex-start; gap: 14rpx; }
.goal-title { min-width: 0; flex: 1; display: -webkit-box; overflow: hidden; color: var(--color-text-main); font-size: 30rpx; line-height: 40rpx; font-weight: 700; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.goal-description { margin-top: 6rpx; display: -webkit-box; overflow: hidden; color: var(--color-text-secondary); font-size: 22rpx; line-height: 32rpx; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.status-chip { min-height: 40rpx; padding: 6rpx 15rpx; flex: none; border-radius: 20rpx; background: var(--color-card-soft); color: var(--color-text-secondary); font-size: 20rpx; }
.status-chip--current { background: var(--color-success-soft); color: var(--color-success); }
.goal-progress-copy { margin: 24rpx 28rpx 10rpx 104rpx; display: flex; justify-content: space-between; gap: 16rpx; color: var(--color-text-secondary); font-size: 21rpx; }
.goal-progress-copy text:last-child { color: var(--color-primary); font-weight: 700; }
.progress-track { height: 10rpx; margin: 0 28rpx 0 104rpx; overflow: hidden; border-radius: 5rpx; background: #E5E9E4; }
.progress-fill { height: 100%; border-radius: inherit; background: var(--gradient-progress); }
.goal-facts { margin: 18rpx 28rpx 0 104rpx; display: flex; flex-wrap: wrap; gap: 12rpx 24rpx; color: var(--color-text-secondary); font-size: 21rpx; }
.goal-primary-actions { margin: 24rpx 28rpx 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(150rpx, .62fr); gap: 14rpx; }
.goal-primary, .goal-switch, .current-note { min-height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 36rpx; font-size: 23rpx; font-weight: 650; }
.goal-primary { background: var(--color-action-primary); color: #FFF; }
.goal-switch { border: 1rpx solid rgba(36,91,77,.2); background: var(--color-card); color: var(--color-primary); }
.current-note { gap: 7rpx; background: var(--color-success-soft); color: var(--color-success); }
.goal-secondary-actions { min-height: 74rpx; margin-top: 18rpx; padding: 0 28rpx; display: flex; align-items: center; justify-content: space-between; border-top: 1rpx solid var(--color-divider); color: var(--color-primary); font-size: 22rpx; }
.end-action { color: var(--color-danger); }
.is-disabled { opacity: .45; pointer-events: none; }

.state-card, .empty-card { min-height: 330rpx; padding: 48rpx 36rpx; display: flex; align-items: center; justify-content: center; flex-direction: column; border: 1rpx solid var(--color-border-soft); border-radius: 28rpx; background: var(--color-card); color: var(--color-primary); text-align: center; box-shadow: var(--shadow-card-soft); }
.state-card > text:first-of-type { margin-top: 16rpx; color: var(--color-text-secondary); font-size: 23rpx; }
.state-title { margin-top: 16rpx; color: var(--color-text-main); font-size: 29rpx; font-weight: 700; }
.state-desc, .empty-desc { max-width: 500rpx; margin-top: 10rpx; color: var(--color-text-secondary); font-size: 23rpx; line-height: 36rpx; }
.state-button, .empty-button { min-height: 68rpx; margin-top: 24rpx; padding: 0 30rpx; display: flex; align-items: center; border-radius: 34rpx; background: var(--color-action-primary); color: #FFF; font-size: 24rpx; font-weight: 650; }
.empty-mountain { width: 118rpx; height: 118rpx; }
.empty-title { margin-top: 14rpx; color: var(--color-text-main); font-size: 30rpx; font-weight: 700; }

.bottom-action { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; padding: 28rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background: linear-gradient(180deg, rgba(247,243,234,0), rgba(247,243,234,.96) 32%); }
.primary-button { min-height: 88rpx; margin: 0; display: flex; align-items: center; justify-content: center; gap: 10rpx; border-radius: 44rpx; background: var(--color-action-primary); color: #FFF; font-size: 28rpx; font-weight: 700; box-shadow: var(--shadow-button-primary); }
.tap-pressed, .action-pressed { opacity: .66; }
.primary-button--pressed { opacity: .9; transform: scale(.99); }
@media (max-width: 350px) { .page-content { padding-right: 24rpx; padding-left: 24rpx; } .goal-progress-copy, .progress-track, .goal-facts { margin-left: 28rpx; } .goal-primary-actions { grid-template-columns: 1fr; } }
@media (prefers-reduced-motion: reduce) { .goal-card { animation: none; } }

/* Semantic type roles for goal history and lifecycle actions. */
.nav-title { font-size: var(--font-page-title); line-height: var(--line-height-page-title); }
.hero-title,
.goal-title { font-size: var(--font-card-title); line-height: var(--line-height-card-title); }
.hero-eyebrow,
.status-chip { font-size: var(--font-tag); line-height: var(--line-height-tag); }
.hero-count,
.stat-value { font-size: var(--font-data); line-height: var(--line-height-data); }
.hero-unit,
.hero-subtitle,
.goal-description,
.goal-progress-copy,
.goal-facts,
.state-card > text:first-of-type,
.state-desc,
.empty-desc { font-size: var(--font-caption); line-height: var(--line-height-caption); }
.goal-primary,
.goal-switch,
.current-note,
.goal-secondary-actions,
.state-button,
.empty-button,
.primary-button { font-size: var(--font-body-strong); line-height: var(--line-height-body-strong); }
.state-title,
.empty-title { font-size: var(--font-card-title); line-height: var(--line-height-card-title); }
.hero-unit,
.goal-progress-copy,
.goal-facts { font-size: var(--font-meta); line-height: var(--line-height-meta); }

@media (max-width: 350px) {
  .nav-title { font-size: var(--font-page-title-compact); line-height: var(--line-height-page-title); }
  .hero-title,
  .goal-title,
  .state-title,
  .empty-title { font-size: var(--font-card-title-compact); line-height: var(--line-height-card-title); }
  .hero-subtitle,
  .goal-description,
  .state-card > text:first-of-type,
  .state-desc,
  .empty-desc { font-size: var(--font-caption-compact); line-height: var(--line-height-caption); }
  .hero-count,
  .stat-value { font-size: var(--font-data-compact); line-height: var(--line-height-data); }
  .hero-eyebrow,
  .status-chip { font-size: var(--font-tag-compact); line-height: var(--line-height-tag); }
}
