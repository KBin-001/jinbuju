page { background: #F5F7F2; }
.goal-manage-page { min-height: 100vh; color: #233B34; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
.custom-nav { box-sizing: content-box; height: 88rpx; padding: calc(env(safe-area-inset-top) + 8rpx) 32rpx 0; display: flex; align-items: center; justify-content: space-between; }
.nav-back, .nav-placeholder { width: 64rpx; height: 64rpx; }
.nav-back { display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #1F5B4A; font-size: 58rpx; font-weight: 300; line-height: 1; }
.nav-title { font-size: 34rpx; font-weight: 700; }
.page-content { padding: 24rpx 32rpx 210rpx; }

.hero-card { position: relative; min-height: 178rpx; padding: 32rpx; display: flex; align-items: center; overflow: hidden; border-radius: 28rpx; background: linear-gradient(135deg, #356859, #1F5B4A); box-shadow: 0 16rpx 40rpx rgba(31,70,58,.14); }
.hero-mark { position: relative; z-index: 1; width: 88rpx; height: 88rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(18,66,53,.64); color: #F8D26A; font-size: 34rpx; font-weight: 700; }
.hero-copy { position: relative; z-index: 1; min-width: 0; margin-left: 24rpx; }
.hero-count-row { display: flex; align-items: baseline; }
.hero-title { color: #FFF; font-size: 34rpx; line-height: 42rpx; font-weight: 700; }
.hero-count { margin-left: 16rpx; color: #F8D26A; font-size: 48rpx; line-height: 56rpx; font-weight: 800; }
.hero-subtitle { display: block; margin-top: 10rpx; color: rgba(255,255,255,.78); font-size: 24rpx; line-height: 34rpx; }
.hero-leaf { position: absolute; right: -30rpx; bottom: -38rpx; width: 150rpx; height: 230rpx; border: 18rpx solid rgba(255,255,255,.035); border-radius: 100% 0 100% 0; transform: rotate(24deg); }
.hero-leaf--two { right: 40rpx; bottom: -120rpx; transform: rotate(-22deg) scale(.76); }

.goal-list, .empty-card { margin-top: 36rpx; }
.goal-card, .empty-card { box-sizing: border-box; width: 100%; border-radius: 28rpx; background: #FFF; box-shadow: 0 16rpx 40rpx rgba(31,70,58,.08); }
.goal-card { margin-top: 24rpx; overflow: hidden; }
.goal-card:first-child { margin-top: 0; }
.goal-head { padding: 28rpx 28rpx 0; display: flex; align-items: center; }
.goal-icon { width: 76rpx; height: 76rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #EAF5EF; color: #356859; font-size: 40rpx; font-weight: 800; }
.goal-info { min-width: 0; flex: 1; margin-left: 20rpx; }
.goal-title { display: block; overflow: hidden; color: #233B34; font-size: 30rpx; line-height: 40rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.goal-days { display: block; margin-top: 4rpx; color: #71827A; font-size: 24rpx; line-height: 34rpx; }
.status-chip { height: 40rpx; margin-left: 16rpx; padding: 0 18rpx; display: inline-flex; align-items: center; flex: none; border-radius: 20rpx; background: #F0F3F1; color: #71827A; font-size: 22rpx; }
.status-chip--current { background: #EAF5EF; color: #356859; }
.progress-row { padding: 26rpx 28rpx 28rpx 124rpx; display: flex; align-items: center; }
.progress-track { height: 14rpx; flex: 1; overflow: hidden; border-radius: 7rpx; background: #E6EEE9; }
.progress-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #8EC9AC, #356859); }
.progress-value { width: 78rpx; margin-left: 18rpx; color: #356859; font-size: 28rpx; font-weight: 800; text-align: right; }

.goal-actions { display: flex; align-items: stretch; border-top: 1rpx solid #E6EEE9; }
.goal-action { position: relative; min-width: 0; height: 82rpx; flex: 1; display: flex; align-items: center; justify-content: center; color: #356859; font-size: 23rpx; font-weight: 600; text-align: center; }
.goal-action + .goal-action::before { content: ""; position: absolute; top: 22rpx; bottom: 22rpx; left: 0; width: 1rpx; background: #E6EEE9; }
.goal-action--end { color: #8B665F; }
.goal-action.is-disabled { opacity: .5; pointer-events: none; }

.empty-card { padding: 58rpx 40rpx; display: flex; align-items: center; flex-direction: column; text-align: center; }
.empty-icon { width: 104rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #EAF5EF; color: #356859; font-size: 54rpx; font-weight: 800; }
.empty-title { margin-top: 22rpx; font-size: 30rpx; line-height: 40rpx; font-weight: 700; }
.empty-desc { max-width: 470rpx; margin-top: 10rpx; color: #71827A; font-size: 24rpx; line-height: 36rpx; }
.empty-button { height: 64rpx; margin-top: 28rpx; padding: 0 32rpx; display: flex; align-items: center; border-radius: 32rpx; background: #EAF5EF; color: #356859; font-size: 26rpx; font-weight: 600; }

.bottom-action { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; padding: 32rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background: linear-gradient(180deg, rgba(245,247,242,0), #F5F7F2 32%); }
.primary-button { height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 44rpx; background: #356859; color: #FFF; font-size: 30rpx; font-weight: 700; box-shadow: 0 12rpx 28rpx rgba(31,91,74,.2); }
.primary-plus { margin-right: 8rpx; font-size: 38rpx; font-weight: 400; }
.tap-pressed, .action-pressed { opacity: .66; }
.primary-button--pressed { opacity: .9; transform: scale(.99); }
