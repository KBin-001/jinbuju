<view class="goal-manage-page" data-theme="{{appTheme}}">
  <view class="custom-nav">
    <view class="nav-back" bindtap="goBack" hover-class="tap-pressed" aria-label="返回">‹</view>
    <text class="nav-title">管理目标</text>
    <view class="nav-placeholder"></view>
  </view>

  <view class="page-content">
    <view class="hero-card">
      <view class="hero-mark">芽</view>
      <view class="hero-copy">
        <view class="hero-count-row"><text class="hero-title">进行中的目标</text><text class="hero-count">{{activeGoalCount}}</text></view>
        <text class="hero-subtitle">一次专注一个目标，也允许自己慢慢来。</text>
      </view>
      <view class="hero-leaf hero-leaf--one"></view><view class="hero-leaf hero-leaf--two"></view>
    </view>

    <view wx:if="{{goals.length === 0}}" class="empty-card">
      <view class="empty-icon">◎</view>
      <text class="empty-title">还没有进行中的目标</text>
      <text class="empty-desc">从一个真正想推进的小目标开始，今天先走一小步。</text>
      <view class="empty-button" bindtap="createGoal" hover-class="tap-pressed">创建第一个目标</view>
    </view>

    <view wx:else class="goal-list">
      <view wx:for="{{goals}}" wx:key="id" class="goal-card">
        <view class="goal-head">
          <view class="goal-icon">◎</view>
          <view class="goal-info"><text class="goal-title">{{item.title}}</text><text class="goal-days">已坚持 {{item.days}} 天</text></view>
          <view class="status-chip {{item.isCurrent ? 'status-chip--current' : ''}}">{{item.statusText}}</view>
        </view>
        <view class="progress-row">
          <view class="progress-track"><view class="progress-fill" style="width: {{item.progressPercent}}%;"></view></view>
          <text class="progress-value">{{item.progressPercent}}%</text>
        </view>
        <view class="goal-actions">
          <view class="goal-action" data-id="{{item.id}}" catchtap="openDetail" hover-class="action-pressed">查看详情</view>
          <view class="goal-action" data-id="{{item.id}}" catchtap="viewArchive" hover-class="action-pressed">成长档案</view>
          <view wx:if="{{!item.isCurrent}}" class="goal-action" data-id="{{item.id}}" catchtap="setAsCurrent" hover-class="action-pressed">设为当前</view>
          <view class="goal-action goal-action--end {{endingGoalId === item.id ? 'is-disabled' : ''}}" data-id="{{item.id}}" data-title="{{item.title}}" catchtap="confirmEndGoal" hover-class="action-pressed">{{endingGoalId === item.id ? '正在结束' : '结束目标'}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-action"><view class="primary-button" bindtap="createGoal" hover-class="primary-button--pressed"><text class="primary-plus">＋</text>添加新目标</view></view>
</view>
