<view class="page goal-review-page" data-theme="{{appTheme}}">
  <view wx:if="{{status === 'loading'}}" class="state-card card">
    <view class="loading-dot"></view>
    <view class="state-title">正在整理复盘</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="state-card card">
    <view class="state-mark">!</view>
    <view class="state-title">{{errorMessage}}</view>
    <button class="primary-button" bindtap="backProfile">回到我的</button>
  </view>

  <block wx:else>
    <view class="review-hero">
      <view class="hero-kicker">GOAL REVIEW</view>
      <view class="hero-title">{{goal.title}}</view>
      <view class="hero-date">{{dateRange}}</view>
      <view class="hero-summary">{{summaryText}}</view>
      <view class="hero-chip">{{statusLabel}}</view>
    </view>

    <view class="stat-grid">
      <view wx:for="{{stats}}" wx:key="label" class="stat-card">
        <view class="stat-value">{{item.value}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title">行动完成趋势</view>
      <view wx:if="{{trendDays.length === 0}}" class="empty-note">这段目标还没有形成趋势记录。</view>
      <view wx:else class="trend-chart">
        <view wx:for="{{trendDays}}" wx:key="date" class="trend-item">
          <view class="trend-bar-wrap">
            <view class="trend-bar" style="height: {{item.height}}%;"></view>
          </view>
          <view class="trend-label">{{item.label}}</view>
          <view class="trend-count">{{item.completed}}/{{item.total}}</view>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title">最有价值的行动</view>
      <view wx:if="{{valuableActions.length === 0}}" class="empty-note">暂时没有完成行动，记录本身也会保留下来。</view>
      <view wx:else class="action-list">
        <view wx:for="{{valuableActions}}" wx:key="id" class="action-card">
          <view class="action-title">{{item.title}}</view>
          <view class="action-meta">{{item.dateText}} · {{item.minutesText}}</view>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title">没完成的原因</view>
      <view class="soft-copy">{{reasonSummary}}</view>
    </view>

    <view class="section-card">
      <view class="section-title">下一次改进建议</view>
      <view class="soft-copy">{{suggestion}}</view>
    </view>
  </block>
</view>
