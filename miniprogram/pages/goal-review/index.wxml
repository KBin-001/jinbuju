<view class="goal-review-page" data-theme="{{appTheme}}">
  <view class="custom-nav">
    <view class="nav-back" bindtap="goBack" hover-class="tap-pressed" aria-role="button" aria-label="返回">
      <t-icon name="chevron-left" size="42rpx" />
    </view>
    <text class="nav-title">成长回顾</text>
    <view class="nav-placeholder"></view>
  </view>

  <view class="page-content">
    <view wx:if="{{status === 'loading'}}" class="state-card">
      <t-loading theme="circular" size="48rpx" />
      <text class="state-title">正在整理成长回顾</text>
      <text class="state-desc">正在读取这段目标留下的行动记录</text>
    </view>

    <view wx:elif="{{status === 'error'}}" class="state-card">
      <t-icon name="error-circle" size="54rpx" />
      <text class="state-title">暂时无法读取</text>
      <text class="state-desc">{{errorMessage}}</text>
      <view class="state-actions">
        <view class="state-button" bindtap="retry" hover-class="tap-pressed">重新加载</view>
        <view class="state-link" bindtap="goBack" hover-class="tap-pressed">返回历史目标</view>
      </view>
    </view>

    <block wx:else>
      <view class="review-hero">
        <image class="hero-mountain" src="/assets/profile/goal-mountain-v2.jpg" mode="aspectFill" />
        <view class="hero-veil"></view>
        <view class="hero-content">
          <view class="hero-topline">
            <text class="hero-eyebrow">这一程的回望</text>
            <text class="hero-chip">{{statusLabel}}</text>
          </view>
          <text class="hero-title">{{goal.title}}</text>
          <text class="hero-date">{{dateRange}}</text>

          <view class="review-summary">
            <view class="summary-rate">
              <text class="summary-number">{{completionRate}}</text><text class="summary-unit">%</text>
              <text class="summary-label">行动完成率</text>
            </view>
            <view class="summary-copy">
              <text class="summary-kicker">基于行动记录的小结</text>
              <text class="summary-fact">{{factSummary}}</text>
              <text class="summary-guidance">{{guidanceSummary}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="stat-card">
        <view wx:for="{{stats}}" wx:key="label" class="stat-item">
          <text class="stat-value">{{item.value}}<text class="stat-unit">{{item.unit}}</text></text>
          <text class="stat-label">{{item.label}}</text>
        </view>
      </view>

      <view wx:if="{{!hasReviewEvidence}}" class="evidence-empty">
        <image class="empty-mountain" src="/assets/profile/goal-mountain-v2.jpg" mode="aspectFill" />
        <text class="empty-title">这段目标还没有留下行动记录</text>
        <text class="empty-copy">目标已经完整归档。下一次可以先从一个 15—30 分钟的小行动开始，让复盘有据可循。</text>
      </view>

      <block wx:else>
        <view class="section-card reflection-section">
          <view class="section-head">
            <view>
              <text class="section-eyebrow">亲自写下的记录</text>
              <text class="section-title">行动感受与收获</text>
            </view>
            <text class="section-count">{{reflectionRecords.length}} 条</text>
          </view>
          <view wx:if="{{reflectionRecords.length === 0}}" class="empty-note">这段目标没有留下感受记录。以后完成行动时写下一句话，就能逐渐看见自己的方法与变化。</view>
          <view wx:else class="reflection-list {{reflectionExpanded ? 'reflection-list--expanded' : ''}}">
            <view wx:for="{{visibleReflections}}" wx:key="id" class="reflection-row">
              <view class="reflection-meta"><text>{{item.dateText}}</text><text>{{item.title}}</text></view>
              <text class="reflection-copy">{{item.reflection}}</text>
            </view>
            <view wx:if="{{reflectionRecords.length > 4}}" class="expand-button" bindtap="toggleReflections" hover-class="tap-pressed">
              {{reflectionExpanded ? '收起记录' : '查看全部 ' + reflectionRecords.length + ' 条'}}
              <t-icon name="{{reflectionExpanded ? 'chevron-up' : 'chevron-down'}}" size="28rpx" />
            </view>
          </view>
        </view>

        <view class="section-card">
          <view class="section-head">
            <view>
              <text class="section-eyebrow">按真实投入排序</text>
              <text class="section-title">投入较多的已完成行动</text>
            </view>
            <text class="section-count">最多 4 项</text>
          </view>
          <view wx:if="{{importantActions.length === 0}}" class="empty-note">还没有完整完成的行动；已发生的部分投入仍然保留在统计中。</view>
          <view wx:else class="action-list">
            <view wx:for="{{importantActions}}" wx:key="id" class="action-row">
              <view class="action-index">{{index + 1}}</view>
              <view class="action-main">
                <text class="action-title">{{item.title}}</text>
                <text class="action-date">{{item.dateText}}</text>
              </view>
              <text class="action-minutes">{{item.actualText}}</text>
            </view>
          </view>
        </view>

        <view class="section-card">
          <view class="section-head trend-head">
            <view>
              <text class="section-eyebrow">行动证据</text>
              <text class="section-title">最近有记录的行动日</text>
              <text class="section-subtitle">最多展示 7 个有完成或投入记录的日期</text>
            </view>
          </view>
          <view wx:if="{{trendDays.length === 0}}" class="empty-note">已有行动记录，但还不足以形成可展示的趋势。</view>
          <view wx:else class="trend-list">
            <view wx:for="{{trendDays}}" wx:key="date" class="trend-row">
              <text class="trend-date">{{item.label}}</text>
              <view class="trend-content">
                <view class="trend-line">
                  <text class="trend-name">完成</text>
                  <view class="trend-track"><view class="trend-fill trend-fill--done" style="width: {{item.completedWidth}}%;"></view></view>
                  <text class="trend-value">{{item.completed}} 项</text>
                </view>
                <view class="trend-line">
                  <text class="trend-name">投入</text>
                  <view class="trend-track"><view class="trend-fill trend-fill--time" style="width: {{item.minutesWidth}}%;"></view></view>
                  <text class="trend-value">{{item.minutes}} 分</text>
                </view>
              </view>
            </view>
          </view>
          <text wx:if="{{trendDays.length > 0}}" class="trend-footnote">两条色带分别按各自峰值展示变化，准确数值以右侧文字为准。</text>
        </view>
      </block>

      <view class="next-section">
        <text class="section-eyebrow">带往下一程</text>
        <text class="next-title">把经历变成下一次的起点</text>
        <view class="insight-card">
          <view class="insight-mark"><t-icon name="help-circle" size="34rpx" /></view>
          <view class="insight-content"><text class="insight-title">这次记录到的阻力</text><text class="insight-copy">{{reasonSummary}}</text></view>
        </view>
        <view class="insight-card insight-card--warm">
          <view class="insight-mark"><t-icon name="lightbulb" size="34rpx" /></view>
          <view class="insight-content"><text class="insight-title">下次可以这样开始</text><text class="insight-copy">{{suggestion}}</text></view>
        </view>
        <text class="insight-note">页面中的小结与建议由完成率和行动记录规则生成，不代表 AI 深度分析。</text>
      </view>
    </block>
  </view>
</view>
