<view class="goal-review-page" data-theme="{{appTheme}}">
  <view class="custom-nav">
    <view class="nav-back" bindtap="goBack" hover-class="tap-pressed" aria-label="返回">‹</view>
    <text class="nav-title">成长回顾</text><view class="nav-placeholder"></view>
  </view>

  <view class="page-content">
    <view wx:if="{{status === 'loading'}}" class="state-card"><view class="loading-dot"></view><text class="state-title">正在整理成长回顾</text></view>
    <view wx:elif="{{status === 'error'}}" class="state-card"><view class="state-mark">!</view><text class="state-title">{{errorMessage}}</text><view class="state-button" bindtap="goBack">返回历史数据</view></view>

    <block wx:else>
      <view class="review-hero">
        <view class="hero-kicker">GROWTH REVIEW</view>
        <view class="hero-title-row"><text class="hero-title">{{goal.title}}</text><view class="hero-chip">{{statusLabel}}</view></view>
        <text class="hero-date">{{dateRange}}</text>
        <view class="hero-insight">
          <view class="rate-ring" style="background: conic-gradient(#F8D26A 0% {{completionRate}}%, rgba(255,255,255,.18) {{completionRate}}% 100%);"><view class="rate-inner">{{completionRate}}<text class="rate-unit">%</text></view></view>
          <text class="hero-summary">{{summaryText}}</text>
        </view>
        <view class="hero-leaf hero-leaf--one"></view><view class="hero-leaf hero-leaf--two"></view>
      </view>

      <view class="stat-card">
        <view wx:for="{{stats}}" wx:key="label" class="stat-item"><text class="stat-label">{{item.label}}</text><view class="stat-value">{{item.value}}<text class="stat-unit">{{item.unit}}</text></view></view>
      </view>

      <view class="section-card">
        <view class="section-head">
          <text class="section-title">最近行动趋势</text>
          <view class="legend"><view class="legend-item"><view class="legend-dot legend-dot--done"></view>完成行动</view><view class="legend-item"><view class="legend-dot legend-dot--time"></view>实际投入</view></view>
        </view>
        <view wx:if="{{trendDays.length === 0}}" class="empty-note">这段目标还没有形成可展示的行动趋势，记录本身依然被完整保存。</view>
        <view wx:else class="trend-chart">
          <view wx:for="{{trendDays}}" wx:key="date" class="trend-item">
            <view class="trend-bars"><view class="trend-bar trend-bar--done" style="height: {{item.completedHeight}}%;"></view><view class="trend-bar trend-bar--time" style="height: {{item.minutesHeight}}%;"></view></view>
            <text class="trend-label">{{item.label}}</text><text class="trend-count">{{item.completed}}项 · {{item.minutes}}分</text>
          </view>
        </view>
      </view>

      <view class="section-card">
        <text class="section-title">值得记住的行动</text>
        <view wx:if="{{valuableActions.length === 0}}" class="empty-note">暂时没有已完成行动，但这段经历仍然值得被保存。</view>
        <view wx:else class="action-list">
          <view wx:for="{{valuableActions}}" wx:key="id" class="action-row"><view class="action-check">✓</view><text class="action-title">{{item.title}}</text><text class="action-date">{{item.dateText}}</text><text class="action-minutes">{{item.minutesText}}</text></view>
        </view>
      </view>

      <view class="section-card reflection-section">
        <view class="section-head">
          <view>
            <text class="section-title">行动感受与收获</text>
            <text class="section-subtitle">这些真实记录会成为以后复盘和 AI 建议的依据</text>
          </view>
          <text class="reflection-count">{{reflectionRecords.length}} 条</text>
        </view>
        <view wx:if="{{reflectionRecords.length === 0}}" class="empty-note">这段目标还没有留下感受记录。以后完成行动时写下一句话，就能逐渐看见自己的方法与变化。</view>
        <view wx:else class="reflection-list">
          <view wx:for="{{reflectionRecords}}" wx:key="id" class="reflection-row">
            <view class="reflection-meta"><text>{{item.dateText}}</text><text>{{item.title}}</text></view>
            <text class="reflection-copy">{{item.reflection}}</text>
          </view>
        </view>
      </view>

      <view class="insight-grid">
        <view class="insight-card"><view class="insight-icon">芽</view><text class="insight-title">这次遇到的阻力</text><text class="insight-copy">{{reasonSummary}}</text></view>
        <view class="insight-card insight-card--warm"><view class="insight-icon">光</view><text class="insight-title">下次可以这样开始</text><text class="insight-copy">{{suggestion}}</text></view>
      </view>
    </block>
  </view>
</view>
