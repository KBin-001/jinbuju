page { background: #F5F7F2; }
.goal-review-page { min-height: 100vh; color: #233B34; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
.custom-nav { box-sizing: content-box; height: 88rpx; padding: calc(env(safe-area-inset-top) + 8rpx) 32rpx 0; display: flex; align-items: center; justify-content: space-between; }
.nav-back, .nav-placeholder { width: 64rpx; height: 64rpx; }
.nav-back { display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #1F5B4A; font-size: 58rpx; line-height: 1; }
.nav-title { font-size: 34rpx; font-weight: 700; }
.page-content { padding: 24rpx 32rpx calc(60rpx + env(safe-area-inset-bottom)); }

.review-hero { position: relative; padding: 32rpx; overflow: hidden; border-radius: 28rpx; background: linear-gradient(135deg, #356859, #1F5B4A); box-shadow: 0 16rpx 40rpx rgba(31,70,58,.14); }
.hero-kicker { position: relative; z-index: 1; color: #91C8AC; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }
.hero-title-row { position: relative; z-index: 1; margin-top: 12rpx; display: flex; align-items: center; }
.hero-title { min-width: 0; overflow: hidden; color: #FFF; font-size: 40rpx; line-height: 50rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.hero-chip { height: 40rpx; margin-left: 16rpx; padding: 0 16rpx; display: flex; align-items: center; flex: none; border-radius: 20rpx; background: rgba(234,245,239,.94); color: #356859; font-size: 21rpx; }
.hero-date { position: relative; z-index: 1; display: block; margin-top: 8rpx; color: rgba(255,255,255,.76); font-size: 23rpx; }
.hero-insight { position: relative; z-index: 1; margin-top: 26rpx; display: flex; align-items: center; }
.rate-ring { width: 112rpx; height: 112rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; }
.rate-inner { width: 86rpx; height: 86rpx; display: flex; align-items: baseline; justify-content: center; border-radius: 50%; background: #286352; color: #F8D26A; font-size: 32rpx; line-height: 86rpx; font-weight: 800; }
.rate-unit { margin-left: 2rpx; font-size: 18rpx; }
.hero-summary { max-width: 460rpx; margin-left: 24rpx; color: rgba(255,255,255,.88); font-size: 25rpx; line-height: 38rpx; }
.hero-leaf { position: absolute; right: -30rpx; bottom: -38rpx; width: 150rpx; height: 230rpx; border: 18rpx solid rgba(255,255,255,.035); border-radius: 100% 0 100% 0; transform: rotate(24deg); }
.hero-leaf--two { right: 40rpx; bottom: -120rpx; transform: rotate(-22deg) scale(.76); }

.stat-card { margin-top: 24rpx; padding: 26rpx 10rpx; display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); border-radius: 28rpx; background: #FFF; box-shadow: 0 16rpx 40rpx rgba(31,70,58,.08); }
.stat-item { position: relative; min-width: 0; text-align: center; }
.stat-item + .stat-item::before { content: ""; position: absolute; top: 5rpx; bottom: 5rpx; left: 0; width: 1rpx; background: #E6EEE9; }
.stat-label { color: #71827A; font-size: 21rpx; }
.stat-value { margin-top: 10rpx; color: #1F5B4A; font-size: 32rpx; font-weight: 800; white-space: nowrap; }
.stat-unit { margin-left: 4rpx; color: #71827A; font-size: 18rpx; font-weight: 400; }

.section-card { margin-top: 24rpx; padding: 28rpx; border-radius: 28rpx; background: #FFF; box-shadow: 0 16rpx 40rpx rgba(31,70,58,.08); }
.section-head { display: flex; align-items: flex-start; justify-content: space-between; }
.section-title { font-size: 30rpx; line-height: 40rpx; font-weight: 700; }
.legend { display: flex; align-items: center; gap: 14rpx; color: #71827A; font-size: 18rpx; }
.legend-item { display: flex; align-items: center; }
.legend-dot { width: 14rpx; height: 14rpx; margin-right: 5rpx; display: inline-block; border-radius: 3rpx; }
.legend-dot--done { background: #356859; }.legend-dot--time { background: #B8DDC9; }
.trend-chart { height: 240rpx; margin-top: 26rpx; display: grid; grid-template-columns: repeat(7,minmax(0,1fr)); gap: 9rpx; align-items: end; }
.trend-item { min-width: 0; display: flex; align-items: center; flex-direction: column; }
.trend-bars { width: 100%; height: 154rpx; display: flex; align-items: flex-end; justify-content: center; gap: 5rpx; border-bottom: 1rpx solid #E6EEE9; }
.trend-bar { width: 17rpx; min-height: 0; border-radius: 8rpx 8rpx 0 0; }
.trend-bar--done { background: #356859; }.trend-bar--time { background: #B8DDC9; }
.trend-label { margin-top: 8rpx; color: #71827A; font-size: 18rpx; }
.trend-count { margin-top: 4rpx; color: #233B34; font-size: 16rpx; white-space: nowrap; }
.empty-note { margin-top: 22rpx; padding: 24rpx; border-radius: 22rpx; background: #F7FAF8; color: #71827A; font-size: 24rpx; line-height: 36rpx; }

.action-list { margin-top: 18rpx; }
.action-row { min-height: 70rpx; display: flex; align-items: center; border-bottom: 1rpx solid #E6EEE9; }
.action-row:last-child { border-bottom: 0; }
.action-check { width: 34rpx; height: 34rpx; flex: none; display: flex; align-items: center; justify-content: center; border: 2rpx solid #356859; border-radius: 50%; color: #356859; font-size: 20rpx; font-weight: 700; }
.action-title { min-width: 0; margin-left: 14rpx; overflow: hidden; flex: 1; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.action-date { margin-left: 12rpx; color: #71827A; font-size: 19rpx; }.action-minutes { width: 86rpx; margin-left: 12rpx; color: #71827A; font-size: 20rpx; text-align: right; }

.section-subtitle { display: block; margin-top: 8rpx; color: #7C817D; font-size: 20rpx; line-height: 30rpx; }
.reflection-count { flex: none; margin-left: 20rpx; padding: 7rpx 15rpx; border-radius: 18rpx; background: #EDF4F0; color: #527466; font-size: 19rpx; }
.reflection-list { margin-top: 18rpx; }
.reflection-row { padding: 22rpx 0; border-bottom: 1rpx solid #E6EEE9; }
.reflection-row:last-child { padding-bottom: 0; border-bottom: 0; }
.reflection-meta { display: flex; align-items: center; gap: 14rpx; color: #7C817D; font-size: 19rpx; }
.reflection-meta text:last-child { min-width: 0; overflow: hidden; color: #486159; text-overflow: ellipsis; white-space: nowrap; }
.reflection-copy { display: block; margin-top: 11rpx; padding: 17rpx 19rpx; border-left: 5rpx solid #C89B4A; border-radius: 0 16rpx 16rpx 0; background: #F8F6EF; color: #3F4F49; font-size: 23rpx; line-height: 36rpx; }

.insight-grid { margin-top: 24rpx; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20rpx; }
.insight-card { position: relative; padding: 28rpx; overflow: hidden; border: 1rpx solid #D7E8DF; border-radius: 28rpx; background: #EFF8F3; }
.insight-card--warm { background: #FFF9E8; border-color: #F0E4BB; }
.insight-icon { width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #7DBB98; color: #FFF; font-size: 20rpx; }
.insight-card--warm .insight-icon { background: #F8D26A; color: #5D531E; }
.insight-title { display: block; margin-top: 15rpx; color: #1F5B4A; font-size: 26rpx; font-weight: 700; }
.insight-copy { display: block; margin-top: 12rpx; color: #526A61; font-size: 22rpx; line-height: 34rpx; }

.state-card { min-height: 360rpx; padding: 50rpx; display: flex; align-items: center; justify-content: center; flex-direction: column; border-radius: 28rpx; background: #FFF; box-shadow: 0 16rpx 40rpx rgba(31,70,58,.08); text-align: center; }
.loading-dot, .state-mark { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #EAF5EF; color: #356859; font-size: 32rpx; }
.loading-dot::after { content: ""; width: 16rpx; height: 16rpx; border-radius: 50%; background: #356859; }
.state-title { margin-top: 20rpx; color: #71827A; font-size: 26rpx; line-height: 38rpx; }
.state-button { height: 64rpx; margin-top: 28rpx; padding: 0 32rpx; display: flex; align-items: center; border-radius: 32rpx; background: #356859; color: #FFF; font-size: 25rpx; font-weight: 600; }
.tap-pressed { opacity: .66; }
