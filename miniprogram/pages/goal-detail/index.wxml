<view class="page goal-detail-page">
  <view wx:if="{{status === 'loading'}}" class="state-card card">
    <view class="loading-dot"></view>
    <view class="state-title">正在读取目标</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="state-card card">
    <view class="state-mark">!</view>
    <view class="state-title">{{errorMessage}}</view>
    <button class="primary-button" bindtap="retry">重试</button>
  </view>

  <block wx:else>
    <view class="detail-hero">
      <view class="hero-kicker">GOAL DETAIL</view>
      <view class="hero-title">{{goal.title}}</view>
      <view class="hero-subtitle">每日行动 · 见证成长</view>
      <view class="hero-progress">
        <view class="hero-progress-copy">
          <text>当前进度</text>
          <text>{{progressPercent}}%</text>
        </view>
        <view class="progress-bar">
          <view class="progress-bar-inner" style="width: {{progressPercent}}%;"></view>
        </view>
      </view>
    </view>

    <view class="stat-grid">
      <view wx:for="{{statItems}}" wx:key="label" class="stat-card">
        <view class="stat-value">{{item.value}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
    </view>

    <view class="action-row">
      <button wx:if="{{!isCurrentGoal}}" class="secondary-button compact-action" bindtap="setAsCurrentGoal">设为当前目标</button>
      <button class="secondary-button compact-action" bindtap="addAction">添加行动</button>
      <button class="secondary-button compact-action" bindtap="openReview">复盘入口</button>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view class="section-title">每日行动记录</view>
        <view class="section-count">{{dailyActions.length}} 条</view>
      </view>
      <view wx:if="{{dailyActions.length === 0}}" class="empty-note">还没有行动记录，可以先添加今天的一小步。</view>
      <view wx:else class="record-list">
        <view wx:for="{{dailyActions}}" wx:key="id" class="record-card">
          <view class="record-head">
            <view class="record-title">{{item.title}}</view>
            <view class="status-chip {{item.statusTone}}">{{item.statusLabel}}</view>
          </view>
          <view class="record-meta">{{item.dateText}} · 预计 {{item.estimatedMinutes}} 分钟 · 实际 {{item.actualText}}</view>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view class="section-title">历史完成记录</view>
        <view class="section-count">{{completedActions.length}} 条</view>
      </view>
      <view wx:if="{{completedActions.length === 0}}" class="empty-note">完成行动后，这里会沉淀你的完成记录。</view>
      <view wx:else class="record-list">
        <view wx:for="{{completedActions}}" wx:key="id" class="record-card done-card">
          <view class="record-title">{{item.title}}</view>
          <view class="record-meta">{{item.dateText}} · 实际 {{item.actualText}}</view>
        </view>
      </view>
    </view>

    <view class="danger-actions">
      <button class="secondary-button" loading="{{lifecycleSubmitting}}" disabled="{{lifecycleSubmitting}}" bindtap="replaceGoal">更换目标</button>
      <button class="danger-button" loading="{{lifecycleSubmitting}}" disabled="{{lifecycleSubmitting}}" bindtap="endGoal">终止目标</button>
    </view>
  </block>
</view>
