<view class="page goal-detail-page" data-theme="{{appTheme}}">
  <view class="page-content">
    <view wx:if="{{status === 'loading'}}" class="state-card">
      <t-loading theme="circular" size="48rpx" />
      <text class="state-title">正在读取目标</text>
      <text class="state-desc">正在整理你的行动与投入记录</text>
    </view>

    <view wx:elif="{{status === 'error'}}" class="state-card">
      <t-icon name="error-circle" size="54rpx" />
      <text class="state-title">暂时无法读取</text>
      <text class="state-desc">{{errorMessage}}</text>
      <view class="state-button" hover-class="tap-pressed" bindtap="retry">重新加载</view>
    </view>

    <block wx:else>
      <view class="detail-hero">
        <image class="hero-mountain" src="/assets/profile/goal-mountain-v2.jpg" mode="aspectFill" />
        <view class="hero-veil"></view>
        <view class="hero-content">
          <view class="hero-status-row">
            <text class="hero-eyebrow">这一程的目标</text>
            <text class="goal-status {{isCurrentGoal ? 'goal-status--current' : ''}}">{{isCurrentGoal ? '当前目标' : '进行中'}}</text>
          </view>
          <text class="hero-title">{{goal.title}}</text>
          <text class="hero-description">{{goal.description || '把长期目标拆成每天可以完成的一小步。'}}</text>

          <view class="hero-progress-copy">
            <text>{{progressText}}</text>
            <text>行动完成率 {{progressPercent}}%</text>
          </view>
          <view class="progress-track">
            <view class="progress-fill" style="width: {{progressPercent}}%;"></view>
          </view>
        </view>
      </view>

      <view class="rhythm-card">
        <view class="section-heading">
          <view>
            <text class="section-kicker">投入与节奏</text>
            <text class="section-title">每一步，都有记录</text>
          </view>
          <text class="section-note">数据来自真实行动</text>
        </view>
        <view class="stat-grid">
          <view wx:for="{{statItems}}" wx:key="label" class="stat-item">
            <text class="stat-value">{{item.value}}</text>
            <text class="stat-label">{{item.label}}</text>
          </view>
        </view>
      </view>

      <view class="quick-actions">
        <view class="primary-action" hover-class="primary-action--pressed" bindtap="addAction">
          <t-icon name="add" size="34rpx" />
          <text>添加行动</text>
        </view>
        <view wx:if="{{!isCurrentGoal}}" class="secondary-action" hover-class="tap-pressed" bindtap="setAsCurrentGoal">设为当前目标</view>
        <view wx:else class="secondary-action" hover-class="tap-pressed" bindtap="viewProgress">查看成长数据</view>
      </view>

      <view class="record-section">
        <view class="section-heading section-heading--records">
          <view>
            <text class="section-kicker">行动足迹</text>
            <text class="section-title">最近行动</text>
          </view>
          <view class="records-link" bindtap="viewAllActions" hover-class="tap-pressed">查看全部<t-icon name="chevron-right" size="27rpx" /></view>
        </view>

        <view wx:if="{{actionRecords.length === 0}}" class="empty-record">
          <image class="empty-mountain" src="/assets/profile/goal-mountain-v2.jpg" mode="aspectFill" />
          <text class="empty-title">还没有行动记录</text>
          <text class="empty-desc">先安排一个容易完成的小行动，让目标真正开始。</text>
          <view class="empty-button" hover-class="tap-pressed" bindtap="addAction">添加第一个行动</view>
        </view>

        <view wx:else class="record-list">
          <view wx:for="{{actionRecords}}" wx:key="id" class="record-item">
            <view class="record-marker {{item.statusTone}}"></view>
            <view class="record-content">
              <view class="record-head">
                <text class="record-title">{{item.title}}</text>
                <text class="record-status {{item.statusTone}}">{{item.statusLabel}}</text>
              </view>
              <text class="record-meta">{{item.dateText}} · 预计 {{item.estimatedMinutes}} 分钟 · 实际 {{item.actualText}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="management-card">
        <text class="section-kicker">目标管理</text>
        <text class="management-title">需要调整这一程？</text>
        <text class="management-desc">更换或结束目标时，已有行动和投入记录都会完整保留在历史目标中。</text>
        <view class="management-actions">
          <view class="management-button" hover-class="tap-pressed" bindtap="replaceGoal">更换目标</view>
          <view class="management-button management-button--danger {{lifecycleSubmitting ? 'is-disabled' : ''}}" hover-class="tap-pressed" bindtap="endGoal">结束目标</view>
        </view>
      </view>
    </block>
  </view>
</view>
