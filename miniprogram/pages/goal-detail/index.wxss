page { background: var(--color-background, #F7F3EA); }
.goal-detail-page { min-height: 100vh; color: var(--color-text-main, #24312D); }
.page-content { padding: 24rpx 32rpx calc(64rpx + env(safe-area-inset-bottom)); }

.detail-hero { position: relative; min-height: 390rpx; overflow: hidden; border: 1rpx solid var(--color-border-soft); border-radius: 32rpx; background: var(--color-card); box-shadow: var(--shadow-card-soft); }
.hero-mountain { position: absolute; right: 0; bottom: 0; width: 100%; height: 100%; opacity: .78; }
.hero-veil { position: absolute; inset: 0; background: linear-gradient(115deg, rgba(255,252,246,.99) 0%, rgba(255,252,246,.94) 54%, rgba(255,252,246,.3) 100%); }
.hero-content { position: relative; z-index: 1; padding: 34rpx; }
.hero-status-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.hero-eyebrow, .section-kicker { display: block; color: var(--color-accent, #C89B4A); font-size: 21rpx; line-height: 30rpx; font-weight: 650; letter-spacing: 2rpx; }
.goal-status { min-height: 40rpx; padding: 5rpx 16rpx; flex: none; border-radius: 20rpx; background: var(--color-card-soft); color: var(--color-text-secondary); font-size: 20rpx; line-height: 30rpx; }
.goal-status--current { background: var(--color-success-soft); color: var(--color-success); }
.hero-title { max-width: 82%; margin-top: 24rpx; display: -webkit-box; overflow: hidden; color: var(--color-primary, #557F75); font-family: "Songti SC", STSong, serif; font-size: 42rpx; line-height: 54rpx; font-weight: 700; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.hero-description { max-width: 78%; margin-top: 10rpx; display: -webkit-box; overflow: hidden; color: var(--color-text-secondary, #7C817D); font-size: 23rpx; line-height: 34rpx; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.hero-progress-copy { max-width: 82%; margin-top: 34rpx; display: flex; justify-content: space-between; gap: 20rpx; color: var(--color-text-secondary); font-size: 22rpx; }
.hero-progress-copy text:last-child { color: var(--color-primary); font-size: 25rpx; font-weight: 750; }
.progress-track { width: 82%; height: 10rpx; margin-top: 12rpx; overflow: hidden; border-radius: 5rpx; background: rgba(127,157,145,.2); }
.progress-fill { height: 100%; border-radius: inherit; background: var(--gradient-progress); }

.rhythm-card, .record-section, .management-card, .state-card { margin-top: 24rpx; border: 1rpx solid var(--color-border-soft); border-radius: 28rpx; background: var(--color-card, #FFFCF6); box-shadow: var(--shadow-card-soft); }
.rhythm-card, .record-section, .management-card { padding: 30rpx; }
.section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }
.section-title { margin-top: 6rpx; display: block; color: var(--color-text-main); font-family: "Songti SC", STSong, serif; font-size: 30rpx; line-height: 40rpx; font-weight: 700; }
.section-note { flex: none; color: var(--color-text-tertiary, #969A96); font-size: 20rpx; }
.records-link { min-height: 56rpx; display: flex; align-items: center; color: var(--color-primary); font-size: 21rpx; font-weight: 650; }
.stat-grid { margin-top: 26rpx; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1rpx solid var(--color-divider); border-left: 1rpx solid var(--color-divider); }
.stat-item { min-height: 116rpx; padding: 22rpx; display: flex; justify-content: center; flex-direction: column; border-right: 1rpx solid var(--color-divider); border-bottom: 1rpx solid var(--color-divider); background: rgba(247,243,234,.34); }
.stat-item:nth-child(1) { border-top-left-radius: 18rpx; }
.stat-item:nth-child(2) { border-top-right-radius: 18rpx; }
.stat-item:nth-child(3) { border-bottom-left-radius: 18rpx; }
.stat-item:nth-child(4) { border-bottom-right-radius: 18rpx; }
.stat-value { overflow: hidden; color: var(--color-primary); font-size: 28rpx; line-height: 38rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.stat-label { margin-top: 6rpx; color: var(--color-text-secondary); font-size: 21rpx; }

.quick-actions { margin-top: 24rpx; display: grid; grid-template-columns: 1.15fr 1fr; gap: 16rpx; }
.primary-action, .secondary-action { min-height: 82rpx; display: flex; align-items: center; justify-content: center; border-radius: 41rpx; font-size: 25rpx; font-weight: 700; }
.primary-action { gap: 8rpx; background: var(--color-action-primary); color: #FFF; box-shadow: var(--shadow-button-primary); }
.secondary-action { border: 1rpx solid rgba(36,91,77,.2); background: var(--color-card); color: var(--color-primary); }
.primary-action--pressed { opacity: .9; transform: scale(.99); }

.section-heading--records { align-items: center; }
.record-list { margin-top: 24rpx; }
.record-item { position: relative; min-height: 94rpx; padding: 22rpx 0 22rpx 34rpx; display: flex; border-top: 1rpx solid var(--color-divider); }
.record-item:first-child { border-top: 0; }
.record-marker { position: absolute; top: 31rpx; left: 2rpx; width: 14rpx; height: 14rpx; border: 4rpx solid rgba(36,91,77,.12); border-radius: 50%; background: var(--color-primary); }
.record-marker.success { background: var(--color-success); }
.record-marker.warning { background: var(--color-warning, #C89B4A); }
.record-marker.muted { background: var(--color-text-tertiary, #969A96); }
.record-content { min-width: 0; flex: 1; }
.record-head { display: flex; align-items: flex-start; gap: 16rpx; }
.record-title { min-width: 0; flex: 1; display: -webkit-box; overflow: hidden; color: var(--color-text-main); font-size: 26rpx; line-height: 36rpx; font-weight: 650; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.record-status { min-height: 36rpx; padding: 3rpx 13rpx; flex: none; border-radius: 18rpx; background: var(--color-primary-soft); color: var(--color-primary); font-size: 19rpx; line-height: 30rpx; }
.record-status.success { background: var(--color-success-soft); color: var(--color-success); }
.record-status.warning { background: var(--color-warning-soft, #F7EEDB); color: var(--color-warning, #9A732E); }
.record-status.muted { background: var(--color-card-soft); color: var(--color-text-secondary); }
.record-meta { margin-top: 8rpx; display: block; color: var(--color-text-secondary); font-size: 21rpx; line-height: 32rpx; }

.empty-record { padding: 34rpx 20rpx 14rpx; display: flex; align-items: center; flex-direction: column; text-align: center; }
.empty-mountain { width: 130rpx; height: 94rpx; border-radius: 50%; opacity: .72; }
.empty-title { margin-top: 14rpx; color: var(--color-text-main); font-size: 27rpx; font-weight: 700; }
.empty-desc { max-width: 460rpx; margin-top: 8rpx; color: var(--color-text-secondary); font-size: 22rpx; line-height: 34rpx; }
.empty-button { min-height: 66rpx; margin-top: 20rpx; padding: 0 28rpx; display: flex; align-items: center; border-radius: 33rpx; background: var(--color-action-primary); color: #FFF; font-size: 23rpx; font-weight: 650; }

.management-card { background: rgba(255,252,246,.72); box-shadow: none; }
.management-title { margin-top: 8rpx; display: block; color: var(--color-text-main); font-size: 27rpx; font-weight: 700; }
.management-desc { margin-top: 8rpx; display: block; color: var(--color-text-secondary); font-size: 22rpx; line-height: 34rpx; }
.management-actions { margin-top: 22rpx; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.management-button { min-height: 68rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(36,91,77,.18); border-radius: 34rpx; color: var(--color-primary); font-size: 23rpx; font-weight: 650; }
.management-button--danger { border-color: rgba(164,91,79,.22); color: var(--color-danger, #A45B4F); }

.state-card { min-height: 360rpx; padding: 48rpx 36rpx; display: flex; align-items: center; justify-content: center; flex-direction: column; color: var(--color-primary); text-align: center; }
.state-title { margin-top: 18rpx; color: var(--color-text-main); font-size: 29rpx; font-weight: 700; }
.state-desc { max-width: 480rpx; margin-top: 10rpx; color: var(--color-text-secondary); font-size: 22rpx; line-height: 34rpx; }
.state-button { min-height: 68rpx; margin-top: 24rpx; padding: 0 30rpx; display: flex; align-items: center; border-radius: 34rpx; background: var(--color-action-primary); color: #FFF; font-size: 24rpx; font-weight: 650; }
.tap-pressed { opacity: .66; }
.is-disabled { opacity: .45; pointer-events: none; }

@media (max-width: 350px) {
  .page-content { padding-right: 24rpx; padding-left: 24rpx; }
  .hero-title, .hero-description, .hero-progress-copy, .progress-track { max-width: 94%; width: 94%; }
  .quick-actions, .management-actions { grid-template-columns: 1fr; }
}

@media (prefers-reduced-motion: reduce) {
  .primary-action--pressed { transform: none; }
}
.stage-card { margin-top: 24rpx; padding: 28rpx; border: 1rpx solid var(--color-border-soft); border-radius: var(--radius-card); background: var(--color-bg-card); }
.milestone-list { margin-top: 22rpx; border-top: 1rpx solid var(--color-divider); }
.milestone-row { min-height: 86rpx; display: flex; align-items: center; gap: 14rpx; border-bottom: 1rpx solid var(--color-divider); }
.milestone-marker { width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-gold-soft); color: var(--color-gold); }
.milestone-marker.is-complete { background: var(--color-success-soft); color: var(--color-success); }
.milestone-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; }.milestone-copy text:first-child { color: var(--color-text-main); font-size: 26rpx; }.milestone-copy text:last-child { margin-top: 3rpx; color: var(--color-text-secondary); font-size: 21rpx; }
.milestone-status { color: var(--color-warning); font-size: 21rpx; }.milestone-status.is-complete { color: var(--color-success); }
.milestone-empty { margin-top: 18rpx; padding: 18rpx 20rpx; border-radius: var(--radius-input); background: var(--color-surface-soft); color: var(--color-text-secondary); font-size: 23rpx; line-height: 1.55; }
