.goal-detail-page {
  background: #F6FAF7;
  color: #244C43;
}

.detail-hero {
  padding: 34rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #E6F4EC 0%, #F7FBF8 60%, #FFFFFF 100%);
  color: #244C43;
  box-shadow: 0 8rpx 24rpx rgba(36, 88, 74, 0.08);
}

.hero-kicker {
  color: #F4C95D;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.hero-subtitle {
  margin-top: 10rpx;
  color: #6F827B;
  font-size: 25rpx;
}

.hero-progress {
  margin-top: 32rpx;
}

.hero-progress-copy {
  display: flex;
  justify-content: space-between;
  margin-bottom: 14rpx;
  color: #244C43;
  font-size: 24rpx;
  font-weight: 700;
}

.progress-bar {
  height: 16rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: rgba(63, 143, 114, 0.16);
}

.progress-bar-inner {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #7CC6A0 0%, #3F8F72 100%);
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.stat-card,
.section-card {
  border: 1rpx solid #E2EEE8;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(36, 88, 74, 0.08);
}

.stat-card {
  min-height: 128rpx;
  padding: 24rpx;
}

.stat-value {
  color: #244C43;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.stat-label {
  margin-top: 8rpx;
  color: #6F827B;
  font-size: 23rpx;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.compact-action {
  min-width: 0;
  min-height: 68rpx;
  flex: 1;
  padding: 0 22rpx;
  border-radius: 34rpx;
  font-size: 24rpx;
}

.section-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title {
  color: #244C43;
  font-size: 30rpx;
  font-weight: 800;
}

.section-count {
  color: #6F827B;
  font-size: 23rpx;
}

.empty-note {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  background: #F8FBF9;
  color: #6F827B;
  font-size: 25rpx;
  line-height: 36rpx;
  text-align: center;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 22rpx;
}

.record-card {
  padding: 22rpx;
  border: 1rpx solid #E2EEE8;
  border-radius: 22rpx;
  background: #FFFFFF;
}

.done-card {
  background: #FBFCFA;
}

.record-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.record-title {
  min-width: 0;
  flex: 1;
  color: #244C43;
  font-size: 27rpx;
  font-weight: 750;
  line-height: 38rpx;
}

.record-meta {
  margin-top: 10rpx;
  color: #6F827B;
  font-size: 23rpx;
  line-height: 34rpx;
}

.status-chip {
  height: 40rpx;
  display: inline-flex;
  align-items: center;
  flex: none;
  padding: 0 18rpx;
  border-radius: 20rpx;
  background: #E6F4EC;
  color: #3F8F72;
  font-size: 22rpx;
  font-weight: 700;
}

.status-chip.warning {
  background: #FFF4D8;
  color: #8A6B1F;
}

.status-chip.muted {
  background: #F1F4F2;
  color: #6F827B;
}

.status-chip.neutral {
  background: #E8F1FB;
  color: #4A6E97;
}

.danger-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.secondary-button,
.danger-button {
  min-width: 0;
  margin-top: 0;
}
