/* ─── Page shell ─────────────────────────────────────────────────── */

.goal-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(circle at 90% 8%, rgba(216,168,78,.14), transparent 26%),
    linear-gradient(180deg, #153f36 0, #285f51 240rpx, #F5F7F2 240rpx);
}

/* ─── Header ────────────────────────────────────────────────────── */

.goal-header {
  flex-shrink: 0;
  height: calc(104rpx + env(safe-area-inset-top));
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: env(safe-area-inset-top) 28rpx 20rpx;
}
.back-button, .header-placeholder { width: 72rpx; height: 64rpx; }
.back-button { display: flex; align-items: center; justify-content: center; font-size: 52rpx; }
.header-center { text-align: center; }
.header-title { font-size: 30rpx; font-weight: 650; }
.step-text { margin-top: 4rpx; color: rgba(255,255,255,.7); font-size: 22rpx; }

.creator-hero {
  margin: 0 24rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(255,255,255,.12);
  border-radius: 28rpx;
  background: rgba(255,255,255,.08);
  color: #fff;
}
.creator-hero .back-button,
.creator-hero .header-title,
.creator-hero .step-text { color: #fff; }

/* ─── Steps (顶部进度条) ─────────────────────────────────────────── */

.goal-steps {
  flex-shrink: 0;
  margin: 10rpx 32rpx 0;
  padding: 10rpx 24rpx 8rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,.96);
  box-shadow: 0 8rpx 24rpx rgba(21,63,54,.10);
}
.goal-steps .ant-steps-item-horizontal {
  margin: 0;
  padding: 0 12rpx;
}
.goal-steps .ant-steps-item-indicator-horizontal {
  margin: 4rpx 0;
}
.goal-steps .ant-steps-item-horizontal::after {
  top: 18rpx;
}
.goal-steps .ant-steps-item-horizontal .ant-steps-item-title {
  font-size: 22rpx;
  line-height: 30rpx;
}

/* ─── States ────────────────────────────────────────────────────── */

.goal-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  text-align: center;
}

/* ─── Form scroll area ──────────────────────────────────────────── */

.form-scroll {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

/* ─── Step sections ─────────────────────────────────────────────── */

.step-section {
  margin: 24rpx 24rpx 0;
  padding: 36rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255,255,255,.96);
  box-shadow: 0 8rpx 28rpx rgba(21,63,54,.08);
}
.step-section-intro { margin-bottom: calc(160rpx + env(safe-area-inset-bottom)); }

.step-title { font-size: 42rpx; font-weight: 700; line-height: 1.35; color: #153f36; }
.step-subtitle { margin: 14rpx 0 32rpx; color: var(--color-text-secondary); line-height: 1.6; }

.growth-kicker {
  display: inline-flex;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-primary-light);
  color: #7567c8;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.step-lead {
  max-width: 620rpx;
  margin-top: 18rpx;
  color: var(--color-primary-deep);
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.55;
}

/* ─── Template grid ─────────────────────────────────────────────── */

.template-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }

.template-card {
  position: relative;
  height: 176rpx;
  box-sizing: border-box;
  padding: 24rpx;
  text-align: left;
  border: 0;
  border-radius: 24rpx;
  background: #f5f6f3;
}
.template-card:nth-child(2) { background: #f7f3ea; }
.template-card:nth-child(3) { background: #f5f3ea; }
.template-card:nth-child(4) { background: #f7f3ea; }
.template-card:nth-child(5) { background: #f5eee9; }
.template-card-custom { border: 2rpx dashed rgba(53, 104, 89, .38); }
.template-card-pressed { opacity: .82; transform: scale(.985); }

.choice-card-active {
  border: 2rpx solid var(--color-primary);
  background: var(--color-primary-light);
  box-shadow: inset 0 0 0 2rpx rgba(53, 104, 89, .08);
}
.selection-mark {
  position: absolute;
  top: 14rpx;
  right: 16rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: 21rpx;
  line-height: 32rpx;
  text-align: center;
}
.choice-title { font-size: 29rpx; font-weight: 650; }
.choice-description { margin-top: 8rpx; color: var(--color-text-secondary); font-size: 23rpx; line-height: 1.45; }

/* ─── Input card ────────────────────────────────────────────────── */

.input-card {
  position: relative;
  margin-top: 24rpx;
  padding: 24rpx 24rpx 58rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 22rpx;
  background: var(--color-surface);
}
.input-card input { height: 58rpx; font-size: 30rpx; }
.input-count { position: absolute; right: 22rpx; bottom: 16rpx; color: var(--color-text-secondary); font-size: 22rpx; }

/* ─── Step 2: 节奏选择页（行内紧凑布局） ──────────────────────── */

.rhythm-section {
  padding: 18rpx 32rpx 12rpx;
}

.rhythm-header {
  margin-bottom: 16rpx;
}
.rhythm-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 48rpx;
  color: #1F4D42;
}
.rhythm-subtitle {
  margin-top: 6rpx;
  font-size: 25rpx;
  line-height: 34rpx;
  color: #7A8A84;
}

/* 设置项直接排列在页面中，不再为每组套大卡片。 */
.rhythm-card {
  padding: 0;
}

/* 行：左侧标题 + 右侧选项 */
.rhythm-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #DDE6E1;
}
.rhythm-row--last {
  border-bottom: none;
}

/* 左侧标题 */
.row-label {
  flex-shrink: 0;
  width: 124rpx;
  padding-top: 8rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 36rpx;
  color: #23443B;
}

/* 右侧选项组 */
.row-options {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.row-options--three .option-chip,
.row-options--four .option-chip {
  flex: 1;
  min-width: 0;
  padding-right: 8rpx;
  padding-left: 8rpx;
}
.row-options--deadline {
  flex: 0 0 auto;
  display: grid;
  grid-template-columns: repeat(2, 152rpx);
  gap: 16rpx;
}
.row-options--deadline .option-chip {
  width: 152rpx;
}
.row-options--wrap {
  flex-direction: column;
  align-items: stretch;
  gap: 10rpx;
}

/* 每天投入两行排列时的单行容器 */
.option-line {
  display: flex;
  gap: 10rpx;
}
.option-line .option-chip {
  flex: 1;
  min-width: 0;
}

/* ─── Chip 选项（统一封装） ─────────────────────────────────────── */

.option-chip {
  height: 52rpx;
  min-width: 96rpx;
  padding: 0 16rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #E1E8E4;
  border-radius: 14rpx;
  background: #FFFFFF;
  color: #30423C;
  font-size: 24rpx;
  line-height: 1;
  text-align: center;
  transition: all .15s ease;
}
.option-chip::after {
  border: none;
}
.option-chip--active {
  border-width: 2rpx;
  border-color: #356859;
  background: #EEF7F2;
  color: #356859;
  font-weight: 600;
  box-shadow: inset 0 0 0 1rpx rgba(53,104,89,.08);
}
.option-chip--disabled {
  opacity: .5;
}
.option-chip:not([disabled]):active {
  background: #E2F0E9;
  transform: scale(.97);
}

/* ─── 自定义输入行 ──────────────────────────────────────────────── */

.custom-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 2rpx 0 12rpx 140rpx;
  padding: 12rpx 16rpx;
  border-radius: 18rpx;
  background: #F5F7F2;
}
.custom-input-row ant-input {
  flex: 1;
  min-width: 0;
}
.custom-confirm-btn {
  flex-shrink: 0;
  width: 132rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 600;
}

/* ─── 截止日期 picker ───────────────────────────────────────────── */

.deadline-picker {
  flex: 1;
  height: 56rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  border: 1rpx solid #E1E8E4;
  border-radius: 18rpx;
  background: #FFFFFF;
  color: #30423C;
  font-size: 26rpx;
}
.deadline-picker--empty {
  color: #9AA6A1;
}
.deadline-clear {
  flex-shrink: 0;
  height: 56rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #E1E8E4;
  border-radius: 18rpx;
  background: #FFFFFF;
  color: #66736F;
  font-size: 24rpx;
  line-height: 1;
}
.deadline-clear::after {
  border: none;
}

/* ─── 滚动底部留白 ──────────────────────────────────────────────── */

.scroll-spacer {
  height: 0;
}

/* ─── Bottom actions ────────────────────────────────────────────── */

.bottom-actions {
  flex-shrink: 0;
  display: flex;
  gap: 20rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  background: rgba(255,255,255,.96);
}
.previous-button, .next-button {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-weight: 650;
}
.previous-button { width: 180rpx; border: 2rpx solid var(--color-border); color: var(--color-text-secondary); }
.next-button { flex: 1; background: var(--color-primary); color: #fff; }

@media (max-width: 340px) {
  .rhythm-section {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .rhythm-row {
    gap: 12rpx;
  }

  .row-label {
    width: 116rpx;
    font-size: 25rpx;
  }

  .row-options,
  .option-line {
    gap: 10rpx;
  }

  .option-chip {
    height: 52rpx;
    min-width: 0;
    padding-right: 12rpx;
    padding-left: 12rpx;
    font-size: 23rpx;
  }

  .custom-input-row {
    margin-left: 128rpx;
  }

  .row-options--deadline {
    grid-template-columns: repeat(2, 140rpx);
  }

  .row-options--deadline .option-chip {
    width: 140rpx;
  }
}
