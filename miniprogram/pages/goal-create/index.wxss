.goal-page {
  padding-top: 38rpx;
  background: #F7F3EA;
}

.goal-hero {
  position: relative;
  min-height: 286rpx;
  overflow: hidden;
  padding: 0;
  margin-bottom: 30rpx;
  border: 1rpx solid rgba(121,111,91,.13);
  border-radius: 30rpx;
  background: #FFFCF6;
  box-shadow: 0 8rpx 24rpx rgba(75,62,40,.06);
}
.goal-hero__mountain { position: absolute; inset: 0; width: 100%; height: 100%; }
.goal-hero__veil { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(255,252,246,.98), rgba(255,252,246,.82) 56%, rgba(255,252,246,.2)); }
.goal-hero__content { position: relative; z-index: 2; padding: 34rpx; }

.hero-kicker {
  color: #9A712E;
  font-size: 20rpx;
  letter-spacing: 3rpx;
}

.hero-title {
  position: relative;
  margin-top: 12rpx;
  color: #245B4D;
  font-family: "Songti SC", STSong, serif;
  font-size: 48rpx;
  font-weight: 700;
}

.hero-copy {
  position: relative;
  margin-top: 14rpx;
  max-width: 440rpx;
  color: #6F7772;
  line-height: 1.6;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
}

.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.choice-chip {
  padding: 18rpx 24rpx;
  border: 1rpx solid rgba(36,91,77,.16);
  border-radius: 999rpx;
  background: #FFFCF6;
  color: #6F7772;
}

.choice-chip-active {
  border-color: #245B4D;
  background: #E5EEE8;
  color: #245B4D;
  font-weight: 650;
}

.form-card {
  margin-top: 26rpx;
}

.field-label {
  font-weight: 650;
}

.field-gap {
  margin-top: 28rpx;
}

.text-input,
.description {
  width: 100%;
  margin-top: 16rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(36,91,77,.16);
  border-radius: 22rpx;
  background: #FFFCF6;
}

.description {
  height: 180rpx;
}

.counter {
  text-align: right;
  margin-top: 8rpx;
  color: #9AA8A3;
  font-size: 22rpx;
}

.manual-note {
  display: flex;
  gap: 20rpx;
  margin-top: 26rpx;
  padding: 25rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(200,155,74,.18);
  background: #FBF2DF;
}

.note-mark {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #C89B4A;
  color: #FFFCF6;
  font-size: 34rpx;
}

.note-title {
  font-weight: 650;
}

.helper {
  margin-top: 8rpx;
  color: #6F827B;
  font-size: 24rpx;
  line-height: 1.55;
}

.submit-button {
  width: 100%;
  margin-top: 30rpx;
}

.existing-card {
  text-align: center;
}

.existing-title {
  margin-top: 18rpx;
  font-size: 38rpx;
  font-weight: 700;
}
