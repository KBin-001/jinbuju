.goal-page { box-sizing: border-box; min-height: 100vh; padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); background: var(--color-bg-page); }
.goal-hero { position: relative; height: 216rpx; overflow: hidden; border-radius: var(--radius-hero); background: var(--color-bg-card); }
.goal-hero__mountain, .goal-hero__veil { position: absolute; inset: 0; width: 100%; height: 100%; }
.goal-hero__mountain { opacity: .56; }
.goal-hero__veil { background: linear-gradient(90deg, rgba(255,252,246,.99) 0%, rgba(255,252,246,.92) 56%, rgba(255,252,246,.22) 100%); }
.goal-hero__content { position: relative; z-index: 1; display: flex; flex-direction: column; padding: 30rpx 32rpx; }
.hero-kicker { color: var(--color-gold); font-size: 22rpx; font-weight: 650; letter-spacing: 3rpx; }
.hero-title { width: 78%; margin-top: 14rpx; color: var(--color-text-main); font-family: var(--font-family-brand); font-size: 40rpx; font-weight: var(--font-weight-title); line-height: 1.25; }
.hero-copy { margin-top: 10rpx; color: var(--color-text-secondary); font-size: 23rpx; }
.stepper { display: flex; justify-content: space-between; margin: 28rpx 24rpx 24rpx; }
.stepper__item { position: relative; display: flex; align-items: center; gap: 10rpx; color: var(--color-text-weak); font-size: 23rpx; }
.stepper__item:not(:last-child)::after { content: ""; position: absolute; left: 88rpx; top: 17rpx; width: 96rpx; height: 2rpx; background: var(--color-border-soft); }
.stepper__dot { width: 34rpx; height: 34rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-surface-soft); font-size: 20rpx; }
.stepper__item.is-active { color: var(--color-primary); font-weight: 650; }
.stepper__item.is-active .stepper__dot { background: var(--color-primary); color: #fff; }
.form-section { min-height: 620rpx; padding: 30rpx 28rpx; border: 1rpx solid var(--color-border-soft); border-radius: var(--radius-card); background: var(--color-bg-card); }
.section-title { color: var(--color-text-main); font-size: 32rpx; font-weight: 700; }
.section-caption { margin-top: 8rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 1.55; }
.direction-grid { margin-top: 24rpx; border-top: 1rpx solid var(--color-border-soft); }
.direction-row { min-height: 88rpx; display: flex; align-items: center; justify-content: space-between; padding: 14rpx 4rpx; border-bottom: 1rpx solid var(--color-border-soft); color: var(--color-text-weak); }
.direction-row.is-selected { color: var(--color-primary); }
.direction-copy { min-width: 0; display: flex; flex-direction: column; }
.direction-label { color: var(--color-text-main); font-size: 28rpx; font-weight: 650; }
.direction-note { margin-top: 4rpx; color: var(--color-text-secondary); font-size: 21rpx; }
.field-shell, .field-block { position: relative; margin-top: 26rpx; padding: 22rpx; border-radius: var(--radius-input); background: var(--color-surface-soft); }
.field-label, .choice-label { display: block; color: var(--color-text-main); font-size: 26rpx; font-weight: 650; }
.text-input { height: 72rpx; color: var(--color-text-main); font-size: 29rpx; }
.field-count { position: absolute; right: 20rpx; bottom: 16rpx; color: var(--color-text-weak); font-size: 20rpx; }
.field-help { display: block; color: var(--color-text-secondary); font-size: 21rpx; line-height: 1.5; }
.choice-row { min-height: 96rpx; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; margin-top: 24rpx; padding: 18rpx 20rpx; border: 1rpx solid var(--color-border-soft); border-radius: var(--radius-input); color: var(--color-primary); }
.choice-note { display: block; margin-top: 5rpx; color: var(--color-text-secondary); font-size: 23rpx; }
.text-link { margin-top: 16rpx; color: var(--color-primary); font-size: 23rpx; text-align: right; }
.inline-note, .error-message, .result-preview { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 22rpx; padding: 18rpx 20rpx; border-radius: var(--radius-input); font-size: 22rpx; line-height: 1.55; }
.inline-note, .result-preview { background: var(--color-surface-soft); color: var(--color-text-secondary); }
.result-preview { align-items: center; color: var(--color-primary); }
.result-preview view { display: flex; flex-direction: column; }
.result-preview text:last-child { margin-top: 4rpx; color: var(--color-text-secondary); font-size: 21rpx; }
.error-message { background: rgba(184,70,70,.08); color: var(--color-error); }
.duration-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.duration-chip { min-width: 118rpx; padding: 15rpx 18rpx; border: 1rpx solid var(--color-border-soft); border-radius: 999rpx; color: var(--color-text-secondary); font-size: 23rpx; text-align: center; }
.duration-chip.is-selected { border-color: var(--color-primary); background: var(--color-primary); color: #fff; }
.reminder-row { border: 0; background: var(--color-surface-soft); }
.time-row { margin-top: 12rpx; }
.footer-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.footer-actions button { height: 92rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border-radius: var(--radius-button); font-size: 28rpx; font-weight: 650; }
.footer-actions button::after { border: 0; }
.secondary-button { flex: 0 0 180rpx; border: 1rpx solid var(--color-border-strong); background: transparent; color: var(--color-primary); }
.primary-button { flex: 1; border: 0; background: var(--color-primary); color: #fff; }
.primary-button[disabled] { background: var(--color-disabled-bg); color: var(--color-disabled-text); }
.pressed { opacity: .76; }
@media (max-width: 350px) { .goal-page { padding-left: 24rpx; padding-right: 24rpx; } .goal-hero { height: 196rpx; } .hero-title { font-size: 36rpx; } .form-section { min-height: 580rpx; padding: 24rpx 22rpx; } .stepper__item:not(:last-child)::after { width: 70rpx; } }

/* Semantic type roles for goal creation fields and duration choices. */
.hero-kicker,
.field-count,
.stepper__dot { font-size: var(--font-tag); line-height: var(--line-height-tag); }
.hero-title { font-size: var(--font-page-title); line-height: var(--line-height-page-title); }
.hero-copy,
.section-caption,
.direction-note,
.field-help,
.choice-note,
.inline-note,
.error-message,
.result-preview { font-size: var(--font-caption); line-height: var(--line-height-caption); }
.section-title,
.direction-label { font-size: var(--font-card-title); line-height: var(--line-height-card-title); }
.stepper__item,
.field-label,
.choice-label,
.text-input,
.text-link,
.duration-chip { font-size: var(--font-body); line-height: var(--line-height-body); }
.footer-actions button,
.primary-button,
.secondary-button { font-size: var(--font-body-strong); line-height: var(--line-height-body-strong); }

@media (max-width: 350px) {
  .hero-title { font-size: var(--font-page-title-compact); line-height: var(--line-height-page-title); }
  .section-title,
  .direction-label { font-size: var(--font-card-title-compact); line-height: var(--line-height-card-title); }
  .hero-copy,
  .section-caption,
  .direction-note,
  .field-help,
  .choice-note,
  .inline-note,
  .error-message,
  .result-preview { font-size: var(--font-caption-compact); line-height: var(--line-height-caption); }
  .hero-kicker,
  .field-count,
  .stepper__dot { font-size: var(--font-tag-compact); line-height: var(--line-height-tag); }
}
