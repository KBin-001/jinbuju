<view class="page goal-page" data-theme="{{appTheme}}">
  <view class="growth-hero goal-hero">
    <image class="goal-hero__mountain" src="/assets/profile/goal-mountain-v2.jpg" mode="aspectFill" />
    <view class="goal-hero__veil"></view>
    <view class="goal-hero__content"><view class="hero-kicker">长期方向</view><view class="hero-title">创建长期目标</view><view class="hero-copy">先定一个方向，再把每天真正想做的行动加进来。</view></view>
  </view>

  <view wx:if="{{activeGoalCount > 0}}" class="manual-note">
    <view class="note-mark">✓</view>
    <view>
      <view class="note-title">你已有 {{activeGoalCount}} 个进行中目标</view>
      <view class="helper">新目标会成为当前目标，旧目标仍会保留在“我的目标”里。</view>
    </view>
  </view>

  <view class="section-shell">
    <view class="section-title">选择目标方向</view>
    <view class="chip-grid">
      <t-button wx:for="{{options}}" wx:key="value" class="choice-chip {{category === item.value ? 'choice-chip-active' : ''}}" data-value="{{item.value}}" bindtap="selectCategory">{{item.label}}</t-button>
    </view>
  </view>

  <view class="card form-card">
    <view class="field-label">目标名称</view>
    <t-input class="text-input" value="{{title}}" maxlength="30" placeholder="例如：完成个人博客" bindchange="inputTitle" />
    <view class="counter">{{title.length}} / 30</view>
    <view class="field-label field-gap">简单说明（可选）</view>
    <t-textarea class="description" value="{{description}}" maxlength="150" placeholder="写下你希望达成的结果" bindchange="inputDescription" />
    <view class="counter">{{description.length}} / 150</view>
  </view>

  <view class="manual-note">
    <view class="note-mark">+</view>
    <view>
      <view class="note-title">目标创建后直接开始行动</view>
      <view class="helper">先从真实可完成的一步开始，AI 教练会根据后续行动记录提供建议。</view>
    </view>
  </view>

  <t-button class="primary-button submit-button" loading="{{submitting}}" disabled="{{submitting || title.length < 2}}" bindtap="submit">{{submitting ? '正在创建' : '创建目标并进入今日'}}</t-button>
</view>
