<view class="goal-page">
  <view class="goal-header">
    <button class="back-button" disabled="{{submitting}}" bindtap="previousStep">‹</button>
    <view class="header-center">
      <view class="header-title">创建行动计划</view>
      <view class="step-text">{{currentStep}} / 2</view>
    </view>
    <view class="header-placeholder"></view>
  </view>
  <view class="progress-track">
    <view class="progress-value" style="width: {{pageStatus === 'form' ? currentStep * 50 : 0}}%;"></view>
  </view>

  <view wx:if="{{pageStatus === 'loading'}}" class="goal-state">
    <view class="loading-dot"></view>
    <view class="state-title">正在检查目标状态</view>
  </view>
  <view wx:elif="{{pageStatus === 'error'}}" class="goal-state">
    <view class="state-mark">!</view>
    <view class="state-title">暂时无法开始创建</view>
    <view class="state-description">{{pageError}}</view>
    <button class="primary-button" bindtap="retryInitialize">重新加载</button>
  </view>

  <scroll-view wx:else class="form-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{currentStep === 1}}" class="step-section">
      <view class="step-title">这次想进步什么？</view>
      <view class="step-subtitle">选一个最接近的目标，不需要先写很多信息。</view>
      <view class="template-grid">
        <button
          wx:for="{{templateOptions}}"
          wx:key="value"
          class="template-card {{draft.templateId === item.value ? 'choice-card-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="selectTemplate"
        >
          <view class="choice-title">{{item.label}}</view>
          <view class="choice-description">{{item.description}}</view>
        </button>
      </view>
      <view wx:if="{{draft.templateId === 'custom'}}" class="input-card">
        <input
          value="{{draft.customGoalTitle}}"
          maxlength="30"
          placeholder="例如：学会基础摄影"
          bindinput="inputCustomGoal"
        />
        <view class="input-count">{{draft.customGoalTitle.length}} / 30</view>
      </view>
    </view>

    <view wx:else class="step-section">
      <view class="step-title">选择一个能坚持的节奏</view>
      <view class="step-subtitle">默认设置已经适合多数人，确认后会立即看到基础计划。</view>

      <view class="field-label">当前水平</view>
      <view class="chip-grid three-grid">
        <button
          wx:for="{{levelOptions}}"
          wx:key="value"
          class="choice-chip {{draft.currentLevel === item.value ? 'choice-chip-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="selectLevel"
        >{{item.label}}</button>
      </view>

      <view class="field-label field-spacing">每天投入时间</view>
      <view class="chip-grid">
        <button
          wx:for="{{minuteOptions}}"
          wx:key="*this"
          class="choice-chip compact-chip {{draft.dailyMinutes === item ? 'choice-chip-active' : ''}}"
          data-value="{{item}}"
          bindtap="selectMinutes"
        >{{item}} 分钟</button>
      </view>

      <view class="field-label field-spacing">每周执行天数</view>
      <view class="chip-grid three-grid">
        <button
          wx:for="{{weeklyOptions}}"
          wx:key="*this"
          class="choice-chip {{draft.weeklyDays === item ? 'choice-chip-active' : ''}}"
          data-value="{{item}}"
          bindtap="selectWeeklyDays"
        >每周 {{item}} 天</button>
      </view>

      <button class="advanced-toggle" bindtap="toggleAdvanced">
        <text>高级设置</text>
        <text>{{advancedOpen ? '收起' : '展开'}}</text>
      </button>

      <view wx:if="{{advancedOpen}}" class="advanced-card">
        <view class="field-label">计划周期</view>
        <view class="chip-grid three-grid">
          <button
            wx:for="{{durationOptions}}"
            wx:key="value"
            class="choice-chip {{draft.durationDays === item.value ? 'choice-chip-active' : ''}}"
            data-value="{{item.value}}"
            bindtap="selectDuration"
          >{{item.label}}</button>
        </view>

        <view class="field-label field-spacing">计划强度</view>
        <button
          wx:for="{{intensityOptions}}"
          wx:key="value"
          class="intensity-row {{draft.intensity === item.value ? 'choice-card-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="selectIntensity"
        >
          <view class="choice-title">{{item.label}}</view>
          <view class="choice-description">{{item.description}}</view>
        </button>

        <view class="field-label field-spacing">长期截止日期（可选）</view>
        <view class="deadline-row">
          <picker mode="date" start="{{minimumDeadline}}" value="{{draft.deadline}}" bindchange="changeDeadline">
            <view class="deadline-picker">{{draft.deadline || '不设置截止日期'}}</view>
          </picker>
          <button wx:if="{{draft.deadline}}" class="clear-button" bindtap="clearDeadline">清除</button>
        </view>
      </view>
      <view class="scroll-spacer"></view>
    </view>
  </scroll-view>

  <view wx:if="{{pageStatus === 'form'}}" class="bottom-actions">
    <button class="previous-button" disabled="{{submitting}}" bindtap="previousStep">
      {{currentStep === 1 ? '返回' : '上一步'}}
    </button>
    <button class="next-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="nextStep">
      {{currentStep === 1 ? '下一步' : '立即生成基础计划'}}
    </button>
  </view>
</view>
