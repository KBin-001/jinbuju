<view class="goal-page">
  <view class="goal-header creator-hero">
    <button class="back-button" disabled="{{submitting && currentStep !== 3}}" bindtap="previousStep">‹</button>
    <view class="header-center">
      <view class="header-title">创建目标</view>
      <view class="step-text">{{currentStep}} / {{totalSteps}}</view>
    </view>
    <view class="header-placeholder"></view>
  </view>
  <ant-steps className="goal-steps" items="{{stepItems}}" current="{{currentStep - 1}}" />

  <view wx:if="{{pageStatus === 'loading'}}" class="goal-state">
    <ant-loading type="spin" size="large" color="#356859" />
    <view class="state-title">正在检查目标状态</view>
  </view>
  <view wx:elif="{{pageStatus === 'error'}}" class="goal-state">
    <view class="state-mark">!</view>
    <view class="state-title">暂时无法开始创建</view>
    <view class="state-description">{{pageError}}</view>
    <ant-button type="primary" className="growth-primary-button" bindtap="retryInitialize">重新加载</ant-button>
  </view>

  <scroll-view wx:else class="form-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- Step 1: 目标描述 -->
    <view wx:if="{{currentStep === 1}}" class="step-section step-section-intro">
      <view class="growth-kicker">GROWTH OS · AI 行动规划</view>
      <view class="step-title">这次想进步什么？</view>
      <view class="step-lead">把想做的事，变成今天能完成的一小步。</view>
      <view class="step-subtitle">AI 会先理解你的目标，再帮你拆解成可执行的行动阶段。</view>
      <view class="template-grid">
        <button
          wx:for="{{templateOptions}}"
          wx:key="value"
          class="template-card {{draft.templateId === item.value ? 'choice-card-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="selectTemplate"
        >
          <view class="choice-title">{{item.label}}</view>
          <view class="choice-description">{{item.description}}</view>
        </button>
      </view>
      <ant-card wx:if="{{draft.templateId === 'custom'}}" className="input-card growth-ant-card">
        <ant-input
          controlled="{{true}}"
          value="{{draft.customGoalTitle}}"
          maxLength="{{30}}"
          placeholder="例如：学会基础摄影"
          bindchange="inputCustomGoal"
        />
        <view class="input-count">{{draft.customGoalTitle.length}} / 30</view>
      </ant-card>
    </view>

    <!-- Step 2: 关键情况确认 -->
    <view wx:elif="{{currentStep === 2}}" class="step-section">
      <view class="step-title">选择一个能坚持的节奏</view>
      <view class="step-subtitle">默认设置已经适合多数人，确认后会立即看到基础计划。</view>

      <view class="field-label">当前水平</view>
      <view class="chip-grid three-grid">
        <button
          wx:for="{{levelOptions}}"
          wx:key="value"
          class="choice-chip {{draft.currentLevel === item.value ? 'choice-chip-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="selectLevel"
        >{{item.label}}</button>
      </view>

      <view class="field-label field-spacing">每天投入时间</view>
      <view class="chip-grid">
        <button
          wx:for="{{minuteOptions}}"
          wx:key="*this"
          class="choice-chip compact-chip {{draft.dailyMinutes === item ? 'choice-chip-active' : ''}}"
          data-value="{{item}}"
          bindtap="selectMinutes"
        >{{item}} 分钟</button>
      </view>

      <view class="field-label field-spacing">每周执行天数</view>
      <view class="chip-grid three-grid">
        <button
          wx:for="{{weeklyOptions}}"
          wx:key="*this"
          class="choice-chip {{draft.weeklyDays === item ? 'choice-chip-active' : ''}}"
          data-value="{{item}}"
          bindtap="selectWeeklyDays"
        >每周 {{item}} 天</button>
      </view>

      <button class="advanced-toggle" bindtap="toggleAdvanced">
        <text>高级设置</text>
        <text>{{advancedOpen ? '收起' : '展开'}}</text>
      </button>

      <ant-card wx:if="{{advancedOpen}}" className="advanced-card growth-ant-card">
        <view class="field-label">计划周期</view>
        <view class="chip-grid three-grid">
          <button
            wx:for="{{durationOptions}}"
            wx:key="value"
            class="choice-chip {{draft.durationDays === item.value ? 'choice-chip-active' : ''}}"
            data-value="{{item.value}}"
            bindtap="selectDuration"
          >{{item.label}}</button>
        </view>

        <view class="field-label field-spacing">计划强度</view>
        <button
          wx:for="{{intensityOptions}}"
          wx:key="value"
          class="intensity-row {{draft.intensity === item.value ? 'choice-card-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="selectIntensity"
        >
          <view class="choice-title">{{item.label}}</view>
          <view class="choice-description">{{item.description}}</view>
        </button>

        <view class="field-label field-spacing">长期截止日期（可选）</view>
        <view class="deadline-row">
          <picker mode="date" start="{{minimumDeadline}}" value="{{draft.deadline}}" bindchange="changeDeadline">
            <view class="deadline-picker">{{draft.deadline || '不设置截止日期'}}</view>
          </picker>
          <button wx:if="{{draft.deadline}}" class="clear-button" bindtap="clearDeadline">清除</button>
        </view>
      </ant-card>

      <!-- Clarification section (shown after analysis) -->
      <view wx:if="{{showClarification && analysis}}" class="clarification-section">
        <view class="section-divider"></view>
        <view class="step-title-sm">再确认几个关键问题</view>
        <view class="step-subtitle">AI 发现了几个需要确认的点，回答后方案会更贴合你的情况。</view>

        <view class="analysis-card">
          <view class="field-label">理解后的目标</view>
          <view class="analysis-goal">{{analysis.normalizedGoal}}</view>
          <view wx:if="{{analysis.analysisSource === 'fallback'}}" class="fallback-copy">
            目标分析暂时不可用，先用基础问题帮你补齐关键信息。
          </view>
        </view>

        <view
          wx:for="{{clarificationQuestions}}"
          wx:key="id"
          wx:for-item="question"
          class="question-card"
        >
          <view class="question-title">
            <text>{{index + 1}}. {{question.question}}</text>
            <text wx:if="{{question.required}}" class="required-mark">必填</text>
          </view>

          <view wx:if="{{question.type === 'single_choice'}}" class="answer-options">
            <button
              wx:for="{{question.optionViews}}"
              wx:key="value"
              wx:for-item="option"
              class="answer-chip {{option.selected ? 'choice-chip-active' : ''}}"
              data-question-id="{{question.id}}"
              data-value="{{option.value}}"
              bindtap="selectAnswer"
            >{{option.value}}</button>
          </view>

          <view wx:elif="{{question.type === 'multiple_choice'}}" class="answer-options">
            <ant-checkbox
              wx:for="{{question.optionViews}}"
              wx:key="value"
              wx:for-item="option"
              className="answer-chip {{option.selected ? 'choice-chip-active' : ''}}"
              checked="{{option.selected}}"
              data-question-id="{{question.id}}"
              data-value="{{option.value}}"
              bindchange="toggleMultiAnswer"
            >{{option.value}}</ant-checkbox>
          </view>

          <view wx:elif="{{question.type === 'boolean'}}" class="answer-options">
            <button
              class="answer-chip {{answers[question.id] === true ? 'choice-chip-active' : ''}}"
              data-question-id="{{question.id}}"
              data-value="true"
              bindtap="selectAnswer"
            >可以</button>
            <button
              class="answer-chip {{answers[question.id] === false ? 'choice-chip-active' : ''}}"
              data-question-id="{{question.id}}"
              data-value="false"
              bindtap="selectAnswer"
            >暂时不行</button>
          </view>

          <ant-input
            wx:elif="{{question.type === 'number'}}"
            className="answer-input"
            type="number"
            controlled="{{true}}"
            value="{{answers[question.id]}}"
            placeholder="{{question.min}}～{{question.max}}"
            data-question-id="{{question.id}}"
            bindchange="inputNumberAnswer"
          />

          <ant-textarea
            wx:else
            className="answer-textarea"
            controlled="{{true}}"
            maxLength="{{question.maxLength || 100}}"
            value="{{answers[question.id]}}"
            placeholder="{{question.placeholder || '简单说明即可'}}"
            data-question-id="{{question.id}}"
            bindchange="inputAnswer"
          />
        </view>
      </view>
      <view class="scroll-spacer"></view>
    </view>

    <!-- Step 3: 行动方案生成 -->
    <view wx:elif="{{currentStep === 3}}" class="step-section generation-step">
      <!-- Generating state -->
      <view wx:if="{{flowState === 'analyzing' || flowState === 'generating'}}" class="generation-panel">
        <ant-loading type="spin" size="x-large" color="#356859" />

        <view class="phase-list">
          <view class="phase-item {{generationPhase === 'understanding' ? 'phase-active' : ''}} {{generationPhase === 'organizing' || generationPhase === 'generating' || generationPhase === 'validating' || generationPhase === 'completed' ? 'phase-done' : ''}}">
            <view class="phase-icon">
              <text wx:if="{{generationPhase === 'organizing' || generationPhase === 'generating' || generationPhase === 'validating' || generationPhase === 'completed'}}">✓</text>
              <text wx:else>1</text>
            </view>
            <view class="phase-text">理解你的目标</view>
          </view>
          <view class="phase-item {{generationPhase === 'organizing' ? 'phase-active' : ''}} {{generationPhase === 'generating' || generationPhase === 'validating' || generationPhase === 'completed' ? 'phase-done' : ''}}">
            <view class="phase-icon">
              <text wx:if="{{generationPhase === 'generating' || generationPhase === 'validating' || generationPhase === 'completed'}}">✓</text>
              <text wx:else>2</text>
            </view>
            <view class="phase-text">整理行动重点</view>
          </view>
          <view class="phase-item {{generationPhase === 'generating' ? 'phase-active' : ''}} {{generationPhase === 'validating' || generationPhase === 'completed' ? 'phase-done' : ''}}">
            <view class="phase-icon">
              <text wx:if="{{generationPhase === 'validating' || generationPhase === 'completed'}}">✓</text>
              <text wx:else>3</text>
            </view>
            <view class="phase-text">生成行动方案</view>
          </view>
          <view class="phase-item {{generationPhase === 'validating' ? 'phase-active' : ''}} {{generationPhase === 'completed' ? 'phase-done' : ''}}">
            <view class="phase-icon">
              <text wx:if="{{generationPhase === 'completed'}}">✓</text>
              <text wx:else>4</text>
            </view>
            <view class="phase-text">检查方案可行性</view>
          </view>
        </view>

        <view class="generation-message">{{generationMessage}}</view>

        <view wx:if="{{showLongWaitHint}}" class="long-wait-hint">
          {{longWaitMessage}}
        </view>
      </view>

      <!-- Completed state (brief flash before navigation) -->
      <view wx:elif="{{flowState === 'completed'}}" class="generation-panel generation-complete">
        <view class="complete-icon">✓</view>
        <view class="generation-message">{{generationMessage}}</view>
        <view class="complete-hint">即将跳转到方案预览</view>
      </view>

      <!-- Error state -->
      <view wx:elif="{{flowState === 'error'}}" class="generation-panel generation-error">
        <view class="state-mark">!</view>
        <view class="state-title">方案生成遇到问题</view>
        <view class="state-description">{{pageError}}</view>
        <view wx:if="{{retryCount >= 2}}" class="retry-hint">已重试 {{retryCount}} 次，建议稍后再试或返回修改目标。</view>
      </view>
    </view>
  </scroll-view>

  <!-- Bottom actions -->
  <view wx:if="{{pageStatus === 'form'}}" class="bottom-actions">
    <block wx:if="{{currentStep < 3}}">
      <ant-button type="default" className="previous-button" disabled="{{submitting}}" bindtap="previousStep">
        {{currentStep === 1 ? '返回' : '上一步'}}
      </ant-button>
      <ant-button
        type="primary"
        className="next-button"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bindtap="nextStep"
      >
        {{currentStep === 1 ? '下一步' : (analyzing ? '正在分析目标' : (showClarification ? '确认并生成方案' : '分析并生成方案'))}}
      </ant-button>
    </block>
    <block wx:elif="{{currentStep === 3 && flowState === 'error'}}">
      <ant-button type="default" className="previous-button" bindtap="backToStep2">返回修改</ant-button>
      <ant-button type="primary" className="next-button" disabled="{{submitting}}" bindtap="retryGeneration">重新生成</ant-button>
    </block>
    <!-- Step 3 generating/completed: no buttons to prevent accidental interaction -->
  </view>
</view>
