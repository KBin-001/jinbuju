<view class="goal-page">
  <view class="goal-header">
    <button class="back-button" disabled="{{submitting}}" bindtap="previousStep">‹</button>
    <view class="header-center">
      <view class="header-title">创建长期目标</view>
      <view class="step-text">{{currentStep}} / {{totalSteps}}</view>
    </view>
    <view class="header-placeholder"></view>
  </view>
  <view class="progress-track"><view class="progress-value" style="width: {{pageStatus === 'form' ? progress : 0}}%;"></view></view>

  <view wx:if="{{pageStatus === 'loading'}}" class="goal-state">
    <view class="loading-dot"></view><view class="state-title">正在检查目标状态</view>
  </view>
  <view wx:elif="{{pageStatus === 'error'}}" class="goal-state">
    <view class="state-mark">!</view><view class="state-title">暂时无法开始创建</view>
    <view class="state-description">{{pageError}}</view>
    <button class="primary-button" bindtap="retryInitialize">重新加载</button>
  </view>

  <scroll-view wx:else class="form-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{currentStep === 1}}" class="step-section">
      <view class="step-title">你想长期推进什么？</view>
      <view class="step-subtitle">把想做的事，变成今天能完成的一小步。</view>
      <view class="input-card">
        <input value="{{draft.title}}" maxlength="30" placeholder="例如：通过英语四级" bindinput="inputTitle" />
        <view class="input-count">{{draft.title.length}} / 30</view>
      </view>
    </view>
    <view wx:elif="{{currentStep === 2}}" class="step-section">
      <view class="step-title">这个目标属于哪个方向？</view>
      <view class="step-subtitle">选择最接近的一项即可。</view>
      <view wx:for="{{categoryOptions}}" wx:key="value"
        class="choice-card {{draft.category === item.value ? 'choice-card-active' : ''}}"
        data-value="{{item.value}}" bindtap="selectCategory">
        <view class="choice-title">{{item.label}}</view>
        <view class="choice-description">{{item.description}}</view>
      </view>
    </view>
    <view wx:elif="{{currentStep === 3}}" class="step-section">
      <view class="step-title">你希望最终达到什么结果？</view>
      <view class="step-subtitle">写得具体一些，行动阶段会更贴合。</view>
      <view class="textarea-card">
        <textarea value="{{draft.desiredResult}}" maxlength="200" placeholder="例如：能够达到四级合格水平，并稳定完成词汇、听力和真题练习" bindinput="inputDesiredResult" />
        <view class="input-count">{{draft.desiredResult.length}} / 200</view>
      </view>
    </view>
    <view wx:else class="step-section">
      <view class="step-title">选择一个能长期坚持的节奏</view>
      <view class="step-subtitle">AI 会先为你拆解第一个行动阶段。</view>
      <view class="field-label">每天可投入时间</view>
      <view class="chip-grid compact-grid">
        <view wx:for="{{minuteOptions}}" wx:key="*this"
          class="choice-chip {{draft.dailyMinutes === item ? 'choice-chip-active' : ''}}"
          data-value="{{item}}" bindtap="selectMinutes">{{item}} 分钟</view>
      </view>
      <view class="field-label field-spacing">长期目标周期</view>
      <view class="chip-grid">
        <view wx:for="{{durationOptions}}" wx:key="value"
          class="choice-chip {{draft.targetDuration === item.value ? 'choice-chip-active' : ''}}"
          data-value="{{item.value}}" bindtap="selectDuration">{{item.label}}</view>
      </view>
      <view class="summary-card">
        <view class="summary-title">目标摘要</view>
        <view class="summary-row"><text>目标</text><text>{{draft.title}}</text></view>
        <view class="summary-row"><text>方向</text><text>{{categoryLabel}}</text></view>
        <view class="summary-row"><text>每日时间</text><text>{{draft.dailyMinutes}} 分钟</text></view>
        <view class="summary-row"><text>目标周期</text><text>{{durationLabel}}</text></view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{pageStatus === 'form'}}" class="bottom-actions">
    <button class="previous-button" disabled="{{submitting}}" bindtap="previousStep">{{currentStep === 1 ? '返回' : '上一步'}}</button>
    <button class="next-button {{submitting ? 'button-disabled' : ''}}" loading="{{submitting}}" disabled="{{submitting}}" bindtap="nextStep">
      {{currentStep === 4 ? 'AI 帮我拆解' : '下一步'}}
    </button>
  </view>
</view>
