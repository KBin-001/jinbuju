<view class="goal-page">
  <view class="goal-header creator-hero">
    <button class="back-button" disabled="{{submitting}}" bindtap="previousStep">‹</button>
    <view class="header-center">
      <view class="header-title">创建目标</view>
      <view class="step-text">{{currentStep}} / {{totalSteps}}</view>
    </view>
    <view class="header-placeholder"></view>
  </view>
  <ant-steps className="goal-steps" items="{{stepItems}}" current="{{currentStep - 1}}" />

  <view wx:if="{{pageStatus === 'loading'}}" class="goal-state">
    <ant-loading type="spin" size="large" color="#356859" />
    <view class="state-title">正在检查目标状态</view>
  </view>
  <view wx:elif="{{pageStatus === 'error'}}" class="goal-state">
    <view class="state-mark">!</view>
    <view class="state-title">暂时无法开始创建</view>
    <view class="state-description">{{pageError}}</view>
    <ant-button type="primary" className="growth-primary-button" bindtap="retryInitialize">重新加载</ant-button>
  </view>

  <scroll-view wx:else class="form-scroll" scroll-y show-scrollbar="{{false}}">
    <!-- Step 1: 目标描述 -->
    <view wx:if="{{currentStep === 1}}" class="step-section step-section-intro">
      <view class="growth-kicker">GROWTH OS · AI 行动规划</view>
      <view class="step-title">这次想进步什么？</view>
      <view class="step-lead">把想做的事，变成今天能完成的一小步。</view>
      <view class="step-subtitle">AI 会先理解你的目标，再帮你拆解成可执行的行动阶段。</view>
      <view class="template-grid">
        <button
          wx:for="{{templateOptions}}"
          wx:key="value"
          class="template-card {{item.value === 'custom' ? 'template-card-custom' : ''}} {{draft.templateId === item.value ? 'choice-card-active' : ''}}"
          hover-class="template-card-pressed"
          aria-label="{{item.label}}：{{item.description}}{{draft.templateId === item.value ? '，已选中' : ''}}"
          data-value="{{item.value}}"
          bindtap="selectTemplate"
        >
          <view wx:if="{{draft.templateId === item.value}}" class="selection-mark">✓</view>
          <view class="choice-title">{{item.label}}</view>
          <view class="choice-description">{{item.description}}</view>
        </button>
      </view>
      <ant-card wx:if="{{draft.templateId === 'custom'}}" className="input-card growth-ant-card">
        <ant-input
          controlled="{{true}}"
          value="{{draft.customGoalTitle}}"
          maxLength="{{30}}"
          placeholder="例如：学习摄影、改善作息、完成个人博客"
          bindchange="inputCustomGoal"
        />
        <view class="input-count">{{draft.customGoalTitle.length}} / 30</view>
      </ant-card>
    </view>

    <!-- Step 2: 节奏设置（行内紧凑布局） -->
    <view wx:elif="{{currentStep === 2}}" class="rhythm-section">
      <view class="rhythm-header">
        <view class="rhythm-title">选择一个能坚持的节奏</view>
        <view class="rhythm-subtitle">AI 会根据你的时间和节奏，生成更适合你的行动方案。</view>
      </view>

      <view class="rhythm-card">
        <!-- 行 1：基础情况 -->
        <view class="rhythm-row">
          <view class="row-label">基础情况</view>
          <view class="row-options row-options--three">
            <button
              wx:for="{{levelOptions}}"
              wx:key="value"
              class="option-chip {{draft.currentLevel === item.value ? 'option-chip--active' : ''}}"
              data-value="{{item.value}}"
              bindtap="selectLevel"
            >{{item.label}}</button>
          </view>
        </view>

        <!-- 行 2：每天投入 -->
        <view class="rhythm-row rhythm-row--wrap">
          <view class="row-label">每天投入</view>
          <view class="row-options row-options--wrap">
            <view class="option-line">
              <button
                wx:for="{{minuteOptions}}"
                wx:if="{{item <= 90}}"
                wx:key="*this"
                class="option-chip {{draft.dailyMinutes === item ? 'option-chip--active' : ''}}"
                data-value="{{item}}"
                bindtap="selectMinutes"
              >{{item}}分钟</button>
            </view>
            <view class="option-line">
              <button
                wx:for="{{minuteOptions}}"
                wx:if="{{item > 90}}"
                wx:key="*this"
                class="option-chip {{draft.dailyMinutes === item ? 'option-chip--active' : ''}}"
                data-value="{{item}}"
                bindtap="selectMinutes"
              >{{item}}分钟</button>
            </view>
          </view>
        </view>

        <!-- 行 3：每周安排 -->
        <view class="rhythm-row">
          <view class="row-label">每周安排</view>
          <view class="row-options row-options--three">
            <button
              wx:for="{{weeklyOptions}}"
              wx:key="*this"
              class="option-chip {{draft.weeklyDays === item ? 'option-chip--active' : ''}}"
              data-value="{{item}}"
              bindtap="selectWeeklyDays"
            >{{item}}天</button>
          </view>
        </view>

        <!-- 行 4：计划周期 -->
        <view class="rhythm-row">
          <view class="row-label">计划周期</view>
          <view class="row-options row-options--four">
            <button
              wx:for="{{durationOptions}}"
              wx:key="value"
              class="option-chip {{draft.planDurationDays === item.value ? 'option-chip--active' : ''}}"
              data-value="{{item.value}}"
              bindtap="selectDuration"
            >{{item.label}}</button>
          </view>
        </view>
        <!-- 行 5：截止日期 -->
        <view class="rhythm-row rhythm-row--last">
          <view class="row-label">截止日期</view>
          <view class="row-options row-options--deadline">
            <button
              class="option-chip {{deadlineMode === 'none' ? 'option-chip--active' : ''}}"
              data-value="none"
              bindtap="selectDeadlineMode"
            >不限</button>
            <button
              class="option-chip {{deadlineMode === 'date' ? 'option-chip--active' : ''}}"
              data-value="date"
              bindtap="selectDeadlineMode"
            >选择日期</button>
          </view>
        </view>
        <view wx:if="{{deadlineMode === 'date'}}" class="custom-input-row">
          <picker mode="date" start="{{minimumDeadline}}" value="{{draft.deadline}}" bindchange="changeDeadline">
            <view class="deadline-picker {{draft.deadline ? '' : 'deadline-picker--empty'}}">{{draft.deadline || '点击选择日期'}}</view>
          </picker>
          <button wx:if="{{draft.deadline}}" class="deadline-clear" bindtap="clearDeadline">清除</button>
        </view>
      </view>

      <view class="scroll-spacer"></view>
    </view>
  </scroll-view>

  <!-- Bottom actions -->
  <view wx:if="{{pageStatus === 'form'}}" class="bottom-actions">
    <ant-button type="default" className="previous-button" disabled="{{submitting}}" bindtap="previousStep">
      {{currentStep === 1 ? '返回' : '上一步'}}
    </ant-button>
    <ant-button
      type="primary"
      className="next-button"
      loading="{{submitting}}"
      disabled="{{submitting || (currentStep === 1 && !canContinueGoal)}}"
      bindtap="nextStep"
    >
      {{currentStep === 1 ? '下一步' : '生成行动方案'}}
    </ant-button>
  </view>
</view>
