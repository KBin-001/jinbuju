<view class="members-page" data-theme="{{appTheme}}">
  <image class="members-bg" src="/assets/team-header-watercolor-v2.jpg" mode="aspectFill" />
  <view class="members-bg-mask"></view>

  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content" style="height: {{navBarHeight}}px; padding-left: {{navRightPad}}px; padding-right: {{navRightPad}}px;">
      <view class="nav-back" bindtap="goBack" aria-label="返回">
        <text class="nav-back-arrow">‹</text>
      </view>
      <view class="nav-titles">
        <text class="nav-title">全部成员</text>
        <text wx:if="{{team}}" class="nav-subtitle">{{team.memberCount}} 位同行伙伴</text>
      </view>
    </view>
  </view>

  <view class="members-body" style="padding-top: {{navTotalHeight}}px;">
    <block wx:if="{{team}}">
      <view class="members-hero paper-card">
        <view class="hero-top">
          <view class="hero-copy">
            <view class="hero-eyebrow">TEAM COMPANIONS</view>
            <view class="hero-name">{{team.name}}</view>
            <view class="hero-meta">成员 {{team.memberCount}}/{{team.maxMembers}} · 房间 {{team.roomCode}}</view>
          </view>
          <view class="hero-seal">
            <image wx:if="{{team.avatar}}" src="{{team.avatar}}" mode="aspectFill" />
            <text wx:else>{{team.avatarText}}</text>
          </view>
        </view>

        <view class="hero-stats">
          <view class="hero-stat">
            <view class="hero-stat-label">已完成</view>
            <view class="hero-stat-value">{{team.completedMembers}}<text>人</text></view>
          </view>
          <view class="hero-stat-divider"></view>
          <view class="hero-stat">
            <view class="hero-stat-label">进行中</view>
            <view class="hero-stat-value">{{team.doingMembers}}<text>人</text></view>
          </view>
          <view class="hero-stat-divider"></view>
          <view class="hero-stat">
            <view class="hero-stat-label">待开始</view>
            <view class="hero-stat-value">{{team.pendingMembers}}<text>人</text></view>
          </view>
        </view>
      </view>

      <view class="member-tools">
        <view class="search-box">
          <view class="search-icon"></view>
          <input
            class="search-input"
            value="{{searchKeyword}}"
            placeholder="搜索成员昵称"
            placeholder-class="search-placeholder"
            confirm-type="search"
            bindinput="onSearchInput"
          />
          <view wx:if="{{searchKeyword}}" class="search-clear" catchtap="onSearchClear">×</view>
        </view>

        <scroll-view scroll-x class="filter-tabs" enhanced show-scrollbar="{{false}}">
          <view class="filter-tabs-inner">
            <view
              wx:for="{{filterTabs}}"
              wx:key="key"
              class="filter-tab {{activeFilter === item.key ? 'filter-tab--active' : ''}}"
              data-key="{{item.key}}"
              bindtap="setFilter"
            >{{item.label}}</view>
          </view>
        </scroll-view>
      </view>

      <view class="member-section-head">
        <view class="member-section-title">同行伙伴</view>
        <view class="member-section-count">共 {{filteredMembers.length}} 人</view>
      </view>

      <view wx:if="{{filteredMembers.length}}" class="member-list">
        <view
          wx:for="{{filteredMembers}}"
          wx:key="id"
          class="member-card paper-card member-card--{{item.state}}"
          data-id="{{item.id}}"
          bindtap="openMemberDetail"
        >
          <view class="member-rank">{{index + 1}}</view>
          <view class="member-avatar avatar-grad {{item.avatarClass}}">
            <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" />
            <image wx:else src="/images/avatar.png" mode="aspectFill" />
          </view>

          <view class="member-main">
            <view class="member-name-row">
              <text class="member-name">{{item.name}}</text>
              <text wx:if="{{item.roleText}}" class="role-chip {{item.isOwner ? 'role-chip--owner' : ''}}">{{item.roleText}}</text>
              <text class="status-chip status-chip--{{item.state}}">{{item.statusText}}</text>
            </view>
            <view class="member-action">{{item.actionSummary}}</view>
            <view class="member-progress">
              <view class="member-progress-fill member-progress-fill--{{item.state}}" style="width: {{item.progressPercent}}%;"></view>
            </view>
          </view>

          <view class="member-side">
            <view class="member-minutes">{{item.actualMinutes}}<text>min</text></view>
            <view class="member-progress-text">{{item.progressText}}</view>
            <view
              wx:if="{{!item.isSelf}}"
              class="encourage-button {{item.canEncourage ? '' : 'encourage-button--disabled'}}"
              data-id="{{item.id}}"
              catchtap="quickEncourage"
            >{{item.encouragedToday ? '已鼓励' : '鼓励'}}</view>
            <view wx:else class="member-detail-link">查看</view>
          </view>
        </view>
      </view>

      <view wx:else class="empty-state paper-card">
        <view class="empty-seal">寻</view>
        <view class="empty-title">没有找到对应伙伴</view>
        <view class="empty-copy">换一个关键词或状态筛选，再看看。</view>
      </view>
    </block>

    <view wx:else class="empty-state empty-state--large paper-card">
      <view class="empty-seal">伴</view>
      <view class="empty-title">还没有加入小队</view>
      <view class="empty-copy">创建或加入小队后，这里会展示所有同行伙伴。</view>
      <view class="empty-action" bindtap="goBack">返回小队页</view>
    </view>

    <view class="bottom-safe-area"></view>
  </view>

  <view wx:if="{{detailVisible && selectedDetail}}" class="detail-layer" catchtouchmove="noop">
    <view class="detail-mask" catchtap="closeDetail"></view>
    <view class="detail-sheet" catchtap="noop">
      <view class="detail-handle"></view>
      <view class="detail-close" catchtap="closeDetail">×</view>

      <scroll-view class="detail-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="detail-profile">
          <view class="detail-avatar avatar-grad {{selectedDetail.avatarClass}}">
            <image wx:if="{{selectedDetail.avatar}}" src="{{selectedDetail.avatar}}" mode="aspectFill" />
            <image wx:else src="/images/avatar.png" mode="aspectFill" />
          </view>
          <view class="detail-profile-main">
            <view class="detail-name-row">
              <text class="detail-name">{{selectedDetail.name}}</text>
              <text wx:if="{{selectedDetail.roleText}}" class="role-chip {{selectedDetail.isOwner ? 'role-chip--owner' : ''}}">{{selectedDetail.roleText}}</text>
              <text class="status-chip status-chip--{{selectedDetail.state}}">{{selectedDetail.statusText}}</text>
            </view>
            <view class="detail-update">{{selectedDetail.updatedText}}</view>
            <view class="detail-status-copy">{{selectedDetail.statusCopy}}</view>
          </view>
        </view>

        <view class="detail-stats paper-card">
          <view class="detail-stat">
            <view class="detail-stat-value">{{selectedDetail.actualMinutes}}<text>min</text></view>
            <view class="detail-stat-label">今日投入</view>
          </view>
          <view class="detail-stat-divider"></view>
          <view class="detail-stat">
            <view class="detail-stat-value">{{selectedDetail.completedActionsText}}</view>
            <view class="detail-stat-label">完成行动</view>
          </view>
          <view class="detail-stat-divider"></view>
          <view class="detail-stat">
            <view class="detail-stat-value">{{selectedDetail.progressText}}</view>
            <view class="detail-stat-label">今日进度</view>
          </view>
        </view>

        <view class="detail-section">
          <view class="detail-section-title">今日行动</view>
          <view wx:if="{{selectedDetail.actions.length}}" class="detail-action-list">
            <view wx:for="{{selectedDetail.actions}}" wx:key="id" class="detail-action-row paper-card">
              <view class="detail-action-mark detail-action-mark--{{item.statusClass}}"></view>
              <view class="detail-action-main">
                <view class="detail-action-title">{{item.title}}</view>
                <view class="detail-action-meta">{{item.minutesText}}</view>
              </view>
              <view class="detail-action-status detail-action-status--{{item.statusClass}}">{{item.statusText}}</view>
            </view>
          </view>
          <view wx:else class="privacy-card paper-card">
            <view class="privacy-leaf"></view>
            <view>
              <view class="privacy-title">保留自己的节奏</view>
              <view class="privacy-copy">{{selectedDetail.privacyMessage}}</view>
            </view>
          </view>
        </view>

        <view class="detail-scroll-pad"></view>
      </scroll-view>

      <view class="detail-footer">
        <view class="detail-footer-secondary" catchtap="closeDetail">关闭</view>
        <view
          wx:if="{{!selectedDetail.isSelf}}"
          class="detail-footer-primary {{selectedDetail.canEncourage ? '' : 'detail-footer-primary--disabled'}}"
          catchtap="sendEncouragementFromDetail"
        >{{selectedDetail.encouragedToday ? '今天已鼓励' : '送一句鼓励'}}</view>
        <view wx:else class="detail-footer-primary detail-footer-primary--self" catchtap="closeDetail">知道了</view>
      </view>
    </view>
  </view>
</view>
