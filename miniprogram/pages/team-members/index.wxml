<view class="members-page" data-theme="{{appTheme}}">
  <image class="members-bg" src="/assets/team-header-bg.jpg" mode="aspectFill" />
  <view class="members-bg-mask"></view>

  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content" style="height: {{navBarHeight}}px; padding-right: {{navRightPad}}px;">
      <view class="nav-back" bindtap="goBack" aria-label="返回">
        <text class="nav-back-arrow">‹</text>
      </view>
      <view class="nav-titles">
        <text class="nav-title">小队成员</text>
        <text class="nav-subtitle">一起自律，各自成长</text>
      </view>
    </view>
  </view>

  <view class="members-body" style="padding-top: {{navTotalHeight}}px;">
    <block wx:if="{{team}}">
      <view class="overview-card paper-card">
        <view class="overview-main">
          <view class="overview-eyebrow">MEMBERS</view>
          <view class="overview-name">{{team.name}}</view>
          <view class="overview-slogan">成员 {{team.memberCount}}/{{team.maxMembers}} · 房间 {{team.roomCode}}</view>
        </view>
        <view class="overview-badge">
          <image wx:if="{{team.avatar}}" class="overview-badge-image" src="{{team.avatar}}" mode="aspectFill" />
          <view wx:else class="overview-badge-inner">{{team.avatarText}}</view>
        </view>
      </view>

      <view class="summary-card paper-card">
        <view class="summary-cell">
          <view class="summary-label">已完成</view>
          <view class="summary-value">{{team.completedMembers}}<text>人</text></view>
        </view>
        <view class="summary-divider"></view>
        <view class="summary-cell">
          <view class="summary-label">进行中</view>
          <view class="summary-value">{{team.activeMembers}}<text>人</text></view>
        </view>
        <view class="summary-divider"></view>
        <view class="summary-cell">
          <view class="summary-label">待开始</view>
          <view class="summary-value">{{team.pendingMembers}}<text>人</text></view>
        </view>
      </view>

      <view class="search-box">
        <view class="search-icon"></view>
        <t-input
          class="search-input"
          value="{{searchKeyword}}"
          placeholder="搜索成员昵称"
          placeholder-class="search-placeholder"
          confirm-type="search"
          bindchange="onSearchInput"
        />
        <view wx:if="{{searchKeyword}}" class="search-clear" catchtap="onSearchClear">×</view>
      </view>

      <scroll-view scroll-x class="filter-tabs" enhanced show-scrollbar="{{false}}">
        <view class="filter-tabs-inner">
          <view
            wx:for="{{filterTabs}}"
            wx:key="key"
            class="filter-tab {{activeFilter === item.key ? 'is-active' : ''}}"
            data-key="{{item.key}}"
            bindtap="setFilter"
          >{{item.label}}</view>
        </view>
      </scroll-view>

      <view wx:if="{{filteredMembers.length > 0}}" class="member-list">
        <view
          wx:for="{{filteredMembers}}"
          wx:key="id"
          class="member-row paper-card"
          data-id="{{item.id}}"
          bindtap="goMemberDetail"
        >
          <view class="member-avatar avatar-grad {{item.avatarClass}}">
            <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" />
            <text wx:else>{{item.avatarText}}</text>
          </view>
          <view class="member-main">
            <view class="member-name-row">
              <text class="member-name">{{item.nickname}}</text>
              <text class="role-tag role-{{item.role}}">{{item.roleText}}</text>
              <text class="status-tag status-{{item.status}}">{{item.statusText}}</text>
            </view>
            <view class="member-sub">本周投入 {{item.weeklyFocusMinutes}} 分钟 · 连续 {{item.streakDays}} 天</view>
          </view>
          <view class="member-arrow">›</view>
        </view>
      </view>

      <view wx:elif="{{!searchKeyword && activeFilter === 'all'}}" class="empty-state paper-card">
        <view class="empty-icon">队</view>
        <view class="empty-title">暂无成员</view>
        <view class="empty-copy">邀请好友加入小队，一起开始成长。</view>
      </view>
      <view wx:else class="empty-state paper-card">
        <view class="empty-icon">查</view>
        <view class="empty-title">没有匹配成员</view>
        <view class="empty-copy">换个关键词或筛选条件再试。</view>
      </view>
    </block>

    <view wx:else class="empty-state empty-state-large paper-card">
      <view class="empty-icon">队</view>
      <view class="empty-title">还没有加入小队</view>
      <view class="empty-copy">创建或加入小队后，这里会展示成员状态。</view>
    </view>

    <view class="bottom-safe-area"></view>
  </view>

  <view wx:if="{{detailVisible && selectedDetail}}" class="detail-mask" catchtap="closeDetail" catchtouchmove="noop">
    <view class="detail-sheet" catchtap="noop">
      <view class="detail-handle-row">
        <view class="detail-handle"></view>
        <view class="detail-close" catchtap="closeDetail">×</view>
      </view>

      <scroll-view class="detail-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="detail-base">
          <view class="detail-avatar avatar-grad {{selectedDetail.avatarClass}}">
            <image wx:if="{{selectedDetail.avatar}}" src="{{selectedDetail.avatar}}" mode="aspectFill" />
            <text wx:else>{{selectedDetail.avatarText}}</text>
          </view>
          <view class="detail-base-main">
            <view class="detail-name-row">
              <text class="detail-name">{{selectedDetail.nickname}}</text>
              <view class="role-tag role-{{selectedDetail.role}}">{{selectedDetail.roleText}}</view>
              <view class="status-tag status-{{selectedDetail.status}}">{{selectedDetail.statusText}}</view>
            </view>
            <view class="detail-joined">加入小队第 {{selectedDetail.joinedDays}} 天</view>
            <view class="detail-status-copy">{{selectedDetail.statusCopy}}</view>
          </view>
        </view>

        <view class="detail-stats paper-card">
          <view class="stat-cell">
            <view class="stat-num-row"><text class="stat-num">{{selectedDetail.weeklyFocusMinutes}}</text><text class="stat-unit">分</text></view>
            <text class="stat-label">本周投入</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-cell">
            <view class="stat-num-row"><text class="stat-num">{{selectedDetail.streakDays}}</text><text class="stat-unit">天</text></view>
            <text class="stat-label">连续行动</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-cell">
            <view class="stat-num-row"><text class="stat-num">{{selectedDetail.maxStreakDays}}</text><text class="stat-unit">天</text></view>
            <text class="stat-label">最长连续</text>
          </view>
        </view>

        <view class="detail-section">
          <view class="section-head">
            <text class="section-title">本周投入趋势</text>
            <text class="section-action" catchtap="viewAllRecords">查看记录</text>
          </view>
          <view class="trend-chart paper-card">
            <view wx:for="{{selectedDetail.weeklyTrend}}" wx:key="dateLabel" class="trend-bar-wrap">
              <view class="trend-bar-track">
                <view class="trend-bar {{item.isToday ? 'is-today' : ''}}" style="height: {{item.heightPercent}}%;"></view>
              </view>
              <text class="trend-date {{item.isToday ? 'is-today' : ''}}">{{item.dateLabel}}</text>
            </view>
          </view>
        </view>

        <view class="detail-section">
          <view class="section-head">
            <text class="section-title">最近行动</text>
          </view>
          <view class="action-list">
            <view wx:for="{{selectedDetail.recentActions}}" wx:key="id" class="action-item paper-card">
              <view class="action-dot"></view>
              <view class="action-main">
                <text class="action-title">{{item.title}}</text>
                <text class="action-meta">{{item.minutes}} 分钟 · {{item.dateText}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="detail-scroll-pad"></view>
      </scroll-view>

      <view class="detail-footer">
        <view class="detail-secondary" catchtap="viewAllRecords">查看完整记录</view>
        <view
          class="detail-primary {{selectedDetail.canEncourage ? '' : 'is-disabled'}}"
          catchtap="sendEncouragementFromDetail"
        >{{selectedDetail.isSelf ? '不能鼓励自己' : (selectedDetail.encouragedToday ? '已鼓励' : '发送鼓励')}}</view>
      </view>
    </view>
  </view>
</view>
