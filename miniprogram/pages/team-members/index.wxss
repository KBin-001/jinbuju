.members-page {
  --paper: #F7F1E6;
  --card: rgba(255, 252, 245, 0.94);
  --ink: #244D42;
  --muted: #746F68;
  --gold: #B88731;
  --green: #2B604F;
  --green-soft: #E7F0E6;
  --line: rgba(206, 196, 176, 0.62);
  --shadow: 0 16rpx 42rpx rgba(58, 48, 32, 0.075);
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 22% 8%, rgba(226, 207, 165, 0.28), transparent 20%),
    linear-gradient(180deg, #FBF7EF 0%, #F7F1E6 46%, #F5EEE2 100%);
  color: var(--ink);
  box-sizing: border-box;
}

.members-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 420rpx;
  opacity: 0.48;
  pointer-events: none;
}

.members-bg-mask {
  position: absolute;
  inset: 0 0 auto;
  height: 560rpx;
  background: linear-gradient(180deg, rgba(251, 247, 239, 0.08) 0%, #F7F1E6 96%);
  pointer-events: none;
}

.paper-card {
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  border-radius: 30rpx;
  background: var(--card);
  box-shadow: var(--shadow);
}

.nav-bar {
  position: relative;
  z-index: 3;
}

.nav-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  padding-left: 96rpx;
}

.nav-back {
  position: absolute;
  left: 24rpx;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  transform: translateY(-50%);
}

.nav-back-arrow {
  color: var(--ink);
  font-size: 58rpx;
  line-height: 1;
}

.nav-titles {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.nav-title {
  color: var(--ink);
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 44rpx;
  letter-spacing: 4rpx;
}

.nav-subtitle {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 30rpx;
}

.members-body {
  position: relative;
  z-index: 1;
  padding: 56rpx 38rpx calc(56rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.overview-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 212rpx;
  padding: 34rpx 34rpx 32rpx;
  overflow: hidden;
}

.overview-eyebrow {
  color: var(--gold);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  line-height: 28rpx;
}

.overview-name {
  margin-top: 10rpx;
  color: var(--ink);
  font-family: "Songti SC", "STSong", serif;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 52rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overview-slogan {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 34rpx;
}

.overview-main {
  min-width: 0;
  flex: 1;
}

.overview-badge {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  width: 108rpx;
  height: 108rpx;
  margin-left: 24rpx;
  border: 4rpx solid rgba(255, 252, 245, 0.94);
  border-radius: 50%;
  background: var(--green-soft);
  color: var(--green);
  font-size: 36rpx;
  font-weight: 800;
}

.overview-badge-image {
  display: block;
  width: 100%;
  height: 100%;
}

.summary-card {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding: 26rpx 0;
}

.summary-cell {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.summary-label {
  color: var(--muted);
  font-size: 24rpx;
  line-height: 32rpx;
}

.summary-value {
  margin-top: 8rpx;
  color: var(--ink);
  font-family: "Songti SC", "STSong", serif;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.summary-value text {
  margin-left: 6rpx;
  color: var(--muted);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 22rpx;
}

.summary-divider {
  width: 1rpx;
  height: 76rpx;
  background: var(--line);
}

.search-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  margin-top: 26rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  background: rgba(255, 252, 245, 0.82);
  box-shadow: 0 8rpx 20rpx rgba(58, 48, 32, 0.045);
}

.search-icon {
  position: relative;
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border: 3rpx solid var(--muted);
  border-radius: 50%;
  box-sizing: border-box;
}

.search-icon::after {
  content: "";
  position: absolute;
  right: -8rpx;
  bottom: -6rpx;
  width: 12rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: var(--muted);
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 26rpx;
}

.search-placeholder {
  color: #A49B8E;
}

.search-clear {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  color: var(--muted);
  font-size: 30rpx;
}

.filter-tabs {
  margin-top: 22rpx;
  white-space: nowrap;
}

.filter-tabs-inner {
  display: flex;
  gap: 14rpx;
}

.filter-tab {
  flex: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(206, 196, 176, 0.62);
  border-radius: 999rpx;
  background: rgba(255, 252, 245, 0.66);
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 700;
}

.filter-tab.is-active {
  border-color: rgba(43, 96, 79, 0.35);
  background: var(--green);
  color: #FFFDF5;
}

.member-list {
  margin-top: 24rpx;
}

.member-row {
  display: flex;
  align-items: center;
  min-height: 118rpx;
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
}

.member-avatar,
.detail-avatar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  width: 72rpx;
  height: 72rpx;
  border: 4rpx solid rgba(255, 252, 245, 0.94);
  border-radius: 50%;
  color: #FFFDF5;
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: 0 6rpx 14rpx rgba(58, 48, 32, 0.08);
}

.avatar-grad image,
.detail-avatar image,
.member-avatar image {
  display: block;
  width: 100%;
  height: 100%;
}

.avatar-grad.grad-1 { background: linear-gradient(135deg, #9FBBA7 0%, #2B604F 100%); }
.avatar-grad.grad-2 { background: linear-gradient(135deg, #CFC5A5 0%, #6A806F 100%); }
.avatar-grad.grad-3 { background: linear-gradient(135deg, #D7BA78 0%, #906824 100%); }
.avatar-grad.grad-4 { background: linear-gradient(135deg, #AFC4BC 0%, #446B5D 100%); }
.avatar-grad.grad-5 { background: linear-gradient(135deg, #CDBEAA 0%, #7A6E5E 100%); }
.avatar-grad.grad-6 { background: linear-gradient(135deg, #D3A78E 0%, #8F5F4F 100%); }

.member-main {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
}

.member-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.member-name {
  max-width: 210rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.member-sub {
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 32rpx;
}

.role-tag,
.status-tag {
  flex: none;
  display: inline-flex;
  align-items: center;
  height: 34rpx;
  padding: 0 13rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.role-leader {
  background: rgba(244, 227, 188, 0.72);
  color: #8C641B;
}

.role-admin {
  background: rgba(231, 240, 230, 0.82);
  color: var(--green);
}

.role-member {
  background: rgba(238, 232, 217, 0.82);
  color: var(--muted);
}

.status-checked {
  background: var(--green-soft);
  color: var(--green);
}

.status-active {
  background: rgba(244, 227, 188, 0.72);
  color: #8C641B;
}

.status-normal,
.status-unchecked {
  background: rgba(238, 232, 217, 0.82);
  color: var(--muted);
}

.member-arrow {
  flex: none;
  margin-left: 12rpx;
  color: #AFA694;
  font-size: 34rpx;
}

.empty-state {
  margin-top: 28rpx;
  padding: 70rpx 36rpx;
  text-align: center;
}

.empty-state-large {
  margin-top: 100rpx;
}

.empty-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--green-soft);
  color: var(--green);
  font-size: 30rpx;
  font-weight: 800;
}

.empty-title {
  margin-top: 22rpx;
  color: var(--ink);
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-copy {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 36rpx;
}

.bottom-safe-area {
  height: env(safe-area-inset-bottom);
}

.detail-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(32, 58, 50, 0.28);
  backdrop-filter: blur(8rpx);
}

.detail-sheet {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 78vh;
  border-radius: 34rpx 34rpx 0 0;
  background: #F7F1E6;
  overflow: hidden;
  box-shadow: 0 -18rpx 50rpx rgba(58, 48, 32, 0.18);
}

.detail-handle-row {
  position: relative;
  flex: none;
  height: 58rpx;
}

.detail-handle {
  position: absolute;
  left: 50%;
  top: 24rpx;
  width: 76rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #DED4C0;
  transform: translateX(-50%);
}

.detail-close {
  position: absolute;
  right: 24rpx;
  top: 13rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #FFFDF5;
  color: var(--muted);
  font-size: 32rpx;
}

.detail-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.detail-base {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 12rpx 0 26rpx;
}

.detail-avatar {
  width: 100rpx;
  height: 100rpx;
  font-size: 38rpx;
}

.detail-base-main {
  min-width: 0;
  flex: 1;
}

.detail-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.detail-name {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 700;
}

.detail-joined,
.detail-status-copy {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 34rpx;
}

.detail-status-copy {
  color: var(--green);
}

.detail-stats {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
}

.stat-cell {
  flex: 1;
  text-align: center;
}

.stat-num-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
}

.stat-num {
  color: var(--ink);
  font-family: "Songti SC", "STSong", serif;
  font-size: 44rpx;
  font-weight: 700;
}

.stat-unit,
.stat-label {
  color: var(--muted);
  font-size: 22rpx;
}

.stat-divider {
  width: 1rpx;
  height: 64rpx;
  background: var(--line);
}

.detail-section {
  margin-top: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
}

.section-action {
  color: var(--gold);
  font-size: 24rpx;
}

.trend-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
  height: 210rpx;
  padding: 18rpx 18rpx 14rpx;
}

.trend-bar-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.trend-bar-track {
  flex: 1;
  display: flex;
  align-items: flex-end;
}

.trend-bar {
  width: 34rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #88A996 0%, #2B604F 100%);
}

.trend-bar.is-today {
  background: linear-gradient(180deg, #D8B46B 0%, #B88731 100%);
}

.trend-date {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.trend-date.is-today {
  color: var(--green);
  font-weight: 700;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 20rpx;
}

.action-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--gold);
}

.action-main {
  min-width: 0;
  flex: 1;
}

.action-title {
  display: block;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-meta {
  display: block;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.detail-scroll-pad {
  height: 30rpx;
}

.detail-footer {
  display: flex;
  gap: 18rpx;
  flex: none;
  padding: 20rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: #FFFDF5;
}

.detail-secondary,
.detail-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.detail-secondary {
  flex: none;
  padding: 0 30rpx;
  border: 1rpx solid var(--line);
  color: var(--gold);
}

.detail-primary {
  flex: 1;
  background: var(--green);
  color: #FFFDF5;
}

.detail-primary.is-disabled {
  background: #C9D6D1;
}

@media (max-width: 350px) {
  .members-body {
    padding-left: 26rpx;
    padding-right: 26rpx;
  }

  .member-name {
    max-width: 150rpx;
  }

  .summary-value {
    font-size: 40rpx;
  }

  .detail-footer {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }
}
