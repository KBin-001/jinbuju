.members-page {
  --paper: #f7f1e7;
  --card: rgba(255, 253, 248, 0.965);
  --ink: #1e5144;
  --ink-deep: #173d34;
  --muted: #777168;
  --muted-light: #a39c91;
  --gold: #b98029;
  --gold-soft: #f5e8ca;
  --green-soft: #e7f0e8;
  --line: rgba(203, 194, 177, 0.58);
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 17% 8%, rgba(224, 200, 146, 0.15), transparent 22%),
    linear-gradient(180deg, #faf7f0 0%, #f7f1e7 48%, #f6efe4 100%);
  color: var(--ink-deep);
}

.members-bg {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;
  width: 100%;
  height: 570rpx;
  opacity: 0.72;
  pointer-events: none;
}

.members-bg-mask {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;
  right: 0;
  height: 700rpx;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(250, 247, 240, 0.03) 0%, rgba(250, 247, 240, 0.10) 54%, #f7f1e7 94%);
}

.paper-card {
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  border-radius: 25rpx;
  background: var(--card);
  box-shadow: 0 15rpx 40rpx rgba(72, 59, 39, 0.07);
}

.nav-bar {
  position: absolute;
  z-index: 5;
  top: 0;
  right: 0;
  left: 0;
}

.nav-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
}

.nav-back {
  position: absolute;
  top: 50%;
  left: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 58rpx;
  height: 58rpx;
  border: 1rpx solid rgba(171, 166, 153, 0.40);
  border-radius: 50%;
  background: rgba(255, 253, 248, 0.70);
  box-shadow: 0 5rpx 15rpx rgba(63, 58, 48, 0.05);
  transform: translateY(-50%);
}

.nav-back-arrow {
  margin-top: -4rpx;
  color: var(--ink);
  font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums;
  font-size: 48rpx;
  font-weight: 400;
  line-height: 1;
}

.nav-titles {
  display: flex;
  align-items: center;
  flex-direction: column;
  min-width: 0;
}

.nav-title {
  color: var(--ink);
  font-family: var(--font-family-brand);
  font-size: 38rpx;
  font-weight: var(--font-weight-title);
  line-height: 43rpx;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(255, 253, 248, 0.8);
}

.nav-subtitle {
  margin-top: 3rpx;
  color: #7d786f;
  font-size: 18rpx;
  line-height: 24rpx;
}

.members-body {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  min-height: 100vh;
  padding-right: 28rpx;
  padding-bottom: calc(46rpx + env(safe-area-inset-bottom));
  padding-left: 28rpx;
}

/* Hero */
.members-hero {
  margin-top: 70rpx;
  overflow: hidden;
  backdrop-filter: blur(5rpx);
  -webkit-backdrop-filter: blur(5rpx);
}

.hero-top {
  display: flex;
  align-items: center;
  min-height: 144rpx;
  padding: 28rpx 31rpx 19rpx;
}

.hero-copy {
  min-width: 0;
  flex: 1;
}

.hero-eyebrow {
  color: var(--gold);
  font-size: 18rpx;
  font-weight: 700;
  line-height: 25rpx;
  letter-spacing: 3rpx;
}

.hero-name {
  max-width: 480rpx;
  margin-top: 7rpx;
  overflow: hidden;
  color: var(--ink);
  font-family: var(--font-family-brand);
  font-size: 38rpx;
  font-weight: var(--font-weight-title);
  line-height: 48rpx;
  letter-spacing: 2rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-meta {
  margin-top: 7rpx;
  color: #767169;
  font-size: 22rpx;
  line-height: 30rpx;
}

.hero-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  flex: 0 0 84rpx;
  overflow: hidden;
  margin-left: 20rpx;
  border: 3rpx solid rgba(255, 253, 248, 0.95);
  border-radius: 50%;
  background: linear-gradient(145deg, #edf2ea, #dce8de);
  box-shadow: 0 5rpx 15rpx rgba(35, 76, 62, 0.11);
  color: var(--ink);
  font-family: var(--font-family-brand);
  font-size: 30rpx;
  font-weight: var(--font-weight-title);
}

.hero-seal image { width: 100%; height: 100%; }

.hero-stats {
  display: flex;
  align-items: center;
  height: 102rpx;
  margin: 0 23rpx;
  border-top: 1rpx solid rgba(209, 200, 184, 0.52);
}

.hero-stat {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  flex-direction: column;
}

.hero-stat-label {
  color: #77726a;
  font-size: 21rpx;
  line-height: 28rpx;
}

.hero-stat-value {
  margin-top: 3rpx;
  color: var(--ink-deep);
  font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums;
  font-size: 39rpx;
  line-height: 45rpx;
}

.hero-stat-value text {
  margin-left: 4rpx;
  color: #716d67;
  font-family: var(--font-family-sans);
  font-size: 19rpx;
}

.hero-stat-divider {
  width: 1rpx;
  height: 62rpx;
  background: rgba(202, 193, 177, 0.56);
}

/* Search and filters */
.member-tools {
  margin-top: 23rpx;
}

.search-box {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 68rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(203, 194, 177, 0.60);
  border-radius: 35rpx;
  background: rgba(255, 253, 248, 0.84);
  box-shadow: 0 8rpx 22rpx rgba(69, 58, 41, 0.045);
  backdrop-filter: blur(5rpx);
  -webkit-backdrop-filter: blur(5rpx);
}

.search-icon {
  position: relative;
  box-sizing: border-box;
  width: 26rpx;
  height: 26rpx;
  flex: 0 0 26rpx;
  margin-right: 14rpx;
  border: 3rpx solid #829087;
  border-radius: 50%;
}

.search-icon::after {
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  width: 11rpx;
  height: 3rpx;
  border-radius: 2rpx;
  content: "";
  background: #829087;
  transform: rotate(45deg);
}

.search-input {
  min-width: 0;
  height: 100%;
  flex: 1;
  color: #35443e;
  font-size: 24rpx;
  line-height: 68rpx;
}

.search-placeholder { color: #a29b91; }

.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  flex: 0 0 38rpx;
  border-radius: 50%;
  background: #efede7;
  color: #88827a;
  font-size: 25rpx;
}

.filter-tabs {
  margin-top: 15rpx;
  white-space: nowrap;
}

.filter-tabs-inner {
  display: flex;
  gap: 12rpx;
  padding: 2rpx 0;
}

.filter-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 110rpx;
  height: 52rpx;
  padding: 0 19rpx;
  border: 1rpx solid rgba(202, 193, 177, 0.58);
  border-radius: 27rpx;
  background: rgba(255, 253, 248, 0.70);
  color: #777169;
  font-size: 22rpx;
}

.filter-tab--active {
  border-color: var(--ink);
  background: linear-gradient(135deg, #326b59, #1f5949);
  box-shadow: 0 6rpx 14rpx rgba(31, 89, 73, 0.12);
  color: #fffdf8;
  font-weight: 650;
}

.member-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 27rpx;
  padding: 0 5rpx;
}

.member-section-title {
  color: var(--ink);
  font-family: var(--font-family-brand);
  font-size: 33rpx;
  font-weight: var(--font-weight-title);
  line-height: 44rpx;
  letter-spacing: 2rpx;
}

.member-section-count {
  color: #8a847b;
  font-size: 21rpx;
}

/* Member cards */
.member-list {
  margin-top: 14rpx;
}

.member-card {
  display: flex;
  align-items: center;
  min-height: 133rpx;
  margin-top: 15rpx;
  padding: 18rpx 20rpx;
}

.member-card:first-child { margin-top: 0; }
.member-card--completed { border-color: rgba(191, 143, 58, 0.34); background: linear-gradient(100deg, rgba(251, 245, 228, 0.94), rgba(255, 253, 248, 0.96)); }

.member-avatar,
.detail-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: hidden;
  border: 3rpx solid rgba(255, 253, 248, 0.96);
  border-radius: 50%;
  color: #fffdf8;
  font-family: var(--font-family-brand);
  font-weight: var(--font-weight-title);
  box-shadow: 0 5rpx 14rpx rgba(45, 74, 63, 0.10);
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  margin-right: 17rpx;
  font-size: 26rpx;
}

.member-avatar image,
.detail-avatar image { width: 100%; height: 100%; }

.avatar-grad.grad-1 { background: linear-gradient(135deg, #9db7a6, #346858); }
.avatar-grad.grad-2 { background: linear-gradient(135deg, #cfc6a9, #718373); }
.avatar-grad.grad-3 { background: linear-gradient(135deg, #d7b978, #956d2a); }
.avatar-grad.grad-4 { background: linear-gradient(135deg, #afc5bd, #486f61); }
.avatar-grad.grad-5 { background: linear-gradient(135deg, #cdbdaa, #796d5e); }
.avatar-grad.grad-6 { background: linear-gradient(135deg, #d4aa93, #8d6151); }

.member-main {
  min-width: 0;
  flex: 1;
}

.member-name-row,
.detail-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 8rpx;
}

.member-name {
  max-width: 165rpx;
  overflow: hidden;
  color: #203c34;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 35rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-chip,
.status-chip {
  display: inline-flex;
  align-items: center;
  height: 30rpx;
  flex: 0 0 auto;
  padding: 0 10rpx;
  border-radius: 16rpx;
  font-size: 18rpx;
  line-height: 30rpx;
}

.role-chip { background: #eef0ea; color: #6e746e; }
.role-chip--owner { background: var(--gold-soft); color: #936721; }
.status-chip--completed { background: #e5f0e7; color: #2e6957; }
.status-chip--doing { background: #f6ebd5; color: #986b27; }
.status-chip--pending { background: #efeee9; color: #79756e; }

.member-action {
  max-width: 360rpx;
  margin-top: 6rpx;
  overflow: hidden;
  color: #77726b;
  font-size: 21rpx;
  line-height: 29rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-progress {
  width: 100%;
  height: 7rpx;
  overflow: hidden;
  margin-top: 10rpx;
  border-radius: 4rpx;
  background: #efede8;
}

.member-progress-fill {
  height: 100%;
  border-radius: inherit;
}

.member-progress-fill--completed { background: linear-gradient(90deg, #d8ae53, #be8730); }
.member-progress-fill--doing { background: linear-gradient(90deg, #92ad9f, #648b7b); }
.member-progress-fill--pending { background: #d8d6d0; }
.member-progress--unknown { background: repeating-linear-gradient(90deg, rgba(127,157,145,.14) 0 18rpx, transparent 18rpx 26rpx); }

.member-side {
  display: flex;
  align-items: flex-end;
  width: 110rpx;
  flex: 0 0 110rpx;
  flex-direction: column;
  margin-left: 14rpx;
}

.member-minutes {
  color: #1c3630;
  font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums;
  font-size: 31rpx;
  line-height: 34rpx;
  white-space: nowrap;
}

.member-minutes text {
  margin-left: 3rpx;
  color: #686963;
  font-family: var(--font-family-sans);
  font-size: 17rpx;
}

.member-progress-text {
  margin-top: 2rpx;
  color: #66736d;
  font-size: 18rpx;
  line-height: 24rpx;
}

.encourage-button,
.member-detail-link {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 70rpx;
  height: 34rpx;
  margin-top: 7rpx;
  padding: 0 11rpx;
  border: 1rpx solid rgba(185, 128, 41, 0.58);
  border-radius: 18rpx;
  color: #a16f23;
  font-size: 18rpx;
}

.encourage-button--disabled { border-color: rgba(153, 150, 143, 0.32); color: #9d9890; background: #f1efea; }
.member-detail-link { border-color: rgba(82, 113, 100, 0.30); color: #507363; }

/* Empty states */
.empty-state {
  display: flex;
  align-items: center;
  flex-direction: column;
  margin-top: 24rpx;
  padding: 55rpx 34rpx;
  text-align: center;
}

.empty-state--large { margin-top: 140rpx; }
.empty-seal { display: flex; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; border: 1rpx solid rgba(183,129,41,.50); border-radius: 50%; background: rgba(247,235,209,.66); color: #a87629; font-family: var(--font-family-brand); font-size: 31rpx; }
.empty-title { margin-top: 21rpx; color: var(--ink); font-family: var(--font-family-brand); font-size: 31rpx; font-weight: var(--font-weight-title); }
.empty-copy { margin-top: 11rpx; color: #817b72; font-size: 23rpx; line-height: 34rpx; }
.empty-action { display: flex; align-items: center; justify-content: center; height: 58rpx; margin-top: 26rpx; padding: 0 27rpx; border-radius: 30rpx; background: var(--ink); color: #fff; font-size: 23rpx; }
.bottom-safe-area { height: 30rpx; }

/* Member detail sheet */
.detail-layer {
  position: fixed;
  z-index: 12000;
  inset: 0;
}

.detail-mask {
  position: absolute;
  inset: 0;
  background: rgba(25, 34, 31, 0.36);
  backdrop-filter: blur(5rpx);
  -webkit-backdrop-filter: blur(5rpx);
}

.detail-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  height: min(82vh, 1160rpx);
  border-radius: 34rpx 34rpx 0 0;
  background: #fbf7ee;
  box-shadow: 0 -19rpx 55rpx rgba(35, 44, 40, 0.18);
}

.detail-handle {
  width: 70rpx;
  height: 7rpx;
  flex: 0 0 7rpx;
  margin: 15rpx auto 0;
  border-radius: 4rpx;
  background: #d4cec2;
}

.detail-close {
  position: absolute;
  z-index: 2;
  top: 26rpx;
  right: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #eeebe3;
  color: #79736b;
  font-size: 31rpx;
}

.detail-scroll {
  min-height: 0;
  flex: 1;
  box-sizing: border-box;
  padding: 0 30rpx;
}

.detail-profile {
  display: flex;
  align-items: center;
  padding: 35rpx 7rpx 24rpx;
}

.detail-avatar {
  width: 94rpx;
  height: 94rpx;
  flex: 0 0 94rpx;
  margin-right: 21rpx;
  font-size: 31rpx;
}

.detail-profile-main { min-width: 0; flex: 1; padding-right: 54rpx; }
.detail-name { max-width: 210rpx; overflow: hidden; color: var(--ink); font-family: var(--font-family-brand); font-size: 34rpx; font-weight: var(--font-weight-title); line-height: 43rpx; text-overflow: ellipsis; white-space: nowrap; }
.detail-update { margin-top: 5rpx; color: #948d83; font-size: 19rpx; }
.detail-status-copy { margin-top: 8rpx; color: #716d66; font-size: 22rpx; line-height: 31rpx; }

.detail-stats {
  display: flex;
  align-items: center;
  padding: 23rpx 0;
}

.detail-stat { display: flex; align-items: center; justify-content: center; flex: 1; flex-direction: column; min-width: 0; }
.detail-stat-divider { width: 1rpx; height: 67rpx; background: rgba(203,194,178,.56); }
.detail-stat-value { color: var(--ink-deep); font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 36rpx; line-height: 43rpx; }
.detail-stat-value text { margin-left: 3rpx; color: #6f6c66; font-family: var(--font-family-sans); font-size: 17rpx; }
.detail-stat-label { margin-top: 5rpx; color: #807a72; font-size: 20rpx; }

.detail-section { margin-top: 27rpx; }
.detail-section-title { padding: 0 4rpx; color: var(--ink); font-family: var(--font-family-brand); font-size: 30rpx; font-weight: var(--font-weight-title); letter-spacing: 1rpx; }
.detail-action-list { margin-top: 13rpx; }
.detail-action-row { display: flex; align-items: center; min-height: 83rpx; margin-top: 11rpx; padding: 14rpx 18rpx; border-radius: 18rpx; }
.detail-action-mark { width: 15rpx; height: 15rpx; flex: 0 0 15rpx; margin-right: 15rpx; border: 2rpx solid #aeb8b0; border-radius: 50%; }
.detail-action-mark--completed { border-color: #3f7562; background: #3f7562; box-shadow: 0 0 0 6rpx rgba(63,117,98,.10); }
.detail-action-mark--doing { border-color: #bd8a36; background: #e7c884; }
.detail-action-main { min-width: 0; flex: 1; }
.detail-action-title { overflow: hidden; color: #35443e; font-size: 23rpx; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }
.detail-action-meta { margin-top: 4rpx; color: #918a81; font-size: 19rpx; }
.detail-action-status { display: inline-flex; align-items: center; height: 32rpx; margin-left: 12rpx; padding: 0 11rpx; border-radius: 17rpx; font-size: 18rpx; }
.detail-action-status--completed { background: #e5f0e7; color: #2e6957; }
.detail-action-status--doing { background: #f6ebd5; color: #986b27; }
.detail-action-status--pending { background: #efeee9; color: #79756e; }

.privacy-card { display: flex; align-items: flex-start; margin-top: 13rpx; padding: 23rpx; border-radius: 18rpx; }
.privacy-leaf { width: 32rpx; height: 20rpx; flex: 0 0 32rpx; margin: 7rpx 16rpx 0 3rpx; border-radius: 100% 0 100% 0; background: #5d8877; transform: rotate(-29deg); }
.privacy-title { color: #3d4b45; font-size: 24rpx; font-weight: 650; }
.privacy-copy { margin-top: 6rpx; color: #858077; font-size: 21rpx; line-height: 31rpx; }
.detail-scroll-pad { height: 34rpx; }

.detail-footer {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(205, 197, 182, 0.56);
  background: rgba(251, 247, 238, 0.96);
}

.detail-footer-secondary,
.detail-footer-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  border-radius: 35rpx;
  font-size: 24rpx;
}

.detail-footer-secondary { width: 180rpx; flex: 0 0 180rpx; border: 1rpx solid rgba(76, 105, 93, 0.30); color: var(--ink); }
.detail-footer-primary { flex: 1; background: linear-gradient(135deg, #2f6957, #1e5747); color: #fff; box-shadow: 0 8rpx 19rpx rgba(31, 89, 73, 0.15); }
.detail-footer-primary--disabled { background: #d8d5ce; box-shadow: none; color: #8f8a82; }
.detail-footer-primary--self { background: var(--ink); }

@media (max-width: 350px) {
  .members-body { padding-right: 24rpx; padding-left: 24rpx; }
  .members-hero { margin-top: 62rpx; }
  .hero-top { padding-right: 25rpx; padding-left: 27rpx; }
  .hero-name { max-width: 430rpx; font-size: 35rpx; }
  .member-card { padding-right: 16rpx; padding-left: 16rpx; }
  .member-avatar { width: 65rpx; height: 65rpx; flex-basis: 65rpx; margin-right: 13rpx; }
  .member-name { max-width: 135rpx; }
  .member-side { width: 98rpx; flex-basis: 98rpx; margin-left: 9rpx; }
  .member-action { max-width: 305rpx; }
  .detail-scroll { padding-right: 25rpx; padding-left: 25rpx; }
}
.member-rank {
  width: 40rpx;
  flex: 0 0 40rpx;
  color: #c89b4a;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}
.cache-notice {
  margin: 0 0 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: #f5ead1;
  color: #7a622f;
  font-size: 22rpx;
  line-height: 32rpx;
}

.page-state {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.management-actions {
  padding: 0 30rpx 18rpx;
  display: flex;
  gap: 14rpx;
}
.management-action {
  flex: 1;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(36,91,77,.22);
  border-radius: 36rpx;
  color: #245b4d;
  font-size: 23rpx;
}
.management-action--danger { border-color: rgba(166,80,73,.22); background: rgba(166,80,73,.06); color: #a65049; }

/* Semantic type roles for the member list and its detail sheet. */
.nav-title { font-size: var(--font-page-title); line-height: var(--line-height-page-title); }
.nav-subtitle,
.hero-meta,
.detail-update,
.detail-stat-label,
.detail-action-meta,
.detail-action-status,
.member-progress-text { font-size: var(--font-meta); line-height: var(--line-height-meta); }
.cache-notice,
.empty-copy,
.detail-status-copy,
.privacy-copy { font-size: var(--font-caption); line-height: var(--line-height-caption); }
.hero-eyebrow,
.filter-tab,
.role-chip,
.status-chip,
.member-section-count { font-size: var(--font-tag); line-height: var(--line-height-tag); }
.hero-name { font-size: var(--font-page-title); line-height: var(--line-height-page-title); }
.hero-stat-value,
.detail-stat-value { font-size: var(--font-data); line-height: var(--line-height-data); }
.hero-stat-label { font-size: var(--font-tag); line-height: var(--line-height-tag); }
.search-input,
.member-action,
.detail-status-copy,
.detail-action-title,
.privacy-title { font-size: var(--font-body); line-height: var(--line-height-body); }
.member-section-title,
.detail-section-title { font-size: var(--font-section-title); line-height: var(--line-height-section-title); }
.member-name,
.detail-name { font-size: var(--font-card-title); line-height: var(--line-height-card-title); }
.member-rank,
.member-minutes { font-size: var(--font-body-strong); line-height: var(--line-height-body-strong); }
.encourage-button,
.member-detail-link,
.empty-action,
.management-action,
.detail-footer-secondary,
.detail-footer-primary { font-size: var(--font-body-strong); line-height: var(--line-height-body-strong); }
.detail-stat-value text,
.detail-action-meta { font-size: var(--font-meta); line-height: var(--line-height-meta); }

@media (max-width: 350px) {
  .nav-title,
  .hero-name { font-size: var(--font-page-title-compact); line-height: var(--line-height-page-title); }
  .empty-copy,
  .detail-status-copy,
  .privacy-copy { font-size: var(--font-caption-compact); line-height: var(--line-height-caption); }
  .nav-subtitle,
  .hero-meta,
  .detail-update,
  .detail-stat-label,
  .detail-action-meta,
  .detail-action-status,
  .member-progress-text { font-size: var(--font-meta-compact); line-height: var(--line-height-meta); }
  .member-section-title,
  .detail-section-title { font-size: var(--font-section-title-compact); line-height: var(--line-height-section-title); }
  .member-name,
  .detail-name { font-size: var(--font-card-title-compact); line-height: var(--line-height-card-title); }
  .hero-stat-value,
  .detail-stat-value { font-size: var(--font-data-compact); line-height: var(--line-height-data); }
  .hero-eyebrow,
  .filter-tab,
  .role-chip,
  .status-chip,
  .member-section-count { font-size: var(--font-tag-compact); line-height: var(--line-height-tag); }
}
