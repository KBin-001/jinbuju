.members-page {
  --m-bg: #F6FAF7;
  --m-bg-soft: #EFF8F3;
  --m-primary: #3F8F72;
  --m-primary-deep: #24584A;
  --m-primary-soft: #E6F4EC;
  --m-primary-light: #7CC6A0;
  --m-accent: #7CC6A0;
  --m-gold: #F4C95D;
  --m-gold-soft: #FFF4D8;
  --m-text: #244C43;
  --m-text-2: #6F827B;
  --m-text-3: #9AA8A3;
  --m-border: #E2EEE8;
  --m-card: #FFFFFF;
  --m-shadow: 0 8rpx 28rpx rgba(36, 88, 74, 0.08);
  --m-shadow-soft: 0 4rpx 16rpx rgba(36, 88, 74, 0.05);
  min-height: 100vh;
  background: var(--m-bg);
  box-sizing: border-box;
}

/* ============ 自定义导航栏 ============ */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--m-bg);
  border-bottom: 1rpx solid rgba(226, 238, 232, 0.6);
}

.nav-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
}

.nav-back {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.nav-back::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(36, 88, 74, 0.06);
  transform: translate(-50%, -50%) scale(0);
  transition: transform 0.18s ease;
}

.nav-back:active::after {
  transform: translate(-50%, -50%) scale(1);
}

.nav-back-arrow {
  position: relative;
  z-index: 1;
  color: var(--m-primary);
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1;
  margin-top: -6rpx;
}

.nav-titles {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.nav-title {
  color: var(--m-text);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.nav-subtitle {
  margin-top: 4rpx;
  color: var(--m-text-3);
  font-size: 22rpx;
  line-height: 1.3;
}

/* ============ 主体 ============ */
.members-body {
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ============ 小队概览卡 ============ */
.overview-card {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  height: 240rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #E6F4EC 0%, #F7FBF8 60%, #FFFFFF 100%);
  box-shadow: 0 8rpx 24rpx rgba(36, 88, 74, 0.06);
  color: var(--m-text);
}

.overview-card::before {
  content: "";
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(124, 198, 160, 0.28) 0%, rgba(124, 198, 160, 0) 70%);
  pointer-events: none;
}

.overview-card::after {
  content: "";
  position: absolute;
  bottom: -50rpx;
  right: 80rpx;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(244, 201, 93, 0.18) 0%, rgba(244, 201, 93, 0) 70%);
  pointer-events: none;
}

.overview-main {
  position: relative;
  z-index: 1;
  min-width: 0;
  flex: 1;
}

.overview-label {
  color: var(--m-text-2);
  font-size: 24rpx;
  line-height: 34rpx;
}

.overview-count {
  margin-left: 6rpx;
  color: var(--m-text);
  font-size: 40rpx;
  font-weight: 800;
}

.overview-sep {
  margin: 0 2rpx;
  color: var(--m-text-3);
  font-size: 30rpx;
  font-weight: 600;
}

.overview-max {
  color: var(--m-text-2);
  font-size: 30rpx;
  font-weight: 700;
}

.overview-name {
  margin-top: 16rpx;
  color: var(--m-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.overview-slogan {
  margin-top: 8rpx;
  color: var(--m-text-2);
  font-size: 24rpx;
  line-height: 34rpx;
}

.overview-badge {
  position: relative;
  z-index: 1;
  flex: none;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(124, 198, 160, 0.4);
}

.overview-badge-inner {
  color: var(--m-primary);
  font-size: 36rpx;
  font-weight: 800;
}

/* ============ 搜索区 ============ */
.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
}

.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--m-border);
  box-shadow: var(--m-shadow-soft);
}

.search-icon {
  flex: none;
  color: var(--m-text-3);
  font-size: 32rpx;
  line-height: 1;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  color: var(--m-text);
  font-size: 26rpx;
  line-height: 36rpx;
}

.search-placeholder {
  color: var(--m-text-3);
  font-size: 26rpx;
}

.search-clear {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(154, 168, 163, 0.18);
  color: var(--m-text-2);
  font-size: 28rpx;
  line-height: 1;
}

/* ============ 筛选 Tab ============ */
.filter-tabs {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
}

.filter-tabs::-webkit-scrollbar {
  display: none;
}

.filter-tab {
  flex: none;
  height: 60rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--m-primary-soft);
  color: var(--m-text);
  font-size: 24rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.filter-tab.is-active {
  background: var(--m-primary);
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(63, 143, 114, 0.22);
}

/* ============ Top3 活跃榜 ============ */
.top3-card {
  margin-top: 32rpx;
  padding: 28rpx 28rpx 32rpx;
  border-radius: 32rpx;
  background: var(--m-card);
  box-shadow: var(--m-shadow);
}

.top3-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.top3-title {
  color: var(--m-text);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.top3-action {
  color: var(--m-primary);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.top3-podium {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 20rpx;
  margin-top: 32rpx;
}

.podium-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.podium-1 {
  padding-bottom: 0;
}

.podium-rank {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
  box-shadow: 0 6rpx 16rpx rgba(36, 88, 74, 0.10);
}

.medal-gold {
  background: linear-gradient(135deg, #F4C95D 0%, #E0B04A 100%);
}

.medal-silver {
  background: linear-gradient(135deg, #D5DCD6 0%, #B0BAB3 100%);
}

.medal-bronze {
  background: linear-gradient(135deg, #D8B79A 0%, #B89472 100%);
}

.podium-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 700;
  overflow: hidden;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(36, 88, 74, 0.10);
}

.podium-avatar image {
  width: 100%;
  height: 100%;
  display: block;
}

.podium-avatar-large {
  width: 124rpx;
  height: 124rpx;
  font-size: 44rpx;
  border: 5rpx solid #FFFFFF;
  box-shadow: 0 10rpx 26rpx rgba(244, 201, 93, 0.28);
}

.podium-name {
  margin-top: 14rpx;
  color: var(--m-text);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 34rpx;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.podium-name-large {
  font-size: 28rpx;
}

.podium-minutes {
  margin-top: 4rpx;
  color: var(--m-text-2);
  font-size: 22rpx;
  line-height: 30rpx;
}

.podium-minutes-large {
  color: var(--m-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.podium-2 .podium-avatar,
.podium-3 .podium-avatar {
  opacity: 0.96;
}

.podium-2 {
  transform: translateY(8rpx);
}

.podium-3 {
  transform: translateY(14rpx);
}

/* ============ 头像渐变占位 ============ */
.avatar-grad {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-weight: 700;
  overflow: hidden;
}

.avatar-grad image {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-grad.grad-1 { background: linear-gradient(135deg, #7CC6A0 0%, #3F8F72 100%); }
.avatar-grad.grad-2 { background: linear-gradient(135deg, #68BE8F 0%, #24584A 100%); }
.avatar-grad.grad-3 { background: linear-gradient(135deg, #F4C95D 0%, #D8A53D 100%); }
.avatar-grad.grad-4 { background: linear-gradient(135deg, #8FB7DE 0%, #5C82B2 100%); }
.avatar-grad.grad-5 { background: linear-gradient(135deg, #C9A0D5 0%, #9670A8 100%); }
.avatar-grad.grad-6 { background: linear-gradient(135deg, #E8A593 0%, #C57766 100%); }

/* ============ 成员列表 ============ */
.member-list-card {
  margin-top: 32rpx;
  padding: 8rpx 24rpx 12rpx;
  border-radius: 32rpx;
  background: var(--m-card);
  box-shadow: var(--m-shadow);
}

.member-list-header {
  display: flex;
  align-items: center;
  height: 64rpx;
  border-bottom: 1rpx solid var(--m-border);
}

.member-list-header text {
  color: var(--m-text-3);
  font-size: 22rpx;
  font-weight: 600;
}

.col-member {
  flex: 1;
  min-width: 0;
}

.col-focus {
  width: 130rpx;
  text-align: center;
}

.col-streak {
  width: 100rpx;
  text-align: center;
}

.col-status {
  width: 150rpx;
  text-align: right;
}

.member-row {
  display: flex;
  align-items: center;
  min-height: 124rpx;
  padding: 18rpx 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(226, 238, 232, 0.7);
}

.member-row:last-child {
  border-bottom: 0;
}

.member-row:active {
  background: rgba(36, 88, 74, 0.025);
}

.member-info {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.member-rank {
  flex: none;
  width: 36rpx;
  color: var(--m-text-3);
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.member-avatar {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  font-size: 28rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 4rpx 12rpx rgba(36, 88, 74, 0.08);
}

.member-name-wrap {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.member-name {
  color: var(--m-text);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-tag {
  align-self: flex-start;
  height: 32rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.role-leader {
  background: rgba(124, 198, 160, 0.18);
  color: var(--m-primary);
}

.role-admin {
  background: rgba(244, 201, 93, 0.20);
  color: #8A6B1F;
}

.role-member {
  background: rgba(154, 168, 163, 0.18);
  color: var(--m-text-2);
}

.member-focus {
  width: 130rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 2rpx;
}

.focus-num {
  color: var(--m-text);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1;
}

.focus-unit {
  color: var(--m-text-3);
  font-size: 20rpx;
  font-weight: 600;
}

.member-streak {
  width: 100rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 2rpx;
}

.streak-num {
  color: var(--m-text);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.streak-unit {
  color: var(--m-text-3);
  font-size: 20rpx;
  font-weight: 600;
}

.member-status-wrap {
  width: 150rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.status-tag {
  height: 40rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.status-checked {
  background: var(--m-primary-soft);
  color: var(--m-primary);
}

.status-active {
  background: rgba(124, 198, 160, 0.14);
  color: #3F8F72;
}

.status-normal {
  background: rgba(244, 201, 93, 0.16);
  color: #8A6B1F;
}

.status-unchecked {
  background: rgba(154, 168, 163, 0.18);
  color: var(--m-text-2);
}

.member-arrow {
  flex: none;
  color: var(--m-text-3);
  font-size: 36rpx;
  line-height: 1;
}

/* ============ 空状态 ============ */
.empty-state {
  margin-top: 60rpx;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-state-large {
  margin-top: 120rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--m-primary-soft);
  color: var(--m-accent);
  font-size: 56rpx;
  line-height: 1;
}

.empty-title {
  margin-top: 28rpx;
  color: var(--m-text);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.empty-copy {
  margin-top: 12rpx;
  color: var(--m-text-2);
  font-size: 24rpx;
  line-height: 34rpx;
  max-width: 440rpx;
}

.bottom-safe-area {
  height: env(safe-area-inset-bottom);
}

/* ============ 成员详情 半屏悬浮窗 ============ */
.detail-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(36, 76, 67, 0.36);
  animation: detail-mask-in 0.22s ease both;
}

.detail-sheet {
  position: relative;
  width: 100%;
  height: 75vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  border-radius: 32rpx 32rpx 0 0;
  background: #FFFFFF;
  box-shadow: 0 -12rpx 40rpx rgba(36, 88, 74, 0.12);
  animation: detail-sheet-up 0.28s cubic-bezier(0.22, 0.9, 0.3, 1) both;
  overflow: hidden;
}

@keyframes detail-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes detail-sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.detail-handle-row {
  position: relative;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
}

.detail-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #E2EEE8;
}

.detail-close {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--m-bg-soft);
  color: var(--m-text-2);
  font-size: 36rpx;
  line-height: 1;
}

.detail-close:active {
  background: var(--m-primary-soft);
}

.detail-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 0 32rpx;
}

.detail-base {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 12rpx 0 28rpx;
  border-bottom: 1rpx solid var(--m-border);
}

.detail-avatar {
  flex: none;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  font-size: 44rpx;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(36, 88, 74, 0.12);
}

.detail-base-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.detail-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.detail-name-row .role-tag,
.detail-name-row .status-tag {
  align-self: center;
}

.detail-name {
  color: var(--m-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.detail-joined {
  color: var(--m-text-2);
  font-size: 24rpx;
  line-height: 32rpx;
}

.detail-status-copy {
  color: var(--m-primary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.detail-stats {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 28rpx 8rpx;
  border-radius: 24rpx;
  background: var(--m-bg-soft);
}

.stat-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.stat-num {
  color: var(--m-text);
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
}

.stat-unit {
  color: var(--m-text-2);
  font-size: 22rpx;
  font-weight: 600;
}

.stat-label {
  color: var(--m-text-3);
  font-size: 22rpx;
  line-height: 30rpx;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--m-border);
}

.detail-section {
  margin-top: 32rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  color: var(--m-text);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.section-action {
  color: var(--m-primary);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.trend-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
  height: 220rpx;
  padding: 16rpx 4rpx 0;
  border-radius: 20rpx;
  background: var(--m-bg-soft);
}

.trend-bar-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  height: 100%;
}

.trend-bar-track {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.trend-bar {
  width: 36rpx;
  border-radius: 10rpx;
  background: linear-gradient(180deg, #7CC6A0 0%, #3F8F72 100%);
  transition: height 0.3s ease;
}

.trend-bar.is-today {
  width: 44rpx;
  background: linear-gradient(180deg, #F4C95D 0%, #E0B04A 100%);
  box-shadow: 0 4rpx 12rpx rgba(244, 201, 93, 0.28);
}

.trend-date {
  color: var(--m-text-3);
  font-size: 20rpx;
  line-height: 26rpx;
  white-space: nowrap;
}

.trend-date.is-today {
  color: var(--m-primary);
  font-weight: 700;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: var(--m-bg-soft);
}

.action-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--m-accent);
}

.action-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.action-title {
  color: var(--m-text);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-meta {
  color: var(--m-text-2);
  font-size: 22rpx;
  line-height: 30rpx;
}

.detail-scroll-pad {
  height: 32rpx;
}

.detail-footer {
  flex: none;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--m-border);
  background: #FFFFFF;
}

.detail-secondary {
  flex: none;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 36rpx;
  border-radius: 44rpx;
  border: 1rpx solid #E2EEE8;
  background: #FFFFFF;
  color: var(--m-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.detail-secondary:active {
  background: var(--m-bg-soft);
}

.detail-primary {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  background: var(--m-primary);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(63, 143, 114, 0.24);
}

.detail-primary:active {
  background: var(--m-primary-deep);
}

.detail-primary.is-disabled {
  background: #C9D6D1;
  color: rgba(255, 255, 255, 0.9);
  box-shadow: none;
}

/* ============ 窄屏适配 ============ */
@media (max-width: 340px) {
  .members-body {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }

  .col-focus {
    width: 110rpx;
  }

  .col-streak {
    width: 88rpx;
  }

  .col-status {
    width: 130rpx;
  }

  .member-focus {
    width: 110rpx;
  }

  .member-streak {
    width: 88rpx;
  }

  .member-status-wrap {
    width: 130rpx;
  }

  .member-avatar {
    width: 64rpx;
    height: 64rpx;
    font-size: 24rpx;
  }

  .podium-avatar {
    width: 80rpx;
    height: 80rpx;
    font-size: 30rpx;
  }

  .podium-avatar-large {
    width: 104rpx;
    height: 104rpx;
    font-size: 38rpx;
  }

  .detail-avatar {
    width: 96rpx;
    height: 96rpx;
    font-size: 38rpx;
  }

  .stat-num {
    font-size: 38rpx;
  }

  .trend-bar {
    width: 28rpx;
  }

  .trend-bar.is-today {
    width: 36rpx;
  }

  .detail-footer {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }
}

/* ============ 墨绿成长主题 覆写 ============ */
.members-page[data-theme="inkGreen"] {
  --m-bg: #F5F7F2;
  --m-bg-soft: #F0F5F1;
  --m-primary: #356859;
  --m-primary-deep: #1F5B4A;
  --m-primary-soft: #EAF5EF;
  --m-primary-light: #7FAA91;
  --m-accent: #356859;
  --m-gold: #F4C95D;
  --m-gold-soft: #FFF2CD;
  --m-text: #183F35;
  --m-text-2: #6D8179;
  --m-text-3: #9AA9A4;
  --m-border: #DDEBE4;
  --m-card: #FFFFFF;
  --m-shadow: 0 10rpx 28rpx rgba(20, 82, 63, 0.10);
  --m-shadow-soft: 0 4rpx 16rpx rgba(20, 82, 63, 0.05);
}

.members-page[data-theme="inkGreen"] .nav-bar {
  border-bottom-color: rgba(20, 82, 63, 0.08);
}

.members-page[data-theme="inkGreen"] .detail-primary {
  background: var(--m-primary);
  box-shadow: 0 10rpx 24rpx rgba(31, 111, 85, 0.26);
}

.members-page[data-theme="inkGreen"] .detail-primary.is-disabled {
  background: #C9DDD3;
}
