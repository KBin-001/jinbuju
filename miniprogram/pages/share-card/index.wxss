page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #70837b;
}

.share-page {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  color: #24312d;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.share-backdrop {
  position: absolute;
  inset: 0;
  background: #81938c;
}

.share-close {
  position: absolute;
  left: 28rpx;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(36, 91, 77, 0.12);
  border-radius: 14rpx;
  background: rgba(255, 252, 246, 0.94);
  color: #245b4d;
  box-shadow: 0 8rpx 20rpx rgba(28, 51, 44, 0.12);
}

.share-close::after,
.state-button::after { border: 0; }

.share-scroll {
  position: absolute;
  inset: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
}

.share-content {
  box-sizing: border-box;
  width: 100%;
  padding-right: 26rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 34rpx);
  padding-left: 26rpx;
}

.share-sheet {
  width: 100%;
  max-width: 700rpx;
  margin: 0 auto;
  overflow: hidden;
  border-radius: 28rpx;
  background: #f7f3ea;
  box-shadow: 0 28rpx 68rpx rgba(25, 48, 41, 0.26);
}

.template-switch {
  position: relative;
  z-index: 3;
  width: 100%;
  white-space: nowrap;
  background: rgba(247, 243, 234, 0.96);
}

.template-switch__inner {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  min-width: 100%;
  box-sizing: border-box;
  padding: 30rpx 34rpx 18rpx;
}

.template-tab {
  position: relative;
  display: flex;
  flex: 1 0 auto;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  padding: 0 10rpx;
  color: #666d69;
  font-size: 25rpx;
  letter-spacing: 1rpx;
}

.template-tab.is-active {
  color: #245b4d;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 28rpx;
  font-weight: 700;
}

.template-tab.is-disabled { opacity: 0.38; }

.template-tab__line {
  position: absolute;
  bottom: -6rpx;
  left: 50%;
  width: 42rpx;
  height: 5rpx;
  transform: translateX(-50%);
  border-radius: 999rpx;
  background: #c89b4a;
}

.share-card {
  position: relative;
  min-height: 1120rpx;
  overflow: hidden;
  background: #f7f3ea;
}

.share-landscape {
  position: absolute;
  right: -180rpx;
  bottom: 128rpx;
  width: 900rpx;
  height: 900rpx;
  opacity: 0.62;
  pointer-events: none;
}

.share-card::before {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: rgba(247, 243, 234, 0.18);
  content: "";
  pointer-events: none;
}

.share-card-body {
  position: relative;
  z-index: 2;
  padding: 42rpx 46rpx 40rpx;
}

.share-identity,
.identity-person,
.identity-goal-row,
.share-progress-row,
.list-head,
.privacy-control,
.completed-item,
.share-growth-strip,
.growth-item {
  display: flex;
  align-items: center;
}

.share-identity { justify-content: space-between; }
.identity-person { min-width: 0; }

.share-avatar {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  overflow: hidden;
  border: 3rpx solid rgba(255, 252, 246, 0.9);
  border-radius: 50%;
  background: #e4eee9;
}

.share-avatar image { width: 100%; height: 100%; }

.identity-copy {
  min-width: 0;
  margin-left: 20rpx;
}

.identity-name {
  max-width: 210rpx;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.identity-goal-row { margin-top: 9rpx; }

.identity-label {
  flex: 0 0 auto;
  color: #737975;
  font-size: 21rpx;
}

.identity-goal {
  max-width: 180rpx;
  overflow: hidden;
  margin-left: 16rpx;
  color: #245b4d;
  font-size: 24rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.identity-date {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: flex-end;
  color: #4f5652;
  font-size: 22rpx;
  line-height: 1.5;
}

.identity-date__sub { color: #8a8e8a; font-size: 19rpx; }

.share-hero { margin-top: 76rpx; }

.hero-label {
  color: #245b4d;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 60rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  line-height: 1.14;
}

.hero-result {
  display: flex;
  align-items: flex-end;
  margin-top: 10rpx;
  line-height: 1;
}

.hero-number {
  color: #c28f35;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 116rpx;
  font-weight: 600;
  letter-spacing: -4rpx;
}

.hero-unit {
  margin-bottom: 12rpx;
  margin-left: 20rpx;
  color: #245b4d;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 72rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.hero-stroke {
  width: 84rpx;
  height: 5rpx;
  margin-top: 6rpx;
  margin-left: 5rpx;
  transform: rotate(-3deg);
  border-radius: 999rpx;
  background: #c89b4a;
  box-shadow: 14rpx 1rpx 0 -1rpx rgba(200, 155, 74, 0.5);
}

.hero-investment {
  margin-top: 30rpx;
  color: #515955;
  font-size: 27rpx;
  letter-spacing: 3rpx;
}

.share-progress-row {
  min-height: 252rpx;
  margin-top: 60rpx;
}

.goal-ring {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 202rpx;
  height: 202rpx;
  border-radius: 50%;
}

.goal-ring-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 164rpx;
  height: 164rpx;
  border-radius: 50%;
  background: rgba(247, 243, 234, 0.94);
  color: #245b4d;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 53rpx;
  line-height: 1;
}

.goal-ring-inner text {
  margin-top: 13rpx;
  color: #666d69;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 21rpx;
}

.progress-divider {
  position: relative;
  flex: 0 0 auto;
  width: 1rpx;
  height: 124rpx;
  margin: 0 36rpx;
  background: rgba(200, 155, 74, 0.62);
}

.progress-divider__dot {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 11rpx;
  height: 11rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: #c89b4a;
}

.share-list { min-width: 0; flex: 1; }
.list-head { align-items: flex-start; justify-content: space-between; }

.list-title {
  color: #245b4d;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 27rpx;
}

.privacy-control {
  flex: 0 0 auto;
  margin-left: 10rpx;
  color: #7c817d;
  font-size: 17rpx;
}

.privacy-control switch {
  margin-left: 5rpx;
  transform: scale(0.52);
  transform-origin: right top;
}

.completed-list { margin-top: 25rpx; }

.completed-item {
  min-width: 0;
  color: #303733;
  font-size: 25rpx;
  line-height: 38rpx;
}

.completed-item + .completed-item { margin-top: 13rpx; }

.completed-item > text {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.completed-check {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #2f6a5b;
  color: #fffdf8;
}

.hidden-summary {
  margin-top: 24rpx;
  color: #646b67;
  font-size: 22rpx;
  line-height: 1.5;
}

.share-encouragement {
  display: flex;
  align-items: stretch;
  margin-top: 62rpx;
}

.encouragement-rule {
  flex: 0 0 auto;
  width: 4rpx;
  min-height: 104rpx;
  background: #c89b4a;
}

.encouragement-copy {
  margin-left: 22rpx;
  color: #245b4d;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 34rpx;
  line-height: 1.45;
  letter-spacing: 2rpx;
}

.encouragement-copy text {
  display: block;
  margin-top: 12rpx;
  color: #747a76;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 21rpx;
  letter-spacing: 1rpx;
}

.share-growth-strip {
  justify-content: space-around;
  margin-top: 62rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(200, 155, 74, 0.65);
}

.growth-item { min-width: 0; }

.growth-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  margin-right: 20rpx;
  color: #245b4d;
}

.growth-label { color: #737975; font-size: 21rpx; }

.growth-value {
  margin-top: 2rpx;
  color: #245b4d;
  font-size: 21rpx;
}

.growth-value text {
  margin-right: 8rpx;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 41rpx;
}

.growth-divider {
  width: 1rpx;
  height: 64rpx;
  margin: 0 20rpx;
  background: rgba(200, 155, 74, 0.56);
}

.save-image-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100rpx;
  margin: 8rpx 30rpx 0;
  overflow: hidden;
  color: #fffdf8;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.save-image-button:active { opacity: 0.84; }
.save-image-button.is-saving { opacity: 0.58; pointer-events: none; }

.save-brush {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.save-image-button text {
  position: relative;
  z-index: 1;
  margin-left: 70rpx;
}

.save-tip {
  padding: 13rpx 0 28rpx;
  color: #7c817d;
  text-align: center;
  font-size: 20rpx;
}

.share-state {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
  color: #fff;
  text-align: center;
}

.state-dot {
  width: 20rpx;
  height: 20rpx;
  margin-bottom: 22rpx;
  border-radius: 50%;
  background: #d8b063;
  box-shadow: 0 0 0 12rpx rgba(216, 176, 99, 0.18);
  animation: share-pulse 1.1s ease-in-out infinite;
}

.state-title { font-size: 32rpx; font-weight: 700; }
.state-copy { margin-top: 12rpx; color: rgba(255,255,255,.76); font-size: 24rpx; }

.state-button {
  margin-top: 28rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  background: #fffdf8;
  color: #245b4d;
  font-size: 25rpx;
}

.share-canvas-host {
  position: fixed;
  right: 0;
  bottom: 0;
  z-index: -1;
  width: 1px;
  height: 1px;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
}

.share-canvas { width: 1px; height: 1px; }

@keyframes share-pulse {
  0%, 100% { transform: scale(0.88); opacity: 0.72; }
  50% { transform: scale(1); opacity: 1; }
}

@media (max-width: 340px) {
  .share-content { padding-right: 18rpx; padding-left: 18rpx; }
  .template-switch__inner { padding-right: 20rpx; padding-left: 20rpx; }
  .template-tab { padding-right: 5rpx; padding-left: 5rpx; font-size: 22rpx; }
  .share-card-body { padding-right: 34rpx; padding-left: 34rpx; }
  .hero-unit { font-size: 62rpx; }
  .goal-ring { width: 178rpx; height: 178rpx; }
  .goal-ring-inner { width: 144rpx; height: 144rpx; }
  .progress-divider { margin-right: 24rpx; margin-left: 24rpx; }
  .identity-date__sub { display: none; }
}

/* Semantic type roles for share-card identity, progress and save actions. */
.template-tab { font-size: var(--font-tag); line-height: var(--line-height-tag); }
.identity-name,
.identity-goal,
.list-title,
.completed-item,
.encouragement-copy { font-size: var(--font-body-strong); line-height: var(--line-height-body-strong); }
.identity-label,
.hero-label,
.hero-unit,
.identity-date__sub,
.growth-label,
.save-tip { font-size: var(--font-meta); line-height: var(--line-height-meta); }
.hero-number { font-size: var(--font-data-hero); line-height: var(--line-height-data); }
.hero-investment,
.hidden-summary { font-size: var(--font-caption); line-height: var(--line-height-caption); }
.growth-value { font-size: var(--font-data); line-height: var(--line-height-data); }
.save-image-button,
.state-button { font-size: var(--font-body-strong); line-height: var(--line-height-body-strong); }
.state-title { font-size: var(--font-card-title); line-height: var(--line-height-card-title); }
.state-copy { font-size: var(--font-caption); line-height: var(--line-height-caption); }

@media (max-width: 340px) {
  .template-tab { font-size: var(--font-tag-compact); line-height: var(--line-height-tag); }
  .identity-name,
  .identity-goal,
  .list-title,
  .completed-item,
  .encouragement-copy { font-size: var(--font-body-compact); line-height: var(--line-height-body); }
  .identity-label,
  .hero-label,
  .hero-unit,
  .identity-date__sub,
  .growth-label,
  .save-tip { font-size: var(--font-meta-compact); line-height: var(--line-height-meta); }
  .hero-number,
  .growth-value { font-size: var(--font-data-compact); line-height: var(--line-height-data); }
  .state-title { font-size: var(--font-card-title-compact); line-height: var(--line-height-card-title); }
  .state-copy { font-size: var(--font-caption-compact); line-height: var(--line-height-caption); }
}
