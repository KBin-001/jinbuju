page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #71877E;
}

.share-page {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #DCE5DF;
  color: #233B34;
}

.share-backdrop {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 16% 8%, rgba(255, 255, 255, 0.32), transparent 34%),
    linear-gradient(180deg, #AEBFB6 0%, #71877E 100%);
  filter: saturate(0.82);
}

.share-close {
  position: absolute;
  top: 52px;
  left: 30rpx;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  color: #356859;
  font-size: 54rpx;
  font-weight: 400;
  line-height: 1;
  box-shadow: 0 6rpx 18rpx rgba(31, 70, 58, 0.14);
}

.share-close::after,
.save-image-button::after,
.state-button::after {
  border: 0;
}

.share-scroll {
  position: absolute;
  inset: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
}

.share-content {
  width: 100%;
  box-sizing: border-box;
  padding: 122px 32rpx calc(env(safe-area-inset-bottom) + 42rpx);
}
.template-switch { width: 100%; margin-bottom: 20rpx; white-space: nowrap; }
.template-switch__inner { display: inline-flex; gap: 12rpx; padding: 0 4rpx; }
.template-chip { padding: 14rpx 22rpx; border: 1rpx solid rgba(36,91,77,.18); border-radius: 999rpx; background: rgba(255,252,246,.9); color: var(--color-text-secondary); font-size: 23rpx; }
.template-chip.is-active { border-color: var(--color-primary); background: var(--color-primary); color: #fff; }
.template-chip.is-disabled { opacity: .42; }

.share-card {
  width: 100%;
  max-width: 686rpx;
  margin: 0 auto;
  overflow: hidden;
  border-radius: 38rpx;
  background: #FBFCF8;
  box-shadow: 0 28rpx 70rpx rgba(26, 55, 47, 0.28);
}

.share-brand-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 32rpx;
  background: #356859;
  color: #FFFFFF;
}

.brand-name {
  min-width: 0;
  font-size: 25rpx;
  font-weight: 700;
  white-space: nowrap;
}

.brand-mark, .signature-mark { display: inline-block; width: 14rpx; height: 14rpx; margin-right: 12rpx; transform: rotate(45deg); border-radius: 3rpx; background: #E4C06A; }

.brand-date {
  flex: 0 0 auto;
  margin-left: 18rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 21rpx;
}

.share-card-body {
  padding: 34rpx 34rpx 30rpx;
}

.share-identity {
  display: flex;
  align-items: center;
}

.share-avatar {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  overflow: hidden;
  border-radius: 50%;
  background: #E3F1E8;
  color: #356859;
  font-size: 34rpx;
  font-weight: 800;
}

.share-avatar image {
  width: 100%;
  height: 100%;
}

.identity-copy {
  min-width: 0;
  margin-left: 22rpx;
}

.identity-name {
  overflow: hidden;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.identity-goal-row {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 6rpx;
}

.identity-chip {
  flex: 0 0 auto;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #FFF1C7;
  color: #A87B18;
  font-size: 20rpx;
  font-weight: 600;
}

.identity-goal {
  overflow: hidden;
  margin-left: 10rpx;
  color: #71827A;
  font-size: 23rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.share-core-card,
.share-list-card {
  border: 1rpx solid #EEF2EF;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: none;
}

.share-core-card {
  display: flex;
  align-items: center;
  min-height: 220rpx;
  margin-top: 34rpx;
  padding: 26rpx 32rpx;
}

.core-left {
  min-width: 0;
  flex: 1;
}

.core-label,
.core-minutes {
  color: #71827A;
  font-size: 23rpx;
}

.core-count {
  margin-top: 8rpx;
  color: #233B34;
  font-size: 32rpx;
  font-weight: 600;
}

.core-count > text:first-child {
  font-size: 54rpx;
  line-height: 64rpx;
  font-weight: 800;
}

.core-total {
  color: #71827A;
}

.core-minutes {
  margin-top: 10rpx;
  white-space: nowrap;
}

.timer-icon {
  margin-right: 8rpx;
  color: #57A183;
  font-size: 26rpx;
}

.core-divider {
  width: 1rpx;
  height: 120rpx;
  margin: 0 26rpx;
  background: #E9EFEA;
}

.goal-ring {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 154rpx;
  height: 154rpx;
  border-radius: 50%;
}

.goal-ring-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 126rpx;
  height: 126rpx;
  border-radius: 50%;
  background: #FFFFFF;
  color: #356859;
  font-size: 39rpx;
  font-weight: 800;
}

.goal-ring-inner text {
  margin-top: 2rpx;
  color: #71827A;
  font-size: 19rpx;
  font-weight: 400;
}

.share-list-card {
  margin-top: 24rpx;
  padding: 26rpx 30rpx;
}

.list-head,
.privacy-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.list-title {
  font-size: 26rpx;
  font-weight: 700;
}

.privacy-control {
  color: #71827A;
  font-size: 20rpx;
}

.privacy-control switch {
  margin-left: 8rpx;
  transform: scale(0.62);
  transform-origin: right center;
}

.completed-list {
  margin-top: 24rpx;
}

.completed-item {
  display: flex;
  align-items: center;
  min-width: 0;
  color: #233B34;
  font-size: 24rpx;
  line-height: 36rpx;
}

.completed-item + .completed-item {
  margin-top: 16rpx;
}

.completed-item text {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.completed-check {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #356859;
  color: #FFFFFF;
  font-size: 21rpx;
  font-weight: 800;
}

.hidden-summary {
  margin-top: 24rpx;
  color: #356859;
  font-size: 25rpx;
  font-weight: 700;
}

.share-growth-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  background: #EAF5EF;
}

.growth-item {
  display: flex;
  align-items: center;
  min-width: 0;
  white-space: nowrap;
}

.growth-icon {
  color: #356859;
  font-size: 25rpx;
}

.growth-icon.is-yellow {
  color: #C99B2E;
}

.growth-label {
  margin-left: 8rpx;
  color: #71827A;
  font-size: 20rpx;
}

.growth-value {
  margin-left: 8rpx;
  font-size: 23rpx;
  font-weight: 800;
}

.growth-divider {
  width: 1rpx;
  height: 34rpx;
  margin: 0 12rpx;
  background: #CFDED6;
}

.share-encouragement {
  margin-top: 34rpx;
  text-align: center;
  font-size: 27rpx;
  line-height: 40rpx;
  font-weight: 700;
}

.share-signature {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #E6EEE9;
  color: #71827A;
  text-align: center;
  font-size: 21rpx;
}

.share-signature text {
  margin-right: 8rpx;
  color: #57A183;
}

.share-save-area {
  width: 100%;
  max-width: 686rpx;
  margin: 34rpx auto 0;
}

.save-image-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 100%;
  height: 92rpx;
  box-sizing: border-box;
  margin: 0;
  border-radius: 28rpx;
  background: #356859;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 30rpx rgba(31, 70, 58, 0.25);
}

.save-icon {
  margin-right: 14rpx;
  font-size: 36rpx;
}

.save-tip {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.72);
  text-align: center;
  font-size: 20rpx;
}

.share-state {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
  color: #FFFFFF;
  text-align: center;
}

.state-dot {
  width: 22rpx;
  height: 22rpx;
  margin-bottom: 22rpx;
  border-radius: 50%;
  background: #F8D26A;
  box-shadow: 0 0 0 12rpx rgba(248, 210, 106, 0.18);
  animation: share-pulse 1.1s ease-in-out infinite;
}

.state-title {
  font-size: 32rpx;
  font-weight: 700;
}

.state-copy {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
}

.state-button {
  margin-top: 28rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #356859;
  font-size: 25rpx;
}

.share-canvas-host {
  position: fixed;
  right: 0;
  bottom: 0;
  z-index: -1;
  width: 1px;
  height: 1px;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
}

.share-canvas {
  width: 1px;
  height: 1px;
}

@keyframes share-pulse {
  0%, 100% { transform: scale(0.88); opacity: 0.72; }
  50% { transform: scale(1); opacity: 1; }
}

@media (max-width: 340px) {
  .share-content { padding-right: 22rpx; padding-left: 22rpx; }
  .share-card-body { padding-right: 26rpx; padding-left: 26rpx; }
  .share-core-card { padding-right: 24rpx; padding-left: 24rpx; }
  .core-divider { margin-right: 18rpx; margin-left: 18rpx; }
  .goal-ring { width: 138rpx; height: 138rpx; }
  .goal-ring-inner { width: 112rpx; height: 112rpx; }
  .share-growth-strip { padding-right: 16rpx; padding-left: 16rpx; }
  .growth-label { display: none; }
}
