<view class="preview-page">
  <view class="preview-header">
    <button class="preview-back" disabled="{{confirming || savingTask || regenerating}}" bindtap="goBack">‹</button>
    <view class="preview-header-title">行动计划预览</view>
    <view class="preview-header-space"></view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="preview-state">
    <ant-loading type="spin" size="large" color="#356859" />
    <view class="state-title">{{isV2Create ? '正在读取行动方案' : '正在读取行动计划'}}</view>
    <view class="state-description">请稍等，正在加载方案内容。</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="preview-state">
    <view class="state-mark">!</view>
    <view class="state-title">计划加载遇到问题</view>
    <view class="state-description">{{errorMessage}}</view>
    <ant-button type="primary" className="growth-primary-button" bindtap="retry">重新加载</ant-button>
    <button class="text-action" bindtap="editGoal">{{isNextStage ? '返回阶段复盘' : '返回修改目标'}}</button>
  </view>

  <block wx:else>
    <scroll-view class="plan-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="plan-content">
        <!-- Regenerating overlay -->
        <view wx:if="{{regenerating}}" class="regen-overlay">
          <ant-loading type="spin" size="large" color="#356859" />
          <view class="regen-title">正在根据你的反馈调整行动方案</view>
          <view class="regen-subtitle">我们会重新检查任务量、难度、行动方式和时间安排。</view>
        </view>

        <ant-notice wx:if="{{preview.generatedBy === 'template'}}" type="error" className="optimization-failed" ellipsisRow="{{3}}">
          <view>
            <view class="notice-title">当前是基础兜底方案</view>
            <view>AI 没有返回可用计划，已临时使用模板。原因：{{preview.fallbackReason || '暂未返回'}}</view>
          </view>
          <button wx:if="{{isNextStage && preview.previousStageId}}" bindtap="editGoal">重新复盘生成</button>
        </ant-notice>
        <ant-notice wx:elif="{{isV2Create && preview.generatedBy === 'ai_repaired'}}" type="info" className="optimization-notice">
          <view class="notice-title">方案已完成自动修正</view>
          <view>系统已根据校验结果整理为可执行的行动阶段。</view>
        </ant-notice>
        <ant-notice wx:elif="{{isV2Create && (preview.generatedBy === 'regenerated_ai' || preview.generatedBy === 'regenerated_ai_repaired')}}" type="primary" className="optimization-notice regen-success">
          <view class="notice-title">方案已根据你的反馈重新生成</view>
          <view>这是第 {{preview.currentVersion}} 版方案。</view>
        </ant-notice>

        <view wx:if="{{justGenerated && !regenerating}}" class="plan-ready-hero" bindtap="dismissJustGenerated">
          <view class="plan-ready-icon">
            <view class="plan-ready-check">✓</view>
            <view class="plan-ready-ring"></view>
          </view>
          <view class="plan-ready-text">
            <view class="plan-ready-title">行动方案已生成</view>
            <view class="plan-ready-desc">请查看下方方案，确认后立即开始今日行动</view>
          </view>
          <view class="plan-ready-arrow">↓</view>
        </view>

        <view class="ai-ready-banner preview-ai-hero">
          <view class="ai-ready-mark">AI</view>
          <view>
            <view class="ai-ready-title">完整行动计划已准备好</view>
            <view class="ai-ready-copy">已生成全部 {{preview.stagePlan.stage.planDurationDays || preview.stagePlan.stage.durationDays}} 天行动，可按周展开查看。</view>
          </view>
        </view>

        <ant-card className="plan-hero growth-ant-card growth-hero">
          <view class="plan-label">计划周期 · {{preview.stagePlan.stage.planDurationDays || preview.stagePlan.stage.durationDays}} 天</view>
          <view class="plan-summary">{{preview.stagePlan.stage.title}}</view>
          <view class="weekly-goal">
            <view class="weekly-goal-label">阶段重点</view>
            <view>{{preview.stagePlan.stage.focus}}</view>
          </view>
          <view class="stage-summary">{{preview.stagePlan.stage.summary}}</view>
        </ant-card>

        <view wx:if="{{preview.stagePlan.outline}}" class="plan-outline-card">
          <view class="outline-head">
            <view class="outline-title">完整行动路线</view>
            <view class="outline-hint">左右滑动查看各阶段</view>
          </view>
          <scroll-view class="outline-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="outline-track">
              <view wx:for="{{preview.stagePlan.outline.blocks}}" wx:key="blockIndex" class="outline-block">
                <view class="outline-index">第 {{item.startDay}}–{{item.endDay}} 天</view>
                <view class="outline-copy"><view>{{item.focus}}</view><text>{{item.objective}}</text></view>
              </view>
            </view>
          </scroll-view>
        </view>

        <view wx:for="{{weeks}}" wx:key="number" wx:for-item="week" class="week-card">
          <button class="week-header" data-week="{{week.number}}" bindtap="toggleWeek">
            <view>第 {{week.number}} 周</view>
            <view>{{week.expanded ? '收起' : '展开'}}</view>
          </button>
          <block wx:if="{{week.expanded}}">
            <view
              wx:for="{{week.days}}"
              wx:key="dayIndex"
              wx:for-item="day"
              class="day-card {{day.actions.length === 0 ? 'rest-card' : ''}}"
            >
              <view class="day-header">
                <view>
                  <view class="day-index">第 {{day.dayIndex}} 天</view>
                  <view class="day-title">{{day.theme}}</view>
                </view>
                <view class="day-type">{{day.actions.length === 0 ? '休息日' : day.totalMinutes + ' 分钟'}}</view>
              </view>
              <view wx:if="{{day.actions.length === 0}}" class="rest-copy">
                今天不安排任务，可以休息或简单整理前面的成果。
              </view>
              <view
                wx:for="{{day.actions}}"
                wx:key="slotId"
                wx:for-item="action"
                class="task-row"
              >
                <block wx:if="{{editingSlotId === action.slotId}}">
                  <view class="edit-form">
                    <view class="edit-label">任务名称</view>
                    <ant-input controlled="{{true}}" maxLength="{{40}}" value="{{editTitle}}" bindchange="inputEditTitle" />
                    <view class="edit-label">任务说明</view>
                    <ant-textarea controlled="{{true}}" maxLength="{{150}}" value="{{editDescription}}" bindchange="inputEditDescription" />
                    <view class="edit-label">预计分钟数</view>
                    <ant-input controlled="{{true}}" type="number" value="{{editMinutes}}" bindchange="inputEditMinutes" />
                    <view class="edit-actions">
                      <button disabled="{{savingTask}}" bindtap="cancelEdit">取消</button>
                      <button class="save-button" loading="{{savingTask}}" disabled="{{savingTask}}" bindtap="saveTask">保存</button>
                    </view>
                  </view>
                </block>
                <block wx:else>
                  <view class="task-main">
                    <view class="task-name">{{action.title}}</view>
                    <view wx:if="{{action.actionTypeLabel}}" class="task-type">{{action.actionTypeLabel}}</view>
                    <view class="task-description">{{action.description}}</view>
                    <view wx:if="{{action.completionCriteria}}" class="task-extra">
                      <text class="task-extra-label">完成标准</text>
                      <text>{{action.completionCriteria}}</text>
                    </view>
                    <view wx:if="{{action.resourceText}}" class="task-extra">
                      <text class="task-extra-label">所需资源</text>
                      <text>{{action.resourceText}}</text>
                    </view>
                    <view wx:if="{{action.safetyText}}" class="task-extra safety-extra">
                      <text class="task-extra-label">安全提醒</text>
                      <text>{{action.safetyText}}</text>
                    </view>
                    <view class="task-time">预计 {{action.estimatedMinutes}} 分钟</view>
                  </view>
                  <button
                    wx:if="{{isV2Create && !regenerating}}"
                    class="edit-button"
                    data-slot-id="{{action.slotId}}"
                    bindtap="beginEdit"
                  >编辑</button>
                </block>
              </view>
            </view>
          </block>
        </view>

        <!-- Feedback suitability section -->
        <view wx:if="{{isV2Create && !regenerating}}" class="feedback-section">
          <view class="feedback-question">这个方案适合你吗？</view>

          <view wx:if="{{regenerationError}}" class="regen-error">
            <view>{{regenerationError}}</view>
          </view>

          <ant-popup visible="{{showFeedbackPanel}}" position="bottom" title="调整行动方案" showClose="{{true}}" className="feedback-popup" bindclose="closeFeedbackPanel">
          <view class="feedback-panel">
            <view class="feedback-hint">告诉我们哪里不合适，AI 会重新设计整个阶段，而不是只修改几句话。</view>

            <view class="feedback-options">
              <button
                wx:for="{{feedbackOptions}}"
                wx:key="type"
                wx:for-item="option"
                class="feedback-chip {{feedbackTypeSet[option.type] ? 'selected' : ''}}"
                data-type="{{option.type}}"
                aria-label="{{option.label}}{{feedbackTypeSet[option.type] ? '，已选择' : '，未选择'}}"
                aria-pressed="{{feedbackTypeSet[option.type]}}"
                hover-class="feedback-chip-pressed"
                bindtap="toggleFeedbackType"
              >
                <view class="feedback-chip-mark">{{feedbackTypeSet[option.type] ? '✓' : ''}}</view>
                <text>{{option.label}}</text>
              </button>
            </view>

            <view wx:if="{{hasOtherFeedback || selectedFeedbackTypes.length > 0}}" class="feedback-note-section">
              <view class="edit-label">补充说明（可选，最多 200 字）</view>
              <ant-textarea
                className="feedback-note-input"
                controlled="{{true}}"
                maxLength="{{200}}"
                placeholder="例如：我暂时无法去付费场馆"
                value="{{feedbackNote}}"
                bindchange="inputFeedbackNote"
              />
              <view class="note-counter">{{feedbackNote.length}}/200</view>
            </view>

            <view class="feedback-remaining">
              剩余重新生成次数：{{preview.maxRegenerationCount - preview.regenerationCount}}
            </view>

            <view class="feedback-actions">
              <ant-button type="default" className="feedback-cancel" disabled="{{regenerating}}" bindtap="closeFeedbackPanel">取消</ant-button>
              <ant-button
                type="primary"
                className="feedback-submit"
                loading="{{regenerating}}"
                disabled="{{regenerating || selectedFeedbackTypes.length === 0}}"
                bindtap="submitRegeneration"
              >重新生成方案</ant-button>
            </view>
          </view>
          </ant-popup>
        </view>

        <view class="plan-bottom-spacer"></view>
      </view>
    </scroll-view>

    <view class="preview-actions {{justGenerated ? 'preview-actions-highlight' : ''}}">
      <view wx:if="{{justGenerated}}" class="confirm-hint-bar">
        <view class="confirm-hint-dot"></view>
        <text>方案已就绪，点击下方按钮确认开始</text>
      </view>
      <block wx:if="{{isV2Create && !showFeedbackPanel && !regenerating}}">
        <view class="actions-row">
          <ant-button type="primary" className="confirm-button {{justGenerated ? 'confirm-button-pulse' : ''}}" loading="{{confirming}}" disabled="{{confirming || savingTask}}" bindtap="confirmStage">
            确认并开始
          </ant-button>
          <view class="adjust-button-wrapper">
            <ant-button type="default" className="adjust-button" disabled="{{confirming || (preview.maxRegenerationCount - preview.regenerationCount) <= 0}}" bindtap="openFeedbackPanel">
              需要调整
            </ant-button>
            <view wx:if="{{(preview.maxRegenerationCount - preview.regenerationCount) <= 0}}" class="adjust-disabled-hint">已用完重新生成次数</view>
          </view>
        </view>
        <button wx:if="{{!showFeedbackPanel}}" class="text-action" disabled="{{confirming || regenerating}}" bindtap="editGoal">调整目标设置</button>
      </block>
      <block wx:elif="{{!isV2Create}}">
        <view class="actions-row">
          <ant-button type="primary" className="confirm-button {{justGenerated ? 'confirm-button-pulse' : ''}}" loading="{{confirming}}" disabled="{{confirming || savingTask}}" bindtap="confirmStage">
            确认并开始
          </ant-button>
        </view>
      </block>
      <block wx:else>
        <view class="actions-row">
          <ant-button type="primary" className="confirm-button" disabled="{{true}}">调整中...</ant-button>
        </view>
        <button wx:if="{{!showFeedbackPanel}}" class="text-action" disabled="{{confirming || regenerating}}" bindtap="editGoal">调整目标设置</button>
      </block>
    </view>
  </block>
</view>
