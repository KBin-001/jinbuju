<view class="preview-page">
  <view class="preview-header">
    <button class="preview-back" disabled="{{generating || confirming}}" bindtap="goBack">‹</button>
    <view class="preview-header-title">行动阶段预览</view>
    <view class="preview-header-space"></view>
  </view>

  <view wx:if="{{status === 'initial'}}" class="preview-state">
    <view class="loading-dot"></view><view class="state-title">正在读取行动阶段</view>
  </view>
  <view wx:elif="{{status === 'generating'}}" class="preview-state generating-state">
    <view class="generation-visual"><view class="generation-ring"></view><view class="generation-number">1</view></view>
    <view class="generation-title">正在为你拆解第一个行动阶段</view>
    <view class="generation-description">这通常只需要一点时间</view>
    <view class="generation-stage">{{stageText}}</view>
  </view>
  <view wx:elif="{{status === 'error'}}" class="preview-state">
    <view class="state-mark">!</view><view class="state-title">阶段生成遇到问题</view>
    <view class="state-description">{{errorMessage}}</view>
    <button class="primary-button" bindtap="retry">{{isNextStage ? '重新加载' : '重新生成'}}</button>
    <button wx:if="{{input}}" class="outline-action" bindtap="useFallback">使用基础行动方案</button>
    <button class="text-action" bindtap="editGoal">{{isNextStage ? '返回阶段复盘' : '返回修改目标'}}</button>
  </view>

  <scroll-view wx:else class="plan-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="plan-content">
      <view wx:if="{{status === 'fallback'}}" class="fallback-notice">
        已为你生成一份基础行动方案，稍后可以继续调整。
      </view>
      <view class="plan-hero">
        <view class="plan-label">第 {{preview.stageNumber}} 个行动阶段 · {{preview.stagePlan.stage.durationDays}} 天</view>
        <view class="plan-summary">{{preview.stagePlan.stage.title}}</view>
        <view class="weekly-goal">
          <view class="weekly-goal-label">阶段重点</view>
          <view>{{preview.stagePlan.stage.focus}}</view>
        </view>
        <view class="stage-summary">{{preview.stagePlan.stage.summary}}</view>
      </view>
      <view wx:for="{{preview.stagePlan.days}}" wx:key="dayIndex" class="day-card">
        <view class="day-header">
          <view>
            <view class="day-index">第 {{item.dayIndex}} 天 · 预计 {{item.totalMinutes}} 分钟</view>
            <view class="day-title">{{item.theme}}</view>
          </view>
          <view class="day-type">{{item.actions.length}} 项行动</view>
        </view>
        <view wx:for="{{item.actions}}" wx:for-item="action" wx:key="title" class="task-row">
          <view class="task-order">{{index + 1}}</view>
          <view class="task-main">
            <view class="task-name">{{action.title}}</view>
            <view class="task-description">{{action.description}}</view>
            <view class="task-time">预计 {{action.estimatedMinutes}} 分钟</view>
          </view>
        </view>
      </view>
      <view class="plan-bottom-spacer"></view>
    </view>
  </scroll-view>

  <view wx:if="{{status === 'success' || status === 'fallback'}}" class="preview-actions">
    <button class="adopt-button" loading="{{confirming}}" disabled="{{confirming}}" bindtap="confirmStage">确认开始</button>
    <view class="secondary-actions">
      <button disabled="{{confirming}}" bindtap="regenerate">调整行动安排</button>
      <button wx:if="{{input}}" disabled="{{confirming}}" bindtap="editGoal">调整目标信息</button>
    </view>
  </view>
</view>
