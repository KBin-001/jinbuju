<view class="preview-page">
  <view class="preview-header">
    <button class="preview-back" disabled="{{generating || adopting}}" bindtap="goBack">‹</button>
    <view class="preview-header-title">7 天成长计划</view>
    <view class="preview-header-space"></view>
  </view>

  <view wx:if="{{status === 'initial'}}" class="preview-state">
    <view class="loading-dot"></view>
    <view class="state-title">正在准备计划</view>
  </view>

  <view wx:elif="{{status === 'generating'}}" class="preview-state generating-state">
    <view class="generation-visual">
      <view class="generation-ring"></view>
      <view class="generation-number">7</view>
    </view>
    <view class="generation-title">正在为你制定 7 天计划</view>
    <view class="generation-description">AI 正在根据你的目标、基础和每日时间拆分任务</view>
    <view class="generation-stage">{{stageText}}</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="preview-state">
    <view class="state-mark">!</view>
    <view class="state-title">计划生成遇到问题</view>
    <view class="state-description">{{errorMessage}}</view>
    <button class="primary-button" bindtap="retry">重新生成</button>
    <button class="outline-action" bindtap="useFallback">使用推荐模板</button>
    <button class="text-action" bindtap="editGoal">返回修改目标</button>
  </view>

  <scroll-view wx:else class="plan-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="plan-content">
      <view wx:if="{{status === 'fallback'}}" class="fallback-notice">
        AI 暂时繁忙，已为你生成一份推荐计划，你仍然可以正常使用。
      </view>

      <view class="plan-hero">
        <view class="plan-label">本周计划</view>
        <view class="plan-summary">{{plan.summary}}</view>
        <view class="weekly-goal">
          <view class="weekly-goal-label">本周目标</view>
          <view>{{plan.weeklyGoal}}</view>
        </view>
      </view>

      <view
        wx:for="{{plan.days}}"
        wx:key="day"
        class="day-card {{item.isStudyDay ? '' : 'rest-card'}}"
      >
        <view class="day-header">
          <view>
            <view class="day-index">第 {{item.day}} 天 · {{item.date}}</view>
            <view class="day-title">{{item.title}}</view>
          </view>
          <view class="day-type">{{item.isStudyDay ? '学习日' : '休息日'}}</view>
        </view>
        <view wx:if="{{item.tasks.length}}">
          <view wx:for="{{item.tasks}}" wx:for-item="task" wx:key="title" class="task-row">
            <view class="task-order">{{index + 1}}</view>
            <view class="task-main">
              <view class="task-name">{{task.title}}</view>
              <view class="task-time">预计 {{task.estimatedMinutes}} 分钟</view>
            </view>
          </view>
        </view>
        <view wx:else class="rest-copy">休息一下，也可以花几分钟简单回顾。</view>
      </view>

      <view class="advice-card">
        <view class="advice-title">没有按时完成也没关系</view>
        <view class="advice-copy">{{plan.fallbackAdvice}}</view>
      </view>
      <view class="plan-bottom-spacer"></view>
    </view>
  </scroll-view>

  <view wx:if="{{status === 'success' || status === 'fallback'}}" class="preview-actions">
    <button
      class="adopt-button {{adopting ? 'button-disabled' : ''}}"
      loading="{{adopting}}"
      disabled="{{adopting}}"
      bindtap="adopt"
    >采用这个计划</button>
    <view class="secondary-actions">
      <button disabled="{{adopting}}" bindtap="regenerate">重新生成</button>
      <button disabled="{{adopting}}" bindtap="adjustTime">调整时间</button>
      <button disabled="{{adopting}}" bindtap="editGoal">修改目标</button>
    </view>
  </view>
</view>
