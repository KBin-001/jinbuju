.preview-page { height: 100vh; background: var(--color-background); }
.preview-header { height: calc(104rpx + env(safe-area-inset-top)); display: flex; align-items: flex-end; justify-content: space-between; padding: env(safe-area-inset-top) 28rpx 20rpx; }
.preview-back, .preview-header-space { width: 72rpx; height: 64rpx; }
.preview-back { display: flex; align-items: center; justify-content: center; font-size: 52rpx; }
.preview-header-title { padding-bottom: 12rpx; font-size: 30rpx; font-weight: 650; }
.preview-state { height: calc(100vh - 104rpx - env(safe-area-inset-top)); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40rpx; text-align: center; }
.text-action { margin-top: 4rpx; color: var(--color-primary); font-size: 26rpx; text-align: center; }
.plan-scroll { height: calc(100vh - 104rpx - env(safe-area-inset-top) - 180rpx - env(safe-area-inset-bottom)); }
.plan-content { padding: 20rpx 28rpx; }
.optimization-notice, .optimization-ready, .optimization-failed { margin-bottom: 20rpx; padding: 22rpx; border-radius: 18rpx; font-size: 24rpx; line-height: 1.55; }
.optimization-notice { background: var(--color-primary-light); color: var(--color-primary); }
.notice-retry { margin-top: 12rpx; color: var(--color-primary); font-weight: 650; text-align: left; }
.optimization-ready { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; background: #e8f1ff; color: #315f8c; }
.optimization-ready button { flex-shrink: 0; padding: 14rpx 20rpx; border-radius: 999rpx; background: #315f8c; color: #fff; }
.optimization-failed { display: flex; align-items: center; justify-content: space-between; background: #fbf0d8; color: #805c1f; }
.optimization-failed button { color: #805c1f; font-weight: 650; }
.notice-title { font-weight: 700; }
.plan-hero, .week-card, .day-card { border: 1rpx solid var(--color-border); border-radius: 26rpx; background: var(--color-surface); }
.plan-hero { padding: 32rpx; }
.plan-label, .day-index { color: var(--color-primary); font-size: 23rpx; font-weight: 650; }
.plan-summary { margin-top: 12rpx; font-size: 36rpx; font-weight: 700; line-height: 1.45; }
.weekly-goal { margin-top: 24rpx; padding: 22rpx; border-radius: 18rpx; background: var(--color-primary-light); color: var(--color-primary); line-height: 1.55; }
.weekly-goal-label { margin-bottom: 6rpx; font-size: 22rpx; font-weight: 650; }
.stage-summary, .task-description { margin-top: 14rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 1.6; }
.week-card { margin-top: 20rpx; overflow: hidden; }
.week-header { width: 100%; display: flex; justify-content: space-between; padding: 26rpx 28rpx; font-weight: 700; text-align: left; }
.day-card { margin: 0 20rpx 20rpx; padding: 26rpx; border-radius: 20rpx; }
.rest-card { background: #fafbf8; }
.day-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.day-title { margin-top: 8rpx; font-size: 30rpx; font-weight: 650; }
.day-type { flex-shrink: 0; padding: 8rpx 14rpx; border-radius: 12rpx; background: var(--color-primary-light); color: var(--color-primary); font-size: 21rpx; }
.rest-copy { margin-top: 18rpx; color: var(--color-text-secondary); line-height: 1.55; }
.task-row { display: flex; align-items: flex-start; gap: 18rpx; margin-top: 22rpx; padding-top: 22rpx; border-top: 1rpx solid var(--color-border); }
.task-main { flex: 1; min-width: 0; }
.task-name { font-weight: 650; line-height: 1.5; }
.task-type { display: inline-flex; margin-top: 10rpx; padding: 5rpx 12rpx; border-radius: 999rpx; background: var(--color-primary-light); color: var(--color-primary); font-size: 21rpx; font-weight: 650; }
.task-time { margin-top: 8rpx; color: var(--color-text-secondary); font-size: 22rpx; }
.task-extra { margin-top: 12rpx; color: var(--color-text-secondary); font-size: 23rpx; line-height: 1.55; }
.task-extra-label { margin-right: 12rpx; color: var(--color-text); font-weight: 650; }
.safety-extra { color: #7a5b24; }
.edit-button { flex-shrink: 0; color: var(--color-primary); }
.edit-form { width: 100%; }
.edit-label { margin: 18rpx 0 10rpx; font-size: 24rpx; font-weight: 650; }
.edit-label:first-child { margin-top: 0; }
.edit-form input, .edit-form textarea { width: 100%; padding: 18rpx; border: 2rpx solid var(--color-border); border-radius: 14rpx; background: #fff; }
.edit-form textarea { height: 150rpx; box-sizing: border-box; }
.edit-actions { display: flex; justify-content: flex-end; gap: 18rpx; margin-top: 20rpx; }
.edit-actions button { padding: 16rpx 26rpx; border-radius: 999rpx; border: 2rpx solid var(--color-border); }
.edit-actions .save-button { border-color: var(--color-primary); background: var(--color-primary); color: #fff; }
.plan-bottom-spacer { height: 24rpx; }
.preview-actions { position: fixed; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; gap: 12rpx; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--color-border); background: rgba(255,255,255,.97); }
.actions-row { display: flex; align-items: center; gap: 16rpx; }
.confirm-button { height: 88rpx; flex: 1; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--color-primary); color: #fff; font-weight: 650; font-size: 28rpx; }
.confirm-button[disabled] { opacity: 0.6; }

/* Adjust button */
.adjust-button { height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; border: 2rpx solid var(--color-primary); color: var(--color-primary); font-weight: 650; padding: 0 28rpx; flex-shrink: 0; font-size: 28rpx; }
.adjust-button[disabled] { opacity: 0.5; }

/* Regeneration overlay */
.regen-overlay { display: flex; flex-direction: column; align-items: center; padding: 48rpx 32rpx; margin-bottom: 24rpx; border-radius: 26rpx; background: var(--color-surface); border: 1rpx solid var(--color-border); text-align: center; }
.regen-title { margin-top: 20rpx; font-size: 30rpx; font-weight: 650; }
.regen-subtitle { margin-top: 12rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 1.6; }

/* Regeneration success */
.regen-success { background: #e6f4ea; color: #1e6e3e; }

/* Regeneration error */
.regen-error { margin: 16rpx 0; padding: 18rpx 22rpx; border-radius: 14rpx; background: #fef3e2; color: #805c1f; font-size: 24rpx; line-height: 1.55; }

/* Feedback section */
.feedback-section { margin-top: 32rpx; padding: 28rpx; border-radius: 26rpx; background: var(--color-surface); border: 1rpx solid var(--color-border); }
.feedback-question { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 8rpx; }

/* Feedback panel */
.feedback-panel { margin-top: 24rpx; }
.feedback-hint { color: var(--color-text-secondary); font-size: 24rpx; line-height: 1.6; margin-bottom: 24rpx; }

/* Feedback chips */
.feedback-options { display: flex; flex-wrap: wrap; gap: 16rpx; }
.feedback-chip { display: inline-flex; align-items: center; padding: 14rpx 24rpx; border-radius: 999rpx; border: 2rpx solid var(--color-border); background: #fff; font-size: 24rpx; color: var(--color-text); }
.feedback-chip.selected { border-color: var(--color-primary); background: var(--color-primary-light); color: var(--color-primary); font-weight: 650; }

@media (max-width: 340px) {
  .plan-scroll {
    height: calc(100vh - 104rpx - env(safe-area-inset-top) - 286rpx - env(safe-area-inset-bottom));
  }

  .plan-content {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .actions-row {
    flex-direction: column;
  }

  .confirm-button,
  .adjust-button {
    width: 100%;
    flex: none;
  }
}

/* Feedback note */
.feedback-note-section { margin-top: 24rpx; }
.feedback-note-input { width: 100%; height: 160rpx; padding: 18rpx; border: 2rpx solid var(--color-border); border-radius: 14rpx; background: #fff; font-size: 26rpx; box-sizing: border-box; }
.note-counter { margin-top: 8rpx; text-align: right; font-size: 22rpx; color: var(--color-text-secondary); }

/* Feedback remaining */
.feedback-remaining { margin-top: 16rpx; font-size: 22rpx; color: var(--color-text-secondary); }

/* Feedback actions */
.feedback-actions { display: flex; gap: 18rpx; margin-top: 24rpx; }
.feedback-cancel { flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; border: 2rpx solid var(--color-border); font-size: 28rpx; }
.feedback-submit { flex: 2; height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--color-primary); color: #fff; font-weight: 650; font-size: 28rpx; }
