/* AI plan studio */
.preview-page { background: radial-gradient(circle at 100% 10%,rgba(124,198,160,.14),transparent 28%),#F6FAF7; }
.preview-header { margin: 0 24rpx; padding: 22rpx 28rpx; border-radius: 28rpx; background: #FFFFFF; color: #244C43; box-shadow: 0 8rpx 24rpx rgba(36,88,74,.08); }
