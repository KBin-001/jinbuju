/* ─── Plan Ready Hero (just generated) ─── */
.plan-ready-hero {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 24rpx;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #E6F4EC 0%, #F7FBF8 60%, #FFFFFF 100%);
  color: #244C43;
  box-shadow: 0 8rpx 24rpx rgba(36, 88, 74, 0.10);
  animation: plan-ready-enter 480ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.plan-ready-icon {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.plan-ready-check {
  position: relative;
  z-index: 2;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #8bbf72, #5fa86b);
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(123, 173, 132, 0.45);
}

.plan-ready-ring {
  position: absolute;
  top: 0;
  left: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(139, 191, 114, 0.6);
  animation: plan-ready-ring 1.6s ease-out infinite;
}

.plan-ready-text {
  flex: 1;
  min-width: 0;
}

.plan-ready-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}

.plan-ready-desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.78);
}

.plan-ready-arrow {
  flex: none;
  font-size: 36rpx;
  font-weight: 650;
  color: #f0d28c;
  animation: plan-ready-arrow 1.4s ease-in-out infinite;
}

@keyframes plan-ready-enter {
  from { opacity: 0; transform: translateY(-16rpx) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes plan-ready-ring {
  0% { transform: scale(1); opacity: 0.7; }
  100% { transform: scale(1.8); opacity: 0; }
}

@keyframes plan-ready-arrow {
  0%, 100% { transform: translateY(0); opacity: 0.7; }
  50% { transform: translateY(10rpx); opacity: 1; }
}

/* ─── Confirm hint bar (above action buttons) ─── */
.confirm-hint-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 10rpx 0 4rpx;
  color: var(--color-primary);
  font-size: 23rpx;
  font-weight: 650;
  animation: confirm-hint-fade 600ms ease-out both;
}

.confirm-hint-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-growth);
  animation: confirm-hint-dot 1s ease-in-out infinite;
}

@keyframes confirm-hint-fade {
  from { opacity: 0; transform: translateY(-8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes confirm-hint-dot {
  0%, 100% { opacity: 0.4; transform: scale(0.85); }
  50% { opacity: 1; transform: scale(1.2); }
}

/* ─── Highlighted action bar (just generated) ─── */
.preview-actions-highlight {
  border-top: 2rpx solid rgba(53, 104, 89, 0.18);
  box-shadow: 0 -10rpx 36rpx rgba(21, 63, 54, 0.12);
  animation: actions-highlight-enter 500ms ease-out both;
}

@keyframes actions-highlight-enter {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

/* ─── Confirm button pulse animation ─── */
.confirm-button-pulse {
  animation: confirm-pulse 1.8s ease-in-out infinite;
  box-shadow: 0 14rpx 32rpx rgba(21, 63, 54, 0.28), 0 0 0 0 rgba(53, 104, 89, 0.5);
}

@keyframes confirm-pulse {
  0%, 100% {
    box-shadow: 0 14rpx 32rpx rgba(21, 63, 54, 0.28), 0 0 0 0 rgba(53, 104, 89, 0.5);
  }
  50% {
    box-shadow: 0 14rpx 32rpx rgba(21, 63, 54, 0.28), 0 0 0 14rpx rgba(53, 104, 89, 0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .plan-ready-hero,
  .plan-ready-ring,
  .plan-ready-arrow,
  .confirm-hint-bar,
  .confirm-hint-dot,
  .preview-actions-highlight,
  .confirm-button-pulse {
    animation: none;
  }
}
