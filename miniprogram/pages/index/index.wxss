  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 104rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #edf1ee;
}

.quick-duration-cancel,
.quick-duration-spacer {
  width: 120rpx;
