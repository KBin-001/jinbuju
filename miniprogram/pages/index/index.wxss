.today-page {
  display: flex;
  flex-direction: column;
  padding-top: 40rpx;
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.page-state {
  margin-top: 80rpx;
}

.date-row,
.card-heading-row,
.section-title-row,
.goal-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
}

.weekday {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.greeting {
  margin-top: 22rpx;
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: 600;
}

.streak-pill {
  min-width: 166rpx;
  padding: 14rpx 18rpx;
  border-radius: 22rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 22rpx;
  text-align: center;
}

.streak-number {
  margin-right: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  transform-origin: center bottom;
  animation: streak-flip 480ms ease-out;
}

.empty-goal-card {
  padding: 40rpx 36rpx;
}

.section-eyebrow {
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.empty-goal-title {
  max-width: 560rpx;
  margin-top: 18rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.5;
}

.empty-goal-description {
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.create-button {
  width: 100%;
}

.goal-card,
.progress-card {
  margin-bottom: 28rpx;
}

.paused-notice {
  margin-bottom: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: 22rpx;
  background: #f5eddf;
  color: #705b37;
  line-height: 1.55;
}

.goal-card {
  position: relative;
  overflow: hidden;
  padding-left: 38rpx;
}

.goal-card::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 6rpx;
  background: var(--color-primary);
  content: "";
}

.paused-notice-title {
  margin-bottom: 6rpx;
  font-weight: 700;
}

.goal-title {
  max-width: 430rpx;
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
  word-break: break-all;
}

.category-tag {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 22rpx;
}

.goal-meta {
  justify-content: flex-start;
  margin-top: 30rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid var(--color-border);
}

.meta-item {
  flex: 1;
}

.meta-divider {
  width: 1rpx;
  height: 64rpx;
  margin: 0 30rpx;
  background: var(--color-border);
}

.meta-value {
  font-size: 28rpx;
  font-weight: 650;
}

.meta-label {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.progress-count {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
}

.progress-count-strong {
  color: var(--color-text);
  font-size: 38rpx;
  font-weight: 700;
}

.progress-rate {
  flex: none;
  min-width: 84rpx;
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: 700;
  text-align: right;
}

.progress-bar-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 26rpx;
}

.progress-track {
  height: 22rpx;
  flex: 1;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e8ece6;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
  transition: width 220ms ease;
  transform-origin: left center;
  animation: progress-reveal 520ms ease-out;
}

.progress-status {
  margin-top: 16rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.progress-card {
  order: 3;
  margin-top: 28rpx;
}

.task-section {
  order: 2;
}

.more-settings-button {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid var(--color-border);
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 600;
  text-align: left;
}

.more-settings-value {
  color: var(--color-primary);
  font-weight: 500;
}

.quick-task-input {
  width: 100%;
  min-height: 92rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  background: #fbfcfa;
  color: var(--color-text);
  font-size: 30rpx;
}

.quick-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
}

.section-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.add-task-trigger {
  width: 152rpx !important;
  min-width: 152rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 650;
}

.add-task-trigger-icon {
  margin-top: -2rpx;
  font-size: 32rpx;
  font-weight: 400;
}

.quick-task-overlay {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  background: rgba(25, 33, 29, 0.42);
}

.quick-task-sheet {
  width: 100%;
  max-height: 86vh;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 36rpx 36rpx 0 0;
  background: var(--color-surface);
}

.quick-task-sheet > .more-settings-button,
.quick-task-sheet > .add-task-button {
  width: 100% !important;
  max-width: none;
  margin-right: 0;
  margin-left: 0;
}

.quick-task-sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.quick-task-sheet-title {
  font-size: 34rpx;
  font-weight: 700;
}

.quick-task-sheet-hint {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 1.5;
}

.sheet-close-button {
  min-width: 88rpx;
  height: 64rpx;
  flex: none;
  color: var(--color-primary);
  font-size: 25rpx;
  font-weight: 600;
  text-align: right;
}

.quick-chip {
  min-width: 124rpx;
  padding: 14rpx 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  background: #fbfcfa;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  text-align: center;
}

.quick-chip-active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 650;
}

.more-settings {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-border);
}

.settings-field-label {
  margin-top: 24rpx;
}

.field-label {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.small-input {
  min-height: 80rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
}

.add-task-button {
  width: 100%;
  margin-top: 28rpx;
}

.task-section {
  margin-top: 34rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
}

.section-count {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.task-card {
  margin-top: 20rpx;
  padding: 28rpx;
  transition: background 180ms ease, border-color 180ms ease;
}

.task-main-row {
  display: flex;
  align-items: center;
}

.task-card-completed {
  border-color: #cfe1d8;
  background: #f3f8f5;
}

.task-content {
  flex: 1;
  min-width: 0;
}

.task-title {
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.45;
}

.task-title-completed {
  color: #56645b;
}

.task-description {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.55;
}

.task-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  margin-top: 12rpx;
}

.task-duration,
.task-source {
  color: #879087;
  font-size: 22rpx;
}

.task-source {
  max-width: 280rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #eef2ec;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.period-group {
  margin-top: 24rpx;
}

.period-title {
  padding-left: 6rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 650;
}

.task-toggle {
  width: 140rpx !important;
  min-width: 140rpx;
  margin-left: 24rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid var(--color-primary);
  border-radius: 999rpx;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.task-toggle-completed {
  position: relative;
  overflow: visible;
  background: var(--color-primary);
  color: #ffffff;
  animation: task-complete-pop 260ms ease-out;
}

.task-toggle-completed::before {
  position: absolute;
  inset: -12rpx;
  z-index: -1;
  border: 4rpx solid rgba(53, 104, 89, 0.28);
  border-radius: 999rpx;
  opacity: 0;
  content: "";
  animation: task-complete-ripple 420ms ease-out;
}

.task-toggle-icon {
  display: inline-block;
  min-width: 24rpx;
  margin-right: 6rpx;
}

.task-toggle[disabled] {
  opacity: 0.65;
}

.task-detail-toggle {
  width: auto !important;
  min-width: 0;
  display: inline-flex;
  align-items: center;
  gap: 7rpx;
  margin-top: 14rpx;
  padding: 8rpx 0;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.task-detail-arrow {
  color: #7f9187;
  font-size: 22rpx;
}

.task-detail-panel {
  margin-top: 16rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-border);
}

.task-detail-item + .task-detail-item {
  margin-top: 18rpx;
}

.task-detail-label {
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.4;
}

.task-detail-text {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.65;
  word-break: break-all;
}

.task-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 10rpx;
}

.task-info-chip {
  max-width: 100%;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eef2ec;
  color: #56645b;
  font-size: 22rpx;
  line-height: 1.4;
  word-break: break-all;
}

.task-note-list {
  margin-top: 10rpx;
}

.task-note-item {
  position: relative;
  padding-left: 22rpx;
  color: #705b37;
  font-size: 24rpx;
  line-height: 1.65;
  word-break: break-all;
}

.task-note-item::before {
  position: absolute;
  top: 16rpx;
  left: 0;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #b08a42;
  content: "";
}

.no-task-card {
  margin-top: 20rpx;
  padding: 44rpx 30rpx;
  text-align: center;
}

.small-mark {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto;
  border-radius: 22rpx;
  font-size: 30rpx;
}

.no-task-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 650;
}

.source-summary {
  margin-top: 26rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.64);
}

.source-summary-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.bottom-action {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  background: rgba(255, 255, 255, 0.96);
}

.checkin-button {
  width: 100%;
  padding: 26rpx 30rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-weight: 650;
}

.checkin-button[disabled] {
  background: #d9ded8;
  color: #899087;
}

.checkin-button-done {
  background: #e3efe9;
  color: var(--color-primary);
}

@keyframes task-complete-pop {
  0% { transform: scale(0.88); }
  70% { transform: scale(1.06); }
  100% { transform: scale(1); }
}

@keyframes task-complete-ripple {
  0% { opacity: 0.7; transform: scale(0.76); }
  100% { opacity: 0; transform: scale(1.18); }
}

@keyframes streak-flip {
  0% { opacity: 0; transform: rotateX(-70deg); }
  100% { opacity: 1; transform: rotateX(0); }
}

@keyframes progress-reveal {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}

@media (max-width: 340px) {
  .date-row,
  .card-heading-row {
    align-items: flex-start;
  }

  .streak-pill {
    min-width: 142rpx;
    margin-left: 16rpx;
  }

  .task-main-row {
    align-items: flex-start;
  }

  .task-toggle {
    min-width: 124rpx;
    margin-left: 16rpx;
    padding-right: 14rpx;
    padding-left: 14rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .streak-number,
  .progress-fill,
  .task-toggle-completed,
  .task-toggle-completed::before {
    animation: none;
  }
}
