page { width: 100%; overflow-x: hidden; background: #f8f4ed; }

.today-page {
  --ivory: #f7f3ea;
  --paper: #fffcf6;
  --ink: #24312d;
  --green: #245b4d;
  --muted: #7c817d;
  --gold: #c89b4a;
  --line: rgba(105, 96, 78, .13);
  min-height: 100vh;
  padding: 0 32rpx calc(166rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  color: var(--ink);
  background: #f8f4ec;
  font-family: var(--font-family-sans);
}

.today-page--timing { padding-bottom: calc(270rpx + env(safe-area-inset-bottom)); }
.today-hero { margin: 0 -32rpx; }
.today-hero__background { opacity: .58; transform: scale(1.035); transform-origin: 72% 20%; }
.today-hero__veil { background: rgba(248,244,236,.2); }
.today-nav { position: relative; }
.today-nav::after { position: absolute; bottom: 2rpx; left: 50%; width: 42rpx; height: 2rpx; border-radius: 2rpx; background: rgba(200,155,74,.84); content: ""; transform: translateX(-50%); }
.today-nav .tab-header__title { font-size: 48rpx; letter-spacing: 10rpx; }
.today-profile-row { position: relative; z-index: 2; min-height: 142rpx; margin-top: 8rpx; padding: 14rpx 4rpx 16rpx; display: flex; align-items: center; }
.today-avatar { width: 86rpx; height: 86rpx; flex: none; overflow: hidden; display: flex; align-items: center; justify-content: center; border: 4rpx solid rgba(255,253,248,.96); border-radius: 50%; background: #ecefe8; box-sizing: border-box; box-shadow: 0 8rpx 22rpx rgba(54,70,63,.09); }
.today-avatar--text { color: var(--green); font-family: var(--font-family-brand); font-size: 46rpx; font-weight: var(--font-weight-title); }
.today-greeting-copy { min-width: 0; margin-left: 22rpx; display: flex; flex: 1; flex-direction: column; }
.today-greeting { overflow: hidden; color: #155b48; font-family: var(--font-family-brand); font-size: 35rpx; line-height: 46rpx; font-weight: 500; letter-spacing: 1rpx; text-overflow: ellipsis; white-space: nowrap; }
.today-subtitle { margin-top: 8rpx; color: #666f6b; font-size: 21rpx; line-height: 30rpx; }

.action-streak { width: 116rpx; min-height: 98rpx; flex: none; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid rgba(200,155,74,.24); border-radius: 22rpx; background: rgba(255,252,246,.97); box-shadow: 0 8rpx 22rpx rgba(74,61,39,.065); }
.action-streak__value { color: #9a671f; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 34rpx; line-height: 38rpx; }
.action-streak__value text { margin-left: 3rpx; font-family: var(--font-family-sans); font-size: 17rpx; }
.action-streak__label { margin-top: 4rpx; color: #6f7471; font-size: 17rpx; }

.paper-card, .week-card, .stats-card, .reference-coach-entry, .today-task-row, .state-card, .empty-card { position: relative; overflow: hidden; box-sizing: border-box; border: 1rpx solid rgba(129,114,86,.1); border-radius: 30rpx; background: #fffcf6; box-shadow: 0 10rpx 30rpx rgba(75,62,40,.052); }
.paper-card::before, .week-card::before, .stats-card::before, .today-task-row::before { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0; }

.week-card { min-height: 206rpx; margin-top: 10rpx; padding: 25rpx 28rpx 22rpx; }
.week-head { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; }
.week-title { color: #155b48; font-family: var(--font-family-brand); font-size: 34rpx; line-height: 44rpx; font-weight: var(--font-weight-title); letter-spacing: 2rpx; }
.week-switch { min-height: 52rpx; display: flex; align-items: center; gap: 8rpx; color: #5d6662; font-size: 21rpx; }
.week-chevron { color: #8f8b82; font-family: var(--font-family-sans); font-size: 35rpx; font-weight: 300; }
.week-grid { position: relative; z-index: 2; margin-top: 16rpx; display: grid; grid-template-columns: repeat(7, minmax(0,1fr)); }
.week-day { position: relative; min-width: 0; height: 90rpx; display: flex; flex-direction: column; align-items: center; color: #3f4542; }
.week-label { font-size: 19rpx; line-height: 30rpx; }
.week-number { width: 60rpx; height: 60rpx; margin-top: 6rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 29rpx; line-height: 60rpx; }
.week-day.is-selected .week-number { background: #1f705a; color: #fffdf8; box-shadow: 0 9rpx 18rpx rgba(31,112,90,.2); }
.week-day.is-today:not(.is-selected) .week-number { color: #31584b; box-shadow: inset 0 0 0 2rpx rgba(49,88,75,.28); }
.week-day.is-muted { opacity: .36; }

.stats-card { height: 200rpx; margin-top: 20rpx; padding: 22rpx 16rpx 18rpx; border: 1rpx solid rgba(90,105,96,.11); border-radius: 24rpx; background: #fffdf8; box-shadow: 0 4rpx 16rpx rgba(63,55,43,.035); }
.stats-card--pressed { opacity: .88; transform: scale(.997); }
.stats-grid { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); height: 100%; }
.stats-column { position: relative; min-width: 0; padding: 0 20rpx; display: flex; flex-direction: column; align-items: flex-start; box-sizing: border-box; }
.stats-column--done { padding-left: 10rpx; }
.stats-column--progress { padding-right: 10rpx; }
.stats-column + .stats-column::before { position: absolute; top: 1rpx; bottom: 1rpx; left: 0; width: 1rpx; background: rgba(102,118,109,.14); content: ""; }
.stats-label { min-height: 30rpx; display: flex; align-items: center; gap: 8rpx; color: #747c77; font-family: var(--font-family-sans); font-size: 20rpx; line-height: 28rpx; white-space: nowrap; }
.stats-icon { width: 29rpx; height: 29rpx; flex: none; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.stats-icon--solid { border-radius: 50%; color: #fffdf8; background: #4f8a68; }
.stats-icon--time { color: #9a7633; }
.stats-icon--flow { color: #245b4d; }
.stats-value { min-height: 52rpx; margin-top: 10rpx; display: flex; align-items: baseline; color: #27332f; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 47rpx; font-weight: 400; line-height: 1; white-space: nowrap; }
.stats-value--done { color: #245b4d; }
.stats-done-total { margin-left: 7rpx; color: #6f7c76; font-family: var(--font-family-sans); font-size: 18rpx; font-weight: 500; }
.stats-value--minutes, .stats-value--progress { font-size: 47rpx; }
.stats-value-unit { margin-left: 5rpx; color: #68736d; font-family: var(--font-family-sans); font-size: 17rpx; }
.stats-value-unit--percent { font-size: 25rpx; }
.stats-meta-row { height: 47rpx; margin-top: 7rpx; display: flex; align-items: flex-start; gap: 6rpx; color: #789085; font-size: 17rpx; line-height: 24rpx; white-space: nowrap; }
.stats-meta-row.is-complete { color: #4f7c62; font-weight: 600; }
.stats-mini-bars { width: 126rpx; height: 44rpx; margin-top: 9rpx; display: flex; align-items: flex-end; justify-content: center; gap: 6rpx; }
.stats-mini-bar { width: 6rpx; min-height: 4rpx; border-radius: 3rpx 3rpx 0 0; background: rgba(109,145,125,.26); }
.stats-mini-bar.is-active { background: #9db9a7; }
.stats-progress-visual { position: relative; width: 100%; height: 54rpx; margin-top: 2rpx; }
.stats-trend-canvas { display: block; width: 100%; height: 43rpx; }
.stats-trend-canvas--progress { width: 100%; }
.stats-achievement-pill { position: absolute; right: 0; bottom: -1rpx; min-width: 86rpx; height: 25rpx; padding: 0 10rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid rgba(73,111,93,.14); border-radius: 13rpx; color: #5f756a; background: rgba(255,253,248,.96); font-size: 15rpx; line-height: 23rpx; white-space: nowrap; }
.stats-achievement-pill.is-complete { border-color: rgba(200,155,74,.3); color: #8d682d; background: #fff8e9; }

.reference-coach-entry { min-height: 202rpx; margin-top: 20rpx; border-radius: 28rpx; box-shadow: none; }
.reference-card--pressed { opacity: .8; }
.reference-coach-background { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: .88; transform: scale(1.02); transform-origin: 78% 64%; }
.reference-coach-veil { position: absolute; inset: 0; background: linear-gradient(90deg,rgba(255,252,246,.99) 0%,rgba(255,252,246,.95) 48%,rgba(255,252,246,.72) 65%,rgba(255,252,246,.22) 100%),linear-gradient(180deg,transparent 55%,rgba(255,252,246,.18) 100%); }
.reference-coach-copy { position: relative; z-index: 2; width: 100%; min-height: 202rpx; padding: 24rpx 28rpx; box-sizing: border-box; display: flex; flex-direction: column; justify-content: center; }
.proactive-insight { max-width: 100%; padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
.proactive-label { color: #9b7432; font-size: 18rpx; font-weight: 600; line-height: 26rpx; }
.proactive-title { margin-top: 5rpx; display: -webkit-box; overflow: hidden; color: #203c33; font-size: 29rpx; font-weight: 700; line-height: 40rpx; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.proactive-body { margin-top: 6rpx; display: -webkit-box; overflow: hidden; color: #65716c; font-size: 20rpx; line-height: 30rpx; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.coach-entry-footer { min-height: 58rpx; margin-top: 12rpx; display: inline-flex; align-items: center; gap: 3rpx; color: #8b682f; font-size: 19rpx; font-weight: 650; }

.task-section { margin-top: 40rpx; }
.task-section--primary { margin-top: 32rpx; }
.task-section-head { min-height: 60rpx; display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.task-section-heading { min-width: 0; display: flex; flex: 1; align-items: baseline; gap: 16rpx; }
.task-section-title { flex: none; color: #155b48; font-family: var(--font-family-brand); font-size: 34rpx; line-height: 44rpx; font-weight: var(--font-weight-title); letter-spacing: 2rpx; }
.task-section-tools { flex: none; display: flex; align-items: center; gap: 10rpx; }
.task-section-add { height: 64rpx; padding: 0 18rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(36,91,77,.16); border-radius: 999rpx; color: #17644f; background: rgba(255,253,248,.92); box-shadow: 0 4rpx 14rpx rgba(60,70,64,.035); font-size: 20rpx; font-weight: 650; transition: transform 160ms ease-out, background 160ms ease-out; }
.task-section-add--icon { width: 64rpx; padding: 0; }
.execution-preference { height: 64rpx; padding: 0 20rpx; display: flex; align-items: center; gap: 7rpx; border: 1rpx solid rgba(105,96,78,.13); border-radius: 999rpx; color: #47534e; background: rgba(255,252,246,.94); box-shadow: 0 4rpx 14rpx rgba(60,70,64,.035); box-sizing: border-box; font-size: 18rpx; white-space: nowrap; transition: transform 160ms ease-out, background 160ms ease-out; }
.task-section-add:active, .execution-preference:active { transform: scale(.97); background: #f1eee6; }
.action-panel { margin-top: 13rpx; overflow: hidden; border: 1rpx solid rgba(105,96,78,.1); border-radius: 30rpx; background: rgba(255,252,246,.97); box-shadow: 0 10rpx 30rpx rgba(75,62,40,.05); }
.focus-action-panel { margin: 16rpx 0 14rpx; padding: 25rpx 24rpx; border-left: 6rpx solid var(--color-primary); border-radius: 0 var(--radius-card) var(--radius-card) 0; background: var(--color-surface-soft); }
.focus-action-kicker { color: var(--color-gold); font-size: 21rpx; font-weight: 650; letter-spacing: 2rpx; }
.focus-action-title { margin-top: 10rpx; color: var(--color-text-main); font-size: 31rpx; font-weight: 700; line-height: 1.4; }
.focus-action-meta { display: flex; gap: 18rpx; margin-top: 8rpx; color: var(--color-text-secondary); font-size: 22rpx; }
.focus-action-buttons { display: flex; gap: 14rpx; margin-top: 22rpx; }
.focus-action-buttons button { height: 76rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; box-sizing: border-box; border-radius: var(--radius-button); font-size: 25rpx; font-weight: 650; }
.focus-action-buttons button::after { border: 0; }
.focus-action-secondary { flex: 0 0 180rpx; border: 1rpx solid var(--color-border-strong); background: var(--color-bg-card); color: var(--color-primary); }
.focus-action-primary { flex: 1; border: 0; background: var(--color-primary); color: #fff; }
.today-task-row { min-height: 102rpx; margin-bottom: 10rpx; padding: 13rpx 18rpx; display: flex; align-items: center; gap: 12rpx; }
.today-task-row.is-done { border-color: rgba(91,120,101,.22); background: rgba(241,245,237,.95); }
.reference-task-icon { position: relative; z-index: 2; width: 50rpx; height: 50rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; color: #35695c; background: #e8f0eb; }
.reference-task-icon image { width: 35rpx; height: 35rpx; }
.reference-task-icon--blue { color: #496a76; background: #e9f0f2; }
.reference-task-icon--gold { color: #98702f; background: #f7efdf; }
.reference-task-icon--orange { color: #a86436; background: #f8ece3; }
.reference-task-icon--purple { color: #665d77; background: #eeebf2; }
.today-task-row.is-done .reference-task-icon { opacity: .9; }
.task-copy { position: relative; z-index: 2; min-width: 0; flex: 1; }
.task-title-line { min-width: 0; display: flex; align-items: center; gap: 14rpx; }
.task-title { min-width: 0; flex: 1; overflow: hidden; color: #263e36; font-family: var(--font-family-brand); font-size: 27rpx; line-height: 36rpx; font-weight: var(--font-weight-title); text-overflow: ellipsis; white-space: nowrap; }
.task-duration { flex: none; color: #777b76; font-size: 18rpx; line-height: 28rpx; white-space: nowrap; }
.task-meta-actual { color: #527064; font-size: 18rpx; line-height: 26rpx; }
.task-status-line { min-height: 28rpx; margin-top: 5rpx; display: flex; align-items: center; gap: 10rpx; }
.task-status { padding: 0 9rpx; border-radius: 999rpx; color: #52645d; background: #edf1ed; font-size: 16rpx; line-height: 26rpx; }
.task-status--success { color: #245b4d; background: #e8f0eb; }
.task-status--warning { color: #8d682d; background: #f7ebcf; }
.task-status--danger { color: #9b5549; background: #fbf1ed; }
.task-carry-badge { padding: 0 9rpx; border: 1rpx solid rgba(152,112,47,.18); border-radius: 999rpx; color: #8d682d; background: #fbf5e8; font-size: 16rpx; line-height: 25rpx; white-space: nowrap; }
.task-tail-check { position: relative; z-index: 2; width: 50rpx; height: 50rpx; flex: none; display: flex; align-items: center; justify-content: center; border: 2rpx solid #777b76; border-radius: 50%; color: #fff; }
.task-tail-check::after { content: ""; position: absolute; inset: -10rpx; border-radius: 50%; }
.task-tail-check.is-done { border-color: #31584b; background: #31584b; box-shadow: 0 6rpx 13rpx rgba(49,88,75,.17); }
.task-tail-check.is-disabled { border-style: dashed; opacity: .38; }
.task-tail-check .t-icon { font-size: 28rpx; }
.action-list-toggle { min-height: 70rpx; display: flex; align-items: center; justify-content: center; gap: 7rpx; border-top: 1rpx solid rgba(105,96,78,.08); color: #5d6662; font-size: 20rpx; text-align: center; transition: opacity 160ms ease-out, transform 160ms ease-out; }
.action-list-toggle--pressed { opacity: .72; transform: scale(.99); }
.action-empty-inline { padding: 42rpx 28rpx; border: 1rpx dashed rgba(49,88,75,.2); border-radius: 25rpx; background: rgba(255,253,248,.72); color: #31584b; text-align: center; }
.action-empty-inline > view { font-family: var(--font-family-brand); font-size: 27rpx; }
.action-empty-inline text { display: block; margin-top: 8rpx; color: #817e77; font-size: 20rpx; }
.action-empty-button { width: 236rpx; min-height: 64rpx; margin: 22rpx auto 0; padding: 0 22rpx; display: flex; align-items: center; justify-content: center; border-radius: 32rpx; color: #fff; background: #31584b; font-family: inherit !important; font-size: 22rpx !important; font-weight: 650; }

.state-card, .empty-card { margin-top: 20rpx; padding: 58rpx 32rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }
.loading-dot { width: 26rpx; height: 26rpx; margin-bottom: 20rpx; border: 5rpx solid rgba(49,88,75,.18); border-top-color: #31584b; border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.state-mark, .empty-mark { width: 72rpx; height: 72rpx; margin-bottom: 18rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #eef2ec; color: #31584b; font-family: var(--font-family-brand); font-size: 26rpx; }
.state-title { color: #234b40; font-family: var(--font-family-brand); font-size: 30rpx; font-weight: var(--font-weight-title); }
.state-description { max-width: 520rpx; margin-top: 12rpx; color: #7d7970; font-size: 21rpx; line-height: 32rpx; }
.primary-button { min-width: 230rpx; height: 72rpx; margin-top: 24rpx; border-radius: 36rpx; background: #31584b; color: #fff; font-size: 25rpx; line-height: 72rpx; }
.primary-button::after { border: 0; }

/* shared bottom sheets */
.calendar-layer, .quick-add-layer, .quick-duration-layer, .completion-layer { position: fixed; z-index: 10020; inset: 0; pointer-events: none; }
.calendar-layer, .quick-add-layer, .quick-duration-layer { pointer-events: auto; }
.calendar-mask, .quick-add-mask, .completion-mask { position: absolute; inset: 0; background: rgba(29,48,41,.34); backdrop-filter: blur(4rpx); -webkit-backdrop-filter: blur(4rpx); }
.calendar-panel, .quick-add-panel, .quick-duration-panel, .completion-panel { position: absolute; right: 0; bottom: 0; left: 0; padding: 18rpx 30rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius: 34rpx 34rpx 0 0; background: #faf8f1; box-shadow: 0 -18rpx 48rpx rgba(31,65,54,.16); }
.calendar-head, .quick-add-header, .quick-duration-header { min-height: 68rpx; display: flex; align-items: center; justify-content: space-between; }
.calendar-title, .quick-add-title, .quick-duration-title { color: #234b40; font-family: var(--font-family-brand); font-size: 32rpx; font-weight: var(--font-weight-title); }
.calendar-nav, .quick-add-close { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #eef1eb; color: #51665d; font-size: 31rpx; }
.calendar-week-row, .calendar-grid { display: grid; grid-template-columns: repeat(7,1fr); }
.calendar-week-row { margin-top: 14rpx; }
.calendar-week-label { color: #8a877f; font-size: 19rpx; text-align: center; }
.calendar-grid { margin-top: 10rpx; row-gap: 7rpx; }
.calendar-day { position: relative; height: 72rpx; display: flex; align-items: center; justify-content: center; }
.calendar-day-number { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #4d514e; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 23rpx; }
.calendar-day.is-outside { opacity: .28; }
.calendar-day.is-today:not(.is-selected) .calendar-day-number { box-shadow: inset 0 0 0 2rpx rgba(49,88,75,.28); }
.calendar-day.is-selected .calendar-day-number { background: #31584b; color: #fff; }
.calendar-footer { margin-top: 18rpx; display: flex; justify-content: flex-end; gap: 14rpx; }
.calendar-today, .calendar-confirm { height: 60rpx; padding: 0 28rpx; display: flex; align-items: center; border-radius: 30rpx; font-size: 22rpx; }
.calendar-today { border: 1rpx solid #d7e1da; color: #31584b; }
.calendar-confirm { background: #31584b; color: #fff; }

.quick-add-mask { background: rgba(27,34,31,.46); backdrop-filter: blur(12rpx); -webkit-backdrop-filter: blur(12rpx); animation: quick-sheet-mask-in 180ms ease-out both; }
.quick-add-panel {
  --quick-gold: #c89b4a;
  --quick-line: rgba(92, 84, 70, .13);
  height: 78vh;
  max-height: 1260rpx;
  padding: 8rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  border-radius: 40rpx 40rpx 0 0;
  background: #fffdf8;
  box-shadow: 0 -18rpx 52rpx rgba(36,49,43,.12);
  animation: quick-sheet-panel-in 240ms cubic-bezier(.2,.8,.2,1) both;
}
.quick-add-landscape { position: absolute; z-index: 0; top: 0; right: 0; left: 0; width: 100%; height: 176rpx; opacity: .09; pointer-events: none; }
.quick-add-grabber, .completion-grabber { position: relative; z-index: 2; width: 72rpx; height: 7rpx; margin: 0 auto 7rpx; border-radius: 5rpx; background: rgba(103,106,101,.2); }
.quick-add-header { position: relative; z-index: 2; min-height: 60rpx; padding: 0 38rpx 4rpx; display: grid; grid-template-columns: 58rpx 1fr 58rpx; align-items: center; }
.quick-add-header-spacer { width: 58rpx; }
.quick-add-title { color: #24312d; font-family: var(--font-family-brand); font-size: 34rpx; font-weight: var(--font-weight-title); line-height: 46rpx; letter-spacing: 4rpx; text-align: center; }
.quick-add-close { width: 46rpx; height: 46rpx; justify-self: end; border-radius: 50%; color: #727974; background: rgba(255,253,248,.5); opacity: .76; }
.quick-add-close.is-disabled { opacity: .38; }
.quick-add-body { position: relative; z-index: 1; min-height: 0; flex: 1; box-sizing: border-box; }
.quick-title-input { min-height: 76rpx; margin: 6rpx 38rpx 0; padding: 0 20rpx 0 22rpx; display: flex; align-items: center; gap: 16rpx; border: 1rpx solid rgba(95,89,78,.15); border-radius: 20rpx; background: rgba(255,253,248,.76); box-sizing: border-box; }
.quick-title-input:focus-within { border-color: rgba(36,91,77,.28); background: #fffefa; }
.quick-title-input__control { min-width: 0; height: 74rpx; flex: 1; color: #24312d; font-size: 24rpx; line-height: 74rpx; }
.quick-title-input__count { flex: none; color: #9a9c98; font-family: var(--font-family-numeric); font-size: 18rpx; font-variant-numeric: tabular-nums; }
.quick-add-placeholder { color: #9fa29e; }
