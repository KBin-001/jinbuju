.today-page {
  --today-primary: #356859;
  --today-primary-deep: #1f4d42;
  --today-text: #1f2d2a;
  --today-secondary: #66736f;
  --today-muted: #9aa6a1;
  --today-border: #e6ece8;
  --today-surface: #ffffff;
  --today-soft: #eff7f2;
  --today-shadow: 0 8rpx 24rpx rgba(21, 71, 58, 0.08);
  padding-top: 36rpx;
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.today-hero {
  margin-bottom: 18rpx;
  padding: 34rpx 34rpx 30rpx;
  border-radius: 32rpx;
  box-shadow: var(--today-shadow);
}

.today-hero::before,
.today-hero::after {
  display: none;
}

.hero-topline {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.hero-kicker {
  position: relative;
  color: rgba(243, 199, 106, 0.92);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.hero-date-pill {
  min-height: 42rpx;
  display: inline-flex;
  align-items: center;
  flex: none;
  box-sizing: border-box;
  padding: 0 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.72);
  font-size: 21rpx;
  font-weight: 600;
  white-space: nowrap;
}

.date-row,
.goal-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.date-row {
  position: relative;
  margin-top: 16rpx;
}

.hero-focus {
  position: relative;
  margin-top: 24rpx;
}

.hero-day-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hero-day {
  color: rgba(255, 255, 255, 0.58);
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  line-height: 1;
}

.hero-status-pill {
  min-height: 36rpx;
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  padding: 0 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  background: rgba(220, 235, 228, 0.18);
  color: rgba(255, 255, 255, 0.82);
  font-size: 20rpx;
  font-weight: 650;
  line-height: 1;
}

.hero-focus-title {
  max-width: 520rpx;
  display: -webkit-box;
  overflow: hidden;
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 50rpx;
  font-weight: 800;
  line-height: 1.16;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.date-title {
  font-size: 42rpx;
  font-weight: 750;
  line-height: 1.18;
}

.weekday,
.hero-copy {
  color: rgba(255, 255, 255, 0.72);
}

.weekday {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.hero-copy {
  position: relative;
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.hero-progress-badge {
  min-width: 76rpx;
  height: 46rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #f7f8f3;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

.hero-progress {
  position: relative;
  margin-top: 22rpx;
}

.hero-progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 10rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 21rpx;
}

.hero-progress-track {
  width: 100%;
  height: 10rpx;
  display: flex;
  gap: 8rpx;
  overflow: visible;
  border-radius: 0;
  background: transparent;
}

.hero-progress-segment {
  height: 100%;
  flex: 1;
  min-width: 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
}

.hero-progress-segment.is-active {
  background: linear-gradient(90deg, #9ad9b0 0%, #5db98a 100%);
  animation: todayProgressFill 0.6s ease-out both;
}

.hero-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #9ad9b0 0%, #5db98a 50%, #2f6f61 100%);
  animation: todayProgressFill 0.6s ease-out both;
  transition: width 180ms ease-out;
}

@keyframes todayProgressFill {
  from {
    transform: scaleX(0);
    transform-origin: left center;
  }
  to {
    transform: scaleX(1);
    transform-origin: left center;
  }
}

.goal-card {
  align-items: flex-start;
  margin-bottom: 22rpx;
  padding: 28rpx 30rpx;
  border-color: rgba(230, 236, 232, 0.9);
  border-radius: 28rpx;
  box-shadow: var(--today-shadow);
}

.goal-card > view:first-child {
  min-width: 0;
  flex: 1;
}

.eyebrow {
  color: var(--today-primary);
  font-size: 22rpx;
  font-weight: 650;
}

.goal-title {
  margin-top: 8rpx;
  color: var(--today-text);
  font-size: 33rpx;
  font-weight: 700;
  line-height: 1.35;
}

.goal-description {
  margin-top: 8rpx;
  color: var(--today-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.goal-chip {
  min-height: 46rpx;
  display: inline-flex;
  align-items: center;
  flex: none;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--today-soft);
  color: var(--today-primary);
  font-size: 21rpx;
  font-weight: 650;
  white-space: nowrap;
}

.today-data-card {
  margin-top: 18rpx;
  padding: 24rpx 26rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(230, 236, 232, 0.9);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: var(--today-shadow);
}

.today-data-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.today-data-header > view:first-child {
  min-width: 0;
  flex: 1;
}

.today-data-title {
  color: var(--today-text);
  font-size: 30rpx;
  font-weight: 700;
}

.today-data-mood {
  margin-top: 6rpx;
  color: #b08a35;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 1.35;
}

.today-data-badge {
  min-height: 42rpx;
  display: inline-flex;
  align-items: center;
  flex: none;
  box-sizing: border-box;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #eff7f2;
  color: var(--today-primary);
  font-size: 22rpx;
  font-weight: 650;
  white-space: nowrap;
}

.today-data-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
  margin-top: 20rpx;
  border-top: 1rpx solid #edf1ee;
  border-left: 1rpx solid #edf1ee;
}

.today-data-item {
  min-width: 0;
  box-sizing: border-box;
  padding: 18rpx 18rpx 16rpx;
  border-right: 1rpx solid #edf1ee;
  border-bottom: 1rpx solid #edf1ee;
}

.today-data-value {
  color: var(--today-text);
  font-size: 28rpx;
  font-weight: 750;
  line-height: 1.2;
}

.today-data-efficiency {
  color: var(--today-primary-deep);
}

.today-data-label {
  margin-top: 6rpx;
  color: var(--today-muted);
  font-size: 22rpx;
}

.today-mood {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #eff7f2 0%, #fbfdfb 100%);
}

.today-mood-mark {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 18rpx;
  background: #356859;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
}

.today-mood-copy {
  min-width: 0;
  flex: 1;
}

.today-mood-title {
  color: var(--today-text);
  font-size: 29rpx;
  font-weight: 750;
  line-height: 1.25;
}

.today-mood-desc {
  margin-top: 6rpx;
  color: var(--today-secondary);
  font-size: 23rpx;
  line-height: 1.45;
}

.mood-done .today-mood-mark {
  background: #1f4d42;
}

.mood-half .today-mood-mark {
  background: #8bbf72;
}

.mood-low .today-mood-mark,
.mood-empty .today-mood-mark {
  background: #f3c76a;
  color: #1f4d42;
}

.today-data-footer {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf1ee;
}

.today-data-tag {
  min-height: 40rpx;
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #fff6df;
  color: #8a6730;
  font-size: 22rpx;
  font-weight: 600;
}

.daily-nudge-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(230, 236, 232, 0.82);
  border-radius: 26rpx;
  background: rgba(255, 248, 236, 0.72);
  box-shadow: 0 8rpx 24rpx rgba(21, 71, 58, 0.05);
}

.daily-nudge-label {
  flex: none;
  color: #8a6730;
  font-size: 22rpx;
  font-weight: 750;
  line-height: 1.45;
}

.daily-nudge-text {
  min-width: 0;
  flex: 1;
  color: var(--today-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.empty-card {
  text-align: center;
}

.empty-mark {
  width: 90rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border-radius: 28rpx;
  background: #dcebe4;
  color: var(--today-primary);
  font-weight: 700;
}

.action-section-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  width: 100%;
  box-sizing: border-box;
  margin: 20rpx 0 16rpx;
}

.action-section-left {
  min-width: 0;
  flex: 1;
}

.action-section-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  min-width: 118rpx;
}

.section-title {
  min-width: 0;
  color: #1f352f;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.25;
}

.section-caption {
  min-width: 0;
  margin-top: 6rpx;
  color: #8a9a93;
  font-size: 24rpx;
  line-height: 1.35;
}

.section-count {
  flex: none;
  margin-top: 10rpx;
  color: #a0aaa5;
  font-size: 24rpx;
  line-height: 1.35;
  text-align: right;
  white-space: nowrap;
}

.add-action-button {
  width: auto;
  min-width: 0;
  min-height: 48rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex: none;
  box-sizing: border-box;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: #2f6f61;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
}

.add-action-button:active {
  color: #1f4d42;
  opacity: 0.78;
}

.task-group {
  margin-top: 22rpx;
}

.group-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 2rpx 14rpx;
}

.group-title {
  color: var(--today-text);
  font-size: 27rpx;
  font-weight: 700;
}

.group-count {
  color: var(--today-muted);
  font-size: 21rpx;
}

.action-card-tap {
  margin-bottom: 14rpx;
}

.action-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid var(--today-border);
  border-radius: 24rpx;
  box-shadow: var(--today-shadow);
}

.action-card-completed {
  border-color: rgba(47, 111, 97, 0.14);
  background: #f1f8f4;
}

.action-card-body {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 118rpx;
}

.action-status-rail {
  width: 10rpx;
  align-self: stretch;
  flex: none;
  border-radius: 999rpx;
  background: #dcebe4;
}

.rail-success {
  background: linear-gradient(180deg, #8bbf72 0%, #2f6f61 100%);
}

.rail-warning {
  background: linear-gradient(180deg, #f3c76a 0%, #d8a84e 100%);
}

.rail-primary,
.rail-neutral,
.rail-muted {
  background: linear-gradient(180deg, #9ad9b0 0%, #5db98a 100%);
}

.action-main {
  min-width: 0;
  flex: 1;
}

.action-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.status-tag,
.source-tag,
.partial-hint {
  border-radius: 999rpx;
}

.status-muted { --tag-primary-color: #66736f; --tag-primary-light-color: #edf0ee; }
.status-neutral { --tag-primary-color: #46627a; --tag-primary-light-color: #e8f0f7; }

.action-title {
  margin-top: 12rpx;
  color: var(--today-text);
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.4;
}

.action-card-completed .action-title {
  color: #55716a;
  text-decoration: line-through;
  text-decoration-color: rgba(47, 111, 97, 0.42);
  text-decoration-thickness: 2rpx;
}

.action-description {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--today-secondary);
  font-size: 24rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.action-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx 18rpx;
  margin-top: 12rpx;
  color: var(--today-secondary);
  font-size: 22rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  white-space: nowrap;
}

.meta-label {
  color: var(--today-muted);
}

.action-complete-btn {
  width: 56rpx;
  min-width: 56rpx;
  max-width: 56rpx;
  height: 56rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  flex: none;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 3rpx solid #d4d9d3;
  border-radius: 999rpx;
  background: #ffffff;
  color: transparent;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

.action-complete-btn::after {
  border: 0;
}

.action-complete-btn:active {
  border-color: #2f6f61;
  background: #eef7f2;
  transform: scale(0.98);
}

.action-completed-icon {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 999rpx;
  background: #2f6f61;
  color: #ffffff;
  font-size: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(47, 111, 97, 0.2);
}

.action-list-toggle {
  min-height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 2rpx 0 16rpx;
  color: var(--today-muted);
  font-size: 23rpx;
  line-height: 1;
}

.empty-action-card {
  text-align: center;
  border-radius: 28rpx;
  box-shadow: var(--today-shadow);
}

.empty-add-button {
  margin-top: 28rpx;
  border-radius: 999rpx;
}

.quick-add-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  box-sizing: border-box;
}

.quick-add-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  background: rgba(31, 45, 42, 0.34);
  backdrop-filter: blur(6rpx);
}

.quick-add-panel {
  position: relative;
  width: calc(100vw - 48rpx);
  max-width: 680rpx;
  max-height: calc(100vh - 180rpx);
  overflow-y: auto;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 16rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 32rpx;
  background:
    linear-gradient(180deg, rgba(247, 250, 246, 0.98), #ffffff 250rpx);
  box-shadow: 0 16rpx 42rpx rgba(21, 71, 58, 0.16);
  animation: quick-add-enter 220ms ease-out both;
}

.quick-add-grabber {
  box-sizing: border-box;
  width: 70rpx;
  height: 7rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: #cbd6d0;
}

.quick-add-header {
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  width: 100%;
  box-sizing: border-box;
  padding-right: 72rpx;
}

.quick-add-header > view:first-child {
  min-width: 0;
  flex: 1;
}

.quick-add-kicker {
  color: #356859;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.quick-add-title {
  margin-top: 6rpx;
  color: #1f2d2a;
  font-size: 38rpx;
  font-weight: 750;
}

.quick-add-close {
  position: absolute;
  right: 32rpx;
  top: 32rpx;
  box-sizing: border-box;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 0;
  background: #f3f7f4;
  color: #6b837a;
  font-size: 30rpx;
  line-height: 1;
  z-index: 1;
}

.quick-add-close.is-disabled {
  opacity: 0.48;
  pointer-events: none;
}

.quick-add-close ant-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-add-close:active {
  background: #e7f0eb;
  color: #2f6f61;
}

.quick-add-copy {
  box-sizing: border-box;
  margin-top: 14rpx;
  color: #66736f;
  font-size: 24rpx;
  line-height: 1.6;
}

.quick-add-field {
  width: 100%;
  box-sizing: border-box;
  margin-top: 24rpx;
}

.quick-add-label {
  color: #1f2d2a;
  font-size: 25rpx;
  font-weight: 700;
}

.quick-add-hint {
  margin-top: 5rpx;
  color: #9aa6a1;
  font-size: 22rpx;
}

.quick-add-input,
.quick-add-textarea {
  width: 100%;
  box-sizing: border-box;
  margin-top: 12rpx;
  border: 1rpx solid #dfe8e3;
  border-radius: 24rpx;
  background: #fbfcfa;
  color: #1f2d2a;
  font-size: 28rpx;
}

.quick-add-input {
  height: 88rpx;
  padding: 0 24rpx;
}

.quick-add-textarea {
  height: 136rpx;
  padding: 20rpx 24rpx;
  line-height: 1.5;
}

.quick-add-placeholder {
  color: #9aa6a1;
}

.quick-add-minutes-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(53, 104, 89, 0.06);
  background: #eff7f2;
}

.quick-add-minutes-row > view:first-child {
  min-width: 0;
  flex: 1;
}

.quick-add-minutes-control {
  width: 220rpx;
  max-width: 100%;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: none;
  margin-top: 0;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(53, 104, 89, 0.08);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(21, 63, 54, 0.08);
}

.quick-add-minutes-control:active {
  background: #f8fbf9;
  box-shadow: 0 4rpx 14rpx rgba(21, 63, 54, 0.08);
}

.quick-add-minutes-value {
  color: #1f2d2a;
  font-size: 35rpx;
  font-weight: 750;
}

.quick-add-minute-unit {
  flex: none;
  color: #66736f;
  font-size: 23rpx;
}

.quick-add-picker-arrow {
  margin-left: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  color: #6b837a;
  font-size: 22rpx;
  line-height: 1;
}

.quick-add-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
  box-sizing: border-box;
  margin-top: 26rpx;
}

.quick-add-secondary,
.quick-add-primary {
  flex: 1;
  width: auto;
  min-width: 0;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.quick-add-secondary {
  border: 2rpx solid rgba(53, 104, 89, 0.2);
  background: #ffffff;
  color: #356859;
}

.quick-add-primary {
  background: #1f4d42;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(21, 71, 58, 0.16);
}

@keyframes quick-add-enter {
  from { transform: translateY(32rpx); opacity: 0; }
  to { transform: translateY(0); }
}

.quick-duration-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 22;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  box-sizing: border-box;
  background: rgba(31, 45, 42, 0.22);
}

.quick-duration-panel {
  width: 100%;
  max-height: calc(100vh - 180rpx);
  overflow-y: auto;
  box-sizing: border-box;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 48rpx rgba(21, 63, 54, 0.18);
  animation: quick-duration-enter 200ms ease-out both;
}

.quick-duration-header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 104rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #edf1ee;
}

.quick-duration-cancel,
.quick-duration-spacer {
  width: 120rpx;
  min-width: 0;
}

.quick-duration-cancel {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  height: 72rpx;
  color: #6b837a;
  font-size: 28rpx;
}

.quick-duration-title {
  flex: 1;
  min-width: 0;
  color: #1f2d2a;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.quick-duration-options {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 28rpx 28rpx 8rpx;
}

.quick-duration-option {
  position: relative;
  min-width: 0;
  min-height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid #e6ece8;
  border-radius: 22rpx;
  background: #f8faf8;
  color: #1f2d2a;
  font-weight: 650;
  box-shadow: 0 4rpx 14rpx rgba(21, 63, 54, 0.04);
}

.quick-duration-option.is-selected {
  border-color: rgba(53, 104, 89, 0.28);
  background: #eff7f2;
  color: #2f6f61;
  box-shadow: inset 0 0 0 1rpx rgba(53, 104, 89, 0.08);
}

.quick-duration-option-label {
  font-size: 27rpx;
}

.quick-duration-check {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #356859;
  color: #ffffff;
  font-size: 20rpx;
}

@keyframes quick-duration-enter {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
