.today-page {
  display: flex;
  flex-direction: column;
  padding-top: 40rpx;
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.page-state {
  margin-top: 80rpx;
}

.date-row,
.card-heading-row,
.section-title-row,
.goal-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
}

.weekday {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.greeting {
  margin-top: 22rpx;
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: 600;
}

.streak-pill {
  min-width: 166rpx;
  padding: 14rpx 18rpx;
  border-radius: 22rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 22rpx;
  text-align: center;
}

.streak-number {
  margin-right: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-goal-card {
  padding: 40rpx 36rpx;
}

.section-eyebrow {
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.empty-goal-title {
  max-width: 560rpx;
  margin-top: 18rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.5;
}

.empty-goal-description {
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.create-button {
  width: 100%;
}

.goal-card,
.progress-card,
.quick-task-card {
  margin-bottom: 24rpx;
}

.paused-notice {
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 22rpx;
  background: #f5eddf;
  color: #705b37;
  line-height: 1.55;
}

.paused-notice-title {
  margin-bottom: 6rpx;
  font-weight: 700;
}

.goal-title {
  max-width: 430rpx;
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
  word-break: break-all;
}

.category-tag {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 22rpx;
}

.goal-meta {
  justify-content: flex-start;
  margin-top: 30rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid var(--color-border);
}

.meta-item {
  flex: 1;
}

.meta-divider {
  width: 1rpx;
  height: 64rpx;
  margin: 0 30rpx;
  background: var(--color-border);
}

.meta-value {
  font-size: 28rpx;
  font-weight: 650;
}

.meta-label {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.progress-count {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
}

.progress-count-strong {
  color: var(--color-text);
  font-size: 38rpx;
  font-weight: 700;
}

.progress-rate {
  color: var(--color-primary);
  font-size: 42rpx;
  font-weight: 700;
}

.progress-track {
  height: 18rpx;
  margin-top: 26rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e8ece6;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
  transition: width 220ms ease;
}

.progress-status {
  margin-top: 16rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.quick-task-card {
  order: 4;
  margin-top: 24rpx;
}

.progress-card {
  order: 2;
}

.task-section {
  order: 3;
}

.quick-task-hint {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 1.45;
}

.more-settings-button {
  padding: 10rpx 0 10rpx 24rpx;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.quick-task-input {
  width: 100%;
  min-height: 92rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  background: #fbfcfa;
  color: var(--color-text);
  font-size: 30rpx;
}

.quick-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
}

.quick-chip {
  min-width: 124rpx;
  padding: 14rpx 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  background: #fbfcfa;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  text-align: center;
}

.quick-chip-active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 650;
}

.more-settings {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--color-border);
}

.field-label {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.small-input {
  min-height: 80rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
}

.add-task-button {
  width: 100%;
}

.task-section {
  margin-top: 34rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
}

.section-count {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.task-card {
  margin-top: 20rpx;
  padding: 28rpx;
  transition: background 180ms ease, border-color 180ms ease;
}

.task-main-row {
  display: flex;
  align-items: center;
}

.task-card-completed {
  border-color: #cfe1d8;
  background: #f3f8f5;
}

.task-content {
  flex: 1;
  min-width: 0;
}

.task-title {
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.45;
}

.task-title-completed {
  color: #56645b;
}

.task-description {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.55;
}

.task-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  margin-top: 12rpx;
}

.task-duration,
.task-source {
  color: #879087;
  font-size: 22rpx;
}

.task-source {
  max-width: 280rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #eef2ec;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.period-group {
  margin-top: 24rpx;
}

.period-title {
  padding-left: 6rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 650;
}

.task-toggle {
  min-width: 140rpx;
  margin-left: 24rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid var(--color-primary);
  border-radius: 999rpx;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.task-toggle-completed {
  background: var(--color-primary);
  color: #ffffff;
}

.task-toggle-icon {
  display: inline-block;
  min-width: 24rpx;
  margin-right: 6rpx;
}

.task-toggle[disabled] {
  opacity: 0.65;
}

.task-detail-toggle {
  margin-top: 18rpx;
  padding: 10rpx 0;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.task-detail-panel {
  margin-top: 16rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-border);
}

.task-detail-item + .task-detail-item {
  margin-top: 18rpx;
}

.task-detail-label {
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.4;
}

.task-detail-text {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.65;
  word-break: break-all;
}

.task-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 10rpx;
}

.task-info-chip {
  max-width: 100%;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eef2ec;
  color: #56645b;
  font-size: 22rpx;
  line-height: 1.4;
  word-break: break-all;
}

.task-note-list {
  margin-top: 10rpx;
}

.task-note-item {
  position: relative;
  padding-left: 22rpx;
  color: #705b37;
  font-size: 24rpx;
  line-height: 1.65;
  word-break: break-all;
}

.task-note-item::before {
  position: absolute;
  top: 16rpx;
  left: 0;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #b08a42;
  content: "";
}

.no-task-card {
  margin-top: 20rpx;
  padding: 44rpx 30rpx;
  text-align: center;
}

.small-mark {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto;
  border-radius: 22rpx;
  font-size: 30rpx;
}

.no-task-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 650;
}

.source-summary {
  margin-top: 26rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.64);
}

.source-summary-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.bottom-action {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  background: rgba(255, 255, 255, 0.96);
}

.checkin-button {
  width: 100%;
  padding: 26rpx 30rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-weight: 650;
}

.checkin-button[disabled] {
  background: #d9ded8;
  color: #899087;
}

.checkin-button-done {
  background: #e3efe9;
  color: var(--color-primary);
}

@media (max-width: 340px) {
  .date-row,
  .card-heading-row {
    align-items: flex-start;
  }

  .streak-pill {
    min-width: 142rpx;
    margin-left: 16rpx;
  }

  .task-main-row {
    align-items: flex-start;
  }

  .task-toggle {
    min-width: 124rpx;
    margin-left: 16rpx;
    padding-right: 14rpx;
    padding-left: 14rpx;
  }
}
