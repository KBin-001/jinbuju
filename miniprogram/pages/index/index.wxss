  border: 1rpx solid #e6ece8;
  border-radius: 22rpx;
  background: #f8faf8;
  color: #1f2d2a;
  font-weight: 650;
  box-shadow: 0 4rpx 14rpx rgba(21, 63, 54, 0.04);
}

.quick-duration-option.is-selected {
  border-color: rgba(53, 104, 89, 0.28);
