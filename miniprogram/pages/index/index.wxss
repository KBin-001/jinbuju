/* =========================================================
 * 今日页 · 浅绿成长风
 * --------------------------------------------------------
 * 设计方向：浅绿、白卡片、轻阴影、极少量深绿
 * 关键决策：Hero 改白卡 + 极浅薄荷绿，Action Panel 顶部用浅绿渐变
 * ========================================================= */

@import "../../styles/theme.wxss";

/* ============ 墨绿成长主题 覆写 ============
 * 由于本页 WXSS 中存在大量硬编码的薄荷绿颜色（rgba/hex/gradient），
 * 这些值在切换到墨绿主题后不会自动跟随 CSS 变量。
 * 因此在切换至墨绿主题时，对最显眼的关键硬编码值做精细化覆写：
 *  · 进度条渐变（active / fill）
 *  · 卡片进度滑轨（rail-success / rail-primary / rail-warning）
 *  · 完成图标阴影
 *  · 心情、提示语等次级色
 * 其余依赖 CSS 变量的样式已被 theme.wxss 覆盖。
 * ---------------------------------------------------------- */
.today-page[data-theme="inkGreen"] {
  --today-primary: #1F6F55;
  --today-primary-deep: #0F3F32;
  --today-accent: #6DBB95;
}

.today-page[data-theme="inkGreen"] .today-hero::after {
  background: rgba(31, 111, 85, 0.20);
}

.today-page[data-theme="inkGreen"] .hero-progress-segment {
  background: rgba(109, 187, 149, 0.32);
}

.today-page[data-theme="inkGreen"] .hero-progress-segment.is-active {
  background: linear-gradient(90deg, #6DBB95 0%, #1F6F55 100%);
}

.today-page[data-theme="inkGreen"] .hero-progress-fill {
  background: linear-gradient(90deg, #6DBB95 0%, #1F6F55 100%);
}

.today-page[data-theme="inkGreen"] .progress-ring {
  background: conic-gradient(#6DBB95 var(--ring-deg, 0%), rgba(109, 187, 149, 0.18) 0);
}

.today-page[data-theme="inkGreen"] .week-switch,
.today-page[data-theme="inkGreen"] .week-day.is-today .week-number,
.today-page[data-theme="inkGreen"] .week-day.is-selected .week-number {
  box-shadow: 0 8rpx 18rpx rgba(31, 111, 85, 0.28);
}

.today-page[data-theme="inkGreen"] .rail-success { background: linear-gradient(180deg, #6DBB95 0%, #1F6F55 100%); }
.today-page[data-theme="inkGreen"] .rail-warning { background: linear-gradient(180deg, #F4C95D 0%, #E0A832 100%); }
.today-page[data-theme="inkGreen"] .rail-primary,
.today-page[data-theme="inkGreen"] .rail-neutral,
.today-page[data-theme="inkGreen"] .rail-muted { background: linear-gradient(180deg, #C8E0D4 0%, #6DBB95 100%); }

.today-page[data-theme="inkGreen"] .action-card-completed {
  border-color: rgba(66, 166, 122, 0.30);
}

.today-page[data-theme="inkGreen"] .action-card-completed .action-title {
  text-decoration-color: rgba(66, 166, 122, 0.42);
}

.today-page[data-theme="inkGreen"] .action-completed-icon,
.today-page[data-theme="inkGreen"] .today-bottom-action,
.today-page[data-theme="inkGreen"] .quick-add-primary,
.today-page[data-theme="inkGreen"] .calendar-confirm,
.today-page[data-theme="inkGreen"] .quick-duration-check {
  box-shadow: 0 8rpx 24rpx rgba(31, 111, 85, 0.28);
}

.today-page[data-theme="inkGreen"] .today-data-mood {
  color: #B08A35;
}

.today-page[data-theme="inkGreen"] .daily-nudge-label,
.today-page[data-theme="inkGreen"] .today-data-tag {
  color: #8A6B1F;
}

.today-page[data-theme="inkGreen"] .quick-add-mask,
.today-page[data-theme="inkGreen"] .quick-duration-layer {
  background: rgba(15, 63, 50, 0.36);
}

.today-page[data-theme="inkGreen"] .calendar-mask {
  background: rgba(15, 63, 50, 0.18);
}

.today-page[data-theme="inkGreen"] .calendar-day.is-outside {
  color: #B6C7C0;
}

/* 展开日历选中态：与今日页内联周日历保持一致的黄色，避免旧模板绿色选中态 */
.today-page[data-theme="inkGreen"] .calendar-day.is-selected .calendar-day-number {
  background: #F4C95D;
  color: #2F4A3F;
  font-weight: 800;
  box-shadow: 0 8rpx 18rpx rgba(244, 201, 93, 0.28);
}

/* 今日但未被选中：浅绿柔和标记，与内联周日历一致 */
.today-page[data-theme="inkGreen"] .calendar-day.is-today:not(.is-selected) .calendar-day-number {
  background: #EAF5EF;
  color: #356859;
}

.today-page {
  --today-primary: var(--color-primary);
  --today-primary-deep: var(--color-primary-deep);
  --today-accent: var(--color-primary-light);
  --today-gold: var(--color-warning);
  --today-text: var(--color-text-main);
  --today-secondary: var(--color-text-secondary);
  --today-muted: var(--color-text-muted);
  --today-border: var(--color-border);
  --today-shadow: var(--shadow-card);
  --today-shadow-soft: var(--shadow-card-soft);
  padding: 28rpx 32rpx calc(166rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  min-height: 100vh;
}

/* ============ 顶部问候 ============ */
.today-topbar {
  min-height: 104rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 10rpx;
  padding: 22rpx 178rpx 10rpx 0;
}

.today-greeting {
  color: var(--color-text-main);
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.today-subtitle {
  margin-top: 4rpx;
  color: var(--color-text-muted);
  font-size: 23rpx;
  line-height: 32rpx;
}

.today-mini-date {
  min-height: 48rpx;
  display: inline-flex;
  align-items: center;
  flex: none;
  padding: 0 18rpx;
  border-radius: 24rpx;
  background: var(--color-card);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: var(--shadow-card-soft);
}

/* ============ Hero（白卡 + 极浅薄荷渐变，不再大面积深绿） ============ */
.today-hero {
  margin-bottom: 24rpx;
  padding: 32rpx 32rpx 30rpx;
  border-radius: 32rpx;
  background: var(--gradient-card-mint);
  color: var(--color-text-main);
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
}

.today-hero::after {
  content: "";
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(124, 198, 160, 0.22);
  pointer-events: none;
}

.hero-topline {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  z-index: 1;
}

.hero-kicker {
  position: relative;
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.hero-date-pill {
  min-height: 42rpx;
  display: inline-flex;
  align-items: center;
  flex: none;
  box-sizing: border-box;
  padding: 0 16rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  color: var(--color-primary-deep);
  font-size: 21rpx;
  font-weight: 600;
  white-space: nowrap;
}

.hero-focus {
  position: relative;
  margin-top: 24rpx;
  z-index: 1;
}

.hero-day-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hero-day {
  color: var(--color-text-secondary);
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  line-height: 1;
}

.hero-status-pill {
  min-height: 36rpx;
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  padding: 0 14rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  background: var(--color-card);
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 650;
  line-height: 1;
}

.hero-focus-title {
  max-width: 520rpx;
  display: -webkit-box;
  overflow: hidden;
  margin-top: 10rpx;
  color: var(--color-text-main);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.16;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.weekday {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.hero-copy {
  position: relative;
  margin-top: 18rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.5;
  z-index: 1;
}

.hero-progress-badge {
  min-width: 76rpx;
  height: 46rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  color: var(--color-primary-deep);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

.hero-progress {
  position: relative;
  margin-top: 22rpx;
  z-index: 1;
}

.hero-progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 10rpx;
  color: var(--color-text-secondary);
  font-size: 21rpx;
}

.hero-progress-track {
  width: 100%;
  height: 12rpx;
  display: flex;
  gap: 8rpx;
  overflow: visible;
  border-radius: 0;
  background: transparent;
}

.hero-progress-segment {
  height: 100%;
  flex: 1;
  min-width: 0;
  border-radius: 999rpx;
  background: rgba(124, 198, 160, 0.32);
}

.hero-progress-segment.is-active {
  background: linear-gradient(90deg, #9BD9B7 0%, #68BE8F 100%);
  animation: todayProgressFill 0.6s ease-out both;
}

.hero-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #7CC6A0 0%, #3F8F72 100%);
  animation: todayProgressFill 0.6s ease-out both;
  transition: width 180ms ease-out;
}

@keyframes todayProgressFill {
  from {
    transform: scaleX(0);
    transform-origin: left center;
  }
  to {
    transform: scaleX(1);
    transform-origin: left center;
  }
}

/* ============ 周历卡片 ============ */
.week-card {
  height: 184rpx;
  min-height: 184rpx;
  margin-top: 10rpx;
  padding: 22rpx 26rpx 18rpx;
  border-radius: 28rpx;
  background: var(--color-card);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.week-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
  height: 40rpx;
}

.week-title {
  color: var(--color-text-main);
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.week-title text {
  margin-left: 10rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
}

.week-switch {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 30rpx;
  box-shadow: 0 8rpx 18rpx rgba(63, 143, 114, 0.22);
}

.week-chevron {
  width: 12rpx;
  height: 12rpx;
  box-sizing: border-box;
  border-right: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: translateY(-2rpx) rotate(45deg);
}

.week-switch:active {
  opacity: 0.86;
  transform: scale(0.96);
}

.week-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 0;
}

.week-day {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  height: 86rpx;
  justify-content: flex-start;
  color: var(--color-text-muted);
}

.week-label {
  height: 28rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 28rpx;
}

.week-number {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 44rpx;
  font-weight: 700;
}

.week-day.is-today .week-number {
  background: var(--color-primary);
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(63, 143, 114, 0.22);
}

.week-day.is-today .week-label {
  color: var(--color-primary);
  font-weight: 800;
}

.week-day.is-selected .week-number {
  background: var(--color-primary);
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(63, 143, 114, 0.24);
}

.week-day.is-selected .week-label {
  color: var(--color-primary);
  font-weight: 800;
}

.week-day.is-today:not(.is-selected) .week-number {
  background: var(--color-primary-soft);
  color: var(--color-primary);
  box-shadow: none;
}

.week-day.is-muted {
  opacity: 0.45;
}

.week-day.is-muted.is-selected {
  opacity: 1;
}

/* ============ 今日行动面板（顶部用浅绿渐变，主体白卡） ============ */
.today-action-panel {
  overflow: hidden;
  margin-top: 28rpx;
  border-radius: 28rpx;
  background: var(--color-card);
  box-shadow: var(--shadow-card);
}

.today-action-hero {
  min-height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
  padding: 28rpx 30rpx;
  background:
    radial-gradient(circle at 80% 45%, rgba(255, 255, 255, 0.4), transparent 30%),
    var(--gradient-card-mint);
  color: var(--color-text-main);
}

.action-hero-label {
  color: var(--color-primary);
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.action-hero-count {
  display: flex;
  align-items: baseline;
  margin-top: 10rpx;
  color: var(--color-text-main);
}

.action-hero-count text:first-child {
  font-size: 50rpx;
  line-height: 58rpx;
  font-weight: 800;
}

.action-total {
  font-size: 34rpx;
  font-weight: 800;
}

.action-unit {
  margin-left: 10rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  font-weight: 600;
}

.action-hero-goal {
  max-width: 376rpx;
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 30rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 100% 圆环：使用 primary-light */
.progress-ring {
  width: 108rpx;
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  background: conic-gradient(var(--color-primary-light) var(--ring-deg, 0%), rgba(124, 198, 160, 0.18) 0);
  transition: background 180ms ease-out;
}

.progress-ring-inner {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-card);
  color: var(--color-primary-deep);
}

.progress-ring-inner view {
  font-size: 27rpx;
  line-height: 32rpx;
  font-weight: 800;
}

.progress-ring-inner text {
  margin-top: 4rpx;
  color: var(--color-text-secondary);
  font-size: 18rpx;
  line-height: 22rpx;
}

/* 任务列表 */
.today-action-list {
  padding: 20rpx 28rpx 26rpx;
  background: var(--color-card);
}

.today-task-row {
  min-height: 80rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.today-task-row + .today-task-row {
  margin-top: 4rpx;
}

.task-box {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border: 2rpx solid #c9d8d1;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 20rpx;
  transition: background 160ms ease-out, border-color 160ms ease-out, transform 160ms ease-out;
}

.today-task-row.is-done .task-box {
  border-color: var(--color-success);
  background: var(--color-success);
  transform: scale(1.02);
}

.task-copy {
  min-width: 0;
  flex: 1;
}

.task-title {
  color: var(--color-text-main);
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-desc {
  margin-top: 2rpx;
  color: var(--color-text-muted);
  font-size: 22rpx;
  line-height: 30rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.today-task-row.is-done .task-title {
  color: var(--color-text-secondary);
}

.task-tail-check {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  color: var(--color-primary);
  font-size: 26rpx;
}

.action-list-toggle {
  min-height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin: 8rpx 0 6rpx 50rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
  line-height: 1;
}

.action-empty-inline {
  padding: 8rpx 0 22rpx;
  color: var(--color-text-main);
  font-size: 28rpx;
  font-weight: 700;
}

.action-empty-inline text {
  display: block;
  margin-top: 8rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
  font-weight: 400;
}

.inline-add-action {
  width: 100%;
  height: 72rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-sizing: border-box;
  margin-top: 8rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 700;
}

/* ============ 今日统计卡 ============ */
.today-data-card {
  margin-top: 28rpx;
  padding: 26rpx 28rpx;
  border-radius: 28rpx;
  background: var(--color-card);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.today-data-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.today-data-header > view:first-child {
  min-width: 0;
  flex: 1;
}

.today-data-title {
  color: var(--color-text-main);
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 800;
}

.today-data-mood {
  margin-top: 6rpx;
  color: #B08A35;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 1.35;
}

.today-data-badge {
  min-height: 42rpx;
  display: inline-flex;
  align-items: center;
  flex: none;
  box-sizing: border-box;
  padding: 0 16rpx;
  border-radius: 20rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 650;
  white-space: nowrap;
}

.today-data-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
  margin-top: 22rpx;
  border: 0;
}

.today-data-item {
  min-width: 0;
  min-height: 86rpx;
  padding: 0 8rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  text-align: center;
  box-sizing: border-box;
}

.today-data-item + .today-data-item {
  border-left: 1rpx solid var(--color-border-soft);
}

.today-data-value {
  color: var(--color-text-main);
  font-size: 40rpx;
  line-height: 48rpx;
  font-weight: 800;
}

.today-data-value text {
  margin-left: 4rpx;
  color: var(--color-text-main);
  font-size: 19rpx;
  font-weight: 700;
}

.today-data-efficiency {
  color: var(--color-primary-deep);
}

.today-data-label {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 30rpx;
}

.today-data-footer {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-border-soft);
}

.today-data-tag {
  min-height: 40rpx;
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: var(--color-warning-soft);
  color: #8A6B1F;
  font-size: 22rpx;
  font-weight: 600;
}

/* ============ 心情 / 低压力卡 ============ */
.today-mood {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: var(--color-card-soft);
}

.today-mood-mark {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 18rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
}

.today-mood-copy {
  min-width: 0;
  flex: 1;
}

.today-mood-title {
  color: var(--color-text-main);
  font-size: 29rpx;
  font-weight: 750;
  line-height: 1.25;
}

.today-mood-desc {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 1.45;
}

.mood-done .today-mood-mark { background: var(--color-primary-deep); }
.mood-half .today-mood-mark { background: var(--color-primary-light); color: var(--color-primary-deep); }
.mood-low .today-mood-mark,
.mood-empty .today-mood-mark { background: var(--color-warning); color: #6B5418; }

/* ============ 每日小提示（黄底） ============ */
.daily-nudge-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 26rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: var(--color-warning-soft);
  box-shadow: none;
}

.daily-nudge-label {
  flex: none;
  color: #8A6B1F;
  font-size: 22rpx;
  font-weight: 750;
  line-height: 1.45;
}

.daily-nudge-text {
  min-width: 0;
  flex: 1;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.quote-mark {
  flex: none;
  color: #B7BDB8;
  font-size: 44rpx;
  line-height: 40rpx;
  font-weight: 800;
}

/* ============ 目标卡 / 段头 / 操作 ============ */
.goal-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  align-items: flex-start;
  margin-bottom: 22rpx;
  padding: 28rpx 30rpx;
  border-color: var(--color-border);
  border-radius: 28rpx;
  background: var(--color-card);
  box-shadow: var(--shadow-card);
}

.goal-card > view:first-child {
  min-width: 0;
  flex: 1;
}

.eyebrow {
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 650;
}

.goal-title {
  margin-top: 8rpx;
  color: var(--color-text-main);
  font-size: 33rpx;
  font-weight: 700;
  line-height: 1.35;
}

.goal-description {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.goal-chip {
  min-height: 46rpx;
  display: inline-flex;
  align-items: center;
  flex: none;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 21rpx;
  font-weight: 650;
  white-space: nowrap;
}

.empty-card {
  margin-top: 24rpx;
  text-align: center;
}

.empty-mark {
  width: 90rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border-radius: 28rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-weight: 700;
}

/* ============ 行动段头 / 添加按钮 ============ */
.action-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  width: 100%;
  box-sizing: border-box;
  margin: 20rpx 0 16rpx;
}

.action-section-left {
  min-width: 0;
  flex: 1;
}

.action-section-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  min-width: 118rpx;
}

.section-title {
  min-width: 0;
  color: var(--color-text-main);
  font-size: 34rpx;
  line-height: 42rpx;
  font-weight: 700;
}

.section-caption {
  min-width: 0;
  margin-top: 6rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
  line-height: 1.35;
}

.section-count {
  flex: none;
  margin-top: 10rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
  line-height: 1.35;
  text-align: right;
  white-space: nowrap;
}

.add-action-button {
  min-height: 56rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex: none;
  box-sizing: border-box;
  padding: 0 8rpx;
  border-radius: 0;
  background: transparent;
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}

.add-action-button:active {
  color: var(--color-primary-deep);
  opacity: 0.78;
}

/* ============ 行动任务卡片 ============ */
.task-group {
  margin-top: 22rpx;
}

.group-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 2rpx 14rpx;
}

.group-title {
  color: var(--color-text-main);
  font-size: 27rpx;
  font-weight: 700;
}

.group-count {
  color: var(--color-text-muted);
  font-size: 21rpx;
}

.action-card-tap {
  width: 100%;
  margin-bottom: 20rpx;
}

.action-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  border-radius: 28rpx;
  background: var(--color-card);
  box-shadow: var(--shadow-card);
}

.action-card .card-body {
  padding: 26rpx 28rpx;
}

.action-card-completed {
  border-color: rgba(104, 190, 143, 0.24);
  background: var(--color-card-hover);
}

.action-card-body {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 136rpx;
}

.action-status-rail {
  width: 10rpx;
  align-self: stretch;
  flex: none;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
}

.rail-success { background: linear-gradient(180deg, #9BD9B7 0%, #68BE8F 100%); }
.rail-warning { background: linear-gradient(180deg, #F4C95D 0%, #E0A832 100%); }
.rail-primary,
.rail-neutral,
.rail-muted { background: linear-gradient(180deg, #C5E5D4 0%, #7CC6A0 100%); }

.action-main {
  min-width: 0;
  flex: 1;
}

.action-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.status-tag,
.source-tag,
.partial-hint {
  height: 40rpx;
  padding: 0 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
}

.status-muted { --tag-primary-color: var(--color-text-secondary); --tag-primary-light-color: #EEF1ED; }
.status-neutral { --tag-primary-color: #46627A; --tag-primary-light-color: #E8F0F7; }

.action-title {
  margin-top: 12rpx;
  color: var(--color-text-main);
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 700;
}

.action-card-completed .action-title {
  color: var(--color-text-secondary);
  text-decoration: line-through;
  text-decoration-color: rgba(104, 190, 143, 0.42);
  text-decoration-thickness: 2rpx;
}

.action-description {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.action-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx 18rpx;
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  white-space: nowrap;
}

.meta-label {
  color: var(--color-text-muted);
}

/* 完成按钮（小圆形） */
.action-complete-btn,
.action-completed-icon {
  width: 56rpx;
  min-width: 56rpx;
  max-width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}

.action-complete-btn {
  border: 2rpx solid #C9D8D1;
  background: var(--color-card);
  color: transparent;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

.action-complete-btn::after { border: 0; }

.action-complete-btn:active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  transform: scale(0.98);
}

.action-completed-icon {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #ffffff;
  font-size: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(63, 143, 114, 0.22);
}

.empty-action-card {
  text-align: center;
  border-radius: 28rpx;
  box-shadow: var(--shadow-card);
}

.empty-add-button {
  margin-top: 28rpx;
  border-radius: 999rpx;
}

/* ============ 底部操作 ============ */
.today-bottom-action {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  border-radius: 44rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(63, 143, 114, 0.22);
}

/* ============ 快速添加面板 ============ */
.quick-add-layer {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  box-sizing: border-box;
}

.quick-add-mask {
  position: absolute;
  inset: 0;
  box-sizing: border-box;
  background: rgba(36, 76, 67, 0.32);
  backdrop-filter: blur(6rpx);
}

.quick-add-panel {
  position: relative;
  width: calc(100vw - 48rpx);
  max-width: 680rpx;
  max-height: calc(100vh - 180rpx);
  overflow-y: auto;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 16rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border: 1rpx solid var(--color-border);
  border-radius: 32rpx;
  background: linear-gradient(180deg, var(--color-bg), var(--color-card) 250rpx);
  box-shadow: var(--shadow-float);
  animation: quick-add-enter 220ms ease-out both;
}

.quick-add-grabber {
  box-sizing: border-box;
  width: 70rpx;
  height: 7rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: var(--color-border);
}

.quick-add-header {
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  width: 100%;
  box-sizing: border-box;
  padding-right: 72rpx;
}

.quick-add-header > view:first-child {
  min-width: 0;
  flex: 1;
}

.quick-add-kicker {
  color: var(--color-primary);
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.quick-add-title {
  margin-top: 6rpx;
  color: var(--color-text-main);
  font-size: 38rpx;
  font-weight: 750;
}

.quick-add-close {
  position: absolute;
  right: 32rpx;
  top: 32rpx;
  box-sizing: border-box;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--color-bg);
  color: var(--color-text-secondary);
  font-size: 30rpx;
  line-height: 1;
  z-index: 1;
}

.quick-add-close.is-disabled {
  opacity: 0.48;
  pointer-events: none;
}

.quick-add-close:active {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.quick-add-copy {
  box-sizing: border-box;
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.quick-add-field {
  width: 100%;
  box-sizing: border-box;
  margin-top: 24rpx;
}

.quick-add-label {
  color: var(--color-text-main);
  font-size: 25rpx;
  font-weight: 700;
}

.quick-add-hint {
  margin-top: 5rpx;
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.quick-add-input,
.quick-add-textarea {
  width: 100%;
  box-sizing: border-box;
  margin-top: 12rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-card);
  color: var(--color-text-main);
  font-size: 28rpx;
}

.quick-add-input {
  height: 88rpx;
  padding: 0 24rpx;
}

.quick-add-textarea {
  height: 136rpx;
  padding: 20rpx 24rpx;
  line-height: 1.5;
}

.quick-add-placeholder {
  color: var(--color-text-muted);
}

.quick-add-minutes-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid var(--color-border);
  background: var(--color-card-soft);
}

.quick-add-minutes-row > view:first-child {
  min-width: 0;
  flex: 1;
}

.quick-add-minutes-control {
  width: 220rpx;
  max-width: 100%;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: none;
  margin-top: 0;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-card);
  box-shadow: var(--shadow-card-soft);
}

.quick-add-minutes-control:active {
  background: var(--color-card-hover);
  box-shadow: var(--shadow-card-soft);
}

.quick-add-minutes-value {
  color: var(--color-text-main);
  font-size: 35rpx;
  font-weight: 750;
}

.quick-add-minute-unit {
  flex: none;
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.quick-add-picker-arrow {
  margin-left: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 1;
}

.quick-add-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
  box-sizing: border-box;
  margin-top: 26rpx;
}

.quick-add-secondary,
.quick-add-primary {
  flex: 1;
  width: auto;
  min-width: 0;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.quick-add-secondary {
  border: 2rpx solid var(--color-border);
  background: var(--color-card);
  color: var(--color-primary);
}

.quick-add-primary {
  background: var(--color-primary);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(63, 143, 114, 0.22);
}

@keyframes quick-add-enter {
  from { transform: translateY(32rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

/* ============ 时长选择弹层 ============ */
.quick-duration-layer {
  position: fixed;
  inset: 0;
  z-index: 22;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  box-sizing: border-box;
  background: rgba(36, 76, 67, 0.22);
}

.quick-duration-panel {
  width: 100%;
  max-height: calc(100vh - 180rpx);
  overflow-y: auto;
  box-sizing: border-box;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: var(--color-card);
  box-shadow: var(--shadow-float);
  animation: quick-duration-enter 200ms ease-out both;
}

.quick-duration-header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 104rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--color-border-soft);
}

.quick-duration-cancel,
.quick-duration-spacer {
  width: 120rpx;
  min-width: 0;
}

.quick-duration-cancel {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  height: 72rpx;
  color: var(--color-text-secondary);
  font-size: 28rpx;
}

.quick-duration-title {
  flex: 1;
  min-width: 0;
  color: var(--color-text-main);
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.quick-duration-options {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 28rpx 28rpx 8rpx;
}

.quick-duration-option {
  position: relative;
  min-width: 0;
  min-height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid var(--color-border);
  border-radius: 22rpx;
  background: var(--color-card-soft);
  color: var(--color-text-main);
  font-weight: 650;
  box-shadow: var(--shadow-card-soft);
}

.quick-duration-option.is-selected {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-primary);
  box-shadow: inset 0 0 0 1rpx rgba(63, 143, 114, 0.1);
}

.quick-duration-option-label {
  font-size: 27rpx;
}

.quick-duration-check {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 20rpx;
}

@keyframes quick-duration-enter {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* ============ 日历弹层 ============ */
.calendar-layer {
  position: fixed;
  inset: 0;
  z-index: 18;
  box-sizing: border-box;
  padding: 330rpx 48rpx 0;
}

.calendar-mask {
  position: absolute;
  inset: 0;
  background: rgba(36, 76, 67, 0.16);
}

.calendar-panel {
  position: relative;
  width: 100%;
  max-width: 640rpx;
  box-sizing: border-box;
  margin: 0 auto;
  padding: 28rpx 32rpx 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 28rpx;
  background: var(--color-card);
  box-shadow: var(--shadow-float);
}

.calendar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.calendar-title {
  color: var(--color-primary-deep);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.calendar-nav {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 999rpx;
  color: var(--color-primary);
  font-size: 42rpx;
  line-height: 1;
}

.calendar-nav:active {
  background: var(--color-primary-soft);
}

.calendar-week-row,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
}

.calendar-week-row {
  margin-top: 22rpx;
}

.calendar-week-label {
  color: var(--color-text-muted);
  font-size: 22rpx;
  font-weight: 650;
  line-height: 34rpx;
  text-align: center;
}

.calendar-grid {
  row-gap: 12rpx;
  margin-top: 12rpx;
}

.calendar-day {
  position: relative;
  min-height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-main);
  font-size: 25rpx;
  font-weight: 700;
}

.calendar-day-number {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
}

.calendar-day.is-outside {
  color: #C2CBC6;
}

.calendar-day.is-today:not(.is-selected) .calendar-day-number {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.calendar-day.is-selected .calendar-day-number {
  background: var(--color-primary);
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(63, 143, 114, 0.22);
}

.calendar-dot {
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: var(--color-warning);
  transform: translateX(-50%);
}

.calendar-dot.is-completed {
  background: var(--color-success);
}

.calendar-day.is-selected .calendar-dot {
  background: #ffffff;
}

.calendar-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--color-border-soft);
}

.calendar-today {
  min-height: 58rpx;
  display: flex;
  align-items: center;
  color: var(--color-primary);
