@media (max-width: 350px) {
  .today-page { padding-right: 28rpx; padding-left: 28rpx; }
  .today-hero { margin-right: -28rpx; margin-left: -28rpx; }
  .today-brand { padding-right: 160rpx; padding-left: 42rpx; }
  .today-brand__title { font-size: 64rpx; }
  .today-profile-row { min-height: 148rpx; }
  .today-avatar { width: 78rpx; height: 78rpx; }
  .today-greeting-copy { margin-left: 17rpx; }
  .today-greeting { font-size: 26rpx; }
  .today-subtitle { font-size: 17rpx; }
  .action-streak { width: 126rpx; padding-left: 18rpx; }
  .action-streak__value { font-size: 32rpx; }
  .task-section-title { font-size: 33rpx; }
  .task-section-tools { gap: 12rpx; }
  .task-tool { gap: 4rpx; font-size: 16rpx; }
}

/* 今日页 2026-07-28：按目标稿重构为紧凑、线性、可执行的首页。 */
.today-page {
  position: relative;
  isolation: isolate;
  width: 100%;
  padding-right: 44rpx;
  padding-left: 44rpx;
  overflow-x: hidden;
  box-sizing: border-box;
  touch-action: pan-y;
  background: #f8f4ed;
}
.today-page--timing { padding-bottom: calc(232rpx + env(safe-area-inset-bottom)); }

.today-atmosphere {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;
  width: 100%;
  height: 660rpx;
  display: block;
  opacity: 1;
  pointer-events: none;
}
.today-hero {
  position: relative;
  z-index: 1;
  margin-right: -44rpx;
  margin-left: -44rpx;
}
.today-brand,
.today-profile-row { display: none; }
.today-header {
  position: relative;
  z-index: 2;
  height: 100%;
  padding-right: 54rpx;
  padding-bottom: 10rpx;
  padding-left: 58rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  box-sizing: border-box;
}
.today-header__copy { min-width: 0; }
.today-header__brand-row {
  display: flex;
  align-items: center;
}
.today-header__brand-logo { width: 148rpx; height: auto; display: block; }
.today-header__date {
  margin-top: 4rpx;
  color: #3f433f;
  font-family: var(--font-family-numeric);
  font-size: 24rpx;
  line-height: 34rpx;
  font-variant-numeric: tabular-nums;
}
.today-header__streak {
  margin-bottom: 0;
  display: flex;
  align-items: baseline;
  gap: 7rpx;
  color: #373c38;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 38rpx;
  white-space: nowrap;
  transform: translateY(12rpx);
}
.today-header__streak-number {
  color: #b17d19;
  font-family: var(--font-family-numeric);
  font-size: 40rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.today-notification,
.state-card,
.today-coach,
.week-card,
.empty-card,
.task-section,
daily-progress {
  position: relative;
  z-index: 1;
}
.today-notification { margin-top: 12rpx; }
.today-coach { display: block; margin-top: -18rpx; }
.week-card {
  min-height: 164rpx;
  margin-top: 0;
  padding: 8rpx 8rpx 8rpx;
  overflow: visible;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}
.week-head { min-height: 42rpx; justify-content: flex-end; }
.week-title { display: none; }
.week-switch { min-height: 42rpx; gap: 4rpx; color: #5f645f; font-size: 20rpx; }
.week-chevron { display: none; }
.week-grid { margin-top: 6rpx; }
.week-day { height: 86rpx; }
.week-label { color: #292d29; font-size: 19rpx; line-height: 29rpx; }
.week-number { width: 56rpx; height: 56rpx; margin-top: 6rpx; color: #1b1e1b; font-size: 28rpx; line-height: 56rpx; }
.week-day.is-selected .week-number { color: #fff; background: #0d7057; box-shadow: none; }
.week-day.is-muted { opacity: .38; }

.task-section--primary { margin-top: 24rpx; }
.task-section-head { min-height: 66rpx; gap: 16rpx; }
.task-section-heading { min-width: 0; flex: 1; align-items: center; gap: 12rpx; }
.task-section-title { color: #176a55; font-size: 44rpx; line-height: 54rpx; font-weight: 500; letter-spacing: 3rpx; }
.task-section-seal { width: 19rpx; height: 32rpx; flex: none; display: block; }
.task-section-count {
  min-width: 58rpx;
  height: 34rpx;
  padding: 0 13rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(181, 137, 57, .72);
  border-radius: 18rpx;
  color: #9f7226;
  background: rgba(255, 252, 246, .34);
  box-sizing: border-box;
  font-family: var(--font-family-brand);
  font-size: 18rpx;
  line-height: 32rpx;
  white-space: nowrap;
}
.task-section-tools { gap: 28rpx; }
.task-tool { min-height: 58rpx; gap: 4rpx; color: #5f645f; font-size: 21rpx; line-height: 30rpx; }
.task-tool .t-icon { color: #5f645f; }
.action-panel { margin-top: 8rpx; overflow: visible; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
.action-list-toggle { min-height: 76rpx; color: #606660; font-size: 21rpx; }

@media (max-width: 350px) {
  .today-page { padding-right: 30rpx; padding-left: 30rpx; }
  .today-hero { margin-right: -30rpx; margin-left: -30rpx; }
  .today-header { padding-right: 34rpx; padding-left: 38rpx; }
  .today-header__brand-logo { width: 138rpx; }
  .today-header__date { font-size: 21rpx; }
  .today-header__streak { gap: 5rpx; font-size: 21rpx; }
  .today-header__streak-number { font-size: 35rpx; }
  .task-section-heading { gap: 8rpx; }
  .task-section-title { font-size: 36rpx; letter-spacing: 2rpx; }
  .task-section-seal { width: 16rpx; height: 28rpx; }
  .task-section-count { min-width: 52rpx; height: 31rpx; padding: 0 10rpx; font-size: 16rpx; line-height: 29rpx; }
  .task-section-tools { gap: 14rpx; }
  .task-tool { font-size: 18rpx; }
}

/* Semantic type roles: keep the existing page cascade, but give its final
 * visual layer one shared scale and predictable line-height contract. */
.today-nav .tab-header__title { font-size: var(--font-page-title); line-height: var(--line-height-page-title); }
.today-greeting { font-size: var(--font-section-title); line-height: var(--line-height-section-title); }
.today-subtitle { font-size: var(--font-caption); line-height: var(--line-height-caption); }
.today-header__date,
.today-header__streak,
.today-brand__subtitle { font-size: var(--font-meta); line-height: var(--line-height-meta); }
.today-header__streak-number,
.action-streak__value { font-size: var(--font-data); line-height: var(--line-height-data); }
.action-streak__value text,
.action-streak__label { font-size: var(--font-meta); line-height: var(--line-height-meta); }

.week-title,
.task-section-title { font-size: var(--font-section-title); line-height: var(--line-height-section-title); }
.week-switch,
.task-tool,
.action-list-toggle { font-size: var(--font-body); line-height: var(--line-height-body); }
.week-label { font-size: var(--font-meta); line-height: var(--line-height-meta); }
.week-number { font-size: var(--font-calendar); line-height: var(--font-calendar); }
.week-chevron,
.calendar-nav,
.quick-add-close { font-size: var(--font-icon-display); line-height: var(--line-height-data); }

.stats-label,
.stats-done-total,
.stats-value-unit,
.stats-meta-row { font-size: var(--font-meta); line-height: var(--line-height-meta); }
.stats-value,
.stats-value--minutes,
.stats-value--progress { font-size: var(--font-data); line-height: var(--line-height-data); }
.stats-value-unit--percent { font-size: var(--font-body-strong); line-height: var(--line-height-body-strong); }
.stats-achievement-pill { font-size: var(--font-tag); line-height: var(--line-height-tag); }

.proactive-label,
.focus-action-kicker,
.task-status,
.task-carry-badge,
.task-section-count,
.task-action-sheet__recommendation { font-size: var(--font-tag); line-height: var(--line-height-tag); }
.proactive-title,
.focus-action-title,
.task-title,
.state-title,
.action-empty-inline > view,
.calendar-title,
.quick-duration-title,
.completion-title { font-size: var(--font-card-title); line-height: var(--line-height-card-title); }
.proactive-body,
.state-description,
.completion-copy,
.task-action-sheet__subtitle { font-size: var(--font-caption); line-height: var(--line-height-caption); }
.coach-entry-footer,
.focus-action-meta,
.action-list-toggle,
.action-empty-inline text { font-size: var(--font-body); line-height: var(--line-height-body); }
.focus-action-buttons button,
.action-empty-button,
.primary-button,
.completion-share-button,
.completion-continue-button,
.completion-reminder-button,
.quick-add-primary { font-size: var(--font-body-strong); line-height: var(--line-height-body-strong); }
.task-duration,
.task-meta-actual,
.completion-stat-label,
.task-action-sheet__desc { font-size: var(--font-meta); line-height: var(--line-height-meta); }

.task-action-sheet__title,
.quick-add-title { font-size: var(--font-page-title); line-height: var(--line-height-page-title); }
.task-action-sheet__group-title,
.quick-section-title,
.task-action-sheet__label { font-size: var(--font-body-strong); line-height: var(--line-height-body-strong); }
.task-action-sheet__cancel,
.task-action-sheet__footer button,
.calendar-today,
.calendar-confirm,
.quick-title-input__control,
.quick-setting-label,
.quick-delete-action { font-size: var(--font-body); line-height: var(--line-height-body); }
.calendar-week-label,
.quick-title-input__count,
.quick-time-unit,
.quick-time-swipe-hint,
.quick-time-tick__label,
.quick-time-hour,
.quick-setting-desc,
.quick-setting-value { font-size: var(--font-meta); line-height: var(--line-height-meta); }
.calendar-day-number { font-size: var(--font-calendar); line-height: var(--font-calendar); }
.quick-time-number,
.quick-time-input { font-size: var(--font-timer); line-height: var(--line-height-data); }
.completion-stat-value { font-size: var(--font-data); line-height: var(--line-height-data); }

/* Controlled display exceptions: brand lockup and compact execution input. */
.today-brand__title { font-size: var(--font-brand-display); line-height: var(--line-height-brand-display); }
.quick-time-editor .quick-time-number,
.quick-time-editor .quick-time-input { font-size: var(--font-timer-editor); line-height: var(--line-height-data); }

@media (max-width: 350px) {
  .today-nav .tab-header__title { font-size: var(--font-page-title-compact); line-height: var(--line-height-page-title); }
  .today-greeting,
  .week-title,
  .task-section-title { font-size: var(--font-section-title-compact); line-height: var(--line-height-section-title); }
  .today-subtitle,
  .proactive-body,
  .state-description,
  .completion-copy,
  .task-action-sheet__subtitle { font-size: var(--font-caption-compact); line-height: var(--line-height-caption); }
  .today-header__date,
  .today-header__streak,
  .action-streak__value text,
  .action-streak__label,
  .week-label,
  .task-duration,
  .task-meta-actual,
  .completion-stat-label,
  .task-action-sheet__desc,
  .calendar-week-label,
  .quick-title-input__count,
  .quick-time-unit,
  .quick-time-swipe-hint,
  .quick-time-tick__label,
  .quick-time-hour,
  .quick-setting-desc,
  .quick-setting-value { font-size: var(--font-meta-compact); line-height: var(--line-height-meta); }
  .stats-label,
  .stats-done-total,
  .stats-value-unit,
  .stats-meta-row { font-size: var(--font-meta-compact); line-height: var(--line-height-meta); }
  .stats-value,
  .stats-value--minutes,
  .stats-value--progress,
  .completion-stat-value { font-size: var(--font-data-compact); line-height: var(--line-height-data); }
  .task-title,
  .state-title,
  .action-empty-inline > view,
  .calendar-title,
  .quick-duration-title,
  .completion-title { font-size: var(--font-card-title-compact); line-height: var(--line-height-card-title); }
  .proactive-label,
  .focus-action-kicker,
  .task-status,
  .task-carry-badge,
  .task-section-count,
  .task-action-sheet__recommendation { font-size: var(--font-tag-compact); line-height: var(--line-height-tag); }
  .quick-time-number,
  .quick-time-input { font-size: var(--font-timer-compact); line-height: var(--line-height-data); }
  .quick-time-editor .quick-time-number,
  .quick-time-editor .quick-time-input { font-size: var(--font-timer-editor-compact); line-height: var(--line-height-data); }
}
