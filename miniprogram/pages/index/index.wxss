/* ============ 行动完成庆祝面板 ============ */
.completion-layer {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.completion-mask {
  position: absolute;
  inset: 0;
  background: rgba(35, 59, 52, 0.38);
  opacity: 0;
  transition: opacity 240ms ease;
  backdrop-filter: blur(4rpx);
}

.completion-panel {
  position: relative;
  width: 100%;
  max-width: 750rpx;
  max-height: calc(100vh - 96rpx);
  overflow-y: auto;
  box-sizing: border-box;
  padding: 18rpx 32rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 44rpx 44rpx 0 0;
  background: #FBFCF8;
  box-shadow: 0 -18rpx 56rpx rgba(31, 70, 58, 0.18);
  transform: translateY(100%);
  transition: transform 260ms cubic-bezier(0.22, 0.78, 0.24, 1);
}

.completion-layer.is-visible .completion-mask {
  opacity: 1;
}

.completion-layer.is-visible .completion-panel {
  transform: translateY(0);
}

.completion-grabber {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 30rpx;
  border-radius: 999rpx;
  background: #DDE5E0;
}

.completion-celebration {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.completion-badge {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #356859;
  color: #FFFFFF;
  font-size: 56rpx;
  box-shadow: 0 16rpx 30rpx rgba(53, 104, 89, 0.28);
}

.completion-badge .t-icon {
  font-size: 58rpx;
  font-weight: 800;
}

.completion-sparkle {
  position: absolute;
  top: -16rpx;
  right: -12rpx;
  color: #F8D26A;
  font-size: 40rpx;
  line-height: 1;
  text-shadow: 0 4rpx 10rpx rgba(200, 151, 25, 0.24);
}

.completion-title {
  margin-top: 28rpx;
  color: #233B34;
  font-size: 38rpx;
  line-height: 48rpx;
  font-weight: 700;
}

.completion-copy {
  margin-top: 8rpx;
  color: #71827A;
  font-size: 25rpx;
  line-height: 36rpx;
}

.completion-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  margin-top: 38rpx;
}

.completion-stat-card {
  display: flex;
  align-items: center;
  min-width: 0;
  min-height: 112rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border: 1rpx solid #EEF2EF;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(31, 70, 58, 0.07);
}

.completion-stat-icon {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin-right: 18rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.completion-stat-icon.is-green {
  background: #EAF5EF;
  color: #356859;
}

.completion-stat-icon.is-yellow {
  background: #FFF2C9;
  color: #B68618;
}

.completion-stat-value {
  overflow: hidden;
  color: #233B34;
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 800;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.completion-stat-label {
  margin-top: 2rpx;
  color: #71827A;
  font-size: 22rpx;
  line-height: 30rpx;
  white-space: nowrap;
}

.completion-actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 38rpx;
}

.completion-share-button,
.completion-continue-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  margin: 0;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.completion-share-button::after,
.completion-continue-button::after {
  border: 0;
}

.completion-share-button {
  background: #356859;
  color: #FFFFFF;
  box-shadow: 0 12rpx 26rpx rgba(53, 104, 89, 0.22);
}

.completion-continue-button {
  border: 1rpx solid #D7E4DE;
  background: #FFFFFF;
  color: #356859;
}

.completion-share-icon {
  margin-right: 12rpx;
  font-size: 34rpx;
  font-weight: 500;
}

.completion-arrow {
  margin-left: 12rpx;
  font-size: 34rpx;
  font-weight: 500;
}

.completion-share-button:active,
.completion-continue-button:active {
  transform: scale(0.985);
}

@media (max-width: 340px) {
  .completion-panel {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .completion-stat-card {
    padding: 16rpx;
  }

  .completion-stat-icon {
    width: 60rpx;
    height: 60rpx;
    margin-right: 12rpx;
  }
}

