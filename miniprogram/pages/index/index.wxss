page { background: #f7f3ea; }

.today-page {
  --ivory: #f7f3ea;
  --paper: #fffcf6;
  --ink: #24312d;
  --green: #245b4d;
  --muted: #7c817d;
  --gold: #c89b4a;
  --line: rgba(105, 96, 78, .13);
  min-height: 100vh;
  padding: 0 36rpx calc(154rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  color: var(--ink);
  background: #f8f4ec;
  font-family: var(--font-family-sans);
}

.today-page--timing { padding-bottom: calc(270rpx + env(safe-area-inset-bottom)); }
.today-hero { margin: 0 -36rpx; }
.today-hero__background { opacity: .48; transform: scale(1.04); transform-origin: 72% 18%; }
.today-hero__veil { background: rgba(248,244,236,.28); }
.today-nav .tab-header__title { font-size: 44rpx; letter-spacing: 8rpx; }
.today-profile-row { position: relative; z-index: 2; min-height: 118rpx; margin-top: 16rpx; padding: 8rpx 4rpx 12rpx; display: flex; align-items: center; }
.today-avatar { width: 80rpx; height: 80rpx; flex: none; overflow: hidden; display: flex; align-items: center; justify-content: center; border: 3rpx solid rgba(255,253,248,.94); border-radius: 50%; background: #ecefe8; box-sizing: border-box; box-shadow: 0 6rpx 18rpx rgba(54,70,63,.07); }
.today-avatar--text { color: var(--green); font-family: var(--font-family-brand); font-size: 46rpx; font-weight: var(--font-weight-title); }
.today-greeting-copy { min-width: 0; margin-left: 20rpx; display: flex; flex: 1; flex-direction: column; }
.today-greeting { overflow: hidden; color: #155b48; font-family: var(--font-family-brand); font-size: 33rpx; line-height: 43rpx; font-weight: 500; letter-spacing: 1rpx; text-overflow: ellipsis; white-space: nowrap; }
.today-subtitle { margin-top: 6rpx; color: #6f7471; font-size: 21rpx; line-height: 30rpx; }

.action-streak { width: 112rpx; min-height: 90rpx; flex: none; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid rgba(200,155,74,.22); border-radius: 20rpx; background: rgba(255,252,246,.96); box-shadow: 0 6rpx 18rpx rgba(74,61,39,.05); }
.action-streak__value { color: #9a671f; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 34rpx; line-height: 38rpx; }
.action-streak__value text { margin-left: 3rpx; font-family: var(--font-family-sans); font-size: 17rpx; }
.action-streak__label { margin-top: 4rpx; color: #6f7471; font-size: 17rpx; }

.paper-card, .week-card, .stats-card, .reference-coach-entry, .today-task-row, .state-card, .empty-card { position: relative; overflow: hidden; box-sizing: border-box; border: 1rpx solid rgba(129,114,86,.11); border-radius: 30rpx; background: #fffcf6; box-shadow: 0 9rpx 26rpx rgba(75,62,40,.045); }
.paper-card::before, .week-card::before, .stats-card::before, .today-task-row::before { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0; }

.week-card { min-height: 186rpx; margin-top: 14rpx; padding: 22rpx 28rpx 18rpx; }
.week-head { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; }
.week-title { color: #155b48; font-family: var(--font-family-brand); font-size: 32rpx; line-height: 42rpx; font-weight: var(--font-weight-title); letter-spacing: 2rpx; }
.week-switch { min-height: 52rpx; display: flex; align-items: center; gap: 8rpx; color: #5d6662; font-size: 21rpx; }
.week-chevron { color: #8f8b82; font-family: var(--font-family-sans); font-size: 35rpx; font-weight: 300; }
.week-grid { position: relative; z-index: 2; margin-top: 12rpx; display: grid; grid-template-columns: repeat(7, minmax(0,1fr)); }
.week-day { position: relative; min-width: 0; height: 86rpx; display: flex; flex-direction: column; align-items: center; color: #3f4542; }
.week-label { font-size: 19rpx; line-height: 30rpx; }
.week-number { width: 56rpx; height: 56rpx; margin-top: 5rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 28rpx; line-height: 56rpx; }
.week-day.is-selected .week-number { background: #1f705a; color: #fffdf8; box-shadow: 0 9rpx 18rpx rgba(31,112,90,.2); }
.week-day.is-today:not(.is-selected) .week-number { color: #31584b; box-shadow: inset 0 0 0 2rpx rgba(49,88,75,.28); }
.week-day.is-muted { opacity: .36; }

.stats-card { height: 200rpx; margin-top: 20rpx; padding: 22rpx 16rpx 18rpx; border: 1rpx solid rgba(90,105,96,.11); border-radius: 24rpx; background: #fffdf8; box-shadow: 0 4rpx 16rpx rgba(63,55,43,.035); }
.stats-card--pressed { opacity: .88; transform: scale(.997); }
.stats-grid { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); height: 100%; }
.stats-column { position: relative; min-width: 0; padding: 0 20rpx; display: flex; flex-direction: column; align-items: flex-start; box-sizing: border-box; }
.stats-column--done { padding-left: 10rpx; }
.stats-column--progress { padding-right: 10rpx; }
.stats-column + .stats-column::before { position: absolute; top: 1rpx; bottom: 1rpx; left: 0; width: 1rpx; background: rgba(102,118,109,.14); content: ""; }
.stats-label { min-height: 30rpx; display: flex; align-items: center; gap: 8rpx; color: #747c77; font-family: var(--font-family-sans); font-size: 20rpx; line-height: 28rpx; white-space: nowrap; }
.stats-icon { width: 29rpx; height: 29rpx; flex: none; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.stats-icon--solid { border-radius: 50%; color: #fffdf8; background: #4f8a68; }
.stats-icon--time { color: #9a7633; }
.stats-icon--flow { color: #245b4d; }
.stats-value { min-height: 52rpx; margin-top: 10rpx; display: flex; align-items: baseline; color: #27332f; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 47rpx; font-weight: 400; line-height: 1; white-space: nowrap; }
.stats-value--done { color: #245b4d; }
.stats-done-total { margin-left: 7rpx; color: #6f7c76; font-family: var(--font-family-sans); font-size: 18rpx; font-weight: 500; }
.stats-value--minutes, .stats-value--progress { font-size: 47rpx; }
.stats-value-unit { margin-left: 5rpx; color: #68736d; font-family: var(--font-family-sans); font-size: 17rpx; }
.stats-value-unit--percent { font-size: 25rpx; }
.stats-meta-row { height: 47rpx; margin-top: 7rpx; display: flex; align-items: flex-start; gap: 6rpx; color: #789085; font-size: 17rpx; line-height: 24rpx; white-space: nowrap; }
.stats-meta-row.is-complete { color: #4f7c62; font-weight: 600; }
.stats-mini-bars { width: 126rpx; height: 44rpx; margin-top: 9rpx; display: flex; align-items: flex-end; justify-content: center; gap: 6rpx; }
.stats-mini-bar { width: 6rpx; min-height: 4rpx; border-radius: 3rpx 3rpx 0 0; background: rgba(109,145,125,.26); }
.stats-mini-bar.is-active { background: #9db9a7; }
.stats-progress-visual { position: relative; width: 100%; height: 54rpx; margin-top: 2rpx; }
.stats-trend-canvas { display: block; width: 100%; height: 43rpx; }
.stats-trend-canvas--progress { width: 100%; }
.stats-achievement-pill { position: absolute; right: 0; bottom: -1rpx; min-width: 86rpx; height: 25rpx; padding: 0 10rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid rgba(73,111,93,.14); border-radius: 13rpx; color: #5f756a; background: rgba(255,253,248,.96); font-size: 15rpx; line-height: 23rpx; white-space: nowrap; }
.stats-achievement-pill.is-complete { border-color: rgba(200,155,74,.3); color: #8d682d; background: #fff8e9; }

.reference-coach-entry { min-height: 202rpx; margin-top: 20rpx; border-radius: 28rpx; box-shadow: none; }
.reference-card--pressed { opacity: .8; }
.reference-coach-background { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: .88; transform: scale(1.02); transform-origin: 78% 64%; }
.reference-coach-veil { position: absolute; inset: 0; background: linear-gradient(90deg,rgba(255,252,246,.99) 0%,rgba(255,252,246,.95) 48%,rgba(255,252,246,.72) 65%,rgba(255,252,246,.22) 100%),linear-gradient(180deg,transparent 55%,rgba(255,252,246,.18) 100%); }
.reference-coach-copy { position: relative; z-index: 2; width: 100%; min-height: 202rpx; padding: 24rpx 28rpx; box-sizing: border-box; display: flex; flex-direction: column; justify-content: center; }
.proactive-insight { max-width: 100%; padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
.proactive-label { color: #9b7432; font-size: 18rpx; font-weight: 600; line-height: 26rpx; }
.proactive-title { margin-top: 5rpx; display: -webkit-box; overflow: hidden; color: #203c33; font-size: 29rpx; font-weight: 700; line-height: 40rpx; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.proactive-body { margin-top: 6rpx; display: -webkit-box; overflow: hidden; color: #65716c; font-size: 20rpx; line-height: 30rpx; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.coach-entry-footer { min-height: 58rpx; margin-top: 12rpx; display: inline-flex; align-items: center; gap: 3rpx; color: #8b682f; font-size: 19rpx; font-weight: 650; }

.task-section { margin-top: 36rpx; }
.task-section--primary { margin-top: 32rpx; }
.task-section-head { min-height: 62rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.task-section-heading { min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 5rpx; }
.task-section-title { flex: none; color: #155b48; font-family: var(--font-family-brand); font-size: 35rpx; line-height: 45rpx; font-weight: var(--font-weight-title); letter-spacing: 2rpx; }
.habit-recommend { min-width: 0; display: flex; align-items: center; gap: 4rpx; color: #8a8f8b; font-size: 19rpx; line-height: 28rpx; white-space: nowrap; }
.task-section-tools { flex: none; display: flex; align-items: center; gap: 10rpx; }
.task-section-add { height: 60rpx; padding: 0 18rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(36,91,77,.16); border-radius: 999rpx; color: #17644f; background: rgba(255,253,248,.8); font-size: 20rpx; font-weight: 650; transition: transform 160ms ease-out, background 160ms ease-out; }
.task-section-add--icon { width: 60rpx; padding: 0; }
.execution-preference { height: 60rpx; padding: 0 18rpx; display: flex; align-items: center; gap: 7rpx; border: 1rpx solid rgba(105,96,78,.12); border-radius: 999rpx; color: #5d6662; background: rgba(255,252,246,.88); box-sizing: border-box; font-size: 18rpx; white-space: nowrap; transition: transform 160ms ease-out, background 160ms ease-out; }
.task-section-add:active, .execution-preference:active { transform: scale(.97); background: #f1eee6; }
.action-panel { margin-top: 12rpx; overflow: hidden; border: 1rpx solid rgba(105,96,78,.1); border-radius: 30rpx; background: rgba(255,252,246,.94); box-shadow: 0 9rpx 26rpx rgba(75,62,40,.045); }
.focus-action-panel { margin: 16rpx 0 14rpx; padding: 25rpx 24rpx; border-left: 6rpx solid var(--color-primary); border-radius: 0 var(--radius-card) var(--radius-card) 0; background: var(--color-surface-soft); }
.focus-action-kicker { color: var(--color-gold); font-size: 21rpx; font-weight: 650; letter-spacing: 2rpx; }
.focus-action-title { margin-top: 10rpx; color: var(--color-text-main); font-size: 31rpx; font-weight: 700; line-height: 1.4; }
.focus-action-meta { display: flex; gap: 18rpx; margin-top: 8rpx; color: var(--color-text-secondary); font-size: 22rpx; }
.focus-action-buttons { display: flex; gap: 14rpx; margin-top: 22rpx; }
.focus-action-buttons button { height: 76rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; box-sizing: border-box; border-radius: var(--radius-button); font-size: 25rpx; font-weight: 650; }
.focus-action-buttons button::after { border: 0; }
.focus-action-secondary { flex: 0 0 180rpx; border: 1rpx solid var(--color-border-strong); background: var(--color-bg-card); color: var(--color-primary); }
.focus-action-primary { flex: 1; border: 0; background: var(--color-primary); color: #fff; }
.today-task-row { min-height: 102rpx; margin-bottom: 10rpx; padding: 13rpx 18rpx; display: flex; align-items: center; gap: 12rpx; }
.today-task-row.is-done { border-color: rgba(91,120,101,.22); background: rgba(241,245,237,.95); }
.reference-task-icon { position: relative; z-index: 2; width: 50rpx; height: 50rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; color: #35695c; background: #e8f0eb; }
.reference-task-icon image { width: 35rpx; height: 35rpx; }
.reference-task-icon--blue { color: #496a76; background: #e9f0f2; }
.reference-task-icon--gold { color: #98702f; background: #f7efdf; }
.reference-task-icon--orange { color: #a86436; background: #f8ece3; }
.reference-task-icon--purple { color: #665d77; background: #eeebf2; }
.today-task-row.is-done .reference-task-icon { opacity: .9; }
.task-copy { position: relative; z-index: 2; min-width: 0; flex: 1; }
.task-title-line { min-width: 0; display: flex; align-items: center; gap: 14rpx; }
.task-title { min-width: 0; flex: 1; overflow: hidden; color: #263e36; font-family: var(--font-family-brand); font-size: 27rpx; line-height: 36rpx; font-weight: var(--font-weight-title); text-overflow: ellipsis; white-space: nowrap; }
.task-duration { flex: none; color: #777b76; font-size: 18rpx; line-height: 28rpx; white-space: nowrap; }
.task-meta-actual { color: #527064; font-size: 18rpx; line-height: 26rpx; }
.task-status-line { min-height: 28rpx; margin-top: 5rpx; display: flex; align-items: center; gap: 10rpx; }
.task-status { padding: 0 9rpx; border-radius: 999rpx; color: #52645d; background: #edf1ed; font-size: 16rpx; line-height: 26rpx; }
.task-status--success { color: #245b4d; background: #e8f0eb; }
.task-status--warning { color: #8d682d; background: #f7ebcf; }
.task-status--danger { color: #9b5549; background: #fbf1ed; }
.task-carry-badge { padding: 0 9rpx; border: 1rpx solid rgba(152,112,47,.18); border-radius: 999rpx; color: #8d682d; background: #fbf5e8; font-size: 16rpx; line-height: 25rpx; white-space: nowrap; }
.task-tail-check { position: relative; z-index: 2; width: 50rpx; height: 50rpx; flex: none; display: flex; align-items: center; justify-content: center; border: 2rpx solid #777b76; border-radius: 50%; color: #fff; }
.task-tail-check::after { content: ""; position: absolute; inset: -10rpx; border-radius: 50%; }
.task-tail-check.is-done { border-color: #31584b; background: #31584b; box-shadow: 0 6rpx 13rpx rgba(49,88,75,.17); }
.task-tail-check.is-disabled { border-style: dashed; opacity: .38; }
.task-tail-check .t-icon { font-size: 28rpx; }
.action-list-toggle { min-height: 70rpx; display: flex; align-items: center; justify-content: center; gap: 7rpx; border-top: 1rpx solid rgba(105,96,78,.08); color: #5d6662; font-size: 20rpx; text-align: center; transition: opacity 160ms ease-out, transform 160ms ease-out; }
.action-list-toggle--pressed { opacity: .72; transform: scale(.99); }
.action-empty-inline { padding: 42rpx 28rpx; border: 1rpx dashed rgba(49,88,75,.2); border-radius: 25rpx; background: rgba(255,253,248,.72); color: #31584b; text-align: center; }
.action-empty-inline > view { font-family: var(--font-family-brand); font-size: 27rpx; }
.action-empty-inline text { display: block; margin-top: 8rpx; color: #817e77; font-size: 20rpx; }
.action-empty-button { width: 236rpx; min-height: 64rpx; margin: 22rpx auto 0; padding: 0 22rpx; display: flex; align-items: center; justify-content: center; border-radius: 32rpx; color: #fff; background: #31584b; font-family: inherit !important; font-size: 22rpx !important; font-weight: 650; }

.state-card, .empty-card { margin-top: 20rpx; padding: 58rpx 32rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }
.loading-dot { width: 26rpx; height: 26rpx; margin-bottom: 20rpx; border: 5rpx solid rgba(49,88,75,.18); border-top-color: #31584b; border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.state-mark, .empty-mark { width: 72rpx; height: 72rpx; margin-bottom: 18rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #eef2ec; color: #31584b; font-family: var(--font-family-brand); font-size: 26rpx; }
.state-title { color: #234b40; font-family: var(--font-family-brand); font-size: 30rpx; font-weight: var(--font-weight-title); }
.state-description { max-width: 520rpx; margin-top: 12rpx; color: #7d7970; font-size: 21rpx; line-height: 32rpx; }
.primary-button { min-width: 230rpx; height: 72rpx; margin-top: 24rpx; border-radius: 36rpx; background: #31584b; color: #fff; font-size: 25rpx; line-height: 72rpx; }
.primary-button::after { border: 0; }

/* shared bottom sheets */
.calendar-layer, .quick-add-layer, .quick-duration-layer, .completion-layer { position: fixed; z-index: 10020; inset: 0; pointer-events: none; }
.calendar-layer, .quick-add-layer, .quick-duration-layer { pointer-events: auto; }
.calendar-mask, .quick-add-mask, .completion-mask { position: absolute; inset: 0; background: rgba(29,48,41,.34); backdrop-filter: blur(4rpx); -webkit-backdrop-filter: blur(4rpx); }
.calendar-panel, .quick-add-panel, .quick-duration-panel, .completion-panel { position: absolute; right: 0; bottom: 0; left: 0; padding: 18rpx 30rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius: 34rpx 34rpx 0 0; background: #faf8f1; box-shadow: 0 -18rpx 48rpx rgba(31,65,54,.16); }
.calendar-head, .quick-add-header, .quick-duration-header { min-height: 68rpx; display: flex; align-items: center; justify-content: space-between; }
.calendar-title, .quick-add-title, .quick-duration-title { color: #234b40; font-family: var(--font-family-brand); font-size: 32rpx; font-weight: var(--font-weight-title); }
.calendar-nav, .quick-add-close { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #eef1eb; color: #51665d; font-size: 31rpx; }
.calendar-week-row, .calendar-grid { display: grid; grid-template-columns: repeat(7,1fr); }
.calendar-week-row { margin-top: 14rpx; }
.calendar-week-label { color: #8a877f; font-size: 19rpx; text-align: center; }
.calendar-grid { margin-top: 10rpx; row-gap: 7rpx; }
.calendar-day { position: relative; height: 72rpx; display: flex; align-items: center; justify-content: center; }
.calendar-day-number { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #4d514e; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 23rpx; }
.calendar-day.is-outside { opacity: .28; }
.calendar-day.is-today:not(.is-selected) .calendar-day-number { box-shadow: inset 0 0 0 2rpx rgba(49,88,75,.28); }
.calendar-day.is-selected .calendar-day-number { background: #31584b; color: #fff; }
.calendar-footer { margin-top: 18rpx; display: flex; justify-content: flex-end; gap: 14rpx; }
.calendar-today, .calendar-confirm { height: 60rpx; padding: 0 28rpx; display: flex; align-items: center; border-radius: 30rpx; font-size: 22rpx; }
.calendar-today { border: 1rpx solid #d7e1da; color: #31584b; }
.calendar-confirm { background: #31584b; color: #fff; }

.quick-add-panel { max-height: 84vh; overflow-y: auto; }
.quick-add-grabber, .completion-grabber { width: 72rpx; height: 7rpx; margin: 0 auto 20rpx; border-radius: 5rpx; background: #d8ddd8; }
.quick-add-copy { margin: 8rpx 0 24rpx; color: #7d7970; font-size: 21rpx; line-height: 31rpx; }
.quick-add-field { margin-top: 20rpx; }
.quick-add-label { color: #234b40; font-size: 23rpx; font-weight: 600; }
.quick-add-hint { color: #918d84; font-size: 18rpx; }
.quick-reminder-row { min-height: 70rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.quick-reminder-time { margin-top: 12rpx; }
.quick-reminder-picker { min-height: 66rpx; margin-top: 10rpx; padding: 0 22rpx; display: flex; align-items: center; justify-content: space-between; border: 1rpx solid rgba(36,91,77,.16); border-radius: 20rpx; background: #fffdf8; color: #245b4d; font-size: 22rpx; }
.quick-reminder-picker__note { color: #918d84; font-size: 19rpx; }
.quick-reminder-note { margin-top: 8rpx; color: #8b6a37; font-size: 19rpx; line-height: 30rpx; }
.quick-add-input { min-height: 88rpx; margin-top: 10rpx; border: 1rpx solid var(--color-border-soft, #e1e5de); border-radius: 24rpx; background: var(--color-card, #fffdf8); }
.quick-add-placeholder { color: #aaa79e; }
.quick-add-label-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.quick-duration-chips { margin-top: 14rpx; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.quick-duration-chip { min-height: 70rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(36,91,77,.2); border-radius: 35rpx; background: var(--color-card, #fffdf8); color: var(--color-primary, #245b4d); font-size: 22rpx; font-weight: 600; }
.quick-duration-chip.is-selected { border-color: var(--color-primary, #245b4d); background: var(--color-primary, #245b4d); color: #fff; box-shadow: 0 8rpx 18rpx rgba(36,91,77,.14); }
.execution-mode-grid { margin-top: 14rpx; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 10rpx; }
.execution-mode-option { min-height: 104rpx; padding: 16rpx 10rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid rgba(36,91,77,.13); border-radius: 22rpx; background: #fffdf8; box-sizing: border-box; text-align: center; }
.execution-mode-option.is-selected { border-color: rgba(36,91,77,.38); background: #edf4f0; box-shadow: inset 0 0 0 1rpx rgba(36,91,77,.04); }
.execution-mode-option__title { color: #35594f; font-size: 21rpx; font-weight: 650; line-height: 29rpx; }
.execution-mode-option__copy { margin-top: 4rpx; color: #8b8a83; font-size: 16rpx; line-height: 23rpx; }
.quick-add-actions { margin-top: 22rpx; display: flex; gap: 14rpx; }
.quick-add-secondary, .quick-add-primary { flex: 1; height: 72rpx; border-radius: 36rpx; font-size: 24rpx; line-height: 72rpx; }
.quick-add-secondary { border: 1rpx solid #d7e1da; background: #fffdf8; color: #31584b; }
.quick-add-primary { background: #31584b; color: #fff; }
.quick-add-secondary::after, .quick-add-primary::after { border: 0; }

.quick-duration-layer { background: rgba(29,48,41,.34); }
.quick-duration-options { margin-top: 12rpx; }
.quick-duration-option { min-height: 72rpx; padding: 0 12rpx; display: flex; align-items: center; border-bottom: 1rpx solid #e6e7e1; color: #5d625e; }
.quick-duration-option.is-selected { color: #31584b; font-weight: 700; }
.quick-duration-option-label { font-size: 23rpx; }
.quick-duration-check { margin-left: auto; color: #b58c43; }
.quick-duration-cancel { height: 66rpx; margin-top: 15rpx; display: flex; align-items: center; justify-content: center; border-radius: 33rpx; background: #eef1eb; color: #31584b; }
.quick-duration-spacer { width: 58rpx; }

.completion-layer { display: block; visibility: hidden; }
.completion-layer.is-visible { visibility: visible; pointer-events: auto; }
.completion-mask { opacity: 0; transition: opacity .2s; }
.completion-panel { transform: translateY(100%); transition: transform .25s ease-out; }
.completion-layer.is-visible .completion-mask { opacity: 1; }
.completion-layer.is-visible .completion-panel { transform: translateY(0); }
.completion-celebration { display: flex; flex-direction: column; align-items: center; text-align: center; }
.completion-badge { position: relative; width: 86rpx; height: 86rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid #c7a15a; border-radius: 50%; background: #f5ecd7; color: #31584b; }
.completion-title { margin-top: 15rpx; color: #234b40; font-family: var(--font-family-brand); font-size: 34rpx; font-weight: var(--font-weight-title); }
.completion-copy { margin-top: 7rpx; color: #7d7970; font-size: 21rpx; }
.completion-stats { margin-top: 22rpx; display: grid; grid-template-columns: repeat(2,1fr); gap: 12rpx; }
.completion-stat-card { min-height: 102rpx; padding: 16rpx; display: flex; align-items: center; gap: 13rpx; border: 1rpx solid #e0e5de; border-radius: 20rpx; background: #fffdf8; }
.completion-stat-icon { width: 48rpx; height: 48rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #e9f0eb; color: #31584b; font-size: 19rpx; }
.completion-stat-icon.is-yellow { background: #f5ecd7; color: #9d762f; }
.completion-stat-value { color: #234b40; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 27rpx; }
.completion-stat-label { margin-top: 3rpx; color: #85827b; font-size: 18rpx; }
.completion-actions { margin-top: 20rpx; display: flex; gap: 14rpx; }
.completion-share-button, .completion-continue-button { flex: 1; height: 72rpx; border-radius: 36rpx; font-size: 23rpx; line-height: 72rpx; }
.completion-share-button { border: 1rpx solid #d7e1da; background: #fffdf8; color: #31584b; }
.completion-continue-button { background: #31584b; color: #fff; }
.completion-share-button::after, .completion-continue-button::after { border: 0; }
.completion-share-icon, .completion-arrow { margin-right: 6rpx; }
.today-notification { margin: 0 0 var(--gap-card); overflow: hidden; border-radius: 20rpx; }
.completion-reminder-button { width: 100%; height: 72rpx; margin-top: 14rpx; border: 1rpx solid #d7e1da; border-radius: 36rpx; color: #31584b; background: #fffdf8; font-size: 23rpx; }
.completion-reminder-button::after { border: 0; }

@media (max-width:350px) {
  .today-page { padding-right: 22rpx; padding-left: 22rpx; }
  .today-hero { margin-right: -22rpx; margin-left: -22rpx; }
  .today-profile-row { padding-right: 4rpx; padding-left: 4rpx; }
  .today-avatar { width: 68rpx; height: 68rpx; }
  .today-greeting-copy { margin-left: 14rpx; }
  .today-greeting { font-size: 28rpx; }
  .today-subtitle { font-size: 21rpx; }
  .action-streak { width: 104rpx; }
  .week-card { padding-right: 20rpx; padding-left: 20rpx; }
  .stats-card { height: 204rpx; padding: 24rpx 10rpx 18rpx; }
  .stats-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .stats-column { padding-right: 13rpx; padding-left: 13rpx; }
  .stats-column--done { padding-left: 7rpx; }
  .stats-column--progress { padding-right: 7rpx; }
  .stats-label { gap: 6rpx; font-size: 17rpx; }
  .stats-icon { width: 27rpx; height: 27rpx; }
  .stats-value { font-size: 43rpx; }
  .stats-done-total { margin-left: 4rpx; font-size: 15rpx; }
  .stats-value--minutes, .stats-value--progress { font-size: 43rpx; }
  .stats-value-unit { font-size: 13rpx; }
  .stats-value-unit--percent { font-size: 22rpx; }
  .stats-meta-row { font-size: 15rpx; }
  .stats-mini-bars { width: 106rpx; gap: 4rpx; }
  .stats-achievement-pill { min-width: 78rpx; padding-right: 7rpx; padding-left: 7rpx; font-size: 14rpx; }
  .reference-coach-entry, .reference-coach-copy { min-height: 272rpx; }
  .reference-coach-copy { width: 100%; padding-left: 26rpx; }
  .proactive-insight { max-width: 68%; }
  .proactive-title { font-size: 27rpx; line-height: 38rpx; }
  .quick-duration-chip { font-size: 20rpx; }
  .task-section-heading { gap: 4rpx; }
  .habit-recommend { font-size: 17rpx; }
  .execution-preference { width: 58rpx; padding: 0; justify-content: center; }
  .execution-preference__label { display: none; }
  .execution-mode-option { min-height: 96rpx; padding-right: 6rpx; padding-left: 6rpx; }
  .execution-mode-option__title { font-size: 18rpx; }
  .execution-mode-option__copy { font-size: 14rpx; }
}

/* ── 任务操作自定义 Action Sheet ── */
.task-action-sheet { position: fixed; z-index: 10030; inset: 0; }
.task-action-sheet__mask { position: absolute; inset: 0; background: rgba(28,35,32,.56); animation: task-sheet-mask-in 200ms ease-out both; }
.task-action-sheet__panel { position: absolute; right: 0; bottom: 0; left: 0; max-height: 76vh; overflow: hidden; display: flex; flex-direction: column; border-radius: 36rpx 36rpx 0 0; background: var(--color-bg-card, #fffcf6); box-shadow: 0 -12rpx 36rpx rgba(38,49,44,.12); animation: task-sheet-panel-in 240ms cubic-bezier(.2,.8,.2,1) both; }
.task-action-sheet__landscape { position: absolute; top: 0; right: 0; left: 0; width: 100%; height: 176rpx; opacity: .11; pointer-events: none; }
.task-action-sheet__grabber { position: relative; z-index: 1; width: 68rpx; height: 7rpx; margin: 16rpx auto 0; border-radius: 5rpx; background: rgba(126,130,124,.22); }
.task-action-sheet__header { position: relative; z-index: 1; padding: 24rpx 36rpx 25rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }
.task-action-sheet__title { color: var(--color-text-main, #24312d); font-family: var(--font-family-brand); font-size: 40rpx; font-weight: var(--font-weight-title); line-height: 54rpx; letter-spacing: 4rpx; }
.task-action-sheet__subtitle { max-width: 100%; margin-top: 8rpx; overflow: hidden; color: var(--color-text-secondary, #7c817d); font-size: 22rpx; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }
.task-action-sheet__recommendation { min-height: 42rpx; margin-top: 12rpx; padding: 0 18rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; border-radius: 21rpx; color: #8d774f; background: rgba(242,230,200,.46); font-size: 19rpx; line-height: 28rpx; }
.task-action-sheet__recommendation-icon { color: var(--color-gold, #c89b4a); }
.task-action-sheet__body { min-height: 0; flex: 1; overflow-y: auto; padding: 0 36rpx; box-sizing: border-box; }
.task-action-sheet__group + .task-action-sheet__group { margin-top: 16rpx; }
.task-action-sheet__group-title { height: 44rpx; display: flex; align-items: center; gap: 14rpx; color: #4a4f4c; font-family: var(--font-family-brand); font-size: 25rpx; font-weight: 600; line-height: 36rpx; letter-spacing: 2rpx; }
.task-action-sheet__group-mark { width: 5rpx; height: 29rpx; flex: none; border-radius: 3rpx; background: rgba(174,137,68,.72); }
.task-action-sheet__items { overflow: hidden; border-top: 1rpx solid rgba(112,99,76,.10); background: transparent; }
.task-action-sheet__item { min-height: 82rpx; padding: 7rpx 14rpx 7rpx 10rpx; display: flex; align-items: center; gap: 17rpx; box-sizing: border-box; transition: opacity 160ms ease-out, transform 160ms ease-out, background 160ms ease-out; }
.task-action-sheet__item + .task-action-sheet__item { border-top: 1rpx solid rgba(112,99,76,.09); }
.task-action-sheet__item--pressed { opacity: .76; transform: scale(.992); background: rgba(36,91,77,.035); }
.task-action-sheet__icon { width: 58rpx; height: 58rpx; flex: none; display: flex; align-items: center; justify-content: center; color: var(--color-primary, #245b4d); }
.task-action-sheet__icon--danger { color: var(--color-danger, #b44e45); }
.task-action-sheet__copy { min-width: 0; flex: 1; }
.task-action-sheet__label { overflow: hidden; color: var(--color-text-main, #24312d); font-size: 25rpx; font-weight: 600; line-height: 34rpx; text-overflow: ellipsis; white-space: nowrap; }
.task-action-sheet__desc { margin-top: 2rpx; overflow: hidden; color: var(--color-text-secondary, #7c817d); font-size: 19rpx; line-height: 27rpx; text-overflow: ellipsis; white-space: nowrap; }
.task-action-sheet__chevron { flex: none; color: rgba(91,99,95,.66); }
.task-action-sheet__item--danger { margin-top: 1rpx; border-top-color: rgba(180,78,69,.20) !important; }
.task-action-sheet__item--danger .task-action-sheet__label { color: var(--color-danger, #b44e45); }
.task-action-sheet__item--danger .task-action-sheet__desc { color: rgba(145,92,85,.76); }
.task-action-sheet__item--danger .task-action-sheet__chevron { color: var(--color-danger, #b44e45); }
.task-action-sheet__footer { flex: none; margin-top: 8rpx; padding: 0 36rpx calc(12rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid rgba(112,99,76,.10); background: rgba(250,248,243,.72); }
.task-action-sheet__cancel { height: 76rpx; display: flex; align-items: center; justify-content: center; color: var(--color-text-main, #24312d); font-family: var(--font-family-brand); font-size: 27rpx; font-weight: 600; letter-spacing: 2rpx; transition: opacity 160ms ease-out, transform 160ms ease-out; }
.task-action-sheet__cancel--pressed { opacity: .62; transform: scale(.98); }

@keyframes task-sheet-mask-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes task-sheet-panel-in { from { transform: translateY(100%); } to { transform: translateY(0); } }

@media (max-width:350px) {
  .task-action-sheet__panel { max-height: 82vh; }
  .task-action-sheet__header { padding-right: 28rpx; padding-left: 28rpx; }
  .task-action-sheet__body { padding-right: 28rpx; padding-left: 28rpx; }
  .task-action-sheet__footer { padding-right: 28rpx; padding-left: 28rpx; }
  .task-action-sheet__title { font-size: 37rpx; }
  .task-action-sheet__item { gap: 13rpx; padding-right: 8rpx; padding-left: 6rpx; }
  .task-action-sheet__icon { width: 52rpx; height: 52rpx; }
  .task-action-sheet__label { font-size: 23rpx; }
  .task-action-sheet__desc { font-size: 17rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .task-action-sheet__mask,
  .task-action-sheet__panel { animation: none; }
  .task-action-sheet__item,
  .task-action-sheet__cancel { transition: none; }
}
