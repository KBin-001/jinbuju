.today-page {
  padding-top: 40rpx;
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.page-state {
  margin-top: 80rpx;
}

.date-row,
.card-heading-row,
.section-title-row,
.goal-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
}

.weekday {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.greeting {
  margin-top: 22rpx;
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: 600;
}

.streak-pill {
  min-width: 166rpx;
  padding: 14rpx 18rpx;
  border-radius: 22rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 22rpx;
  text-align: center;
}

.streak-number {
  margin-right: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-goal-card {
  padding: 40rpx 36rpx;
}

.section-eyebrow {
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.empty-goal-title {
  max-width: 560rpx;
  margin-top: 18rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.5;
}

.empty-goal-description {
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.create-button {
  width: 100%;
}

.goal-card,
.progress-card {
  margin-bottom: 24rpx;
}

.goal-title {
  max-width: 430rpx;
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
  word-break: break-all;
}

.category-tag {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 22rpx;
}

.goal-meta {
  justify-content: flex-start;
  margin-top: 30rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid var(--color-border);
}

.meta-item {
  flex: 1;
}

.meta-divider {
  width: 1rpx;
  height: 64rpx;
  margin: 0 30rpx;
  background: var(--color-border);
}

.meta-value {
  font-size: 28rpx;
  font-weight: 650;
}

.meta-label {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.progress-count {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
}

.progress-count-strong {
  color: var(--color-text);
  font-size: 38rpx;
  font-weight: 700;
}

.progress-rate {
  color: var(--color-primary);
  font-size: 42rpx;
  font-weight: 700;
}

.progress-track {
  height: 18rpx;
  margin-top: 26rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e8ece6;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
  transition: width 220ms ease;
}

.progress-status {
  margin-top: 16rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.task-section {
  margin-top: 34rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
}

.section-count {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.task-card {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 28rpx;
  transition: background 180ms ease, border-color 180ms ease;
}

.task-card-completed {
  border-color: #cfe1d8;
  background: #f3f8f5;
}

.task-content {
  flex: 1;
  min-width: 0;
}

.task-title {
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.45;
}

.task-title-completed {
  color: #56645b;
}

.task-description {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.55;
}

.task-duration {
  margin-top: 12rpx;
  color: #879087;
  font-size: 22rpx;
}

.task-toggle {
  min-width: 140rpx;
  margin-left: 24rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid var(--color-primary);
  border-radius: 999rpx;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.task-toggle-completed {
  background: var(--color-primary);
  color: #ffffff;
}

.task-toggle-icon {
  display: inline-block;
  min-width: 24rpx;
  margin-right: 6rpx;
}

.task-toggle[disabled] {
  opacity: 0.65;
}

.no-task-card {
  margin-top: 20rpx;
  padding: 44rpx 30rpx;
  text-align: center;
}

.small-mark {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto;
  border-radius: 22rpx;
  font-size: 30rpx;
}

.no-task-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 650;
}

.bottom-action {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  background: rgba(255, 255, 255, 0.96);
}

.checkin-button {
  width: 100%;
  padding: 26rpx 30rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-weight: 650;
}

.checkin-button[disabled] {
  background: #d9ded8;
  color: #899087;
}

.checkin-button-done {
  background: #e3efe9;
  color: var(--color-primary);
}
