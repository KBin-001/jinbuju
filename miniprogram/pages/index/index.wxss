/* --- CSS 变量统一为奶油浅色系 --- */
.today-page[data-theme="inkGreen"] {
  --today-primary: #2F765E;
  --today-primary-deep: #294F43;
  --today-accent: #5EB28B;
  --today-text: #20322D;
  --today-secondary: #7D8C86;
  --today-muted: #93A099;
  --today-border: #E7ECE5;
  --today-gold: #F2C34B;
  background: #F6F3EA;
  color: #20322D;
}

/* --- 顶部背景插画（轻插画氛围，无文字） --- */
.today-header {
  position: relative;
  overflow: hidden;
  margin: -28rpx -32rpx 0;
  height: 300rpx;
}

.today-header-bg {
  position: absolute;
  left: 0;
  top: -12%;
  width: 100%;
  height: 124%;
  z-index: 0;
  pointer-events: none;
}

/* 底部柔和过渡：让插画波浪底部融入页面奶油白背景 */
.today-header::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 70rpx;
  background: linear-gradient(to bottom, rgba(246, 243, 234, 0) 0%, rgba(246, 243, 234, 0.5) 55%, #F6F3EA 100%);
  z-index: 1;
  pointer-events: none;
}

.today-header-content {
  position: relative;
  z-index: 2;
  padding: 52rpx 48rpx 0;
  box-sizing: border-box;
}

/* --- 问候文案（由 WXML 渲染，不写进背景图） --- */
.today-page[data-theme="inkGreen"] .today-header .today-greeting {
  color: #20322D;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1.12;
  letter-spacing: -1rpx;
}

.today-page[data-theme="inkGreen"] .today-header .today-subtitle {
  margin-top: 10rpx;
