.task-section-heading { flex: none; }
.task-section-title { font-size: 38rpx; line-height: 48rpx; font-weight: 500; letter-spacing: 3rpx; }
.task-section-tools { gap: 24rpx; }
.task-tool { min-height: 58rpx; display: flex; align-items: center; gap: 7rpx; color: #666e6a; font-size: 19rpx; line-height: 28rpx; white-space: nowrap; transition: opacity 160ms ease-out, transform 160ms ease-out; }
.task-tool:active { opacity: .65; transform: scale(.97); }
.task-tool .t-icon { color: #59635f; }
.action-panel { margin-top: 20rpx; overflow: visible; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
