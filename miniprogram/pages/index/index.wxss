}

@keyframes quick-add-enter {
  from { transform: translateY(32rpx); opacity: 0; }
  to { transform: translateY(0); }
}

.quick-duration-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 22;
