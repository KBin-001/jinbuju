page { background: #f8f5ec; }

.today-page {
  --ivory: #f8f5ec;
  --paper: #fffdf8;
  --ink: #234b40;
  --green: #31584b;
  --muted: #7d7970;
  --gold: #b58c43;
  --line: rgba(121,111,91,.16);
  min-height: 100vh;
  padding: 0 28rpx calc(142rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  color: var(--ink);
  background: linear-gradient(180deg, #faf7ef 0%, #f8f5ec 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.today-hero { margin: 0 -28rpx; }
.today-hero__background { opacity: .7; }
.today-hero__veil { background: linear-gradient(180deg, rgba(250,247,239,.02), rgba(248,245,236,.18) 58%, #f8f5ec 100%); }
.today-profile-row { position: relative; z-index: 2; min-height: 104rpx; margin-top: 10rpx; padding: 8rpx 10rpx 10rpx; display: flex; align-items: center; }
.today-avatar { width: 76rpx; height: 76rpx; flex: none; overflow: hidden; display: flex; align-items: center; justify-content: center; border: 3rpx solid rgba(255,253,248,.9); border-radius: 50%; background: #ecefe8; box-sizing: border-box; }
.today-avatar--text { color: var(--green); font-family: "Songti SC", STSong, serif; font-size: 48rpx; font-weight: 700; }
.today-greeting-copy { min-width: 0; margin-left: 18rpx; display: flex; flex: 1; flex-direction: column; }
.today-greeting { overflow: hidden; color: #1f4d40; font-family: "Songti SC", STSong, SimSun, serif; font-size: 31rpx; line-height: 40rpx; font-weight: 700; letter-spacing: 1rpx; text-overflow: ellipsis; white-space: nowrap; }
.today-subtitle { margin-top: 7rpx; color: #77746d; font-family: "Songti SC", STSong, serif; font-size: 23rpx; line-height: 32rpx; }

.action-streak { width: 112rpx; min-height: 68rpx; flex: none; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid rgba(200,155,74,.24); border-radius: 20rpx; background: rgba(255,252,246,.9); }
.action-streak__value { color: #8d682d; font-family: Georgia, serif; font-size: 32rpx; line-height: 38rpx; }
.action-streak__value text { margin-left: 3rpx; font-family: sans-serif; font-size: 18rpx; }
.action-streak__label { margin-top: 2rpx; color: #7c817d; font-size: 18rpx; }

.paper-card, .week-card, .stats-card, .reference-coach-entry, .today-task-row, .state-card, .empty-card { position: relative; overflow: hidden; box-sizing: border-box; border: 1rpx solid rgba(129,114,86,.14); border-radius: 28rpx; background: rgba(255,253,248,.95); box-shadow: 0 8rpx 24rpx rgba(75,62,40,.065); }
.paper-card::before, .week-card::before, .stats-card::before, .today-task-row::before { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0; }

.week-card { min-height: 190rpx; margin-top: 8rpx; padding: 20rpx 26rpx 18rpx; }
.week-head { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; }
.week-title { color: #1f4d40; font-family: "Songti SC", STSong, SimSun, serif; font-size: 31rpx; line-height: 42rpx; font-weight: 700; letter-spacing: 1rpx; }
.week-switch { min-height: 52rpx; display: flex; align-items: center; gap: 12rpx; color: #77746d; font-family: "Songti SC", STSong, serif; font-size: 23rpx; }
.week-chevron { color: #8f8b82; font-family: sans-serif; font-size: 35rpx; font-weight: 300; }
.week-grid { position: relative; z-index: 2; margin-top: 13rpx; display: grid; grid-template-columns: repeat(7, minmax(0,1fr)); }
.week-day { position: relative; min-width: 0; height: 88rpx; display: flex; flex-direction: column; align-items: center; color: #484b48; }
.week-label { font-family: "Songti SC", STSong, serif; font-size: 20rpx; line-height: 30rpx; }
.week-number { width: 52rpx; height: 52rpx; margin-top: 3rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-family: Georgia, "Songti SC", serif; font-size: 28rpx; line-height: 52rpx; }
.week-day.is-selected .week-number { background: #31584b; color: #fffdf8; box-shadow: 0 7rpx 16rpx rgba(49,88,75,.17); }
.week-day.is-today:not(.is-selected) .week-number { color: #31584b; box-shadow: inset 0 0 0 2rpx rgba(49,88,75,.28); }
.week-day.is-muted { opacity: .36; }

.stats-card { min-height: 210rpx; margin-top: 20rpx; padding: 27rpx 20rpx 20rpx; border-color: rgba(73,112,94,.16); background: #fffdf8; box-shadow: none; }
.stats-card--pressed { opacity: .86; transform: scale(.996); }
.stats-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 30% 30% 40%; height: 100%; }
.stats-column { position: relative; min-width: 0; box-sizing: border-box; padding: 0 24rpx; display: flex; flex-direction: column; align-items: flex-start; }
.stats-column--done { padding-left: 18rpx; }
.stats-column--progress { padding-right: 10rpx; }
.stats-column + .stats-column::before { content: ""; position: absolute; left: 0; top: 4rpx; bottom: 12rpx; width: 1rpx; background: rgba(61,100,83,.18); }
.stats-label { display: flex; align-items: center; gap: 10rpx; min-height: 34rpx; color: #5f6b66; font-family: "Songti SC", STSong, serif; font-size: 20rpx; line-height: 32rpx; white-space: nowrap; }
.stats-icon { width: 32rpx; height: 32rpx; flex: none; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.stats-icon--solid { border-radius: 50%; color: #fffdf8; background: #2f6b5a; }
.stats-icon--time { color: #9a7633; }
.stats-icon--flow { position: relative; overflow: hidden; border-radius: 50%; background: #2f6b5a; }
.stats-icon-flow-line { width: 21rpx; height: 8rpx; border-top: 3rpx solid #fffdf8; border-radius: 50%; transform: rotate(-7deg); }
.stats-value { display: flex; align-items: baseline; margin-top: 15rpx; color: #173f34; font-family: Georgia, "Songti SC", serif; line-height: 1; white-space: nowrap; }
.stats-value--done { font-size: 55rpx; }
.stats-value-slash { margin: 0 7rpx; color: #70877e; font-size: 48rpx; font-weight: 300; }
.stats-value--minutes { font-size: 49rpx; }
.stats-value--progress { font-size: 52rpx; }
.stats-value-unit { margin-left: 5rpx; color: #52645c; font-family: sans-serif; font-size: 17rpx; }
.stats-value-unit--percent { font-size: 27rpx; }
.stats-foot { min-width: 0; margin-top: 15rpx; display: flex; align-items: center; gap: 7rpx; color: #7f9d91; font-size: 18rpx; line-height: 27rpx; white-space: nowrap; }
.stats-foot-check { width: 25rpx; height: 25rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: #9db9a7; }
.stats-foot.is-complete { color: #638c70; font-weight: 600; }
.stats-mini-bars { width: 126rpx; height: 44rpx; margin-top: 16rpx; display: flex; align-items: flex-end; justify-content: center; gap: 6rpx; }
.stats-mini-bar { width: 6rpx; min-height: 4rpx; border-radius: 3rpx 3rpx 0 0; background: rgba(109,145,125,.26); }
.stats-mini-bar.is-active { background: #9db9a7; }
.stats-flow-track { position: relative; width: 100%; height: 47rpx; margin-top: 7rpx; overflow: hidden; border-radius: 24rpx; background: rgba(238,245,240,.72); }
.stats-flow-image { position: absolute; width: 100%; height: 47rpx; top: 0; left: 0; }
.stats-flow-image--base { opacity: .2; filter: grayscale(.45); }
.stats-flow-active { position: absolute; z-index: 2; width: 100%; height: 47rpx; top: 0; left: 0; overflow: hidden; transition: clip-path 420ms cubic-bezier(.22,.72,.28,1); }
.stats-flow-canvas { position: absolute; width: 100%; height: 47rpx; top: 0; left: 0; }
.stats-flow-image--active { width: 100%; filter: drop-shadow(0 3rpx 5rpx rgba(39,88,71,.14)); }
.stats-achievement-pill { min-width: 92rpx; height: 30rpx; margin: 0 auto; padding: 0 13rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid rgba(61,100,83,.18); border-radius: 15rpx; color: #527064; background: rgba(255,253,248,.92); font-size: 16rpx; line-height: 28rpx; white-space: nowrap; }
.stats-achievement-pill.is-complete { border-color: rgba(200,155,74,.3); color: #8d682d; background: #fff8e9; }

.reference-coach-entry { min-height: 202rpx; margin-top: 20rpx; border-radius: 28rpx; box-shadow: none; }
.reference-card--pressed { opacity: .8; }
.reference-coach-background { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: .88; transform: scale(1.02); transform-origin: 78% 64%; }
.reference-coach-veil { position: absolute; inset: 0; background: linear-gradient(90deg,rgba(255,252,246,.99) 0%,rgba(255,252,246,.95) 48%,rgba(255,252,246,.72) 65%,rgba(255,252,246,.22) 100%),linear-gradient(180deg,transparent 55%,rgba(255,252,246,.18) 100%); }
.reference-coach-copy { position: relative; z-index: 2; width: 100%; min-height: 202rpx; padding: 24rpx 28rpx; box-sizing: border-box; display: flex; flex-direction: column; justify-content: center; }
.proactive-insight { max-width: 100%; padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
.proactive-label { color: #9b7432; font-size: 18rpx; font-weight: 600; line-height: 26rpx; }
.proactive-title { margin-top: 5rpx; display: -webkit-box; overflow: hidden; color: #203c33; font-size: 29rpx; font-weight: 700; line-height: 40rpx; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.proactive-body { margin-top: 6rpx; display: -webkit-box; overflow: hidden; color: #65716c; font-size: 20rpx; line-height: 30rpx; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.coach-entry-footer { min-height: 58rpx; margin-top: 12rpx; display: inline-flex; align-items: center; gap: 3rpx; color: #8b682f; font-size: 19rpx; font-weight: 650; }

.task-section { margin-top: 24rpx; }
.task-section--primary { margin-top: 16rpx; }
.task-section-head { min-height: 56rpx; display: flex; align-items: center; justify-content: space-between; }
.task-section-title { color: #1f4d40; font-family: "Songti SC", STSong, SimSun, serif; font-size: 32rpx; line-height: 42rpx; font-weight: 700; letter-spacing: 2rpx; }
.task-section-subtitle { margin-top: 2rpx; color: #817e77; font-size: 20rpx; line-height: 30rpx; }
.task-section-add { height: 52rpx; padding: 0 19rpx; display: flex; align-items: center; gap: 4rpx; border: 1rpx solid rgba(36,91,77,.24); border-radius: 26rpx; color: #245b4d; background: #fffdf8; font-size: 20rpx; font-weight: 650; }
.today-action-list { margin-top: 10rpx; }
.today-task-row { min-height: 102rpx; margin-bottom: 10rpx; padding: 13rpx 18rpx; display: flex; align-items: center; gap: 12rpx; }
.today-task-row.is-done { border-color: rgba(91,120,101,.22); background: rgba(241,245,237,.95); }
.reference-task-icon { position: relative; z-index: 2; width: 46rpx; height: 46rpx; flex: none; display: flex; align-items: center; justify-content: center; }
.reference-task-icon image { width: 40rpx; height: 40rpx; filter: grayscale(.65) sepia(.15) hue-rotate(85deg) saturate(.75); opacity: .78; }
.task-copy { position: relative; z-index: 2; min-width: 0; flex: 1; }
.task-title-line { min-width: 0; display: flex; align-items: center; gap: 14rpx; }
.task-title { min-width: 0; flex: 1; overflow: hidden; color: #263e36; font-family: "Songti SC", STSong, serif; font-size: 27rpx; line-height: 36rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.task-duration { flex: none; color: #777b76; font-size: 18rpx; line-height: 28rpx; white-space: nowrap; }
.task-meta-actual { color: #527064; font-size: 18rpx; line-height: 26rpx; }
.task-status-line { min-height: 28rpx; margin-top: 5rpx; display: flex; align-items: center; gap: 10rpx; }
.task-status { padding: 0 9rpx; border-radius: 999rpx; color: #52645d; background: #edf1ed; font-size: 16rpx; line-height: 26rpx; }
.task-status--success { color: #245b4d; background: #e8f0eb; }
.task-status--warning { color: #8d682d; background: #f7ebcf; }
.task-status--danger { color: #9b5549; background: #fbf1ed; }
.task-tail-check { position: relative; z-index: 2; width: 50rpx; height: 50rpx; flex: none; display: flex; align-items: center; justify-content: center; border: 2rpx solid #777b76; border-radius: 50%; color: #fff; }
.task-tail-check::after { content: ""; position: absolute; inset: -10rpx; border-radius: 50%; }
.task-tail-check.is-done { border-color: #31584b; background: #31584b; box-shadow: 0 6rpx 13rpx rgba(49,88,75,.17); }
.task-tail-check.is-disabled { border-style: dashed; opacity: .38; }
.task-tail-check .t-icon { font-size: 28rpx; }
.action-list-toggle { padding: 10rpx 0 4rpx; color: #8f793f; font-size: 20rpx; text-align: center; }
.action-empty-inline { padding: 42rpx 28rpx; border: 1rpx dashed rgba(49,88,75,.2); border-radius: 25rpx; background: rgba(255,253,248,.72); color: #31584b; text-align: center; }
.action-empty-inline > view { font-family: "Songti SC", STSong, serif; font-size: 27rpx; }
.action-empty-inline text { display: block; margin-top: 8rpx; color: #817e77; font-size: 20rpx; }
.action-empty-button { width: 236rpx; min-height: 64rpx; margin: 22rpx auto 0; padding: 0 22rpx; display: flex; align-items: center; justify-content: center; border-radius: 32rpx; color: #fff; background: #31584b; font-family: inherit !important; font-size: 22rpx !important; font-weight: 650; }

.state-card, .empty-card { margin-top: 20rpx; padding: 58rpx 32rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }
.loading-dot { width: 26rpx; height: 26rpx; margin-bottom: 20rpx; border: 5rpx solid rgba(49,88,75,.18); border-top-color: #31584b; border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.state-mark, .empty-mark { width: 72rpx; height: 72rpx; margin-bottom: 18rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #eef2ec; color: #31584b; font-family: "Songti SC", serif; font-size: 26rpx; }
.state-title { color: #234b40; font-family: "Songti SC", STSong, serif; font-size: 30rpx; font-weight: 700; }
.state-description { max-width: 520rpx; margin-top: 12rpx; color: #7d7970; font-size: 21rpx; line-height: 32rpx; }
.primary-button { min-width: 230rpx; height: 72rpx; margin-top: 24rpx; border-radius: 36rpx; background: #31584b; color: #fff; font-size: 25rpx; line-height: 72rpx; }
.primary-button::after { border: 0; }

/* shared bottom sheets */
.calendar-layer, .quick-add-layer, .quick-duration-layer, .completion-layer { position: fixed; z-index: 10020; inset: 0; pointer-events: none; }
.calendar-layer, .quick-add-layer, .quick-duration-layer { pointer-events: auto; }
.calendar-mask, .quick-add-mask, .completion-mask { position: absolute; inset: 0; background: rgba(29,48,41,.34); backdrop-filter: blur(4rpx); -webkit-backdrop-filter: blur(4rpx); }
.calendar-panel, .quick-add-panel, .quick-duration-panel, .completion-panel { position: absolute; right: 0; bottom: 0; left: 0; padding: 18rpx 30rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius: 34rpx 34rpx 0 0; background: #faf8f1; box-shadow: 0 -18rpx 48rpx rgba(31,65,54,.16); }
.calendar-head, .quick-add-header, .quick-duration-header { min-height: 68rpx; display: flex; align-items: center; justify-content: space-between; }
.calendar-title, .quick-add-title, .quick-duration-title { color: #234b40; font-family: "Songti SC", STSong, serif; font-size: 32rpx; font-weight: 700; }
.calendar-nav, .quick-add-close { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #eef1eb; color: #51665d; font-size: 31rpx; }
.calendar-week-row, .calendar-grid { display: grid; grid-template-columns: repeat(7,1fr); }
.calendar-week-row { margin-top: 14rpx; }
.calendar-week-label { color: #8a877f; font-size: 19rpx; text-align: center; }
.calendar-grid { margin-top: 10rpx; row-gap: 7rpx; }
.calendar-day { position: relative; height: 72rpx; display: flex; align-items: center; justify-content: center; }
.calendar-day-number { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #4d514e; font-family: Georgia, serif; font-size: 23rpx; }
.calendar-day.is-outside { opacity: .28; }
.calendar-day.is-today:not(.is-selected) .calendar-day-number { box-shadow: inset 0 0 0 2rpx rgba(49,88,75,.28); }
.calendar-day.is-selected .calendar-day-number { background: #31584b; color: #fff; }
.calendar-footer { margin-top: 18rpx; display: flex; justify-content: flex-end; gap: 14rpx; }
.calendar-today, .calendar-confirm { height: 60rpx; padding: 0 28rpx; display: flex; align-items: center; border-radius: 30rpx; font-size: 22rpx; }
.calendar-today { border: 1rpx solid #d7e1da; color: #31584b; }
.calendar-confirm { background: #31584b; color: #fff; }

.quick-add-panel { max-height: 84vh; overflow-y: auto; }
.quick-add-grabber, .completion-grabber { width: 72rpx; height: 7rpx; margin: 0 auto 20rpx; border-radius: 5rpx; background: #d8ddd8; }
.quick-add-copy { margin: 8rpx 0 24rpx; color: #7d7970; font-size: 21rpx; line-height: 31rpx; }
.quick-add-field { margin-top: 20rpx; }
.quick-add-label { color: #234b40; font-size: 23rpx; font-weight: 600; }
.quick-add-hint { color: #918d84; font-size: 18rpx; }
.quick-reminder-row { min-height: 70rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.quick-reminder-time { margin-top: 12rpx; }
.quick-reminder-picker { min-height: 66rpx; margin-top: 10rpx; padding: 0 22rpx; display: flex; align-items: center; justify-content: space-between; border: 1rpx solid rgba(36,91,77,.16); border-radius: 20rpx; background: #fffdf8; color: #245b4d; font-size: 22rpx; }
.quick-reminder-picker text:last-child { color: #918d84; font-size: 19rpx; }
.quick-reminder-note { margin-top: 8rpx; color: #8b6a37; font-size: 19rpx; line-height: 30rpx; }
.quick-add-input { min-height: 88rpx; margin-top: 10rpx; border: 1rpx solid var(--color-border-soft, #e1e5de); border-radius: 24rpx; background: var(--color-card, #fffdf8); }
.quick-add-placeholder { color: #aaa79e; }
.quick-add-label-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.quick-duration-chips { margin-top: 14rpx; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.quick-duration-chip { min-height: 70rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(36,91,77,.2); border-radius: 35rpx; background: var(--color-card, #fffdf8); color: var(--color-primary, #245b4d); font-size: 22rpx; font-weight: 600; }
.quick-duration-chip.is-selected { border-color: var(--color-primary, #245b4d); background: var(--color-primary, #245b4d); color: #fff; box-shadow: 0 8rpx 18rpx rgba(36,91,77,.14); }
.quick-add-actions { margin-top: 22rpx; display: flex; gap: 14rpx; }
.quick-add-secondary, .quick-add-primary { flex: 1; height: 72rpx; border-radius: 36rpx; font-size: 24rpx; line-height: 72rpx; }
.quick-add-secondary { border: 1rpx solid #d7e1da; background: #fffdf8; color: #31584b; }
.quick-add-primary { background: #31584b; color: #fff; }
.quick-add-secondary::after, .quick-add-primary::after { border: 0; }

.quick-duration-layer { background: rgba(29,48,41,.34); }
.quick-duration-options { margin-top: 12rpx; }
.quick-duration-option { min-height: 72rpx; padding: 0 12rpx; display: flex; align-items: center; border-bottom: 1rpx solid #e6e7e1; color: #5d625e; }
.quick-duration-option.is-selected { color: #31584b; font-weight: 700; }
.quick-duration-option-label { font-size: 23rpx; }
.quick-duration-check { margin-left: auto; color: #b58c43; }
.quick-duration-cancel { height: 66rpx; margin-top: 15rpx; display: flex; align-items: center; justify-content: center; border-radius: 33rpx; background: #eef1eb; color: #31584b; }
.quick-duration-spacer { width: 58rpx; }

.completion-layer { display: block; visibility: hidden; }
.completion-layer.is-visible { visibility: visible; pointer-events: auto; }
.completion-mask { opacity: 0; transition: opacity .2s; }
.completion-panel { transform: translateY(100%); transition: transform .25s ease-out; }
.completion-layer.is-visible .completion-mask { opacity: 1; }
.completion-layer.is-visible .completion-panel { transform: translateY(0); }
.completion-celebration { display: flex; flex-direction: column; align-items: center; text-align: center; }
.completion-badge { position: relative; width: 86rpx; height: 86rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid #c7a15a; border-radius: 50%; background: #f5ecd7; color: #31584b; }
.completion-title { margin-top: 15rpx; color: #234b40; font-family: "Songti SC", STSong, serif; font-size: 34rpx; font-weight: 700; }
.completion-copy { margin-top: 7rpx; color: #7d7970; font-size: 21rpx; }
.completion-stats { margin-top: 22rpx; display: grid; grid-template-columns: repeat(2,1fr); gap: 12rpx; }
.completion-stat-card { min-height: 102rpx; padding: 16rpx; display: flex; align-items: center; gap: 13rpx; border: 1rpx solid #e0e5de; border-radius: 20rpx; background: #fffdf8; }
.completion-stat-icon { width: 48rpx; height: 48rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #e9f0eb; color: #31584b; font-size: 19rpx; }
.completion-stat-icon.is-yellow { background: #f5ecd7; color: #9d762f; }
.completion-stat-value { color: #234b40; font-family: Georgia, serif; font-size: 27rpx; }
.completion-stat-label { margin-top: 3rpx; color: #85827b; font-size: 18rpx; }
.completion-actions { margin-top: 20rpx; display: flex; gap: 14rpx; }
.completion-share-button, .completion-continue-button { flex: 1; height: 72rpx; border-radius: 36rpx; font-size: 23rpx; line-height: 72rpx; }
.completion-share-button { border: 1rpx solid #d7e1da; background: #fffdf8; color: #31584b; }
.completion-continue-button { background: #31584b; color: #fff; }
.completion-share-button::after, .completion-continue-button::after { border: 0; }
.completion-share-icon, .completion-arrow { margin-right: 6rpx; }
.today-notification { margin: 0 0 var(--gap-card); overflow: hidden; border-radius: 20rpx; }
.completion-reminder-button { width: 100%; height: 72rpx; margin-top: 14rpx; border: 1rpx solid #d7e1da; border-radius: 36rpx; color: #31584b; background: #fffdf8; font-size: 23rpx; }
.completion-reminder-button::after { border: 0; }

@media (max-width:350px) {
  .today-page { padding-right: 22rpx; padding-left: 22rpx; }
  .today-hero { margin-right: -22rpx; margin-left: -22rpx; }
  .today-profile-row { padding-right: 4rpx; padding-left: 4rpx; }
  .today-avatar { width: 68rpx; height: 68rpx; }
  .today-greeting-copy { margin-left: 14rpx; }
  .today-greeting { font-size: 28rpx; }
  .today-subtitle { font-size: 21rpx; }
  .action-streak { width: 104rpx; }
  .week-card { padding-right: 20rpx; padding-left: 20rpx; }
  .stats-card { height: 258rpx; padding: 35rpx 17rpx 23rpx; }
  .stats-grid { grid-template-columns: 29% 29% 42%; }
  .stats-column { padding-right: 15rpx; padding-left: 15rpx; }
  .stats-column--done { padding-left: 10rpx; }
  .stats-column--progress { padding-right: 6rpx; }
  .stats-label { gap: 6rpx; font-size: 17rpx; }
  .stats-icon { width: 27rpx; height: 27rpx; }
  .stats-value--done { font-size: 58rpx; }
  .stats-value-slash { margin-right: 4rpx; margin-left: 4rpx; font-size: 39rpx; }
  .stats-value--minutes { font-size: 47rpx; }
  .stats-value--progress { font-size: 53rpx; }
  .stats-value-unit { font-size: 13rpx; }
  .stats-value-unit--percent { font-size: 22rpx; }
  .stats-foot { gap: 4rpx; font-size: 15rpx; }
  .stats-foot-check { width: 21rpx; height: 21rpx; }
  .stats-mini-bars { width: 106rpx; gap: 4rpx; }
  .reference-coach-entry, .reference-coach-copy { min-height: 272rpx; }
  .reference-coach-copy { width: 100%; padding-left: 26rpx; }
  .proactive-insight { max-width: 68%; }
  .proactive-title { font-size: 27rpx; line-height: 38rpx; }
  .quick-duration-chip { font-size: 20rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .stats-flow-active { transition: none; }
}
