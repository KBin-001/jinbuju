page { background: #f8f5ec; }

.today-page {
  --ivory: #f8f5ec;
  --paper: #fffdf8;
  --ink: #234b40;
  --green: #31584b;
  --muted: #7d7970;
  --gold: #b58c43;
  --line: rgba(121,111,91,.16);
  min-height: 100vh;
  padding: 0 28rpx calc(142rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  color: var(--ink);
  background: linear-gradient(180deg, #faf7ef 0%, #f8f5ec 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.today-hero { position: relative; height: 378rpx; margin: 0 -28rpx; overflow: hidden; }
.today-hero__background { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
.today-hero__veil { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(250,247,239,.02), rgba(248,245,236,.02) 70%, #f8f5ec 100%); }
.today-nav { position: relative; z-index: 2; box-sizing: content-box; display: flex; align-items: center; justify-content: center; }
.today-nav text { color: #1f4d40; font-family: "Songti SC", STSong, SimSun, serif; font-size: 43rpx; line-height: 1; font-weight: 700; letter-spacing: 5rpx; }
.today-profile-row { position: absolute; z-index: 2; left: 54rpx; right: 44rpx; bottom: 36rpx; display: flex; align-items: center; }
.today-avatar { width: 126rpx; height: 126rpx; flex: none; overflow: hidden; display: flex; align-items: center; justify-content: center; border: 4rpx solid rgba(255,253,248,.78); border-radius: 50%; background: #ecefe8; box-sizing: border-box; box-shadow: 0 8rpx 20rpx rgba(45,66,56,.08); }
.today-avatar--text { color: var(--green); font-family: "Songti SC", STSong, serif; font-size: 48rpx; font-weight: 700; }
.today-greeting-copy { min-width: 0; margin-left: 28rpx; display: flex; flex: 1; flex-direction: column; }
.today-greeting { overflow: hidden; color: #1f4d40; font-family: "Songti SC", STSong, SimSun, serif; font-size: 36rpx; line-height: 46rpx; font-weight: 700; letter-spacing: 2rpx; text-overflow: ellipsis; white-space: nowrap; }
.today-subtitle { margin-top: 7rpx; color: #77746d; font-family: "Songti SC", STSong, serif; font-size: 23rpx; line-height: 32rpx; }

.spark-checkin { position: relative; width: 150rpx; min-height: 94rpx; flex: none; padding: 13rpx 16rpx; display: flex; align-items: center; justify-content: center; gap: 9rpx; box-sizing: border-box; border: 1rpx solid rgba(181,140,67,.22); border-radius: 22rpx; background: rgba(255,253,248,.88); box-shadow: 0 8rpx 20rpx rgba(75,58,28,.08); transition: transform .16s, opacity .16s; }
.spark-checkin--pressed { opacity: .75; transform: scale(.96); }
.spark-icon-wrap { position: relative; width: 50rpx; height: 60rpx; flex: none; }
.spark-icon { position: relative; z-index: 2; width: 100%; height: 100%; display: block; filter: sepia(.35) saturate(.75); }
.spark-halo { position: absolute; z-index: 1; inset: 8rpx 2rpx; border-radius: 50%; background: rgba(211,166,77,.28); filter: blur(10rpx); animation: spark-breathe .8s ease-in-out infinite alternate; }
.spark-copy { display: flex; flex-direction: column; align-items: flex-start; }
.spark-count { color: #a77931; font-family: Georgia, "Songti SC", serif; font-size: 35rpx; line-height: 39rpx; }
.spark-count text { margin-left: 2rpx; font-size: 19rpx; }
.spark-action { color: #77746d; font-size: 19rpx; line-height: 27rpx; }
.spark-checkin.is-unlit { filter: grayscale(.48); opacity: .74; }
.spark-checkin.is-animating { animation: spark-pop .68s ease-out both; }
@keyframes spark-pop { 0%{transform:scale(.88)} 50%{transform:scale(1.08)} 100%{transform:scale(1)} }
@keyframes spark-breathe { from{opacity:.45;transform:scale(.85)} to{opacity:1;transform:scale(1.16)} }

.paper-card, .week-card, .stats-card, .reference-coach-entry, .today-task-row, .state-card, .empty-card { position: relative; overflow: hidden; box-sizing: border-box; border: 1rpx solid rgba(129,114,86,.14); border-radius: 28rpx; background: rgba(255,253,248,.95); box-shadow: 0 8rpx 24rpx rgba(75,62,40,.065); }
.paper-card::before, .week-card::before, .stats-card::before, .reference-coach-entry::before, .today-task-row::before { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .22; background-image: radial-gradient(rgba(92,75,47,.09) .6rpx, transparent .7rpx); background-size: 6rpx 6rpx; }

.week-card { min-height: 232rpx; margin-top: -8rpx; padding: 26rpx 30rpx 25rpx; }
.week-head { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; }
.week-title { color: #1f4d40; font-family: "Songti SC", STSong, SimSun, serif; font-size: 36rpx; line-height: 46rpx; font-weight: 700; letter-spacing: 2rpx; }
.week-switch { min-height: 52rpx; display: flex; align-items: center; gap: 12rpx; color: #77746d; font-family: "Songti SC", STSong, serif; font-size: 23rpx; }
.week-chevron { color: #8f8b82; font-family: sans-serif; font-size: 35rpx; font-weight: 300; }
.week-grid { position: relative; z-index: 2; margin-top: 22rpx; display: grid; grid-template-columns: repeat(7, minmax(0,1fr)); }
.week-day { position: relative; min-width: 0; height: 112rpx; display: flex; flex-direction: column; align-items: center; color: #484b48; }
.week-label { font-family: "Songti SC", STSong, serif; font-size: 20rpx; line-height: 30rpx; }
.week-number { width: 60rpx; height: 60rpx; margin-top: 8rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-family: Georgia, "Songti SC", serif; font-size: 33rpx; line-height: 60rpx; }
.week-day.is-selected .week-number { background: #31584b; color: #fffdf8; box-shadow: 0 7rpx 16rpx rgba(49,88,75,.17); }
.week-day.is-today:not(.is-selected) .week-number { color: #31584b; box-shadow: inset 0 0 0 2rpx rgba(49,88,75,.28); }
.week-day.is-muted { opacity: .36; }
.week-selected-dot { position: absolute; bottom: 1rpx; width: 13rpx; height: 13rpx; border: 3rpx solid #fffdf8; border-radius: 50%; background: #c39a4f; }

.stats-card { height: 210rpx; margin-top: 20rpx; padding: 30rpx 12rpx; display: flex; }
.stats-card--pressed { opacity: .78; }
.stats-col { position: relative; z-index: 2; flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.stats-col + .stats-col::before { content: ""; position: absolute; left: 0; top: 2rpx; bottom: 2rpx; width: 1rpx; background: var(--line); }
.stats-col-label { min-height: 38rpx; display: flex; align-items: center; gap: 9rpx; color: #74756f; font-family: "Songti SC", STSong, serif; font-size: 21rpx; white-space: nowrap; }
.stats-col-label t-icon { color: #606d67; }
.stats-col-value { margin-top: 13rpx; color: #202f2a; font-family: Georgia, "Songti SC", serif; font-size: 54rpx; line-height: 66rpx; }
.stats-col-unit { margin-left: 5rpx; color: #716e68; font-size: 20rpx; }
.stats-ring-wrap { position: relative; width: 112rpx; height: 112rpx; margin-top: 4rpx; }
.stats-ring-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
.stats-ring-text { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #203c33; font-family: Georgia, serif; font-size: 32rpx; }

.reference-coach-entry { height: 190rpx; margin-top: 20rpx; }
.reference-card--pressed { opacity: .8; }
.reference-coach-background { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
.reference-coach-veil { position: absolute; inset: 0; background: linear-gradient(90deg,#fffdf8 0%,#fffdf8 43%,rgba(255,253,248,.9) 55%,rgba(255,253,248,.08) 100%); }
.reference-coach-copy { position: relative; z-index: 2; width: 64%; height: 100%; padding: 35rpx 36rpx; box-sizing: border-box; display: flex; flex-direction: column; justify-content: center; }
.reference-coach-title { display: flex; align-items: center; color: #1f4d40; font-family: "Songti SC", STSong, serif; font-size: 37rpx; line-height: 46rpx; font-weight: 700; letter-spacing: 2rpx; }
.reference-coach-mark { order: 2; margin-left: 10rpx; color: #c1974c; font-size: 29rpx; }
.reference-coach-arrow { display: none; }
.reference-coach-subtitle { margin-top: 13rpx; display: -webkit-box; overflow: hidden; color: #77746d; font-family: "Songti SC", STSong, serif; font-size: 21rpx; line-height: 31rpx; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }

.task-section { margin-top: 28rpx; }
.task-section-head { min-height: 64rpx; display: flex; align-items: center; justify-content: space-between; }
.task-section-title { color: #1f4d40; font-family: "Songti SC", STSong, SimSun, serif; font-size: 37rpx; line-height: 48rpx; font-weight: 700; letter-spacing: 3rpx; }
.task-section-add { height: 54rpx; padding: 0 23rpx; display: flex; align-items: center; gap: 5rpx; border: 1rpx solid #bd9145; border-radius: 28rpx; color: #a77931; font-family: "Songti SC", STSong, serif; font-size: 21rpx; }
.today-action-list { margin-top: 14rpx; }
.today-task-row { min-height: 112rpx; margin-bottom: 14rpx; padding: 18rpx 22rpx; display: flex; align-items: center; gap: 18rpx; }
.today-task-row.is-done { border-color: rgba(91,120,101,.22); background: rgba(241,245,237,.95); }
.reference-task-icon { position: relative; z-index: 2; width: 58rpx; height: 58rpx; flex: none; display: flex; align-items: center; justify-content: center; }
.reference-task-icon image { width: 48rpx; height: 48rpx; filter: grayscale(.65) sepia(.15) hue-rotate(85deg) saturate(.75); opacity: .78; }
.task-copy { position: relative; z-index: 2; min-width: 0; flex: 1; }
.task-title { overflow: hidden; color: #263e36; font-family: "Songti SC", STSong, serif; font-size: 28rpx; line-height: 38rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.task-meta { margin-top: 6rpx; overflow: hidden; color: #7e7b74; font-size: 19rpx; line-height: 28rpx; text-overflow: ellipsis; white-space: nowrap; }
.task-meta-dot { margin: 0 8rpx; }
.task-goal-name { color: #77746d; }
.task-tail-check { position: relative; z-index: 2; width: 52rpx; height: 52rpx; flex: none; display: flex; align-items: center; justify-content: center; border: 2rpx solid #777b76; border-radius: 50%; color: #fff; }
.task-tail-check.is-done { border-color: #31584b; background: #31584b; box-shadow: 0 6rpx 13rpx rgba(49,88,75,.17); }
.task-tail-check .t-icon { font-size: 28rpx; }
.action-list-toggle { padding: 15rpx 0 7rpx; color: #8f793f; font-size: 21rpx; text-align: center; }
.action-empty-inline { padding: 42rpx 28rpx; border: 1rpx dashed rgba(49,88,75,.2); border-radius: 25rpx; background: rgba(255,253,248,.72); color: #31584b; text-align: center; }
.action-empty-inline > view { font-family: "Songti SC", STSong, serif; font-size: 27rpx; }
.action-empty-inline text { display: block; margin-top: 8rpx; color: #817e77; font-size: 20rpx; }

.state-card, .empty-card { margin-top: -8rpx; padding: 58rpx 32rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }
.loading-dot { width: 26rpx; height: 26rpx; margin-bottom: 20rpx; border: 5rpx solid rgba(49,88,75,.18); border-top-color: #31584b; border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.state-mark, .empty-mark { width: 72rpx; height: 72rpx; margin-bottom: 18rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #eef2ec; color: #31584b; font-family: "Songti SC", serif; font-size: 26rpx; }
.state-title { color: #234b40; font-family: "Songti SC", STSong, serif; font-size: 30rpx; font-weight: 700; }
.state-description { max-width: 520rpx; margin-top: 12rpx; color: #7d7970; font-size: 21rpx; line-height: 32rpx; }
.primary-button { min-width: 230rpx; height: 72rpx; margin-top: 24rpx; border-radius: 36rpx; background: #31584b; color: #fff; font-size: 25rpx; line-height: 72rpx; }
.primary-button::after { border: 0; }

/* shared bottom sheets */
.calendar-layer, .quick-add-layer, .quick-duration-layer, .completion-layer { position: fixed; z-index: 10020; inset: 0; pointer-events: none; }
.calendar-layer, .quick-add-layer, .quick-duration-layer { pointer-events: auto; }
.calendar-mask, .quick-add-mask, .completion-mask { position: absolute; inset: 0; background: rgba(29,48,41,.34); backdrop-filter: blur(4rpx); -webkit-backdrop-filter: blur(4rpx); }
.calendar-panel, .quick-add-panel, .quick-duration-panel, .completion-panel { position: absolute; right: 0; bottom: 0; left: 0; padding: 18rpx 30rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius: 34rpx 34rpx 0 0; background: #faf8f1; box-shadow: 0 -18rpx 48rpx rgba(31,65,54,.16); }
.calendar-head, .quick-add-header, .quick-duration-header { min-height: 68rpx; display: flex; align-items: center; justify-content: space-between; }
.calendar-title, .quick-add-title, .quick-duration-title { color: #234b40; font-family: "Songti SC", STSong, serif; font-size: 32rpx; font-weight: 700; }
.calendar-nav, .quick-add-close { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #eef1eb; color: #51665d; font-size: 31rpx; }
.calendar-week-row, .calendar-grid { display: grid; grid-template-columns: repeat(7,1fr); }
.calendar-week-row { margin-top: 14rpx; }
.calendar-week-label { color: #8a877f; font-size: 19rpx; text-align: center; }
.calendar-grid { margin-top: 10rpx; row-gap: 7rpx; }
.calendar-day { position: relative; height: 72rpx; display: flex; align-items: center; justify-content: center; }
.calendar-day-number { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #4d514e; font-family: Georgia, serif; font-size: 23rpx; }
.calendar-day.is-outside { opacity: .28; }
.calendar-day.is-today:not(.is-selected) .calendar-day-number { box-shadow: inset 0 0 0 2rpx rgba(49,88,75,.28); }
.calendar-day.is-selected .calendar-day-number { background: #31584b; color: #fff; }
.calendar-dot { position: absolute; bottom: 2rpx; width: 7rpx; height: 7rpx; border-radius: 50%; background: #c39a4f; }
.calendar-dot.is-completed { background: #31584b; }
.calendar-footer { margin-top: 18rpx; display: flex; justify-content: flex-end; gap: 14rpx; }
.calendar-today, .calendar-confirm { height: 60rpx; padding: 0 28rpx; display: flex; align-items: center; border-radius: 30rpx; font-size: 22rpx; }
.calendar-today { border: 1rpx solid #d7e1da; color: #31584b; }
.calendar-confirm { background: #31584b; color: #fff; }

.quick-add-panel { max-height: 84vh; overflow-y: auto; }
.quick-add-grabber, .completion-grabber { width: 72rpx; height: 7rpx; margin: 0 auto 20rpx; border-radius: 5rpx; background: #d8ddd8; }
.quick-add-copy { margin: 8rpx 0 24rpx; color: #7d7970; font-size: 21rpx; line-height: 31rpx; }
.quick-add-field { margin-top: 20rpx; }
.quick-add-label { color: #234b40; font-size: 23rpx; font-weight: 600; }
.quick-add-hint { color: #918d84; font-size: 18rpx; }
.quick-add-input, .quick-add-textarea { margin-top: 10rpx; border: 1rpx solid #e1e5de; border-radius: 20rpx; background: #fffdf8; }
.quick-add-input { min-height: 76rpx; }
.quick-add-textarea { min-height: 138rpx; padding: 18rpx; box-sizing: border-box; }
.quick-add-placeholder { color: #aaa79e; }
.quick-add-minutes-row > view:first-child { display: flex; align-items: center; justify-content: space-between; }
.quick-add-minutes-control { height: 76rpx; margin-top: 10rpx; padding: 0 22rpx; display: flex; align-items: center; border: 1rpx solid #e1e5de; border-radius: 20rpx; background: #fffdf8; }
.quick-add-minutes-value { color: #31584b; font-family: Georgia, serif; font-size: 32rpx; }
.quick-add-minute-unit { margin-left: 6rpx; color: #77746d; font-size: 20rpx; }
.quick-add-picker-arrow { margin-left: auto; width: 14rpx; height: 14rpx; border-right: 2rpx solid #8a8d88; border-bottom: 2rpx solid #8a8d88; transform: rotate(45deg) translateY(-4rpx); }
.quick-add-actions { margin-top: 22rpx; display: flex; gap: 14rpx; }
.quick-add-secondary, .quick-add-primary { flex: 1; height: 72rpx; border-radius: 36rpx; font-size: 24rpx; line-height: 72rpx; }
.quick-add-secondary { border: 1rpx solid #d7e1da; background: #fffdf8; color: #31584b; }
.quick-add-primary { background: #31584b; color: #fff; }
.quick-add-secondary::after, .quick-add-primary::after { border: 0; }

.quick-duration-layer { background: rgba(29,48,41,.34); }
.quick-duration-options { margin-top: 12rpx; }
.quick-duration-option { min-height: 72rpx; padding: 0 12rpx; display: flex; align-items: center; border-bottom: 1rpx solid #e6e7e1; color: #5d625e; }
.quick-duration-option.is-selected { color: #31584b; font-weight: 700; }
.quick-duration-option-label { font-size: 23rpx; }
.quick-duration-check { margin-left: auto; color: #b58c43; }
.quick-duration-cancel { height: 66rpx; margin-top: 15rpx; display: flex; align-items: center; justify-content: center; border-radius: 33rpx; background: #eef1eb; color: #31584b; }
.quick-duration-spacer { width: 58rpx; }

.completion-layer { display: block; visibility: hidden; }
.completion-layer.is-visible { visibility: visible; pointer-events: auto; }
.completion-mask { opacity: 0; transition: opacity .2s; }
.completion-panel { transform: translateY(100%); transition: transform .25s ease-out; }
.completion-layer.is-visible .completion-mask { opacity: 1; }
.completion-layer.is-visible .completion-panel { transform: translateY(0); }
.completion-celebration { display: flex; flex-direction: column; align-items: center; text-align: center; }
.completion-badge { position: relative; width: 86rpx; height: 86rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid #c7a15a; border-radius: 50%; background: #f5ecd7; color: #31584b; }
.completion-sparkle { position: absolute; right: -9rpx; top: -8rpx; color: #c39a4f; }
.completion-title { margin-top: 15rpx; color: #234b40; font-family: "Songti SC", STSong, serif; font-size: 34rpx; font-weight: 700; }
.completion-copy { margin-top: 7rpx; color: #7d7970; font-size: 21rpx; }
.completion-stats { margin-top: 22rpx; display: grid; grid-template-columns: repeat(2,1fr); gap: 12rpx; }
.completion-stat-card { min-height: 102rpx; padding: 16rpx; display: flex; align-items: center; gap: 13rpx; border: 1rpx solid #e0e5de; border-radius: 20rpx; background: #fffdf8; }
.completion-stat-icon { width: 48rpx; height: 48rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #e9f0eb; color: #31584b; font-size: 19rpx; }
.completion-stat-icon.is-yellow { background: #f5ecd7; color: #9d762f; }
.completion-stat-value { color: #234b40; font-family: Georgia, serif; font-size: 27rpx; }
.completion-stat-label { margin-top: 3rpx; color: #85827b; font-size: 18rpx; }
.completion-actions { margin-top: 20rpx; display: flex; gap: 14rpx; }
.completion-share-button, .completion-continue-button { flex: 1; height: 72rpx; border-radius: 36rpx; font-size: 23rpx; line-height: 72rpx; }
.completion-share-button { border: 1rpx solid #d7e1da; background: #fffdf8; color: #31584b; }
.completion-continue-button { background: #31584b; color: #fff; }
.completion-share-button::after, .completion-continue-button::after { border: 0; }
.completion-share-icon, .completion-arrow { margin-right: 6rpx; }

@media (max-width:350px) {
  .today-page { padding-right: 22rpx; padding-left: 22rpx; }
  .today-hero { margin-right: -22rpx; margin-left: -22rpx; }
  .today-profile-row { left: 38rpx; right: 28rpx; }
  .today-avatar { width: 112rpx; height: 112rpx; }
  .today-greeting-copy { margin-left: 18rpx; }
  .today-greeting { font-size: 31rpx; }
  .spark-checkin { width: 134rpx; }
  .week-card { padding-right: 20rpx; padding-left: 20rpx; }
  .stats-col-label { gap: 4rpx; font-size: 18rpx; }
  .stats-col-value { font-size: 46rpx; }
  .reference-coach-copy { width: 68%; padding-left: 26rpx; }
}
