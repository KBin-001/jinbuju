<view class="page today-page" data-theme="{{appTheme}}">
  <view class="today-hero tab-header" style="height: {{headerHeight}}px;">
    <image class="today-hero__background tab-header__background" src="/assets/today-hero-mountain-v2.jpg" mode="aspectFill" />
    <view class="today-hero__veil tab-header__veil"></view>
    <view class="today-nav tab-header__nav" style="padding-top: {{menuTop}}px; height: {{menuHeight}}px;"><text class="tab-header__title">今日</text></view>
  </view>

  <view wx:if="{{status === 'ready'}}" class="today-profile-row">
    <image wx:if="{{displayAvatarUrl}}" class="today-avatar" src="{{displayAvatarUrl}}" mode="aspectFill" binderror="useDefaultAvatar" />
    <image wx:else class="today-avatar" src="/images/icons/avatar.png" mode="aspectFit" />
    <view class="today-greeting-copy"><text class="today-greeting">{{greetingText}}，{{displayName}}</text><text class="today-subtitle">{{greetingSubtitle}}</text></view>
    <view class="action-streak" aria-label="连续行动天数">
      <view class="action-streak__value">{{currentStreakDays}}<text>天</text></view>
      <view class="action-streak__label">连续行动</view>
    </view>
  </view>

  <view wx:if="{{inAppMessage}}" class="today-notification" bindtap="openInAppMessage" role="button">
    <t-notice-bar prefix-icon="notification" content="{{inAppMessage.title + ' · ' + inAppMessage.body}}" />
  </view>

  <view wx:if="{{status === 'loading'}}" class="paper-card state-card">
    <view class="loading-dot"></view>
    <view class="state-title">正在整理今日行动</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="paper-card state-card">
    <view class="state-mark">!</view>
    <view class="state-title">今日数据读取失败</view>
    <view class="state-description">{{errorMessage}}</view>
    <t-button class="primary-button" bindtap="retry">重新加载</t-button>
  </view>

  <block wx:else>
    <view class="paper-card week-card">
      <view class="week-head"><view class="week-title">{{selectedMonthDay}}</view><view class="week-switch" catchtap="openCalendar" aria-label="展开完整日历"><text>完整日历</text><text class="week-chevron">›</text></view></view>
      <view class="week-grid">
        <view
          wx:for="{{weekDays}}"
          wx:key="date"
          class="week-day {{item.isToday ? 'is-today' : ''}} {{item.isSelected ? 'is-selected' : ''}} {{item.isCurrentMonth ? '' : 'is-muted'}}"
          data-date="{{item.date}}"
          bindtap="selectWeekDate"
        >
          <view class="week-label">周{{item.label}}</view>
          <view class="week-number">{{item.day}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{!goal}}" class="paper-card empty-card">
      <view class="empty-mark">目标</view>
      <view class="state-title">先创建一个长期目标</view>
      <view class="state-description">之后每天都可以自由添加行动，不需要等待 AI 生成计划。</view>
      <t-button class="primary-button" disabled="{{navigating}}" bindtap="goCreateGoal">创建长期目标</t-button>
    </view>

    <block wx:else>
      <view class="task-section task-section--primary">
        <view class="task-section-head">
          <view>
            <view class="task-section-title">今日行动</view>
            <view class="task-section-subtitle">{{summary.totalCount ? '先完成最容易开始的一项' : '从一件今天能完成的小事开始'}}</view>
          </view>
          <view class="task-section-add" catchtap="addTask"><t-icon name="add" size="27rpx" /> 添加行动</view>
        </view>

        <view class="today-action-list">
          <view wx:if="{{tasks.length === 0}}" class="action-empty-inline">
            <view>今天还没有行动</view>
            <text>添加一件具体的小事，今天就从这里开始。</text>
            <view class="action-empty-button" catchtap="addTask" hover-class="reference-card--pressed">添加今日行动</view>
          </view>
          <view
            wx:for="{{visibleTasks}}"
            wx:key="id"
            wx:for-item="task"
            class="today-task-row {{task.status === 'completed' ? 'is-done' : ''}}"
            data-id="{{task.id}}"
            bindtap="openTask"
          >
            <view class="reference-task-icon reference-task-icon--{{task.actionIconTone}} reference-task-icon-key--{{task.actionIconKey}}"><image src="{{task.actionIconAsset}}" mode="aspectFit" /></view>
            <view class="task-copy">
              <view class="task-title-line">
                <view class="task-title">{{task.displayTitle}}</view>
                <text class="task-duration">预计 {{task.estimatedMinutes}} 分钟</text>
              </view>
              <view class="task-status-line">
                <text class="task-status task-status--{{task.statusTone}}">{{task.statusLabel}}</text>
                <text wx:if="{{task.rescheduled}}" class="task-carry-badge">顺延任务</text>
                <text wx:if="{{task.actualMinutes}}" class="task-meta-actual">实际 {{task.actualMinutes}} 分钟</text>
                <text wx:if="{{task.reminder && task.reminder.status === 'scheduled'}}" class="task-meta-actual">{{task.reminder.time}} 提醒</text>
              </view>
            </view>
            <view class="task-tail-check {{task.status === 'completed' ? 'is-done' : ''}} {{!task.canComplete ? 'is-disabled' : ''}}" data-id="{{task.id}}" catchtap="toggleTaskDone" aria-label="{{task.status === 'completed' ? '取消完成' : '标记完成'}}">
              <t-icon wx:if="{{task.status === 'completed'}}" name="check" />
            </view>
          </view>
          <view wx:if="{{hiddenActionCount > 0 || actionListExpanded}}" class="action-list-toggle" bindtap="toggleActionList">
            {{actionListExpanded ? '收起行动' : '展开剩余 ' + hiddenActionCount + ' 项'}}
          </view>
        </view>
      </view>

      <view class="stats-card" bindtap="openTodayDataDetails" hover-class="stats-card--pressed">
        <view class="stats-grid">
          <view class="stats-column stats-column--done">
            <view class="stats-label"><view class="stats-icon stats-icon--solid"><t-icon name="check" size="22rpx" /></view><text>已完成</text></view>
            <view class="stats-value stats-value--done"><text>{{summary.completedCount}}</text><text class="stats-value-slash">/</text><text>{{summary.totalCount}}</text></view>
            <view class="stats-foot stats-foot--done {{completionPercent === 100 && summary.totalCount > 0 ? 'is-complete' : ''}}">
              <view class="stats-foot-check"><t-icon name="check" size="17rpx" /></view>
              <text>{{summary.totalCount === 0 ? '等待开始' : (completionPercent === 100 ? '全部完成' : (summary.completedCount > 0 ? '稳步推进' : '尚未完成'))}}</text>
            </view>
          </view>
          <view class="stats-column stats-column--minutes">
            <view class="stats-label"><view class="stats-icon stats-icon--time"><t-icon name="time" size="27rpx" /></view><text>今日投入</text></view>
            <view class="stats-value stats-value--minutes">{{summary.actualMinutes}}<text class="stats-value-unit">分钟</text></view>
            <view class="stats-mini-bars" aria-label="今日投入时段分布">
              <view wx:for="{{statsRhythmBars}}" wx:key="key" class="stats-mini-bar {{item.active ? 'is-active' : ''}}" style="height: {{item.height}}rpx;"></view>
            </view>
          </view>
          <view class="stats-column stats-column--progress">
            <view class="stats-label"><view class="stats-icon stats-icon--flow"><view class="stats-icon-flow-line"></view></view><text>今日进度</text></view>
            <view class="stats-value stats-value--progress">{{completionPercent}}<text class="stats-value-unit stats-value-unit--percent">%</text></view>
            <view class="stats-flow-track" aria-label="今日进度 {{completionPercent}}%">
              <image class="stats-flow-image stats-flow-image--base" src="/assets/today-progress-river.svg" mode="scaleToFill" />
              <view class="stats-flow-active" style="clip-path: inset(0 {{flowRemainingPercent}}% 0 0);">
                <view class="stats-flow-canvas">
                  <image class="stats-flow-image stats-flow-image--active" src="/assets/today-progress-river.svg" mode="scaleToFill" />
                </view>
              </view>
            </view>
            <view class="stats-achievement-pill {{completionPercent === 100 && summary.totalCount > 0 ? 'is-complete' : ''}}">
              {{completionPercent === 100 && summary.totalCount > 0 ? '今日达成' : (remainingCount > 0 ? '还差 ' + remainingCount + ' 项' : '等待启程')}}
            </view>
          </view>
        </view>
      </view>

      <view class="reference-coach-entry" bindtap="openDailyCoach" hover-class="reference-card--pressed">
        <view class="reference-coach-copy">
          <view class="proactive-insight proactive-insight--{{proactiveInsight.tone}}">
            <view class="proactive-label">AI 成长教练 · 今日</view>
            <view class="proactive-title">{{coachStatus === 'loading' ? '正在结合今日行动整理下一步' : proactiveInsight.title}}</view>
            <view class="proactive-body">{{coachStatus === 'loading' ? '建议生成期间，你仍然可以照常查看和完成行动。' : proactiveInsight.body}}</view>
            <view class="coach-entry-footer"><text>{{coachStatus === 'error' ? 'AI 暂时不可用，当前展示本地建议' : '查看完整建议与对话'}}</text><t-icon name="chevron-right" size="27rpx" /></view>
          </view>
        </view>
      </view>

    </block>
  </block>

  <view wx:if="{{calendarVisible}}" class="calendar-layer" catchtouchmove="noop">
    <view class="calendar-mask" catchtap="closeCalendar"></view>
    <view class="calendar-panel" catchtap="noop">
      <view class="calendar-head">
        <view class="calendar-nav" data-delta="-1" catchtap="switchCalendarMonth">‹</view>
        <view class="calendar-title">{{calendarTitle}}</view>
        <view class="calendar-nav" data-delta="1" catchtap="switchCalendarMonth">›</view>
      </view>
      <view class="calendar-week-row">
        <view wx:for="{{calendarWeekLabels}}" wx:key="*this" class="calendar-week-label">{{item}}</view>
      </view>
      <view class="calendar-grid">
        <view
          wx:for="{{calendarDays}}"
          wx:key="date"
          class="calendar-day {{item.isCurrentMonth ? '' : 'is-outside'}} {{item.isToday ? 'is-today' : ''}} {{item.isSelected ? 'is-selected' : ''}} {{item.hasAction ? 'has-action' : ''}}"
          data-date="{{item.date}}"
          catchtap="selectCalendarDate"
        >
          <view class="calendar-day-number">{{item.day}}</view>
        </view>
      </view>
      <view class="calendar-footer">
        <view class="calendar-today" catchtap="jumpTodayFromCalendar">今天</view>
        <view class="calendar-confirm" catchtap="closeCalendar">确定</view>
      </view>
    </view>
  </view>

  <view wx:if="{{quickAddVisible}}" class="quick-add-layer" catchtouchmove="noop">
    <view class="quick-add-mask" catchtap="closeQuickAdd"></view>
    <view
      class="quick-add-panel"
      style="transform: translateY({{quickAddTouchDeltaY}}px);"
      catchtap="noop"
    >
      <view class="quick-add-grabber" bindtouchstart="quickAddTouchStart" bindtouchmove="quickAddTouchMove" bindtouchend="quickAddTouchEnd" bindtouchcancel="quickAddTouchEnd"></view>
      <view class="quick-add-header">
        <view>
          <view class="quick-add-title">添加行动</view>
        </view>
        <view class="quick-add-close {{quickAddSubmitting ? 'is-disabled' : ''}}" catchtap="closeQuickAdd" aria-label="关闭">
          <t-icon name="close" />
        </view>
      </view>
      <view class="quick-add-copy">写下一件准备推进的小事，可安排日期并设置一次微信提醒。</view>

      <view class="quick-add-field">
        <view class="quick-add-label">行动标题</view>
        <t-input
          class="quick-add-input"
          value="{{quickAddTitle}}"
          maxlength="40"
          placeholder="例如：完成 20 分钟听力精听"
          placeholder-class="quick-add-placeholder"
          confirm-type="done"
          bindchange="inputQuickAddTitle"
        />
      </view>
      <view class="quick-add-field quick-add-minutes-row">
        <view class="quick-add-label-row">
          <view class="quick-add-label">预计投入</view>
          <view class="quick-add-hint">选择一个容易开始的时长</view>
        </view>
        <view class="quick-duration-chips">
          <view wx:for="{{quickDurationPrimaryOptions}}" wx:key="value" class="quick-duration-chip {{quickAddMinuteIndex === item.sourceIndex ? 'is-selected' : ''}}" data-index="{{item.sourceIndex}}" catchtap="selectQuickDurationChip">{{item.value}} 分钟</view>
          <view class="quick-duration-chip {{quickAddMinutes !== 30 && quickAddMinutes !== 45 && quickAddMinutes !== 60 && quickAddMinutes !== 90 && quickAddMinutes !== 120 ? 'is-selected' : ''}}" catchtap="openCustomDuration">{{quickAddMinutes !== 30 && quickAddMinutes !== 45 && quickAddMinutes !== 60 && quickAddMinutes !== 90 && quickAddMinutes !== 120 ? quickAddMinutes + ' 分钟' : '更多时长'}}</view>
        </view>
      </view>

      <view class="quick-add-field">
        <view class="quick-add-label">行动日期</view>
        <picker mode="date" value="{{quickAddDate}}" start="{{todayDate}}" end="{{quickAddDateEnd}}" bindchange="changeQuickAddDate">
          <view class="quick-reminder-picker"><text>{{quickAddDate}}</text><text>选择日期</text></view>
        </picker>
      </view>

      <view class="quick-add-field quick-reminder-row">
        <view><view class="quick-add-label">提醒我</view><view class="quick-add-hint">每条微信提醒需要一次授权</view></view>
        <switch color="#245B4D" checked="{{quickAddReminderEnabled}}" bindchange="toggleQuickAddReminder" />
      </view>
      <view wx:if="{{quickAddReminderEnabled}}" class="quick-reminder-time">
        <picker mode="time" value="{{quickAddReminderTime}}" bindchange="changeQuickAddReminderTime">
          <view class="quick-reminder-picker"><text>{{quickAddReminderTime}}</text><text>5 分钟粒度</text></view>
        </picker>
        <view class="quick-reminder-note">保存时会立即弹出微信一次性订阅授权。</view>
      </view>

      <view class="quick-add-actions">
        <t-button class="quick-add-secondary" disabled="{{quickAddSubmitting}}" catchtap="closeQuickAdd">取消</t-button>
        <t-button class="quick-add-primary" loading="{{quickAddSubmitting}}" disabled="{{quickAddSubmitting || quickAddTitle.length < 2}}" catchtap="saveQuickAdd">保存行动</t-button>
      </view>
    </view>

    <view wx:if="{{quickDurationVisible}}" class="quick-duration-layer" catchtap="closeDurationPicker">
      <view class="quick-duration-panel" catchtap="noop">
        <view class="quick-duration-header">
          <t-button class="quick-duration-cancel" catchtap="closeDurationPicker">取消</t-button>
          <view class="quick-duration-title">选择预计投入</view>
          <view class="quick-duration-spacer"></view>
        </view>
        <view class="quick-duration-options">
          <view
            wx:for="{{quickDurationOptions}}"
            wx:key="value"
            class="quick-duration-option {{quickAddMinuteIndex === index ? 'is-selected' : ''}}"
            data-index="{{index}}"
            catchtap="selectQuickAddDuration"
          >
            <view class="quick-duration-option-label">{{item.label}}</view>
            <view wx:if="{{quickAddMinuteIndex === index}}" class="quick-duration-check">
              <t-icon name="check" />
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view
    wx:if="{{completionSheetRendered}}"
    class="completion-layer {{completionSheetVisible ? 'is-visible' : ''}}"
    catchtouchmove="noop"
  >
    <view class="completion-mask" catchtap="closeCompletionSheet"></view>
    <view class="completion-panel" catchtap="noop" role="dialog" aria-label="行动完成">
      <view class="completion-grabber"></view>

      <view class="completion-celebration">
        <view class="completion-badge">
          <t-icon name="check" />
        </view>
        <view class="completion-title">又完成一项行动</view>
        <view class="completion-copy">今日已完成 {{completionSheetData.done}} / {{completionSheetData.total}} 项，继续保持当前节奏。</view>
      </view>

      <view class="completion-stats">
        <view class="completion-stat-card">
          <view class="completion-stat-icon is-green">日</view>
          <view>
            <view class="completion-stat-value">{{completionSheetData.done}}/{{completionSheetData.total}}</view>
            <view class="completion-stat-label">今日完成</view>
          </view>
        </view>
        <view class="completion-stat-card">
          <view class="completion-stat-icon is-green">标</view>
          <view>
            <view class="completion-stat-value">{{completionSheetData.goalProgress}}%</view>
            <view class="completion-stat-label">目标进度</view>
          </view>
        </view>
        <view class="completion-stat-card">
          <view class="completion-stat-icon is-yellow">时</view>
          <view>
            <view class="completion-stat-value">{{completionSheetData.minutes}} 分</view>
            <view class="completion-stat-label">今日投入</view>
          </view>
        </view>
        <view class="completion-stat-card">
          <view class="completion-stat-icon is-yellow">续</view>
          <view>
            <view class="completion-stat-value">{{completionSheetData.streak}} 天</view>
            <view class="completion-stat-label">连续坚持</view>
          </view>
        </view>
      </view>

      <view class="completion-actions">
        <t-button class="completion-share-button" catchtap="generateTodayShareCard">
          <text class="completion-share-icon">↗</text>
          <text>生成今日分享卡</text>
        </t-button>
        <t-button class="completion-continue-button" catchtap="closeCompletionSheet">
          <text>继续完成</text>
          <text class="completion-arrow">→</text>
        </t-button>
      </view>
      <t-button wx:if="{{dailyActionNotificationAvailable && completionSheetData.allDone}}" class="completion-reminder-button" loading="{{notificationAuthorizing}}" disabled="{{notificationAuthorizing}}" catchtap="subscribeDailyActionReminder">提醒我明天</t-button>
    </view>
  </view>
</view>
