<view class="page today-page" data-theme="{{appTheme}}">
  <view class="today-hero">
    <image class="today-hero__background" src="/assets/today-hero-mountain-v2.jpg" mode="aspectFill" />
    <view class="today-hero__veil"></view>
    <view class="today-nav" style="padding-top: {{menuTop}}px; height: {{menuHeight}}px;"><text>今日</text></view>

    <view wx:if="{{status === 'ready'}}" class="today-profile-row">
      <image wx:if="{{displayAvatarUrl}}" class="today-avatar" src="{{displayAvatarUrl}}" mode="aspectFill" binderror="useDefaultAvatar" />
      <image wx:else class="today-avatar" src="/images/icons/avatar.png" mode="aspectFit" />
      <view class="today-greeting-copy"><text class="today-greeting">{{greetingText}}，{{displayName}}</text><text class="today-subtitle">{{greetingSubtitle}}</text></view>
      <view class="action-streak" aria-label="连续行动天数">
        <view class="action-streak__value">{{currentStreakDays}}<text>天</text></view>
        <view class="action-streak__label">连续行动</view>
      </view>
    </view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="paper-card state-card">
    <view class="loading-dot"></view>
    <view class="state-title">正在整理今日行动</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="paper-card state-card">
    <view class="state-mark">!</view>
    <view class="state-title">今日数据读取失败</view>
    <view class="state-description">{{errorMessage}}</view>
    <t-button class="primary-button" bindtap="retry">重新加载</t-button>
  </view>

  <block wx:else>
    <view class="paper-card week-card">
      <view class="week-head"><view class="week-title">{{selectedMonthDay}}</view><view class="week-switch" catchtap="openCalendar" aria-label="展开完整日历"><text>完整日历</text><text class="week-chevron">›</text></view></view>
      <view class="week-grid">
        <view
          wx:for="{{weekDays}}"
          wx:key="date"
          class="week-day {{item.isToday ? 'is-today' : ''}} {{item.isSelected ? 'is-selected' : ''}} {{item.isCurrentMonth ? '' : 'is-muted'}}"
          data-date="{{item.date}}"
          bindtap="selectWeekDate"
        >
          <view class="week-label">周{{item.label}}</view>
          <view class="week-number">{{item.day}}</view><view wx:if="{{item.isSelected}}" class="week-selected-dot"></view>
        </view>
      </view>
    </view>

    <view wx:if="{{!goal}}" class="paper-card empty-card">
      <view class="empty-mark">目标</view>
      <view class="state-title">先创建一个长期目标</view>
      <view class="state-description">之后每天都可以自由添加行动，不需要等待 AI 生成计划。</view>
      <t-button class="primary-button" disabled="{{navigating}}" bindtap="goCreateGoal">创建长期目标</t-button>
    </view>

    <block wx:else>
      <view class="stats-card" bindtap="openTodayDataDetails" hover-class="stats-card--pressed">
        <view class="stats-col">
          <view class="stats-col-label"><t-icon name="check-rectangle" size="36rpx" /><text>已完成</text></view>
          <view class="stats-col-value">{{summary.completedCount}}/{{summary.totalCount}}</view>
        </view>
        <view class="stats-col">
          <view class="stats-col-label"><t-icon name="time" size="36rpx" /><text>今日投入</text></view>
          <view class="stats-col-value">{{summary.actualMinutes}}<text class="stats-col-unit">min</text></view>
        </view>
        <view class="stats-col stats-col--progress">
          <view class="stats-col-label"><t-icon name="chart-pie" size="36rpx" /><text>今日进度</text></view>
          <view class="stats-ring-wrap">
            <canvas
              wx:if="{{!calendarVisible && !quickAddVisible && !completionSheetRendered}}"
              type="2d"
              id="stats-progress-ring"
              class="stats-ring-canvas"
            ></canvas>
            <view class="stats-ring-text">{{completionPercent}}%</view>
          </view>
        </view>
      </view>

      <view class="reference-coach-entry" bindtap="openDailyCoach" hover-class="reference-card--pressed">
        <image class="reference-coach-background" src="/assets/today-coach-watercolor-v2.jpg" mode="aspectFill" />
        <view class="reference-coach-veil"></view>
        <view class="reference-coach-copy">
          <view class="reference-coach-title">
            <view class="reference-coach-mark">✦</view>
            <text>{{coachStatus === 'ready' ? 'AI 教练' : '行动建议'}}</text>
            <text class="reference-coach-source">{{coachStatus === 'loading' ? '正在读取记录' : (coachStatus === 'ready' ? '已读取真实记录' : (coachStatus === 'error' ? 'AI 暂不可用' : '本地规则'))}}</text>
            <text class="reference-coach-arrow">›</text>
          </view>
          <view class="reference-coach-subtitle">{{coachStatus === 'loading' ? '正在根据今天的真实行动准备建议…' : (coachStatus === 'ready' ? coachSummary : dailyNudge)}}</view>
          <view wx:if="{{coachStatus === 'ready' && coachNextStep}}" class="reference-coach-next">下一步 · {{coachNextStep}}</view>
        </view>
      </view>

      <view class="task-section">
        <view class="task-section-head">
          <view class="task-section-title">今日行动</view>
          <view class="task-section-add" catchtap="addTask"><text>＋</text> 添加任务</view>
        </view>

        <view class="today-action-list">
          <view wx:if="{{tasks.length === 0}}" class="action-empty-inline">
            <view>今天还没有行动</view>
            <text>添加一件今天想推进的小事。</text>
          </view>
          <view
            wx:for="{{visibleTasks}}"
            wx:key="id"
            wx:for-item="task"
            class="today-task-row {{task.status === 'completed' ? 'is-done' : ''}}"
            data-id="{{task.id}}"
            bindtap="openTask"
          >
            <view class="reference-task-icon reference-task-icon--{{task.actionIconType}}">
              <image wx:if="{{task.actionIconType === 'book'}}" src="/assets/coach-ui/icon-book.svg" mode="aspectFit" />
              <image wx:elif="{{task.actionIconType === 'audio'}}" src="/assets/coach-ui/icon-headphone.svg" mode="aspectFit" />
              <image wx:else src="/assets/coach-ui/icon-doc.svg" mode="aspectFit" />
            </view>
            <view class="task-copy">
              <view class="task-title-line"><view class="task-title">{{task.displayTitle}}</view></view>
              <view class="task-meta"><text>预计 {{task.estimatedMinutes}} 分钟</text><text wx:if="{{task.actualMinutes}}" class="task-meta-actual">实际 {{task.actualMinutes}} 分钟</text></view>
              <view class="task-status-line"><text class="task-status task-status--{{task.statusTone}}">{{task.statusLabel}}</text><text class="task-more" data-id="{{task.id}}" catchtap="openTask">更多操作</text></view>
            </view>
            <view class="task-tail-check {{task.status === 'completed' ? 'is-done' : ''}} {{!task.canComplete ? 'is-disabled' : ''}}" data-id="{{task.id}}" catchtap="toggleTaskDone">
              <t-icon wx:if="{{task.status === 'completed'}}" name="check" />
            </view>
          </view>
          <view wx:if="{{hiddenActionCount > 0 || actionListExpanded}}" class="action-list-toggle" bindtap="toggleActionList">
            {{actionListExpanded ? '收起行动 ˄' : '展开剩余 ' + hiddenActionCount + ' 项 ˅'}}
          </view>
        </view>
      </view>
    </block>
  </block>

  <view wx:if="{{calendarVisible}}" class="calendar-layer" catchtouchmove="noop">
    <view class="calendar-mask" catchtap="closeCalendar"></view>
    <view class="calendar-panel" catchtap="noop">
      <view class="calendar-head">
        <view class="calendar-nav" data-delta="-1" catchtap="switchCalendarMonth">‹</view>
        <view class="calendar-title">{{calendarTitle}}</view>
        <view class="calendar-nav" data-delta="1" catchtap="switchCalendarMonth">›</view>
      </view>
      <view class="calendar-week-row">
        <view wx:for="{{calendarWeekLabels}}" wx:key="*this" class="calendar-week-label">{{item}}</view>
      </view>
      <view class="calendar-grid">
        <view
          wx:for="{{calendarDays}}"
          wx:key="date"
          class="calendar-day {{item.isCurrentMonth ? '' : 'is-outside'}} {{item.isToday ? 'is-today' : ''}} {{item.isSelected ? 'is-selected' : ''}} {{item.hasAction ? 'has-action' : ''}}"
          data-date="{{item.date}}"
          catchtap="selectCalendarDate"
        >
          <view class="calendar-day-number">{{item.day}}</view>
          <view wx:if="{{item.hasAction}}" class="calendar-dot {{item.isCompleted ? 'is-completed' : ''}}"></view>
        </view>
      </view>
      <view class="calendar-footer">
        <view class="calendar-today" catchtap="jumpTodayFromCalendar">今天</view>
        <view class="calendar-confirm" catchtap="closeCalendar">确定</view>
      </view>
    </view>
  </view>

  <view wx:if="{{quickAddVisible}}" class="quick-add-layer" catchtouchmove="noop">
    <view class="quick-add-mask" catchtap="closeQuickAdd"></view>
    <view
      class="quick-add-panel"
      style="transform: translateY({{quickAddTouchDeltaY}}px);"
      catchtap="noop"
      bindtouchstart="quickAddTouchStart"
      bindtouchmove="quickAddTouchMove"
      bindtouchend="quickAddTouchEnd"
      bindtouchcancel="quickAddTouchEnd"
    >
      <view class="quick-add-grabber"></view>
      <view class="quick-add-header">
        <view>
          <view class="quick-add-title">添加今日行动</view>
        </view>
        <view class="quick-add-close {{quickAddSubmitting ? 'is-disabled' : ''}}" catchtap="closeQuickAdd" aria-label="关闭">
          <t-icon name="close" />
        </view>
      </view>
      <view class="quick-add-copy">写下一件今天能推进的小事，保存后会出现在今日行动安排里。</view>

      <view class="quick-add-field">
        <view class="quick-add-label">行动标题</view>
        <t-input
          class="quick-add-input"
          value="{{quickAddTitle}}"
          maxlength="40"
          placeholder="例如：完成 20 分钟听力精听"
          placeholder-class="quick-add-placeholder"
          confirm-type="done"
          bindchange="inputQuickAddTitle"
        />
      </view>
      <view class="quick-add-field">
        <view class="quick-add-label">补充说明</view>
        <t-textarea
          class="quick-add-textarea"
          value="{{quickAddDescription}}"
          maxlength="150"
          placeholder="可选：写清楚材料、范围或完成标准"
          placeholder-class="quick-add-placeholder"
          auto-height="{{false}}"
          bindchange="inputQuickAddDescription"
        />
      </view>
      <view class="quick-add-field quick-add-minutes-row">
        <view>
          <view class="quick-add-label">预计投入</view>
          <view class="quick-add-hint">点右侧滚动选择时间</view>
        </view>
        <view class="quick-add-minutes-control" catchtap="openDurationPicker">
          <text class="quick-add-minutes-value">{{quickAddMinutes}}</text>
          <text class="quick-add-minute-unit">分钟</text>
          <view class="quick-add-picker-arrow">
            <t-icon name="chevron-down" />
          </view>
        </view>
      </view>

      <view class="quick-add-actions">
        <t-button class="quick-add-secondary" disabled="{{quickAddSubmitting}}" catchtap="closeQuickAdd">取消</t-button>
        <t-button class="quick-add-primary" loading="{{quickAddSubmitting}}" disabled="{{quickAddSubmitting}}" catchtap="saveQuickAdd">保存行动</t-button>
      </view>
    </view>

    <view wx:if="{{quickDurationVisible}}" class="quick-duration-layer" catchtap="closeDurationPicker">
      <view class="quick-duration-panel" catchtap="noop">
        <view class="quick-duration-header">
          <t-button class="quick-duration-cancel" catchtap="closeDurationPicker">取消</t-button>
          <view class="quick-duration-title">选择预计投入</view>
          <view class="quick-duration-spacer"></view>
        </view>
        <view class="quick-duration-options">
          <view
            wx:for="{{quickDurationOptions}}"
            wx:key="value"
            class="quick-duration-option {{quickAddMinuteIndex === index ? 'is-selected' : ''}}"
            data-index="{{index}}"
            catchtap="selectQuickAddDuration"
          >
            <view class="quick-duration-option-label">{{item.label}}</view>
            <view wx:if="{{quickAddMinuteIndex === index}}" class="quick-duration-check">
              <t-icon name="check" />
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view
    wx:if="{{completionSheetRendered}}"
    class="completion-layer {{completionSheetVisible ? 'is-visible' : ''}}"
    catchtouchmove="noop"
  >
    <view class="completion-mask" catchtap="closeCompletionSheet"></view>
    <view class="completion-panel" catchtap="noop" role="dialog" aria-label="行动完成">
      <view class="completion-grabber"></view>

      <view class="completion-celebration">
        <view class="completion-badge">
          <t-icon name="check" />
          <view class="completion-sparkle">✦</view>
        </view>
        <view class="completion-title">又完成一件，真棒！</view>
        <view class="completion-copy">每天完成一点，就会靠近一点。</view>
      </view>

      <view class="completion-stats">
        <view class="completion-stat-card">
          <view class="completion-stat-icon is-green">日</view>
          <view>
            <view class="completion-stat-value">{{completionSheetData.done}}/{{completionSheetData.total}}</view>
            <view class="completion-stat-label">今日完成</view>
          </view>
        </view>
        <view class="completion-stat-card">
          <view class="completion-stat-icon is-green">标</view>
          <view>
            <view class="completion-stat-value">{{completionSheetData.goalProgress}}%</view>
            <view class="completion-stat-label">目标进度</view>
          </view>
        </view>
        <view class="completion-stat-card">
          <view class="completion-stat-icon is-yellow">时</view>
          <view>
            <view class="completion-stat-value">{{completionSheetData.minutes}} 分</view>
            <view class="completion-stat-label">今日投入</view>
          </view>
        </view>
        <view class="completion-stat-card">
          <view class="completion-stat-icon is-yellow">续</view>
          <view>
            <view class="completion-stat-value">{{completionSheetData.streak}} 天</view>
            <view class="completion-stat-label">连续坚持</view>
          </view>
        </view>
      </view>

      <view class="completion-actions">
        <t-button class="completion-share-button" catchtap="generateTodayShareCard">
          <text class="completion-share-icon">↗</text>
          <text>生成今日分享卡</text>
        </t-button>
        <t-button class="completion-continue-button" catchtap="closeCompletionSheet">
          <text>继续完成</text>
          <text class="completion-arrow">→</text>
        </t-button>
      </view>
    </view>
  </view>
</view>
