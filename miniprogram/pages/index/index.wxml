<view class="page today-page">
  <view wx:if="{{status === 'loading'}}" class="card state-card">
    <view class="loading-dot"></view>
    <view class="state-title">正在整理今日行动</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="card state-card">
    <view class="state-mark">!</view>
    <view class="state-title">今日数据读取失败</view>
    <view class="state-description">{{errorMessage}}</view>
    <button class="primary-button" bindtap="retry">重新加载</button>
  </view>

  <block wx:else>
    <view class="growth-hero today-hero">
      <view class="hero-kicker">TODAY · ACTION</view>
      <view class="date-row">
        <view>
          <view class="date-title">{{dateTitle}}</view>
          <view class="weekday">{{weekday}}</view>
        </view>
        <view class="completion-ring">
          <text class="ring-value">{{summary.completedCount}}</text>
          <text class="ring-total">/{{summary.totalCount}}</text>
        </view>
      </view>
      <view class="hero-copy">{{summary.totalCount ? '按自己的节奏，推进今天真正重要的事。' : '今天先加一件想推进的小事。'}}</view>
    </view>

    <view wx:if="{{!goal}}" class="card empty-card">
      <view class="empty-mark">目标</view>
      <view class="state-title">先创建一个长期目标</view>
      <view class="state-description">之后每天都可以自由添加行动，不需要等待 AI 生成计划。</view>
      <button class="primary-button" disabled="{{navigating}}" bindtap="goCreateGoal">创建长期目标</button>
    </view>

    <block wx:else>
      <view class="card goal-card">
        <view>
          <view class="eyebrow">当前目标</view>
          <view class="goal-title">{{goal.title}}</view>
          <view wx:if="{{goal.description}}" class="goal-description">{{goal.description}}</view>
        </view>
        <view class="goal-chip">进行中</view>
      </view>

      <view class="stats-grid">
        <view class="stat-tile"><view class="stat-value">{{summary.completedCount}}</view><view class="stat-label">已完成</view></view>
        <view class="stat-tile accent"><view class="stat-value">{{summary.estimatedMinutes}}</view><view class="stat-label">预计分钟</view></view>
        <view class="stat-tile warm"><view class="stat-value">{{summary.actualMinutes}}</view><view class="stat-label">实际投入</view></view>
        <view class="stat-tile blue"><view class="stat-value">{{summary.partialCount}}</view><view class="stat-label">完成一部分</view></view>
      </view>

      <view class="action-section-header">
        <view class="action-section-left">
          <view class="section-title">行动安排</view>
          <view class="section-caption">点击卡片可调整行动状态</view>
        </view>
        <view class="action-section-right">
          <view class="add-action-button" catchtap="addTask">
            <ant-icon type="AddOutline" />
            <text>添加</text>
          </view>
          <view class="section-count">{{tasks.length}} 项</view>
        </view>
      </view>
      <view wx:if="{{taskGroups.length === 0}}" class="card empty-action-card">
        <view class="state-title">今天还没有行动</view>
        <view class="state-description">添加一件今天想推进的小事。</view>
        <ant-button type="primary" inline icon="AddOutline" className="empty-add-button" bindtap="addTask">添加今日行动</ant-button>
      </view>
      <view wx:for="{{taskGroups}}" wx:key="key" class="task-group">
        <view class="group-heading">
          <view class="group-title">{{item.title}}</view>
        </view>
        <view wx:for="{{item.tasks}}" wx:for-item="task" wx:key="id" class="action-card-tap" data-id="{{task.id}}" bindtap="openTask">
          <ant-card className="action-card {{task.status === 'completed' ? 'action-card-completed' : ''}}">
            <view class="action-card-body">
              <view class="action-main">
                <view class="action-tags">
                  <ant-tag wx:if="{{task.rescheduled}}" type="outline" color="success" className="source-tag">从之前顺延</ant-tag>
                  <ant-tag type="fill-light" color="{{task.statusTone === 'success' ? 'success' : (task.statusTone === 'warning' ? 'warning' : 'primary')}}" className="status-tag status-{{task.statusTone}}">{{task.statusLabel}}</ant-tag>
                  <ant-tag wx:if="{{task.partialHint}}" type="fill-light" color="warning" className="partial-hint">待继续</ant-tag>
                </view>
                <view class="action-title">{{task.title}}</view>
                <view wx:if="{{task.description}}" class="action-description">{{task.description}}</view>
                <view class="action-meta">
                  <view class="meta-item"><text class="meta-label">预计</text><text>{{task.estimatedMinutes}} 分钟</text></view>
                  <view wx:if="{{task.actualMinutes !== undefined}}" class="meta-item"><text class="meta-label">实际</text><text>{{task.actualMinutes}} 分钟</text></view>
                  <view class="meta-item">{{task.dateLabel}}</view>
                </view>
              </view>
              <view wx:if="{{task.status === 'completed'}}" class="action-completed-icon" aria-label="已完成">
                <ant-icon type="CheckOutline" />
              </view>
              <button wx:else class="action-complete-btn" data-id="{{task.id}}" catchtap="quickCompleteTask">
                <ant-icon type="CheckOutline" />
                <text>完成</text>
              </button>
            </view>
          </ant-card>
        </view>
      </view>
    </block>
  </block>

  <view wx:if="{{quickAddVisible}}" class="quick-add-layer" catchtouchmove="noop">
    <view class="quick-add-mask" catchtap="closeQuickAdd"></view>
    <view
      class="quick-add-panel"
      style="transform: translateY({{quickAddTouchDeltaY}}px);"
      catchtap="noop"
      bindtouchstart="quickAddTouchStart"
      bindtouchmove="quickAddTouchMove"
      bindtouchend="quickAddTouchEnd"
      bindtouchcancel="quickAddTouchEnd"
    >
      <view class="quick-add-grabber"></view>
      <view class="quick-add-header">
        <view>
          <view class="quick-add-kicker">TODAY ACTION</view>
          <view class="quick-add-title">添加今日行动</view>
        </view>
        <view class="quick-add-close {{quickAddSubmitting ? 'is-disabled' : ''}}" catchtap="closeQuickAdd" aria-label="关闭">
          <ant-icon type="CloseOutline" />
        </view>
      </view>
      <view class="quick-add-copy">写下一件今天能推进的小事，保存后会出现在今日行动安排里。</view>

      <view class="quick-add-field">
        <view class="quick-add-label">行动标题</view>
        <input
          class="quick-add-input"
          value="{{quickAddTitle}}"
          maxlength="40"
          placeholder="例如：完成 20 分钟听力精听"
          placeholder-class="quick-add-placeholder"
          confirm-type="done"
          bindinput="inputQuickAddTitle"
        />
      </view>
      <view class="quick-add-field">
        <view class="quick-add-label">补充说明</view>
        <textarea
          class="quick-add-textarea"
          value="{{quickAddDescription}}"
          maxlength="150"
          placeholder="可选：写清楚材料、范围或完成标准"
          placeholder-class="quick-add-placeholder"
          auto-height="{{false}}"
          bindinput="inputQuickAddDescription"
        />
      </view>
      <view class="quick-add-field quick-add-minutes-row">
        <view>
          <view class="quick-add-label">预计投入</view>
          <view class="quick-add-hint">点右侧滚动选择时间</view>
        </view>
        <view class="quick-add-minutes-control" catchtap="openDurationPicker">
          <text class="quick-add-minutes-value">{{quickAddMinutes}}</text>
          <text class="quick-add-minute-unit">分钟</text>
          <view class="quick-add-picker-arrow">
            <ant-icon type="DownOutline" />
          </view>
        </view>
      </view>

      <view class="quick-add-actions">
        <button class="quick-add-secondary" disabled="{{quickAddSubmitting}}" catchtap="closeQuickAdd">取消</button>
        <button class="quick-add-primary" loading="{{quickAddSubmitting}}" disabled="{{quickAddSubmitting}}" catchtap="saveQuickAdd">保存行动</button>
      </view>
    </view>

    <view wx:if="{{quickDurationVisible}}" class="quick-duration-layer" catchtap="closeDurationPicker">
      <view class="quick-duration-panel" catchtap="noop">
        <view class="quick-duration-header">
          <button class="quick-duration-cancel" catchtap="closeDurationPicker">取消</button>
          <view class="quick-duration-title">选择预计投入</view>
          <view class="quick-duration-spacer"></view>
        </view>
        <view class="quick-duration-options">
          <view
            wx:for="{{quickDurationOptions}}"
            wx:key="value"
            class="quick-duration-option {{quickAddMinuteIndex === index ? 'is-selected' : ''}}"
            data-index="{{index}}"
            catchtap="selectQuickAddDuration"
          >
            <view class="quick-duration-option-label">{{item.label}}</view>
            <view wx:if="{{quickAddMinuteIndex === index}}" class="quick-duration-check">
              <ant-icon type="CheckOutline" />
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
