<view class="page today-page {{activeSessionId ? 'today-page--timing' : ''}}" data-theme="{{appTheme}}">
  <view class="today-hero tab-header" style="height: {{headerHeight}}px;">
    <image class="today-hero__background tab-header__background" src="/assets/today-hero-mountain-v2.jpg" mode="aspectFill" />
    <view class="today-hero__veil tab-header__veil"></view>
    <view class="today-nav tab-header__nav" style="padding-top: {{menuTop}}px; height: {{menuHeight}}px;"><text class="tab-header__title">今日</text></view>
  </view>

  <view wx:if="{{status === 'ready'}}" class="today-profile-row">
    <image wx:if="{{displayAvatarUrl}}" class="today-avatar" src="{{displayAvatarUrl}}" mode="aspectFill" binderror="useDefaultAvatar" />
    <image wx:else class="today-avatar" src="/images/icons/avatar.png" mode="aspectFit" />
    <view class="today-greeting-copy"><text class="today-greeting">{{greetingText}}，行动伙伴</text><text class="today-subtitle">{{greetingSubtitle}}</text></view>
    <view class="action-streak" aria-label="连续行动天数">
      <view class="action-streak__value">{{currentStreakDays}}<text>天</text></view>
      <view class="action-streak__label">连续行动</view>
    </view>
  </view>

  <view wx:if="{{inAppMessage}}" class="today-notification" bindtap="openInAppMessage" role="button">
    <t-notice-bar prefix-icon="notification" content="{{inAppMessage.title + ' · ' + inAppMessage.body}}" />
  </view>

  <view wx:if="{{status === 'loading'}}" class="paper-card state-card">
    <view class="loading-dot"></view>
    <view class="state-title">正在整理今日行动</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="paper-card state-card">
    <view class="state-mark">!</view>
    <view class="state-title">今日数据读取失败</view>
    <view class="state-description">{{errorMessage}}</view>
    <t-button class="primary-button" bindtap="retry">重新加载</t-button>
  </view>

  <block wx:else>
    <view class="paper-card week-card">
      <view class="week-head"><view class="week-title">{{selectedMonthDay}}</view><view class="week-switch" catchtap="openCalendar" aria-label="展开完整日历"><text>完整日历</text><text class="week-chevron">›</text></view></view>
      <view class="week-grid">
        <view
          wx:for="{{weekDays}}"
          wx:key="date"
          class="week-day {{item.isToday ? 'is-today' : ''}} {{item.isSelected ? 'is-selected' : ''}} {{item.isCurrentMonth ? '' : 'is-muted'}}"
          data-date="{{item.date}}"
          bindtap="selectWeekDate"
        >
          <view class="week-label">周{{item.label}}</view>
          <view class="week-number">{{item.day}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{!goal}}" class="paper-card empty-card">
      <view class="empty-mark">目标</view>
      <view class="state-title">先创建一个长期目标</view>
      <view class="state-description">之后每天都可以自由添加行动，不需要等待 AI 生成计划。</view>
      <t-button class="primary-button" disabled="{{navigating}}" bindtap="goCreateGoal">创建长期目标</t-button>
    </view>

    <block wx:else>
      <view class="task-section task-section--primary">
        <view class="task-section-head">
          <view class="task-section-heading">
            <view class="task-section-title">今日行动</view>
            <view class="habit-recommend" catchtap="openRecommendInfo" role="button" aria-label="了解推荐机制">按习惯推荐</view>
          </view>
          <view class="task-section-tools">
            <view class="task-section-add task-section-add--icon" catchtap="addTask" role="button" aria-label="添加行动"><t-icon name="add" size="27rpx" /></view>
            <view class="execution-preference" catchtap="openExecutionPreference" role="button" aria-label="设置执行偏好">
              <t-icon name="setting" size="24rpx" />
              <text class="execution-preference__label">执行偏好</text>
            </view>
          </view>
        </view>

        <view class="action-panel">
          <today-action-list
            task-groups="{{visibleTaskGroups}}"
            tasks="{{visibleTasks}}"
            active-task-id="{{activeSessionTaskId}}"
            active-status="{{activeSessionStatus}}"
            active-minutes="{{activeSessionElapsedMinutes}}"
            bind:open="openTask"
            bind:primary="handleTaskPrimary"
            bind:menu="openTaskMenu"
          />
          <view wx:if="{{hiddenActionCount > 0 || actionListExpanded}}" class="action-list-toggle" bindtap="toggleActionList" hover-class="action-list-toggle--pressed">
            <text>{{actionListExpanded ? '收起行动' : '查看全部任务（' + tasks.length + '）'}}</text>
            <t-icon name="{{actionListExpanded ? 'chevron-up' : 'chevron-down'}}" size="28rpx" />
          </view>
        </view>
      </view>

      <daily-progress
        target-minutes="{{todayTargetMinutes}}"
        actual-minutes="{{todayActualMinutes}}"
        percent="{{todayMinuteProgress}}"
        bind:open="openTodayDataDetails"
      />

      <ai-coach-tip
        status="{{coachStatus}}"
        text="{{coachTipText}}"
        bind:open="openDailyCoach"
      />
    </block>
  </block>

  <active-timer-bar
    visible="{{!!activeSessionId}}"
    task-title="{{activeSessionOrphan ? '行动已删除' : (activeSessionTask ? activeSessionTask.displayTitle : '当前行动')}}"
    icon-asset="{{activeSessionOrphan ? '' : (activeSessionTask ? activeSessionTask.actionIconAsset : '')}}"
    status="{{activeSessionStatus}}"
    display-time="{{activeSessionDisplay}}"
    progress-percent="{{activeSessionProgress}}"
    orphan="{{activeSessionOrphan}}"
    bind:toggle="toggleActiveTimer"
    bind:finish="requestFinishTimer"
    bind:cleanup="cleanupOrphanSession"
  />

  <view wx:if="{{taskMenuVisible}}" class="task-action-sheet" catchtouchmove="noop">
    <view class="task-action-sheet__mask" catchtap="onTaskMenuClose"></view>
    <view class="task-action-sheet__panel" catchtap="noop" role="dialog" aria-label="任务操作">
      <image class="task-action-sheet__landscape" src="/assets/today-hero-mountain-v2.jpg" mode="aspectFill" aria-hidden="true" />
      <view class="task-action-sheet__grabber"></view>
      <view class="task-action-sheet__header">
        <view class="task-action-sheet__title">任务操作</view>
        <view class="task-action-sheet__subtitle">{{taskMenuSubtitle}}</view>
        <view wx:if="{{taskMenuRecommendation}}" class="task-action-sheet__recommendation">
          <t-icon class="task-action-sheet__recommendation-icon" name="highlight" size="24rpx" />
          <text>{{taskMenuRecommendation}}</text>
        </view>
      </view>
      <scroll-view class="task-action-sheet__body" scroll-y enhanced show-scrollbar="{{false}}">
        <view wx:for="{{taskMenuGroups}}" wx:key="title" class="task-action-sheet__group">
          <view class="task-action-sheet__group-title">
            <view class="task-action-sheet__group-mark" aria-hidden="true"></view>
            <text>{{item.title}}</text>
          </view>
          <view class="task-action-sheet__items">
            <view
              wx:for="{{item.items}}"
              wx:for-item="menuItem"
              wx:key="label"
              class="task-action-sheet__item {{menuItem.color === 'danger' ? 'task-action-sheet__item--danger' : ''}}"
              data-index="{{menuItem.actionIndex}}"
              catchtap="onTaskMenuItemTap"
              hover-class="task-action-sheet__item--pressed"
              role="button"
              aria-label="{{menuItem.label + '，' + menuItem.desc}}"
            >
              <view class="task-action-sheet__icon task-action-sheet__icon--{{menuItem.color || 'default'}}">
                <t-icon name="{{menuItem.icon}}" size="42rpx" />
              </view>
              <view class="task-action-sheet__copy">
                <view class="task-action-sheet__label">{{menuItem.label}}</view>
                <view class="task-action-sheet__desc">{{menuItem.desc}}</view>
              </view>
              <t-icon class="task-action-sheet__chevron" name="chevron-right" size="30rpx" />
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="task-action-sheet__footer">
        <view class="task-action-sheet__cancel" catchtap="onTaskMenuClose" hover-class="task-action-sheet__cancel--pressed">取消</view>
      </view>
    </view>
  </view>

  <view wx:if="{{calendarVisible}}" class="calendar-layer" catchtouchmove="noop">
    <view class="calendar-mask" catchtap="closeCalendar"></view>
    <view class="calendar-panel" catchtap="noop">
      <view class="calendar-head">
        <view class="calendar-nav" data-delta="-1" catchtap="switchCalendarMonth">‹</view>
        <view class="calendar-title">{{calendarTitle}}</view>
        <view class="calendar-nav" data-delta="1" catchtap="switchCalendarMonth">›</view>
      </view>
      <view class="calendar-week-row">
        <view wx:for="{{calendarWeekLabels}}" wx:key="*this" class="calendar-week-label">{{item}}</view>
      </view>
      <view class="calendar-grid">
        <view
          wx:for="{{calendarDays}}"
          wx:key="date"
          class="calendar-day {{item.isCurrentMonth ? '' : 'is-outside'}} {{item.isToday ? 'is-today' : ''}} {{item.isSelected ? 'is-selected' : ''}} {{item.hasAction ? 'has-action' : ''}}"
          data-date="{{item.date}}"
          catchtap="selectCalendarDate"
        >
          <view class="calendar-day-number">{{item.day}}</view>
        </view>
      </view>
      <view class="calendar-footer">
        <view class="calendar-today" catchtap="jumpTodayFromCalendar">今天</view>
        <view class="calendar-confirm" catchtap="closeCalendar">确定</view>
      </view>
    </view>
  </view>

  <view wx:if="{{quickAddVisible}}" class="quick-add-layer" catchtouchmove="noop">
    <view class="quick-add-mask" catchtap="closeQuickAdd"></view>
    <view
      class="quick-add-panel"
      style="transform: translateY({{quickAddTouchDeltaY}}px);"
      catchtap="noop"
      role="dialog"
      aria-label="{{quickAddMode === 'edit' ? '编辑行动' : '添加行动'}}"
    >
      <view class="quick-add-grabber" bindtouchstart="quickAddTouchStart" bindtouchmove="quickAddTouchMove" bindtouchend="quickAddTouchEnd" bindtouchcancel="quickAddTouchEnd"></view>
      <view class="quick-add-header">
        <view class="quick-add-header-spacer"></view>
        <view class="quick-add-title">{{quickAddMode === 'edit' ? '编辑行动' : '添加行动'}}</view>
        <view class="quick-add-close {{quickAddSubmitting ? 'is-disabled' : ''}}" catchtap="closeQuickAdd" aria-label="关闭">
          <t-icon name="close" size="30rpx" />
        </view>
      </view>

      <scroll-view class="quick-add-body" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="quick-title-input">
          <input
          class="quick-title-input__control"
          value="{{quickAddTitle}}"
          maxlength="40"
          placeholder="行动标题"
          placeholder-class="quick-add-placeholder"
          confirm-type="done"
          bindinput="inputQuickAddTitle"
        />
          <view class="quick-title-input__count">{{quickAddTitle.length}}/40</view>
        </view>

        <view class="quick-settings-section quick-time-section">
          <view class="quick-section-title"><view class="quick-section-mark"></view><text>预计投入</text></view>
          <view class="quick-time-card">
            <view class="quick-time-value"><text class="quick-time-number">{{quickAddMinutes}}</text><text class="quick-time-unit">分钟</text></view>
            <view class="quick-time-swipe-hint">
              <t-icon class="quick-time-swipe-icon" name="chevron-left" size="24rpx" />
              <text>左右滑动调整时间</text>
              <t-icon class="quick-time-swipe-icon" name="chevron-right" size="24rpx" />
            </view>
            <view class="quick-time-ruler-wrap">
              <view class="quick-time-center">
                <view class="quick-time-center__caret"></view>
                <view class="quick-time-center__diamond"></view>
              </view>
              <scroll-view
                class="quick-time-ruler"
                scroll-x
                enhanced
                bounces="{{false}}"
                show-scrollbar="{{false}}"
                scroll-left="{{quickDurationScrollLeft}}"
                scroll-with-animation="{{true}}"
                bindscroll="onQuickDurationScroll"
              >
                <view class="quick-time-ruler__content">
                  <view class="quick-time-ruler__spacer"></view>
                  <view
                    wx:for="{{quickDurationMarks}}"
                    wx:key="value"
                    class="quick-time-tick {{item.major ? 'is-major' : ''}} {{quickAddMinutes === item.value ? 'is-selected' : ''}}"
                  >
                    <view class="quick-time-tick__line"></view>
                    <text wx:if="{{item.label}}" class="quick-time-tick__label">{{item.label}}</text>
                  </view>
                  <view class="quick-time-ruler__spacer"></view>
                </view>
              </scroll-view>
              <view class="quick-time-ruler__fade quick-time-ruler__fade--left"></view>
              <view class="quick-time-ruler__fade quick-time-ruler__fade--right"></view>
            </view>
            <view class="quick-time-hour">约 {{quickAddHourText}} 小时</view>
          </view>
        </view>

        <view class="quick-settings-section">
          <view class="quick-section-title"><view class="quick-section-mark"></view><text>执行方式</text></view>
          <view class="quick-settings-group">
            <view class="quick-setting-row {{quickAddExecutionMode === 'direct' ? 'is-selected' : ''}}" data-mode="direct" catchtap="selectQuickExecutionMode">
              <view class="quick-setting-copy"><view class="quick-setting-label">直接完成</view><view class="quick-setting-desc">适合简单行动</view></view>
              <view class="quick-setting-check"><t-icon wx:if="{{quickAddExecutionMode === 'direct'}}" name="check" size="24rpx" /></view>
            </view>
            <view class="quick-setting-row {{quickAddExecutionMode === 'focus' ? 'is-selected' : ''}}" data-mode="focus" catchtap="selectQuickExecutionMode">
              <view class="quick-setting-copy"><view class="quick-setting-label">专注计时</view><view class="quick-setting-desc">适合需要深度投入的行动</view></view>
              <view class="quick-setting-check"><t-icon wx:if="{{quickAddExecutionMode === 'focus'}}" name="check" size="24rpx" /></view>
            </view>
            <view class="quick-setting-row {{quickAddExecutionMode === 'ask' ? 'is-selected' : ''}}" data-mode="ask" catchtap="selectQuickExecutionMode">
              <view class="quick-setting-copy"><view class="quick-setting-label">每次询问</view><view class="quick-setting-desc">开始时再选择执行方式</view></view>
              <view class="quick-setting-check"><t-icon wx:if="{{quickAddExecutionMode === 'ask'}}" name="check" size="24rpx" /></view>
            </view>
          </view>
        </view>

        <view class="quick-settings-section">
          <view class="quick-section-title"><view class="quick-section-mark"></view><text>重要程度</text></view>
          <view class="quick-settings-group">
            <view class="quick-setting-row {{quickAddImportance === 'normal' ? 'is-selected' : ''}}" data-importance="normal" catchtap="selectQuickAddImportance">
              <view class="quick-setting-copy"><view class="quick-setting-label">正常推进</view><view class="quick-setting-desc">保持稳定节奏</view></view>
              <view class="quick-setting-check"><t-icon wx:if="{{quickAddImportance === 'normal'}}" name="check" size="24rpx" /></view>
            </view>
            <view class="quick-setting-row {{quickAddImportance === 'required' ? 'is-selected' : ''}}" data-importance="required" catchtap="selectQuickAddImportance">
              <view class="quick-setting-copy"><view class="quick-setting-label">必须完成</view><view class="quick-setting-desc">优先确保完成</view></view>
              <view class="quick-setting-check"><t-icon wx:if="{{quickAddImportance === 'required'}}" name="check" size="24rpx" /></view>
            </view>
          </view>
        </view>

        <view class="quick-settings-section">
          <view class="quick-section-title"><view class="quick-section-mark"></view><text>安排</text></view>
          <view class="quick-settings-group">
            <picker class="quick-setting-picker" mode="date" value="{{quickAddDate}}" start="{{quickAddDateStart}}" end="{{quickAddDateEnd}}" bindchange="changeQuickAddDate">
              <view class="quick-setting-row quick-setting-row--picker">
                <view class="quick-setting-icon"><t-icon name="calendar" size="34rpx" /></view>
                <view class="quick-setting-label">行动日期</view>
                <view class="quick-setting-value">{{quickAddDate}}</view>
                <t-icon class="quick-setting-chevron" name="chevron-right" size="28rpx" />
              </view>
            </picker>
            <view class="quick-setting-row">
              <view class="quick-setting-icon"><t-icon name="notification" size="34rpx" /></view>
              <view class="quick-setting-copy"><view class="quick-setting-label">提醒我</view><view class="quick-setting-desc">每次提醒需要微信授权</view></view>
              <switch class="quick-setting-switch" color="#245B4D" checked="{{quickAddReminderEnabled}}" bindchange="toggleQuickAddReminder" />
            </view>
            <picker wx:if="{{quickAddReminderEnabled}}" class="quick-setting-picker" mode="time" value="{{quickAddReminderTime}}" bindchange="changeQuickAddReminderTime">
              <view class="quick-setting-row quick-setting-row--picker quick-setting-row--sub">
                <view class="quick-setting-icon"><t-icon name="time" size="32rpx" /></view>
                <view class="quick-setting-label">提醒时间</view>
                <view class="quick-setting-value">{{quickAddReminderTime}}</view>
                <t-icon class="quick-setting-chevron" name="chevron-right" size="28rpx" />
              </view>
            </picker>
            <view class="quick-setting-row">
              <view class="quick-setting-icon"><t-icon name="setting" size="34rpx" /></view>
              <view class="quick-setting-copy"><view class="quick-setting-label">阻塞其他任务</view><view class="quick-setting-desc">用于判断今日行动优先级</view></view>
              <switch class="quick-setting-switch" color="#245B4D" checked="{{quickAddBlocksOthers}}" bindchange="toggleQuickAddBlocksOthers" />
            </view>
          </view>
        </view>

        <view wx:if="{{quickAddMode === 'edit'}}" class="quick-delete-action" catchtap="deleteQuickAddTask">删除行动</view>
      </scroll-view>

      <view class="quick-add-actions">
        <t-button class="quick-add-primary" loading="{{quickAddSubmitting}}" disabled="{{quickAddSubmitting || quickAddTitle.length < 2}}" catchtap="saveQuickAdd">{{quickAddMode === 'edit' ? '保存修改' : '添加到今天'}}</t-button>
      </view>
    </view>
  </view>

  <view
    wx:if="{{completionSheetRendered}}"
    class="completion-layer {{completionSheetVisible ? 'is-visible' : ''}}"
    catchtouchmove="noop"
  >
    <view class="completion-mask" catchtap="closeCompletionSheet"></view>
    <view class="completion-panel" catchtap="noop" role="dialog" aria-label="行动完成">
      <view class="completion-grabber"></view>

      <view class="completion-celebration">
        <view class="completion-badge">
          <t-icon name="check" />
        </view>
        <view class="completion-title">又完成一项行动</view>
        <view class="completion-copy">今日已完成 {{completionSheetData.done}} / {{completionSheetData.total}} 项，继续保持当前节奏。</view>
      </view>

      <view class="completion-stats">
        <view class="completion-stat-card">
          <view class="completion-stat-icon is-green">日</view>
          <view>
            <view class="completion-stat-value">{{completionSheetData.done}}/{{completionSheetData.total}}</view>
            <view class="completion-stat-label">今日完成</view>
          </view>
        </view>
        <view class="completion-stat-card">
          <view class="completion-stat-icon is-green">标</view>
          <view>
            <view class="completion-stat-value">{{completionSheetData.goalProgress}}%</view>
            <view class="completion-stat-label">目标进度</view>
          </view>
        </view>
        <view class="completion-stat-card">
          <view class="completion-stat-icon is-yellow">时</view>
          <view>
            <view class="completion-stat-value">{{completionSheetData.minutes}} 分</view>
            <view class="completion-stat-label">今日投入</view>
          </view>
        </view>
        <view class="completion-stat-card">
          <view class="completion-stat-icon is-yellow">续</view>
          <view>
            <view class="completion-stat-value">{{completionSheetData.streak}} 天</view>
            <view class="completion-stat-label">连续坚持</view>
          </view>
        </view>
      </view>

      <view class="completion-actions">
        <t-button class="completion-share-button" catchtap="generateTodayShareCard">
          <text class="completion-share-icon">↗</text>
          <text>生成今日分享卡</text>
        </t-button>
        <t-button class="completion-continue-button" catchtap="closeCompletionSheet">
          <text>继续完成</text>
          <text class="completion-arrow">→</text>
        </t-button>
      </view>
      <t-button wx:if="{{dailyActionNotificationAvailable && completionSheetData.allDone}}" class="completion-reminder-button" loading="{{notificationAuthorizing}}" disabled="{{notificationAuthorizing}}" catchtap="subscribeDailyActionReminder">提醒我明天</t-button>
    </view>
  </view>
</view>
