.custom-tab-shell {
  position: fixed;
  z-index: 9999;
  right: 0;
  bottom: 0;
  left: 0;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(237,229,216,.82);
  background: rgba(255,253,248,.985);
  box-shadow: 0 -2rpx 10rpx rgba(61,48,28,.022);
}

.custom-tab-bar {
  height: 104rpx;
  display: flex;
  align-items: stretch;
}

.custom-tab-item {
  position: relative;
  min-width: 0;
  height: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  color: var(--color-text-secondary, #7C817D);
  transition: color 180ms ease, opacity 180ms ease, transform 180ms ease;
}

.custom-tab-item::before {
  position: absolute;
  top: 7rpx;
  left: 50%;
  width: 32rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: transparent;
  content: "";
  transform: translateX(-50%);
}

.custom-tab-item.is-pressed {
  opacity: .72;
  transform: scale(.97);
}

.custom-tab-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.custom-tab-label {
  font-family: var(--font-family-sans, -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 28rpx;
}

.custom-tab-item.is-selected {
  color: var(--color-primary, #245B4D);
}

.custom-tab-item.is-selected::before {
  background: var(--color-gold, #C89B4A);
}

.custom-tab-item.is-selected .custom-tab-label {
  font-weight: 600;
}

@media (prefers-reduced-motion: reduce) {
  .custom-tab-item {
    transition: none;
  }
}
