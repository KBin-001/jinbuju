.custom-tab-shell {
  position: fixed;
  z-index: 9999;
  left: 0;
  right: 0;
  bottom: 0;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(103, 94, 77, 0.12);
  background: rgba(255, 252, 246, 0.94);
  box-shadow: 0 -6rpx 24rpx rgba(65, 55, 38, 0.045);
  backdrop-filter: blur(24rpx) saturate(130%);
  -webkit-backdrop-filter: blur(24rpx) saturate(130%);
}
.custom-tab-bar { height: 104rpx; display: flex; align-items: center; }
.custom-tab-item { flex: 1; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5rpx; color: #829189; }
.custom-tab-icon { width: 43rpx; height: 43rpx; display: block; }
.custom-tab-label { font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 20rpx; line-height: 27rpx; font-weight: 500; }
.custom-tab-item.is-selected { color: #245b4d; }
.custom-tab-item.is-selected .custom-tab-label { font-weight: 800; }
.custom-tab-item.is-selected .custom-tab-icon { transform: translateY(-1rpx); }
