<view class="custom-tab-shell">
  <view class="custom-tab-bar">
    <view wx:for="{{items}}" wx:key="path" class="custom-tab-item {{selected === index ? 'is-selected' : ''}}" data-index="{{index}}" bindtap="switchTab">
      <image class="custom-tab-icon" src="{{selected === index ? item.activeIcon : item.icon}}" mode="aspectFit" />
      <text class="custom-tab-label">{{item.text}}</text>
    </view>
  </view>
</view>
