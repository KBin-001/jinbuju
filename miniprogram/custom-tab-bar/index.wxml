<view class="custom-tab-shell">
  <view class="custom-tab-bar" aria-role="tablist">
    <view
      wx:for="{{items}}"
      wx:key="path"
      class="custom-tab-item {{selected === index ? 'is-selected' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
      hover-class="is-pressed"
      hover-stay-time="80"
      aria-role="tab"
      aria-label="{{item.text}}"
      aria-selected="{{selected === index}}"
    >
      <image class="custom-tab-icon" src="{{selected === index ? item.activeIcon : item.icon}}" mode="aspectFit" />
      <text class="custom-tab-label">{{item.text}}</text>
    </view>
  </view>
</view>
