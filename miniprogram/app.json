    "pages/welcome/index",
    "pages/index/index",
    "pages/plan/index",
    "pages/team/index",
    "pages/profile/index"
  ],
  "subpackages": [
    { "root": "pages/goal-create", "pages": ["index"] },
    { "root": "pages/action-edit", "pages": ["index"] },
    { "root": "pages/action-records", "pages": ["index"] },
    { "root": "pages/growth-records", "pages": ["index"] },
    { "root": "pages/goal-generate", "pages": ["index"] },
    { "root": "pages/plan-preview", "pages": ["index"] },
    { "root": "pages/stage-review", "pages": ["index"] },
    { "root": "pages/daily-coach", "pages": ["index"] },
    { "root": "pages/today-data", "pages": ["index"] },
    { "root": "pages/share-card", "pages": ["index"] },
    { "root": "pages/checkin", "pages": ["index"] },
    { "root": "pages/team-invite", "pages": ["index"] },
    { "root": "pages/team-members", "pages": ["index"] },
    { "root": "pages/team-activity", "pages": ["index"] },
    { "root": "pages/account-security", "pages": ["index"] },
    { "root": "pages/data-sync", "pages": ["index"] },
    { "root": "pages/privacy-center", "pages": ["index"] },
    { "root": "pages/achievements", "pages": ["index"] },
    { "root": "pages/ai-coach", "pages": ["index"] },
    { "root": "pages/goal-manage", "pages": ["index"] },
    { "root": "pages/history", "pages": ["index"] },
    { "root": "pages/goal-detail", "pages": ["index"] },
    { "root": "pages/goal-review", "pages": ["index"] },
    { "root": "pages/legal/privacy", "pages": ["index"] },
    { "root": "pages/legal/terms", "pages": ["index"] },
    { "root": "pages/data-management", "pages": ["index"] },
    { "root": "pages/about", "pages": ["index"] }
  ],
  "preloadRule": {
    "pages/welcome/index": {
      "network": "all",
      "packages": ["pages/legal/privacy", "pages/legal/terms"]
    },
    "pages/index/index": {
      "network": "all",
      "packages": [
        "pages/action-edit",
        "pages/checkin",
        "pages/daily-coach",
        "pages/ai-coach",
        "pages/today-data",
        "pages/goal-create"
      ]
    },
    "pages/plan/index": {
      "network": "all",
      "packages": [
        "pages/action-edit",
        "pages/ai-coach",
        "pages/growth-records",
        "pages/goal-detail",
        "pages/goal-create",
        "pages/goal-generate",
        "pages/plan-preview",
        "pages/stage-review",
        "pages/today-data"
      ]
    },
    "pages/team/index": {
      "network": "all",
      "packages": ["pages/team-members", "pages/team-activity", "pages/team-invite"]
    },
    "pages/profile/index": {
      "network": "all",
      "packages": [
        "pages/goal-manage",
        "pages/growth-records",
        "pages/history",
        "pages/achievements",
        "pages/account-security",
        "pages/privacy-center",
        "pages/data-sync",
        "pages/data-management",
        "pages/about"
      ]
    }
  },
  "window": {
    "backgroundColor": "#F7F3EA",
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#F7F3EA",
    "navigationBarTitleText": "今日成长-目标打卡",
    "navigationBarTextStyle": "black"
  },
  "lazyCodeLoading": "requiredComponents",
  "usingComponents": {
    "t-button": "tdesign-miniprogram/button/button",
    "t-checkbox": "tdesign-miniprogram/checkbox/checkbox",
    "t-checkbox-group": "tdesign-miniprogram/checkbox-group/checkbox-group",
    "t-icon": "tdesign-miniprogram/icon/icon",
    "t-input": "tdesign-miniprogram/input/input",
    "t-loading": "tdesign-miniprogram/loading/loading",
    "t-notice-bar": "tdesign-miniprogram/notice-bar/notice-bar",
    "t-popup": "tdesign-miniprogram/popup/popup",
    "t-progress": "tdesign-miniprogram/progress/progress",
    "coach-chat": "/components/coach-chat/index",
    "t-radio": "tdesign-miniprogram/radio/radio",
    "t-radio-group": "tdesign-miniprogram/radio-group/radio-group",
    "t-switch": "tdesign-miniprogram/switch/switch",
    "t-textarea": "tdesign-miniprogram/textarea/textarea"
  },
  "tabBar": {
    "custom": true,
    "color": "#7F9D91",
    "selectedColor": "#245B4D",
    "backgroundColor": "#FFFCF6",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "今日",
        "iconPath": "images/icons/tab-today.png",
        "selectedIconPath": "images/icons/tab-today-active.png"
      },
      {
        "pagePath": "pages/plan/index",
        "text": "进度",
        "iconPath": "images/icons/tab-progress.png",
        "selectedIconPath": "images/icons/tab-progress-active.png"
      },
      {
        "pagePath": "pages/team/index",
        "text": "小队",
        "iconPath": "images/icons/tab-team.png",
        "selectedIconPath": "images/icons/tab-team-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "images/icons/tab-profile.png",
        "selectedIconPath": "images/icons/tab-profile-active.png"
      }
    ]
  },
  "sitemapLocation": "sitemap.json",
  "style": "v2"
}
