:host { display: block; margin-top: 10rpx; }
.goal-overview { position: relative; min-height: 270rpx; padding: 20rpx 78rpx 15rpx 32rpx; overflow: hidden; border: 2rpx solid rgba(200,155,74,.42); border-radius: 24rpx; background: var(--progress-surface,#fffdf8); box-shadow: 0 9rpx 26rpx rgba(79,61,31,.065), inset 0 0 0 5rpx rgba(255,252,246,.84); font-family: var(--font-family-sans); }
.goal-overview__image { position: absolute; width: 78%; height: 100%; right: 45rpx; bottom: 0; opacity: .53; filter: saturate(.55) contrast(.92) brightness(1.08); }
.goal-overview__wash { position: absolute; inset: 0 45rpx 0 0; background: linear-gradient(90deg, rgba(255,253,248,.98) 0%, rgba(255,253,248,.93) 38%, rgba(255,253,248,.42) 72%, rgba(255,253,248,.12) 100%); pointer-events: none; }
.goal-overview__gold-rail { position: absolute; width: 47rpx; top: 0; right: 0; bottom: 0; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 31rpx; border-left: 1rpx solid rgba(200,155,74,.20); background: linear-gradient(180deg, rgba(232,197,123,.28), rgba(200,155,74,.72)); box-shadow: inset 5rpx 0 14rpx rgba(255,249,229,.44); }
.goal-overview__flag { display: flex; align-items: center; justify-content: center; color: #fffdf8; filter: drop-shadow(0 2rpx 3rpx rgba(119,78,18,.16)); }
.goal-overview__content { position: relative; z-index: 2; min-width: 0; }
.goal-overview__top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.goal-overview__eyebrow { min-height: 38rpx; padding: 2rpx 13rpx; display: flex; align-items: center; border: 1rpx solid rgba(36,91,77,.14); border-radius: 8rpx; color: var(--progress-primary,#17614f); background: rgba(255,253,248,.58); font-size: 20rpx; font-weight: 500; line-height: 28rpx; }
.goal-overview__switch { min-height: 38rpx; display: flex; align-items: center; color: var(--progress-primary,#17614f); font-size: 21rpx; font-weight: 600; white-space: nowrap; transition: opacity 180ms ease, transform 180ms ease; }
.goal-overview__title { margin-top: 4rpx; display: -webkit-box; overflow: hidden; color: var(--progress-primary,#17614f); font-family: var(--font-family-brand); font-size: 44rpx; font-weight: 500; line-height: 50rpx; letter-spacing: 2rpx; -webkit-box-orient: vertical; -webkit-line-clamp: 1; }
.goal-overview__period { margin-top: 3rpx; overflow: hidden; color: #707874; font-size: 21rpx; line-height: 29rpx; text-overflow: ellipsis; white-space: nowrap; }
.goal-stage { margin-top: 12rpx; }
.goal-stage__labels { display: flex; justify-content: space-between; color: #5f6d67; font-size: 19rpx; font-weight: 500; }
.goal-stage__track { position: relative; height: 22rpx; margin: 7rpx 8rpx 0; }
.goal-stage__track::before { position: absolute; height: 1rpx; top: 10rpx; right: 0; left: 0; background: #ded3bd; content: ""; }
.goal-stage__fill { position: absolute; height: 2rpx; top: 9rpx; left: 0; max-width: 100%; background: var(--progress-primary,#17614f); }
.goal-stage__node,.goal-stage__current { position: absolute; box-sizing: border-box; width: 13rpx; height: 13rpx; top: 4rpx; border: 2rpx solid #d8c9aa; border-radius: 50%; background: #fffaf1; transform: translateX(-50%); }
.goal-stage__node.is-start { left: 0; }.goal-stage__node.is-mid-one { left: 34%; }.goal-stage__node.is-mid-two { left: 67%; }.goal-stage__node.is-end { left: 100%; }
.goal-stage__current { z-index: 2; width: 19rpx; height: 19rpx; top: 1rpx; border: 3rpx solid #edf3ef; background: var(--progress-primary,#17614f); box-shadow: 0 0 0 1rpx rgba(23,97,79,.12); }
.goal-stage__caption { margin-top: 3rpx; color: var(--progress-muted,#7c827d); font-size: 20rpx; font-weight: 400; line-height: 26rpx; }
.tap-pressed { opacity: .72; transform: scale(.98); }
@media (max-width: 350px) { .goal-overview { min-height: 270rpx; padding-right: 66rpx; padding-left: 24rpx; }.goal-overview__gold-rail { width: 41rpx; }.goal-overview__title { font-size: 38rpx; }.goal-overview__eyebrow { font-size: 18rpx; }.goal-overview__period { font-size: 18rpx; }.goal-stage { margin-top: 14rpx; }.goal-stage__caption { font-size: 18rpx; } }
