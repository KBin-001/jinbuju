:host { display: block; margin-top: -2rpx; }
.goal-overview { position: relative; min-height: 350rpx; padding: 8rpx 14rpx 4rpx; overflow: hidden; border: 0; border-radius: 0; background: transparent; box-shadow: none; font-family: var(--font-family-sans); }
.goal-overview__content { position: relative; z-index: 2; min-width: 0; }
.goal-overview__top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.goal-overview__eyebrow { min-height: 38rpx; display: flex; align-items: center; color: #6f6045; font-family: var(--font-family-brand); font-size: var(--font-meta); font-weight: 500; line-height: var(--line-height-meta); letter-spacing: 2rpx; }
.goal-overview__switch { min-height: 42rpx; display: flex; align-items: center; color: var(--progress-primary,#17614f); font-size: var(--font-body); line-height: var(--line-height-body); font-weight: 600; white-space: nowrap; transition: opacity 180ms ease, transform 180ms ease; }
.goal-overview__title { margin-top: 7rpx; display: -webkit-box; overflow: hidden; color: #1f2824; font-family: var(--font-family-brand); font-size: var(--font-brand-display); font-weight: 500; line-height: 1.2; letter-spacing: 4rpx; -webkit-box-orient: vertical; -webkit-line-clamp: 1; }
.goal-overview__period { margin-top: 5rpx; overflow: hidden; color: #6f746f; font-size: var(--font-meta); line-height: var(--line-height-meta); text-overflow: ellipsis; white-space: nowrap; }
.goal-stage { margin-top: 6rpx; }
.goal-stage__track { position: relative; height: 112rpx; margin: 0 9rpx; overflow: visible; }
.goal-stage__canvas { position: absolute; width: 100%; height: 100%; inset: 0; }
.goal-stage__label { position: absolute; z-index: 2; overflow: hidden; color: #786f5e; font-family: var(--font-family-brand); font-size: var(--font-tag); font-weight: 500; line-height: var(--line-height-tag); text-align: center; white-space: nowrap; }
.goal-stage__label.is-start { bottom: 42rpx; left: 0; color: #245b4d; text-align: left; }
.goal-stage__label.is-mid-one { bottom: 47rpx; left: 33.333%; transform: translateX(-50%); }
.goal-stage__label.is-mid-two { bottom: 63rpx; left: 66.667%; transform: translateX(-50%); }
.goal-stage__label.is-end { right: 3rpx; bottom: 98rpx; color: #8d682d; text-align: right; }
.goal-stage__flag { position: absolute; z-index: 3; right: -2rpx; bottom: 75rpx; display: flex; }
.goal-stage__meta { margin-top: -2rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.goal-stage__invested { color: #51645c; font-size: var(--font-meta); font-weight: 500; line-height: var(--line-height-meta); }
.goal-stage__caption { overflow: hidden; color: #727974; font-size: var(--font-meta); font-weight: 400; line-height: var(--line-height-meta); text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.tap-pressed { opacity: .72; transform: scale(.98); }
@media (max-width: 350px) { .goal-overview { min-height: 338rpx; padding-right: 6rpx; padding-left: 6rpx; }.goal-overview__title { font-size: var(--font-page-title-compact); }.goal-overview__eyebrow { font-size: var(--font-meta-compact); }.goal-overview__period { font-size: var(--font-meta-compact); }.goal-stage__label { font-size: var(--font-tag-compact); }.goal-stage__caption,.goal-stage__invested { font-size: var(--font-meta-compact); } }
