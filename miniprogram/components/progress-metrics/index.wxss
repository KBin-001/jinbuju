:host { display: block; margin-top: 24rpx; }
.metrics-card { min-height: 166rpx; padding: 26rpx 12rpx 24rpx; display: flex; align-items: stretch; border: 1rpx solid var(--progress-border,#ede5d8); border-radius: var(--progress-radius,28rpx); background: var(--progress-surface,#fffdf8); box-shadow: var(--progress-shadow,0 10rpx 30rpx rgba(61,48,28,.045)); font-family: var(--font-family-sans); }
.metric-item { position: relative; min-width: 0; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.metric-item + .metric-item { border-left: 1rpx solid rgba(124,130,125,.095); }
.metric-item + .metric-item::before { position: absolute; width: 6rpx; height: 6rpx; top: 50%; left: -3rpx; border-radius: 50%; background: var(--progress-gold,#c5963e); content: ""; transform: translateY(-50%); }
.metric-main { min-width: 0; width: 100%; display: flex; align-items: baseline; justify-content: center; gap: 11rpx; }
.metric-icon { display: flex; flex: 0 0 auto; color: var(--progress-primary,#17614f); transform: translateY(2rpx); }
.metric-value { min-width: 0; display: flex; align-items: baseline; justify-content: center; color: var(--progress-primary,#17614f); font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; line-height: 1; white-space: nowrap; }
.metric-number { font-size: 52rpx; font-weight: 600; letter-spacing: -.4rpx; }
.metric-value.is-long .metric-number { font-size: 45rpx; }
.metric-unit { margin-left: 6rpx; color: #66716c; font-family: -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size: 22rpx; font-weight: 400; }
.metric-label { margin-top: 13rpx; color: var(--progress-muted,#7c827d); font-size: 23rpx; font-weight: 400; line-height: 31rpx; }
@media (max-width: 350px) { .metrics-card { min-height: 164rpx; padding-right: 4rpx; padding-left: 4rpx; }.metric-main { gap: 5rpx; }.metric-number { font-size: 47rpx; }.metric-value.is-long .metric-number { font-size: 40rpx; }.metric-unit { margin-left: 3rpx; font-size: 18rpx; }.metric-label { font-size: 20rpx; } }
