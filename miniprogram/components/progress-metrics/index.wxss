:host { display: block; margin-top: 18rpx; }
.metrics-card { min-height: 124rpx; padding: 17rpx 12rpx 16rpx; display: flex; align-items: stretch; border: 1rpx solid rgba(36,91,77,.07); border-radius: var(--progress-radius,28rpx); background: rgba(255,253,248,.96); box-shadow: var(--progress-shadow,0 10rpx 30rpx rgba(61,48,28,.045)); font-family: var(--font-family-sans); }
.metric-item { position: relative; min-width: 0; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.metric-item + .metric-item { border-left: 1rpx solid rgba(124,130,125,.095); }
.metric-item + .metric-item::before { position: absolute; width: 6rpx; height: 6rpx; top: 50%; left: -3rpx; border-radius: 50%; background: var(--progress-gold,#c5963e); content: ""; transform: translateY(-50%); }
.metric-main { min-width: 0; width: 100%; display: flex; align-items: baseline; justify-content: center; gap: 11rpx; }
.metric-icon { display: flex; flex: 0 0 auto; color: var(--progress-primary,#17614f); transform: translateY(1rpx); }
.metric-value { min-width: 0; display: flex; align-items: baseline; justify-content: center; color: var(--progress-primary,#17614f); font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; line-height: 1; white-space: nowrap; }
.metric-number { font-size: 45rpx; font-weight: 600; letter-spacing: -.4rpx; }
.metric-value.is-long .metric-number { font-size: 39rpx; }
.metric-unit { margin-left: 5rpx; color: #66716c; font-family: var(--font-family-sans); font-size: 19rpx; font-weight: 400; }
.metric-label { margin-top: 9rpx; color: var(--progress-muted,#7c827d); font-size: 20rpx; font-weight: 400; line-height: 28rpx; }
@media (max-width: 350px) { .metrics-card { min-height: 124rpx; padding-right: 4rpx; padding-left: 4rpx; }.metric-main { gap: 4rpx; }.metric-number { font-size: 40rpx; }.metric-value.is-long .metric-number { font-size: 35rpx; }.metric-unit { margin-left: 2rpx; font-size: 16rpx; }.metric-label { font-size: 18rpx; } }
