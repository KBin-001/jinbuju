:host { display: block; margin-top: 2rpx; }
.metrics-card { padding: 25rpx 8rpx 8rpx; border-top: 1rpx solid rgba(108,103,91,.16); border-right: 0; border-bottom: 1rpx solid rgba(108,103,91,.13); border-left: 0; border-radius: 0; background: transparent; box-shadow: none; font-family: var(--font-family-sans); }
.metrics-grid { min-height: 136rpx; display: flex; align-items: stretch; }
.metric-item { position: relative; min-width: 0; padding: 0 18rpx; flex: 1; }
.metric-item:first-child { padding-left: 6rpx; }
.metric-item:last-child { padding-right: 6rpx; }
.metric-item + .metric-item { border-left: 1rpx solid rgba(112,112,104,.18); }
.metric-heading { min-width: 0; display: flex; align-items: center; gap: 9rpx; color: #a97829; font-size: var(--font-tag); line-height: var(--line-height-tag); white-space: nowrap; }
.metric-heading text { overflow: hidden; color: #646c68; text-overflow: ellipsis; }
.metric-value { min-width: 0; margin-top: 17rpx; display: flex; align-items: baseline; color: var(--progress-primary,#17614f); font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; line-height: 1; white-space: nowrap; }
.metric-number { font-size: var(--font-data); line-height: var(--line-height-data); font-weight: 600; letter-spacing: -.6rpx; }
.metric-value.is-long .metric-number { font-size: var(--font-data-compact); }
.metric-unit { margin-left: 7rpx; color: #52615b; font-family: var(--font-family-sans); font-size: var(--font-meta); line-height: var(--line-height-meta); font-weight: 400; }
.metric-meta { margin-top: 12rpx; overflow: hidden; color: #747c77; font-size: var(--font-meta); line-height: var(--line-height-meta); text-overflow: ellipsis; white-space: nowrap; }
.metrics-history { min-height: 46rpx; margin-top: -2rpx; display: flex; align-items: center; justify-content: flex-end; color: #95681f; font-size: var(--font-body); line-height: var(--line-height-body); font-weight: 500; }
.tap-pressed { opacity: .65; }
@media (max-width: 350px) {
  .metrics-card { padding-right: 16rpx; padding-left: 16rpx; }
  .metric-item { padding-right: 10rpx; padding-left: 10rpx; }
  .metric-heading { gap: 5rpx; font-size: var(--font-tag-compact); }
  .metric-number { font-size: var(--font-data-compact); }
  .metric-value.is-long .metric-number { font-size: var(--font-data-compact); }
  .metric-unit { font-size: var(--font-meta-compact); }
  .metric-meta { font-size: var(--font-meta-compact); }
}
