:host { display: block; }
.timer-bar { position: fixed; z-index: 9998; right: 32rpx; bottom: calc(122rpx + env(safe-area-inset-bottom)); left: 32rpx; min-height: 100rpx; padding: 13rpx 18rpx; display: flex; align-items: center; gap: 14rpx; box-sizing: border-box; border: 1rpx solid rgba(200,155,74,.32); border-radius: 25rpx; background: rgba(255,252,246,.98); box-shadow: 0 10rpx 28rpx rgba(67,57,42,.11); }
.timer-bar__identity { width: 190rpx; min-width: 190rpx; max-width: 190rpx; flex: none; display: flex; align-items: center; gap: 10rpx; }
.timer-bar__icon { position: relative; width: 54rpx; height: 54rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: #eaf1ed; }
.timer-bar__icon::after { position: absolute; top: -3rpx; right: -3rpx; width: 10rpx; height: 10rpx; border: 2rpx solid #fffdf8; border-radius: 50%; background: #c89b4a; content: ""; }
.timer-bar__icon-image { width: 36rpx; height: 36rpx; }
.timer-bar__title { min-width: 0; max-width: 126rpx; flex: 1; overflow: hidden; color: #283a34; font-size: 22rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.timer-bar__clock { width: 84rpx; flex: none; color: #245b4d; font-family: Georgia, "Songti SC", serif; font-size: 28rpx; font-variant-numeric: tabular-nums; line-height: 40rpx; text-align: center; }
.timer-bar__track { width: 58rpx; height: 7rpx; flex: none; overflow: hidden; border-radius: 999rpx; background: #e8e2d7; }
.timer-bar__fill { height: 100%; border-radius: inherit; background: #31705e; }
.timer-bar__action { min-width: 0; height: 62rpx; margin: 0; padding: 0 3rpx; box-sizing: border-box; flex: none; display: flex; align-items: center; justify-content: center; gap: 2rpx; border: 0; color: #245b4d; background: transparent; font-size: 18rpx; line-height: 62rpx; white-space: nowrap; }
.timer-bar__action--pressed { opacity: .68; }
.timer-bar__action--toggle { width: 82rpx; }
.timer-bar__action--finish { width: 114rpx; color: #3e4c47; }
.timer-bar--orphan { border-color: rgba(193, 96, 76, .3); }
.timer-bar--orphan .timer-bar__icon { background: #f6e8e4; }
.timer-bar--orphan .timer-bar__icon::after { display: none; }
.timer-bar--orphan .timer-bar__title { color: #8a4a3e; }
.timer-bar--orphan .timer-bar__clock { color: #6b3a30; }
.timer-bar__action--cleanup { width: 140rpx; color: #b54a38; }
@media (max-width: 350px) {
  .timer-bar {
    right: 22rpx;
    left: 22rpx;
    min-height: 100rpx;
    padding: 12rpx 14rpx;
    gap: 7rpx;
  }
  .timer-bar__identity { width: 210rpx; min-width: 210rpx; max-width: 210rpx; flex: none; gap: 7rpx; }
  .timer-bar__icon { width: 42rpx; height: 42rpx; border-radius: 14rpx; }
  .timer-bar__icon-image { width: 29rpx; height: 29rpx; }
  .timer-bar__title { min-width: 0; max-width: 152rpx; flex: 1; font-size: 17rpx; }
  .timer-bar__clock { width: 84rpx; font-size: 23rpx; line-height: 34rpx; text-align: center; }
  .timer-bar__track { display: none; }
  .timer-bar__action { height: 52rpx; padding: 0; gap: 1rpx; font-size: 15rpx; line-height: 52rpx; }
  .timer-bar__action--toggle { width: 82rpx; }
  .timer-bar__action--finish { width: 118rpx; }
  .timer-bar__action--cleanup { width: 144rpx; }
}
