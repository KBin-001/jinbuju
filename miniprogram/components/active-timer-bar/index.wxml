<view wx:if="{{visible}}" class="timer-bar {{orphan ? 'timer-bar--orphan' : ''}}" role="region" aria-label="{{taskTitle + '计时状态'}}" catchtap="openSession" hover-class="timer-bar--pressed">
  <block wx:if="{{!orphan}}">
    <view class="timer-bar__dot {{status === 'paused' ? 'is-paused' : ''}}"></view>
    <text class="timer-bar__status">{{status === 'paused' ? '已暂停' : '专注中'}}</text>
    <text class="timer-bar__separator">·</text>
    <text class="timer-bar__title">{{taskTitle}}</text>
    <text class="timer-bar__separator">·</text>
    <text class="timer-bar__clock">{{displayTime}}</text>
    <t-icon class="timer-bar__chevron" name="chevron-right" size="30rpx" />
    <view class="timer-bar__a11y-controls" aria-hidden="true"><text>暂停</text><text>继续</text><text>结束计时</text></view>
  </block>
  <block wx:else>
    <t-icon name="error-circle" size="30rpx" />
    <text class="timer-bar__orphan-copy">关联行动已删除</text>
    <view class="timer-bar__cleanup" role="button" catchtap="cleanupOrphan">结束并清理</view>
  </block>
</view>
