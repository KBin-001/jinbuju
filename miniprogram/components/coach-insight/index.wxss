:host { display: block; margin-top: 28rpx; }
.coach-insight { position: relative; min-height: 428rpx; overflow: hidden; border: 1rpx solid rgba(197,150,62,.13); border-radius: var(--progress-radius,28rpx); background: #fffdf8; box-shadow: 0 8rpx 26rpx rgba(61,48,28,.035); font-family: var(--font-family-sans); }
.coach-backdrop { position: absolute; z-index: 0; width: 73%; height: 100%; top: 0; right: 0; opacity: .30; pointer-events: none; }
.coach-content { position: relative; z-index: 1; padding: 32rpx 30rpx 0; }
.coach-head { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.coach-title { display: flex; align-items: center; gap: 12rpx; color: #153f34; font-family: var(--font-family-brand); font-size: var(--font-section-title); font-weight: 550; line-height: var(--line-height-section-title); letter-spacing: 2rpx; }
.coach-seal { width: auto; height: 31rpx; }
.coach-analysis { min-height: 54rpx; display: flex; align-items: center; color: var(--progress-primary,#17614f); font-size: var(--font-meta); font-weight: 500; line-height: var(--line-height-meta); white-space: nowrap; }
.coach-memo { margin-top: 25rpx; display: grid; grid-template-columns: 11rpx minmax(0,1fr); gap: 25rpx; }
.coach-memo__rail { width: 8rpx; height: 230rpx; margin-top: 3rpx; opacity: .72; }
.coach-memo__body { min-width: 0; }
.coach-section { display: flex; flex-direction: column; }
.coach-section--advice { margin-top: 27rpx; }
.coach-section__label { color: #a77724; font-family: var(--font-family-brand); font-size: var(--font-tag); font-weight: 550; line-height: var(--line-height-tag); letter-spacing: 2rpx; }
.coach-conclusion { margin-top: 8rpx; display: -webkit-box; overflow: hidden; color: #17483b; font-family: var(--font-family-brand); font-size: var(--font-card-title); font-weight: 500; line-height: var(--line-height-card-title); letter-spacing: 1rpx; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.coach-evidence { margin-top: 7rpx; display: -webkit-box; overflow: hidden; color: #737976; font-size: var(--font-caption); line-height: var(--line-height-caption); -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.coach-advice { margin-top: 7rpx; display: -webkit-box; overflow: hidden; color: #263c35; font-family: var(--font-family-brand); font-size: var(--font-body-strong); font-weight: 500; line-height: var(--line-height-body-strong); -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.coach-footer { min-height: 82rpx; margin-top: 24rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; border-top: 1rpx solid rgba(167,119,36,.28); transition: opacity 180ms ease, transform 180ms ease; }
.coach-action__link { min-height: 60rpx; display: flex; align-items: center; color: var(--progress-primary,#17614f); font-size: var(--font-body); font-weight: 600; line-height: var(--line-height-body); white-space: nowrap; }
.coach-duration { display: flex; align-items: center; gap: 10rpx; color: #858b87; font-size: var(--font-meta); line-height: var(--line-height-meta); }
.tap-pressed { opacity: .62; }
.coach-action--pressed { opacity: .72; transform: scale(.99); }
@media (max-width: 350px) {
  .coach-content { padding-right: 24rpx; padding-left: 24rpx; }
  .coach-title { font-size: var(--font-section-title-compact); }
  .coach-conclusion { font-size: var(--font-card-title-compact); }
  .coach-advice { font-size: var(--font-body-compact); }
  .coach-action__link { font-size: var(--font-meta-compact); }
}
