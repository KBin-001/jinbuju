.record-layer {
  position: fixed;
  z-index: 12000;
  inset: 0;
}

.record-mask {
  position: absolute;
  inset: 0;
  background: var(--color-mask, rgba(25, 35, 31, .46));
  -webkit-backdrop-filter: blur(5rpx);
  backdrop-filter: blur(5rpx);
}

.record-panel {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: min(86vh, 1280rpx);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  border-radius: var(--radius-sheet, 32rpx) var(--radius-sheet, 32rpx) 0 0;
  background: var(--color-bg-card, #FFFCF6);
  box-shadow: var(--shadow-float, 0 18rpx 48rpx rgba(36, 70, 59, .14));
  animation: record-enter 220ms cubic-bezier(.22, .78, .24, 1);
}

.record-panel::before {
  position: absolute;
  z-index: 0;
  top: 0;
  right: 0;
  width: 420rpx;
  height: 300rpx;
  background: url('/assets/profile/goal-mountain-v2.jpg') center/cover no-repeat;
  content: "";
  opacity: .09;
  pointer-events: none;
}

.record-grabber {
  position: absolute;
  z-index: 3;
  top: 16rpx;
  left: 50%;
  width: 64rpx;
  height: 7rpx;
  border-radius: 999rpx;
  background: #D4D0C6;
  transform: translateX(-50%);
}

.record-scroll {
  position: relative;
  z-index: 2;
  min-height: 0;
  flex: 1;
  box-sizing: border-box;
}

.record-head {
  position: relative;
  z-index: 2;
  min-height: 132rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 44rpx 40rpx 8rpx;
}

.record-eyebrow {
  color: var(--color-primary-light, #7F9D91);
  font-size: var(--font-meta);
  font-weight: 650;
  letter-spacing: 2rpx;
}

.record-title {
  margin-top: 6rpx;
  color: var(--color-text-main, #24312D);
  font-size: var(--font-card-title);
  font-weight: 700;
  line-height: var(--line-height-card-title);
}

.record-close {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-bg-soft, #F1F4EE);
  color: var(--color-text-body, #4F615B);
  transition: opacity 180ms ease, transform 180ms ease;
}

.record-field {
  margin: 24rpx 40rpx 0;
}

.record-label {
  margin-bottom: 12rpx;
  color: var(--color-text-body, #4F615B);
  font-size: var(--font-body-strong);
  font-weight: 550;
  line-height: var(--line-height-body-strong);
}

.record-input-shell,
.record-date-shell {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-border, rgba(36, 91, 77, .12));
  border-radius: var(--radius-input, 20rpx);
  background: rgba(255, 252, 246, .88);
  color: var(--color-primary, #245B4D);
}

.record-title-input,
.record-minutes-input {
  min-width: 0;
  height: 88rpx;
  flex: 1;
  color: var(--color-text-main, #24312D);
  font-size: var(--font-body);
}

.record-date-shell {
  gap: 16rpx;
}

.record-date-picker {
  min-width: 0;
  flex: 1;
  color: var(--color-text-body, #4F615B);
  font-size: var(--font-body);
}

.record-time-picker {
  color: var(--color-text-body, #4F615B);
  font-size: var(--font-body);
}

.record-minutes-shell {
  gap: 18rpx;
}

.record-minutes-input {
  flex: 1;
}

.record-minutes-unit {
  color: var(--color-text-secondary, #7C817D);
  font-size: var(--font-meta);
}

.record-segments {
  min-height: 80rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 6rpx;
  border: 1rpx solid var(--color-border, rgba(36, 91, 77, .12));
  border-radius: var(--radius-input, 20rpx);
  background: var(--color-bg-soft, #F1F4EE);
}

.record-segment {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border-radius: 15rpx;
  color: var(--color-text-secondary, #7C817D);
  font-size: var(--font-meta);
  transition: background-color 180ms ease, color 180ms ease, opacity 180ms ease;
}

.record-segment.is-active {
  background: var(--color-primary, #245B4D);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(36, 91, 77, .13);
}

.record-reflection-shell {
  position: relative;
  height: 186rpx;
  padding: 18rpx 22rpx 38rpx;
  border: 1rpx solid var(--color-border, rgba(36, 91, 77, .12));
  border-radius: var(--radius-input, 20rpx);
  background: rgba(255, 252, 246, .88);
}

.record-reflection-input {
  width: 100%;
  height: 126rpx;
  color: var(--color-text-main, #24312D);
  font-size: var(--font-body);
  line-height: var(--line-height-body);
}

.record-reflection-counter {
  position: absolute;
  right: 18rpx;
  bottom: 10rpx;
  color: var(--color-text-light, #9B9F9B);
  font-size: var(--font-meta);
}

.record-ai-note {
  margin: 28rpx 40rpx 0;
  padding: 20rpx 22rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  border: 1rpx solid rgba(36, 91, 77, .10);
  border-radius: var(--radius-card-small, 18rpx);
  background: var(--gradient-card-soft, linear-gradient(135deg, #F1F4EE, #FFFCF6));
}

.record-ai-mark {
  width: 48rpx;
  height: 48rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: var(--color-primary-light, #7F9D91);
  color: #FFFFFF;
  font-size: var(--font-meta);
  font-weight: 700;
}

.record-ai-title {
  color: var(--color-primary-dark, #183F35);
  font-size: var(--font-meta);
  font-weight: 650;
}

.record-ai-copy {
  margin-top: 5rpx;
  color: var(--color-text-secondary, #7C817D);
  font-size: var(--font-caption);
  line-height: var(--line-height-caption);
}

.record-scroll-spacer {
  height: 28rpx;
}

.record-footer {
  position: relative;
  z-index: 3;
  flex: none;
  padding: 16rpx 40rpx calc(14rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-divider, rgba(36, 91, 77, .08));
  background: rgba(255, 252, 246, .98);
}

.record-save {
  height: 88rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 0;
  border-radius: 999rpx;
  background: var(--color-primary, #245B4D);
  color: #FFFFFF;
  font-size: var(--font-body);
  font-weight: 650;
  line-height: var(--line-height-body);
  box-shadow: var(--shadow-button, 0 8rpx 18rpx rgba(36, 91, 77, .14));
  transition: opacity 180ms ease, transform 180ms ease;
}

.record-save::after {
  border: 0;
}

.record-save.is-disabled {
  background: #B9C7C0;
  box-shadow: none;
  opacity: .66;
}

.record-delete {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-danger, #B86152);
  font-size: var(--font-meta);
  line-height: var(--line-height-meta);
  text-align: center;
  transition: opacity 180ms ease;
}

.record-close.is-pressed,
.record-segment.is-pressed,
.record-save.is-pressed,
.record-delete.is-pressed {
  opacity: .72;
}

.record-close.is-pressed,
.record-save.is-pressed {
  transform: scale(.985);
}

.record-delete.is-disabled {
  opacity: .45;
}

@keyframes record-enter {
  from { opacity: .7; transform: translateY(100%); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 350px) {
  .record-panel { height: 89vh; }
  .record-head { padding-right: 28rpx; padding-left: 28rpx; }
  .record-title { font-size: var(--font-card-title-compact); }
  .record-field,
  .record-ai-note { margin-right: 28rpx; margin-left: 28rpx; }
  .record-footer { padding-right: 28rpx; padding-left: 28rpx; }
  .record-label { font-size: var(--font-body-compact); }
}

@media (prefers-reduced-motion: reduce) {
  .record-panel,
  .record-close,
  .record-segment,
  .record-save,
  .record-delete {
    transition: none;
    animation: none;
  }
}
