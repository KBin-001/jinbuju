:host { display: block; }
.daily-progress { position: relative; min-height: 118rpx; margin-top: 22rpx; padding: 23rpx 28rpx 24rpx; border: 1rpx solid rgba(105,96,78,.1); border-radius: 26rpx; color: #59635e; background: rgba(255,253,248,.98); box-shadow: 0 8rpx 24rpx rgba(75,62,40,.045); box-sizing: border-box; transition: opacity 160ms ease-out, transform 160ms ease-out; }
.daily-progress--pressed { opacity: .76; transform: scale(.995); }
.daily-progress__labels { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; color: #555f5a; font-size: 20rpx; line-height: 29rpx; }
.daily-progress__label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.daily-progress__meter { margin-top: 18rpx; display: flex; align-items: center; gap: 22rpx; }
.daily-progress__track { height: 13rpx; flex: 1; overflow: hidden; border-radius: 999rpx; background: #e8e4dc; }
.daily-progress__fill { height: 100%; min-width: 0; border-radius: inherit; background: #1d755a; transition: width .2s ease; }
.daily-progress__percent { width: 82rpx; flex: none; color: #a36f25; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 34rpx; font-weight: 500; line-height: 36rpx; text-align: right; }

@media (prefers-reduced-motion: reduce) {
  .daily-progress,
  .daily-progress__fill {
    transition: none;
  }
}
