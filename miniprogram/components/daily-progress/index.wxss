:host { display: block; }
.daily-progress {
  min-height: 132rpx;
  margin-top: 20rpx;
  padding: 24rpx 18rpx 25rpx;
  border-top: 1rpx solid rgba(30, 40, 35, .07);
  border-bottom: 1rpx solid rgba(30, 40, 35, .07);
  color: #686e68;
  background: rgba(255, 253, 249, .64);
  box-sizing: border-box;
  transition: opacity 160ms ease-out;
}
.daily-progress--pressed { opacity: .72; }
.daily-progress__labels {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: #696e69;
  font-size: var(--font-meta);
  line-height: var(--line-height-meta);
}
.daily-progress__label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.daily-progress__meter {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.daily-progress__track {
  height: 8rpx;
  flex: 1;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e4e5e1;
}
.daily-progress__fill {
  height: 100%;
  border-radius: inherit;
  background: #0d7057;
  transition: width 180ms ease-out;
}
.daily-progress__percent {
  width: 84rpx;
  flex: none;
  color: #b07c18;
  font-family: var(--font-family-numeric);
  font-size: var(--font-body-strong);
  font-weight: 500;
  line-height: var(--line-height-body-strong);
  text-align: right;
  font-variant-numeric: tabular-nums;
}
@media (prefers-reduced-motion: reduce) {
  .daily-progress,
  .daily-progress__fill { transition: none; }
}

/* Shared progress labels use the same data and metadata roles everywhere. */
.daily-progress__label { font-size: var(--font-meta); line-height: var(--line-height-meta); }
.daily-progress__percent { font-size: var(--font-body-strong); line-height: var(--line-height-body-strong); }

@media (max-width: 350px) {
  .daily-progress__label { font-size: var(--font-meta-compact); line-height: var(--line-height-meta); }
  .daily-progress__percent { font-size: var(--font-body-compact); line-height: var(--line-height-body); }
}
