:host { display: block; }
.daily-progress { position: relative; margin-top: 20rpx; padding: 18rpx 26rpx 20rpx; border: 1rpx solid rgba(105,96,78,.1); border-radius: 24rpx; color: #626965; background: rgba(255,253,248,.96); box-shadow: 0 6rpx 20rpx rgba(75,62,40,.035); transition: opacity 160ms ease-out, transform 160ms ease-out; }
.daily-progress--pressed { opacity: .76; transform: scale(.995); }
.daily-progress__labels { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; font-size: 20rpx; line-height: 29rpx; }
.daily-progress__label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.daily-progress__meter { margin-top: 14rpx; display: flex; align-items: center; gap: 20rpx; }
.daily-progress__track { height: 12rpx; flex: 1; overflow: hidden; border-radius: 999rpx; background: #e9e4db; }
.daily-progress__fill { height: 100%; min-width: 0; border-radius: inherit; background: #1d755a; transition: width .2s ease; }
.daily-progress__percent { width: 76rpx; flex: none; color: #245b4d; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 29rpx; font-weight: 600; line-height: 34rpx; text-align: right; }

@media (prefers-reduced-motion: reduce) {
  .daily-progress,
  .daily-progress__fill {
    transition: none;
  }
}
