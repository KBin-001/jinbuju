<view class="daily-progress" bindtap="openDetails" hover-class="daily-progress--pressed" aria-label="今日目标 {{targetMinutes}} 分钟，已投入 {{actualMinutes}} 分钟，完成 {{percent}}%">
  <view class="daily-progress__labels">
    <text class="daily-progress__label">{{targetMinutes > 0 ? '今日目标 ' + targetMinutes + '分钟' : '今日目标 待安排'}}</text>
    <text class="daily-progress__label">已投入 {{actualMinutes}}分钟</text>
  </view>
  <view class="daily-progress__track">
    <view class="daily-progress__fill" style="width: {{percent}}%;"></view>
  </view>
  <view class="daily-progress__percent">{{percent}}%</view>
</view>
