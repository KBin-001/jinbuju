<view class="action-list">
  <view wx:if="{{!tasks.length}}" class="action-empty">
    <t-icon name="calendar-edit" size="42rpx" />
    <view class="action-empty__title">今天还没有行动</view>
    <view class="action-empty__copy">添加一件具体的小事，今天就从这里开始。</view>
  </view>

  <view
    wx:for="{{renderGroups}}"
    wx:for-item="group"
    wx:key="key"
    class="action-group action-group--{{group.tone}}"
  >
    <view class="action-group__body">
      <view class="action-group__head">
        <view class="action-group__rail">
          <t-icon class="action-group__icon action-group__icon--{{group.tone}}" name="{{group.icon}}" size="32rpx" />
        </view>
        <view class="action-group__title">
          <text>{{group.title}}</text>
          <text class="action-group__count">{{group.count}}</text>
        </view>
        <view wx:if="{{group.hint}}" class="action-group__hint">{{group.hint}}</view>
      </view>

      <view class="action-group__tasks">
        <view
          wx:for="{{group.tasks}}"
          wx:for-item="item"
          wx:key="id"
          class="action-row {{item.status === 'completed' ? 'is-completed' : ''}} {{item.showProgress || activeTaskId === item.id ? 'is-active' : ''}} {{activeTaskId === item.id && activeStatus === 'paused' ? 'is-paused' : ''}}"
          data-id="{{item.id}}"
          bindtap="openTask"
          hover-class="action-row--pressed"
          aria-label="{{item.displayTitle + '，' + item.actionTimeText}}"
        >
          <view class="action-copy">
            <view class="action-title">{{item.displayTitle}}</view>
            <view class="action-meta"><text>{{item.actionMetaText}}</text><text wx:if="{{item.rescheduled}}" class="carry-badge">顺延任务</text></view>
            <view wx:if="{{item.priorityReasons.length}}" class="priority-reasons" aria-hidden="true">
              <text wx:for="{{item.priorityReasons}}" wx:for-item="reason" wx:key="key" class="reason-tag">{{reason.label}}</text>
            </view>
          </view>

          <view
            class="action-button action-button--{{item.actionButtonTone}} {{item.primaryAction === 'complete' && !item.canComplete ? 'is-disabled' : ''}}"
            data-id="{{item.id}}"
            catchtap="primaryAction"
            hover-class="action-button--pressed"
            role="button"
            aria-label="{{item.primaryActionLabel + item.displayTitle}}"
            aria-disabled="{{item.primaryAction === 'complete' && !item.canComplete}}"
          >
            <text>{{item.actionButtonLabel}}</text>
            <t-icon wx:if="{{item.status === 'completed'}}" name="check" size="24rpx" />
            <text class="action-mark__label">{{item.primaryActionShortLabel || item.primaryActionLabel || '开始'}}</text>
          </view>
          <view class="action-mark action-mark--{{item.primaryActionTone}}" aria-hidden="true">
            <view class="action-mark__disc"><t-icon name="{{item.primaryActionIcon || 'play-circle'}}" size="24rpx" /></view>
          </view>

          <view
            class="task-more"
            data-id="{{item.id}}"
            catchtap="openMenu"
            hover-class="task-more--pressed"
            role="button"
            aria-label="{{item.displayTitle + '更多操作'}}"
          >
            <t-icon name="ellipsis" size="30rpx" />
          </view>
          <view wx:if="{{item.showProgress}}" class="action-progress"><view class="action-progress__fill" style="width: {{item.progressPercent}}%;"></view></view>
        </view>
      </view>
    </view>
  </view>
</view>
