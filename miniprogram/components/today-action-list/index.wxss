:host { display: block; }

.action-list { padding: 0; }
.action-group { position: relative; }
.action-group + .action-group { margin-top: 8rpx; }

.action-group__head {
  min-height: 70rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid rgba(30, 40, 35, .08);
}
.action-group__rail,
.action-group__hint { display: none; }
.action-group__title {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 22rpx;
  color: #202521;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 40rpx;
}
.action-group__title::before {
  width: 10rpx;
  height: 34rpx;
  border-radius: 5rpx;
  background: #0d7057;
  content: "";
}
.action-group--muted .action-group__title::before { background: #999b98; }
.action-group__count {
  color: #747974;
  font-family: var(--font-family-numeric);
  font-size: 21rpx;
  font-weight: 400;
  font-variant-numeric: tabular-nums;
}

.action-group__tasks { background: transparent; }
.action-row {
  position: relative;
  min-height: 110rpx;
  padding: 22rpx 6rpx 22rpx 14rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid rgba(30, 40, 35, .075);
  box-sizing: border-box;
  transition: opacity 160ms ease-out, background 160ms ease-out;
}
.action-row--pressed { opacity: .72; }
.action-row.is-active {
  min-height: 124rpx;
  padding-top: 24rpx;
  padding-bottom: 30rpx;
  background: rgba(235, 242, 238, .52);
}
.action-row.is-completed { opacity: 1; }

.action-copy { min-width: 0; flex: 1; }
.action-title {
  overflow: hidden;
  color: #181a18;
  font-size: 27rpx;
  font-weight: 520;
  line-height: 39rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.action-row.is-active .action-title { color: #181a18; font-size: 27rpx; }
.action-meta {
  min-width: 0;
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  overflow: hidden;
  color: #737871;
  font-family: var(--font-family-numeric);
  font-size: 20rpx;
  line-height: 29rpx;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.carry-badge {
  padding: 0 8rpx;
  border: 1rpx solid rgba(182, 133, 36, .2);
  border-radius: 999rpx;
  color: #98702f;
  background: rgba(251, 245, 232, .72);
  font-size: 15rpx;
  line-height: 24rpx;
}
.priority-reasons,
.reason-tag { display: none; }

.action-button {
  min-width: 88rpx;
  height: 50rpx;
  padding: 0 18rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  border: 1.5rpx solid var(--color-primary, #0d7057);
  border-radius: 999rpx;
  color: #0b624e;
  background: transparent;
  box-sizing: border-box;
  font-size: 22rpx;
  font-weight: 520;
  line-height: 48rpx;
  transition: opacity 160ms ease-out, transform 160ms ease-out;
}
.action-button--continue {
  border-color: #0d7057;
  color: #fff;
  background: #0d7057;
}
.action-button--done {
  border-color: transparent;
  color: #315d52;
  background: #e8f1ed;
}
.action-button--complete {
  border-color: rgba(13, 112, 87, .32);
  color: #315d52;
  background: rgba(235, 242, 238, .6);
}
.action-button.is-disabled { opacity: .38; }
.action-button--pressed { opacity: .72; transform: scale(.96); }
.action-mark__label,
.action-primary-icon { display: none; }

.task-more {
  width: 52rpx;
  height: 58rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #777c77;
}
.task-more--pressed { background: rgba(13, 112, 87, .06); }

.action-progress {
  position: absolute;
  right: 150rpx;
  bottom: 16rpx;
  left: 14rpx;
  height: 6rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e1e8e4;
}
.action-progress__fill {
  height: 100%;
  border-radius: inherit;
  background: #0d7057;
  transition: width 180ms ease-out;
}

.action-empty {
  padding: 58rpx 28rpx;
  color: #6f756f;
  text-align: center;
}
.action-empty__title { margin-top: 12rpx; color: #1f4f43; font-size: 28rpx; font-weight: 550; }
.action-empty__copy { margin-top: 8rpx; color: #858984; font-size: 20rpx; line-height: 31rpx; }

/* 保留旧契约选择器，实际界面已改为右侧状态按钮。 */
.action-mark { width: 132rpx; height: 54rpx; display: none; }
.action-mark__disc { width: 132rpx; height: 54rpx; }

@media (max-width: 350px) {
  .action-row { padding-left: 8rpx; gap: 10rpx; }
  .action-title { font-size: 24rpx; }
  .action-meta { font-size: 17rpx; }
  .action-button { min-width: 76rpx; height: 46rpx; padding: 0 14rpx; font-size: 19rpx; }
  .task-more { width: 40rpx; }
  .action-progress { right: 128rpx; left: 8rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .action-row,
  .action-button,
  .action-progress__fill { transition: none; }
}
