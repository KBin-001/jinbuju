:host {
  display: block;
}

.action-list {
  padding: 22rpx 24rpx 22rpx;
}

.action-group {
  position: relative;
}

.action-group + .action-group {
  margin-top: 27rpx;
}

.action-group__body {
  min-width: 0;
  flex: 1;
}

.action-group__head {
  min-height: 48rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.action-group__rail {
  width: 38rpx;
  height: 42rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-group__title {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 0;
  color: #17644f;
  font-family: var(--font-family-brand);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
  letter-spacing: 1rpx;
}

.action-group--gold .action-group__title {
  color: #17644f;
}

.action-group__icon--gold {
  color: #dd9013;
}

.action-group__icon--green {
  color: #167a5d;
}

.action-group__icon--muted {
  color: #aaa79f;
}

.action-group__hint {
  flex: none;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
  color: #6d746f;
  background: #f2f1ec;
  font-size: 17rpx;
  line-height: 25rpx;
  white-space: nowrap;
}

.action-group--gold .action-group__hint {
  border-color: rgba(200,155,74,.2);
  color: #9a6b27;
  background: #fbf3e4;
}

.action-group--green .action-group__hint {
  border-color: rgba(73,123,104,.16);
  color: #3f6f60;
  background: #edf5f0;
}

.action-group--muted .action-group__hint {
  border-color: rgba(113,119,114,.14);
  color: #707772;
  background: #f0f1ed;
}

.action-group__tasks {
  margin-top: 11rpx;
  overflow: hidden;
  border: 1rpx solid rgba(105,96,78,.09);
  border-radius: 26rpx;
  background: #fffdfa;
  box-shadow: 0 5rpx 16rpx rgba(75,62,40,.035);
}

.action-row {
  min-height: 118rpx;
  padding: 18rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
  transition: opacity 160ms ease-out, transform 160ms ease-out, background 160ms ease-out;
}

.action-row + .action-row {
  border-top: 1rpx solid rgba(105,96,78,.07);
}

.action-row--pressed {
  opacity: .78;
  transform: scale(.995);
  background: rgba(36,91,77,.035);
}

.action-row.is-completed {
  background: rgba(244,248,244,.72);
}

.action-icon {
  width: 68rpx;
  height: 68rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  background: #edf2ef;
}

.action-icon__image {
  width: 38rpx;
  height: 38rpx;
  display: block;
}

.action-icon--blue { background: #edf3f4; }
.action-icon--gold { background: #f7f0e3; }
.action-icon--orange { background: #f8eee7; }
.action-icon--purple { background: #f0edf2; }

.action-copy {
  min-width: 0;
  flex: 1;
}

.action-title {
  overflow: hidden;
  color: #17644f;
  font-family: var(--font-family-brand);
  font-size: 29rpx;
  font-weight: 600;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-meta {
  min-width: 0;
  margin-top: 5rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  overflow: hidden;
  color: #6f7773;
  font-size: 20rpx;
  line-height: 29rpx;
  white-space: nowrap;
}

.carry-badge {
  padding: 0 8rpx;
  border: 1rpx solid rgba(200,155,74,.2);
  border-radius: 999rpx;
  color: #98702f;
  background: #fbf5e8;
  font-size: 15rpx;
  line-height: 24rpx;
}

.reason-tag {
  padding: 2rpx 10rpx;
  border: 1rpx solid rgba(200,155,74,.2);
  border-radius: 999rpx;
  color: #9a7030;
  background: rgba(247,239,228,.7);
  font-size: 16rpx;
  line-height: 24rpx;
  white-space: nowrap;
}

.action-control {
  width: 132rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-mark {
  width: 132rpx;
  height: 54rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary, #245b4d);
  box-sizing: border-box;
  transition: transform 160ms ease-out, opacity 160ms ease-out;
}

.action-mark__disc {
  position: relative;
  width: 132rpx;
  height: 54rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  border: 1rpx solid rgba(36,91,77,.2);
  border-radius: 28rpx;
  color: var(--color-primary, #245b4d);
  background: rgba(248,251,248,.9);
  box-shadow: 0 4rpx 12rpx rgba(45,78,67,.04);
  box-sizing: border-box;
}

.action-mark__label {
  display: block;
  overflow: hidden;
  color: currentColor;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 27rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-mark__label--numeric {
  font-family: var(--font-family-numeric, "DIN Alternate", "Avenir Next", sans-serif);
  font-variant-numeric: tabular-nums;
}

.action-mark--plain .action-mark__disc {
  border-color: rgba(143,154,149,.28);
  color: var(--color-secondary, #7f9d91);
  background: #f3f6f2;
  box-shadow: none;
}

.action-mark--success {
  color: var(--color-success, #39745f);
}

.action-mark--success .action-mark__disc {
  border-color: rgba(57,116,95,.2);
  color: var(--color-success, #39745f);
  background: #eaf3ee;
}

.action-mark--active .action-mark__disc {
  border-color: var(--color-primary, #245b4d);
  color: #fff;
  background: var(--color-primary, #245b4d);
  box-shadow: 0 6rpx 16rpx rgba(36,91,77,.18);
}

.action-mark--disabled {
  color: var(--color-disabled-text, #8f9a95);
}

.action-mark--disabled .action-mark__disc {
  border-style: dashed;
  border-color: rgba(143,154,149,.5);
  color: var(--color-disabled-text, #8f9a95);
  background: #eef0ed;
}

.action-mark__recommendation {
  position: absolute;
  top: -3rpx;
  right: -3rpx;
  width: 9rpx;
  height: 9rpx;
  border: 3rpx solid #fffcf6;
  border-radius: 50%;
  background: var(--color-gold, #c89b4a);
  box-sizing: content-box;
}

.action-mark--pressed {
  opacity: .78;
  transform: scale(.96);
}

.task-more {
  width: 42rpx;
  height: 58rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: 16rpx;
}

.task-more__dot {
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: #9a9b96;
}

.task-more--pressed {
  background: rgba(36,91,77,.08);
}

.action-empty {
  padding: 42rpx 28rpx;
  color: #60736b;
  text-align: center;
}

.action-empty__title {
  margin-top: 12rpx;
  color: #234b40;
  font-family: var(--font-family-brand);
  font-size: 27rpx;
  font-weight: var(--font-weight-title);
}

.action-empty__copy {
  margin-top: 7rpx;
  color: #817e77;
  font-size: 20rpx;
  line-height: 30rpx;
}

@media (max-width: 350px) {
  .action-list { padding-right: 18rpx; padding-left: 18rpx; }
  .action-group + .action-group { margin-top: 20rpx; }
  .action-group__hint { padding-right: 10rpx; padding-left: 10rpx; font-size: 15rpx; }
  .action-row { gap: 12rpx; padding-right: 12rpx; padding-left: 12rpx; }
  .action-icon { width: 56rpx; height: 56rpx; border-radius: 16rpx; }
  .action-icon__image { width: 35rpx; height: 35rpx; }
  .action-title { font-size: 25rpx; }
  .action-meta { font-size: 17rpx; }
  .action-control, .action-mark, .action-mark__disc { width: 128rpx; }
  .action-mark__disc { padding-right: 12rpx; padding-left: 12rpx; }
  .task-more { width: 22rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .action-row,
  .action-mark {
    transition: none;
  }
}
