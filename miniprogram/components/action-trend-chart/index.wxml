<view class="trend-card">
  <view class="trend-head">
    <view>
      <view class="trend-title-row"><view class="trend-title">行动趋势</view><image class="trend-title-seal" src="/assets/today-action-seal-v1.png" mode="heightFix" aria-hidden="true" /></view>
      <view class="trend-period">{{periodLabel}}</view>
    </view>
    <view class="trend-tabs" role="tablist">
      <view wx:for="{{ranges}}" wx:key="key" class="trend-tab {{item.active ? 'is-active' : ''}}" data-key="{{item.key}}" bindtap="changeRange">{{item.label}}</view>
    </view>
  </view>

  <view wx:if="{{summary.insufficient}}" class="trend-empty">
    <t-icon name="chart-line" size="48rpx" color="#7F9D91" />
    <view class="trend-empty__title">还没有可分析的行动节奏</view>
    <view class="trend-empty__description">{{summary.summaryText}}</view>
    <view class="trend-empty__action" bindtap="handleEmptyAction">{{hasAnyTask ? '去今日页开始行动' : '添加今日行动'}}</view>
  </view>
  <block wx:else>
    <view class="chart-toolbar">
      <view class="chart-legend">
        <view class="legend-item"><view class="legend-line is-minutes"></view><text>投入时间（分钟）</text></view>
        <view wx:if="{{completionEnabled}}" class="legend-item"><view class="legend-line is-actions"><view class="legend-dot"></view></view><text>完成行动（项）</text></view>
      </view>
      <view class="trend-activity">{{summary.activityLabel}}</view>
    </view>
    <view class="chart-shell" bindtap="selectPoint">
      <view class="axis-unit">分钟</view>
      <view class="axis-labels axis-left"><text wx:for="{{chart.axisLabels}}" wx:key="*this">{{item}}</text></view>
      <canvas canvas-id="trendCanvas" class="trend-canvas"></canvas>
      <view wx:if="{{completionEnabled}}" class="axis-labels axis-right"><text>{{chart.maxActions}}</text><text>{{chart.midActions}}</text><text>{{chart.lowActions}}</text><text>0</text></view>
    </view>
    <view class="chart-labels">
      <view wx:for="{{chart.bars}}" wx:key="key" class="chart-label {{item.isToday ? 'is-today' : ''}} {{item.isFuture ? 'is-future' : ''}}">
        <text class="chart-label__day">{{item.isToday ? '今天' : item.label}}</text><text class="chart-label__date">{{item.subLabel || item.label}}</text>
      </view>
    </view>
  </block>
</view>
