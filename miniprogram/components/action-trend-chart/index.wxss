:host { display: block; margin-top: 0; }
.trend-card { padding: 32rpx 8rpx 8rpx; border: 0; border-radius: 0; background: transparent; box-shadow: none; font-family: var(--font-family-sans); }
.trend-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.trend-title-row { display: flex; align-items: center; gap: 11rpx; }
.trend-title { color: var(--progress-primary,#17614f); font-family: var(--font-family-brand); font-size: var(--font-section-title); font-weight: 550; line-height: var(--line-height-section-title); letter-spacing: 3rpx; }
.trend-title-seal { width: auto; height: 31rpx; display: block; }
.trend-period { margin-top: 7rpx; color: #7b817d; font-size: var(--font-meta); line-height: var(--line-height-meta); }
.trend-tabs { height: 58rpx; padding: 4rpx; display: flex; border-radius: 29rpx; background: #f1eee7; }
.trend-tab { min-width: 54rpx; height: 50rpx; display: flex; align-items: center; justify-content: center; border-radius: 25rpx; color: #707772; font-size: var(--font-tag); line-height: var(--line-height-tag); }
.trend-tab.is-active { color: #fff; background: var(--progress-primary,#17614f); box-shadow: 0 2rpx 5rpx rgba(23,97,79,.10); }
.chart-toolbar { margin-top: 27rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.chart-legend { min-width: 0; display: flex; align-items: center; gap: 30rpx; color: #68736e; font-size: var(--font-meta); line-height: var(--line-height-meta); }
.legend-item { display: flex; align-items: center; gap: 9rpx; }
.legend-line { width: 29rpx; height: 4rpx; border-radius: 3rpx; background: var(--progress-primary,#17614f); }
.legend-line.is-actions { position: relative; height: 2rpx; background: #c79a3b; }
.legend-dot { position: absolute; box-sizing: border-box; width: 10rpx; height: 10rpx; top: -4rpx; left: 10rpx; border: 3rpx solid #c79a3b; border-radius: 50%; background: #fffdf8; }
.trend-activity { min-height: 46rpx; padding: 5rpx 17rpx; flex: none; display: flex; align-items: center; border: 1rpx solid rgba(98,103,94,.24); border-radius: 24rpx; color: #315f51; background: rgba(255,253,248,.42); font-size: var(--font-tag); line-height: var(--line-height-tag); white-space: nowrap; }
.chart-shell { position: relative; height: 340rpx; margin-top: 15rpx; padding: 0 50rpx; overflow: hidden; }
.trend-canvas { position: absolute; z-index: 1; width: auto; height: auto; top: 0; right: 50rpx; bottom: 0; left: 50rpx; }
.axis-unit { position: absolute; z-index: 2; top: 0; left: 0; color: #8a8f8b; font-size: var(--font-meta); line-height: var(--line-height-meta); pointer-events: none; }
.axis-labels { position: absolute; z-index: 2; width: 46rpx; top: 32rpx; bottom: 28rpx; display: flex; flex-direction: column; justify-content: space-between; color: #878d89; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: var(--font-meta); font-weight: 400; line-height: var(--line-height-meta); pointer-events: none; }
.axis-left { left: 0; align-items: flex-start; }.axis-right { right: 0; align-items: flex-end; }
.axis-right { top: 32rpx; bottom: 28rpx; }
.chart-labels { margin: 5rpx 44rpx 0; padding-bottom: 4rpx; display: flex; }
.chart-label { min-width: 0; flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4rpx; color: #7e8580; font-family: var(--font-family-sans); font-size: var(--font-meta); font-weight: 400; line-height: var(--line-height-meta); }
.chart-label__day { color: #66716c; }
.chart-label.is-future,.chart-label.is-future .chart-label__day { color: #a8ada9; }
.chart-label.is-today { color: #165b49; }
.chart-label.is-today .chart-label__date,.chart-label.is-today .chart-label__day { color: var(--progress-primary,#17614f); font-weight: 600; }
.trend-empty { min-height: 360rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.trend-empty__title { margin-top: 18rpx; color: #24332e; font-size: var(--font-card-title); line-height: var(--line-height-card-title); font-weight: 600; }
.trend-empty__description { max-width: 470rpx; margin-top: 9rpx; color: #7b817d; font-size: var(--font-caption); line-height: var(--line-height-caption); }
.trend-empty__action { min-height: 64rpx; margin-top: 20rpx; padding: 0 24rpx; display: flex; align-items: center; border: 1rpx solid rgba(22,91,73,.16); border-radius: 18rpx; color: #165b49; font-size: var(--font-body); line-height: var(--line-height-body); font-weight: 600; }
@media (max-width: 350px) { .trend-card { padding-right: 0; padding-left: 0; }.trend-title { font-size: var(--font-section-title-compact); }.trend-tabs { height: 54rpx; }.trend-tab { min-width: 48rpx; height: 46rpx; }.chart-toolbar { align-items: flex-start; flex-direction: column; gap: 13rpx; }.chart-legend { gap: 20rpx; font-size: var(--font-meta-compact); }.trend-activity { align-self: flex-end; margin-top: -56rpx; font-size: var(--font-tag-compact); }.chart-shell { height: 324rpx; padding-right: 44rpx; padding-left: 44rpx; }.trend-canvas { right: 44rpx; left: 44rpx; }.chart-labels { margin-right: 40rpx; margin-left: 40rpx; font-size: var(--font-meta-compact); } }
