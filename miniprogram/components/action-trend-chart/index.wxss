:host { display: block; margin-top: 24rpx; }
.trend-card { padding: 30rpx 28rpx 12rpx; border: 1rpx solid var(--progress-border,#ede5d8); border-radius: var(--progress-radius,28rpx); background: var(--progress-surface,#fffdf8); box-shadow: var(--progress-shadow,0 10rpx 30rpx rgba(61,48,28,.045)); font-family: var(--font-family-sans); }
.trend-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.trend-title-row { display: flex; align-items: center; gap: 9rpx; }
.trend-title { color: var(--progress-text,#27352f); font-size: 34rpx; font-weight: 600; line-height: 46rpx; }
.trend-period { margin-top: 7rpx; color: #7b817d; font-size: 22rpx; line-height: 30rpx; }
.trend-tabs { height: 58rpx; padding: 4rpx; display: flex; border-radius: 29rpx; background: #f1eee7; }
.trend-tab { min-width: 54rpx; height: 50rpx; display: flex; align-items: center; justify-content: center; border-radius: 25rpx; color: #707772; font-size: 21rpx; }
.trend-tab.is-active { color: #fff; background: var(--progress-primary,#17614f); box-shadow: 0 2rpx 5rpx rgba(23,97,79,.10); }
.chart-legend { margin-top: 30rpx; display: flex; align-items: center; gap: 34rpx; color: #68736e; font-size: 20rpx; line-height: 28rpx; }
.legend-item { display: flex; align-items: center; gap: 9rpx; }
.legend-line { width: 29rpx; height: 4rpx; border-radius: 3rpx; background: var(--progress-primary,#17614f); }
.legend-line.is-actions { position: relative; height: 2rpx; background: #c79a3b; }
.legend-dot { position: absolute; box-sizing: border-box; width: 10rpx; height: 10rpx; top: -4rpx; left: 10rpx; border: 3rpx solid #c79a3b; border-radius: 50%; background: #fffdf8; }
.chart-shell { position: relative; height: 492rpx; margin-top: 27rpx; padding: 0 50rpx; overflow: hidden; }
.trend-canvas { position: absolute; z-index: 1; width: auto; height: auto; top: 0; right: 50rpx; bottom: 0; left: 50rpx; }
.axis-unit { position: absolute; z-index: 2; top: 0; left: 0; color: #8a8f8b; font-size: 17rpx; pointer-events: none; }
.axis-labels { position: absolute; z-index: 2; width: 46rpx; top: 32rpx; bottom: 28rpx; display: flex; flex-direction: column; justify-content: space-between; color: #878d89; font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 19rpx; font-weight: 400; line-height: 24rpx; pointer-events: none; }
.axis-left { left: 0; align-items: flex-start; }.axis-right { right: 0; align-items: flex-end; }
.axis-right { top: 32rpx; bottom: 28rpx; }
.chart-labels { margin: 8rpx 44rpx 0; display: flex; }
.chart-label { min-width: 0; flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4rpx; color: #7e8580; font-family: var(--font-family-sans); font-size: 19rpx; font-weight: 400; line-height: 27rpx; }
.chart-label__day { color: #66716c; }
.chart-label.is-future,.chart-label.is-future .chart-label__day { color: #a8ada9; }
.chart-label.is-today { margin-top: -6rpx; padding: 6rpx 0 7rpx; border-radius: 16rpx; background: #e7f0ea; color: #165b49; box-shadow: inset 0 0 0 1rpx rgba(22,91,73,.035); }
.chart-label.is-today .chart-label__date,.chart-label.is-today .chart-label__day { color: var(--progress-primary,#17614f); font-weight: 600; }
.trend-highlights { margin-top: 30rpx; padding: 24rpx 4rpx 23rpx; display: flex; border-radius: 20rpx; background: #f8f3e9; }
.trend-highlight { min-width: 0; padding: 0 18rpx; flex: 1; }
.trend-highlight + .trend-highlight { border-left: 1rpx solid rgba(102,113,106,.12); }
.trend-highlight__title { display: flex; align-items: center; gap: 7rpx; color: #98712e; font-size: 19rpx; line-height: 27rpx; white-space: nowrap; }
.trend-highlight__value { margin-top: 10rpx; color: var(--progress-primary,#17614f); font-family: var(--font-family-numeric); font-variant-numeric: tabular-nums; font-size: 34rpx; font-weight: 600; line-height: 40rpx; white-space: nowrap; }
.trend-highlight__unit { margin-left: 5rpx; color: #65716c; font-family: var(--font-family-sans); font-size: 18rpx; }
.trend-highlight__label { margin-top: 4rpx; overflow: hidden; color: #747c77; font-size: 18rpx; line-height: 26rpx; text-overflow: ellipsis; white-space: nowrap; }
.history-link { min-height: 78rpx; padding-top: 3rpx; display: flex; align-items: center; justify-content: flex-end; color: #8e6728; font-size: 21rpx; font-weight: 500; }
.trend-empty { min-height: 360rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.trend-empty__title { margin-top: 18rpx; color: #24332e; font-size: 27rpx; font-weight: 600; }
.trend-empty__description { max-width: 470rpx; margin-top: 9rpx; color: #7b817d; font-size: 21rpx; line-height: 34rpx; }
.trend-empty__action { min-height: 64rpx; margin-top: 20rpx; padding: 0 24rpx; display: flex; align-items: center; border: 1rpx solid rgba(22,91,73,.16); border-radius: 18rpx; color: #165b49; font-size: 21rpx; font-weight: 600; }
@media (max-width: 350px) { .trend-card { padding-right: 20rpx; padding-left: 20rpx; }.chart-shell { height: 424rpx; padding-right: 44rpx; padding-left: 44rpx; }.trend-canvas { right: 44rpx; left: 44rpx; }.chart-labels { margin-right: 40rpx; margin-left: 40rpx; }.trend-highlight { padding: 0 9rpx; }.trend-highlight__title { gap: 3rpx; font-size: 16rpx; }.trend-highlight__value { font-size: 28rpx; }.trend-highlight__label { font-size: 16rpx; } }
