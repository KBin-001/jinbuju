<view class="coach-tip" bindtap="openCoach" hover-class="coach-tip--pressed" aria-label="AI 成长教练建议">
  <view class="coach-tip__content">
    <view class="coach-tip__head"><t-icon name="star" size="27rpx" /><text>AI 成长教练</text></view>
    <view class="coach-tip__main">
      <view class="coach-tip__copy">
        <view class="coach-tip__title">{{title || '今天先完成 1 项重点'}}</view>
        <view class="coach-tip__text">{{body || text || '结合当前行动与投入时间生成建议。'}}</view>
      </view>
      <view class="coach-tip__link"><text>查看建议</text><t-icon name="chevron-right" size="25rpx" /></view>
    </view>
    <view wx:if="{{status === 'error'}}" class="coach-tip__state">当前展示本地建议</view>
  </view>
</view>
