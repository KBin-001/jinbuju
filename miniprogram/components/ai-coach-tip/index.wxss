:host { display: block; }
.coach-tip {
  min-height: 190rpx;
  margin: 0;
  border-top: 1rpx solid rgba(30, 40, 35, .07);
  border-bottom: 1rpx solid rgba(30, 40, 35, .07);
  background: rgba(255, 253, 249, .58);
  box-sizing: border-box;
  transition: opacity 160ms ease-out;
}
.coach-tip--pressed { opacity: .72; }
.coach-tip__content {
  min-height: 190rpx;
  padding: 25rpx 12rpx 23rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}
.coach-tip__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #a4741f;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 32rpx;
  letter-spacing: 1rpx;
}
.coach-tip__main {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.coach-tip__copy { min-width: 0; flex: 1; }
.coach-tip__title {
  display: -webkit-box;
  overflow: hidden;
  color: #181a18;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 42rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}
.coach-tip__text {
  margin-top: 7rpx;
  display: -webkit-box;
  overflow: hidden;
  color: #6f756f;
  font-size: 21rpx;
  line-height: 31rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}
.coach-tip__link {
  min-width: 130rpx;
  min-height: 64rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
  color: #9e701e;
  font-size: 21rpx;
  font-weight: 500;
}
.coach-tip__state { margin-top: 5rpx; color: #969a95; font-size: 16rpx; }

@media (max-width: 350px) {
  .coach-tip__content { padding-right: 4rpx; padding-left: 4rpx; }
  .coach-tip__title { font-size: 27rpx; }
  .coach-tip__link { min-width: 106rpx; font-size: 18rpx; }
}
@media (prefers-reduced-motion: reduce) {
  .coach-tip { transition: none; }
}
