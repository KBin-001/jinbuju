:host { display: block; }
.coach-tip {
  min-height: 164rpx;
  margin: 0;
  border: 0;
  background: transparent;
  box-sizing: border-box;
  transition: opacity 160ms ease-out;
}
.coach-tip--pressed { opacity: .72; }
.coach-tip__content {
  min-height: 164rpx;
  padding: 18rpx 12rpx 15rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}
.coach-tip__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #a4741f;
  font-size: var(--font-meta);
  font-weight: 550;
  line-height: var(--line-height-meta);
  letter-spacing: 1rpx;
}
.coach-tip__main {
  margin-top: 13rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.coach-tip__copy { min-width: 0; flex: 1; }
.coach-tip__title {
  display: -webkit-box;
  overflow: hidden;
  color: #181a18;
  font-size: var(--font-card-title);
  font-weight: 600;
  line-height: var(--line-height-card-title);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}
.coach-tip__text {
  margin-top: 7rpx;
  display: -webkit-box;
  overflow: hidden;
  color: #6f756f;
  font-size: var(--font-caption);
  line-height: var(--line-height-caption);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}
.coach-tip__link {
  min-width: 130rpx;
  min-height: 64rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
  color: #9e701e;
  font-size: var(--font-body);
  line-height: var(--line-height-body);
  font-weight: 500;
}
.coach-tip__state { margin-top: 5rpx; color: #969a95; font-size: var(--font-tag); line-height: var(--line-height-tag); }

@media (max-width: 350px) {
  .coach-tip__content { padding-right: 4rpx; padding-left: 4rpx; }
  .coach-tip__title { font-size: var(--font-card-title-compact); }
  .coach-tip__link { min-width: 106rpx; font-size: var(--font-meta-compact); }
}
@media (prefers-reduced-motion: reduce) {
  .coach-tip { transition: none; }
}
