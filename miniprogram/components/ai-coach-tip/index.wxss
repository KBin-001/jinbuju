:host { display: block; }
.coach-tip { position: relative; min-height: 136rpx; margin-top: 16rpx; overflow: hidden; border: 1rpx solid rgba(105,96,78,.1); border-radius: 26rpx; background: #fffcf6; box-shadow: 0 8rpx 24rpx rgba(75,62,40,.04); transition: opacity 160ms ease-out, transform 160ms ease-out; }
.coach-tip--pressed { opacity: .78; transform: scale(.995); }
.coach-tip__art { position: absolute; top: -126rpx; right: -34rpx; width: 68%; height: auto; display: block; opacity: .32; }
.coach-tip__veil { position: absolute; inset: 0; background: rgba(255,252,246,.4); }
.coach-tip__content { position: relative; z-index: 2; min-height: 136rpx; padding: 17rpx 28rpx 15rpx; display: flex; flex-direction: column; justify-content: center; }
.coach-tip__head { display: flex; align-items: center; gap: 9rpx; color: #a17630; font-family: var(--font-family-brand); font-size: 23rpx; font-weight: var(--font-weight-title); line-height: 32rpx; }
.coach-tip__text { max-width: 88%; margin-top: 6rpx; display: -webkit-box; overflow: hidden; color: #3f4945; font-size: 20rpx; line-height: 29rpx; -webkit-box-orient: vertical; -webkit-line-clamp: 1; }
.coach-tip__state { margin-top: 4rpx; color: #8b8d87; font-size: 16rpx; }
.coach-tip__link { min-height: 30rpx; margin-top: 6rpx; display: flex; align-items: center; gap: 3rpx; color: #a1661b; font-size: 18rpx; font-weight: 500; }

@media (prefers-reduced-motion: reduce) {
  .coach-tip {
    transition: none;
  }
}
