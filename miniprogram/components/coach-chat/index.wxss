.coach-chat {
  box-sizing: border-box;
  min-height: 112rpx;
  color: var(--color-text-main);
}

.coach-chat__invitation {
  box-sizing: border-box;
  min-height: 180rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(200, 155, 74, .34);
  border-radius: 28rpx;
  background: linear-gradient(135deg, #FFF8E7 0%, #F3E3B8 100%);
  box-shadow: 0 12rpx 30rpx rgba(153, 115, 47, .08);
}

.coach-chat__invitation-heading {
  display: flex;
  gap: 11rpx;
  align-items: center;
}

.coach-chat__invitation-spark {
  display: flex;
  width: 34rpx;
  height: 42rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  color: var(--color-gold);
}

.coach-chat__invitation-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.coach-chat__invitation-title-text {
  color: var(--color-text-main);
  font-family: STKaiti, "KaiTi SC", "Noto Serif SC", serif;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.coach-chat__invitation-subtitle {
  margin-top: 1rpx;
  color: #84765D;
  font-size: 19rpx;
  line-height: 28rpx;
}

.coach-chat__quick-list {
  display: flex;
  gap: 10rpx;
  margin-top: 18rpx;
}

.coach-chat__quick {
  display: flex;
  box-sizing: border-box;
  width: 0;
  min-width: 0;
  height: 64rpx;
  flex: 1;
  padding: 7rpx 8rpx;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border: 1rpx solid rgba(200, 155, 74, .38);
  border-radius: 32rpx;
  color: #876923;
  background: rgba(255, 253, 248, .84);
  font-size: 19rpx;
  line-height: 24rpx;
}

.coach-chat__quick--0,
.coach-chat__quick--2 {
  color: var(--color-primary);
}

.coach-chat__quick-text {
  display: -webkit-box;
  min-width: 0;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  text-align: center;
}

.coach-chat__messages {
  padding-top: 32rpx;
}

.coach-chat__message {
  margin-top: 26rpx;
}

.coach-chat__message:first-child {
  margin-top: 4rpx;
}

.coach-chat__user-row {
  display: flex;
  gap: 14rpx;
  align-items: flex-end;
  justify-content: flex-end;
}

.coach-chat__avatar {
  flex: none;
  filter: drop-shadow(0 4rpx 10rpx rgba(34, 63, 53, .12));
}

.coach-chat__user-text {
  box-sizing: border-box;
  max-width: 72%;
  padding: 19rpx 25rpx;
  border-radius: 24rpx 24rpx 7rpx 24rpx;
  border: 1rpx solid rgba(127, 157, 145, .13);
  color: var(--color-text-main);
  background: linear-gradient(135deg, #EAF1EA 0%, #F7F6ED 100%);
  box-shadow: 0 8rpx 20rpx rgba(36, 91, 77, .06);
  font-size: 24rpx;
  line-height: 36rpx;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.coach-chat__message-time { flex: none; padding-bottom: 7rpx; color: #9c9c97; font-size: 18rpx; line-height: 26rpx; }

.coach-chat__assistant {
  display: flex;
  gap: 15rpx;
  align-items: flex-start;
}

.coach-chat__brand {
  display: flex;
  box-sizing: border-box;
  width: 78rpx;
  height: 78rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.coach-chat__brand--thinking {
  margin-top: 2rpx;
}

.coach-chat__brand-image {
  width: 78rpx;
  height: 78rpx;
}

.coach-chat__assistant-body {
  box-sizing: border-box;
  min-width: 0;
  flex: 1;
  padding: 27rpx 29rpx 20rpx;
  border: 1rpx solid rgba(200, 155, 74, .28);
  border-radius: 28rpx;
  background: rgba(255, 253, 248, .98);
  box-shadow: 0 14rpx 36rpx rgba(91, 70, 31, .065);
}

.coach-chat__assistant-body--clarification {
  border-color: rgba(168, 112, 37, .18);
  background: rgba(255, 250, 239, .96);
}

.coach-chat__answer,
.coach-chat__response-summary,
.coach-chat__section-detail,
.coach-chat__priority-detail,
.coach-chat__timeline-detail,
.coach-chat__team-detail {
  overflow-wrap: anywhere;
  white-space: pre-wrap;
  word-break: break-word;
}

.coach-chat__answer {
  color: var(--color-text-body);
  font-size: 24rpx;
  line-height: 39rpx;
}

.coach-chat__eyebrow {
  display: flex;
  gap: 8rpx;
  align-items: center;
  color: var(--color-gold);
  font-size: 25rpx;
  font-weight: 650;
  line-height: 29rpx;
}

.coach-chat__response-title {
  margin-top: 11rpx;
  color: var(--color-primary-dark);
  font-family: STKaiti,"KaiTi SC","Noto Serif SC",serif;
  font-size: 32rpx;
  font-weight: 750;
  line-height: 39rpx;
}

.coach-chat__response-summary {
  margin-top: 8rpx;
  color: var(--color-text-body);
  font-size: 23rpx;
  line-height: 38rpx;
}

.coach-chat__structure-label {
  display: flex;
  gap: 7rpx;
  margin-bottom: 8rpx;
  align-items: center;
  color: var(--color-gold);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 29rpx;
}

.coach-chat__structure-label--conclusion {
  margin-top: 14rpx;
}

.coach-chat__structure-label--wide {
  width: 100%;
}

.coach-chat__structure-label--inset {
  margin: 14rpx 17rpx 2rpx;
}

.coach-chat__structure-label--next {
  margin-top: 18rpx;
  color: var(--color-primary);
}

.coach-chat__answer--direct {
  color: var(--color-text-main);
}

.coach-chat__metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.coach-chat__metric {
  box-sizing: border-box;
  width: calc(50% - 6rpx);
  min-width: 0;
  padding: 17rpx;
  border: 1rpx solid rgba(200, 155, 74, .18);
  border-radius: var(--radius-card-small);
  background: linear-gradient(145deg, #FFF8E7 0%, #FFFCF6 100%);
}

.coach-chat__metric-head {
  display: flex;
  gap: 8rpx;
  align-items: center;
  justify-content: space-between;
}

.coach-chat__metric-value {
  min-width: 0;
  color: var(--color-primary);
  font-size: 31rpx;
  font-weight: 750;
  line-height: 40rpx;
  overflow-wrap: anywhere;
}

.coach-chat__metric-unit {
  margin-left: 4rpx;
  color: var(--color-primary-light);
  font-size: 17rpx;
  font-weight: 500;
}

.coach-chat__metric-label {
  margin: 3rpx 0 10rpx;
  overflow: hidden;
  color: var(--color-text-secondary);
  font-size: 19rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coach-chat__sections,
.coach-chat__priorities,
.coach-chat__timeline,
.coach-chat__comparison,
.coach-chat__trend,
.coach-chat__team {
  margin-top: 17rpx;
  overflow: hidden;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.coach-chat__section,
.coach-chat__priority,
.coach-chat__comparison-item,
.coach-chat__team-item {
  display: flex;
  gap: 13rpx;
  padding: 20rpx 0;
  align-items: flex-start;
}

.coach-chat__section--evidence {
  margin: 4rpx 0;
  padding-right: 14rpx;
  padding-left: 14rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(255, 248, 231, .82), rgba(255, 252, 246, .56));
}

.coach-chat__section--next {
  margin-top: 8rpx;
  padding-right: 14rpx;
  padding-left: 14rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(232, 240, 235, .9), rgba(255, 252, 246, .58));
}

.coach-chat__section--next .coach-chat__section-index {
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.coach-chat__section + .coach-chat__section,
.coach-chat__priority + .coach-chat__priority,
.coach-chat__comparison-item + .coach-chat__comparison-item,
.coach-chat__team-item + .coach-chat__team-item {
  border-top: 1rpx solid rgba(200,155,74,.17);
}

.coach-chat__section-index {
  display: flex;
  box-sizing: border-box;
  width: auto;
  min-width: 48rpx;
  height: 40rpx;
  padding: 0 9rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: var(--color-gold);
  background: var(--color-gold-soft);
  font-size: 18rpx;
  font-weight: 750;
  white-space: nowrap;
}

.coach-chat__section-copy,
.coach-chat__priority-copy,
.coach-chat__timeline-copy,
.coach-chat__team-copy {
  min-width: 0;
  flex: 1;
}

.coach-chat__section-title,
.coach-chat__priority-title,
.coach-chat__timeline-title,
.coach-chat__team-label {
  color: var(--color-text-main);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.coach-chat__section-detail,
.coach-chat__priority-detail,
.coach-chat__timeline-detail,
.coach-chat__team-detail {
  margin-top: 3rpx;
  color: var(--color-text-secondary);
  font-size: 19rpx;
  line-height: 30rpx;
}

.coach-chat__priority {
  align-items: center;
}

.coach-chat__priority-tag {
  flex: none;
}

.coach-chat__timeline {
  padding: 5rpx 0;
}

.coach-chat__timeline-item {
  display: flex;
  gap: 13rpx;
  min-height: 72rpx;
  padding: 13rpx 17rpx 5rpx;
}

.coach-chat__timeline-rail {
  position: relative;
  display: flex;
  width: 16rpx;
  flex: none;
  justify-content: center;
}

.coach-chat__timeline-dot {
  position: relative;
  z-index: 1;
  width: 12rpx;
  height: 12rpx;
  margin-top: 9rpx;
  border: 4rpx solid var(--color-primary-soft);
  border-radius: 50%;
  background: var(--color-primary);
}

.coach-chat__timeline-line {
  position: absolute;
  top: 28rpx;
  bottom: -10rpx;
  width: 2rpx;
  background: var(--color-border);
}

.coach-chat__timeline-time {
  color: var(--color-gold);
  font-size: 18rpx;
  font-weight: 700;
  line-height: 27rpx;
}

.coach-chat__comparison-item {
  align-items: center;
  justify-content: space-between;
}

.coach-chat__comparison-label {
  min-width: 0;
  color: var(--color-text-body);
  font-size: 21rpx;
  line-height: 31rpx;
}

.coach-chat__comparison-values {
  display: flex;
  flex: none;
  align-items: baseline;
  gap: 8rpx;
}

.coach-chat__comparison-current {
  color: var(--color-primary);
  font-size: 27rpx;
  font-weight: 750;
}

.coach-chat__comparison-previous {
  color: var(--color-text-light);
  font-size: 17rpx;
}

.coach-chat__comparison-delta {
  color: var(--color-success);
  font-size: 18rpx;
  font-weight: 650;
}

.coach-chat__trend {
  padding: 12rpx 17rpx 4rpx;
}

.coach-chat__trend-item {
  margin-bottom: 14rpx;
}

.coach-chat__trend-copy {
  display: flex;
  margin-bottom: 7rpx;
  justify-content: space-between;
  color: var(--color-text-secondary);
  font-size: 19rpx;
  line-height: 28rpx;
}

.coach-chat__team-item {
  align-items: center;
}

.coach-chat__team-value {
  flex: none;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 750;
  line-height: 34rpx;
}

.coach-chat__action-template {
  display: flex;
  gap: 12rpx;
  margin-top: 17rpx;
  padding: 17rpx;
  align-items: flex-start;
  border: 1rpx solid rgba(36, 91, 77, .10);
  border-radius: var(--radius-card-small);
  background: var(--gradient-card-mint);
}

.coach-chat__action-icon {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 13rpx;
  color: var(--color-primary);
  background: rgba(255, 252, 246, .74);
}

.coach-chat__action-copy {
  min-width: 0;
  flex: 1;
}

.coach-chat__action-title {
  color: var(--color-primary-dark);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 32rpx;
  overflow-wrap: anywhere;
}

.coach-chat__action-detail {
  margin-top: 3rpx;
  color: var(--color-text-secondary);
  font-size: 19rpx;
  line-height: 30rpx;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.coach-chat__action-time {
  display: flex;
  gap: 6rpx;
  margin-top: 8rpx;
  align-items: center;
  color: var(--color-growth);
  font-size: 19rpx;
}

.coach-chat__proposal {
  margin-top: 17rpx;
  padding: 17rpx;
  border: 1rpx solid rgba(200, 155, 74, .18);
  border-radius: var(--radius-card-small);
  color: #705522;
  background: var(--gradient-card-sun);
  font-size: 21rpx;
  line-height: 33rpx;
}

.coach-chat__proposal-heading,
.coach-chat__proposal-reminder,
.coach-chat__proposal-done {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.coach-chat__feedback { display: flex; margin-top: 13rpx; gap: 2rpx; align-items: center; justify-content: flex-end; border-top: 1rpx solid rgba(200,155,74,.17); padding-top: 5rpx; }
.coach-chat__feedback-button { display: flex; width: 68rpx; height: 68rpx; align-items: center; justify-content: center; border-radius: 50%; color: #8c8e89; background: transparent; }
.coach-chat__feedback-button.is-selected { color: var(--color-primary); background: var(--color-primary-soft); }

.coach-chat__proposal-title {
  min-width: 0;
  flex: 1;
  color: #654E25;
  font-weight: 650;
  overflow-wrap: anywhere;
}

.coach-chat__proposal-reminder {
  margin-top: 9rpx;
  color: #80652F;
  font-size: 20rpx;
}

.coach-chat__proposal-button {
  display: block;
  margin-top: 14rpx;
}

.coach-chat__proposal-done {
  margin-top: 11rpx;
  color: var(--color-success);
  font-weight: 650;
}

.coach-chat__thinking {
  display: flex;
  gap: 13rpx;
  margin-top: 24rpx;
  align-items: flex-start;
}

.coach-chat__error {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 17rpx 19rpx;
  align-items: center;
  border: 1rpx solid rgba(168, 112, 37, .14);
  border-radius: var(--radius-card-small);
  color: #775A25;
  background: var(--color-warning-soft);
  font-size: 21rpx;
}

.coach-chat__error-copy {
  min-width: 0;
  flex: 1;
  line-height: 31rpx;
  overflow-wrap: anywhere;
}

.coach-chat__error-retry {
  flex: none;
  padding: 9rpx 4rpx;
  color: var(--color-primary);
  font-weight: 700;
}

.coach-chat__composer {
  position: fixed;
  z-index: 80;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  display: flex;
  box-sizing: border-box;
  min-height: 104rpx;
  padding: 10rpx 11rpx 10rpx 14rpx;
  align-items: center;
  border: 2rpx solid rgba(62, 107, 88, .55);
  border-radius: 52rpx;
  background: rgba(255, 253, 248, .97);
  box-shadow: 0 14rpx 38rpx rgba(58, 66, 60, .12), 0 0 0 7rpx rgba(255, 252, 246, .72);
}

.coach-chat__input-bar {
  display: flex;
  gap: 10rpx;
  width: 100%;
  min-height: 68rpx;
  align-items: center;
}

.coach-chat__composer-guide {
  position: relative;
  display: flex;
  width: 48rpx;
  height: 48rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fffdf8;
  background: #8fb5a5;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, .72);
}

.coach-chat__composer-guide::after {
  position: absolute;
  top: -3rpx;
  right: -1rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #c89b4a;
  content: "";
}

.coach-chat__input {
  box-sizing: border-box;
  width: 0;
  min-width: 0;
  min-height: 58rpx;
  max-height: 116rpx;
  padding: 11rpx 5rpx 9rpx 0;
  flex: 1;
  color: var(--color-text-main);
  font-size: 24rpx;
  line-height: 36rpx;
}

.coach-chat__placeholder {
  color: var(--color-text-light);
}

.coach-chat__send {
  position: relative;
  display: flex;
  box-sizing: border-box;
  width: 66rpx;
  height: 66rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 50%;
  color: #fff;
  background: var(--color-primary, #245B4D);
  box-shadow: 0 7rpx 18rpx rgba(36, 91, 77, .26), inset 0 0 0 2rpx rgba(255,255,255,.22);
}

.coach-chat__send.is-disabled {
  border: none;
  color: rgba(255, 255, 255, .78);
  background: rgba(36, 91, 77, .68);
  opacity: 1;
  box-shadow: 0 5rpx 14rpx rgba(36, 91, 77, .17), inset 0 0 0 2rpx rgba(255,255,255,.17);
}

.coach-chat__send-accent {
  position: absolute;
  right: 9rpx;
  bottom: 8rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #d5aa58;
}

.coach-chat__anchor {
  height: calc(160rpx + env(safe-area-inset-bottom));
}

@media (min-width: 390px) {
  .coach-chat__metric {
    width: calc(33.333% - 8rpx);
  }
}

@media (max-width: 350px) {
  .coach-chat__quick-list { gap: 6rpx; }
  .coach-chat__quick { padding: 6rpx 4rpx; font-size: 17rpx; }
  .coach-chat__assistant { gap: 9rpx; }
  .coach-chat__brand,.coach-chat__brand-image { width: 62rpx; height: 62rpx; }
  .coach-chat__assistant-body { padding: 21rpx; }
  .coach-chat__message-time { display: none; }
  .coach-chat__composer { right: 16rpx; left: 16rpx; padding-right: 9rpx; padding-left: 17rpx; }
  .coach-chat__send { width: 56rpx; height: 56rpx; }
}

/* Semantic type roles for coach answers, evidence and composer text. */
.coach-chat__invitation-title-text,
.coach-chat__response-title { font-size: var(--font-card-title); line-height: var(--line-height-card-title); }
.coach-chat__invitation-subtitle,
.coach-chat__message-time,
.coach-chat__metric-unit,
.coach-chat__metric-label,
.coach-chat__section-detail,
.coach-chat__priority-detail,
.coach-chat__timeline-detail,
.coach-chat__team-detail,
.coach-chat__timeline-time,
.coach-chat__comparison-previous,
.coach-chat__comparison-delta,
.coach-chat__trend-copy,
.coach-chat__action-detail,
.coach-chat__action-time,
.coach-chat__proposal-reminder { font-size: var(--font-meta); line-height: var(--line-height-meta); }
.coach-chat__quick,
.coach-chat__structure-label,
.coach-chat__section-index { font-size: var(--font-tag); line-height: var(--line-height-tag); }
.coach-chat__user-text,
.coach-chat__answer,
.coach-chat__response-summary,
.coach-chat__proposal,
.coach-chat__comparison-label,
.coach-chat__action-title,
.coach-chat__team-value,
.coach-chat__error { font-size: var(--font-body); line-height: var(--line-height-body); }
.coach-chat__eyebrow,
.coach-chat__metric-value,
.coach-chat__comparison-current { font-size: var(--font-body-strong); line-height: var(--line-height-body-strong); }
.coach-chat__input { font-size: var(--font-body); line-height: var(--line-height-body); }

@media (max-width: 350px) {
  .coach-chat__invitation-title-text,
  .coach-chat__response-title { font-size: var(--font-card-title-compact); line-height: var(--line-height-card-title); }
  .coach-chat__invitation-subtitle,
  .coach-chat__message-time,
  .coach-chat__metric-unit,
  .coach-chat__metric-label,
  .coach-chat__section-detail,
  .coach-chat__priority-detail,
  .coach-chat__timeline-detail,
  .coach-chat__team-detail,
  .coach-chat__timeline-time,
  .coach-chat__comparison-previous,
  .coach-chat__comparison-delta,
  .coach-chat__trend-copy,
  .coach-chat__action-detail,
  .coach-chat__action-time,
  .coach-chat__proposal-reminder { font-size: var(--font-meta-compact); line-height: var(--line-height-meta); }
  .coach-chat__quick,
  .coach-chat__structure-label,
  .coach-chat__section-index { font-size: var(--font-tag-compact); line-height: var(--line-height-tag); }
  .coach-chat__user-text,
  .coach-chat__answer,
  .coach-chat__response-summary,
  .coach-chat__proposal,
