/* 进步局 · 现代东方山水统一设计令牌
 * 山水负责品牌氛围，正文与数据统一使用高对比度的系统字体和暖色纸张表面。
 * 历史主题 id 仍可被页面读取，但视觉统一到同一套商业化基线，避免页面间色板漂移。
 */
page,
[data-theme="mint"],
[data-theme="cream"],
[data-theme="inkGreen"],
[data-theme="apricot"] {
  --color-bg: #F7F3EA;
  --color-background: #F7F3EA;
  --color-bg-warm: #F7EBCF;
  --color-background-warm: #F7EBCF;
  --color-card: #FFFCF6;
  --color-surface: #FFFCF6;
  --color-card-soft: #F1F4EE;
  --color-card-soft-2: #E8F0EB;
  --color-card-hover: #F3F5F0;

  --color-primary: #245B4D;
  --color-primary-deep: #183F35;
  --color-primary-dark: #183F35;
  --color-primary-light: #7F9D91;
  --color-primary-soft: #E8F0EB;
  --color-growth: #557D6E;
  --color-accent: #C89B4A;
  --color-sun: #C89B4A;

  --color-text: #24312D;
  --color-text-main: #24312D;
  --color-text-secondary: #7C817D;
  --color-text-light: #9B9F9B;
  --color-text-muted: #9B9F9B;
  --color-text-inverse: #FFFFFF;

  --color-border: rgba(103, 94, 77, .16);
  --color-border-soft: rgba(103, 94, 77, .10);
  --color-divider: rgba(103, 94, 77, .12);
  --color-success: #39745F;
  --color-success-soft: #E8F0EB;
  --color-warning: #B37D27;
  --color-warning-soft: #F7EBCF;
  --color-info: #587A86;
  --color-info-soft: #EAF0F2;
  --color-danger: #B86152;
  --color-danger-soft: #F8E9E5;
  --color-danger-light: #F8E9E5;

  --gradient-card-mint: linear-gradient(135deg, #E8F0EB 0%, #FFFCF6 72%);
  --gradient-card-soft: linear-gradient(135deg, #F1F4EE 0%, #FFFCF6 68%);
  --gradient-card-sun: linear-gradient(135deg, #F7EBCF 0%, #FFFCF6 100%);
  --gradient-progress: linear-gradient(90deg, #7F9D91 0%, #245B4D 100%);
  --gradient-ring: linear-gradient(135deg, #7F9D91 0%, #245B4D 100%);
  --gradient-hero: var(--gradient-card-mint);
  --gradient-gold: linear-gradient(135deg, #F7EBCF, #C89B4A);
  --gradient-ai: linear-gradient(135deg, #7F9D91, #245B4D);

  --shadow-card: 0 10rpx 28rpx rgba(49, 57, 50, .07);
  --shadow-card-soft: 0 4rpx 18rpx rgba(49, 57, 50, .05);
  --shadow-float: 0 16rpx 40rpx rgba(36, 70, 59, .12);
  --shadow-button: 0 10rpx 24rpx rgba(36, 91, 77, .18);
  --shadow-button-soft: 0 6rpx 16rpx rgba(36, 91, 77, .12);
  --shadow-button-primary: 0 12rpx 28rpx rgba(36, 91, 77, .20);

  --radius-card: 28rpx;
  --radius-card-sm: 24rpx;
  --radius-pill: 999rpx;
  --radius-button: 999rpx;
  --radius-tag: 18rpx;
  --gap-card: 20rpx;
  --gap-section: 36rpx;
  --padding-page: 24rpx 32rpx 160rpx;

  --td-brand-color: #245B4D;
  --td-brand-color-active: #183F35;
  --td-brand-color-disabled: #B9C7C0;
  --td-brand-color-light: #E8F0EB;
  --td-bg-color-page: #F7F3EA;
  --td-bg-color-container: #FFFCF6;
  --td-text-color-primary: #24312D;
  --td-text-color-secondary: #7C817D;
  --td-component-border: rgba(103, 94, 77, .16);
  --td-radius-default: 24rpx;
  --td-radius-large: 28rpx;
  --td-button-primary-bg-color: #245B4D;
  --td-button-primary-active-bg-color: #183F35;
  --td-button-primary-color: #FFFFFF;
  --td-button-default-color: #245B4D;
  --td-button-default-border-color: rgba(36, 91, 77, .22);
  --td-input-bg-color: #FFFCF6;
  --td-input-border-color: rgba(103, 94, 77, .16);
  --td-progress-track-color: #E5E9E4;
  --td-progress-inner-bg-color: #245B4D;

  --button-primary-background-color: #245B4D;
  --button-primary-border-color: #245B4D;
  --button-primary-color: #FFFFFF;
  --button-default-background-color: #FFFCF6;
  --button-default-border-color: rgba(36, 91, 77, .22);
  --button-default-color: #245B4D;
  --button-primary-danger-background-color: #B86152;
  --button-primary-danger-border-color: #B86152;
  --button-disabled-opacity: .5;

  --tag-primary-color: #245B4D;
  --tag-primary-light-color: #E8F0EB;
  --tag-success-color: #39745F;
  --tag-success-light-color: #E8F0EB;
  --progress-stroke-color: #245B4D;
  --progress-success-color: #39745F;
  --progress-trail-color: #E5E9E4;
  --popup-background: #F7F3EA;
  --popup-color: #24312D;
  --dialog-background-color: #FFFCF6;
  --dialog-title-color: #24312D;
  --dialog-content-color: #7C817D;
  --input-background-color: #FFFCF6;
  --input-item-color: #24312D;
  --input-item-placeholder-color: #9B9F9B;
}

page [data-theme] {
  color: var(--color-text-main);
  background-color: var(--color-background);
}

page [data-theme] .card,
page [data-theme] .section-card {
  border-color: var(--color-border);
  background-color: var(--color-card);
  box-shadow: var(--shadow-card);
}

page [data-theme] .primary-button {
  color: #FFFFFF;
  background: var(--color-primary);
  box-shadow: var(--shadow-button-primary);
}

page [data-theme] .secondary-button {
  color: var(--color-primary);
  border-color: var(--color-border);
  background: var(--color-card);
}

page [data-theme] .status-chip,
page [data-theme] .ui-tag {
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

page [data-theme] .progress-bar-inner {
  background: var(--gradient-progress);
}
