.legal-page { padding-top: 32rpx; background: #F7F3EA; color: #24312D; }
.legal-title { color: #245B4D; font-family: "Songti SC", STSong, serif; font-size: 44rpx; font-weight: 700; line-height: 1.35; letter-spacing: 2rpx; }
.legal-meta { margin-top: 12rpx; color: #7C817D; font-size: 22rpx; line-height: 34rpx; }
.legal-notice { margin-top: 22rpx; padding: 24rpx 26rpx; border: 1rpx solid rgba(200,155,74,.25); border-radius: 24rpx; background: #FBF2DF; color: #795C2D; font-size: 23rpx; line-height: 1.7; }
.legal-section { margin-top: 20rpx; padding: 28rpx; border: 1rpx solid rgba(121,111,91,.13); border-radius: 28rpx; background: #FFFCF6; box-shadow: 0 8rpx 24rpx rgba(75,62,40,.05); }
.legal-heading { color: #24312D; font-size: 29rpx; font-weight: 700; }
.legal-copy { margin-top: 12rpx; color: #6F7772; font-size: 25rpx; line-height: 1.8; }
