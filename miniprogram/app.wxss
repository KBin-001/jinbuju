page {
  --color-primary: #145243;
  --color-primary-deep: #0f4035;
  --color-primary-soft: #f3f8f5;
  --color-primary-light: #eef7f2;
  --color-growth: #7dbb69;
  --color-accent: #55b98b;
  --color-sun: #f5b94e;
  --color-coral: #d98a76;
  --color-blue: #8fb5c8;
  --color-purple: #9e96c8;
  --color-text: #173c34;
  --color-text-secondary: #6f7f78;
  --color-text-light: #a8b0aa;
  --color-background: #f7f8f5;
  --color-background-warm: #fff4cf;
  --color-surface: #ffffff;
  --color-border: #e8efeb;
  --color-danger: #a46d61;
  --color-danger-light: #fbf1ed;
  --shadow-card: 0 8rpx 30rpx rgba(20, 82, 67, 0.08);
  --shadow-float: 0 18rpx 48rpx rgba(21, 63, 54, 0.18);
  --gradient-hero: linear-gradient(145deg, #145243 0%, #1d604f 58%, #2c755e 100%);
  --gradient-gold: linear-gradient(135deg, #fff3b7, #f5b94e);
  --gradient-ai: linear-gradient(135deg, #5c78d6, #7567c8);
  --button-primary-background-color: #145243;
  --button-primary-border-color: #145243;
  --button-primary-color: #ffffff;
  --button-default-background-color: #ffffff;
  --button-default-border-color: #d8e5df;
  --button-default-color: #145243;
  --button-primary-danger-background-color: #b45c55;
  --button-primary-danger-border-color: #b45c55;
  --button-disabled-opacity: 0.5;
  --ant-card-bg: #ffffff;
  --ant-card-divider-color: #e8efeb;
  --ant-card-header-title-color: #173c34;
  --tag-primary-color: #145243;
  --tag-primary-light-color: #eff7f2;
  --tag-success-color: #145243;
  --tag-success-light-color: #eff7f2;
  --progress-stroke-color: #145243;
  --progress-success-color: #7dbb69;
  --progress-trail-color: #e8efeb;
  --notice-primary-background-color: #eff7f2;
  --notice-primary-color: #145243;
  --notice-info-background-color: #eef0fb;
  --notice-info-text-color: #495ca8;
  --steps-finish-bg: #145243;
  --steps-default-bg: #dcebe4;
  --steps-non-active-bg: #e8efeb;
  --steps-title-color: #173c34;
  --steps-desc-color: #6f7f78;
  --popup-background: #ffffff;
  --popup-color: #173c34;
  --dialog-background-color: #ffffff;
  --dialog-title-color: #173c34;
  --dialog-content-color: #6f7f78;
  --input-background-color: #fbfcfa;
  --input-item-color: #173c34;
  --input-item-placeholder-color: #a8b0aa;
  --radio-background-color: #145243;
  --radio-border-color: #c9d7d1;
  --radio-icon-color: #145243;
  --radio-text-color: #173c34;
  --checkbox-background-color: #145243;
  --checkbox-border-color: #c9d7d1;
  --checkbox-text-color: #173c34;
  background: var(--color-background);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view,
text,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  font-size: inherit;
  line-height: inherit;
}

button::after {
  border: 0;
}

button:not([disabled]):active {
  opacity: 0.86;
  transform: scale(0.985);
}

button[disabled] {
  cursor: default;
  opacity: 0.52;
}

.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 160rpx;
  background: transparent;
}

.page-header {
  margin-bottom: 32rpx;
}

.page-eyebrow {
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.page-title {
  margin-top: 8rpx;
  font-size: 54rpx;
  font-weight: 750;
  line-height: 1.25;
}

.page-subtitle {
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  font-size: 28rpx;
  line-height: 1.6;
}

.card {
  padding: 28rpx;
  border: 1rpx solid rgba(230, 238, 233, 0.82);
  border-radius: 28rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  animation: card-enter 240ms ease-out both;
}

.state-card {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.state-mark {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  border: 1rpx solid rgba(53, 104, 89, 0.12);
  background: linear-gradient(145deg, var(--color-primary-light), var(--color-primary-soft));
  color: var(--color-primary);
  font-size: 42rpx;
  font-weight: 700;
}

.state-title {
  margin-top: 28rpx;
  font-size: 34rpx;
  font-weight: 650;
}

.state-description {
  max-width: 520rpx;
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  line-height: 1.65;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 240rpx;
  min-height: 88rpx;
  margin-top: 32rpx;
  padding: 24rpx 36rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-weight: 650;
  text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(31, 77, 66, 0.18);
}

.primary-button[disabled] {
  background: #d9ded8;
  color: #7f877e;
}

.growth-primary-button,
.checkin-button,
.confirm-button,
.next-button,
.add-task-button {
  width: 100%;
  min-height: 92rpx;
  border-radius: 999rpx;
  font-weight: 650;
  --button-primary-background-color: #153f36;
  --button-primary-border-color: #153f36;
  box-shadow: 0 14rpx 32rpx rgba(21, 63, 54, 0.24);
}

.growth-ant-card {
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 28rpx;
  box-shadow: var(--shadow-card);
}

.growth-hero {
  position: relative;
  overflow: hidden;
  padding: 38rpx;
  border-radius: 40rpx;
  background: var(--gradient-hero);
  color: #ffffff;
  box-shadow: var(--shadow-float);
}

.growth-hero::after {
  position: absolute;
  border-radius: 50%;
  content: "";
  pointer-events: none;
}

.growth-hero::after {
  right: 120rpx;
  bottom: -120rpx;
  width: 210rpx;
  height: 210rpx;
  background: rgba(92, 120, 214, 0.17);
}

.bento-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.bento-tile {
  min-width: 0;
  padding: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: var(--shadow-card);
}

.accent-gold { background: linear-gradient(145deg, #fffaf0, #f2dfb4); }
.accent-blue { background: linear-gradient(145deg, #f7f8ff, #dfe5fa); }
.accent-purple { background: linear-gradient(145deg, #faf8ff, #e6e1f8); }
.accent-coral { background: linear-gradient(145deg, #fff9f6, #f5ddd7); }

.section-shell {
  margin-top: 28rpx;
  padding: 30rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 10rpx 36rpx rgba(21, 63, 54, 0.07);
  backdrop-filter: blur(16rpx);
}

.growth-progress {
  width: 100%;
}

.goal-steps {
  margin: 0 32rpx 10rpx;
  padding: 8rpx 0 20rpx;
}

.quick-task-popup,
.feedback-popup,
.management-popup {
  --popup-background: #f9fbf8;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 22rpx 34rpx;
  border: 2rpx solid rgba(53, 104, 89, 0.22);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: var(--color-primary);
  font-weight: 650;
}

.status-chip {
  height: 40rpx;
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  padding: 0 18rpx;
  border-radius: 20rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 600;
}

.progress-bar {
  width: 100%;
  height: 16rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #e8efea;
}

.progress-bar-inner {
  height: 100%;
  border-radius: 8rpx;
  background: var(--color-growth);
}

.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 22rpx 34rpx;
  border: 2rpx solid rgba(180, 92, 85, 0.22);
  border-radius: 999rpx;
  background: var(--color-danger-light);
  color: var(--color-danger);
  font-weight: 650;
}

.ai-notice,
.safety-notice {
  padding: 24rpx 26rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  line-height: 1.65;
}

.ai-notice {
  border: 1rpx solid rgba(123, 167, 201, 0.22);
  background: #f2f7fb;
  color: #49677d;
}

.safety-notice {
  border: 1rpx solid rgba(243, 199, 106, 0.28);
  background: var(--color-background-warm);
  color: #765f37;
}

.ui-tag {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 650;
}

@keyframes card-enter {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.loading-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--color-primary);
  animation: pulse 1.1s ease-in-out infinite;
}

@keyframes pulse {
  0%,
  100% {
    opacity: 0.35;
    transform: scale(0.8);
  }

  50% {
    opacity: 1;
    transform: scale(1.15);
  }
}

@media (max-width: 340px) {
  .page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .page-title {
    font-size: 44rpx;
  }

  .card {
    padding: 26rpx;
    border-radius: 24rpx;
  }

  .state-card {
    min-height: 360rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .card,
  .loading-dot {
    animation: none;
  }
}
