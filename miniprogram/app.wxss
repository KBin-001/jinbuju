@import "./styles/theme.wxss";

page {
  min-height: 100%;
  background: var(--color-bg-page);
  color: var(--color-text-main);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  font-size: inherit;
  line-height: inherit;
}

button::after {
  border: 0;
}

button:not([disabled]) {
  transition: opacity 180ms ease, transform 180ms ease;
}

button:not([disabled]):active {
  opacity: .86;
  transform: scale(.985);
}

button[disabled] {
  opacity: var(--button-disabled-opacity);
}

.page {
  min-height: 100vh;
  padding: var(--padding-page);
  background: transparent;
}

/* 四个主 Tab 共用的顶部标题区：安全区、胶囊基线与 Header 底边保持一致。 */
.tab-header {
  position: relative;
  z-index: 1;
  width: auto;
  overflow: hidden;
}

.tab-header__background,
.tab-header__veil {
  position: absolute;
  width: 100%;
  height: 100%;
  inset: 0;
  pointer-events: none;
}

.tab-header__background {
  display: block;
  opacity: .68;
}

.tab-header__veil {
  background: linear-gradient(180deg, rgba(247, 243, 234, .06), rgba(247, 243, 234, .26) 58%, var(--color-bg-page, #F7F3EA) 100%);
}

.tab-header__nav {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: content-box;
  padding-right: 190rpx;
  padding-left: 190rpx;
}

.tab-header__title {
  overflow: hidden;
  color: var(--color-primary, #245B4D);
  font-family: "Songti SC", "STSong", SimSun, serif;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 5rpx;
  text-overflow: ellipsis;
  text-shadow: 0 2rpx 8rpx rgba(255, 253, 247, .68);
  white-space: nowrap;
}

.page-header {
  margin-bottom: 28rpx;
}

.page-eyebrow {
  color: var(--color-primary);
  font-size: var(--font-caption);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.page-title {
  margin-top: 8rpx;
  color: var(--color-text-main);
  font-size: var(--font-page-title);
  font-weight: 700;
  line-height: 1.3;
}

.page-subtitle {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-body);
  line-height: 1.6;
}

.card {
  padding: var(--space-card-inner);
  border: 1rpx solid var(--color-border-soft);
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
  box-shadow: var(--shadow-card-soft);
}

.state-card {
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx;
  text-align: center;
}

.state-mark {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card-small);
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 38rpx;
  font-weight: 700;
}

.state-title {
  margin-top: 24rpx;
  color: var(--color-text-main);
  font-size: var(--font-card-title);
  font-weight: 650;
  line-height: 1.4;
}

.state-description {
  max-width: 520rpx;
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-body);
  line-height: 1.65;
}

.primary-button,
.secondary-button,
.danger-button {
  min-height: var(--size-control-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 34rpx;
  border-radius: var(--radius-button);
  font-size: var(--font-body);
  font-weight: 650;
  text-align: center;
}

.primary-button {
  min-width: 240rpx;
  margin-top: 28rpx;
  background: var(--color-primary);
  color: var(--color-text-inverse);
  box-shadow: var(--shadow-button-primary);
}

.primary-button[disabled] {
  background: #D9DED8;
  color: #7F877E;
  box-shadow: none;
}

.secondary-button {
  border: 1rpx solid rgba(36, 91, 77, .20);
  background: var(--color-bg-card);
  color: var(--color-primary);
}

.danger-button {
  border: 1rpx solid rgba(184, 97, 82, .24);
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.growth-primary-button,
.checkin-button,
.confirm-button,
.next-button,
.add-task-button {
  width: 100%;
  min-height: var(--size-control-lg);
  border-radius: var(--radius-button);
  font-weight: 650;
  --td-button-border-radius: var(--radius-button);
  --td-button-primary-bg-color: var(--color-primary);
  --td-button-primary-border-color: var(--color-primary);
  box-shadow: var(--shadow-button);
}

.growth-component-card {
  border: 1rpx solid var(--color-border-soft);
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
  box-shadow: var(--shadow-card-soft);
}

.growth-hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx;
  border-radius: var(--radius-hero);
  background: var(--gradient-card-mint);
  color: var(--color-text-main);
  box-shadow: var(--shadow-card);
}

.growth-hero::after {
  position: absolute;
  right: 120rpx;
  bottom: -120rpx;
  width: 210rpx;
  height: 210rpx;
  border-radius: 50%;
  background: rgba(36, 91, 77, .08);
  content: "";
  pointer-events: none;
}

.bento-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.bento-tile {
  min-width: 0;
  padding: 26rpx;
  border: 1rpx solid var(--color-border-soft);
  border-radius: var(--radius-card);
  background: rgba(255, 252, 246, .94);
}

.accent-gold { background: var(--gradient-accent-gold); }
.accent-blue { background: var(--gradient-accent-blue); }
.accent-purple { background: var(--gradient-accent-purple); }
.accent-coral { background: var(--gradient-accent-coral); }

.section-shell {
  margin-top: 28rpx;
  padding: 30rpx;
  border: 1rpx solid var(--color-border-soft);
  border-radius: var(--radius-card-large);
  background: rgba(255, 252, 246, .96);
  box-shadow: var(--shadow-card-soft);
}

.growth-progress {
  width: 100%;
}

.goal-steps {
  margin: 0 32rpx 10rpx;
  padding: 8rpx 0 20rpx;
}

.quick-task-popup,
.feedback-popup,
.management-popup {
  --td-popup-bg-color: var(--color-bg-card);
  --popup-background: var(--color-bg-card);
}

.status-chip,
.ui-tag {
  min-height: 44rpx;
  display: inline-flex;
  align-items: center;
  padding: 5rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: var(--font-tag);
  font-weight: 600;
  line-height: 1.35;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  overflow: hidden;
  border-radius: var(--radius-pill);
  background: #E5E9E4;
}

.progress-bar-inner {
  height: 100%;
  border-radius: inherit;
  background: var(--gradient-progress);
}

.ai-notice,
.safety-notice {
  padding: 22rpx 24rpx;
  border-radius: var(--radius-card-small);
  font-size: var(--font-caption);
  line-height: 1.65;
}

.ai-notice {
  border: 1rpx solid rgba(88, 122, 134, .18);
  background: var(--color-info-soft);
  color: var(--color-info);
}

.safety-notice {
  border: 1rpx solid rgba(168, 112, 37, .22);
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.loading-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--color-primary);
  animation: loading-pulse 1.1s ease-in-out infinite;
}

@keyframes loading-pulse {
  0%,
  100% { opacity: .35; transform: scale(.82); }
  50% { opacity: 1; transform: scale(1); }
}

/* TDesign hosts inherit the shared variables from page/theme. */
t-button,
t-input,
t-textarea,
t-cell,
t-progress {
  box-sizing: border-box;
}

t-button.primary-button,
t-button.growth-primary-button,
t-button.checkin-button,
t-button.confirm-button,
t-button.next-button,
t-button.add-task-button {
  --td-button-border-radius: var(--radius-button);
  --td-button-primary-bg-color: var(--color-primary);
  --td-button-primary-active-bg-color: var(--color-primary-dark);
}

t-input,
t-textarea {
  --td-input-bg-color: var(--color-bg-card);
  --td-input-border-color: var(--color-border);
  --td-textarea-background-color: var(--color-bg-card);
  --td-textarea-border-color: var(--color-border);
}

t-popup {
  --td-popup-border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
}

@media (max-width: 340px) {
  .page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .card,
  .growth-hero,
  .section-shell {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .state-card {
    min-height: 280rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  button:not([disabled]),
  .loading-dot {
    transition: none;
    animation: none;
  }
}
